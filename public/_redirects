# 301 Redirects for incorrect paths and unsupported languages
# en-gb (unsupported) → en-us
/en-gb/* /en-us/:splat 301

# Mixed language paths (English URL with German path segments)
/en-us/sorrentinische-halbinsel/* /en-us/sorrento-peninsula/:splat 301
/en-us/erlebnisse/* /en-us/experiences/:splat 301
/en-us/strande/* /en-us/beaches/:splat 301

# Mixed language paths (other languages)
/de-de/experiences/* /de-de/erlebnisse/:splat 301
/fr-fr/experiences/* /fr-fr/experiences/:splat 301
/es-es/courses/* /es-es/experiences/:splat 301

# Destination path variations
/en-us/destinations/amalfi /en-us/amalfi-coast/amalfi 301
/en-us/destinations/* /en-us/:splat 301
/de-de/reiseziele/* /de-de/:splat 301

# Blog paths
/en-gb/blog/* /en-us/blog/:splat 301

# Beach/Spiagge paths with wrong language names
/en-us/beaches/sorrentiner-halbinsel/* /en-us/beaches/sorrentine-peninsula/:splat 301
/de-de/strande/penisola-sorrentina/* /de-de/strande/sorrentinische-halbinsel/:splat 301

# Language-specific 404 handling for Netlify
# Rewrite 404s to language-specific pages while maintaining 404 status

/it-it/* /it-it/404/index.html 404
/en-us/* /en-us/404/index.html 404
/de-de/* /de-de/404/index.html 404
/fr-fr/* /fr-fr/404/index.html 404
/es-es/* /es-es/404/index.html 404

# Fallback for root level 404s
/* /en-us/404/index.html 404
