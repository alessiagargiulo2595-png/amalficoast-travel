---
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<svg
  viewBox="0 0 24 24"
  fill="currentColor"
  xmlns="http://www.w3.org/2000/svg"
  class={className}
>
  {/* Limone intero - corpo principale ovale */}
  <ellipse cx="12" cy="12" rx="8" ry="9" fill="currentColor" />

  {/* Punta superiore del limone */}
  <path
    d="M 11 3 Q 12 1 13 3 Q 12 4 11 3"
    fill="currentColor"
  />

  {/* Punta inferiore del limone */}
  <path
    d="M 11 21 Q 12 23 13 21 Q 12 20 11 21"
    fill="currentColor"
  />
</svg>
