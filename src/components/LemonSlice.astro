---
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<svg
  viewBox="0 0 20 20"
  fill="currentColor"
  xmlns="http://www.w3.org/2000/svg"
  class={className}
>
  {/* Spicchio di limone - grande e chiaro */}
  <path
    d="M 10 10 L 10 1 A 9 9 0 0 1 19 10 Z"
    fill="currentColor"
    stroke="currentColor"
    stroke-width="0.7"
    stroke-linejoin="round"
  />

  {/* Linee radiali della polpa - spesse e visibili */}
  <line x1="10" y1="10" x2="10" y2="1.5" stroke="white" stroke-width="0.9" opacity="0.95" stroke-linecap="round" />
  <line x1="10" y1="10" x2="17" y2="4" stroke="white" stroke-width="0.9" opacity="0.95" stroke-linecap="round" />
  <line x1="10" y1="10" x2="19" y2="10" stroke="white" stroke-width="0.9" opacity="0.95" stroke-linecap="round" />
  <line x1="10" y1="10" x2="17" y2="17" stroke="white" stroke-width="0.9" opacity="0.95" stroke-linecap="round" />
  <line x1="10" y1="10" x2="12" y2="19" stroke="white" stroke-width="0.9" opacity="0.95" stroke-linecap="round" />

  {/* Seme al centro - più grande */}
  <circle cx="15" cy="8" r="1" fill="white" opacity="0.85" />
</svg>
