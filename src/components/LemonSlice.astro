---
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<svg
  viewBox="0 0 24 24"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  class={className}
>
  <defs>
    {/* Gradiente per effetto più realistico */}
    <radialGradient id="lemonGradient" cx="65%" cy="25%">
      <stop offset="0%" style="stop-color:white;stop-opacity:0.4" />
      <stop offset="100%" style="stop-color:currentColor;stop-opacity:1" />
    </radialGradient>
  </defs>

  {/* Spicchio di limone con gradiente */}
  <path
    d="M 12 12 L 12 2 A 10 10 0 0 1 22 12 Z"
    fill="url(#lemonGradient)"
    stroke="currentColor"
    stroke-width="1.3"
    stroke-linejoin="round"
  />

  {/* Linee radiali della polpa - molto visibili */}
  <line
    x1="12"
    y1="12"
    x2="12"
    y2="2.5"
    stroke="white"
    stroke-width="1.4"
    stroke-linecap="round"
    opacity="1"
  />
  <line
    x1="12"
    y1="12"
    x2="18.5"
    y2="4.5"
    stroke="white"
    stroke-width="1.4"
    stroke-linecap="round"
    opacity="1"
  />
  <line
    x1="12"
    y1="12"
    x2="21.5"
    y2="12"
    stroke="white"
    stroke-width="1.4"
    stroke-linecap="round"
    opacity="1"
  />
  <line
    x1="12"
    y1="12"
    x2="18.5"
    y2="19.5"
    stroke="white"
    stroke-width="1.4"
    stroke-linecap="round"
    opacity="1"
  />
  <line
    x1="12"
    y1="12"
    x2="13"
    y2="21.5"
    stroke="white"
    stroke-width="1.4"
    stroke-linecap="round"
    opacity="1"
  />

  {/* Seme al centro - ben visibile */}
  <circle cx="16.5" cy="9" r="1.4" fill="white" opacity="0.9" />
</svg>
