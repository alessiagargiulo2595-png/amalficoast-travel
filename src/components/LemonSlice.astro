---
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<svg
  viewBox="0 0 24 24"
  fill="white"
  xmlns="http://www.w3.org/2000/svg"
  class={className}
>
  {/* Contorno esterno dello spicchio di limone */}
  <path
    d="M 12 12 L 12 2 A 10 10 0 0 1 22 12 Z"
    fill="white"
    stroke="currentColor"
    stroke-width="1.5"
    stroke-linejoin="round"
  />

  {/* Contorno interno della scorza - crea lo spessore */}
  <path
    d="M 12 12 L 12 4.5 A 7.5 7.5 0 0 1 19.5 12 Z"
    fill="none"
    stroke="currentColor"
    stroke-width="1.5"
    stroke-linejoin="round"
  />

  {/* Linee radiali della polpa - creano le sezioni */}
  <line
    x1="12"
    y1="12"
    x2="12"
    y2="4.5"
    stroke="currentColor"
    stroke-width="1.3"
    stroke-linecap="round"
  />
  <line
    x1="12"
    y1="12"
    x2="17.5"
    y2="6"
    stroke="currentColor"
    stroke-width="1.3"
    stroke-linecap="round"
  />
  <line
    x1="12"
    y1="12"
    x2="19.5"
    y2="12"
    stroke="currentColor"
    stroke-width="1.3"
    stroke-linecap="round"
  />
  <line
    x1="12"
    y1="12"
    x2="17.5"
    y2="18"
    stroke="currentColor"
    stroke-width="1.3"
    stroke-linecap="round"
  />

  {/* Arco finale che completa la polpa */}
  <path
    d="M 12 4.5 A 7.5 7.5 0 0 1 19.5 12"
    fill="none"
    stroke="currentColor"
    stroke-width="1.3"
    stroke-linecap="round"
  />
</svg>
