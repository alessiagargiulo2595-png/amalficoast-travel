---
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<svg
  viewBox="0 0 24 24"
  fill="currentColor"
  xmlns="http://www.w3.org/2000/svg"
  class={className}
>
  {/* Spicchio di limone semplice e riconoscibile */}
  <path
    d="M 12 12 L 12 2 A 10 10 0 0 1 22 12 Z"
    fill="currentColor"
  />

  {/* Linea centrale verticale */}
  <line
    x1="12"
    y1="12"
    x2="12"
    y2="2"
    stroke="white"
    stroke-width="1.2"
    opacity="0.7"
  />

  {/* Linea diagonale destra */}
  <line
    x1="12"
    y1="12"
    x2="22"
    y2="12"
    stroke="white"
    stroke-width="1.2"
    opacity="0.7"
  />

  {/* Linea diagonale sinistra-bassa */}
  <line
    x1="12"
    y1="12"
    x2="18"
    y2="18"
    stroke="white"
    stroke-width="1.2"
    opacity="0.7"
  />
</svg>
