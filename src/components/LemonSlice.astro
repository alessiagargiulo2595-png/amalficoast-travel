---
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<svg
  viewBox="0 0 24 24"
  fill="currentColor"
  xmlns="http://www.w3.org/2000/svg"
  class={className}
>
  {/* Limone intero - corpo principale ovale */}
  <ellipse cx="12" cy="13" rx="8" ry="9" fill="currentColor" />

  {/* Punta superiore del limone */}
  <path
    d="M 11 4 Q 12 2 13 4 Q 12 5 11 4"
    fill="currentColor"
  />

  {/* Punta inferiore del limone */}
  <path
    d="M 11 22 Q 12 24 13 22 Q 12 21 11 22"
    fill="currentColor"
  />

  {/* Foglia - verde (usando un colore più chiaro per contrasto) */}
  <ellipse cx="18" cy="8" rx="3.5" ry="5" fill="white" opacity="0.6" transform="rotate(-30 18 8)" />

  {/* Vena della foglia */}
  <line x1="18" y1="3.5" x2="18" y2="12.5" stroke="currentColor" stroke-width="0.8" opacity="0.8" />
</svg>
