---
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<svg
  viewBox="0 0 24 24"
  fill="currentColor"
  xmlns="http://www.w3.org/2000/svg"
  class={className}
>
  {/* Spicchio di limone - settore principale */}
  <path
    d="M 12 12 L 12 2 A 10 10 0 0 1 21.93 5.36 Z"
    fill="currentColor"
    stroke="currentColor"
    stroke-width="1.2"
    stroke-linejoin="round"
  />

  {/* Linee radiali della polpa - più evidenti */}
  <line x1="12" y1="12" x2="12" y2="2.5" stroke="white" stroke-width="0.8" opacity="0.8" stroke-linecap="round" />
  <line x1="12" y1="12" x2="19" y2="5" stroke="white" stroke-width="0.8" opacity="0.8" stroke-linecap="round" />
  <line x1="12" y1="12" x2="21" y2="11.5" stroke="white" stroke-width="0.8" opacity="0.8" stroke-linecap="round" />
  <line x1="12" y1="12" x2="17" y2="17" stroke="white" stroke-width="0.8" opacity="0.8" stroke-linecap="round" />

  {/* Seme al centro */}
  <circle cx="16" cy="9.5" r="0.9" fill="white" opacity="0.6" />
</svg>
