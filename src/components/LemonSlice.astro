---
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<svg
  viewBox="0 0 24 24"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  class={className}
>
  {/* Scorza esterna con riempimento leggero */}
  <path
    d="M20 12C20 7.58172 16.4183 4 12 4V12H20Z"
    fill="currentColor"
    fill-opacity="0.2"
    stroke="currentColor"
    stroke-width="1.5"
    stroke-linejoin="round"
  />
  {/* Dettagli polpa */}
  <path d="M12 12L17.5 10" stroke="currentColor" stroke-width="1" stroke-linecap="round" opacity="0.6" />
  <path d="M12 12L14 6.5" stroke="currentColor" stroke-width="1" stroke-linecap="round" opacity="0.6" />
</svg>
