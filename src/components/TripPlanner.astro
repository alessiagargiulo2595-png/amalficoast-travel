---
import type { Locale } from '../i18n/translations';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;

const langKey = lang.split('-')[0] as 'it' | 'en' | 'de' | 'es' | 'fr';

const ui: Record<string, Record<string, string>> = {
  title: { it: 'Pianifica il tuo viaggio', en: 'Plan your trip', de: 'Plane deine Reise', es: 'Planifica tu viaje', fr: 'Planifie ton voyage' },
  subtitle: { it: 'Seleziona le tue preferenze e ottieni un itinerario personalizzato in pochi secondi.', en: 'Select your preferences and get a personalised itinerary in seconds.', de: 'Wähle deine Vorlieben und erhalte in Sekunden eine persönliche Reiseroute.', es: 'Selecciona tus preferencias y obtén un itinerario personalizado en segundos.', fr: 'Sélectionne tes préférences et obtiens un itinéraire personnalisé en quelques secondes.' },
  step1: { it: 'Punto di partenza', en: 'Starting point', de: 'Ausgangspunkt', es: 'Punto de partida', fr: 'Point de départ' },
  step2: { it: 'Preferenze', en: 'Preferences', de: 'Vorlieben', es: 'Preferencias', fr: 'Préférences' },
  step3: { it: 'Il tuo itinerario', en: 'Your itinerary', de: 'Deine Reiseroute', es: 'Tu itinerario', fr: 'Ton itinéraire' },
  from: { it: 'Da dove parti?', en: 'Where are you coming from?', de: 'Von wo startest du?', es: '¿Desde dónde sales?', fr: "D'où pars-tu?" },
  days: { it: 'Quanti giorni?', en: 'How many days?', de: 'Wie viele Tage?', es: '¿Cuántos días?', fr: 'Combien de jours?' },
  budget: { it: 'Budget', en: 'Budget', de: 'Budget', es: 'Presupuesto', fr: 'Budget' },
  budget_1: { it: 'Economico', en: 'Budget', de: 'Günstig', es: 'Económico', fr: 'Économique' },
  budget_2: { it: 'Medio', en: 'Mid-range', de: 'Mittel', es: 'Medio', fr: 'Moyen' },
  budget_3: { it: 'Alto', en: 'High-end', de: 'Gehoben', es: 'Alto', fr: 'Haut de gamme' },
  season: { it: 'Periodo', en: 'Season', de: 'Reisezeit', es: 'Temporada', fr: 'Saison' },
  spring: { it: 'Primavera', en: 'Spring', de: 'Frühling', es: 'Primavera', fr: 'Printemps' },
  summer: { it: 'Estate', en: 'Summer', de: 'Sommer', es: 'Verano', fr: 'Été' },
  autumn: { it: 'Autunno', en: 'Autumn', de: 'Herbst', es: 'Otoño', fr: 'Automne' },
  winter: { it: 'Inverno', en: 'Winter', de: 'Winter', es: 'Invierno', fr: 'Hiver' },
  types: { it: 'Cosa ti interessa?', en: 'What interests you?', de: 'Was interessiert dich?', es: '¿Qué te interesa?', fr: "Qu'est-ce qui t'intéresse?" },
  mare: { it: 'Mare', en: 'Beach', de: 'Strand', es: 'Playa', fr: 'Plage' },
  cultura: { it: 'Cultura', en: 'Culture', de: 'Kultur', es: 'Cultura', fr: 'Culture' },
  trekking: { it: 'Trekking', en: 'Hiking', de: 'Wandern', es: 'Senderismo', fr: 'Randonnée' },
  gastronomia: { it: 'Gastronomia', en: 'Food & wine', de: 'Essen & Wein', es: 'Gastronomía', fr: 'Gastronomie' },
  relax: { it: 'Relax', en: 'Relax', de: 'Entspannung', es: 'Relax', fr: 'Détente' },
  panorama: { it: 'Panorama', en: 'Views', de: 'Aussicht', es: 'Panorama', fr: 'Panorama' },
  shopping: { it: 'Shopping', en: 'Shopping', de: 'Shopping', es: 'Compras', fr: 'Shopping' },
  next: { it: 'Avanti', en: 'Next', de: 'Weiter', es: 'Siguiente', fr: 'Suivant' },
  back: { it: 'Indietro', en: 'Back', de: 'Zurück', es: 'Atrás', fr: 'Retour' },
  generate: { it: 'Genera itinerario', en: 'Generate itinerary', de: 'Reiseroute erstellen', es: 'Generar itinerario', fr: 'Générer itinéraire' },
  restart: { it: 'Ricomincia', en: 'Start over', de: 'Neu starten', es: 'Empezar de nuevo', fr: 'Recommencer' },
  day_label: { it: 'Giorno', en: 'Day', de: 'Tag', es: 'Día', fr: 'Jour' },
  transport: { it: 'Trasporto', en: 'Transport', de: 'Transport', es: 'Transporte', fr: 'Transport' },
  time_min: { it: 'min', en: 'min', de: 'Min', es: 'min', fr: 'min' },
  cost_label: { it: 'Costo stimato', en: 'Estimated cost', de: 'Geschätzte Kosten', es: 'Coste estimado', fr: 'Coût estimé' },
  no_results: { it: 'Nessun blocco corrisponde ai tuoi criteri. Prova a modificare le preferenze.', en: 'No activities match your criteria. Try adjusting your preferences.', de: 'Keine Aktivitäten entsprechen deinen Kriterien. Versuche, deine Vorlieben anzupassen.', es: 'Ninguna actividad coincide con tus criterios. Intenta modificar tus preferencias.', fr: "Aucune activité ne correspond à tes critères. Essaie de modifier tes préférences." },
  highlights_label: { it: 'Highlights', en: 'Highlights', de: 'Highlights', es: 'Destacados', fr: 'Points forts' },
  napoli: { it: 'Napoli', en: 'Naples', de: 'Neapel', es: 'Nápoles', fr: 'Naples' },
  salerno: { it: 'Salerno', en: 'Salerno', de: 'Salerno', es: 'Salerno', fr: 'Salerne' },
  sorrento: { it: 'Sorrento', en: 'Sorrento', de: 'Sorrent', es: 'Sorrento', fr: 'Sorrente' },
  amalfi: { it: 'Amalfi', en: 'Amalfi', de: 'Amalfi', es: 'Amalfi', fr: 'Amalfi' },
  destination: { it: 'Dove vuoi andare?', en: 'Where do you want to go?', de: 'Wohin möchtest du?', es: '¿Adónde quieres ir?', fr: 'Où veux-tu aller?' },
  area_costiera: { it: 'Costiera Amalfitana', en: 'Amalfi Coast', de: 'Amalfiküste', es: 'Costa Amalfitana', fr: 'Côte Amalfitaine' },
  area_penisola: { it: 'Penisola Sorrentina', en: 'Sorrento Peninsula', de: 'Halbinsel Sorrent', es: 'Península Sorrentina', fr: 'Péninsule de Sorrente' },
  area_isole: { it: 'Isole del Golfo', en: 'Gulf Islands', de: 'Golfinseln', es: 'Islas del Golfo', fr: 'Îles du Golfe' },
  area_all: { it: 'Tutte le zone', en: 'All areas', de: 'Alle Gebiete', es: 'Todas las zonas', fr: 'Toutes les zones' },
  preferred_city: { it: 'Città preferite (max 3)', en: 'Preferred towns (max 3)', de: 'Bevorzugte Orte (max 3)', es: 'Ciudades preferidas (máx. 3)', fr: 'Villes préférées (max 3)' },
  share_wa: { it: 'Condividi su WhatsApp', en: 'Share on WhatsApp', de: 'Auf WhatsApp teilen', es: 'Compartir en WhatsApp', fr: 'Partager sur WhatsApp' },
  download_pdf: { it: 'Scarica PDF', en: 'Download PDF', de: 'PDF herunterladen', es: 'Descargar PDF', fr: 'Télécharger PDF' },
  any_city: { it: 'Nessuna preferenza', en: 'No preference', de: 'Keine Präferenz', es: 'Sin preferencia', fr: 'Pas de préférence' },
  morning: { it: 'Mattina', en: 'Morning', de: 'Vormittag', es: 'Mañana', fr: 'Matin' },
  afternoon: { it: 'Pomeriggio', en: 'Afternoon', de: 'Nachmittag', es: 'Tarde', fr: 'Après-midi' },
  regenerate: { it: 'Rigenera itinerario', en: 'Regenerate', de: 'Neu generieren', es: 'Regenerar', fr: 'Régénérer' },
  generating: { it: 'Stiamo creando il tuo itinerario...', en: 'Creating your itinerary...', de: 'Deine Reiseroute wird erstellt...', es: 'Creando tu itinerario...', fr: 'Création de ton itinéraire...' },
  map_label: { it: 'Mappa del giorno', en: 'Day map', de: 'Tageskarte', es: 'Mapa del día', fr: 'Carte du jour' },
  restored_label: { it: 'Itinerario ripristinato dal salvataggio precedente.', en: 'Itinerary restored from previous save.', de: 'Reiseroute aus vorherigem Speicherstand wiederhergestellt.', es: 'Itinerario restaurado desde guardado anterior.', fr: 'Itinéraire restauré depuis la sauvegarde précédente.' },
  discover: { it: 'Scopri di più', en: 'Discover more', de: 'Mehr entdecken', es: 'Descubrir más', fr: 'En savoir plus' },
  schedule: { it: 'Orario', en: 'Schedule', de: 'Zeitplan', es: 'Horario', fr: 'Horaire' },
  event_label: { it: 'Evento stagionale', en: 'Seasonal event', de: 'Saisonales Event', es: 'Evento estacional', fr: 'Événement saisonnier' },
};

function t(key: string): string {
  return ui[key]?.[langKey] || ui[key]?.['en'] || key;
}
---

<style>
  @keyframes planner-spin { to { transform: rotate(360deg); } }
  .planner-drag-ghost { opacity: 0.4; }
  .planner-drag-chosen { box-shadow: 0 0 0 2px #d4af37; border-radius: 12px; }

  /* Glassmorphism */
  .glass-card {
    background: rgba(255,255,255,0.04);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border: 1px solid rgba(255,255,255,0.08);
    box-shadow: 0 4px 24px rgba(0,0,0,0.2);
  }
  .glass-btn {
    background: rgba(255,255,255,0.05);
    border: 1px solid rgba(255,255,255,0.10);
    cursor: pointer;
  }
  .glass-btn:hover {
    background: rgba(212,175,55,0.08);
    border-color: rgba(212,175,55,0.35);
    color: #fff;
    box-shadow: 0 0 16px rgba(212,175,55,0.12);
  }
  .glass-btn--active, .glass-btn--active:hover {
    background: rgba(212,175,55,0.15);
    border-color: rgba(212,175,55,0.6);
    color: #fff;
    box-shadow: 0 0 20px rgba(212,175,55,0.2);
  }
</style>
<section class="relative overflow-hidden bg-gradient-to-br from-slate-900 via-slate-950 to-blue-950 pt-20 pb-12 md:pt-20 md:pb-16" id="trip-planner">
  <!-- Ambient glow -->
  <div class="absolute -top-20 -left-20 w-72 h-72 bg-blue-500/15 rounded-full blur-3xl pointer-events-none"></div>
  <div class="absolute -bottom-20 -right-20 w-72 h-72 bg-amber-500/10 rounded-full blur-3xl pointer-events-none"></div>

  <div class="relative z-10 max-w-4xl mx-auto px-4 sm:px-6">
    <!-- Header -->
    <div class="text-center mb-10">
      <h1 class="font-display text-4xl md:text-5xl font-bold text-med-gold mb-3">{t('title')}</h1>
      <p class="text-slate-300 text-lg max-w-2xl mx-auto">{t('subtitle')}</p>
    </div>

    <!-- Step indicator -->
    <div class="flex items-center justify-center gap-2 mb-8" id="step-indicator">
      <div class="step-dot active w-3 h-3 rounded-full bg-med-gold transition-colors" data-step="1"></div>
      <div class="w-8 h-0.5 bg-slate-600"></div>
      <div class="step-dot w-3 h-3 rounded-full bg-slate-600 transition-colors" data-step="2"></div>
      <div class="w-8 h-0.5 bg-slate-600"></div>
      <div class="step-dot w-3 h-3 rounded-full bg-slate-600 transition-colors" data-step="3"></div>
    </div>

    <!-- Step 1: Starting point -->
    <div class="planner-step" data-planner-step="1">
      <div class="space-y-5 mb-6">
        <div class="glass-card rounded-2xl p-6 sm:p-8">
          <h3 class="text-xl font-semibold text-white mb-5">{t('from')}</h3>
          <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
            <button class="hub-btn glass-btn px-4 py-5 rounded-xl text-center text-base font-medium text-slate-300 transition-all" data-hub="napoli">
              <svg class="w-8 h-8 mx-auto mb-2" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M8 4h8a4 4 0 014 4v7a3 3 0 01-3 3H7a3 3 0 01-3-3V8a4 4 0 014-4z"/><path stroke-linecap="round" d="M8 10h8M8 13.5h3m5 0h-2"/><circle cx="8" cy="15.5" r="1"/><circle cx="16" cy="15.5" r="1"/><path stroke-linecap="round" stroke-linejoin="round" d="M9 18l-2 3m8-3l2 3M4 21h16"/></svg>
              {t('napoli')}
            </button>
            <button class="hub-btn glass-btn px-4 py-5 rounded-xl text-center text-base font-medium text-slate-300 transition-all" data-hub="salerno">
              <svg class="w-8 h-8 mx-auto mb-2" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4 16l2-5h12l2 5H4zm3-5V7h10v4M10 7V5h4v2"/><path stroke-linecap="round" stroke-linejoin="round" d="M2 20c2-1.5 4-2 6-1s4 .5 6-1 4-.5 6 1"/></svg>
              {t('salerno')}
            </button>
            <button class="hub-btn glass-btn px-4 py-5 rounded-xl text-center text-base font-medium text-slate-300 transition-all" data-hub="sorrento">
              <svg class="w-8 h-8 mx-auto mb-2" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><circle cx="12" cy="12" r="5"/><path stroke-linecap="round" d="M12 2v3m0 14v3M2 12h3m14 0h3M4.93 4.93l2.12 2.12m9.9 9.9l2.12 2.12M4.93 19.07l2.12-2.12m9.9-9.9l2.12-2.12"/></svg>
              {t('sorrento')}
            </button>
            <button class="hub-btn glass-btn px-4 py-5 rounded-xl text-center text-base font-medium text-slate-300 transition-all" data-hub="amalfi">
              <svg class="w-8 h-8 mx-auto mb-2" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3 17c2-2 4-3 6-1s4 1 6-1 4-1 6 1M3 12c2-2 4-3 6-1s4 1 6-1 4-1 6 1M3 7c2-2 4-3 6-1s4 1 6-1 4-1 6 1"/></svg>
              {t('amalfi')}
            </button>
          </div>
        </div>
        <div class="glass-card rounded-2xl p-6 sm:p-8">
          <h3 class="text-xl font-semibold text-white mb-5">{t('days')}</h3>
          <div class="grid grid-cols-3 sm:grid-cols-6 gap-3">
            {[1,2,3,4,5,7].map(d => (
              <button class="day-btn glass-btn py-4 rounded-xl text-lg font-semibold text-slate-300 transition-all" data-days={d}>
                {d}
              </button>
            ))}
          </div>
        </div>
      </div>

      <button class="planner-next-btn w-full px-8 py-3.5 bg-gradient-to-r from-med-gold to-yellow-600 text-slate-900 font-bold rounded-xl hover:shadow-[0_0_24px_rgba(212,175,55,0.4)] transition-all disabled:opacity-40 disabled:cursor-not-allowed disabled:shadow-none" disabled>
        {t('next')} &rarr;
      </button>
    </div>

    <!-- Step 2: Preferences -->
    <div class="planner-step hidden" data-planner-step="2">

      <!-- DOVE -->
      <div class="glass-card rounded-2xl p-6 mb-5">
        <h3 class="text-xl font-semibold text-white mb-3">{t('destination')}</h3>
        <div class="grid grid-cols-2 md:grid-cols-4 gap-3">
          <button class="area-btn glass-btn px-4 py-3 rounded-xl text-center text-base font-medium text-slate-300 transition-all" data-area="costiera">
            <svg class="w-5 h-5 mx-auto mb-1" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 21a9.004 9.004 0 008.716-6.747M12 21a9.004 9.004 0 01-8.716-6.747M12 21c2.485 0 4.5-4.03 4.5-9S14.485 3 12 3m0 18c-2.485 0-4.5-4.03-4.5-9S9.515 3 12 3m0 0a8.997 8.997 0 017.843 4.582M12 3a8.997 8.997 0 00-7.843 4.582"/></svg>
            {t('area_costiera')}
          </button>
          <button class="area-btn glass-btn px-4 py-3 rounded-xl text-center text-base font-medium text-slate-300 transition-all" data-area="penisola">
            <svg class="w-5 h-5 mx-auto mb-1" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 10.5l4.72-4.72a.75.75 0 011.28.53v11.38a.75.75 0 01-1.28.53l-4.72-4.72M4.5 18.75h9a2.25 2.25 0 002.25-2.25v-9a2.25 2.25 0 00-2.25-2.25h-9A2.25 2.25 0 002.25 7.5v9a2.25 2.25 0 002.25 2.25z"/></svg>
            {t('area_penisola')}
          </button>
          <button class="area-btn glass-btn px-4 py-3 rounded-xl text-center text-base font-medium text-slate-300 transition-all" data-area="isole">
            <svg class="w-5 h-5 mx-auto mb-1" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M20.893 13.393l-1.135-1.135a2.252 2.252 0 01-.421-.585l-1.08-2.16a.414.414 0 00-.663-.107.827.827 0 01-.812.21l-1.273-.363a.89.89 0 00-.738.145l-.92.815a1.177 1.177 0 01-1.002.229l-3.47-.776M3.75 21h16.5M4.5 3h15M5.25 3v18m13.5-18v18"/></svg>
            {t('area_isole')}
          </button>
          <button class="area-btn glass-btn glass-btn--active px-4 py-3 rounded-xl text-center text-base font-medium transition-all" data-area="all">
            <svg class="w-5 h-5 mx-auto mb-1" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 6.75V15m6-6v8.25m.503 3.498l4.875-2.437c.381-.19.622-.58.622-1.006V4.82c0-.836-.88-1.38-1.628-1.006l-3.869 1.934c-.317.159-.69.159-1.006 0L9.503 3.252a1.125 1.125 0 00-1.006 0L3.622 5.689C3.24 5.88 3 6.27 3 6.695V19.18c0 .836.88 1.38 1.628 1.006l3.869-1.934c.317-.159.69-.159 1.006 0l4.994 2.497c.317.158.69.158 1.006 0z"/></svg>
            {t('area_all')}
          </button>
        </div>
        <div class="mt-4 pt-4 border-t border-white/10">
          <p class="text-sm text-white mb-8">{t('preferred_city')}</p>
          <div class="flex flex-wrap gap-3 pt-2" id="city-list">
            <button class="city-btn px-3 py-1.5 rounded-md border border-med-gold/40 text-sm font-medium text-med-gold bg-med-gold/10 transition-all" data-city="">
              {t('any_city')}
            </button>
            {[
              { city: 'Positano', area: 'costiera' }, { city: 'Amalfi', area: 'costiera' }, { city: 'Ravello', area: 'costiera' },
              { city: 'Praiano', area: 'costiera' }, { city: 'Minori', area: 'costiera' }, { city: 'Maiori', area: 'costiera' },
              { city: 'Cetara', area: 'costiera' }, { city: 'Vietri sul Mare', area: 'costiera' }, { city: 'Furore', area: 'costiera' },
              { city: 'Sorrento', area: 'penisola' }, { city: "Sant'Agnello", area: 'penisola' },
              { city: 'Massa Lubrense', area: 'penisola' }, { city: 'Vico Equense', area: 'penisola' },
              { city: 'Capri', area: 'isole' }, { city: 'Anacapri', area: 'isole' },
              { city: 'Ischia', area: 'isole' }, { city: 'Procida', area: 'isole' },
            ].map(({ city, area }) => (
              <button class="city-btn px-3 py-1.5 rounded-md border border-white/10 text-sm font-medium text-slate-400 hover:border-med-gold/50 hover:text-white transition-all" data-city={city} data-area-group={area}>
                {city}
              </button>
            ))}
          </div>
        </div>
      </div>

      <!-- QUANDO + BUDGET -->
      <div class="grid md:grid-cols-2 gap-5 mb-5">
        <div class="glass-card rounded-2xl p-6">
          <h3 class="text-xl font-semibold text-white mb-3">{t('season')}</h3>
          <div class="grid grid-cols-2 gap-2">
            {['spring','summer','autumn','winter'].map(s => (
              <button class="season-btn glass-btn px-3 py-2.5 rounded-xl text-base font-medium text-slate-300 transition-all" data-season={s}>
                {t(s)}
              </button>
            ))}
          </div>
        </div>
        <div class="glass-card rounded-2xl p-6">
          <h3 class="text-xl font-semibold text-white mb-3">{t('budget')}</h3>
          <div class="grid grid-cols-1 gap-2">
            {[1,2,3].map(b => (
              <button class="budget-btn glass-btn px-4 py-2.5 rounded-xl font-medium text-slate-300 transition-all text-base" data-budget={b}>
                {'€'.repeat(b)} {t(`budget_${b}`)}
              </button>
            ))}
          </div>
        </div>
      </div>

      <!-- INTERESSI -->
      <div class="glass-card rounded-2xl p-6 mb-6">
        <h3 class="text-xl font-semibold text-white mb-3">{t('types')}</h3>
        <div class="flex flex-wrap gap-2">
          {['mare','cultura','trekking','gastronomia','relax','panorama','shopping'].map(tp => (
            <button class="type-btn glass-btn px-4 py-2.5 rounded-xl text-base font-medium text-slate-300 transition-all" data-type={tp}>
              {t(tp)}
            </button>
          ))}
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-[auto_1fr] gap-3">
        <button class="planner-back-btn px-6 py-3.5 border border-white/20 text-slate-200 font-semibold rounded-xl backdrop-blur-sm hover:border-white/40 hover:bg-white/5 transition-all">
          &larr; {t('back')}
        </button>
        <button class="planner-generate-btn px-8 py-3.5 bg-gradient-to-r from-med-gold to-yellow-600 text-slate-900 font-bold rounded-xl hover:shadow-[0_0_24px_rgba(212,175,55,0.4)] transition-all disabled:opacity-40 disabled:cursor-not-allowed disabled:shadow-none" disabled>
          {t('generate')}
        </button>
      </div>
    </div>

    <!-- Step 3: Results -->
    <div class="planner-step hidden" data-planner-step="3">
      <div id="planner-results"></div>
      <button class="planner-restart-btn mt-8 px-6 py-3.5 font-semibold rounded-xl transition-all text-white" style="background:rgba(255,255,255,0.06);border:1px solid rgba(255,255,255,0.12);backdrop-filter:blur(12px)" onmouseover="this.style.borderColor='rgba(255,255,255,0.3)';this.style.background='rgba(255,255,255,0.10)'" onmouseout="this.style.borderColor='rgba(255,255,255,0.12)';this.style.background='rgba(255,255,255,0.06)'">
        &larr; {t('restart')}
      </button>
    </div>
  </div>
</section>

<script define:vars={{ langKey, ui }}>
  // Load dataset
  let blocksData = null;

  function t(key) {
    return ui[key]?.[langKey] || ui[key]?.['en'] || key;
  }

  async function loadData() {
    const resp = await fetch('/data/itinerary-blocks.json');
    blocksData = await resp.json();
  }

  // State
  const state = { hub: null, days: null, budget: null, season: null, types: [], area: 'all', cities: [] };

  // DOM
  const steps = document.querySelectorAll('.planner-step');
  const dots = document.querySelectorAll('.step-dot');

  function showStep(n) {
    steps.forEach((s, i) => {
      s.classList.toggle('hidden', i !== n - 1);
    });
    dots.forEach((d, i) => {
      d.classList.toggle('bg-med-gold', i < n);
      d.classList.toggle('bg-slate-600', i >= n);
    });
  }

  // Step 1: Hub selection
  document.querySelectorAll('.hub-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.hub-btn').forEach(b => b.classList.remove('glass-btn--active'));
      btn.classList.add('glass-btn--active');
      state.hub = btn.dataset.hub;
      checkStep1();
    });
  });

  // Step 1: Days selection
  document.querySelectorAll('.day-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.day-btn').forEach(b => b.classList.remove('glass-btn--active'));
      btn.classList.add('glass-btn--active');
      state.days = parseInt(btn.dataset.days);
      checkStep1();
    });
  });

  function checkStep1() {
    const btn = document.querySelector('.planner-next-btn');
    btn.disabled = !(state.hub && state.days);
  }

  // Next button
  document.querySelector('.planner-next-btn').addEventListener('click', () => {
    showStep(2);
    document.getElementById('trip-planner').scrollIntoView({ behavior: 'smooth' });
    if (typeof window.gtag === 'function') {
      window.gtag('event', 'planner_step', { step: 1, hub: state.hub, days: state.days });
    }
  });

  // Step 2: City selection (multi-select, max 3)
  document.querySelectorAll('.city-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const city = btn.dataset.city;
      if (city === '') {
        state.cities = [];
        document.querySelectorAll('.city-btn').forEach(b => { b.classList.remove('glass-btn--active'); b.style.borderColor = ''; b.style.color = ''; });
        btn.classList.add('glass-btn--active');
        return;
      }
      const noPrefBtn = document.querySelector('.city-btn[data-city=""]');
      if (noPrefBtn) noPrefBtn.classList.remove('glass-btn--active');
      if (state.cities.includes(city)) {
        state.cities = state.cities.filter(c => c !== city);
        btn.classList.remove('glass-btn--active');
      } else if (state.cities.length < 3) {
        state.cities.push(city);
        btn.classList.add('glass-btn--active');
      }
      if (state.cities.length === 0 && noPrefBtn) noPrefBtn.classList.add('glass-btn--active');
    });
  });

  // Step 2: Area selection (single select, default "all")
  document.querySelectorAll('.area-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.area-btn').forEach(b => b.classList.remove('glass-btn--active'));
      btn.classList.add('glass-btn--active');
      state.area = btn.dataset.area;
      state.cities = [];
      document.querySelectorAll('.city-btn').forEach(cb => {
        const group = cb.dataset.areaGroup;
        cb.classList.remove('glass-btn--active');
        if (!group) { cb.classList.add('glass-btn--active'); cb.style.display = ''; return; }
        cb.style.display = (state.area === 'all' || group === state.area) ? '' : 'none';
      });
      checkStep2();
    });
  });

  // Step 2: Budget (single select)
  document.querySelectorAll('.budget-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.budget-btn').forEach(b => b.classList.remove('glass-btn--active'));
      btn.classList.add('glass-btn--active');
      state.budget = parseInt(btn.dataset.budget);
      checkStep2();
    });
  });

  // Step 2: Season (single select)
  document.querySelectorAll('.season-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.season-btn').forEach(b => b.classList.remove('glass-btn--active'));
      btn.classList.add('glass-btn--active');
      state.season = btn.dataset.season;
      checkStep2();
    });
  });

  // Step 2: Types (multi select)
  document.querySelectorAll('.type-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const tp = btn.dataset.type;
      if (state.types.includes(tp)) {
        state.types = state.types.filter(x => x !== tp);
        btn.classList.remove('glass-btn--active');
      } else {
        state.types.push(tp);
        btn.classList.add('glass-btn--active');
      }
      checkStep2();
    });
  });

  function checkStep2() {
    const btn = document.querySelector('.planner-generate-btn');
    btn.disabled = !(state.budget && state.season && state.types.length > 0);
  }

  // Back button
  document.querySelector('.planner-back-btn').addEventListener('click', () => {
    showStep(1);
  });

  // Generate with loading animation
  document.querySelector('.planner-generate-btn').addEventListener('click', async () => {
    if (!blocksData) await loadData();
    // Show loading animation
    showStep(3);
    document.getElementById('trip-planner').scrollIntoView({ behavior: 'smooth' });
    const container = document.getElementById('planner-results');
    container.innerHTML = `
      <div style="text-align:center;padding:60px 20px">
        <div style="display:inline-block;width:48px;height:48px;border:4px solid rgba(212,175,55,0.2);border-top-color:#d4af37;border-radius:50%;animation:planner-spin 0.8s linear infinite"></div>
        <p style="color:#cbd5e1;margin-top:16px;font-size:15px">${t('generating')}</p>
      </div>`;
    // Delay for animation effect, then generate
    await new Promise(r => setTimeout(r, 1200));
    generateItinerary();
    if (typeof window.gtag === 'function') {
      window.gtag('event', 'planner_complete', {
        hub: state.hub, days: state.days, budget: state.budget,
        season: state.season, types: state.types.join(','),
        area: state.area, cities: state.cities.join(',')
      });
    }
  });

  // Restart
  document.querySelector('.planner-restart-btn').addEventListener('click', () => {
    state.hub = null; state.days = null; state.budget = null; state.season = null; state.types = []; state.area = 'all'; state.cities = [];
    document.querySelectorAll('.hub-btn, .day-btn, .budget-btn, .season-btn, .type-btn, .area-btn, .city-btn').forEach(b => {
      b.classList.remove('glass-btn--active');
    });
    // Re-select defaults
    const allBtn = document.querySelector('.area-btn[data-area="all"]');
    if (allBtn) allBtn.classList.add('glass-btn--active');
    const noCityBtn = document.querySelector('.city-btn[data-city=""]');
    if (noCityBtn) noCityBtn.classList.add('glass-btn--active');
    // Show all cities again
    document.querySelectorAll('.city-btn[data-area-group]').forEach(cb => { cb.style.display = ''; });
    document.querySelector('.planner-next-btn').disabled = true;
    document.querySelector('.planner-generate-btn').disabled = true;
    showStep(1);
    document.getElementById('trip-planner').scrollIntoView({ behavior: 'smooth' });
  });

  // --- Utility: Haversine distance in km ---
  function haversine(c1, c2) {
    const toRad = d => d * Math.PI / 180;
    const [lat1, lon1] = c1;
    const [lat2, lon2] = c2;
    const dLat = toRad(lat2 - lat1);
    const dLon = toRad(lon2 - lon1);
    const a = Math.sin(dLat / 2) ** 2 + Math.cos(toRad(lat1)) * Math.cos(toRad(lat2)) * Math.sin(dLon / 2) ** 2;
    return 6371 * 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a));
  }

  // --- Slot assignment: AM types vs PM types ---
  const amTypes = new Set(['trekking', 'mare', 'relax']);
  const pmTypes = new Set(['cultura', 'panorama', 'gastronomia', 'shopping']);

  function slotPreference(block) {
    // Use suggested_time range: pure morning (ends ≤13) = AM, starts ≥14 = PM, spans midday = any
    if (block.suggested_time) {
      const [startStr, endStr] = block.suggested_time.split('-');
      const startHour = parseInt(startStr.split(':')[0]);
      const endHour = endStr ? parseInt(endStr.split(':')[0]) : startHour + 2;
      if (startHour < 12 && endHour <= 13) return 'am';
      if (startHour >= 14) return 'pm';
      return 'any'; // spans midday (e.g. 10:00-14:00)
    }
    const amScore = block.types.filter(t => amTypes.has(t)).length;
    const pmScore = block.types.filter(t => pmTypes.has(t)).length;
    if (amScore > pmScore) return 'am';
    if (pmScore > amScore) return 'pm';
    return 'any';
  }

  function assignSlots(dayBlocks) {
    // For full-day blocks, label 'full'. For 2 half-day blocks, assign AM/PM intelligently.
    if (dayBlocks.length === 1) {
      return [{ ...dayBlocks[0], slot: dayBlocks[0].duration === 'full' ? 'full' : 'am' }];
    }
    const a = dayBlocks[0], b = dayBlocks[1];
    const prefA = slotPreference(a), prefB = slotPreference(b);
    // If one clearly wants AM and the other PM
    if (prefA === 'am' && prefB !== 'am') return [{ ...a, slot: 'am' }, { ...b, slot: 'pm' }];
    if (prefB === 'am' && prefA !== 'am') return [{ ...b, slot: 'am' }, { ...a, slot: 'pm' }];
    if (prefA === 'pm' && prefB !== 'pm') return [{ ...b, slot: 'am' }, { ...a, slot: 'pm' }];
    if (prefB === 'pm' && prefA !== 'pm') return [{ ...a, slot: 'am' }, { ...b, slot: 'pm' }];
    // Same preference: use suggested_time to order chronologically (earlier → AM)
    if (a.suggested_time && b.suggested_time) {
      const startA = parseInt(a.suggested_time.split(':')[0]);
      const startB = parseInt(b.suggested_time.split(':')[0]);
      if (startA !== startB) {
        return startA < startB
          ? [{ ...a, slot: 'am' }, { ...b, slot: 'pm' }]
          : [{ ...b, slot: 'am' }, { ...a, slot: 'pm' }];
      }
    }
    // Default: keep original order
    return [{ ...a, slot: 'am' }, { ...b, slot: 'pm' }];
  }

  // --- Algorithm v3 ---
  function generateItinerary() {
    const blocks = blocksData.blocks;
    const hubCoords = blocksData.transport_hubs[state.hub].coordinates;

    // 1. Filter by area, season, budget
    let candidates = blocks.filter(b => {
      const areaOk = state.area === 'all' || b.area === state.area;
      const seasonOk = b.season.includes(state.season) || b.season.includes('all');
      const budgetOk = b.budget <= state.budget;
      return areaOk && seasonOk && budgetOk;
    });

    // 2. Enrich with distance from hub and score
    candidates = candidates.map(b => {
      const typeScore = b.types.filter(tp => state.types.includes(tp)).length;
      const cityBoost = (state.cities.length > 0 && state.cities.includes(b.location)) ? 10 : 0;
      const distFromHub = haversine(hubCoords, b.coordinates);
      const rand = Math.random() * 1.5; // randomization for regeneration variety
      return { ...b, score: cityBoost + typeScore * 2 + rand, distFromHub };
    });

    // 3. Sort by score DESC
    candidates.sort((a, b) => b.score - a.score);

    // 4. Build days with progressive exploration + continuity + type variety
    const itinerary = [];
    const used = new Set();
    let prevDayEndCoords = hubCoords; // day-to-day continuity: start from hub

    for (let day = 0; day < state.days; day++) {
      const dayBlocks = [];
      let remaining = 2;

      // Progressive exploration: day 1 prefers near hub, later days can go farther
      // Max allowed distance grows with day index
      const maxDistFactor = 10 + day * 15; // day0: 10km, day1: 25km, day2: 40km...

      // Pick anchor: best unused that respects distance progression + area variety
      let anchor = null;
      const prevArea = itinerary.length > 0 ? itinerary[itinerary.length - 1][0]?.area : null;

      // First pass: respect distance + area variety
      for (const c of candidates) {
        if (used.has(c.id)) continue;
        if (c.distFromHub > maxDistFactor && candidates.some(x => !used.has(x.id) && x.distFromHub <= maxDistFactor)) continue;
        if (prevArea && prevArea === c.area && candidates.some(x => !used.has(x.id) && x.area !== prevArea && x.distFromHub <= maxDistFactor + 20)) continue;
        anchor = c;
        break;
      }
      // Second pass: relax area variety
      if (!anchor) {
        for (const c of candidates) {
          if (used.has(c.id)) continue;
          if (c.distFromHub > maxDistFactor && candidates.some(x => !used.has(x.id) && x.distFromHub <= maxDistFactor)) continue;
          anchor = c;
          break;
        }
      }
      // Third pass: any unused
      if (!anchor) anchor = candidates.find(c => !used.has(c.id));
      if (!anchor) break;

      const anchorSlots = anchor.duration === 'full' ? 2 : 1;
      dayBlocks.push(anchor);
      used.add(anchor.id);
      remaining -= anchorSlots;

      // Fill remaining slot: prefer nearby + different type + continuity from previous day
      if (remaining > 0) {
        const anchorTypes = new Set(anchor.types);

        // Score fill candidates
        const fillCandidates = candidates.filter(c => {
          if (used.has(c.id)) return false;
          if ((c.duration === 'full' ? 2 : 1) > remaining) return false;
          if (dayBlocks.some(db => c.avoid_with?.includes(db.id) || db.avoid_with?.includes(c.id))) return false;
          return true;
        }).map(c => {
          const dist = haversine(anchor.coordinates, c.coordinates);
          const proximityScore = Math.max(0, 5 - dist / 5); // closer = better, max 5pts
          const typeVariety = c.types.some(tp => !anchorTypes.has(tp)) ? 3 : 0; // reward different types
          const continuity = haversine(prevDayEndCoords, c.coordinates) < 15 ? 2 : 0; // near prev day end
          const combinedBonus = anchor.best_combined_with?.includes(c.id) ? 4 : 0;
          const sameLocationBonus = c.location === anchor.location ? 3 : 0;
          return { ...c, fillScore: c.score + proximityScore + typeVariety + continuity + combinedBonus + sameLocationBonus };
        });

        fillCandidates.sort((a, b) => b.fillScore - a.fillScore);

        for (const opt of fillCandidates) {
          if (remaining <= 0) break;
          const slots = opt.duration === 'full' ? 2 : 1;
          if (slots > remaining) continue;
          dayBlocks.push(opt);
          used.add(opt.id);
          remaining -= slots;
        }
      }

      if (dayBlocks.length > 0) {
        // Assign AM/PM slots
        const slotted = assignSlots(dayBlocks);
        itinerary.push(slotted);
        // Update continuity: last block's coordinates become the reference for next day
        const lastBlock = slotted[slotted.length - 1];
        prevDayEndCoords = lastBlock.coordinates;
      }
    }

    // Store itinerary for regeneration
    lastItinerary = itinerary;
    renderResults(itinerary);
  }

  // Store for regeneration
  let lastItinerary = null;

  // --- Lazy load Leaflet and SortableJS ---
  let leafletLoaded = false;
  let sortableLoaded = false;

  async function loadLeaflet() {
    if (leafletLoaded) return;
    // CSS
    const link = document.createElement('link');
    link.rel = 'stylesheet'; link.href = '/css/leaflet.css';
    document.head.appendChild(link);
    // JS
    const script = document.createElement('script');
    script.src = '/js/leaflet.js';
    document.head.appendChild(script);
    await new Promise((resolve, reject) => { script.onload = resolve; script.onerror = reject; });
    leafletLoaded = true;
  }

  async function loadSortable() {
    if (sortableLoaded) return;
    const script = document.createElement('script');
    script.src = '/js/sortablejs.min.js';
    document.head.appendChild(script);
    await new Promise((resolve, reject) => { script.onload = resolve; script.onerror = reject; });
    sortableLoaded = true;
  }

  // --- Build block lookup from data ---
  function getBlockById(id) {
    return blocksData.blocks.find(b => b.id === id);
  }

  // --- Compute total cost from itinerary ---
  function computeTotalCost(itinerary) {
    let total = 0;
    itinerary.flat().forEach(block => {
      const transport = block.transport_from[state.hub];
      if (transport) total += transport.cost;
      total += block.budget === 1 ? 20 : block.budget === 2 ? 50 : 90;
    });
    return total;
  }

  // --- Save / Restore from localStorage ---
  const STORAGE_KEY = 'planner_itinerary_v1';

  function saveToLocalStorage(itinerary) {
    const data = {
      state: { hub: state.hub, days: state.days, budget: state.budget, season: state.season, types: state.types, area: state.area, cities: state.cities },
      blocks: itinerary.map(day => day.map(b => ({ id: b.id, slot: b.slot }))),
      ts: Date.now()
    };
    localStorage.setItem(STORAGE_KEY, JSON.stringify(data));
  }

  function restoreFromLocalStorage() {
    try {
      const raw = localStorage.getItem(STORAGE_KEY);
      if (!raw) return null;
      const data = JSON.parse(raw);
      // Expire after 7 days
      if (Date.now() - data.ts > 7 * 24 * 60 * 60 * 1000) { localStorage.removeItem(STORAGE_KEY); return null; }
      return data;
    } catch { return null; }
  }

  // --- Build shareable URL ---
  function buildShareUrl(itinerary) {
    const ids = itinerary.map(day => day.map(b => b.id).join('.')).join('_');
    const params = new URLSearchParams({
      h: state.hub, d: state.days, b: state.budget, s: state.season,
      t: state.types.join('.'), a: state.area, i: ids
    });
    if (state.cities.length) params.set('c', state.cities.join('.'));
    return `${window.location.origin}${window.location.pathname}?${params.toString()}`;
  }

  // --- Restore from URL params ---
  function restoreFromUrl() {
    const params = new URLSearchParams(window.location.search);
    if (!params.has('h') || !params.has('i')) return null;
    return {
      state: {
        hub: params.get('h'), days: parseInt(params.get('d')), budget: parseInt(params.get('b')),
        season: params.get('s'), types: params.get('t').split('.'), area: params.get('a') || 'all',
        cities: params.has('c') ? params.get('c').split('.') : []
      },
      blockIds: params.get('i').split('_').map(day => day.split('.'))
    };
  }

  // --- Rebuild itinerary from block IDs ---
  function rebuildItinerary(blockIdsByDay) {
    return blockIdsByDay.map(dayIds => {
      const dayBlocks = dayIds.map(id => {
        const block = getBlockById(id);
        return block ? { ...block } : null;
      }).filter(Boolean);
      return assignSlots(dayBlocks);
    }).filter(day => day.length > 0);
  }

  // --- Read itinerary from DOM after drag & drop ---
  function readItineraryFromDom() {
    const dayContainers = document.querySelectorAll('.sortable-day');
    const newItinerary = [];
    dayContainers.forEach(container => {
      const cards = container.querySelectorAll('[data-block-id]');
      const dayBlocks = [];
      cards.forEach(card => {
        const block = getBlockById(card.dataset.blockId);
        if (block) dayBlocks.push({ ...block });
      });
      if (dayBlocks.length > 0) newItinerary.push(assignSlots(dayBlocks));
    });
    lastItinerary = newItinerary;
    // Update slot badges in DOM
    dayContainers.forEach((container, di) => {
      if (!newItinerary[di]) return;
      const cards = container.querySelectorAll('[data-block-id]');
      cards.forEach((card, bi) => {
        const block = newItinerary[di][bi];
        if (!block) return;
        const badge = card.querySelector('.slot-badge');
        if (badge) {
          const slotLabels = { am: t('morning'), pm: t('afternoon'), full: t('morning') + ' + ' + t('afternoon') };
          badge.textContent = slotLabels[block.slot] || '';
        }
      });
    });
    // Update cost
    const costEl = document.getElementById('planner-total-cost');
    if (costEl) costEl.textContent = `${t('cost_label')}: ~€${computeTotalCost(newItinerary)}`;
    // Auto-save
    saveToLocalStorage(newItinerary);
  }

  // --- Map colors per day ---
  const dayColors = ['#d4af37', '#7ca0c4', '#c9a96e', '#8bb5a2', '#b8956a', '#94a3b8', '#d4af37'];

  // --- Render results ---
  async function renderResults(itinerary) {
    const container = document.getElementById('planner-results');

    if (itinerary.length === 0) {
      container.innerHTML = `<p class="text-center py-8" style="color:rgba(255,255,255,0.5)">${t('no_results')}</p>`;
      return;
    }

    // Load Leaflet + SortableJS in parallel
    await Promise.all([loadLeaflet(), loadSortable()]);

    const totalCost = computeTotalCost(itinerary);
    let html = '';

    // Map container
    html += `<div id="planner-map" style="height:300px;border-radius:16px;margin-bottom:28px;z-index:1;position:relative;border:1px solid rgba(255,255,255,0.08);box-shadow:0 4px 24px rgba(0,0,0,0.3)"></div>`;

    // Day cards with sortable containers
    const slotLabels = { am: t('morning'), pm: t('afternoon'), full: t('morning') + ' + ' + t('afternoon') };
    const modeIcons = { ferry: '⛴', bus: '🚌', train: '🚆', walk: '🚶' };
    const areaLabels = { costiera: t('area_costiera'), penisola: t('area_penisola'), isole: t('area_isole') };

    itinerary.forEach((dayBlocks, i) => {
      const color = dayColors[i % dayColors.length];
      // Determine day area: if all blocks share the same area, show it
      const dayAreas = [...new Set(dayBlocks.map(b => b.area))];
      const dayAreaLabel = dayAreas.length === 1 && areaLabels[dayAreas[0]] ? areaLabels[dayAreas[0]] : '';
      const areaHtml = dayAreaLabel ? `<span style="font-size:13px;font-weight:400;color:rgba(255,255,255,0.45);margin-left:4px">— ${dayAreaLabel}</span>` : '';
      html += `<div class="mb-8">`;
      html += `<h3 class="font-display text-xl font-bold mb-4 flex items-center gap-3" style="color:${color}"><span style="display:inline-flex;align-items:center;justify-content:center;width:32px;height:32px;border-radius:50%;background:${color};color:#fff;font-size:14px;font-weight:700">${i + 1}</span>${t('day_label')} ${i + 1}${areaHtml}</h3>`;
      html += `<div class="sortable-day space-y-5" data-day="${i}">`;

      dayBlocks.forEach(block => {
        const transport = block.transport_from[state.hub];
        const slotLabel = block.slot ? (slotLabels[block.slot] || '') : '';
        const isEvent = block.types && block.types.includes('evento');
        const accentColor = block.slot === 'pm' ? '#60a5fa' : '#d4af37';

        // --- Card container with left accent ---
        html += `<div style="background:rgba(255,255,255,0.03);border:1px solid rgba(255,255,255,0.07);border-left:3px solid ${accentColor};box-shadow:0 2px 16px rgba(0,0,0,0.12)" class="rounded-xl" data-block-id="${block.id}">`;

        // --- Top section: slot, time, drag ---
        html += `<div style="padding:20px 24px 0;display:flex;align-items:flex-start;justify-content:space-between">`;
        html += `<div>`;
        if (slotLabel) html += `<div class="slot-badge" style="font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:0.08em;color:${accentColor};margin-bottom:2px">${slotLabel}</div>`;
        if (block.suggested_time) html += `<div style="font-size:13px;font-weight:600;color:rgba(255,255,255,0.7);font-variant-numeric:tabular-nums">${block.suggested_time}</div>`;
        if (isEvent) html += `<span style="display:inline-block;font-size:10px;font-weight:600;color:#f87171;background:rgba(220,38,38,0.12);padding:2px 8px;border-radius:6px;margin-top:4px">${t('event_label')}</span>`;
        html += `</div>`;
        html += `<div style="padding:2px;color:rgba(255,255,255,0.15);cursor:grab;touch-action:none" class="drag-handle"><svg width="14" height="14" fill="currentColor" viewBox="0 0 16 16"><circle cx="5" cy="3" r="1.5"/><circle cx="11" cy="3" r="1.5"/><circle cx="5" cy="8" r="1.5"/><circle cx="11" cy="8" r="1.5"/><circle cx="5" cy="13" r="1.5"/><circle cx="11" cy="13" r="1.5"/></svg></div>`;
        html += `</div>`;

        // --- Title + description ---
        html += `<div style="padding:14px 24px 0">`;
        html += `<h4 style="font-size:17px;font-weight:700;color:#fff;margin:0 0 8px;line-height:1.35">${block.name[langKey]}</h4>`;
        html += `<p style="font-size:13.5px;line-height:1.7;color:rgba(255,255,255,0.5);margin:0">${block.description[langKey]}</p>`;
        html += `</div>`;

        // --- Highlights ---
        html += `<div style="padding:14px 24px 0;display:flex;flex-wrap:wrap;gap:6px;justify-content:center">`;
        block.highlights.forEach(h => {
          html += `<span style="font-size:11px;font-weight:500;color:rgba(255,255,255,0.6);background:rgba(255,255,255,0.06);padding:5px 12px;border-radius:20px">${h}</span>`;
        });
        html += `</div>`;

        // --- Footer: divider + guide & transport ---
        html += `<div style="margin:16px 24px 0;border-top:1px solid rgba(255,255,255,0.06)"></div>`;
        html += `<div style="padding:12px 24px 16px;display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:8px">`;
        if (block.guide_link) {
          html += `<a href="${block.guide_link}" style="display:inline-flex;align-items:center;gap:5px;font-size:13px;color:${accentColor};font-weight:600;text-decoration:none;transition:opacity 0.2s" onmouseover="this.style.opacity='0.7'" onmouseout="this.style.opacity='1'">${t('discover')} <svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3"/></svg></a>`;
        } else {
          html += `<span></span>`;
        }
        if (transport && transport.time > 0) {
          html += `<span style="display:inline-flex;align-items:center;gap:5px;font-size:12px;font-weight:500;color:rgba(255,255,255,0.4)">${modeIcons[transport.mode] || ''} ${transport.time} ${t('time_min')} · €${transport.cost}</span>`;
        }
        html += `</div>`;

        html += `</div>`; // end card
      });

      html += `</div></div>`;
    });

    // Total cost
    html += `<div class="mt-8 p-5 rounded-2xl" style="background:rgba(255,255,255,0.04);backdrop-filter:blur(16px);border:1px solid rgba(212,175,55,0.2);box-shadow:0 4px 24px rgba(0,0,0,0.2)">`;
    html += `<p class="font-semibold text-white text-lg" id="planner-total-cost">${t('cost_label')}: <span class="text-med-gold">~€${totalCost}</span> <span class="font-normal text-sm" style="color:rgba(255,255,255,0.4)">(${t('transport')} + attività)</span></p>`;
    html += `</div>`;

    // Action buttons row — after cards so user sees itinerary first
    html += `<div class="grid grid-cols-1 sm:grid-cols-3 gap-3 mt-6">`;
    html += `<button id="regenerate-btn" style="background:rgba(255,255,255,0.06);border:1px solid rgba(255,255,255,0.12);backdrop-filter:blur(12px)" class="inline-flex items-center justify-center gap-2 px-4 py-3 text-white text-sm font-semibold rounded-xl transition-all hover:border-white/30 hover:bg-white/10">`;
    html += `<svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0l3.181 3.183a8.25 8.25 0 0013.803-3.7M4.031 9.865a8.25 8.25 0 0113.803-3.7l3.181 3.182"/></svg>`;
    html += `${t('regenerate')}</button>`;
    html += `<button id="share-wa-btn" style="background:rgba(212,175,55,0.15);border:1px solid rgba(212,175,55,0.4)" class="inline-flex items-center justify-center gap-2 px-4 py-3 text-med-gold text-sm font-semibold rounded-xl transition-all hover:bg-[rgba(212,175,55,0.25)] hover:shadow-[0_0_16px_rgba(212,175,55,0.15)]">`;
    html += `<svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>`;
    html += `${t('share_wa')}</button>`;
    html += `<button id="download-pdf-btn" style="background:rgba(37,99,235,0.15);border:1px solid rgba(37,99,235,0.4)" class="inline-flex items-center justify-center gap-2 px-4 py-3 text-blue-400 text-sm font-semibold rounded-xl transition-all hover:bg-[rgba(37,99,235,0.25)] hover:shadow-[0_0_16px_rgba(37,99,235,0.15)]">`;
    html += `<svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5M16.5 12L12 16.5m0 0L7.5 12m4.5 4.5V3"/></svg>`;
    html += `${t('download_pdf')}</button>`;
    html += `</div>`;

    container.innerHTML = html;

    // --- Init Leaflet map ---
    const L = window.L;
    const map = L.map('planner-map', { scrollWheelZoom: false, attributionControl: true });
    L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
      attribution: '&copy; OpenStreetMap',
      maxZoom: 17
    }).addTo(map);

    const allMarkers = [];
    itinerary.forEach((dayBlocks, di) => {
      const color = dayColors[di % dayColors.length];
      dayBlocks.forEach((block, bi) => {
        const [lat, lng] = block.coordinates;
        const icon = L.divIcon({
          className: '',
          html: `<div style="display:flex;align-items:center;justify-content:center;width:28px;height:28px;border-radius:50%;background:${color};color:#fff;font-weight:700;font-size:12px;border:2px solid #fff;box-shadow:0 2px 6px rgba(0,0,0,.3)">${di + 1}</div>`,
          iconSize: [28, 28],
          iconAnchor: [14, 14]
        });
        const marker = L.marker([lat, lng], { icon }).addTo(map);
        marker.bindPopup(`<b>${t('day_label')} ${di + 1}</b><br>${block.name[langKey]}`);
        allMarkers.push([lat, lng]);
      });
      // Draw route line per day
      if (dayBlocks.length > 1) {
        const latlngs = dayBlocks.map(b => b.coordinates);
        L.polyline(latlngs, { color, weight: 3, opacity: 0.6, dashArray: '8 4' }).addTo(map);
      }
    });

    // Fit bounds
    if (allMarkers.length > 0) {
      map.fitBounds(allMarkers, { padding: [30, 30] });
    }

    // --- Init SortableJS drag & drop ---
    const Sortable = window.Sortable;
    document.querySelectorAll('.sortable-day').forEach(el => {
      Sortable.create(el, {
        group: 'itinerary-days',
        animation: 200,
        handle: '.drag-handle',
        ghostClass: 'planner-drag-ghost',
        chosenClass: 'planner-drag-chosen',
        onEnd: () => readItineraryFromDom()
      });
    });

    // --- Regenerate handler ---
    document.getElementById('regenerate-btn').addEventListener('click', async () => {
      container.innerHTML = `
        <div style="text-align:center;padding:60px 20px">
          <div style="display:inline-block;width:48px;height:48px;border:4px solid rgba(212,175,55,0.2);border-top-color:#d4af37;border-radius:50%;animation:planner-spin 0.8s linear infinite"></div>
          <p style="color:#cbd5e1;margin-top:16px;font-size:15px">${t('generating')}</p>
        </div>`;
      await new Promise(r => setTimeout(r, 800));
      generateItinerary();
      document.getElementById('trip-planner').scrollIntoView({ behavior: 'smooth' });
      if (typeof window.gtag === 'function') {
        window.gtag('event', 'planner_regenerate', { days: state.days });
      }
    });


    // --- WhatsApp share handler ---
    document.getElementById('share-wa-btn').addEventListener('click', () => {
      let text = `${t('title')}\n\n`;
      const itin = lastItinerary || itinerary;
      const cost = computeTotalCost(itin);
      itin.forEach((dayBlocks, i) => {
        text += `📅 ${t('day_label')} ${i + 1}\n`;
        dayBlocks.forEach(block => {
          const slotEmoji = block.slot === 'am' ? '🌅' : block.slot === 'pm' ? '🌇' : '📍';
          const timeStr = block.suggested_time ? ` (${block.suggested_time})` : '';
          text += `${slotEmoji} ${block.name[langKey]}${timeStr}\n`;
        });
        text += `\n`;
      });
      text += `💰 ${t('cost_label')}: ~€${cost}\n`;
      text += `\n🌐 amalficoast-travel.com`;
      window.open(`https://wa.me/?text=${encodeURIComponent(text)}`, '_blank');
      if (typeof window.gtag === 'function') {
        window.gtag('event', 'planner_share', { method: 'whatsapp', days: state.days });
      }
    });

    // --- PDF download handler ---
    document.getElementById('download-pdf-btn').addEventListener('click', async () => {
      const itin = lastItinerary || itinerary;
      const cost = computeTotalCost(itin);
      try {
      if (!window.jspdf) {
        const script = document.createElement('script');
        script.src = '/js/jspdf.umd.min.js';
        document.head.appendChild(script);
        await new Promise((resolve, reject) => { script.onload = resolve; script.onerror = reject; });
      }
      const { jsPDF } = window.jspdf;
      const doc = new jsPDF();

      doc.setFillColor(30, 41, 59);
      doc.rect(0, 0, 210, 35, 'F');
      doc.setTextColor(212, 175, 55);
      doc.setFontSize(20);
      doc.setFont('helvetica', 'bold');
      doc.text(t('title'), 15, 22);
      doc.setFontSize(10);
      doc.setTextColor(200, 200, 200);
      doc.text('amalficoast-travel.com', 15, 30);

      let y = 45;

      itin.forEach((dayBlocks, i) => {
        if (y > 260) { doc.addPage(); y = 20; }
        doc.setFontSize(14);
        doc.setFont('helvetica', 'bold');
        doc.setTextColor(212, 175, 55);
        doc.text(`${t('day_label')} ${i + 1}`, 15, y);
        y += 8;

        dayBlocks.forEach(block => {
          if (y > 260) { doc.addPage(); y = 20; }
          const slotText = block.slot === 'am' ? t('morning') : block.slot === 'pm' ? t('afternoon') : (t('morning') + ' + ' + t('afternoon'));
          doc.setFontSize(8);
          doc.setFont('helvetica', 'bold');
          doc.setTextColor(212, 175, 55);
          const timeLabel = block.suggested_time ? `  (${block.suggested_time})` : '';
          doc.text(slotText.toUpperCase() + timeLabel, 20, y);
          y += 4;
          doc.setFontSize(11);
          doc.setFont('helvetica', 'bold');
          doc.setTextColor(30, 41, 59);
          doc.text(block.name[langKey], 20, y);
          y += 5;
          doc.setFontSize(9);
          doc.setFont('helvetica', 'normal');
          doc.setTextColor(80, 80, 80);
          const descLines = doc.splitTextToSize(block.description[langKey], 165);
          doc.text(descLines, 20, y);
          y += descLines.length * 4 + 2;
          const transport = block.transport_from[state.hub];
          if (transport && transport.time > 0) {
            doc.setFontSize(8);
            doc.setTextColor(120, 120, 120);
            doc.text(`${t('transport')}: ${transport.time} ${t('time_min')} | €${transport.cost}`, 20, y);
            y += 4;
          }
          y += 4;
        });
        y += 4;
      });

      if (y > 260) { doc.addPage(); y = 20; }
      doc.setDrawColor(200, 200, 200);
      doc.line(15, y, 195, y);
      y += 8;
      doc.setFontSize(12);
      doc.setFont('helvetica', 'bold');
      doc.setTextColor(30, 41, 59);
      doc.text(`${t('cost_label')}: ~€${cost}`, 15, y);

      doc.save('itinerario-amalfi-coast.pdf');
      if (typeof window.gtag === 'function') {
        window.gtag('event', 'planner_download', { format: 'pdf', days: state.days });
      }
      } catch (e) {
        console.error('PDF generation failed:', e);
        let content = `${t('title')}\n${'='.repeat(30)}\n\n`;
        itin.forEach((dayBlocks, i) => {
          content += `${t('day_label')} ${i + 1}\n${'-'.repeat(20)}\n`;
          dayBlocks.forEach(block => {
            const slotText = block.slot === 'am' ? t('morning') : block.slot === 'pm' ? t('afternoon') : t('morning') + ' + ' + t('afternoon');
            content += `[${slotText}] ${block.name[langKey]}\n  ${block.description[langKey]}\n\n`;
          });
        });
        content += `${t('cost_label')}: ~€${cost}\namalficoast-travel.com`;
        const blob = new Blob([content], { type: 'text/plain;charset=utf-8' });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url; a.download = 'itinerario-amalfi-coast.txt'; a.click();
        URL.revokeObjectURL(url);
      }
    });

    // localStorage save removed — always start fresh
  }

  // --- Check URL params or localStorage on load ---
  async function checkRestore() {
    // URL params take priority
    const urlData = restoreFromUrl();
    if (urlData) {
      if (!blocksData) await loadData();
      Object.assign(state, urlData.state);
      const restored = rebuildItinerary(urlData.blockIds);
      if (restored.length > 0) {
        lastItinerary = restored;
        showStep(3);
        await renderResults(restored);
        return;
      }
    }
    // Clear any old localStorage data
    try { localStorage.removeItem(STORAGE_KEY); } catch {}
  }

  // Preload data + check restore
  loadData().then(() => checkRestore());
</script>
