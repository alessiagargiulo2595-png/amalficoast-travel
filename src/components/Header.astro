---

<header id="main-nav" class="fixed top-0 left-0 right-0 z-50 transition-all duration-700">
  <!-- Mobile Navbar (simple white bar) -->
  <div class="lg:hidden bg-white border-b border-slate-100 shadow-[0_4px_30px_rgba(0,0,0,0.03)]">
    <div class="flex items-center justify-between h-20 px-6">
      <!-- Logo -->
      <a href={`/${lang}/`} class="flex-shrink-0">
        <img src="/logo.svg" alt="Amalfi Coast Travel Guide" class="h-10 w-auto" />
      </a>
      <!-- Mobile hamburger -->
      <button id="mobile-menu-btn" class="p-2 rounded-xl text-med-blue hover:bg-slate-100" aria-label="Menu">
        <svg id="icon-open" class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16"/>
        </svg>
        <svg id="icon-close" class="w-5 h-5 hidden" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
        </svg>
      </button>
    </div>
  </div>

  <div class="nav-inner transition-all duration-700 max-w-7xl mx-auto px-6">
    <div class="nav-bar hidden lg:flex transition-all duration-700 shadow-[0_4px_30px_rgba(0,0,0,0.03)] items-center justify-between h-20 px-8">

      <!-- Logo -->
      <a href={`/${lang}/`} class="flex-shrink-0">
        <img src="/logo.svg" alt="Amalfi Coast Travel Guide" class="h-10 w-auto" />
      </a>

      <!-- Desktop Nav (mega dropdown - all locales) -->
      <nav class="hidden lg:flex items-center gap-1">

        <!-- Destinazioni mega-dropdown -->
        <button data-menu="dest" class="flex items-center gap-2 px-8 py-6 text-[10px] font-bold tracking-[0.25em] uppercase text-slate-900 hover:text-med-blue transition-colors cursor-pointer">
          {nav.dest}
          <svg class="w-3.5 h-3.5 opacity-50 hover:opacity-100 transition-transform duration-200" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
          </svg>
        </button>

        <!-- Spiagge dropdown -->
        <button data-menu="spiagge" class="flex items-center gap-2 px-8 py-6 text-[10px] font-bold tracking-[0.25em] uppercase text-slate-900 hover:text-med-blue transition-colors cursor-pointer">
          {nav.spiagge}
          <svg class="w-3.5 h-3.5 opacity-50 hover:opacity-100 transition-transform duration-200" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
          </svg>
        </button>

        <!-- Guida Pratica -->
        <button data-menu="guida" class="flex items-center gap-2 px-8 py-6 text-[10px] font-bold tracking-[0.25em] uppercase text-slate-900 hover:text-med-blue transition-colors cursor-pointer">
          {nav.guida}
          <svg class="w-3.5 h-3.5 opacity-50 hover:opacity-100 transition-transform duration-200" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
          </svg>
        </button>

        <!-- Esperienze -->
        <button data-menu="esp" class="flex items-center gap-2 px-8 py-6 text-[10px] font-bold tracking-[0.25em] uppercase text-slate-900 hover:text-med-blue transition-colors cursor-pointer">
          {nav.esp}
          <svg class="w-3.5 h-3.5 opacity-50 hover:opacity-100 transition-transform duration-200" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
          </svg>
        </button>

        <!-- Eventi -->
        <button data-menu="ev" class="flex items-center gap-2 px-8 py-6 text-[10px] font-bold tracking-[0.25em] uppercase text-slate-900 hover:text-med-blue transition-colors cursor-pointer">
          {nav.ev}
          <svg class="w-3.5 h-3.5 opacity-50 hover:opacity-100 transition-transform duration-200" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
          </svg>
        </button>

      <!-- Right: Language + CTA -->
      <div class="flex items-center gap-4">

        <!-- Language Switcher (world icon - desktop only) -->
        <div class="hidden lg:block relative group/lang">
          <button id="lang-selector-btn" class="flex items-center justify-center w-10 h-10 rounded-full transition-all duration-200 hover:bg-white/20" title="Select language" aria-label="Language selector">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <circle cx="12" cy="12" r="10"/><path d="M2 12h20M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>
            </svg>
          </button>
          <div id="lang-dropdown" class="fixed right-6 top-24 w-48 bg-white rounded-xl shadow-xl border border-slate-100 overflow-hidden opacity-0 invisible group-hover/lang:opacity-100 group-hover/lang:visible transition-all duration-200 z-[100] py-2">
            {locales.map(l => {
              const pageExists = pageKey && existingPages[l].includes(pageKey);
              const fullPathname = Astro.url.pathname.startsWith('/') && !Astro.url.pathname.split('/')[1]?.match(/[a-z]{2}-[a-z]{2}/)
                ? `/${lang}${Astro.url.pathname}`
                : Astro.url.pathname;
              const href = pageExists ? getLocalePath(l, pageKey!) : translatePath(fullPathname, lang, l);
              return (
                <a href={href} class={`flex items-center justify-center px-3 py-2.5 text-xs font-semibold transition-colors ${l === lang ? 'bg-med-blue/10 text-med-blue' : 'text-slate-700 hover:bg-slate-50'}`} title={countryCodeMap[l]}>
                  {countryCodeMap[l]}
                </a>
              );
            })}
          </div>
        </div>
      </div>
    </div>
    </div>
  </div>

  <!-- Mega Menu (hidden, shown via JS) -->
  <div id="mega-menu" class="hidden fixed left-0 right-0 top-20 z-[51] rounded-b-2xl overflow-hidden">
    <div class="bg-white w-full shadow-[0_20px_50px_rgba(0,0,0,0.1)] border-b border-slate-100">
      <div class="max-w-7xl mx-auto flex min-h-[280px] relative">
        <!-- Data menu containers - rendered hidden, shown via JS -->

        {/* DESTINAZIONI */}
        <div data-menu-id="dest" class="hidden w-full flex">
          <!-- Sidebar -->
          <div class="w-[320px] flex-shrink-0 bg-slate-50/50 p-8 flex flex-col justify-between border-r border-slate-100">
            <div class="pt-8">
              <h3 class="font-serif text-5xl italic text-med-gold mb-6">{nav.dest}</h3>
              <div class="w-12 h-px bg-med-gold/30 mb-8"></div>
              <p class="text-slate-400 text-[11px] leading-relaxed uppercase tracking-[0.3em] font-medium">Scopri destinazioni affascinanti</p>
