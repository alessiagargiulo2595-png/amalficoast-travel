<style>
  .mob-overlay-anim {
    animation: mobFadeIn 200ms ease-out;
  }
  @keyframes mobFadeIn {
    from { opacity: 0; transform: translateY(-8px); }
    to { opacity: 1; transform: translateY(0); }
  }
</style>

<script is:inline>
  // Search button handlers
  document.getElementById('desktop-search-btn')?.addEventListener('click', () => {
    if (window.__openSearch) window.__openSearch();
  });
  document.getElementById('mobile-search-btn')?.addEventListener('click', () => {
    if (window.__openSearch) window.__openSearch();
  });

  // Mobile menu
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('icon-open');
  const iconClose = document.getElementById('icon-close');
  const closeBtn = document.getElementById('mob-close-btn');
  const slideWrap = document.getElementById('mob-slide-wrap');
  const backBtn = document.getElementById('mob-back-btn');
  const backLabel = document.getElementById('mob-back-label');

  // Category label map for back button
  const catLabels = {};
  document.querySelectorAll('.mob-cat-btn').forEach(b => {
    catLabels[b.getAttribute('data-mob-panel')] = b.querySelector('span')?.textContent?.trim() || b.textContent.trim();
  });

  function openMobMenu() {
    menu?.classList.remove('hidden');
    document.body.style.overflow = 'hidden';
    iconOpen?.classList.add('hidden');
    iconClose?.classList.remove('hidden');
  }

  function closeMobMenu() {
    menu?.classList.add('hidden');
    document.body.style.overflow = '';
    iconOpen?.classList.remove('hidden');
    iconClose?.classList.add('hidden');
    // Reset to root panel
    if (slideWrap) slideWrap.style.transform = 'translateX(0)';
    document.querySelectorAll('.mob-sub-panel').forEach(p => p.classList.add('hidden'));
  }

  btn?.addEventListener('click', () => {
    if (menu?.classList.contains('hidden')) openMobMenu();
    else closeMobMenu();
  });

  closeBtn?.addEventListener('click', closeMobMenu);

  // ESC to close
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !menu?.classList.contains('hidden')) closeMobMenu();
  });

  // Slide to sub-panel
  const rootPanel = slideWrap?.children[0];
  const subPanel = slideWrap?.children[1];

  document.querySelectorAll('.mob-cat-btn').forEach(b => {
    b.addEventListener('click', () => {
      const panelId = b.getAttribute('data-mob-panel');
      document.querySelectorAll('.mob-sub-panel').forEach(p => p.classList.add('hidden'));
      const target = document.getElementById('mob-sub-' + panelId);
      if (target) target.classList.remove('hidden');
      if (backLabel) backLabel.textContent = catLabels[panelId] || '';
      // Slide right + fade in sub-panel
      if (slideWrap) slideWrap.style.transform = 'translateX(-50%)';
      if (rootPanel) rootPanel.style.opacity = '0.3';
      if (subPanel) { subPanel.style.opacity = '0'; requestAnimationFrame(() => { subPanel.style.transition = 'opacity 200ms ease'; subPanel.style.opacity = '1'; }); }
    });
  });

  // Slide back to root
  backBtn?.addEventListener('click', () => {
    if (slideWrap) slideWrap.style.transform = 'translateX(0)';
    if (rootPanel) { rootPanel.style.transition = 'opacity 250ms ease'; rootPanel.style.opacity = '1'; rootPanel.scrollTop = 0; }
    if (subPanel) subPanel.scrollTop = 0;
  });

  // Header scroll effect
  const nav = document.getElementById('main-nav');
  const navInner = nav?.querySelector('.nav-inner');
  const navBar = nav?.querySelector('.nav-bar');
  const megaMenu = document.getElementById('mega-menu');

  window.addEventListener('scroll', () => {
    const scrolled = window.scrollY > 50;

    if (scrolled) {
      nav?.classList.add('scrolled');
      navInner?.classList.remove('max-w-7xl', 'mx-auto', 'px-6');
      navInner?.classList.add('max-w-none', 'px-0');
      megaMenu?.classList.remove('rounded-b-2xl');
      megaMenu?.classList.add('rounded-none');
    } else {
      nav?.classList.remove('scrolled');
      navInner?.classList.add('max-w-7xl', 'mx-auto', 'px-6');
      navInner?.classList.remove('max-w-none', 'px-0');
      megaMenu?.classList.add('rounded-b-2xl');
      megaMenu?.classList.remove('rounded-none');
    }
  });

  // Menu visibility (DESKTOP ONLY)
  if (megaMenu) {
    let activeMenu = null;
    let hoverTimer = null;

    function showMenu(menuId) {
      // Hide all menu sections
      document.querySelectorAll('[data-menu-id]').forEach(m => {
        m.classList.add('hidden');
        m.style.display = 'none';
      });
      // Show target menu
      const menu = document.querySelector(`[data-menu-id="${menuId}"]`);
      if (menu) {
        menu.classList.remove('hidden');
        menu.style.display = 'flex';
      }
      // Show mega menu container
      megaMenu.classList.remove('hidden');
      megaMenu.style.display = 'block';
      activeMenu = menuId;
    }

    function hideMenu() {
      // Hide all menu sections
      document.querySelectorAll('[data-menu-id]').forEach(m => {
        m.classList.add('hidden');
        m.style.display = 'none';
      });
      // Hide mega menu container
      megaMenu.classList.add('hidden');
      megaMenu.style.display = 'none';
      activeMenu = null;
    }

    // Attach listeners to all menu buttons
    const menuButtons = document.querySelectorAll('[data-menu]');
    menuButtons.forEach(btn => {
      // Mouseenter: show menu on hover with delay to prevent accidental switching
      btn.addEventListener('mouseenter', () => {
        clearTimeout(hoverTimer);
        const menuId = btn.getAttribute('data-menu');
        if (menuId) {
          hoverTimer = setTimeout(() => {
            showMenu(menuId);
          }, 200);
        }
      });

      // Mouseleave: cancel timer if mouse leaves before delay completes
      btn.addEventListener('mouseleave', () => {
        clearTimeout(hoverTimer);
      });

      // Click: toggle menu
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        clearTimeout(hoverTimer);
        const menuId = btn.getAttribute('data-menu');
        if (menuId && activeMenu === menuId) {
          hideMenu();
        } else if (menuId) {
          showMenu(menuId);
        }
      });
    });

    // Hide menu when mouse leaves header + menu area
    nav?.addEventListener('mouseleave', () => {
      clearTimeout(hoverTimer);
      hideMenu();
    });

    // Hide menu on escape key
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && activeMenu) {
        clearTimeout(hoverTimer);
        hideMenu();
      }
    });
  }
</script>
