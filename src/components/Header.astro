  'de-de': [{ name: 'Zitronenfest (Massa)', href: '/de-de/veranstaltungen/sorrentinische-halbinsel/sagra-limone-massa-lubrense/' }, { name: 'Auberginenfest', href: '/de-de/veranstaltungen/sorrentinische-halbinsel/sagra-melanzana-preazzano/' }, { name: 'Fischfest (Positano)', href: '/de-de/veranstaltungen/amalfikueste/sagra-del-pesce-positano/' }, { name: 'Zitronenfest (Minori)', href: '/de-de/veranstaltungen/amalfikueste/festival-limone-minori/' }, { name: 'Gustamincanto', href: '/de-de/veranstaltungen/sorrentinische-halbinsel/gustamincanto-vico-equense/' }],
  'fr-fr': [{ name: 'Fête du Citron (Massa)', href: '/fr-fr/evenements/peninsule-sorrentine/sagra-limone-massa-lubrense/' }, { name: "Fête de l'Aubergine", href: '/fr-fr/evenements/peninsule-sorrentine/sagra-melanzana-preazzano/' }, { name: 'Fête du Poisson (Positano)', href: '/fr-fr/evenements/cote-amalfitaine/sagra-del-pesce-positano/' }, { name: 'Fête du Citron (Minori)', href: '/fr-fr/evenements/cote-amalfitaine/festival-limone-minori/' }, { name: 'Gustamincanto', href: '/fr-fr/evenements/peninsule-sorrentine/gustamincanto-vico-equense/' }],
  'es-es': [{ name: 'Festival del Limón (Massa)', href: '/es-es/eventos/peninsula-sorrentina/sagra-limone-massa-lubrense/' }, { name: 'Festival de la Berenjena', href: '/es-es/eventos/peninsula-sorrentina/sagra-melanzana-preazzano/' }, { name: 'Fiesta del Pescado (Positano)', href: '/es-es/eventos/costa-amalfitana/sagra-del-pesce-positano/' }, { name: 'Festival del Limón (Minori)', href: '/es-es/eventos/costa-amalfitana/festival-limone-minori/' }, { name: 'Gustamincanto', href: '/es-es/eventos/peninsula-sorrentina/gustamincanto-vico-equense/' }],
  'it-it': [
    { name: 'Sagra del Limone (Massa)',    href: '/it-it/eventi/penisola-sorrentina/sagra-limone-massa-lubrense/' },
    { name: 'Sagra della Melanzana',       href: '/it-it/eventi/penisola-sorrentina/sagra-melanzana-preazzano/' },
    { name: 'Sagra del Pesce (Positano)',  href: '/it-it/eventi/costiera-amalfitana/sagra-del-pesce-positano/' },
    { name: 'Festival del Limone (Minori)',href: '/it-it/eventi/costiera-amalfitana/festival-limone-minori/' },
    { name: 'Gustamincanto',               href: '/it-it/eventi/penisola-sorrentina/gustamincanto-vico-equense/' },
  ],
} as const)[lang];
---

<header id="main-nav" class="fixed top-0 left-0 right-0 z-50 transition-all duration-700">
  <!-- Mobile Navbar (simple white bar) -->
  <div class="lg:hidden bg-white border-b border-slate-100 shadow-[0_4px_30px_rgba(0,0,0,0.03)]">
    <div class="flex items-center justify-between h-20 px-6">
      <!-- Logo -->
      <a href={`/${lang}/`} class="flex-shrink-0">
        <img src="/logo.svg" alt={amalfiCoastGuideAlt} class="h-10 w-auto" />
      </a>
      <div class="flex items-center gap-2">
        <!-- Mobile search button -->
        <button id="mobile-search-btn" class="p-2 rounded-xl text-slate-500 hover:text-med-blue hover:bg-slate-100 transition-colors" aria-label="Search">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
          </svg>
        </button>
        <!-- Mobile hamburger -->
        <button id="mobile-menu-btn" class="p-2 rounded-xl text-med-blue hover:bg-slate-100" aria-label="Menu">
        <svg id="icon-open" class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16"/>
        </svg>
        <svg id="icon-close" class="w-5 h-5 hidden" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
        </svg>
      </button>
      </div>
    </div>
  </div>

  <div class="nav-inner transition-all duration-700 max-w-7xl mx-auto px-6">
    <div class="nav-bar hidden lg:flex transition-all duration-700 shadow-[0_4px_30px_rgba(0,0,0,0.03)] items-center justify-between h-20 px-8">

      <!-- Logo -->
      <a href={`/${lang}/`} class="flex-shrink-0">
        <img src="/logo.svg" alt={amalfiCoastGuideAlt} class="h-10 w-auto" />
      </a>

      <!-- Desktop Nav (mega dropdown - all locales) -->
      <nav class="hidden lg:flex items-center flex-1 justify-evenly">

        <!-- Destinazioni mega-dropdown -->
        <button data-menu="dest" class="flex items-center gap-2 px-3 py-6 text-[10px] font-bold tracking-[0.25em] uppercase text-slate-900 hover:text-med-blue transition-colors cursor-pointer">
          {nav.dest}
          <svg class="w-3.5 h-3.5 opacity-50 hover:opacity-100 transition-transform duration-200" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
          </svg>
        </button>

        <!-- Spiagge dropdown -->
        <button data-menu="spiagge" class="flex items-center gap-2 px-3 py-6 text-[10px] font-bold tracking-[0.25em] uppercase text-slate-900 hover:text-med-blue transition-colors cursor-pointer">
          {nav.spiagge}
          <svg class="w-3.5 h-3.5 opacity-50 hover:opacity-100 transition-transform duration-200" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
          </svg>
        </button>

        <!-- Guida Pratica -->
        <button data-menu="guida" class="flex items-center gap-2 px-3 py-6 text-[10px] font-bold tracking-[0.25em] uppercase text-slate-900 hover:text-med-blue transition-colors cursor-pointer">
          {nav.guida}
          <svg class="w-3.5 h-3.5 opacity-50 hover:opacity-100 transition-transform duration-200" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
          </svg>
        </button>

        <!-- Esperienze -->
        <button data-menu="esp" class="flex items-center gap-2 px-3 py-6 text-[10px] font-bold tracking-[0.25em] uppercase text-slate-900 hover:text-med-blue transition-colors cursor-pointer">
          {nav.esp}
          <svg class="w-3.5 h-3.5 opacity-50 hover:opacity-100 transition-transform duration-200" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
          </svg>
        </button>

        <!-- Eventi -->
        <button data-menu="ev" class="flex items-center gap-2 px-3 py-6 text-[10px] font-bold tracking-[0.25em] uppercase text-slate-900 hover:text-med-blue transition-colors cursor-pointer">
          {nav.ev}
          <svg class="w-3.5 h-3.5 opacity-50 hover:opacity-100 transition-transform duration-200" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
          </svg>
        </button>

      <!-- Right: Search + Language -->
      <div class="flex items-center gap-3">

        <!-- Desktop Search Button -->
        <button id="desktop-search-btn" class="hidden lg:flex items-center justify-center w-10 h-10 rounded-full transition-all duration-200 hover:bg-white/20 cursor-pointer" aria-label="Search">
          <svg class="w-5 h-5 text-med-gold" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
          </svg>
        </button>

        <!-- Language Switcher (world icon - desktop only) -->
        <div class="hidden lg:block relative group/lang">
          <button id="lang-selector-btn" class="flex items-center justify-center w-10 h-10 rounded-full transition-all duration-200 hover:bg-white/20" title="Select language" aria-label="Language selector">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <circle cx="12" cy="12" r="10"/><path d="M2 12h20M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>
            </svg>
          </button>
          <div id="lang-dropdown" class="fixed right-6 top-24 w-48 bg-white rounded-xl shadow-xl border border-slate-100 overflow-hidden opacity-0 invisible group-hover/lang:opacity-100 group-hover/lang:visible transition-all duration-200 z-[100] py-2">
            {locales.map(l => {
              const pageExists = pageKey && existingPages[l].includes(pageKey);
              const fullPathname = Astro.url.pathname.startsWith('/') && !Astro.url.pathname.split('/')[1]?.match(/[a-z]{2}-[a-z]{2}/)
                ? `/${lang}${Astro.url.pathname}`
                : Astro.url.pathname;
              const href = pageExists ? getLocalePath(l, pageKey!) : translatePath(fullPathname, lang, l);
              return (
                <a href={href} class={`flex items-center justify-center px-3 py-2.5 text-xs font-semibold transition-colors ${l === lang ? 'bg-med-blue/10 text-med-blue' : 'text-slate-700 hover:bg-slate-50'}`} title={countryCodeMap[l]}>
                  {countryCodeMap[l]}
                </a>
              );
            })}
          </div>
        </div>
      </div>
    </div>
    </div>
  </div>

  <!-- Mega Menu (hidden, shown via JS) -->
  <div id="mega-menu" class="hidden fixed left-0 right-0 top-20 z-[51] rounded-b-2xl overflow-hidden">
    <div class="bg-white w-full shadow-[0_20px_50px_rgba(0,0,0,0.1)] border-b border-slate-100">
      <div class="max-w-7xl mx-auto flex min-h-[280px] relative">
        <!-- Data menu containers - rendered hidden, shown via JS -->

        {/* DESTINAZIONI */}
        <div data-menu-id="dest" class="hidden w-full flex">
          <!-- Sidebar -->
          <div class="w-[320px] flex-shrink-0 bg-slate-50/50 p-8 flex flex-col justify-between border-r border-slate-100">
            <div class="pt-8">
              <h3 class="font-serif text-5xl italic text-med-gold mb-6">{nav.dest}</h3>
              <div class="w-12 h-px bg-med-gold/30 mb-8"></div>
              <p class="text-slate-400 text-[11px] leading-relaxed uppercase tracking-[0.3em] font-medium">{menuDescDest}</p>
            </div>
            <div class="flex items-center gap-4">
              <svg class="w-8 h-8 text-med-gold" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
              <span class="text-[9px] text-slate-400 uppercase tracking-widest font-medium">{luxuryColleciton}</span>
            </div>
          </div>
          <!-- Content -->
          <div class="flex-grow p-8">
            <div class="grid grid-cols-3 gap-x-16 gap-y-8">
              {/* Costiera */}
              <div class="flex flex-col space-y-3">
                <a href={`${costieraBase}/`} class="text-med-blue text-[10px] font-bold uppercase tracking-[0.3em] relative block pb-2">
                  {dh.costiera}
                  <span class="absolute bottom-[-1px] left-0 w-8 h-px bg-med-gold"></span>
                </a>
                <ul class="space-y-3">
                  {costieraBorghi.map(b => (
                    <li>
                      <a href={b.href} class="group flex items-center gap-3 text-slate-500 hover:text-med-blue transition-all font-sans text-[11px] uppercase tracking-widest">
                        <div class="w-5 h-5 rounded-sm bg-slate-50 opacity-0 group-hover:opacity-100 -ml-8 group-hover:ml-0 transition-all flex items-center justify-center flex-shrink-0">
                          <LemonSlice class="w-3 h-3 text-med-gold" />
                        </div>
                        {b.name}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
              {/* Penisola */}
              <div class="flex flex-col space-y-3">
                <a href={sorrentineHref} class="text-med-blue text-[10px] font-bold uppercase tracking-[0.3em] relative block pb-2">
                  {dh.sorrentina}
                  <span class="absolute bottom-[-1px] left-0 w-8 h-px bg-med-gold"></span>
                </a>
                <ul class="space-y-3">
                  {sorrentinaBorghi.map(b => (
                    <li>
                      <a href={b.href} class="group flex items-center gap-3 text-slate-500 hover:text-med-blue transition-all font-sans text-[11px] uppercase tracking-widest">
                        <div class="w-5 h-5 rounded-sm bg-slate-50 opacity-0 group-hover:opacity-100 -ml-8 group-hover:ml-0 transition-all flex items-center justify-center flex-shrink-0">
                          <LemonSlice class="w-3 h-3 text-med-gold" />
                        </div>
                        {b.name}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
              {/* Isole */}
              <div class="flex flex-col space-y-3">
                <a href={isoleHref} class="text-med-blue text-[10px] font-bold uppercase tracking-[0.3em] relative block pb-2">
                  {dh.isole}
                  <span class="absolute bottom-[-1px] left-0 w-8 h-px bg-med-gold"></span>
                </a>
                <ul class="space-y-3">
                  {isoleLinks.map(b => (
                    <li>
                      <a href={b.href} class="group flex items-center gap-3 text-slate-500 hover:text-med-blue transition-all font-sans text-[11px] uppercase tracking-widest">
                        <div class="w-5 h-5 rounded-sm bg-slate-50 opacity-0 group-hover:opacity-100 -ml-8 group-hover:ml-0 transition-all flex items-center justify-center flex-shrink-0">
                          <LemonSlice class="w-3 h-3 text-med-gold" />
                        </div>
                        {b.name}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            </div>
            <div class="mt-8 pt-4 border-t border-slate-100 text-right">
              <a href={destinazioniHref} class="text-med-blue font-bold text-[11px] uppercase tracking-[0.3em] hover:text-med-blue/70 transition-colors inline-flex items-center gap-2">
                {exploreMoreLabel} <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
              </a>
            </div>
          </div>
        </div>

        {/* SPIAGGE */}
        <div data-menu-id="spiagge" class="hidden w-full flex">
          <!-- Sidebar -->
          <div class="w-[320px] flex-shrink-0 bg-slate-50/50 p-8 flex flex-col justify-between border-r border-slate-100">
            <div class="pt-8">
              <h3 class="font-serif text-5xl italic text-med-gold mb-6">{nav.spiagge}</h3>
              <div class="w-12 h-px bg-med-gold/30 mb-8"></div>
              <p class="text-slate-400 text-[11px] leading-relaxed uppercase tracking-[0.3em] font-medium">{menuDescBeaches}</p>
            </div>
            <div class="flex items-center gap-4">
              <svg class="w-8 h-8 text-med-gold" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M16.5 10.5V6.75a4.5 4.5 0 10-9 0v3.75m11.356-1.993l1.263 12c.07.665-.56 1.243-1.228 1.243H3.909c-.668 0-1.3-.578-1.228-1.243l1.263-12a1.5 1.5 0 011.487-1.243h16.536a1.5 1.5 0 011.487 1.243z"/></svg>
              <span class="text-[9px] text-slate-400 uppercase tracking-widest font-medium">{beachParadise}</span>
            </div>
          </div>
          <!-- Content -->
          <div class="flex-grow p-8">
            <div class="grid grid-cols-3 gap-x-16 gap-y-8">
              {spiaggeAree.map(area => (
                <div class="flex flex-col space-y-3">
                  <a href={area.href} class="text-med-blue text-[10px] font-bold uppercase tracking-[0.3em] relative block pb-2">
                    {area.area}
                    <span class="absolute bottom-[-1px] left-0 w-8 h-px bg-med-gold"></span>
                  </a>
                  <ul class="space-y-3">
                    {area.beaches.map(b => (
                      <li>
                        <a href={b.href} class="group flex items-center gap-3 text-slate-500 hover:text-med-blue transition-all font-sans text-[11px] uppercase tracking-widest">
                          <div class="w-5 h-5 rounded-sm bg-slate-50 opacity-0 group-hover:opacity-100 -ml-8 group-hover:ml-0 transition-all flex items-center justify-center flex-shrink-0">
                            <LemonSlice class="w-3 h-3 text-med-gold" />
                          </div>
                          {b.name}
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              ))}
            </div>
            <div class="mt-8 pt-4 border-t border-slate-100 text-right">
              <a href={spiaggeHref} class="text-med-blue font-bold text-[11px] uppercase tracking-[0.3em] hover:text-med-blue/70 transition-colors inline-flex items-center gap-2">
                {exploreMoreLabel} <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
              </a>
            </div>
          </div>
        </div>

        {/* GUIDA */}
        <div data-menu-id="guida" class="hidden w-full flex">
          <!-- Sidebar -->
          <div class="w-[320px] flex-shrink-0 bg-slate-50/50 p-8 flex flex-col justify-between border-r border-slate-100">
            <div class="pt-8">
              <h3 class="font-serif text-5xl italic text-med-gold mb-6">{nav.guida}</h3>
              <div class="w-12 h-px bg-med-gold/30 mb-8"></div>
              <p class="text-slate-400 text-[11px] leading-relaxed uppercase tracking-[0.3em] font-medium">{menuDescGuida}</p>
            </div>
            <div class="flex items-center gap-4">
              <svg class="w-8 h-8 text-med-gold" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6.253v13m0-13C6.5 6.253 2 10.998 2 17s4.5 10.747 10 10.747 10-4.998 10-10.747c0-5.002-4.5-10.747-10-10.747z"/></svg>
              <span class="text-[9px] text-slate-400 uppercase tracking-widest font-medium">{travelGuideLabel}</span>
            </div>
          </div>
          <!-- Content -->
          <div class="flex-grow p-8">
            <div class="grid grid-cols-3 gap-x-16 gap-y-8">
              <!-- Pianificazione -->
              <div class="flex flex-col space-y-3">
                <a href={pianificazioneHref} class="text-med-blue text-[10px] font-bold uppercase tracking-[0.3em] relative block pb-2">
                  {lang === 'it-it' ? 'Pianificazione' : lang === 'en-us' ? 'Planning' : lang === 'de-de' ? 'Planung' : lang === 'fr-fr' ? 'Planification' : 'Planificación'}
                  <span class="absolute bottom-[-1px] left-0 w-8 h-px bg-med-gold"></span>
                </a>
                <ul class="space-y-3">
                  {guidaPratica.planning.map(l => (
                    <li>
                      <a href={l.href} class="group flex items-center gap-3 text-slate-500 hover:text-med-blue transition-all font-sans text-[11px] uppercase tracking-widest">
                        <div class="w-5 h-5 rounded-sm bg-slate-50 opacity-0 group-hover:opacity-100 -ml-8 group-hover:ml-0 transition-all flex items-center justify-center flex-shrink-0">
                          <LemonSlice class="w-3 h-3 text-med-gold" />
                        </div>
                        {l.name}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
              <!-- Guide Pratiche -->
              <div class="flex flex-col space-y-3">
                <a href={pianificazioneHref} class="text-med-blue text-[10px] font-bold uppercase tracking-[0.3em] relative block pb-2">
                  {lang === 'it-it' ? 'Guide pratiche' : lang === 'en-us' ? 'Practical Guides' : lang === 'de-de' ? 'Praktische Ratgeber' : lang === 'fr-fr' ? 'Guides Pratiques' : 'Guías Prácticas'}
                  <span class="absolute bottom-[-1px] left-0 w-8 h-px bg-med-gold"></span>
                </a>
                <ul class="space-y-3">
                  {guidaPratica.guides.map(l => (
                    <li>
                      <a href={l.href} class="group flex items-center gap-3 text-slate-500 hover:text-med-blue transition-all font-sans text-[11px] uppercase tracking-widest">
                        <div class="w-5 h-5 rounded-sm bg-slate-50 opacity-0 group-hover:opacity-100 -ml-8 group-hover:ml-0 transition-all flex items-center justify-center flex-shrink-0">
                          <LemonSlice class="w-3 h-3 text-med-gold" />
                        </div>
                        {l.name}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
              <!-- Blog & Local Tips -->
              <div class="flex flex-col space-y-3">
                <a href={blogHref} class="text-med-blue text-[10px] font-bold uppercase tracking-[0.3em] relative block pb-2">
                  {lang === 'it-it' ? 'Blog & Local tips' : lang === 'en-us' ? 'Blog & Local Tips' : lang === 'de-de' ? 'Blog & Lokale Tipps' : lang === 'fr-fr' ? 'Blog & Conseils Locaux' : 'Blog & Consejos Locales'}
                  <span class="absolute bottom-[-1px] left-0 w-8 h-px bg-med-gold"></span>
                </a>
                <ul class="space-y-3">
                  {guidaPratica.blog.map(l => (
                    <li>
                      <a href={l.href} class="group flex items-center gap-3 text-slate-500 hover:text-med-blue transition-all font-sans text-[11px] uppercase tracking-widest">
                        <div class="w-5 h-5 rounded-sm bg-slate-50 opacity-0 group-hover:opacity-100 -ml-8 group-hover:ml-0 transition-all flex items-center justify-center flex-shrink-0">
                          <LemonSlice class="w-3 h-3 text-med-gold" />
                        </div>
                        {l.name}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            </div>
