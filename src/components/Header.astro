                <a href={tuttiEvHref} class="text-[11px] uppercase tracking-[0.2em] text-med-blue font-semibold flex items-center justify-between pb-1.5 mb-1 border-b border-med-gold/30">{evSec.tradizioni}<svg class="w-3 h-3 text-med-gold flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg></a>
