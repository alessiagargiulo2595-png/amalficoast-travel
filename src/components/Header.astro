---

<header class="glass-nav sticky top-0 z-50">
  <div class="max-w-7xl mx-auto px-6">
    <div class="flex items-center justify-between h-16">

      <!-- Logo -->
      <a href={`/${lang}/`} class="flex-shrink-0">
        <img src="/logo.svg" alt="Amalfi Coast Travel Guide" class="h-10 w-auto" />
      </a>

      <!-- Desktop Nav (mega dropdown - all locales) -->
      <nav class="hidden lg:flex items-center gap-1">

        <!-- Destinazioni mega-dropdown -->
        <div class="relative group/dest">
          <button class="flex items-center gap-1 px-4 py-2 text-sm font-medium text-slate-700 hover:text-med-blue transition-colors rounded-lg hover:bg-med-blue/5 group-hover/dest:text-med-blue">
            {nav.dest}
            <svg class="w-3.5 h-3.5 opacity-50 group-hover/dest:opacity-100 transition-transform group-hover/dest:rotate-180 duration-200" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
            </svg>
          </button>
          <div class="absolute inset-x-0 top-full pt-2 opacity-0 invisible group-hover/dest:opacity-100 group-hover/dest:visible transition-all duration-200 z-50">
            <div class="w-full bg-white shadow-[0_20px_50px_rgba(0,0,0,0.1)] border-b border-slate-100 overflow-hidden flex justify-center">
              <div class="max-w-7xl flex">

              <!-- Sidebar sinistra -->
              <div class="w-[280px] bg-slate-50 p-8 flex flex-col justify-between border-r border-slate-100">
                <div>
                  <h3 class="font-serif text-3xl mb-3 text-med-gold">{nav.dest}</h3>
                  <p class="text-slate-400 text-[10px] leading-relaxed uppercase tracking-[0.2em] font-medium">
                    Scopri l'essenza<br />del Mediterraneo
                  </p>
                </div>
                <div class="flex items-center gap-3">
                  <span class="text-4xl">🍋</span>
                  <span class="text-[9px] font-bold text-med-gold uppercase tracking-widest leading-tight">
                    Luxury Travel<br />Collection
                  </span>
                </div>
              </div>

              <!-- Area contenuti (destra) -->
              <div class="flex-grow p-8">
                <div class="grid grid-cols-1 md:grid-cols-3 gap-x-12 gap-y-8">

                  <!-- Costiera -->
                  <div class="flex flex-col">
                    <a href={`${costieraBase}/`} class="text-slate-900 text-[10px] font-bold uppercase tracking-[0.3em] mb-4 pb-2 border-b border-slate-100 hover:text-med-gold transition-colors">
                      {dh.costiera}
                    </a>
                    <ul class="space-y-3">
                      {costieraBorghi.map(b => (
                        <li>
                          <a href={b.href} class="group flex items-center gap-2 text-slate-500 hover:text-med-gold transition-all font-sans text-[11px] uppercase tracking-widest">
                            <div class="w-4 flex justify-center opacity-0 group-hover:opacity-100 transition-all -ml-4 group-hover:ml-0">
                              <span>🍋</span>
                            </div>
                            {b.name}
                          </a>
                        </li>
                      ))}
                    </ul>
                  </div>

                  <!-- Penisola -->
                  <div class="flex flex-col">
                    <a href={sorrentineHref} class="text-slate-900 text-[10px] font-bold uppercase tracking-[0.3em] mb-4 pb-2 border-b border-slate-100 hover:text-med-gold transition-colors">
                      {dh.sorrentina}
                    </a>
                    <ul class="space-y-3">
                      {sorrentinaBorghi.map(b => (
                        <li>
                          <a href={b.href} class="group flex items-center gap-2 text-slate-500 hover:text-med-gold transition-all font-sans text-[11px] uppercase tracking-widest">
                            <div class="w-4 flex justify-center opacity-0 group-hover:opacity-100 transition-all -ml-4 group-hover:ml-0">
                              <span>🍋</span>
                            </div>
                            {b.name}
                          </a>
                        </li>
                      ))}
                    </ul>
                  </div>

                  <!-- Isole -->
                  <div class="flex flex-col">
                    <a href={isoleHref} class="text-slate-900 text-[10px] font-bold uppercase tracking-[0.3em] mb-4 pb-2 border-b border-slate-100 hover:text-med-gold transition-colors">
                      {dh.isole}
                    </a>
                    <ul class="space-y-3">
                      {isoleLinks.map(b => (
                        <li>
                          <a href={b.href} class="group flex items-center gap-2 text-slate-500 hover:text-med-gold transition-all font-sans text-[11px] uppercase tracking-widest">
                            <div class="w-4 flex justify-center opacity-0 group-hover:opacity-100 transition-all -ml-4 group-hover:ml-0">
                              <span>🍋</span>
                            </div>
                            {b.name}
                          </a>
                        </li>
                      ))}
                    </ul>
                  </div>

                </div>

                <!-- Footer menu -->
                <div class="mt-8 pt-6 border-t border-slate-50 flex justify-between items-center">
                  <p class="text-[10px] text-slate-300 italic">Prepara il tuo viaggio esclusivo 2026</p>
                  <a href={`/${lang}/destinations/`} class="text-slate-900 font-bold text-[10px] uppercase tracking-widest flex items-center gap-2 hover:gap-3 transition-all group">
                    Vedi Tutto
                    <svg class="w-3 h-3 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
                  </a>
                </div>
              </div>

              </div>
            </div>
          </div>
        </div>

        <!-- Spiagge dropdown -->
        <div class="relative group/spiagge">
          <button class="flex items-center gap-1 px-4 py-2 text-sm font-medium text-slate-700 hover:text-med-blue transition-colors rounded-lg hover:bg-med-blue/5 group-hover/spiagge:text-med-blue">
            {nav.spiagge}
            <svg class="w-3.5 h-3.5 opacity-50 group-hover/spiagge:opacity-100 transition-transform group-hover/spiagge:rotate-180 duration-200" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
            </svg>
          </button>
          <div class="absolute inset-x-0 top-full pt-2 opacity-0 invisible group-hover/spiagge:opacity-100 group-hover/spiagge:visible transition-all duration-200 z-50">
            <div class="w-full bg-white shadow-[0_20px_50px_rgba(0,0,0,0.1)] border-b border-slate-100 overflow-hidden flex justify-center">
              <div class="max-w-7xl flex">

              <!-- Sidebar sinistra -->
              <div class="w-[280px] bg-slate-50 p-8 flex flex-col justify-between border-r border-slate-100">
                <div>
                  <h3 class="font-serif text-3xl mb-3 text-med-gold">{nav.spiagge}</h3>
                  <p class="text-slate-400 text-[10px] leading-relaxed uppercase tracking-[0.2em] font-medium">
                    Scopri le coste<br />più affascinanti
                  </p>
                </div>
                <div class="flex items-center gap-3">
                  <span class="text-4xl">🏖️</span>
                  <span class="text-[9px] font-bold text-med-gold uppercase tracking-widest leading-tight">
                    Beach<br />Paradise
                  </span>
                </div>
              </div>

              <!-- Area contenuti (destra) -->
              <div class="flex-grow p-8">
                <div class="grid grid-cols-1 md:grid-cols-3 gap-x-12 gap-y-8">
