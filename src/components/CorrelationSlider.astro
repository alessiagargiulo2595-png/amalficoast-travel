---
interface SliderItem {
  name: string;
  href: string;
  tag: string;
  desc: string;
}
interface Props {
  heading?: string;
  items: SliderItem[];
  lang?: string;
}

const getButtonText = (lang?: string) => {
  const translations: Record<string, string> = {
    'it-it': 'Scopri',
    'es-es': 'Descubre',
    'en-us': 'Discover',
    'fr-fr': 'Découvrir',
    'de-de': 'Entdecken',
  };
  return translations[lang || 'it-it'] || 'Scopri';
};

const getHeading = (lang?: string) => {
  const translations: Record<string, string> = {
    'it-it': 'Esplora anche',
    'es-es': 'Explora también',
    'en-us': 'Also Explore',
    'fr-fr': 'Explorez aussi',
    'de-de': 'Auch erkunden',
  };
  return translations[lang || 'it-it'] || 'Esplora anche';
};

const { heading, items, lang } = Astro.props;
const finalHeading = heading || getHeading(lang);

const scrollContainerId = `slider-container-${lang}`;
const scrollBtnId = `scroll-btn-${lang}`;
const scrollBtnLeftId = `scroll-btn-left-${lang}`;
---

<script define:vars={{ scrollContainerId, scrollBtnId, scrollBtnLeftId }}>
  document.addEventListener('DOMContentLoaded', () => {
    const container = document.getElementById(scrollContainerId);
    const buttonRight = document.getElementById(scrollBtnId);
    const buttonLeft = document.getElementById(scrollBtnLeftId);

    // Hide left button initially
    if (buttonLeft) {
      buttonLeft.classList.add('opacity-0', 'pointer-events-none');
    }

    // Update button visibility on scroll
    const updateButtonVisibility = () => {
      if (container && buttonLeft) {
        if (container.scrollLeft > 5) {
          buttonLeft.classList.remove('opacity-0', 'pointer-events-none');
        } else {
          buttonLeft.classList.add('opacity-0', 'pointer-events-none');
        }
      }
    };

    if (container) {
      container.addEventListener('scroll', updateButtonVisibility, { passive: true });
    }

    if (container && buttonRight) {
      buttonRight.addEventListener('click', () => {
        container.scrollBy({
          left: 200,
          behavior: 'smooth'
        });
        // Check button visibility after smooth scroll completes
        setTimeout(updateButtonVisibility, 350);
      });
    }

    if (container && buttonLeft) {
      buttonLeft.addEventListener('click', () => {
        container.scrollBy({
          left: -200,
          behavior: 'smooth'
        });
        // Check button visibility after smooth scroll completes
        setTimeout(updateButtonVisibility, 350);
      });
    }
  });
</script>

<section class="bg-offwhite border-t border-slate-100 py-12">
  <div class="max-w-editorial mx-auto px-4 sm:px-6 lg:px-8">
    <h2 class="font-serif text-2xl font-semibold text-charcoal mb-6">{finalHeading}</h2>
    <div class="relative" id={`slider-${lang}`}>
      <div class="flex gap-4 overflow-x-auto pb-3 snap-x snap-mandatory -mx-4 px-24 sm:px-4 [scrollbar-width:none] [&::-webkit-scrollbar]:hidden" id={`slider-container-${lang}`}>
        {items.map(item => (
          <a
            href={item.href}
            class="correlation-card flex-shrink-0 w-48 sm:w-56 snap-start rounded-2xl p-5 border border-slate-200 hover:border-med-blue/30 hover:shadow-md transition-all duration-200 group flex flex-col sm:h-auto sm:min-h-0 min-h-[240px] relative overflow-hidden"
          >
            <div class="absolute -inset-2 bg-[url('/images/tile-vietri-sm.jpg')] bg-cover bg-center bg-no-repeat"></div>
            <div class="absolute inset-0 bg-black/70"></div>
            <div class="relative z-10 flex flex-col flex-grow">
              <span class="text-[10px] uppercase tracking-wide bg-med-gold/30 text-white px-2 py-1 rounded-full font-bold w-fit [text-shadow:_0_1px_2px_rgba(0,0,0,0.5)]">{item.tag}</span>
              <h3 class="font-serif text-xl font-bold text-white mt-3 mb-1 group-hover:text-med-gold transition-colors [text-shadow:_0_1px_4px_rgba(0,0,0,0.6)]">{item.name}</h3>
              <p class="text-[13px] text-white font-semibold leading-relaxed flex-grow [text-shadow:_0_1px_3px_rgba(0,0,0,0.5)]">{item.desc}</p>
              <div class="w-12 h-[2px] bg-med-gold rounded-full mt-4 mb-2"></div>
              <p class="text-med-gold text-sm font-extrabold group-hover:translate-x-1 transition-transform inline-flex items-center gap-1 drop-shadow-[0_1px_3px_rgba(212,175,55,0.5)]">
                {getButtonText(lang)}
                <svg class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 18l6-6-6-6"/></svg>
              </p>
            </div>
          </a>
        ))}
        <!-- Spacer for scroll on mobile -->
        <div class="flex-shrink-0 w-8 sm:hidden"></div>
      </div>
      <!-- Scroll arrows (mobile only) -->
      <button
        id={`scroll-btn-left-${lang}`}
        class="absolute left-1 top-1/2 -translate-y-1/2 w-9 h-9 bg-white rounded-full shadow-lg border border-slate-100 flex items-center justify-center text-slate-500 hover:text-med-blue hover:shadow-xl transition-all duration-200 sm:hidden z-20 opacity-0 pointer-events-none"
        aria-label="Scroll left"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
        </svg>
      </button>
      <button
        id={`scroll-btn-${lang}`}
        class="absolute right-1 top-1/2 -translate-y-1/2 w-9 h-9 bg-white rounded-full shadow-lg border border-slate-100 flex items-center justify-center text-slate-500 hover:text-med-blue hover:shadow-xl transition-all duration-200 sm:hidden z-20"
        aria-label="Scroll right"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
        </svg>
      </button>
    </div>
  </div>
</section>
