---
interface SliderItem {
  name: string;
  href: string;
  tag: string;
  desc: string;
}
interface Props {
  heading?: string;
  items: SliderItem[];
  lang?: string;
}

const getButtonText = (lang?: string) => {
  const translations: Record<string, string> = {
    'it-it': 'Scopri',
    'es-es': 'Descubre',
    'en-us': 'Discover',
    'fr-fr': 'Découvrir',
    'de-de': 'Entdecken',
  };
  return translations[lang || 'it-it'] || 'Scopri';
};

const getHeading = (lang?: string) => {
  const translations: Record<string, string> = {
    'it-it': 'Esplora anche',
    'es-es': 'Explora también',
    'en-us': 'Also Explore',
    'fr-fr': 'Explorez aussi',
    'de-de': 'Auch erkunden',
  };
  return translations[lang || 'it-it'] || 'Esplora anche';
};

const { heading, items, lang } = Astro.props;
const finalHeading = heading || getHeading(lang);

const scrollContainerId = `slider-container-${lang}`;
const scrollBtnId = `scroll-btn-${lang}`;
const scrollBtnLeftId = `scroll-btn-left-${lang}`;
---

<script define:vars={{ scrollContainerId, scrollBtnId, scrollBtnLeftId }}>
  document.addEventListener('DOMContentLoaded', () => {
    const container = document.getElementById(scrollContainerId);
    const buttonRight = document.getElementById(scrollBtnId);
    const buttonLeft = document.getElementById(scrollBtnLeftId);

    // Hide left button initially
    if (buttonLeft) {
      buttonLeft.classList.add('opacity-0', 'pointer-events-none');
    }

    // Update button visibility on scroll
    const updateButtonVisibility = () => {
      if (container && buttonLeft) {
        // Use setTimeout to ensure scroll has finished
        setTimeout(() => {
          if (container.scrollLeft > 0) {
            buttonLeft.classList.remove('opacity-0', 'pointer-events-none');
          } else {
            buttonLeft.classList.add('opacity-0', 'pointer-events-none');
          }
        }, 0);
      }
    };

    if (container) {
      container.addEventListener('scroll', updateButtonVisibility, { passive: true });
    }

    if (container && buttonRight) {
      buttonRight.addEventListener('click', () => {
        container.scrollBy({
          left: 200,
          behavior: 'smooth'
        });
        // Check button visibility after smooth scroll completes
        setTimeout(updateButtonVisibility, 350);
      });
    }

    if (container && buttonLeft) {
      buttonLeft.addEventListener('click', () => {
        container.scrollBy({
          left: -200,
          behavior: 'smooth'
        });
        // Check button visibility after smooth scroll completes
        setTimeout(updateButtonVisibility, 350);
      });
    }
  });
</script>

<section class="bg-offwhite border-t border-slate-100 py-12">
  <div class="max-w-editorial mx-auto px-4 sm:px-6 lg:px-8">
    <h2 class="font-serif text-2xl font-semibold text-charcoal mb-6">{finalHeading}</h2>
    <div class="relative" id={`slider-${lang}`}>
      <div class="flex gap-4 overflow-x-auto pb-3 snap-x snap-mandatory -mx-4 px-24 sm:px-4 [scrollbar-width:none] [&::-webkit-scrollbar]:hidden" id={`slider-container-${lang}`}>
        {items.map(item => (
          <a
            href={item.href}
            class="flex-shrink-0 w-48 sm:w-56 snap-start bg-white border border-slate-200 rounded-2xl p-5 hover:border-med-blue/30 hover:shadow-md transition-all duration-200 group flex flex-col sm:h-auto sm:min-h-0 min-h-[240px]"
          >
            <span class="text-[10px] uppercase tracking-wide bg-med-blue/5 text-med-blue px-2 py-1 rounded-full font-medium w-fit">{item.tag}</span>
            <h3 class="font-serif text-lg font-semibold text-charcoal mt-3 mb-1 group-hover:text-med-blue transition-colors">{item.name}</h3>
            <p class="text-xs text-slate-500 leading-relaxed flex-grow">{item.desc}</p>
            <p class="text-med-blue text-xs font-medium mt-4 group-hover:translate-x-1 transition-transform inline-flex items-center gap-1">
              {getButtonText(lang)}
              <svg class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 18l6-6-6-6"/></svg>
            </p>
          </a>
        ))}
        <!-- Spacer for scroll on mobile -->
        <div class="flex-shrink-0 w-8 sm:hidden"></div>
      </div>
      <!-- Scroll arrows (mobile only) -->
      <button
        id={`scroll-btn-left-${lang}`}
        class="absolute -left-4 top-1/2 -translate-y-1/2 pointer-events-auto bg-gradient-to-r from-offwhite/95 to-transparent w-12 h-32 flex items-center justify-start pl-3 sm:hidden hover:pl-2 transition-all active:pl-3 z-20"
        aria-label="Scroll left"
      >
        <svg class="w-5 h-5 text-med-blue" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
        </svg>
      </button>
      <button
        id={`scroll-btn-${lang}`}
        class="absolute right-0 top-1/2 -translate-y-1/2 pointer-events-auto bg-gradient-to-l from-offwhite/95 to-transparent w-12 h-32 flex items-center justify-end pr-3 sm:hidden hover:pr-2 transition-all active:pr-3 z-20 opacity-100"
        aria-label="Scroll right"
      >
        <svg class="w-5 h-5 text-med-blue animate-bounce" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
        </svg>
      </button>
    </div>
  </div>
</section>
