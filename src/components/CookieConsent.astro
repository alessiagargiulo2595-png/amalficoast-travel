---
interface Props {
  lang: string;
}
const { lang } = Astro.props;

const ccLangMap: Record<string, string> = {
  'en-us': 'en', 'it-it': 'it', 'de-de': 'de', 'fr-fr': 'fr', 'es-es': 'es'
};
const privacyUrls: Record<string, string> = {
  'en-us': '/en-us/privacy-policy/', 'it-it': '/it-it/privacy-policy/',
  'de-de': '/de-de/privacy-policy/', 'fr-fr': '/fr-fr/privacy-policy/', 'es-es': '/es-es/privacy-policy/',
};
const cookieUrls: Record<string, string> = {
  'en-us': '/en-us/cookie-policy/', 'it-it': '/it-it/cookie-policy/',
  'de-de': '/de-de/cookie-policy/', 'fr-fr': '/fr-fr/cookie-policy/', 'es-es': '/es-es/cookie-policy/',
};

const ccLang = ccLangMap[lang] || 'en';
const privacyUrl = privacyUrls[lang] || '/en-us/privacy-policy/';
const cookieUrl = cookieUrls[lang] || '/en-us/cookie-policy/';
---

<span id="cc-config" data-lang={ccLang} data-privacy={privacyUrl} data-cookie={cookieUrl} hidden></span>

<script>
  import * as CookieConsent from 'vanilla-cookieconsent';
  import 'vanilla-cookieconsent/dist/cookieconsent.css';

  const el = document.getElementById('cc-config') as HTMLElement;
  const lang = el?.dataset.lang || 'en';
  const privacyUrl = el?.dataset.privacy || '/en-us/privacy-policy/';
  const cookieUrl = el?.dataset.cookie || '/en-us/cookie-policy/';

  // Expose for footer "Cookie preferences" link
  (window as any).showCookiePreferences = () => CookieConsent.showPreferences();

  function updateConsent(granted: boolean) {
    if (typeof (window as any).gtag === 'function') {
      (window as any).gtag('consent', 'update', {
        analytics_storage: granted ? 'granted' : 'denied',
        ad_storage: 'denied',
        ad_user_data: 'denied',
        ad_personalization: 'denied',
      });
    }
  }

  CookieConsent.run({
    guiOptions: {
      consentModal: {
        layout: 'box',
        position: 'bottom left',
        equalWeightButtons: false,
        flipButtons: false,
        disablePageInteraction: false,
      },
    },
    categories: {
      necessary: { enabled: true, readOnly: true },
      analytics: {
        enabled: false,
        autoClear: {
          cookies: [
            { name: /^(_ga|_gid|_gat)/ },
            { name: /^_ga_/ },
            { name: /^(_clck|_clsk)/ },
          ],
        },
      },
    },
    onConsent: () => {
      const accepted = CookieConsent.acceptedCategory('analytics');
      updateConsent(accepted);
      if (typeof (window as any).gtag === 'function') {
        (window as any).gtag('event', 'cookie_consent', {
          consent_action: accepted ? 'accept' : 'reject',
          page_path: window.location.pathname,
        });
      }
    },
    onChange: ({ changedCategories }) => {
      if (changedCategories.includes('analytics')) {
        updateConsent(CookieConsent.acceptedCategory('analytics'));
      }
    },
    language: {
      default: lang,
      translations: {
        en: {
          consentModal: {
            title: 'Travel light, your privacy is safe',
            description: `Analytics only — no advertising. <a href="${privacyUrl}">Privacy Policy</a> · <a href="${cookieUrl}">Cookie Policy</a>`,
            acceptAllBtn: 'Accept',
            acceptNecessaryBtn: 'Reject',
          },
          preferencesModal: {
            title: 'Cookie preferences',
            acceptAllBtn: 'Accept all',
            acceptNecessaryBtn: 'Reject all',
            savePreferencesBtn: 'Save preferences',
            closeIconLabel: 'Close',
            sections: [
              { title: 'Strictly necessary', description: 'Required for the site to function. Cannot be disabled.', linkedCategory: 'necessary' },
              { title: 'Analytics', description: 'Google Analytics and Microsoft Clarity collect anonymous data to help improve the site. No personal data is stored.', linkedCategory: 'analytics' },
            ],
          },
        },
        it: {
          consentModal: {
            title: 'Naviga leggero, la tua privacy è al sicuro',
            description: `Solo cookie analitici, zero pubblicità. <a href="${privacyUrl}">Privacy Policy</a> · <a href="${cookieUrl}">Cookie Policy</a>`,
            acceptAllBtn: 'Accetta',
            acceptNecessaryBtn: 'Rifiuta',
          },
          preferencesModal: {
            title: 'Preferenze cookie',
            acceptAllBtn: 'Accetta tutto',
            acceptNecessaryBtn: 'Rifiuta tutto',
            savePreferencesBtn: 'Salva preferenze',
            closeIconLabel: 'Chiudi',
            sections: [
              { title: 'Strettamente necessari', description: 'Necessari al funzionamento del sito. Non possono essere disabilitati.', linkedCategory: 'necessary' },
              { title: 'Analitici', description: 'Google Analytics e Microsoft Clarity raccolgono dati anonimi per migliorare il sito. Nessun dato personale viene memorizzato.', linkedCategory: 'analytics' },
            ],
          },
        },
        de: {
          consentModal: {
            title: 'Leicht reisen, Ihre Privatsphäre ist sicher',
            description: `Nur Analyse-Cookies, keine Werbung. <a href="${privacyUrl}">Datenschutz</a> · <a href="${cookieUrl}">Cookie-Richtlinie</a>`,
            acceptAllBtn: 'Akzeptieren',
            acceptNecessaryBtn: 'Ablehnen',
          },
          preferencesModal: {
            title: 'Cookie-Einstellungen',
            acceptAllBtn: 'Alle akzeptieren',
            acceptNecessaryBtn: 'Alle ablehnen',
            savePreferencesBtn: 'Einstellungen speichern',
            closeIconLabel: 'Schließen',
            sections: [
              { title: 'Unbedingt notwendig', description: 'Für den Betrieb der Website erforderlich. Können nicht deaktiviert werden.', linkedCategory: 'necessary' },
              { title: 'Analyse', description: 'Google Analytics und Microsoft Clarity sammeln anonyme Daten zur Verbesserung der Website. Es werden keine personenbezogenen Daten gespeichert.', linkedCategory: 'analytics' },
            ],
          },
        },
        fr: {
          consentModal: {
            title: 'Naviguez léger, votre vie privée est protégée',
            description: `Cookies analytiques uniquement, zéro pub. <a href="${privacyUrl}">Politique de confidentialité</a> · <a href="${cookieUrl}">Politique de cookies</a>`,
            acceptAllBtn: 'Accepter',
            acceptNecessaryBtn: 'Refuser',
          },
          preferencesModal: {
            title: 'Préférences de cookies',
            acceptAllBtn: 'Tout accepter',
            acceptNecessaryBtn: 'Tout refuser',
            savePreferencesBtn: 'Sauvegarder',
            closeIconLabel: 'Fermer',
            sections: [
              { title: 'Strictement nécessaires', description: 'Nécessaires au fonctionnement du site. Ne peuvent pas être désactivés.', linkedCategory: 'necessary' },
              { title: 'Analytiques', description: 'Google Analytics et Microsoft Clarity collectent des données anonymes pour améliorer le site. Aucune donnée personnelle n\'est stockée.', linkedCategory: 'analytics' },
            ],
          },
        },
        es: {
          consentModal: {
            title: 'Navega ligero, tu privacidad está segura',
            description: `Solo cookies analíticas, sin publicidad. <a href="${privacyUrl}">Política de privacidad</a> · <a href="${cookieUrl}">Política de cookies</a>`,
            acceptAllBtn: 'Aceptar',
            acceptNecessaryBtn: 'Rechazar',
          },
          preferencesModal: {
            title: 'Preferencias de cookies',
            acceptAllBtn: 'Aceptar todo',
            acceptNecessaryBtn: 'Rechazar todo',
            savePreferencesBtn: 'Guardar preferencias',
            closeIconLabel: 'Cerrar',
            sections: [
              { title: 'Estrictamente necesarias', description: 'Necesarias para el funcionamiento del sitio. No pueden desactivarse.', linkedCategory: 'necessary' },
              { title: 'Analíticas', description: 'Google Analytics y Microsoft Clarity recopilan datos anónimos para mejorar el sitio. No se almacenan datos personales.', linkedCategory: 'analytics' },
            ],
          },
        },
      },
    },
  });
</script>

<style is:global>
  #cc-main {
    --cc-font-family: Inter, system-ui, sans-serif;
    --cc-modal-border-radius: 0.875rem;
    --cc-btn-border-radius: 0.375rem;

    /* Light, minimal theme */
    --cc-bg: #ffffff;
    --cc-primary-color: #0f172a;
    --cc-secondary-color: #64748b;
    --cc-separator-border-color: #f1f5f9;
    --cc-link-color: #2563eb;

    /* No overlay — banner floats without blocking */
    --cc-overlay-bg: transparent;

    /* Accept — dark filled */
    --cc-btn-primary-bg: #0f172a;
    --cc-btn-primary-color: #ffffff;
    --cc-btn-primary-hover-bg: #1e293b;

    /* Reject — white bg with border */
    --cc-btn-secondary-bg: #ffffff;
    --cc-btn-secondary-color: #0f172a;
    --cc-btn-secondary-hover-bg: #f8fafc;
    --cc-btn-secondary-border-color: #e2e8f0;

    /* Preferences modal toggle */
    --cc-toggle-on-bg: #0f172a;
    --cc-toggle-off-bg: #cbd5e1;
    --cc-toggle-readonly-bg: #e2e8f0;
  }

  /* Compact box with shadow, no harsh border */
  #cc-main .cm {
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.10), 0 1px 4px rgba(0, 0, 0, 0.06);
    border: 1px solid #f1f5f9;
    max-width: 300px;
  }

  /* Tighter padding */
  #cc-main .cm__body { padding: 0.85rem 1rem 0.5rem; }
  #cc-main .cm__footer { padding: 0.5rem 1rem 0.85rem; }
  #cc-main .cm__title { font-size: 0.8rem; font-weight: 600; margin-bottom: 0.25rem; }
  #cc-main .cm__desc { font-size: 0.72rem; line-height: 1.45; color: #64748b; }
  #cc-main .cm__desc a { color: #2563eb; text-decoration: none; }
  #cc-main .cm__desc a:hover { text-decoration: underline; }

  /* 2 buttons side by side */
  #cc-main .cm__btn-group { gap: 0.5rem; display: flex !important; flex-direction: row !important; flex-wrap: nowrap; }
  #cc-main .cm__btn { font-size: 0.78rem; padding: 0.45rem 0.9rem; font-weight: 500; flex: 1; text-align: center; min-width: 0; }
  #cc-main .cm__btn--secondary { border: 1px solid #e2e8f0; }

  /* Bottom-left margin so it clears StickyBar on mobile */
  @media (max-width: 1023px) {
    #cc-main .cm { margin-bottom: 4.5rem; }
  }
</style>
