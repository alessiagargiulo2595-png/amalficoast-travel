---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import CorrelationSlider from '../../../../components/CorrelationSlider.astro';
import Breadcrumbs from '../../../../components/Breadcrumbs.astro';

const lang = 'de-de';

const breadcrumbs = [
  { name: 'Home', url: '/de-de/' },
  { name: 'Inseln im Golf', url: '/de-de/inseln/' },
  { name: 'Anacapri', url: '/de-de/inseln/anacapri/' },
];

const touristAttractionSchema = {
  "@context": "https://schema.org",
  "@type": "TouristAttraction",
  "name": "Anacapri",
  "description": "Anacapri ist die hoeher gelegene Gemeinde der Insel Capri: Villa San Michele, Sessellift zum Monte Solaro (589 m), Kirche San Michele und atemberaubende Panoramen ueber den Golf von Neapel.",
  "url": "https://amalficoast-travel.com/de-de/inseln/anacapri/",
  "touristType": ["Kultur", "Natur", "Wandern", "Panoramen"],
  "address": { "@type": "PostalAddress", "addressLocality": "Anacapri", "addressRegion": "Napoli", "addressCountry": "IT", "postalCode": "80071" },
  "geo": { "@type": "GeoCoordinates", "latitude": 40.5520, "longitude": 14.2150 }
};

const placeSchema = {
  "@context": "https://schema.org",
  "@type": "Place",
  "name": "Anacapri, Insel Capri",
  "geo": { "@type": "GeoCoordinates", "latitude": 40.5520, "longitude": 14.2150 },
  "containedInPlace": { "@type": "AdministrativeArea", "name": "Insel Capri" }
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Wie kommt man von der Marina Grande nach Anacapri?",
      "acceptedAnswer": { "@type": "Answer", "text": "Von der Marina Grande nimmt man den direkten ATC-Bus nach Anacapri (ca. 15 Minuten, Ticket ~2 Euro). Alternativ kann man die Standseilbahn bis ins Zentrum von Capri nehmen und dann den Bus nach Anacapri. Die offenen Taxis kosten etwa 20-25 Euro." }
    },
    {
      "@type": "Question",
      "name": "Was kostet der Sessellift zum Monte Solaro?",
      "acceptedAnswer": { "@type": "Answer", "text": "Der Einsitzer-Sessellift von der Piazza Vittoria in Anacapri kostet etwa 12 Euro hin und zurueck (8 Euro einfach). Die Fahrt dauert ca. 12 Minuten mit spektakulaeren Panoramen. Oben gibt es eine Bar und den hoechsten Aussichtspunkt der Insel auf 589 Metern." }
    },
    {
      "@type": "Question",
      "name": "Lohnt sich der Besuch der Villa San Michele?",
      "acceptedAnswer": { "@type": "Answer", "text": "Absolut. Die Villa San Michele, erbaut vom schwedischen Arzt Axel Munthe auf den Ueberresten einer Kapelle und einer roemischen Villa des Tiberius, ist einer der suggestivsten Orte auf Capri. Der Garten mit der aegyptischen Sphinx und die Panoramaterrasse ueber dem Golf von Neapel sind unvergesslich. Eintritt ca. 8 Euro." }
    },
    {
      "@type": "Question",
      "name": "Anacapri oder Capri: Was ist der Unterschied?",
      "acceptedAnswer": { "@type": "Answer", "text": "Anacapri ist die hoeher gelegene Gemeinde der Insel (ca. 275 m ueber dem Meeresspiegel), ruhiger, gruener und authentischer. Capri-Zentrum ist mondaener, mit der Piazzetta, Luxusgeschaeften und Nachtleben. Anacapri ist ideal fuer alle, die Natur, Panoramen und ein entspannteres Tempo suchen." }
    },
    {
      "@type": "Question",
      "name": "Kann man die Blaue Grotte von Anacapri aus erreichen?",
      "acceptedAnswer": { "@type": "Answer", "text": "Ja. Von Anacapri kann man den Eingang der Blauen Grotte zu Fuss erreichen (ca. 30 Minuten bergab) oder mit dem Bus zur Grotta Azzurra. Die Bootsfahrt in die Grotte kostet ca. 14 Euro. Alternativ ist sie per Boot von der Marina Grande erreichbar." }
    }
  ]
};

const schemas = [touristAttractionSchema, placeSchema, faqSchema];

const fastFacts = [
  { dt: 'Lage', dd: 'Insel Capri, NA' },
  { dt: 'Hoehe', dd: '275 m u.d.M.' },
  { dt: 'Einwohner', dd: '~7.000' },
  { dt: 'Gipfel', dd: 'Monte Solaro 589 m' },
  { dt: 'Von Marina Grande', dd: '15 Min (ATC-Bus)' },
  { dt: 'Von Capri-Zentrum', dd: '10 Min (Bus)' },
  { dt: 'Top-Attraktion', dd: 'Villa San Michele' },
  { dt: 'Beste Reisezeit', dd: 'Apr-Jun / Sep-Okt' },
  { dt: 'Waehrung', dd: 'Euro (EUR)' },
];

const tips = [
  'Nehmen Sie den ersten Bus von der Marina Grande nach Anacapri (7:30 Uhr): Sie kommen vor dem Ansturm an und fahren den Sessellift ohne Wartezeit.',
  'Die Kirche San Michele besitzt einen Majolika-Fussboden von 1761, der von der Empore aus zu bewundern ist: Eintritt nur 2 Euro.',
  'Steigen Sie vom Monte Solaro zu Fuss ab statt mit dem Sessellift: Der Pfad fuehrt durch Steineichenwaelder und bietet unglaubliche Aussichten (45 Min).',
  'Die Via Orlandi ist die lokale Einkaufsstrasse: guenstiger als die Piazzetta in Capri, mit authentischen Handwerkslaeden.',
];
---

<BaseLayout
  title="Anacapri 2026: Kompletter Reisefuhrer | Villa San Michele, Monte Solaro & Blaue Grotte"
  description="Anacapri vollstaendiger Reisefuehrer: Villa San Michele, Sessellift Monte Solaro, Kirche San Michele, Blaue Grotte. Anreise, Sehenswuerdigkeiten, praktische Tipps fuer das obere Dorf auf Capri."
  lang={lang}
  breadcrumbs={breadcrumbs}
  schema={schemas}
  pageKey="anacapri"

  heroImage="/images/anacapri-hero.jpg"
>

  <section class="relative h-[75vh] sm:h-[90vh] flex items-center bg-charcoal overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-b from-black/75 via-black/40 to-black/70 z-10"></div>
    <img src="/images/anacapri-hero.jpg" alt="Anacapri: das obere Dorf von Capri mit Blick auf den Monte Solaro" class="absolute inset-0 w-full h-full object-cover" loading="eager" fetchpriority="high" decoding="sync" referrerpolicy="no-referrer"/>
    <div class="relative z-20 max-w-editorial mx-auto px-4 sm:px-6 lg:px-8">
      </nav>
      <div class="max-w-3xl">
        <p class="text-med-gold text-xs sm:text-sm font-medium uppercase tracking-[0.3em] mb-3">Insel Capri · Das obere Dorf</p>
        <h1 class="font-serif text-display text-white mb-4">Anacapri</h1>
        <p class="text-xl text-white/80 leading-relaxed max-w-2xl">
          Das gruene und stille Herz der Insel Capri: Villa San Michele, der Sessellift zum Monte Solaro und die spektakulaersten Panoramen des Golfs.
        </p>
        <div class="flex flex-wrap gap-3 mt-8">
          <a href="#fast-facts" class="px-5 py-2.5 bg-med-gold text-white text-xs sm:text-sm font-semibold rounded-full hover:scale-105 hover:shadow-[0_8px_25px_rgba(212,175,55,0.4)] transition-all duration-300">Fast Facts</a>
          <a href="#anreise" class="px-5 py-2.5 bg-white/10 backdrop-blur text-white text-xs sm:text-sm font-medium rounded-full border border-white/20 hover:bg-white/20 transition-colors">Anreise</a>
          <a href="#faq" class="px-5 py-2.5 bg-white/10 backdrop-blur text-white text-xs sm:text-sm font-medium rounded-full border border-white/20 hover:bg-white/20 transition-colors">FAQ</a>
        </div>
      </div>
    </div>

    <Breadcrumbs breadcrumbs={breadcrumbs} />
  </section>

  <section class="max-w-editorial mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="grid lg:grid-cols-[1fr_320px] gap-12">

      <div class="space-y-16">

        <div class="prose-editorial">
          <p class="text-xl leading-relaxed text-charcoal">
            Anacapri ist die zweite Gemeinde der Insel Capri, auf etwa 275 Metern ueber dem Meeresspiegel gelegen. Waehrend Capri-Zentrum fuer Glamour, Boutiquen und die Piazzetta steht, ist Anacapri das genaue Gegenteil: stille Gaerten, Panoramawege, authentische Doerfer und der hoechste Gipfel der Insel.
          </p>
          <p class="mt-4 text-slate-600 leading-relaxed">
            Der Name leitet sich vom griechischen "ana" (oben) und Capri ab: woertlich "oberhalb von Capri". Bis 1877 waren die beiden Gemeinden nur durch die Scala Fenicia verbunden, 921 in den Fels gehauene Stufen. Heute faehrt man bequem mit dem Bus hinauf, aber die Treppe existiert noch und ist eine der eindrucksvollsten Wanderungen der Insel.
          </p>
        </div>

        <div class="bg-slate-900 border border-white/10 rounded-[3rem] p-8">
          <p class="text-[10px] uppercase tracking-[0.3em] text-med-gold font-medium mb-4">Wusstest du?</p>
          <div class="grid sm:grid-cols-3 gap-6">
            <div class="text-center">
              <p class="font-serif text-5xl font-bold text-med-gold">589 m</p>
              <p class="text-white/60 text-xs italic mt-1">Monte Solaro, hoechster Gipfel</p>
            </div>
            <div class="text-center">
              <p class="font-serif text-5xl font-bold text-med-gold">921</p>
              <p class="text-white/60 text-xs italic mt-1">Stufen der Scala Fenicia</p>
            </div>
            <div class="text-center">
              <p class="font-serif text-5xl font-bold text-med-gold">1877</p>
              <p class="text-white/60 text-xs italic mt-1">Jahr der ersten Fahrstrasse</p>
            </div>
          </div>
          <p class="text-white/40 text-xs mt-6 italic">
            Axel Munthe, der schwedische Arzt, der die Villa San Michele erbaute, schrieb "Das Buch von San Michele" (1929), eines der meistverkauften Buecher des 20. Jahrhunderts, das vollstaendig in Anacapri spielt.
          </p>
        </div>

        <div>
          <h2 class="font-serif text-3xl font-semibold text-slate-900 mb-8">Sehenswuerdigkeiten in Anacapri</h2>
          <div class="space-y-8">
            {[
              {
                n: 1,
                title: 'Villa San Michele',
                text: 'Das Residenz-Museum des schwedischen Arztes Axel Munthe, erbaut auf den Ueberresten einer mittelalterlichen Kapelle und einer Villa des Tiberius. Der Garten mit der aegyptischen Sphinx und die Panoramaterrasse ueber dem Golf von Neapel gehoeren zu den ikonischsten Bildern von Capri. Eintritt ~8 Euro. Das ganze Jahr geoeffnet.',
              },
              {
                n: 2,
                title: 'Monte Solaro (Sessellift)',
                text: 'Der Einsitzer-Sessellift von der Piazza Vittoria bringt Sie in 12 Minuten auf den Gipfel des Monte Solaro (589 m). 360-Grad-Panorama: Capri, Ischia, Procida, der Vesuv, die Amalfikueste und bei klarem Wetter Kalabrien. Oben: Bar, Aussichtspunkt und das Heiligtum der Madonna del Soccorso.',
              },
              {
                n: 3,
                title: 'Kirche San Michele Arcangelo',
                text: 'Die Barockkirche aus dem 18. Jahrhundert beherbergt einen aussergewoehnlichen Majolika-Fussboden (1761), der die Vertreibung von Adam und Eva aus dem Paradies darstellt. Er wird von der Empore aus betrachtet, um ihn nicht zu betreten. Eintritt ~2 Euro. Am Piazza San Nicola.',
              },
              {
                n: 4,
                title: 'Scala Fenicia',
                text: 'Die uralte Treppe mit 921 Stufen, die die Marina Grande mit Anacapri verband, bevor die Strasse (1877) gebaut wurde. Im Abstieg in ca. 25 Minuten begehbar. Start an der Via Capodimonte in Anacapri, Ankunft in der Naahe des Hafens. Spektakulaere Aussicht beim Abstieg.',
              },
              {
                n: 5,
                title: 'Blaue Grotte',
                text: 'Von Anacapri mit dem Bus zur Grotta Azzurra oder zu Fuss (30 Min bergab) erreichbar. Die beruechmte Meereshoehle wird per Boot besichtigt: Das Licht faellt durch eine untergetauchte Oeffnung und taucht das Wasser in ein elektrisches Blau. Eintritt ~14 Euro. Bei rauem See nicht besuchen.',
              },
            ].map(({ n, title, text }) => (
              <div class="grid sm:grid-cols-[auto_1fr] gap-4">
                <div class="w-14 h-14 rounded-[1rem] bg-med-gold/10 flex items-center justify-center flex-shrink-0 text-med-gold font-serif font-bold text-xl">{n}</div>
                <div>
                  <h3 class="font-semibold text-charcoal text-lg mb-1">{title}</h3>
                  <p class="text-slate-600 leading-relaxed">{text}</p>
                </div>
              </div>
            ))}
          </div>
        </div>

        <div id="anreise">
          <h2 class="font-serif text-3xl font-semibold text-slate-900 mb-6">Anreise nach Anacapri</h2>
          <p class="text-slate-600 mb-8 leading-relaxed">Anacapri erreicht man von der Marina Grande auf Capri mit dem direkten ATC-Bus (ca. 15 Minuten). Alternativ kann man die Standseilbahn bis ins Zentrum von Capri nehmen und dann den Bus weiterfahren. Offene Taxis von der Marina kosten ca. 20-25 Euro.</p>

          <div class="overflow-x-auto rounded-2xl border border-slate-200">
            <table class="w-full text-xs sm:text-xs sm:text-sm">
              <caption class="text-left text-xs text-slate-500 px-4 py-2 bg-slate-50 rounded-t-2xl border-b border-slate-200 font-medium">
                Anreise nach und von Anacapri
              </caption>
              <thead>
                <tr class="bg-slate-900 text-white">
                  <th class="text-left px-4 py-3 font-semibold">Strecke</th>
                  <th class="text-left px-4 py-3 font-semibold">Verkehrsmittel</th>
                  <th class="text-left px-4 py-3 font-semibold">Dauer</th>
                  <th class="text-left px-4 py-3 font-semibold">Kosten</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-slate-100">
                {[
                  ['Marina Grande → Anacapri', 'ATC-Bus direkt', '~15 Min', '~2 EUR'],
                  ['Capri-Zentrum → Anacapri', 'ATC-Bus', '~10 Min', '~2 EUR'],
                  ['Marina Grande → Anacapri', 'Offenes Taxi', '~12 Min', '~20-25 EUR'],
                  ['Anacapri → Blaue Grotte', 'ATC-Bus', '~10 Min', '~2 EUR'],
                  ['Anacapri → Monte Solaro', 'Sessellift', '~12 Min', '~12 EUR H+R'],
                ].map(([strecke, verkehr, dauer, kosten]) => (
                  <tr class="hover:bg-slate-50 transition-colors">
                    <td class="px-4 py-3 font-medium text-charcoal">{strecke}</td>
                    <td class="px-4 py-3 text-slate-500">{verkehr}</td>
                    <td class="px-4 py-3 font-mono">{dauer}</td>
                    <td class="px-4 py-3 text-slate-500">{kosten}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          <p class="text-xs text-slate-400 mt-2">* Preise und Zeiten unverbindlich, Sommer 2026.</p>
        </div>

        <div>
          <h2 class="font-serif text-3xl font-semibold text-slate-900 mb-6">Wanderwege ab Anacapri</h2>
          <div class="grid sm:grid-cols-2 gap-6">
            {[
              { title: 'Scala Fenicia (Abstieg)', text: '921 Stufen von der Panoramastrasse hinunter zur Marina Grande. Ca. 25 Minuten bergab (45 bergauf). Unglaubliche Aussichten auf die Nordkueste der Insel. Start an der Via Capodimonte.' },
              { title: 'Sentiero dei Fortini', text: 'Kuestenweg von ca. 5 km, der die Blaue Grotte mit dem Leuchtturm Punta Carena verbindet und dabei drei borbonische Fortins passiert. Offener Meerblick, ideal bei Sonnenuntergang. Dauer ca. 2 Stunden.' },
              { title: 'Monte Solaro zu Fuss', text: 'Von der Piazza Vittoria steigt man zu Fuss zum Gipfel (589 m) in ca. 1 Stunde durch Steineichenwald und mediterrane Macchia. Kostenlose Alternative zum Sessellift.' },
              { title: 'Migliera - Belvedere della Migliara', text: 'Einfacher Spaziergang von ca. 30 Minuten vom Anacapri-Zentrum zum Aussichtspunkt ueber die Suedkueste und die Faraglioni. Fuer alle geeignet. Endet am Tuono, einem Panoramarestaurant.' },
            ].map(({ title, text }) => (
              <div class="bg-white rounded-[3rem] p-8 border border-slate-100 hover:shadow-xl transition-all duration-300">
                <h3 class="font-semibold text-charcoal mb-2">{title}</h3>
                <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">{text}</p>
              </div>
            ))}
          </div>
        </div>

        <div id="faq">
          <h2 class="font-serif text-3xl font-semibold text-slate-900 mb-8">Haeufig gestellte Fragen ueber Anacapri</h2>
          <div class="space-y-4">
            {faqSchema.mainEntity.map((q) => (
              <details class="group border border-slate-200 rounded-2xl overflow-hidden">
                <summary class="flex items-center justify-between px-6 py-4 cursor-pointer select-none text-charcoal font-medium hover:bg-slate-50 transition-colors">
                  {q.name}
                  <svg class="w-4 h-4 text-slate-400 group-open:rotate-180 transition-transform flex-shrink-0 ml-3" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
                </summary>
                <div class="px-6 pb-5 text-slate-600 leading-relaxed text-xs sm:text-sm border-t border-slate-100 pt-4">
                  {q.acceptedAnswer.text}
                </div>
              </details>
            ))}
          </div>
        </div>

      </div>

      <aside class="space-y-6 lg:sticky lg:top-24 self-start">
        <div id="fast-facts" class="bg-slate-900 text-white rounded-[3rem] p-6">
          <p class="text-[10px] uppercase tracking-[0.3em] text-med-gold font-medium mb-4">Fast Facts - Anacapri</p>
          <dl class="space-y-3">
            {fastFacts.map(({ dt, dd }, i) => (
              <>
                <div class="flex justify-between items-start gap-3">
                  <dt class="text-white/40 text-xs sm:text-sm font-light flex-shrink-0">{dt}</dt>
                  <dd class="text-white font-medium text-xs sm:text-sm text-right">{dd}</dd>
                </div>
                {i < fastFacts.length - 1 && <div class="border-t border-white/5"></div>}
              </>
            ))}
          </dl>
        </div>

        <div class="bg-med-cream border border-med-gold/30 rounded-[2rem] p-6">
          <p class="text-[10px] uppercase tracking-[0.3em] text-med-gold font-medium mb-3">Insider-Tipps</p>
          <ul class="space-y-3">
            {tips.map(tip => (
              <li class="flex items-start gap-2 text-xs sm:text-sm text-charcoal">
                <span class="w-1.5 h-1.5 rounded-full bg-med-gold mt-1.5 flex-shrink-0"></span>
                <span set:html={tip}></span>
              </li>
            ))}
          </ul>
        </div>

        <div class="bg-white border border-slate-100 rounded-[2rem] p-6 shadow-sm">
          <p class="text-[10px] uppercase tracking-[0.3em] text-slate-400 font-medium mb-3">Andere Golfinseln</p>
          <nav class="space-y-1">
            {[
              { href: '/de-de/inseln/capri/', label: 'Capri' },
              { href: '/de-de/inseln/ischia/', label: 'Ischia' },
              { href: '/de-de/inseln/forio/', label: 'Forio' },
              { href: '/de-de/inseln/procida/', label: 'Procida' },
            ].map(({ href, label }) => (
              <a href={href} class="flex items-center gap-2 px-3 py-2 rounded-xl text-xs sm:text-sm text-charcoal hover:bg-med-blue/5 hover:text-med-blue transition-colors">
                <span class="w-1.5 h-1.5 rounded-full bg-med-blue/30"></span> {label}
              </a>
            ))}
          </nav>
        </div>
      </aside>

    </div>
  </section>

  <CorrelationSlider
    lang="de-de"
    heading="Entdecken Sie die anderen Inseln und die Kueste"
    items={[
      { name: 'Capri',     href: '/de-de/inseln/capri/',                  tag: 'Die Ikonischste',    desc: 'Blaue Grotte, Faraglioni, die Piazzetta: die beruechmteste Insel des Golfs.' },
      { name: 'Ischia',    href: '/de-de/inseln/ischia/',                 tag: 'Thermen & Natur',    desc: 'Natuerliche Thermen, Aragonesische Burg, Monte Epomeo und vulkanische Straende.' },
      { name: 'Forio',     href: '/de-de/inseln/forio/',                  tag: 'Sonnenuntergaenge & Thermen', desc: 'Die Poseidon-Gaerten, die Soccorso-Kirche und die schoensten Sonnenuntergaenge Ischias.' },
      { name: 'Procida',   href: '/de-de/inseln/procida/',                tag: 'Die Authentischste', desc: 'Bunte Haeuser an der Marina Corricella, Italiens Kulturhauptstadt 2022.' },
      { name: 'Positano',  href: '/de-de/amalfikueste/positano/',         tag: 'Mode & Aussicht',    desc: 'Die bunten Haeuser direkt am Meer, Luxusboutiquen und der Strand Fornillo.' },
    ]}
  />

</BaseLayout>
