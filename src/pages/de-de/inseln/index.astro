---
import BaseLayout from '../../../layouts/BaseLayout.astro';

const lang = 'de-de';

const breadcrumbs = [
  { name: 'Home', url: '/de-de/' },
  { name: 'Golfinseln', url: '/de-de/inseln/' },
];

const isole = [
  {
    name: 'Capri',
    href: '/de-de/inseln/capri/',
    desc: 'Die Blaue Grotte, die Faraglioni-Felsen und die glamouröse Piazzetta: die ikonischste Insel im Golf von Neapel.',
    tag: 'Die ikonischste',
  },
  {
    name: 'Anacapri',
    href: '/de-de/inseln/anacapri/',
    desc: 'Das obere Dorf von Capri: Villa San Michele, der Sessellift zum Monte Solaro (589 m) und die antike Phönizische Treppe.',
    tag: 'Natur & Panoramen',
  },
  {
    name: 'Ischia',
    href: '/de-de/inseln/ischia/',
    desc: 'Die grüne Insel des Golfs: natürliche Thermalbäder, das Aragonesische Schloss, Vulkanstrände und der Monte Epomeo.',
    tag: 'Thermen & Natur',
  },
  {
    name: 'Forio',
    href: '/de-de/inseln/forio/',
    desc: 'Die Poseidon-Gärten, die Soccorso-Kirche bei Sonnenuntergang und die natürlichen Thermalquellen der Bucht von Sorgeto.',
    tag: 'Sonnenuntergänge & Thermen',
  },
  {
    name: 'Procida',
    href: '/de-de/inseln/procida/',
    desc: 'Die kleinste und authentischste: bunte Häuser an der Marina Corricella, italienische Kulturhauptstadt 2022.',
    tag: 'Die authentischste',
  },
];

const destinationSchema = {
  "@context": "https://schema.org",
  "@type": "TouristDestination",
  "name": "Inseln im Golf von Neapel",
  "description": "Capri, Anacapri, Ischia, Forio und Procida: die Inseln im Golf von Neapel, erreichbar per Fähre von Neapel, Pozzuoli und Sorrent.",
  "url": "https://amalficoast-travel.com/de-de/inseln/",
  "touristType": ["Meer", "Kultur", "Thermen", "Natur"],
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": 40.5500,
    "longitude": 14.1000
  }
};
---

<BaseLayout
  title="Inseln im Golf von Neapel 2026: Capri, Anacapri, Ischia, Forio & Procida"
  description="Reiseführer zu den Inseln im Golf von Neapel: Capri, Anacapri, Ischia, Forio und Procida. Anreise, Sehenswürdigkeiten, beste Reisezeit. Alles für die Planung Ihres Inselausflugs."
  lang={lang}
  breadcrumbs={breadcrumbs}
  schema={[destinationSchema]}
  pageKey="islands"

  heroImage="/images/isole-hero.jpg"
>

  <!-- Hero -->
  <section class="relative h-[75vh] sm:h-[90vh] flex items-center bg-charcoal overflow-hidden">
    <img src="/images/isole-hero.jpg" alt="Inseln im Golf von Neapel" class="absolute inset-0 w-full h-full object-cover" loading="eager" fetchpriority="high" decoding="sync" referrerpolicy="no-referrer"/>

    <div class="absolute inset-0 bg-gradient-to-b from-black/25 via-black/40 to-black/75"></div>
    <div class="relative z-10 max-w-7xl mx-auto px-6 py-24">
      <nav class="flex items-center gap-2 text-white/60 text-xs mb-6">
        <a href="/de-de/" class="hover:text-white transition-colors">Home</a>
        <span>/</span>
        <span class="text-white">Golfinseln</span>
      </nav>
      <div class="max-w-3xl">
        <p class="text-med-gold text-xs sm:text-sm font-medium uppercase tracking-[0.3em] mb-3">Golf von Neapel</p>
        <h1 class="font-serif text-display text-white mb-4">Die Golfinseln</h1>
        <p class="text-xl text-white/80 leading-relaxed">
          Drei verschiedene Inseln: Capri (Glamour, Blaue Grotte), Ischia (Vulkanthermen, Schloss), Procida (authentisch, ohne Massen). Alle in &lt;1 Stunde per Fähre ab Neapel.
        </p>
      </div>
    </div>
  </section>

  <div class="max-w-editorial mx-auto px-4 sm:px-6 lg:px-8 py-16 space-y-20">

    <!-- Intro -->
    <section class="text-justify">
      <p class="text-xl leading-relaxed text-charcoal">
        Der Golf von Neapel zählt zu den schönsten des Mittelmeers, und seine Inseln sind seine Krone. Jede hat einen starken, unverwechselbaren Charakter: Es ist schwer, sie alle auf einer Reise zu besuchen, aber unmöglich, sich für eine einzige zu entscheiden.
      </p>
      <p class="mt-4 text-slate-600 leading-relaxed">
        Capri, Ischia und Procida erreichen Sie alle ab Neapel Molo Beverello oder Pozzuoli mit häufigen Fähren und Tragflügelbooten. Im Sommer werden die Verbindungen vervielfacht. Von Sorrent erreichen Sie Capri in 20–25 Minuten mit dem Tragflügelboot.
      </p>
    </section>

    <!-- Isole Grid -->
    <section>
      <div class="flex items-end justify-between mb-8">
        <h2 class="font-serif text-3xl font-semibold">Die Golfinseln</h2>
        <p class="text-xs sm:text-sm text-slate-400 hidden sm:block">Golf von Neapel, Kampanien</p>
      </div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {isole.map((b, i) => {
          const stripeColors = ['#D4AF37', '#E2725B', '#005B96', '#40E0D0'];
          const stripeColor = stripeColors[i % stripeColors.length];
          return (
            <a href={b.href} class="group relative overflow-hidden bg-white border border-slate-100 rounded-[2rem] p-6 pl-7 shadow-sm hover:border-med-blue/30 hover:shadow-xl transition-all duration-300">
              <span class="absolute left-0 top-0 bottom-0 w-1.5" style={`background-color: ${stripeColor}`}></span>
              <div class="flex items-start justify-between mb-3">
                <h3 class="font-serif text-xl font-semibold text-slate-900 group-hover:text-med-blue transition-colors">{b.name}</h3>
                <span class="text-[10px] uppercase tracking-wide px-2 py-1 rounded-full font-semibold flex-shrink-0 ml-2 text-white" style={`background-color: ${stripeColor}`}>{b.tag}</span>
              </div>
              <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">{b.desc}</p>
              <p class="text-med-blue text-xs sm:text-sm font-medium mt-4 group-hover:translate-x-1 transition-transform inline-flex items-center gap-1">
                {b.name} entdecken
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 18l6-6-6-6"/></svg>
              </p>
            </a>
          );
        })}
      </div>
    </section>

    <!-- Stats -->
    <section class="bg-charcoal text-white rounded-[2rem] p-10">
      <p class="text-[10px] uppercase tracking-[0.3em] text-med-gold font-medium mb-8">Die Inseln in Zahlen</p>
      <div class="grid sm:grid-cols-4 gap-8 text-center">
        <div>
          <p class="font-serif text-5xl font-bold text-med-gold">3</p>
          <p class="text-white/60 text-xs sm:text-sm mt-2">Inseln im Golf von Neapel</p>
        </div>
        <div>
          <p class="font-serif text-5xl font-bold text-med-gold">25 Min.</p>
          <p class="text-white/60 text-xs sm:text-sm mt-2">Sorrent → Capri mit Tragflügelboot</p>
        </div>
        <div>
          <p class="font-serif text-5xl font-bold text-med-gold">789 m</p>
          <p class="text-white/60 text-xs sm:text-sm mt-2">Monte Epomeo, Ischia</p>
        </div>
        <div>
          <p class="font-serif text-5xl font-bold text-med-gold">2022</p>
          <p class="text-white/60 text-xs sm:text-sm mt-2">Procida Kulturhauptstadt</p>
        </div>
      </div>
    </section>

    <!-- Come arrivare riepilogo -->
    <section>
      <h2 class="font-serif text-3xl font-semibold text-slate-900 mb-8">Anreise zu den Inseln</h2>
      <div class="overflow-x-auto rounded-2xl border border-slate-200">
        <table class="w-full text-xs sm:text-xs sm:text-sm">
          <thead>
            <tr class="bg-slate-900 text-white">
              <th class="text-left px-4 py-3 font-semibold">Insel</th>
              <th class="text-left px-4 py-3 font-semibold">Ab Neapel (Beverello)</th>
              <th class="text-left px-4 py-3 font-semibold">Ab Sorrent</th>
              <th class="text-left px-4 py-3 font-semibold">Ab Pozzuoli</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100">
            <tr class="hover:bg-slate-50 transition-colors">
              <td class="px-4 py-3 font-semibold text-charcoal">Capri</td>
              <td class="px-4 py-3">~50 Min. (Fähre) / ~40 Min. (Tragflügelboot)</td>
              <td class="px-4 py-3">~20–25 Min. (Tragflügelboot)</td>
              <td class="px-4 py-3 text-slate-400">-</td>
            </tr>
            <tr class="hover:bg-slate-50 transition-colors">
              <td class="px-4 py-3 font-semibold text-charcoal">Ischia</td>
              <td class="px-4 py-3">~75 Min. (Fähre) / ~50 Min. (Tragflügelboot)</td>
              <td class="px-4 py-3 text-slate-400">-</td>
              <td class="px-4 py-3">~35 Min. (Fähre)</td>
            </tr>
            <tr class="hover:bg-slate-50 transition-colors">
              <td class="px-4 py-3 font-semibold text-charcoal">Procida</td>
              <td class="px-4 py-3">~35 Min. (Tragflügelboot)</td>
              <td class="px-4 py-3 text-slate-400">-</td>
              <td class="px-4 py-3">~15 Min. (Fähre)</td>
            </tr>
          </tbody>
        </table>
      </div>
      <p class="text-xs text-slate-400 mt-2">* Richtwerte. Aktuelle Fahrpläne auf caremar.it, snav.it, medmar.it.</p>
    </section>

  </div>

</BaseLayout>
