---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import CorrelationSlider from '../../../../components/CorrelationSlider.astro';
import Breadcrumbs from '../../../../components/Breadcrumbs.astro';

const lang = 'de-de';

const breadcrumbs = [
  { name: 'Home', url: '/de-de/' },
  { name: 'Inseln im Golf', url: '/de-de/inseln/' },
  { name: 'Forio', url: '/de-de/inseln/forio/' },
];

const touristAttractionSchema = {
  "@context": "https://schema.org",
  "@type": "TouristAttraction",
  "name": "Forio d'Ischia",
  "description": "Forio ist die groesste Gemeinde der Insel Ischia: die Poseidon-Gaerten, die Soccorso-Kirche, die Bucht von Citara, Sonnenuntergaenge am Meer und natuerliche Thermen machen es zu einem unverzichtbaren Reiseziel.",
  "url": "https://amalficoast-travel.com/de-de/inseln/forio/",
  "touristType": ["Thermen", "Strand", "Kultur", "Sonnenuntergaenge"],
  "address": { "@type": "PostalAddress", "addressLocality": "Forio", "addressRegion": "Napoli", "addressCountry": "IT", "postalCode": "80075" },
  "geo": { "@type": "GeoCoordinates", "latitude": 40.7365, "longitude": 13.8570 }
};

const placeSchema = {
  "@context": "https://schema.org",
  "@type": "Place",
  "name": "Forio, Insel Ischia",
  "geo": { "@type": "GeoCoordinates", "latitude": 40.7365, "longitude": 13.8570 },
  "containedInPlace": { "@type": "AdministrativeArea", "name": "Insel Ischia" }
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Wie kommt man von Neapel nach Forio?",
      "acceptedAnswer": { "@type": "Answer", "text": "Von Neapel nimmt man die Faehre oder das Tragfluegelboot nach Ischia Porto (ca. 50-75 Minuten). Von dort erreicht man Forio mit dem Bus (Linie CD oder CS, ca. 25-30 Minuten) oder per Taxi. Alternativ fahren einige Medmar-Faehren von Pozzuoli nach Casamicciola, von wo Forio noch naeher ist." }
    },
    {
      "@type": "Question",
      "name": "Was kosten die Poseidon-Gaerten?",
      "acceptedAnswer": { "@type": "Answer", "text": "Der Eintritt in die Giardini Poseidon Terme kostet ca. 35-38 Euro fuer den ganzen Tag (Halbtag ab 13 Uhr ca. 30 Euro). Der Park umfasst 22 Thermalbecken mit verschiedenen Temperaturen, einen Privatstrand, Sauna und Gaerten. Er ist der groesste und beruechmteste Thermalpark auf Ischia." }
    },
    {
      "@type": "Question",
      "name": "Welches ist der schoenste Strand in Forio?",
      "acceptedAnswer": { "@type": "Answer", "text": "Die Baia di Citara ist der bekannteste Strand, mit feinem Sand und klarem Wasser. Der Spiaggia di San Francesco ist kleiner und ruhiger. Die Baia di Sorgeto bietet natuerliche Pools mit warmem Thermalwasser, das sich mit dem Meer vermischt (kostenlos, ueber eine Treppe erreichbar)." }
    },
    {
      "@type": "Question",
      "name": "Was kann man in Forio an einem Tag sehen?",
      "acceptedAnswer": { "@type": "Answer", "text": "An einem Tag kann man die Soccorso-Kirche beim Sonnenuntergang besuchen, morgens die Gaerten La Mortella, die Altstadt mit den Sarazenentuermen, und nachmittags die Baia di Citara oder die Poseidon-Gaerten. Wenn noch Zeit bleibt, die Baia di Sorgeto fuer ein Thermalbad bei Sonnenuntergang." }
    },
    {
      "@type": "Question",
      "name": "Wann sollte man Forio am besten besuchen?",
      "acceptedAnswer": { "@type": "Answer", "text": "Mai, Juni und September sind die idealen Monate: perfektes Klima, warmes Meer, weniger Gedraenge als im Juli und August. Die Gaerten La Mortella sind von April bis November geoeffnet. Die Poseidon-Gaerten sind von April bis Oktober geoeffnet. Der Winter ist sehr ruhig mit einigen eingeschraenkten Diensten." }
    }
  ]
};

const schemas = [touristAttractionSchema, placeSchema, faqSchema];

const fastFacts = [
  { dt: 'Lage', dd: 'Westkueste Ischia, NA' },
  { dt: 'Einwohner', dd: '~18.000' },
  { dt: 'Groesste Gemeinde', dd: 'Der Insel Ischia' },
  { dt: 'Von Ischia Porto', dd: '25-30 Min (Bus CD/CS)' },
  { dt: 'Von Neapel', dd: '50-75 Min + Bus' },
  { dt: 'Thermen', dd: 'Poseidon-Gaerten, Sorgeto' },
  { dt: 'Top-Strand', dd: 'Baia di Citara' },
  { dt: 'Beste Reisezeit', dd: 'Mai-Jun / Sep' },
  { dt: 'Waehrung', dd: 'Euro (EUR)' },
];

const tips = [
  'Die Soccorso-Kirche beim Sonnenuntergang ist eines der schoensten Schauspiele im gesamten Golf von Neapel: 30 Minuten frueher ankommen, um einen guten Platz zu finden.',
  'Die Gaerten La Mortella sind nur an bestimmten Tagen geoeffnet: Kalender vor der Planung auf lamortella.org pruefen.',
  'Die Baia di Sorgeto ist kostenlos, aber man steigt ca. 200 Stufen hinunter: bei Sonnenuntergang fuer das stimmungsvollste Thermalbad hingehen.',
  'Der Kreisbus CD (im Uhrzeigersinn) und CS (gegen den Uhrzeigersinn) verbinden alle Gemeinden Ischias: 90-Min-Ticket ~2 Euro.',
];
---

<BaseLayout
  title="Forio auf Ischia 2026: Kompletter Reisefuhrer | Poseidon-Garten, Soccorso-Kirche & Thermen"
  description="Forio auf Ischia vollstaendiger Reisefuehrer: Poseidon-Gaerten, Soccorso-Kirche, Baia di Citara, La Mortella, Sorgeto. Anreise, Sehenswuerdigkeiten, Thermen und Sonnenuntergaenge."
  lang={lang}
  breadcrumbs={breadcrumbs}
  schema={schemas}
  pageKey="forio"
>

  <section class="relative h-[75vh] sm:h-[90vh] flex items-center bg-charcoal overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-b from-black/75 via-black/40 to-black/70 z-10"></div>
    <img src="/images/forio-hero.jpg" alt="" class="absolute inset-0 w-full h-full object-cover" loading="eager" referrerpolicy="no-referrer"/>
    <div class="relative z-20 max-w-editorial mx-auto px-4 sm:px-6 lg:px-8">
      </nav>
      <div class="max-w-3xl">
        <p class="text-med-gold text-xs sm:text-sm font-medium uppercase tracking-[0.3em] mb-3">Insel Ischia · Westkueste</p>
        <h1 class="font-serif text-display text-white mb-4">Forio</h1>
        <p class="text-xl text-white/80 leading-relaxed max-w-2xl">
          Thermen unter freiem Himmel, legendaere Sonnenuntergaenge an der Soccorso-Kirche und die Poseidon-Gaerten: Forio ist das pulsierende Herz der Westkueste Ischias.
        </p>
        <div class="flex flex-wrap gap-3 mt-8">
          <a href="#fast-facts" class="px-5 py-2.5 bg-med-gold text-white text-xs sm:text-sm font-semibold rounded-full hover:scale-105 hover:shadow-[0_8px_25px_rgba(212,175,55,0.4)] transition-all duration-300">Fast Facts</a>
          <a href="#anreise" class="px-5 py-2.5 bg-white/10 backdrop-blur text-white text-xs sm:text-sm font-medium rounded-full border border-white/20 hover:bg-white/20 transition-colors">Anreise</a>
          <a href="#faq" class="px-5 py-2.5 bg-white/10 backdrop-blur text-white text-xs sm:text-sm font-medium rounded-full border border-white/20 hover:bg-white/20 transition-colors">FAQ</a>
        </div>
      </div>
    </div>

    <Breadcrumbs breadcrumbs={breadcrumbs} />
  </section>

  <section class="max-w-editorial mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="grid lg:grid-cols-[1fr_320px] gap-12">

      <div class="space-y-16">

        <div class="prose-editorial">
          <p class="text-xl leading-relaxed text-charcoal">
            Forio ist die groesste Gemeinde der Insel Ischia und nimmt die gesamte Westkueste ein. Es ist der Punkt der Insel, an dem die Sonne ueber dem offenen Meer untergeht - und genau dieser geografische Umstand hat seine Identitaet gepraegt: ein Ort des goldenen Lichts, vulkanischer Thermen und ueppiger Gaerten.
          </p>
          <p class="mt-4 text-slate-600 leading-relaxed">
            Historisch ein Fischer- und Bauernort, wurde Forio in den 1950er Jahren von europaeischen Kuenstlern und Intellektuellen entdeckt - Truman Capote, W.H. Auden und Hans Werner Henze komponierten hier einige ihrer wichtigsten Werke. Heute ist es das ideale Reiseziel fuer alle, die die authentischere und natuerlichere Seite Ischias suchen, fernab des Trubels von Ischia Porto.
          </p>
        </div>

        <div class="bg-slate-900 border border-white/10 rounded-[3rem] p-8">
          <p class="text-[10px] uppercase tracking-[0.3em] text-med-gold font-medium mb-4">Wusstest du?</p>
          <div class="grid sm:grid-cols-3 gap-6">
            <div class="text-center">
              <p class="font-serif text-5xl font-bold text-med-gold">22</p>
              <p class="text-white/60 text-xs italic mt-1">Thermalbecken in den Poseidon-Gaerten</p>
            </div>
            <div class="text-center">
              <p class="font-serif text-5xl font-bold text-med-gold">12</p>
              <p class="text-white/60 text-xs italic mt-1">Sarazenentuermen im Gemeindegebiet</p>
            </div>
            <div class="text-center">
              <p class="font-serif text-5xl font-bold text-med-gold">1958</p>
              <p class="text-white/60 text-xs italic mt-1">Gruendungsjahr der Gaerten La Mortella</p>
            </div>
          </div>
          <p class="text-white/40 text-xs mt-6 italic">
            Lady Susana Walton, Ehefrau des englischen Komponisten William Walton, schuf die Gaerten La Mortella in Forio mit Hilfe des Landschaftsarchitekten Russell Page. Heute finden dort jeden Wochenende Kammerkonzerte statt.
          </p>
        </div>

        <div>
          <h2 class="font-serif text-3xl font-semibold text-slate-900 mb-8">Sehenswuerdigkeiten in Forio</h2>
          <div class="space-y-8">
            {[
              {
                n: 1,
                title: 'Soccorso-Kirche',
                text: 'Die weisse Kirche auf dem Vorgebirge ist das Wahrzeichen von Forio und ganz Ischia. Im 14. Jahrhundert erbaut, blickt sie direkt auf das offene Meer mit einem mit Majolika gepflasterten Vorplatz. Bei Sonnenuntergang wird sie zur spektakulaersten Naturbuehne der Insel. Eintritt frei.',
              },
              {
                n: 2,
                title: 'Poseidon-Gaerten (Thermen)',
                text: 'Der groesste und beruechmteste Thermalpark Ischias: 22 Becken mit verschiedenen Temperaturen (von 20 bis 40 Grad), natuerliche Grottensauna, Privatstrand an der Baia di Citara. Ein ganzer Tag der Entspannung. Eintritt ca. 35-38 Euro ganzer Tag. Geoeffnet April-Oktober.',
              },
              {
                n: 3,
                title: 'Gaerten La Mortella',
                text: 'Einer der schoensten botanischen Gaerten des Mittelmeers, von Lady Walton 1958 angelegt. Zwei Hektar tropische und mediterrane Pflanzen, Brunnen, Seerosen, ein Museum und ein Konzertsaal mit woeuchentlichen Recitals. Eintritt ca. 12 Euro. Einige Tage pro Woche geoeffnet (Kalender pruefen).',
              },
              {
                n: 4,
                title: 'Baia di Sorgeto',
                text: 'Natuerliche Pools, wo warmes Thermalwasser aus den Felsen sprudelt und sich mit dem kalten Meer mischt. Erreichbar ueber ca. 200 Stufen vom Ortsteil Panza. Kostenlos und das ganze Jahr geoeffnet, auch nachts. Das Bad bei Sonnenuntergang oder unter den Sternen ist ein einzigartiges Erlebnis.',
              },
              {
                n: 5,
                title: 'Altstadt und Sarazenentuermen',
                text: 'Das Zentrum von Forio bewahrt 12 Wachtuermen aus dem 15.-16. Jahrhundert, die zum Schutz vor Sarazenenueberiaellen errichtet wurden. Der Torre Torrione ist der groesste und beherbergt ein Stadtmuseum. Das Dorf ist ein Geflecht aus Gassen, Barockkirchen, Handwerkslaeden und typischen Restaurants.',
              },
            ].map(({ n, title, text }) => (
              <div class="grid sm:grid-cols-[auto_1fr] gap-4">
                <div class="w-14 h-14 rounded-[1rem] bg-med-gold/10 flex items-center justify-center flex-shrink-0 text-med-gold font-serif font-bold text-xl">{n}</div>
                <div>
                  <h3 class="font-semibold text-charcoal text-lg mb-1">{title}</h3>
                  <p class="text-slate-600 leading-relaxed">{text}</p>
                </div>
              </div>
            ))}
          </div>
        </div>

        <div id="anreise">
          <h2 class="font-serif text-3xl font-semibold text-slate-900 mb-6">Anreise nach Forio</h2>
          <p class="text-slate-600 mb-8 leading-relaxed">Forio erreicht man mit der Faehre oder dem Tragfluegelboot von Neapel oder Pozzuoli bis Ischia Porto oder Casamicciola, dann mit dem Kreisbus. Es gibt keine direkten Schiffsverbindungen nach Forio.</p>

          <div class="overflow-x-auto rounded-2xl border border-slate-200">
            <table class="w-full text-xs sm:text-xs sm:text-sm">
              <caption class="text-left text-xs text-slate-500 px-4 py-2 bg-slate-50 rounded-t-2xl border-b border-slate-200 font-medium">
                Anreise nach Forio
              </caption>
              <thead>
                <tr class="bg-slate-900 text-white">
                  <th class="text-left px-4 py-3 font-semibold">Strecke</th>
                  <th class="text-left px-4 py-3 font-semibold">Verkehrsmittel</th>
                  <th class="text-left px-4 py-3 font-semibold">Dauer</th>
                  <th class="text-left px-4 py-3 font-semibold">Kosten</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-slate-100">
                {[
                  ['Neapel → Ischia Porto', 'Tragfluegelboot (NLG/Alilauro)', '~50 Min', '~20 EUR'],
                  ['Neapel → Ischia Porto', 'Faehre (Caremar)', '~75 Min', '~13 EUR'],
                  ['Pozzuoli → Casamicciola', 'Faehre (Medmar)', '~35 Min', '~10 EUR'],
                  ['Ischia Porto → Forio', 'Bus CD/CS', '~25-30 Min', '~2 EUR'],
                  ['Casamicciola → Forio', 'Bus CD/CS', '~15 Min', '~2 EUR'],
                ].map(([strecke, verkehr, dauer, kosten]) => (
                  <tr class="hover:bg-slate-50 transition-colors">
                    <td class="px-4 py-3 font-medium text-charcoal">{strecke}</td>
                    <td class="px-4 py-3 text-slate-500">{verkehr}</td>
                    <td class="px-4 py-3 font-mono">{dauer}</td>
                    <td class="px-4 py-3 text-slate-500">{kosten}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          <p class="text-xs text-slate-400 mt-2">* Preise und Zeiten unverbindlich, Sommer 2026. Pruefen Sie caremar.it, medmar.it, alilauro.it.</p>
        </div>

        <div>
          <h2 class="font-serif text-3xl font-semibold text-slate-900 mb-6">Straende von Forio</h2>
          <div class="grid sm:grid-cols-2 gap-6">
            {[
              { title: 'Baia di Citara', text: 'Der groesste und am besten ausgestattete Strand von Forio, mit feinem goldenem Sand und tuerkisfarbenem Wasser. Hier befinden sich die Poseidon-Gaerten. Liegestuehle und ein freier Strandabschnitt. Nach Westen ausgerichtet: ideal fuer Sonnenuntergaenge.' },
              { title: 'Spiaggia di San Francesco', text: 'Kleiner Strand unterhalb der Soccorso-Kirche, ruhiger und geborgener als die Citara. Sand und Kiesel, kristallklares Wasser. Vom Stadtzentrum von Forio in 5 Minuten zu Fuss erreichbar.' },
              { title: "Spiaggia di Cava dell'Isola", text: 'Wilde Bucht an der Nordkueste von Forio, beliebt bei Surfern und Naturliebhabern. Weniger ausgestattet, authentischer. Per Auto oder Bus + kurzer Fussweg erreichbar.' },
              { title: 'Baia di Sorgeto (Thermen)', text: 'Kein traditioneller Strand, sondern natuerliche Thermalpools zwischen den Felsen. Das warme Vulkanwasser mischt sich mit dem kalten Meer. Kostenlos, das ganze Jahr geoeffnet. Ca. 200 Stufen hinunter vom Ortsteil Panza.' },
            ].map(({ title, text }) => (
              <div class="bg-white rounded-[3rem] p-8 border border-slate-100 hover:shadow-xl transition-all duration-300">
                <h3 class="font-semibold text-charcoal mb-2">{title}</h3>
                <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">{text}</p>
              </div>
            ))}
          </div>
        </div>

        <div id="faq">
          <h2 class="font-serif text-3xl font-semibold text-slate-900 mb-8">Haeufig gestellte Fragen ueber Forio</h2>
          <div class="space-y-4">
            {faqSchema.mainEntity.map((q) => (
              <details class="group border border-slate-200 rounded-2xl overflow-hidden">
                <summary class="flex items-center justify-between px-6 py-4 cursor-pointer select-none text-charcoal font-medium hover:bg-slate-50 transition-colors">
                  {q.name}
                  <svg class="w-4 h-4 text-slate-400 group-open:rotate-180 transition-transform flex-shrink-0 ml-3" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
                </summary>
                <div class="px-6 pb-5 text-slate-600 leading-relaxed text-xs sm:text-sm border-t border-slate-100 pt-4">
                  {q.acceptedAnswer.text}
                </div>
              </details>
            ))}
          </div>
        </div>

      </div>

      <aside class="space-y-6 lg:sticky lg:top-24 self-start">
        <div id="fast-facts" class="bg-slate-900 text-white rounded-[3rem] p-6">
          <p class="text-[10px] uppercase tracking-[0.3em] text-med-gold font-medium mb-4">Fast Facts - Forio</p>
          <dl class="space-y-3">
            {fastFacts.map(({ dt, dd }, i) => (
              <>
                <div class="flex justify-between items-start gap-3">
                  <dt class="text-white/40 text-xs sm:text-sm font-light flex-shrink-0">{dt}</dt>
                  <dd class="text-white font-medium text-xs sm:text-sm text-right">{dd}</dd>
                </div>
                {i < fastFacts.length - 1 && <div class="border-t border-white/5"></div>}
              </>
            ))}
          </dl>
        </div>

        <div class="bg-med-cream border border-med-gold/30 rounded-[2rem] p-6">
          <p class="text-[10px] uppercase tracking-[0.3em] text-med-gold font-medium mb-3">Insider-Tipps</p>
          <ul class="space-y-3">
            {tips.map(tip => (
              <li class="flex items-start gap-2 text-xs sm:text-sm text-charcoal">
                <span class="w-1.5 h-1.5 rounded-full bg-med-gold mt-1.5 flex-shrink-0"></span>
                <span set:html={tip}></span>
              </li>
            ))}
          </ul>
        </div>

        <div class="bg-white border border-slate-100 rounded-[2rem] p-6 shadow-sm">
          <p class="text-[10px] uppercase tracking-[0.3em] text-slate-400 font-medium mb-3">Andere Golfinseln</p>
          <nav class="space-y-1">
            {[
              { href: '/de-de/inseln/capri/', label: 'Capri' },
              { href: '/de-de/inseln/anacapri/', label: 'Anacapri' },
              { href: '/de-de/inseln/ischia/', label: 'Ischia' },
              { href: '/de-de/inseln/procida/', label: 'Procida' },
            ].map(({ href, label }) => (
              <a href={href} class="flex items-center gap-2 px-3 py-2 rounded-xl text-xs sm:text-sm text-charcoal hover:bg-med-blue/5 hover:text-med-blue transition-colors">
                <span class="w-1.5 h-1.5 rounded-full bg-med-blue/30"></span> {label}
              </a>
            ))}
          </nav>
        </div>
      </aside>

    </div>
  </section>

  <CorrelationSlider
    lang="de-de"
    heading="Entdecken Sie die anderen Inseln und die Kueste"
    items={[
      { name: 'Ischia',    href: '/de-de/inseln/ischia/',                 tag: 'Thermen & Natur',    desc: 'Natuerliche Thermen, Aragonesische Burg, Monte Epomeo und vulkanische Straende.' },
      { name: 'Capri',     href: '/de-de/inseln/capri/',                  tag: 'Die Ikonischste',    desc: 'Blaue Grotte, Faraglioni, die Piazzetta: die beruechmteste Insel des Golfs.' },
      { name: 'Anacapri',  href: '/de-de/inseln/anacapri/',               tag: 'Natur & Panoramen',  desc: 'Villa San Michele, Monte Solaro, Scala Fenicia: das obere Dorf auf Capri.' },
      { name: 'Procida',   href: '/de-de/inseln/procida/',                tag: 'Die Authentischste', desc: 'Bunte Haeuser an der Marina Corricella, Italiens Kulturhauptstadt 2022.' },
      { name: 'Positano',  href: '/de-de/amalfikusete/positano/',         tag: 'Mode & Aussicht',    desc: 'Die bunten Haeuser direkt am Meer, Luxusboutiquen und der Strand Fornillo.' },
    ]}
  />

</BaseLayout>
