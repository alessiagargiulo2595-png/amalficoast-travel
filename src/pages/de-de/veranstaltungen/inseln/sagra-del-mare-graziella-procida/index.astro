---
import BaseLayout from '../../../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../../../components/Breadcrumbs.astro';
import LocalitySlider from '../../../../../components/LocalitySlider.astro';

const lang = 'de-de';

const breadcrumbs = [
  { name: 'Home', url: '/de-de/' },
  { name: 'Veranstaltungen', url: '/de-de/veranstaltungen/' },
  { name: 'Sagra del Mare – Procida', url: '/de-de/veranstaltungen/inseln/sagra-del-mare-graziella-procida/' },
];

const eventSchema = {
  "@context": "https://schema.org",
  "@type": "EventSeries",
  "name": "Sagra del Mare Procida",
  "description": "Die Sagra del Mare in Procida im Juli 2026. Ein Meeresfest, das die Figur der Graziella – literarisches Symbol Procidas – mit historischen Nachstellungen und frischen Meeresfrüchten feiert.",
  "image": "https://amalficoast-travel.com/images/procida-hero.jpg",
  "url": "https://amalficoast-travel.com/de-de/veranstaltungen/inseln/sagra-del-mare-graziella-procida/",
  "location": {
      "@type": "Place",
      "name": "Procida",
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Procida",
        "addressRegion": "NA",
        "addressCountry": "IT"
      }
    },
  "eventStatus": "https://schema.org/EventScheduled",
  "eventAttendanceMode": "https://schema.org/OfflineEventAttendanceMode",
  "subEvent": [
    {
      "@type": "Event",
      "name": "Sagra del Mare Procida 2026",
      "startDate": "2026-07-01",
      "endDate": "2026-07-31",
      "eventStatus": "https://schema.org/EventScheduled",
      "eventAttendanceMode": "https://schema.org/OfflineEventAttendanceMode",
      "location": {
          "@type": "Place",
          "name": "Procida",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Procida",
            "addressRegion": "NA",
            "addressCountry": "IT"
          }
        },
      "url": "https://amalficoast-travel.com/de-de/veranstaltungen/inseln/sagra-del-mare-graziella-procida/",
      "image": "https://amalficoast-travel.com/images/procida-hero.jpg",
      "description": "Die Sagra del Mare in Procida im Juli 2026. Ein Meeresfest, das die Figur der Graziella – literarisches Symbol Procidas – mit historischen Nachstellungen und frischen Meeresfrüchten feiert."
    }
  ]
};

const facts = [
  { dt: 'Zeitraum', dd: 'Juli 2026' },
  { dt: 'Veranstaltungsort', dd: 'Procida' },
  { dt: 'Typ', dd: 'Meeres- & Literaturfest' },
  { dt: 'Symbol', dd: 'Figur der Graziella' },
  { dt: 'Ab Neapel', dd: 'Fähre, ca. 40 min' },
];
---

<BaseLayout
  title="Sagra del Mare Procida 2026 – Die Legende der Graziella"
  description="Die Sagra del Mare in Procida im Juli 2026. Ein Meeresfest, das die Figur der Graziella – literarisches Symbol Procidas – mit historischen Nachstellungen und frischen Meeresfrüchten feiert."
  lang={lang}
  breadcrumbs={breadcrumbs}
  schema={[eventSchema]}
 pageKey="sagra-del-mare-graziella-procida"
  heroImage="/images/procida-hero.jpg"
>

  <!-- Hero -->
  <section class="relative h-[65vh] sm:h-[70vh] overflow-hidden flex items-center justify-center">
    <img
      src="/images/procida-hero.jpg"
      alt="Sagra del Mare, Procida"
      class="absolute inset-0 w-full h-full object-cover"
      loading="eager" fetchpriority="high" decoding="sync" referrerpolicy="no-referrer"
    />
    <div class="absolute inset-0 bg-gradient-to-b from-black/20 via-black/50 to-black/70"></div>
    <div class="relative z-10 text-center px-6 max-w-5xl text-white">
      <div class="flex flex-wrap justify-center items-center gap-4 mb-6">
        <span class="bg-med-gold text-white px-4 py-1 rounded-full text-[10px] font-bold uppercase tracking-widest">Veranstaltung 2026</span>
        <span class="text-white/70 text-xs sm:text-sm">Juli 2026</span>
        <span class="text-white/70 text-xs sm:text-sm">Procida, NA</span>
      </div>
      <h1 class="font-serif text-5xl md:text-7xl font-bold text-white leading-tight mb-6">Sagra del Mare – Procida</h1>
      <p class="text-white/85 text-lg md:text-xl font-light max-w-2xl mx-auto leading-relaxed">
        Die Legende der Graziella zwischen Meerestradition und Literaturgeschichte.
      </p>
    </div>
    <Breadcrumbs breadcrumbs={breadcrumbs} isEvent={true} />
  </section>

  <!-- Content 70/30 -->
  <section class="py-12 sm:py-24 px-6 max-w-7xl mx-auto">
    <div class="grid grid-cols-1 lg:grid-cols-10 gap-16">

      <!-- Main Content (70%) -->
      <div class="lg:col-span-7 space-y-12">
        <div>
          <h2 class="font-serif text-4xl font-bold text-slate-900 mb-8">Zur Veranstaltung</h2>
          <div class="space-y-4 text-slate-600 text-lg leading-relaxed">
            <p>Die Sagra del Mare auf Procida vereint Meereskultur, lokale Gastronomie und Literatur in einem einzigartigen Fest. Im Mittelpunkt steht die Figur der Graziella – die junge Fischerin, die der französische Schriftsteller Alphonse de Lamartine im 19. Jahrhundert in seinem gleichnamigen Roman verewigt hat und die zum literarischen Symbol der Insel wurde.</p>
            <p>Historische Nachstellungen in historischen Kostümen, frische Meeresfrüchte direkt vom Hafen und Musik machen das Fest zu einem der stimmungsvollsten Sommerereignisse im Golf von Neapel. Procida, seit 2022 Kulturhauptstadt Italiens, hat das Fest zu einem Aushängeschild seiner Identität gemacht.</p>
          </div>
        </div>

        <!-- Das Fest -->
        <div>
          <h3 class="font-serif text-2xl font-bold text-slate-900 mb-6">Das Fest</h3>
          <div class="grid sm:grid-cols-2 gap-6">
            <div class="bg-white p-8 rounded-[2rem] border border-slate-100 shadow-sm">
              <span class="text-med-gold text-[10px] font-bold uppercase tracking-widest mb-2 block">Die Graziella</span>
              <h4 class="text-xl font-serif font-bold text-slate-900 mb-3">Ein literarisches Symbol</h4>
              <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Graziella, die Heldin des Romans von Lamartine, verkörpert die Seele Procidas: einfach, stolz, dem Meer verbunden. Das Fest ehrt dieses Symbol mit Kostümprozessionen und theatralischen Darbietungen.</p>
            </div>
            <div class="bg-white p-8 rounded-[2rem] border border-slate-100 shadow-sm">
              <span class="text-med-gold text-[10px] font-bold uppercase tracking-widest mb-2 block">Meeresfrüchte</span>
              <h4 class="text-xl font-serif font-bold text-slate-900 mb-3">Direkt vom Fischer</h4>
              <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Die gastronomische Seele des Festes: frische Meeresfrüchte aus dem Golf von Neapel, zubereitet nach traditionellen Rezepten der Insel – Muscheln, Tintenfisch, Garnelen und der berühmte Procida-Hummer.</p>
            </div>
          </div>
        </div>

        <!-- Anreise -->
        <div>
          <h3 class="font-serif text-2xl font-bold text-slate-900 mb-6">Anreise</h3>
          <div class="bg-white rounded-[2rem] border border-slate-100 overflow-hidden shadow-sm">
            <table class="w-full text-xs sm:text-xs sm:text-sm">
              <thead>
                <tr class="bg-slate-900 text-white">
                  <th class="text-left px-6 py-4 font-semibold">Verkehrsmittel</th>
                  <th class="text-left px-6 py-4 font-semibold">Verbindung</th>
                  <th class="text-left px-6 py-4 font-semibold">Hinweise</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-slate-100">
                <tr class="hover:bg-slate-50 transition-colors">
                  <td class="px-6 py-4 font-medium">Fähre</td>
                  <td class="px-6 py-4 text-slate-600">Ab Neapel Molo Beverello</td>
                  <td class="px-6 py-4 text-slate-500 text-xs">Ca. 40 min nach Procida</td>
                </tr>
                <tr class="hover:bg-slate-50 transition-colors">
                  <td class="px-6 py-4 font-medium">Fähre</td>
                  <td class="px-6 py-4 text-slate-600">Ab Pozzuoli</td>
                  <td class="px-6 py-4 text-slate-500 text-xs">Ca. 35 min, häufige Verbindungen</td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>
      </div>

      <!-- Sidebar (30%) -->
      <aside class="lg:col-span-3">
        <div class="bg-slate-900 text-white p-10 rounded-[3rem] sticky top-32 shadow-2xl">
          <p class="text-[10px] uppercase tracking-[0.3em] text-med-gold font-medium mb-6">Veranstaltungsdetails</p>
          <dl class="space-y-4">
            {facts.map(({ dt, dd }, i) => (
              <>
                <div>
                  <dt class="text-white/40 text-[10px] uppercase tracking-widest font-bold mb-1">{dt}</dt>
                  <dd class="text-white font-medium">{dd}</dd>
                </div>
                {i < facts.length - 1 && <div class="border-t border-white/5"></div>}
              </>
            ))}
          </dl>
          <div class="mt-10 pt-8 border-t border-white/5">
            <p class="text-white/50 text-xs leading-relaxed">Wir empfehlen, frühzeitig anzureisen. Das aktualisierte Programm finden Sie auf den offiziellen Kanälen.</p>
          </div>
        </div>
      </aside>

    </div>
  </section>

  <LocalitySlider
    heading="Entdecke Procida und die Inseln"
    lang={lang}
    items={[
      { name: "Procida", href: '/de-de/inseln/procida/', image: '/images/procida-hero.jpg', tag: "Veranstaltungsort" },
      { name: "Ischia", href: '/de-de/inseln/ischia/', image: '/images/ischia-hero.jpg', tag: "In der Nähe" },
      { name: "Capri", href: '/de-de/inseln/capri/', image: '/images/capri-hero.jpg', tag: "Ikonisch" },
      { name: "Anacapri", href: '/de-de/inseln/anacapri/', image: '/images/anacapri-hero.jpg', tag: "Dorf" },
    ]}
  />

  <!-- Zugehörige Veranstaltungen -->
  <section class="py-4 sm:py-12 px-6 max-w-7xl mx-auto">
    <h2 class="font-serif text-3xl sm:text-4xl font-bold text-slate-900 mb-12">Zugehörige Veranstaltungen</h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
      <a href="/de-de/veranstaltungen/inseln/anacapri-settembre-borgo/" class="block bg-white rounded-[2rem] border border-slate-100 overflow-hidden shadow-sm hover:shadow-md transition-shadow">
        <img src="/images/anacapri-hero.jpg" alt="Anacapri" class="h-40 w-full object-cover" />
        <div class="p-6">
          <span class="text-med-gold text-[10px] font-bold uppercase tracking-widest mb-2 block">September 2026</span>
          <h3 class="font-serif text-lg font-bold text-slate-900 mb-2">Anacapri September</h3>
          <p class="text-slate-600 text-sm mb-4">Traditioneller Jahrmarkt mit Inselkultur.</p>
          <p class="text-slate-500 text-xs font-medium">📍 Anacapri, NA</p>
        </div>
      </a>
      <a href="/de-de/veranstaltungen/inseln/ischia-global-film-festival/" class="block bg-white rounded-[2rem] border border-slate-100 overflow-hidden shadow-sm hover:shadow-md transition-shadow">
        <img src="/images/ischia-hero.jpg" alt="Ischia Film" class="h-40 w-full object-cover" />
        <div class="p-6">
          <span class="text-med-gold text-[10px] font-bold uppercase tracking-widest mb-2 block">Juli 2026</span>
          <h3 class="font-serif text-lg font-bold text-slate-900 mb-2">Ischia Film Festival</h3>
          <p class="text-slate-600 text-sm mb-4">Internationales Filmfestival mit Inselkultur.</p>
          <p class="text-slate-500 text-xs font-medium">📍 Ischia, NA</p>
        </div>
      </a>
      <a href="/de-de/veranstaltungen/" class="block bg-white rounded-[2rem] border border-slate-100 overflow-hidden shadow-sm hover:shadow-md transition-shadow">
        <img src="/images/ravello-hero.jpg" alt="Strände" class="h-40 w-full object-cover" />
        <div class="p-6">
          <span class="text-med-gold text-[10px] font-bold uppercase tracking-widest mb-2 block">Ganzjährig</span>
          <h3 class="font-serif text-lg font-bold text-slate-900 mb-2">Entdecke die Inseln</h3>
          <p class="text-slate-600 text-sm mb-4">Strände, Höhlen und Kultur im Golf von Neapel.</p>
          <p class="text-slate-500 text-xs font-medium">📍 Inselarchipel, NA</p>
        </div>
      </a>
    </div>
  </section>

  <!-- Destinazione CTA -->
  <section class="bg-med-blue text-white py-12 sm:py-16 px-6">
    <div class="max-w-7xl mx-auto">
      <div class="flex flex-col sm:flex-row items-center justify-between gap-8">
        <div>
          <h3 class="font-serif text-2xl sm:text-3xl font-bold mb-3">Erkunden Sie Procida</h3>
          <p class="text-white/70 text-sm sm:text-base max-w-md">Charmante Insel mit bunten Häusern und ruhigen Stränden.</p>
        </div>
        <a href="/de-de/inseln/procida/" class="bg-med-gold text-white px-8 py-3 rounded-full font-medium hover:bg-yellow-500 transition-colors whitespace-nowrap">
          View Destination →
        </a>
      </div>
    </div>
  </section>


