---
import BaseLayout from '../../../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../../../components/Breadcrumbs.astro';
import LocalitySlider from '../../../../../components/LocalitySlider.astro';

const lang = 'de-de';

const breadcrumbs = [
  { name: 'Home', url: '/de-de/' },
  { name: 'Veranstaltungen', url: '/de-de/veranstaltungen/' },
  { name: 'Fest des hl. Gennaro – Praiano', url: '/de-de/veranstaltungen/amalfikueste/festa-san-gennaro-praiano/' },
];

const eventSchema = {
  "@context": "https://schema.org",
  "@type": "EventSeries",
  "name": "Fest des hl. Gennaro Praiano",
  "description": "Das Fest des heiligen Gennaro in Praiano am 19. September 2026. Patronatsprozession im Weiler Vettica Maggiore – wenig Touristen, Panoramablick auf Capri.",
  "image": "https://amalficoast-travel.com/images/praiano-hero.jpg",
  "url": "https://amalficoast-travel.com/de-de/veranstaltungen/amalfikueste/festa-san-gennaro-praiano/",
  "location": {
      "@type": "Place",
      "name": "Vettica Maggiore, Praiano",
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Praiano",
        "addressRegion": "SA",
        "addressCountry": "IT"
      }
    },
  "eventStatus": "https://schema.org/EventScheduled",
  "eventAttendanceMode": "https://schema.org/OfflineEventAttendanceMode",
  "subEvent": [
    {
      "@type": "Event",
      "name": "Fest des hl. Gennaro Praiano 2026",
      "startDate": "2026-09-19",
      "endDate": "2026-09-19",
      "eventStatus": "https://schema.org/EventScheduled",
      "eventAttendanceMode": "https://schema.org/OfflineEventAttendanceMode",
      "location": {
          "@type": "Place",
          "name": "Vettica Maggiore, Praiano",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Praiano",
            "addressRegion": "SA",
            "addressCountry": "IT"
          }
        },
      "url": "https://amalficoast-travel.com/de-de/veranstaltungen/amalfikueste/festa-san-gennaro-praiano/",
      "image": "https://amalficoast-travel.com/images/praiano-hero.jpg",
      "description": "Das Fest des heiligen Gennaro in Praiano am 19. September 2026. Patronatsprozession im Weiler Vettica Maggiore – wenig Touristen, Panoramablick auf Capri."
    }
  ]
};

const facts = [
  { dt: 'Datum', dd: '19. September 2026' },
  { dt: 'Ort', dd: 'Vettica Maggiore, Praiano' },
  { dt: 'Typ', dd: 'Patronatsprozession' },
  { dt: 'Atmosphäre', dd: 'Authentisch, kaum Touristen' },
  { dt: 'Ab Amalfi', dd: 'Bus SITA, 20 min' },
];
---

<BaseLayout
  title="Fest des hl. Gennaro Praiano 2026 – Authentische Prozession mit Capri-Blick"
  description="Das Fest des heiligen Gennaro in Praiano am 19. September 2026. Patronatsprozession im Weiler Vettica Maggiore – wenig Touristen, Panoramablick auf Capri."
  lang={lang}
  breadcrumbs={breadcrumbs}
  schema={[eventSchema]}
 pageKey="festa-san-gennaro-praiano"
  heroImage="/images/praiano-hero.jpg"
>

  <!-- Hero -->
  <section class="relative h-[65vh] sm:h-[70vh] overflow-hidden flex items-center justify-center">
    <img
      src="/images/praiano-hero.jpg"
      alt="Fest des hl. Gennaro, Praiano"
      class="absolute inset-0 w-full h-full object-cover"
      loading="eager" fetchpriority="high" decoding="sync" referrerpolicy="no-referrer"
    />
    <div class="absolute inset-0 bg-gradient-to-b from-black/20 via-black/50 to-black/70"></div>
    <div class="relative z-10 text-center px-6 max-w-5xl text-white">
      <div class="flex flex-wrap justify-center items-center gap-4 mb-6">
        <span class="bg-med-gold text-white px-4 py-1 rounded-full text-[10px] font-bold uppercase tracking-widest">Veranstaltung 2026</span>
        <span class="text-white/70 text-xs sm:text-sm">19. September 2026</span>
        <span class="text-white/70 text-xs sm:text-sm">Praiano, SA</span>
      </div>
      <h1 class="font-serif text-5xl md:text-7xl font-bold text-white leading-tight mb-6">Fest des hl. Gennaro</h1>
      <p class="text-white/85 text-lg md:text-xl font-light max-w-2xl mx-auto leading-relaxed">
        Eine authentische Prozession mit Panoramablick auf Capri – fernab der Touristenströme.
      </p>
    </div>
    <Breadcrumbs breadcrumbs={breadcrumbs} isEvent={true} />
  </section>

  <!-- Content 70/30 -->
  <section class="py-12 sm:py-24 px-6 max-w-7xl mx-auto">
    <div class="grid grid-cols-1 lg:grid-cols-10 gap-16">

      <!-- Main Content (70%) -->
      <div class="lg:col-span-7 space-y-12">
        <div>
          <h2 class="font-serif text-4xl font-bold text-slate-900 mb-8">Zur Veranstaltung</h2>
          <div class="space-y-4 text-slate-600 text-lg leading-relaxed">
            <p>Das Patronatsfest des heiligen Gennaro findet im oberen Weiler Vettica Maggiore statt – dem höher gelegenen Teil von Praiano mit atemberaubendem Panoramablick auf Capri und den Golf von Salerno. Anders als die bekannteren Feste der Küste ist dieses Ereignis noch weitgehend von Touristen unentdeckt.</p>
            <p>Die feierliche Prozession durch die engen Gassen des Weilers, der Klang der Blaskapelle und die Gemeinschaft der Dorfbewohner verleihen dem Fest eine Authentizität, die man heute an der Amalfiküste selten noch findet.</p>
          </div>
        </div>

        <!-- Die Prozession -->
        <div>
          <h3 class="font-serif text-2xl font-bold text-slate-900 mb-6">Die Prozession</h3>
          <div class="grid sm:grid-cols-2 gap-6">
            <div class="bg-white p-8 rounded-[2rem] border border-slate-100 shadow-sm">
              <span class="text-med-gold text-[10px] font-bold uppercase tracking-widest mb-2 block">Vettica Maggiore</span>
              <h4 class="text-xl font-serif font-bold text-slate-900 mb-3">Der Weiler über dem Meer</h4>
              <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Vettica Maggiore liegt auf einem Felsen über dem Meer und bietet einen der besten Aussichtspunkte auf Capri. Die Prozession durch seine steilen Gassen ist ein bewegendes Erlebnis.</p>
            </div>
            <div class="bg-white p-8 rounded-[2rem] border border-slate-100 shadow-sm">
              <span class="text-med-gold text-[10px] font-bold uppercase tracking-widest mb-2 block">Dorfleben</span>
              <h4 class="text-xl font-serif font-bold text-slate-900 mb-3">Echtes Campania</h4>
              <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Das Fest spiegelt das echte Leben an der Amalfiküste wider: Die Einwohner feiern ihren Schutzpatron mit Herzlichkeit und Stolz – ohne Tourismusrummel, mit echtem campanesinischem Gemeinschaftsgefühl.</p>
            </div>
          </div>
        </div>

        <!-- Anreise -->
        <div>
          <h3 class="font-serif text-2xl font-bold text-slate-900 mb-6">Anreise</h3>
          <div class="bg-white rounded-[2rem] border border-slate-100 overflow-hidden shadow-sm">
            <table class="w-full text-xs sm:text-xs sm:text-sm">
              <thead>
                <tr class="bg-slate-900 text-white">
                  <th class="text-left px-6 py-4 font-semibold">Verkehrsmittel</th>
                  <th class="text-left px-6 py-4 font-semibold">Verbindung</th>
                  <th class="text-left px-6 py-4 font-semibold">Hinweise</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-slate-100">
                <tr class="hover:bg-slate-50 transition-colors">
                  <td class="px-6 py-4 font-medium">Bus SITA</td>
                  <td class="px-6 py-4 text-slate-600">Ab Amalfi oder Positano</td>
                  <td class="px-6 py-4 text-slate-500 text-xs">Haltestelle Praiano, dann zu Fuß bergauf</td>
                </tr>
                <tr class="hover:bg-slate-50 transition-colors">
                  <td class="px-6 py-4 font-medium">Taxi/Transfer</td>
                  <td class="px-6 py-4 text-slate-600">Ab jedem Küstenort</td>
                  <td class="px-6 py-4 text-slate-500 text-xs">Empfehlenswert für Abendveranstaltungen</td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>
      </div>

      <!-- Sidebar (30%) -->
      <aside class="lg:col-span-3">
        <div class="bg-slate-900 text-white p-10 rounded-[3rem] sticky top-32 shadow-2xl">
          <p class="text-[10px] uppercase tracking-[0.3em] text-med-gold font-medium mb-6">Veranstaltungsdetails</p>
          <dl class="space-y-4">
            {facts.map(({ dt, dd }, i) => (
              <>
                <div>
                  <dt class="text-white/40 text-[10px] uppercase tracking-widest font-bold mb-1">{dt}</dt>
                  <dd class="text-white font-medium">{dd}</dd>
                </div>
                {i < facts.length - 1 && <div class="border-t border-white/5"></div>}
              </>
            ))}
          </dl>
          <div class="mt-10 pt-8 border-t border-white/5">
            <p class="text-white/50 text-xs leading-relaxed">Wir empfehlen, frühzeitig anzureisen. Das aktualisierte Programm finden Sie auf den offiziellen Kanälen.</p>
          </div>
        </div>
      </aside>

    </div>
  </section>

  <LocalitySlider
    heading="Entdecke Praiano und Umgebung"
    lang={lang}
    items={[
      { name: "Praiano", href: '/de-de/amalfikueste/praiano/', image: '/images/praiano-hero.jpg', tag: "Veranstaltungsort" },
      { name: "Positano", href: '/de-de/amalfikueste/positano/', image: '/images/positano-hero.jpg', tag: "Ikonisch" },
      { name: "Amalfi", href: '/de-de/amalfikueste/amalfi/', image: '/images/amalfi-hero.jpg', tag: "Historisch" },
      { name: "Furore", href: '/de-de/amalfikueste/furore/', image: '/images/costiera-hero.jpg', tag: "Authentisch" },
    ]}
  />

    <!-- BANNER: Itinerary Planner -->
  <section class="py-10 md:py-14 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6">
      <div class="relative overflow-hidden rounded-[2.5rem] bg-gradient-to-br from-slate-900 via-slate-950 to-blue-950 px-6 sm:px-10 md:px-14 py-10 md:py-14 shadow-[0_20px_60px_rgba(0,0,0,0.35)]">
        <div class="absolute -top-20 -left-20 w-72 h-72 bg-blue-500/15 rounded-full blur-3xl pointer-events-none"></div>
        <div class="absolute -bottom-20 -right-20 w-72 h-72 bg-amber-500/10 rounded-full blur-3xl pointer-events-none"></div>
        <div class="relative z-10 grid md:grid-cols-[3fr_2fr] md:items-center gap-8">
          <div>
            <span class="inline-block px-4 py-1.5 rounded-full text-xs font-semibold tracking-wide uppercase bg-med-gold/15 text-med-gold border border-med-gold/25 mb-6">Neu: Maßgeschneiderte Reise</span>
            <h2 class="text-3xl md:text-4xl font-bold text-white leading-tight mb-2">Gestalte deinen</h2>
            <p class="font-serif text-3xl md:text-4xl italic text-med-blue mb-5">idealen Reiseplan</p>
            <p class="text-white/60 text-base md:text-lg leading-relaxed max-w-xl mb-8">
              Beantworte ein paar einfache Fragen - Startpunkt, Tage und Interessen - und erhalte einen personalisierten Reiseplan mit Transport, Kosten und Zeiten.
            </p>
            <div class="flex flex-wrap gap-6">
              <div class="flex items-center gap-2.5">
                <div class="w-9 h-9 rounded-xl bg-white/5 border border-white/10 flex items-center justify-center">
                  <svg class="w-4 h-4 text-med-gold" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                </div>
                <span class="text-white/50 text-sm">30 Sekunden zur Konfiguration</span>
              </div>
              <div class="flex items-center gap-2.5">
                <div class="w-9 h-9 rounded-xl bg-white/5 border border-white/10 flex items-center justify-center">
                  <svg class="w-4 h-4 text-med-gold" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 6.75V15m6-6v8.25m.503 3.498l4.875-2.437c.381-.19.622-.58.622-1.006V4.82c0-.836-.88-1.38-1.628-1.006l-3.869 1.934c-.317.159-.69.159-1.006 0L9.503 3.252a1.125 1.125 0 00-1.006 0L3.622 5.689C3.24 5.88 3 6.27 3 6.695V19.18c0 .836.88 1.38 1.628 1.006l3.869-1.934c.317-.159.69-.159 1.006 0l4.994 2.497c.317.158.69.158 1.006 0z"/></svg>
                </div>
                <span class="text-white/50 text-sm">Anti-Crowd-Tipps inklusive</span>
              </div>
            </div>
          </div>
          <div class="mt-8 md:mt-0 md:flex md:justify-center">
            <a href="/de-de/reiserouten-planer/" class="inline-flex items-center gap-2.5 px-7 py-3.5 bg-gradient-to-r from-med-gold to-yellow-600 text-slate-900 font-bold rounded-xl hover:shadow-[0_0_30px_rgba(212,175,55,0.4)] hover:scale-105 transition-all duration-300">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 2L2 12l4 0 0 6 4 0 0-4 4 0 0 4 4 0 0-6 4 0L12 2z"/></svg>
              Jetzt konfigurieren
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Zugehörige Veranstaltungen -->
  <section class="py-4 sm:py-12 px-6 max-w-7xl mx-auto">
    <h2 class="font-serif text-3xl sm:text-4xl font-bold text-slate-900 mb-12">Zugehörige Veranstaltungen</h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
      <a href="/de-de/veranstaltungen/amalfikueste/festa-sant-andrea-amalfi/" class="block bg-white rounded-[2rem] border border-slate-100 overflow-hidden shadow-sm hover:shadow-md transition-shadow">
        <img src="/images/amalfi-hero.jpg" alt="Festa di Sant'Andrea" class="h-40 w-full object-cover" />
        <div class="p-6">
          <span class="text-med-gold text-[10px] font-bold uppercase tracking-widest mb-2 block">Juni 2026</span>
          <h3 class="font-serif text-lg font-bold text-slate-900 mb-2">Festa di Sant'Andrea</h3>
          <p class="text-slate-600 text-sm mb-4">Trägerrennen und Feuerwerk im Hafen.</p>
          <p class="text-slate-500 text-xs font-medium">📍 Amalfi, SA</p>
        </div>
      </a>
      <a href="/de-de/veranstaltungen/amalfikueste/luminaria-san-domenico-praiano/" class="block bg-white rounded-[2rem] border border-slate-100 overflow-hidden shadow-sm hover:shadow-md transition-shadow">
        <img src="/images/praiano-hero.jpg" alt="Luminaria" class="h-40 w-full object-cover" />
        <div class="p-6">
          <span class="text-med-gold text-[10px] font-bold uppercase tracking-widest mb-2 block">August 2026</span>
          <h3 class="font-serif text-lg font-bold text-slate-900 mb-2">Luminaria von San Domenico</h3>
          <p class="text-slate-600 text-sm mb-4">Spektakuläre Fackelparade am Strand.</p>
          <p class="text-slate-500 text-xs font-medium">📍 Praiano, SA</p>
        </div>
      </a>
      <a href="/de-de/veranstaltungen/amalfikueste/ravello-festival/" class="block bg-white rounded-[2rem] border border-slate-100 overflow-hidden shadow-sm hover:shadow-md transition-shadow">
        <img src="/images/ravello-hero.jpg" alt="Festival Ravello" class="h-40 w-full object-cover" />
        <div class="p-6">
          <span class="text-med-gold text-[10px] font-bold uppercase tracking-widest mb-2 block">Juli - September 2026</span>
          <h3 class="font-serif text-lg font-bold text-slate-900 mb-2">Festival Ravello</h3>
          <p class="text-slate-600 text-sm mb-4">Klassische und zeitgenössische Musik in Villa Rufolo.</p>
          <p class="text-slate-500 text-xs font-medium">📍 Ravello, SA</p>
        </div>
      </a>
    </div>
  </section>

  <!-- Destinazione CTA -->
  <section class="bg-med-blue text-white py-12 sm:py-16 px-6">
    <div class="max-w-7xl mx-auto">
      <div class="flex flex-col sm:flex-row items-center justify-between gap-8">
        <div>
          <h3 class="font-serif text-2xl sm:text-3xl font-bold mb-3">Erkunden Sie Praiano</h3>
          <p class="text-white/70 text-sm sm:text-base max-w-md">Fischerdorf mit unberührten Stränden und ruhigem Wasser.</p>
        </div>
        <a href="/de-de/amalfikueste/praiano/" class="bg-med-gold text-white px-8 py-3 rounded-full font-medium hover:bg-yellow-500 transition-colors whitespace-nowrap">
          View Destination →
        </a>
      </div>
    </div>
  </section>


