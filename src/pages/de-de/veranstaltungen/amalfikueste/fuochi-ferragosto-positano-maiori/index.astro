---
import BaseLayout from '../../../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../../../components/Breadcrumbs.astro';
import LocalitySlider from '../../../../../components/LocalitySlider.astro';

const lang = 'de-de';

const breadcrumbs = [
  { name: 'Home', url: '/de-de/' },
  { name: 'Veranstaltungen', url: '/de-de/veranstaltungen/' },
  { name: 'Ferragosto-Feuerwerk', url: '/de-de/veranstaltungen/amalfikueste/fuochi-ferragosto-positano-maiori/' },
];

const eventSchema = {
  "@context": "https://schema.org",
  "@type": "EventSeries",
  "name": "Ferragosto-Feuerwerk 2026 – Positano & Maiori",
  "description": "Das Ferragosto-Feuerwerk am 15. August 2026. Spektakuläre Feuerwerke über dem Meer in Positano (Madonna Assunta) und Maiori (Santa Maria a Mare).",
  "image": "https://amalficoast-travel.com/images/positano-hero.jpg",
  "url": "https://amalficoast-travel.com/de-de/veranstaltungen/amalfikueste/fuochi-ferragosto-positano-maiori/",
  "location": {
      "@type": "Place",
      "name": "Positano & Maiori",
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Positano",
        "addressRegion": "SA",
        "addressCountry": "IT"
      }
    },
  "eventStatus": "https://schema.org/EventScheduled",
  "eventAttendanceMode": "https://schema.org/OfflineEventAttendanceMode",
  "subEvent": [
    {
      "@type": "Event",
      "name": "Ferragosto-Feuerwerk 2026 – Positano & Maiori",
      "startDate": "2026-08-15",
      "endDate": "2026-08-15",
      "eventStatus": "https://schema.org/EventScheduled",
      "eventAttendanceMode": "https://schema.org/OfflineEventAttendanceMode",
      "location": {
          "@type": "Place",
          "name": "Positano & Maiori",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Positano",
            "addressRegion": "SA",
            "addressCountry": "IT"
          }
        },
      "url": "https://amalficoast-travel.com/de-de/veranstaltungen/amalfikueste/fuochi-ferragosto-positano-maiori/",
      "image": "https://amalficoast-travel.com/images/positano-hero.jpg",
      "description": "Das Ferragosto-Feuerwerk am 15. August 2026. Spektakuläre Feuerwerke über dem Meer in Positano (Madonna Assunta) und Maiori (Santa Maria a Mare)."
    }
  ]
};

const facts = [
  { dt: 'Datum', dd: '15. August 2026' },
  { dt: 'Orte', dd: 'Positano & Maiori' },
  { dt: 'Anlass', dd: 'Ferragosto / Mariä Himmelfahrt' },
  { dt: 'Beste Sicht', dd: 'Vom Meer aus' },
  { dt: 'Eintritt', dd: 'Kostenlos' },
];
---

<BaseLayout
  title="Ferragosto-Feuerwerk 2026 – Positano & Maiori leuchten über dem Meer"
  description="Das Ferragosto-Feuerwerk am 15. August 2026. Spektakuläre Feuerwerke über dem Meer in Positano (Madonna Assunta) und Maiori (Santa Maria a Mare)."
  lang={lang}
  breadcrumbs={breadcrumbs}
  schema={[eventSchema]}
 pageKey="fuochi-ferragosto-positano-maiori"
  heroImage="/images/positano-hero.jpg"
>

  <!-- Hero -->
  <section class="relative h-[65vh] sm:h-[70vh] overflow-hidden flex items-center justify-center">
    <img
      src="/images/positano-hero.jpg"
      alt="Ferragosto-Feuerwerk, Positano"
      class="absolute inset-0 w-full h-full object-cover"
      loading="eager" fetchpriority="high" decoding="sync" referrerpolicy="no-referrer"
    />
    <div class="absolute inset-0 bg-gradient-to-b from-black/20 via-black/50 to-black/70"></div>
    <div class="relative z-10 text-center px-6 max-w-5xl text-white">
      <div class="flex flex-wrap justify-center items-center gap-4 mb-6">
        <span class="bg-med-gold text-white px-4 py-1 rounded-full text-[10px] font-bold uppercase tracking-widest">Veranstaltung 2026</span>
        <span class="text-white/70 text-xs sm:text-sm">15. August 2026</span>
        <span class="text-white/70 text-xs sm:text-sm">Positano & Maiori, SA</span>
      </div>
      <h1 class="font-serif text-5xl md:text-7xl font-bold text-white leading-tight mb-6">Ferragosto-Feuerwerk</h1>
      <p class="text-white/85 text-lg md:text-xl font-light max-w-2xl mx-auto leading-relaxed">
        Die Küste leuchtet: Positano und Maiori feiern Ferragosto mit Feuerwerken über dem Meer.
      </p>
    </div>
    <Breadcrumbs breadcrumbs={breadcrumbs} isEvent={true} />
  </section>

  <!-- Content 70/30 -->
  <section class="py-12 sm:py-24 px-6 max-w-7xl mx-auto">
    <div class="grid grid-cols-1 lg:grid-cols-10 gap-16">

      <!-- Main Content (70%) -->
      <div class="lg:col-span-7 space-y-12">
        <div>
          <h2 class="font-serif text-4xl font-bold text-slate-900 mb-8">Zur Veranstaltung</h2>
          <div class="space-y-4 text-slate-600 text-lg leading-relaxed">
            <p>Der 15. August ist Ferragosto – Italiens größter Sommerferien-Feiertag, verbunden mit dem Fest Mariä Himmelfahrt. An der Amalfiküste feiern gleich zwei Orte mit spektakulären Feuerwerken über dem Tyrrhenischen Meer: Positano zu Ehren der Madonna Assunta und Maiori zu Ehren der Santa Maria a Mare.</p>
            <p>Das Feuerwerk von Positano ist besonders eindrucksvoll, da die bunten Farbexplosionen zwischen den weißen Häusern des steilen Hangs reflektieren. Von einem Boot oder der Küstenstraße aus betrachtet entfaltet sich ein unvergessliches Schauspiel.</p>
          </div>
        </div>

        <!-- Zwei Feuerwerke -->
        <div>
          <h3 class="font-serif text-2xl font-bold text-slate-900 mb-6">Zwei Feuerwerke, eine Nacht</h3>
          <div class="grid sm:grid-cols-2 gap-6">
            <div class="bg-white p-8 rounded-[2rem] border border-slate-100 shadow-sm">
              <span class="text-med-gold text-[10px] font-bold uppercase tracking-widest mb-2 block">Positano</span>
              <h4 class="text-xl font-serif font-bold text-slate-900 mb-3">Madonna Assunta</h4>
              <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Das Feuerwerk von Positano ist eines der schönsten an der Küste: Die Raketen spiegeln sich im Meer und beleuchten die berühmte Stufensilhouette des Dorfes in allen Farben.</p>
            </div>
            <div class="bg-white p-8 rounded-[2rem] border border-slate-100 shadow-sm">
              <span class="text-med-gold text-[10px] font-bold uppercase tracking-widest mb-2 block">Maiori</span>
              <h4 class="text-xl font-serif font-bold text-slate-900 mb-3">Santa Maria a Mare</h4>
              <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Maiori, mit seinem breiten Sandstrand, bietet hervorragende Sichtverhältnisse für das Feuerwerk zu Ehren der Schutzpatronin Santa Maria a Mare – ideal auch für Familien.</p>
            </div>
          </div>
        </div>

        <!-- Anreise -->
        <div>
          <h3 class="font-serif text-2xl font-bold text-slate-900 mb-6">Anreise</h3>
          <div class="bg-white rounded-[2rem] border border-slate-100 overflow-hidden shadow-sm">
            <table class="w-full text-xs sm:text-xs sm:text-sm">
              <thead>
                <tr class="bg-slate-900 text-white">
                  <th class="text-left px-6 py-4 font-semibold">Verkehrsmittel</th>
                  <th class="text-left px-6 py-4 font-semibold">Verbindung</th>
                  <th class="text-left px-6 py-4 font-semibold">Hinweise</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-slate-100">
                <tr class="hover:bg-slate-50 transition-colors">
                  <td class="px-6 py-4 font-medium">Fähre</td>
                  <td class="px-6 py-4 text-slate-600">Ab Amalfi, Sorrent, Neapel</td>
                  <td class="px-6 py-4 text-slate-500 text-xs">Beste Sicht auf das Feuerwerk vom Wasser</td>
                </tr>
                <tr class="hover:bg-slate-50 transition-colors">
                  <td class="px-6 py-4 font-medium">Bus SITA</td>
                  <td class="px-6 py-4 text-slate-600">Entlang der SS163</td>
                  <td class="px-6 py-4 text-slate-500 text-xs">Sehr stark frequentiert am 15. August</td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>
      </div>

      <!-- Sidebar (30%) -->
      <aside class="lg:col-span-3">
        <div class="bg-slate-900 text-white p-10 rounded-[3rem] sticky top-32 shadow-2xl">
          <p class="text-[10px] uppercase tracking-[0.3em] text-med-gold font-medium mb-6">Veranstaltungsdetails</p>
          <dl class="space-y-4">
            {facts.map(({ dt, dd }, i) => (
              <>
                <div>
                  <dt class="text-white/40 text-[10px] uppercase tracking-widest font-bold mb-1">{dt}</dt>
                  <dd class="text-white font-medium">{dd}</dd>
                </div>
                {i < facts.length - 1 && <div class="border-t border-white/5"></div>}
              </>
            ))}
          </dl>
          <div class="mt-10 pt-8 border-t border-white/5">
            <p class="text-white/50 text-xs leading-relaxed">Wir empfehlen, frühzeitig anzureisen. Das aktualisierte Programm finden Sie auf den offiziellen Kanälen.</p>
          </div>
        </div>
      </aside>

    </div>
  </section>

  <LocalitySlider
    heading="Orte an der Küste"
    lang={lang}
    items={[
      { name: "Positano", href: '/de-de/amalfikueste/positano/', image: '/images/positano-hero.jpg', tag: "Veranstaltungsort" },
      { name: "Maiori", href: '/de-de/amalfikueste/maiori/', image: '/images/costiera-hero.jpg', tag: "Veranstaltungsort" },
      { name: "Amalfi", href: '/de-de/amalfikueste/amalfi/', image: '/images/amalfi-hero.jpg', tag: "Historisch" },
      { name: "Minori", href: '/de-de/amalfikueste/minori/', image: '/images/costiera-hero.jpg', tag: "Authentisch" },
    ]}
  />

  <!-- Zugehörige Veranstaltungen -->
  <section class="py-4 sm:py-12 px-6 max-w-7xl mx-auto">
    <h2 class="font-serif text-3xl sm:text-4xl font-bold text-slate-900 mb-12">Zugehörige Veranstaltungen</h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
      <a href="/de-de/veranstaltungen/amalfikueste/regata-storica-amalfi/" class="block bg-white rounded-[2rem] border border-slate-100 overflow-hidden shadow-sm hover:shadow-md transition-shadow">
        <img src="/images/amalfi-hero.jpg" alt="Regata Storica" class="h-40 w-full object-cover" />
        <div class="p-6">
          <span class="text-med-gold text-[10px] font-bold uppercase tracking-widest mb-2 block">Juni 2026</span>
          <h3 class="font-serif text-lg font-bold text-slate-900 mb-2">Regata Storica</h3>
          <p class="text-slate-600 text-sm mb-4">Alte Seestädte konkurrieren in historischen Rennen.</p>
          <p class="text-slate-500 text-xs font-medium">📍 Amalfi, SA</p>
        </div>
      </a>
      <a href="/de-de/veranstaltungen/amalfikueste/positano-mare-sole-cultura/" class="block bg-white rounded-[2rem] border border-slate-100 overflow-hidden shadow-sm hover:shadow-md transition-shadow">
        <img src="/images/positano-hero.jpg" alt="Positano Kultur" class="h-40 w-full object-cover" />
        <div class="p-6">
          <span class="text-med-gold text-[10px] font-bold uppercase tracking-widest mb-2 block">Juli - August 2026</span>
          <h3 class="font-serif text-lg font-bold text-slate-900 mb-2">Positano Meer Sonne Kultur</h3>
          <p class="text-slate-600 text-sm mb-4">Kunstfestival mit Musik, Theater und lokalen Traditionen.</p>
          <p class="text-slate-500 text-xs font-medium">📍 Positano, SA</p>
        </div>
      </a>
      <a href="/de-de/veranstaltungen/amalfikueste/ravello-festival/" class="block bg-white rounded-[2rem] border border-slate-100 overflow-hidden shadow-sm hover:shadow-md transition-shadow">
        <img src="/images/ravello-hero.jpg" alt="Festival Ravello" class="h-40 w-full object-cover" />
        <div class="p-6">
          <span class="text-med-gold text-[10px] font-bold uppercase tracking-widest mb-2 block">Juli - September 2026</span>
          <h3 class="font-serif text-lg font-bold text-slate-900 mb-2">Festival Ravello</h3>
          <p class="text-slate-600 text-sm mb-4">Klassische und zeitgenössische Musik in Villa Rufolo.</p>
          <p class="text-slate-500 text-xs font-medium">📍 Ravello, SA</p>
        </div>
      </a>
    </div>
  </section>

  <!-- Destinazione CTA -->
  <section class="bg-med-blue text-white py-12 sm:py-16 px-6">
    <div class="max-w-7xl mx-auto">
      <div class="flex flex-col sm:flex-row items-center justify-between gap-8">
        <div>
          <h3 class="font-serif text-2xl sm:text-3xl font-bold mb-3">Erkunden Sie Positano</h3>
          <p class="text-white/70 text-sm sm:text-base max-w-md">Das Juwel der Küste mit bunten Dörfern am Hang.</p>
        </div>
        <a href="/de-de/amalfikueste/positano/" class="bg-med-gold text-white px-8 py-3 rounded-full font-medium hover:bg-yellow-500 transition-colors whitespace-nowrap">
          View Destination →
        </a>
      </div>
    </div>
  </section>


