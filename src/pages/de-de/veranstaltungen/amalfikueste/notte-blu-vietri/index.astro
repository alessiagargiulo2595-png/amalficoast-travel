---
import BaseLayout from '../../../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../../../components/Breadcrumbs.astro';
import LocalitySlider from '../../../../../components/LocalitySlider.astro';

const lang = 'de-de';

const breadcrumbs = [
  { name: 'Home', url: '/de-de/' },
  { name: 'Veranstaltungen', url: '/de-de/veranstaltungen/' },
  { name: 'Notte Blu Vietri', url: '/de-de/veranstaltungen/amalfikueste/notte-blu-vietri/' },
];

const eventSchema = {
  "@context": "https://schema.org",
  "@type": "EventSeries",
  "name": "Notte Blu Vietri sul Mare",
  "description": "Die Notte Blu in Vietri sul Mare im Juli 2026. Keramikwerkstätten bis Mitternacht geöffnet, Live-Konzerte und Kunstinstallationen im historischen Stadtkern.",
  "image": "https://amalficoast-travel.com/images/costiera-hero.jpg",
  "url": "https://amalficoast-travel.com/de-de/veranstaltungen/amalfikueste/notte-blu-vietri/",
  "location": {
      "@type": "Place",
      "name": "Historisches Zentrum, Vietri sul Mare",
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Vietri sul Mare",
        "addressRegion": "SA",
        "addressCountry": "IT"
      }
    },
  "eventStatus": "https://schema.org/EventScheduled",
  "eventAttendanceMode": "https://schema.org/OfflineEventAttendanceMode",
  "startDate": "2026-07-01",
  "endDate": "2026-07-31",
  "subEvent": [
    {
      "@type": "Event",
      "name": "Notte Blu Vietri sul Mare 2026",
      "startDate": "2026-07-01",
      "endDate": "2026-07-31",
      "eventStatus": "https://schema.org/EventScheduled",
      "eventAttendanceMode": "https://schema.org/OfflineEventAttendanceMode",
      "location": {
          "@type": "Place",
          "name": "Historisches Zentrum, Vietri sul Mare",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Vietri sul Mare",
            "addressRegion": "SA",
            "addressCountry": "IT"
          }
        },
      "url": "https://amalficoast-travel.com/de-de/veranstaltungen/amalfikueste/notte-blu-vietri/",
      "image": "https://amalficoast-travel.com/images/costiera-hero.jpg",
      "description": "Die Notte Blu in Vietri sul Mare im Juli 2026. Keramikwerkstätten bis Mitternacht geöffnet, Live-Konzerte und Kunstinstallationen im historischen Stadtkern."
    }
  ]
};

const facts = [
  { dt: 'Zeitraum', dd: 'Juli 2026' },
  { dt: 'Veranstaltungsort', dd: 'Historisches Zentrum, Vietri' },
  { dt: 'Typ', dd: 'Kunst, Keramik & Musik' },
  { dt: 'Öffnungszeiten', dd: 'Bis Mitternacht' },
  { dt: 'Ab Salerno', dd: '15 min mit dem Bus' },
];
---

<BaseLayout
  title="Notte Blu Vietri sul Mare 2026 – Kunst, Keramik und Musik"
  description="Die Notte Blu in Vietri sul Mare im Juli 2026. Keramikwerkstätten bis Mitternacht geöffnet, Live-Konzerte und Kunstinstallationen im historischen Stadtkern."
  lang={lang}
  breadcrumbs={breadcrumbs}
  schema={[eventSchema]}
 pageKey="notte-blu-vietri"
  heroImage="/images/costiera-hero.jpg"
>

  <!-- Hero -->
  <section class="relative h-[65vh] sm:h-[70vh] overflow-hidden flex items-center justify-center">
    <img
      src="/images/costiera-hero.jpg"
      alt="Notte Blu, Vietri sul Mare"
      class="absolute inset-0 w-full h-full object-cover"
      loading="eager" fetchpriority="high" decoding="sync" referrerpolicy="no-referrer"
    />
    <div class="absolute inset-0 bg-gradient-to-b from-black/20 via-black/50 to-black/70"></div>
    <div class="relative z-10 text-center px-6 max-w-5xl text-white">
      <div class="flex flex-wrap justify-center items-center gap-4 mb-6">
        <span class="bg-med-gold text-white px-4 py-1 rounded-full text-[10px] font-bold uppercase tracking-widest">Veranstaltung 2026</span>
        <span class="text-white/70 text-xs sm:text-sm">Juli 2026</span>
        <span class="text-white/70 text-xs sm:text-sm">Vietri sul Mare, SA</span>
      </div>
      <h1 class="font-serif text-5xl md:text-7xl font-bold text-white leading-tight mb-6">Notte Blu</h1>
      <p class="text-white/85 text-lg md:text-xl font-light max-w-2xl mx-auto leading-relaxed">
        Kunst, Keramik und Musik bis spät in der Nacht im historischen Zentrum von Vietri sul Mare.
      </p>
    </div>
    <Breadcrumbs breadcrumbs={breadcrumbs} isEvent={true} />
  </section>

  <!-- Content 70/30 -->
  <section class="py-12 sm:py-24 px-6 max-w-7xl mx-auto">
    <div class="grid grid-cols-1 lg:grid-cols-10 gap-16">

      <!-- Main Content (70%) -->
      <div class="lg:col-span-7 space-y-12">
        <div>
          <h2 class="font-serif text-4xl font-bold text-slate-900 mb-8">Zur Veranstaltung</h2>
          <div class="space-y-4 text-slate-600 text-lg leading-relaxed">
            <p>In der Notte Blu öffnen die berühmten Keramikwerkstätten von Vietri sul Mare bis Mitternacht ihre Türen. Die Besucher können den Handwerkern bei der Arbeit zusehen, Keramik kaufen und dabei Live-Konzerte und Kunstinstallationen im historischen Stadtzentrum genießen.</p>
            <p>Vietri sul Mare ist die Keramikhauptstadt der Amalfiküste – seine bunten Majolika-Fliesen schmücken Kirchen, Villen und Cafés von Sorrent bis Salerno. Die Notte Blu ist die beste Gelegenheit, die Werkstätten hinter den Kulissen zu erleben.</p>
          </div>
        </div>

        <!-- Die blaue Nacht -->
        <div>
          <h3 class="font-serif text-2xl font-bold text-slate-900 mb-6">Die blaue Nacht</h3>
          <div class="grid sm:grid-cols-2 gap-6">
            <div class="bg-white p-8 rounded-[2rem] border border-slate-100 shadow-sm">
              <span class="text-med-gold text-[10px] font-bold uppercase tracking-widest mb-2 block">Keramik-Werkstätten</span>
              <h4 class="text-xl font-serif font-bold text-slate-900 mb-3">Offene Ateliers</h4>
              <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Die traditionsreichen Keramikwerkstätten von Vietri öffnen ihre Tore und gewähren Einblick in die uralte Kunst der Majolika-Herstellung – von der Tonscheibe bis zur bemalten Glasur.</p>
            </div>
            <div class="bg-white p-8 rounded-[2rem] border border-slate-100 shadow-sm">
              <span class="text-med-gold text-[10px] font-bold uppercase tracking-widest mb-2 block">Live-Musik & Kunst</span>
              <h4 class="text-xl font-serif font-bold text-slate-900 mb-3">Kultur bis Mitternacht</h4>
              <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Lokale Bands, Kunstinstallationen und Lichtprojektionen verwandeln das historische Zentrum in eine offene Bühne – die ganze Stadt feiert gemeinsam bis in die Nacht.</p>
            </div>
          </div>
        </div>

        <!-- Anreise -->
        <div>
          <h3 class="font-serif text-2xl font-bold text-slate-900 mb-6">Anreise</h3>
          <div class="bg-white rounded-[2rem] border border-slate-100 overflow-hidden shadow-sm">
            <table class="w-full text-xs sm:text-xs sm:text-sm">
              <thead>
                <tr class="bg-slate-900 text-white">
                  <th class="text-left px-6 py-4 font-semibold">Verkehrsmittel</th>
                  <th class="text-left px-6 py-4 font-semibold">Verbindung</th>
                  <th class="text-left px-6 py-4 font-semibold">Hinweise</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-slate-100">
                <tr class="hover:bg-slate-50 transition-colors">
                  <td class="px-6 py-4 font-medium">Bus</td>
                  <td class="px-6 py-4 text-slate-600">Ab Salerno</td>
                  <td class="px-6 py-4 text-slate-500 text-xs">Ca. 15 min, sehr häufige Verbindungen</td>
                </tr>
                <tr class="hover:bg-slate-50 transition-colors">
                  <td class="px-6 py-4 font-medium">Bus SITA</td>
                  <td class="px-6 py-4 text-slate-600">Entlang der Amalfiküste</td>
                  <td class="px-6 py-4 text-slate-500 text-xs">Vietri ist das östliche Tor der Küste</td>
                </tr>
                <tr class="hover:bg-slate-50 transition-colors">
                  <td class="px-6 py-4 font-medium">Zug</td>
                  <td class="px-6 py-4 text-slate-600">Ab Salerno Hauptbahnhof</td>
                  <td class="px-6 py-4 text-slate-500 text-xs">Haltestelle Vietri sul Mare</td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>
      </div>

      <!-- Sidebar (30%) -->
      <aside class="lg:col-span-3">
        <div class="bg-slate-900 text-white p-10 rounded-[3rem] sticky top-32 shadow-2xl">
          <p class="text-[10px] uppercase tracking-[0.3em] text-med-gold font-medium mb-6">Veranstaltungsdetails</p>
          <dl class="space-y-4">
            {facts.map(({ dt, dd }, i) => (
              <>
                <div>
                  <dt class="text-white/40 text-[10px] uppercase tracking-widest font-bold mb-1">{dt}</dt>
                  <dd class="text-white font-medium">{dd}</dd>
                </div>
                {i < facts.length - 1 && <div class="border-t border-white/5"></div>}
              </>
            ))}
          </dl>
          <div class="mt-10 pt-8 border-t border-white/5">
            <p class="text-white/50 text-xs leading-relaxed">Wir empfehlen, frühzeitig anzureisen. Das aktualisierte Programm finden Sie auf den offiziellen Kanälen.</p>
          </div>
        </div>
      </aside>

    </div>
  </section>

  <LocalitySlider
    heading="Orte in der Nähe von Vietri"
    lang={lang}
    items={[
      { name: "Vietri sul Mare", href: '/de-de/amalfikueste/vietri-sul-mare/', image: '/images/vietri-hero.jpg', tag: "Veranstaltungsort" },
      { name: "Cetara", href: '/de-de/amalfikueste/cetara/', image: '/images/cetara-hero.jpg', tag: "Gastronomie" },
      { name: "Maiori", href: '/de-de/amalfikueste/maiori/', image: '/images/maiori-hero.jpg', tag: "Küste" },
      { name: "Salerno", href: '/de-de/amalfikueste/salerno/', image: '/images/salerno-hero.webp', tag: "Historisch" },
    ]}
  />

    <!-- BANNER: Itinerary Planner -->
  <section class="py-10 md:py-14 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6">
      <div class="relative overflow-hidden rounded-[2.5rem] bg-gradient-to-br from-slate-900 via-slate-950 to-blue-950 px-6 sm:px-10 md:px-14 py-10 md:py-14 shadow-[0_20px_60px_rgba(0,0,0,0.35)]">
        <div class="absolute -top-20 -left-20 w-72 h-72 bg-blue-500/15 rounded-full blur-3xl pointer-events-none"></div>
        <div class="absolute -bottom-20 -right-20 w-72 h-72 bg-amber-500/10 rounded-full blur-3xl pointer-events-none"></div>
        <div class="relative z-10 grid md:grid-cols-[3fr_2fr] md:items-center gap-8">
          <div>
            <span class="inline-block px-4 py-1.5 rounded-full text-xs font-semibold tracking-wide uppercase bg-med-gold/15 text-med-gold border border-med-gold/25 mb-6">Neu: Maßgeschneiderte Reise</span>
            <h2 class="text-3xl md:text-4xl font-bold text-white leading-tight mb-2">Gestalte deinen</h2>
            <p class="font-serif text-3xl md:text-4xl italic text-med-blue mb-5">idealen Reiseplan</p>
            <p class="text-white/60 text-base md:text-lg leading-relaxed max-w-xl mb-8">
              Beantworte ein paar einfache Fragen - Startpunkt, Tage und Interessen - und erhalte einen personalisierten Reiseplan mit Transport, Kosten und Zeiten.
            </p>
            <div class="flex flex-wrap gap-6">
              <div class="flex items-center gap-2.5">
                <div class="w-9 h-9 rounded-xl bg-white/5 border border-white/10 flex items-center justify-center">
                  <svg class="w-4 h-4 text-med-gold" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                </div>
                <span class="text-white/50 text-sm">30 Sekunden zur Konfiguration</span>
              </div>
              <div class="flex items-center gap-2.5">
                <div class="w-9 h-9 rounded-xl bg-white/5 border border-white/10 flex items-center justify-center">
                  <svg class="w-4 h-4 text-med-gold" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 6.75V15m6-6v8.25m.503 3.498l4.875-2.437c.381-.19.622-.58.622-1.006V4.82c0-.836-.88-1.38-1.628-1.006l-3.869 1.934c-.317.159-.69.159-1.006 0L9.503 3.252a1.125 1.125 0 00-1.006 0L3.622 5.689C3.24 5.88 3 6.27 3 6.695V19.18c0 .836.88 1.38 1.628 1.006l3.869-1.934c.317-.159.69-.159 1.006 0l4.994 2.497c.317.158.69.158 1.006 0z"/></svg>
                </div>
                <span class="text-white/50 text-sm">Anti-Crowd-Tipps inklusive</span>
              </div>
            </div>
          </div>
          <div class="mt-8 md:mt-0 md:flex md:justify-center">
            <a href="/de-de/reiserouten-planer/" class="inline-flex items-center gap-2.5 px-7 py-3.5 bg-gradient-to-r from-med-gold to-yellow-600 text-slate-900 font-bold rounded-xl hover:shadow-[0_0_30px_rgba(212,175,55,0.4)] hover:scale-105 transition-all duration-300">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 2L2 12l4 0 0 6 4 0 0-4 4 0 0 4 4 0 0-6 4 0L12 2z"/></svg>
              Jetzt konfigurieren
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Zugehörige Veranstaltungen -->
  <section class="py-4 sm:py-12 px-6 max-w-7xl mx-auto">
    <h2 class="font-serif text-3xl sm:text-4xl font-bold text-slate-900 mb-12">Zugehörige Veranstaltungen</h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
      <a href="/de-de/veranstaltungen/amalfikueste/luminaria-san-domenico-praiano/" class="block bg-white rounded-[2rem] border border-slate-100 overflow-hidden shadow-sm hover:shadow-md transition-shadow">
        <img src="/images/praiano-hero.jpg" alt="Luminaria" class="h-40 w-full object-cover" />
        <div class="p-6">
          <span class="text-med-gold text-[10px] font-bold uppercase tracking-widest mb-2 block">August 2026</span>
          <h3 class="font-serif text-lg font-bold text-slate-900 mb-2">Luminaria San Domenico</h3>
          <p class="text-slate-600 text-sm mb-4">Spektakuläre Fackelparade am Strand.</p>
          <p class="text-slate-500 text-xs font-medium">📍 Praiano, SA</p>
        </div>
      </a>
      <a href="/de-de/veranstaltungen/amalfikueste/positano-mare-sole-cultura/" class="block bg-white rounded-[2rem] border border-slate-100 overflow-hidden shadow-sm hover:shadow-md transition-shadow">
        <img src="/images/positano-hero.jpg" alt="Positano Kultur" class="h-40 w-full object-cover" />
        <div class="p-6">
          <span class="text-med-gold text-[10px] font-bold uppercase tracking-widest mb-2 block">Juli - August 2026</span>
          <h3 class="font-serif text-lg font-bold text-slate-900 mb-2">Positano Meer Sonne Kultur</h3>
          <p class="text-slate-600 text-sm mb-4">Kunstfestival mit Musik, Theater und Traditionen.</p>
          <p class="text-slate-500 text-xs font-medium">📍 Positano, SA</p>
        </div>
      </a>
      <a href="/de-de/veranstaltungen/amalfikueste/sagra-del-pesce-positano/" class="block bg-white rounded-[2rem] border border-slate-100 overflow-hidden shadow-sm hover:shadow-md transition-shadow">
        <img src="/images/positano-hero.jpg" alt="Sagra Pesce" class="h-40 w-full object-cover" />
        <div class="p-6">
          <span class="text-med-gold text-[10px] font-bold uppercase tracking-widest mb-2 block">Oktober 2026</span>
          <h3 class="font-serif text-lg font-bold text-slate-900 mb-2">Sagra del Pesce</h3>
          <p class="text-slate-600 text-sm mb-4">Feier der lokalen Meeresfrüchte mit traditioneller Küche.</p>
          <p class="text-slate-500 text-xs font-medium">📍 Positano, SA</p>
        </div>
      </a>
    </div>
  </section>

  <!-- Destinazione CTA -->
  <section class="bg-med-blue text-white py-12 sm:py-16 px-6">
    <div class="max-w-7xl mx-auto">
      <div class="flex flex-col sm:flex-row items-center justify-between gap-8">
        <div>
          <h3 class="font-serif text-2xl sm:text-3xl font-bold mb-3">Erkunden Sie Vietri sul Mare</h3>
          <p class="text-white/70 text-sm sm:text-base max-w-md">Berühmt für bunte Keramik und Meerescharme.</p>
        </div>
        <a href="/de-de/amalfikueste/vietri-sul-mare/" class="bg-med-gold text-white px-8 py-3 rounded-full font-medium hover:bg-yellow-500 transition-colors whitespace-nowrap">
          View Destination →
        </a>
      </div>
    </div>
  </section>


