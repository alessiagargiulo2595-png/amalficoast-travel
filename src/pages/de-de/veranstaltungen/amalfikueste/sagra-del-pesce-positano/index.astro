---
import BaseLayout from '../../../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../../../components/Breadcrumbs.astro';

const lang = 'de-de';

const breadcrumbs = [
  { name: 'Home', url: '/de-de/' },
  { name: 'Veranstaltungen', url: '/de-de/veranstaltungen/' },
  { name: 'Fischfest Positano', url: '/de-de/veranstaltungen/amalfikueste/sagra-del-pesce-positano/' },
];

const eventSchema = {
  "@context": "https://schema.org",
  "@type": "Event",
  "name": "Fischfest Positano 2026",
  "startDate": "2026-09-26",
  "endDate": "2026-09-26",
  "location": {
    "@type": "Place",
    "name": "Strand Fornillo, Positano",
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Positano",
      "addressRegion": "SA",
      "addressCountry": "IT"
    }
  },
  "url": "https://amalficoast-travel.com/de-de/veranstaltungen/amalfikueste/sagra-del-pesce-positano/"
};

const facts = [
  { dt: 'Datum', dd: '26. September 2026' },
  { dt: 'Veranstaltungsort', dd: 'Strand Fornillo, Positano' },
  { dt: 'Spezialität', dd: 'Frittura di paranza' },
  { dt: 'Shuttle', dd: 'Kostenloses Seependelboot' },
  { dt: 'Eintritt', dd: 'Kostenlos' },
];
---

<BaseLayout
  title="Fischfest Positano 2026 – Frittura di Paranza am Strand Fornillo"
  description="Das Fischfest in Positano am 26. September 2026. Lokales Fischgericht am Strand Fornillo mit kostenlosem Seependelboot vom Hauptsteg."
  lang={lang}
  breadcrumbs={breadcrumbs}
  schema={[eventSchema]}
 pageKey="sagra-del-pesce-positano">

  <!-- Hero -->
  <section class="relative h-[65vh] sm:h-[70vh] overflow-hidden flex items-center justify-center">
    <img
      src="/images/positano-hero.jpg"
      alt="Fischfest, Strand Fornillo, Positano"
      class="absolute inset-0 w-full h-full object-cover"
      loading="eager" fetchpriority="high" decoding="sync" referrerpolicy="no-referrer"
    />
    <div class="absolute inset-0 bg-gradient-to-b from-black/20 via-black/50 to-black/70"></div>
    <div class="relative z-10 text-center px-6 max-w-5xl text-white">
      <div class="flex flex-wrap justify-center items-center gap-4 mb-6">
        <span class="bg-med-gold text-white px-4 py-1 rounded-full text-[10px] font-bold uppercase tracking-widest">Veranstaltung 2026</span>
        <span class="text-white/70 text-xs sm:text-sm">26. September 2026</span>
        <span class="text-white/70 text-xs sm:text-sm">Positano, SA</span>
      </div>
      <h1 class="font-serif text-5xl md:text-7xl font-bold text-white leading-tight mb-6">Fischfest Positano</h1>
      <p class="text-white/85 text-lg md:text-xl font-light max-w-2xl mx-auto leading-relaxed">
        Die Frittura di paranza läutet das Ende des Sommers am Strand Fornillo ein.
      </p>
    </div>
    <Breadcrumbs breadcrumbs={breadcrumbs} isEvent={true} />
  </section>

  <!-- Content 70/30 -->
  <section class="py-12 sm:py-24 px-6 max-w-7xl mx-auto">
    <div class="grid grid-cols-1 lg:grid-cols-10 gap-16">

      <!-- Main Content (70%) -->
      <div class="lg:col-span-7 space-y-12">
        <div>
          <h2 class="font-serif text-4xl font-bold text-slate-900 mb-8">Zur Veranstaltung</h2>
          <div class="space-y-4 text-slate-600 text-lg leading-relaxed">
            <p>Ein lokales Fischfest am ruhigen Strand Fornillo, abseits der überfüllten Hauptstrände Positanos. Der Höhepunkt: die Frittura di paranza, ein traditionelles gemischtes Fischgericht aus dem Tyrrhenischen Meer, frisch zubereitet und kostenlos angeboten.</p>
            <p>Ein kostenloses Seependelboot verbindet den Hauptsteg von Positano mit dem Strand Fornillo während des gesamten Festes – ideal, um das Ereignis stressfrei zu erreichen und dabei die Küstensilhouette vom Wasser aus zu genießen.</p>
          </div>
        </div>

        <!-- Das Fest -->
        <div>
          <h3 class="font-serif text-2xl font-bold text-slate-900 mb-6">Das Fest</h3>
          <div class="grid sm:grid-cols-2 gap-6">
            <div class="bg-white p-8 rounded-[2rem] border border-slate-100 shadow-sm">
              <span class="text-med-gold text-[10px] font-bold uppercase tracking-widest mb-2 block">Frittura di paranza</span>
              <h4 class="text-xl font-serif font-bold text-slate-900 mb-3">Das traditionelle Gericht</h4>
              <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Die Frittura di paranza ist ein typisches Gericht der Amalfiküste: kleine Fische aus dem lokalen Fischfang, in Mehl gewendet und in Olivenöl goldbraun gebraten – einfach und unvergleichlich gut.</p>
            </div>
            <div class="bg-white p-8 rounded-[2rem] border border-slate-100 shadow-sm">
              <span class="text-med-gold text-[10px] font-bold uppercase tracking-widest mb-2 block">Strand Fornillo</span>
              <h4 class="text-xl font-serif font-bold text-slate-900 mb-3">Der ruhige Strand</h4>
              <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Im Gegensatz zum belebten Spiaggia Grande ist der Fornillo-Strand ein ruhigerer, von Fischern bevorzugter Ort – authentischer und weniger touristisch geprägt.</p>
            </div>
          </div>
        </div>

        <!-- Anreise -->
        <div>
          <h3 class="font-serif text-2xl font-bold text-slate-900 mb-6">Anreise</h3>
          <div class="bg-white rounded-[2rem] border border-slate-100 overflow-hidden shadow-sm">
            <table class="w-full text-xs sm:text-xs sm:text-sm">
              <thead>
                <tr class="bg-slate-900 text-white">
                  <th class="text-left px-6 py-4 font-semibold">Verkehrsmittel</th>
                  <th class="text-left px-6 py-4 font-semibold">Verbindung</th>
                  <th class="text-left px-6 py-4 font-semibold">Hinweise</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-slate-100">
                <tr class="hover:bg-slate-50 transition-colors">
                  <td class="px-6 py-4 font-medium">Seependelboot</td>
                  <td class="px-6 py-4 text-slate-600">Vom Hauptsteg Positano</td>
                  <td class="px-6 py-4 text-slate-500 text-xs">Kostenlos während des Festes</td>
                </tr>
                <tr class="hover:bg-slate-50 transition-colors">
                  <td class="px-6 py-4 font-medium">Zu Fuß</td>
                  <td class="px-6 py-4 text-slate-600">Vom Zentrum Positanos</td>
                  <td class="px-6 py-4 text-slate-500 text-xs">15 min über den Küstenpfad</td>
                </tr>
                <tr class="hover:bg-slate-50 transition-colors">
                  <td class="px-6 py-4 font-medium">Fähre</td>
                  <td class="px-6 py-4 text-slate-600">Ab Amalfi oder Sorrent</td>
                  <td class="px-6 py-4 text-slate-500 text-xs">Anleger Positano, dann Seependelboot</td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>
      </div>

      <!-- Sidebar (30%) -->
      <aside class="lg:col-span-3">
        <div class="bg-slate-900 text-white p-10 rounded-[3rem] sticky top-32 shadow-2xl">
          <p class="text-[10px] uppercase tracking-[0.3em] text-med-gold font-medium mb-6">Veranstaltungsdetails</p>
          <dl class="space-y-4">
            {facts.map(({ dt, dd }, i) => (
              <>
                <div>
                  <dt class="text-white/40 text-[10px] uppercase tracking-widest font-bold mb-1">{dt}</dt>
                  <dd class="text-white font-medium">{dd}</dd>
                </div>
                {i < facts.length - 1 && <div class="border-t border-white/5"></div>}
              </>
            ))}
          </dl>
          <div class="mt-10 pt-8 border-t border-white/5">
            <p class="text-white/50 text-xs leading-relaxed">Wir empfehlen, frühzeitig anzureisen. Das aktualisierte Programm finden Sie auf den offiziellen Kanälen.</p>
          </div>
        </div>
      </aside>

    </div>
  </section>

  <!-- Zugehörige Veranstaltungen -->
  <section class="py-4 sm:py-12 px-6 max-w-7xl mx-auto">
    <h2 class="font-serif text-3xl sm:text-4xl font-bold text-slate-900 mb-12">Zugehörige Veranstaltungen</h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
      <div class="bg-white rounded-[2rem] border border-slate-100 overflow-hidden shadow-sm hover:shadow-md transition-shadow">
        <img src="/images/positano-hero.jpg" alt="Feuerwerk" class="h-40 w-full object-cover" />
        <div class="p-6">
          <span class="text-med-gold text-[10px] font-bold uppercase tracking-widest mb-2 block">August 2026</span>
          <h3 class="font-serif text-lg font-bold text-slate-900 mb-2">Feuerwerk Ferragosto</h3>
          <p class="text-slate-600 text-sm mb-4">Spektakuläre Pyrotechnik über dem Meer.</p>
          <p class="text-slate-500 text-xs font-medium">📍 Positano & Maiori, SA</p>
        </div>
      </div>
      <div class="bg-white rounded-[2rem] border border-slate-100 overflow-hidden shadow-sm hover:shadow-md transition-shadow">
        <img src="/images/vietri-hero.jpg" alt="Notte Blu" class="h-40 w-full object-cover" />
        <div class="p-6">
          <span class="text-med-gold text-[10px] font-bold uppercase tracking-widest mb-2 block">Juli 2026</span>
          <h3 class="font-serif text-lg font-bold text-slate-900 mb-2">Notte Blu</h3>
          <p class="text-slate-600 text-sm mb-4">Keramikkunst-Feier mit Licht und Aufführungen.</p>
          <p class="text-slate-500 text-xs font-medium">📍 Vietri sul Mare, SA</p>
        </div>
      </div>
      <div class="bg-white rounded-[2rem] border border-slate-100 overflow-hidden shadow-sm hover:shadow-md transition-shadow">
        <img src="/images/positano-hero.jpg" alt="Positano Kultur" class="h-40 w-full object-cover" />
        <div class="p-6">
          <span class="text-med-gold text-[10px] font-bold uppercase tracking-widest mb-2 block">Juli - August 2026</span>
          <h3 class="font-serif text-lg font-bold text-slate-900 mb-2">Positano Meer Sonne Kultur</h3>
          <p class="text-slate-600 text-sm mb-4">Kunstfestival mit Musik, Theater und Traditionen.</p>
          <p class="text-slate-500 text-xs font-medium">📍 Positano, SA</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Destinazione CTA -->
  <section class="bg-med-blue text-white py-12 sm:py-16 px-6">
    <div class="max-w-7xl mx-auto">
      <div class="flex flex-col sm:flex-row items-center justify-between gap-8">
        <div>
          <h3 class="font-serif text-2xl sm:text-3xl font-bold mb-3">Erkunden Sie Positano</h3>
          <p class="text-white/70 text-sm sm:text-base max-w-md">Das Juwel der Küste mit bunten Dörfern am Hang.</p>
        </div>
        <a href="/de-de/amalfikueste/positano/" class="bg-med-gold text-white px-8 py-3 rounded-full font-medium hover:bg-yellow-500 transition-colors whitespace-nowrap">
          View Destination →
        </a>
      </div>
    </div>
  </section>


