---
import BaseLayout from '../../../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../../../components/Breadcrumbs.astro';
import LocalitySlider from '../../../../../components/LocalitySlider.astro';

const lang = 'de-de';

const breadcrumbs = [
  { name: 'Home', url: '/de-de/' },
  { name: 'Veranstaltungen', url: '/de-de/veranstaltungen/' },
  { name: 'Sorrento Meeting', url: '/de-de/veranstaltungen/sorrentinische-halbinsel/sorrento-meeting-cultura/' },
];

const eventSchema = {
  "@context": "https://schema.org",
  "@type": "EventSeries",
  "name": "Sorrento Meeting",
  "description": "Das Sorrento Meeting von Juni bis Juli 2026. Abendliche Begegnungen mit international renommierten Autoren im gotisch-arabischen Kreuzgang von San Francesco.",
  "image": "https://amalficoast-travel.com/images/sorrento-hero.jpg",
  "url": "https://amalficoast-travel.com/de-de/veranstaltungen/sorrentinische-halbinsel/sorrento-meeting-cultura/",
  "location": {
      "@type": "Place",
      "name": "Kreuzgang San Francesco, Sorrent",
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Sorrento",
        "addressRegion": "NA",
        "addressCountry": "IT"
      }
    },
  "eventStatus": "https://schema.org/EventScheduled",
  "eventAttendanceMode": "https://schema.org/OfflineEventAttendanceMode",
  "startDate": "2026-06-01",
  "endDate": "2026-07-31",
  "subEvent": [
    {
      "@type": "Event",
      "name": "Sorrento Meeting 2026",
      "startDate": "2026-06-01",
      "endDate": "2026-07-31",
      "eventStatus": "https://schema.org/EventScheduled",
      "eventAttendanceMode": "https://schema.org/OfflineEventAttendanceMode",
      "location": {
          "@type": "Place",
          "name": "Kreuzgang San Francesco, Sorrent",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Sorrento",
            "addressRegion": "NA",
            "addressCountry": "IT"
          }
        },
      "url": "https://amalficoast-travel.com/de-de/veranstaltungen/sorrentinische-halbinsel/sorrento-meeting-cultura/",
      "image": "https://amalficoast-travel.com/images/sorrento-hero.jpg",
      "description": "Das Sorrento Meeting von Juni bis Juli 2026. Abendliche Begegnungen mit international renommierten Autoren im gotisch-arabischen Kreuzgang von San Francesco."
    }
  ]
};

const facts = [
  { dt: 'Zeitraum', dd: 'Jun–Jul 2026' },
  { dt: 'Veranstaltungsort', dd: 'Kreuzgang San Francesco' },
  { dt: 'Typ', dd: 'Literarische Begegnungsreihe' },
  { dt: 'Zugang', dd: 'Reservierung empfohlen' },
  { dt: 'Ab Neapel', dd: 'Circumvesuviana 70 min' },
];
---

<BaseLayout
  title="Sorrento Meeting 2026 – Literatur & Journalismus im Kreuzgang"
  description="Das Sorrento Meeting von Juni bis Juli 2026. Abendliche Begegnungen mit international renommierten Autoren im gotisch-arabischen Kreuzgang von San Francesco."
  lang={lang}
  breadcrumbs={breadcrumbs}
  schema={[eventSchema]}
 pageKey="sorrento-meeting-cultura"
  heroImage="/images/sorrento-hero.jpg"
>

  <!-- Hero -->
  <section class="relative h-[65vh] sm:h-[70vh] overflow-hidden flex items-center justify-center">
    <img
      src="/images/sorrento-hero.jpg"
      alt="Sorrento Meeting, Kreuzgang San Francesco"
      class="absolute inset-0 w-full h-full object-cover"
      loading="eager" fetchpriority="high" decoding="sync" referrerpolicy="no-referrer"
    />
    <div class="absolute inset-0 bg-gradient-to-b from-black/20 via-black/50 to-black/70"></div>
    <div class="relative z-10 text-center px-6 max-w-5xl text-white">
      <div class="flex flex-wrap justify-center items-center gap-4 mb-6">
        <span class="bg-med-gold text-white px-4 py-1 rounded-full text-[10px] font-bold uppercase tracking-widest">Veranstaltung 2026</span>
        <span class="text-white/70 text-xs sm:text-sm">Jun–Jul 2026</span>
        <span class="text-white/70 text-xs sm:text-sm">Sorrent, NA</span>
      </div>
      <h1 class="font-serif text-5xl md:text-7xl font-bold text-white leading-tight mb-6">Sorrento Meeting</h1>
      <p class="text-white/85 text-lg md:text-xl font-light max-w-2xl mx-auto leading-relaxed">
        Literatur und internationaler Journalismus im Kreuzgang aus dem 14. Jahrhundert.
      </p>
    </div>
    <Breadcrumbs breadcrumbs={breadcrumbs} isEvent={true} />
  </section>

  <!-- Content 70/30 -->
  <section class="py-12 sm:py-24 px-6 max-w-7xl mx-auto">
    <div class="grid grid-cols-1 lg:grid-cols-10 gap-16">

      <!-- Main Content (70%) -->
      <div class="lg:col-span-7 space-y-12">
        <div>
          <h2 class="font-serif text-4xl font-bold text-slate-900 mb-8">Zur Veranstaltung</h2>
          <div class="space-y-4 text-slate-600 text-lg leading-relaxed">
            <p>Eine literarische und journalistische Begegnungsreihe im Kreuzgang von San Francesco. Abendliche Treffen mit international renommierten Autoren. Der gotisch-arabische Kreuzgang aus dem 14. Jahrhundert bietet einen einzigartigen Rahmen für die Kulturbegegnungen dieser Sommerreihe.</p>
            <p>Die Abendveranstaltungen finden typischerweise bei Sonnenuntergang statt und nutzen das magische Abendlicht im Kreuzgang. Die Teilnehmer können den Abend anschließend in den Restaurants und Panoramaterrassen des Sorrenter Zentrums fortsetzen.</p>
          </div>
        </div>

        <!-- Die Kulturreihe -->
        <div>
          <h3 class="font-serif text-2xl font-bold text-slate-900 mb-6">Die Kulturreihe</h3>
          <div class="grid sm:grid-cols-2 gap-6">
            <div class="bg-white p-8 rounded-[2rem] border border-slate-100 shadow-sm">
              <span class="text-med-gold text-[10px] font-bold uppercase tracking-widest mb-2 block">Autorenbegegnungen</span>
              <h4 class="text-xl font-serif font-bold text-slate-900 mb-3">Internationale Literatur</h4>
              <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Schriftsteller, Journalisten und international renommierte Intellektuelle wechseln sich im Kreuzgang ab, um ihre Werke vorzustellen und in einem offenen, informellen Format mit dem Publikum zu diskutieren.</p>
            </div>
            <div class="bg-white p-8 rounded-[2rem] border border-slate-100 shadow-sm">
              <span class="text-med-gold text-[10px] font-bold uppercase tracking-widest mb-2 block">Der Kreuzgang</span>
              <h4 class="text-xl font-serif font-bold text-slate-900 mb-3">Ein einzigartiger Ort</h4>
              <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Der Kreuzgang von San Francesco mit seinen gotisch-arabischen Bögen aus dem 14. Jahrhundert ist einer der stimmungsvollsten Orte Sorrents und ein aktives Kulturzentrum während des gesamten Sommers.</p>
            </div>
          </div>
        </div>

        <!-- Anreise -->
        <div>
          <h3 class="font-serif text-2xl font-bold text-slate-900 mb-6">Anreise</h3>
          <div class="bg-white rounded-[2rem] border border-slate-100 overflow-hidden shadow-sm">
            <table class="w-full text-xs sm:text-xs sm:text-sm">
              <thead>
                <tr class="bg-slate-900 text-white">
                  <th class="text-left px-6 py-4 font-semibold">Verkehrsmittel</th>
                  <th class="text-left px-6 py-4 font-semibold">Verbindung</th>
                  <th class="text-left px-6 py-4 font-semibold">Hinweise</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-slate-100">
                <tr class="hover:bg-slate-50 transition-colors">
                  <td class="px-6 py-4 font-medium">Circumvesuviana</td>
                  <td class="px-6 py-4 text-slate-600">Ab Neapel Garibaldi</td>
                  <td class="px-6 py-4 text-slate-500 text-xs">70 Minuten, Haltestelle Sorrent</td>
                </tr>
                <tr class="hover:bg-slate-50 transition-colors">
                  <td class="px-6 py-4 font-medium">Fähre</td>
                  <td class="px-6 py-4 text-slate-600">Ab der Küste oder Neapel</td>
                  <td class="px-6 py-4 text-slate-500 text-xs">Hafen Sorrent, Inselverbindungen</td>
                </tr>
                <tr class="hover:bg-slate-50 transition-colors">
                  <td class="px-6 py-4 font-medium">Zu Fuß</td>
                  <td class="px-6 py-4 text-slate-600">Ab Sorrentzentrum</td>
                  <td class="px-6 py-4 text-slate-500 text-xs">5 min ab der Piazza Tasso</td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>
      </div>

      <!-- Sidebar (30%) -->
      <aside class="lg:col-span-3">
        <div class="bg-slate-900 text-white p-10 rounded-[3rem] sticky top-32 shadow-2xl">
          <p class="text-[10px] uppercase tracking-[0.3em] text-med-gold font-medium mb-6">Veranstaltungsdetails</p>
          <dl class="space-y-4">
            {facts.map(({ dt, dd }, i) => (
              <>
                <div>
                  <dt class="text-white/40 text-[10px] uppercase tracking-widest font-bold mb-1">{dt}</dt>
                  <dd class="text-white font-medium">{dd}</dd>
                </div>
                {i < facts.length - 1 && <div class="border-t border-white/5"></div>}
              </>
            ))}
          </dl>
          <div class="mt-10 pt-8 border-t border-white/5">
            <p class="text-white/50 text-xs leading-relaxed">Wir empfehlen, frühzeitig anzureisen. Das aktualisierte Programm finden Sie auf den offiziellen Kanälen.</p>
          </div>
        </div>
      </aside>

    </div>
  </section>

  <LocalitySlider
    heading="Entdecke Sorrent"
    lang={lang}
    items={[
      { name: "Sorrent", href: '/de-de/sorrentinische-halbinsel/sorrent/', image: '/images/sorrento-hero.jpg', tag: "Veranstaltungsort" },
      { name: "Sant'Agnello", href: '/de-de/sorrentinische-halbinsel/sant-agnello/', image: '/images/sorrento-hero.jpg', tag: "In der Nähe" },
      { name: "Meta", href: '/de-de/sorrentinische-halbinsel/meta/', image: '/images/meta-hero.webp', tag: "In der Nähe" },
      { name: "Massa Lubrense", href: '/de-de/sorrentinische-halbinsel/massa-lubrense/', image: '/images/massa-lubrense-hero.jpg', tag: "Natur" },
    ]}
  />

    <!-- BANNER: Itinerary Planner -->
  <section class="py-10 md:py-14 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6">
      <div class="relative overflow-hidden rounded-[2.5rem] bg-gradient-to-br from-slate-900 via-slate-950 to-blue-950 px-6 sm:px-10 md:px-14 py-10 md:py-14 shadow-[0_20px_60px_rgba(0,0,0,0.35)]">
        <div class="absolute -top-20 -left-20 w-72 h-72 bg-blue-500/15 rounded-full blur-3xl pointer-events-none"></div>
        <div class="absolute -bottom-20 -right-20 w-72 h-72 bg-amber-500/10 rounded-full blur-3xl pointer-events-none"></div>
        <div class="relative z-10 grid md:grid-cols-[3fr_2fr] md:items-center gap-8">
          <div>
            <span class="inline-block px-4 py-1.5 rounded-full text-xs font-semibold tracking-wide uppercase bg-med-gold/15 text-med-gold border border-med-gold/25 mb-6">Neu: Maßgeschneiderte Reise</span>
            <h2 class="text-3xl md:text-4xl font-bold text-white leading-tight mb-2">Gestalte deinen</h2>
            <p class="font-serif text-3xl md:text-4xl italic text-med-blue mb-5">idealen Reiseplan</p>
            <p class="text-white/60 text-base md:text-lg leading-relaxed max-w-xl mb-8">
              Beantworte ein paar einfache Fragen - Startpunkt, Tage und Interessen - und erhalte einen personalisierten Reiseplan mit Transport, Kosten und Zeiten.
            </p>
            <div class="flex flex-wrap gap-6">
              <div class="flex items-center gap-2.5">
                <div class="w-9 h-9 rounded-xl bg-white/5 border border-white/10 flex items-center justify-center">
                  <svg class="w-4 h-4 text-med-gold" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                </div>
                <span class="text-white/50 text-sm">30 Sekunden zur Konfiguration</span>
              </div>
              <div class="flex items-center gap-2.5">
                <div class="w-9 h-9 rounded-xl bg-white/5 border border-white/10 flex items-center justify-center">
                  <svg class="w-4 h-4 text-med-gold" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 6.75V15m6-6v8.25m.503 3.498l4.875-2.437c.381-.19.622-.58.622-1.006V4.82c0-.836-.88-1.38-1.628-1.006l-3.869 1.934c-.317.159-.69.159-1.006 0L9.503 3.252a1.125 1.125 0 00-1.006 0L3.622 5.689C3.24 5.88 3 6.27 3 6.695V19.18c0 .836.88 1.38 1.628 1.006l3.869-1.934c.317-.159.69-.159 1.006 0l4.994 2.497c.317.158.69.158 1.006 0z"/></svg>
                </div>
                <span class="text-white/50 text-sm">Anti-Crowd-Tipps inklusive</span>
              </div>
            </div>
          </div>
          <div class="mt-8 md:mt-0 md:flex md:justify-center">
            <a href="/de-de/reiserouten-planer/" class="inline-flex items-center gap-2.5 px-7 py-3.5 bg-gradient-to-r from-med-gold to-yellow-600 text-slate-900 font-bold rounded-xl hover:shadow-[0_0_30px_rgba(212,175,55,0.4)] hover:scale-105 transition-all duration-300">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 2L2 12l4 0 0 6 4 0 0-4 4 0 0 4 4 0 0-6 4 0L12 2z"/></svg>
              Jetzt konfigurieren
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Zugehörige Veranstaltungen -->
  <section class="py-4 sm:py-12 px-6 max-w-7xl mx-auto">
    <h2 class="font-serif text-3xl sm:text-4xl font-bold text-slate-900 mb-12">Zugehörige Veranstaltungen</h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
      <a href="/de-de/veranstaltungen/sorrentinische-halbinsel/festa-sant-antonino/" class="block bg-white rounded-[2rem] border border-slate-100 overflow-hidden shadow-sm hover:shadow-md transition-shadow">
        <img src="/images/sorrento-hero.jpg" alt="Antonino" class="h-40 w-full object-cover" />
        <div class="p-6">
          <span class="text-med-gold text-[10px] font-bold uppercase tracking-widest mb-2 block">Februar 2026</span>
          <h3 class="font-serif text-lg font-bold text-slate-900 mb-2">Fest Sant'Antonino</h3>
          <p class="text-slate-600 text-sm mb-4">Feier des Schutzpatrons mit Prozessionen.</p>
          <p class="text-slate-500 text-xs font-medium">📍 Sorrent, NA</p>
        </div>
      </a>
      <a href="/de-de/veranstaltungen/sorrentinische-halbinsel/gustamincanto-vico-equense/" class="block bg-white rounded-[2rem] border border-slate-100 overflow-hidden shadow-sm hover:shadow-md transition-shadow">
        <img src="/images/vico-equense-hero.jpg" alt="Gustamincanto" class="h-40 w-full object-cover" />
        <div class="p-6">
          <span class="text-med-gold text-[10px] font-bold uppercase tracking-widest mb-2 block">September 2026</span>
          <h3 class="font-serif text-lg font-bold text-slate-900 mb-2">Gustamincanto</h3>
          <p class="text-slate-600 text-sm mb-4">Fest der lokalen Gastronomie und kulinarischen Traditionen.</p>
          <p class="text-slate-500 text-xs font-medium">📍 Vico Equense, NA</p>
        </div>
      </a>
      <a href="/de-de/veranstaltungen/sorrentinische-halbinsel/sagra-limone-massa-lubrense/" class="block bg-white rounded-[2rem] border border-slate-100 overflow-hidden shadow-sm hover:shadow-md transition-shadow">
        <img src="/images/massa-lubrense-hero.jpg" alt="Zitrone" class="h-40 w-full object-cover" />
        <div class="p-6">
          <span class="text-med-gold text-[10px] font-bold uppercase tracking-widest mb-2 block">Juni 2026</span>
          <h3 class="font-serif text-lg font-bold text-slate-900 mb-2">Sagra del Limone</h3>
          <p class="text-slate-600 text-sm mb-4">Feier der berühmten Zitronen von Sorrent.</p>
          <p class="text-slate-500 text-xs font-medium">📍 Massa Lubrense, NA</p>
        </div>
      </a>
    </div>
  </section>

  <!-- Destinazione CTA -->
  <section class="bg-med-blue text-white py-12 sm:py-16 px-6">
    <div class="max-w-7xl mx-auto">
      <div class="flex flex-col sm:flex-row items-center justify-between gap-8">
        <div>
          <h3 class="font-serif text-2xl sm:text-3xl font-bold mb-3">Erkunden Sie Sorrent</h3>
          <p class="text-white/70 text-sm sm:text-base max-w-md">Klifftop-Stadt mit Ausblicken, Gärten und süßen Weinen.</p>
        </div>
        <a href="/de-de/sorrentinische-halbinsel/sorrent/" class="bg-med-gold text-white px-8 py-3 rounded-full font-medium hover:bg-yellow-500 transition-colors whitespace-nowrap">
          View Destination →
        </a>
      </div>
    </div>
  </section>


