---
import BaseLayout from '../../layouts/BaseLayout.astro';

const lang = 'de-de';

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "TouristDestination",
    "name": "Amalfiküste",
    "alternateName": "Costiera Amalfitana",
    "description": "UNESCO-Welterbe, 50 km Steilküste am Tyrrhenischen Meer in Kampanien, Italien.",
    "url": "https://amalficoast-travel.com/de-de/",
    "geo": { "@type": "GeoCoordinates", "latitude": "40.634", "longitude": "14.602" },
    "containedInPlace": { "@type": "Country", "name": "Italy" }
  }
];

const silos = [
  {
    title: 'Amalfiküste',
    subtitle: '50 km UNESCO-Steilküste',
    href: '/de-de/amalfikueste/',
    borghi: ['Positano', 'Amalfi', 'Ravello', 'Praiano', 'Maiori', 'Minori'],
    img: '/images/costiera-hero.webp',
  },
  {
    title: 'Halbinsel Sorrent',
    subtitle: 'Das Tor zum Süden Italiens',
    href: '/de-de/destinations/',
    borghi: ['Sorrent', 'Vico Equense', 'Massa Lubrense', "Sant'Agnello"],
    img: '/images/sorrento-hero.webp',
  },
  {
    title: 'Inseln im Golf',
    subtitle: 'Capri, Ischia, Procida',
    href: '/de-de/inseln/',
    borghi: ['Capri', 'Ischia', 'Procida'],
    img: '/images/capri-hero.webp',
  },
];

const borghi = [
  {
    name: 'Positano',
    subtitle: 'Die lebendige Postkarte',
    description: 'Berühmt für seine pastellfarbenen Häuser, die der Schwerkraft zu trotzen scheinen, Luxusboutiquen und ikonische Strände.',
    img: '/images/positano-hero.webp',
    href: '/de-de/amalfikueste/positano/',
    tags: ['Ikonisch', 'Mode', 'Spiaggia Grande'],
  },
  {
    name: 'Amalfi',
    subtitle: 'Die alte Seerepublik',
    description: 'Das historische Herz der Küste, dominiert vom majestätischen Dom Sant\'Andrea und den alten Papiermühlen.',
    img: '/images/amalfi-hero.webp',
    href: '/de-de/amalfikueste/amalfi/',
    tags: ['Geschichte', 'Dom', 'Piazza'],
  },
  {
    name: 'Ravello',
    subtitle: 'Die Stadt der Musik',
    description: 'Zwischen Himmel und Meer schwebend, bietet sie die spektakulärsten Panoramen von ihren historischen Villen und verwunschenen Gärten.',
    img: '/images/ravello-hero.webp',
    href: '/de-de/amalfikueste/ravello/',
    tags: ['Musik', 'Villa Cimbrone', 'Aussicht'],
  },
  {
    name: 'Praiano',
    subtitle: 'Das Dorf der Sonnenuntergänge',
    description: 'Eine Oase der Ruhe mit atemberaubenden Ausblicken und einer lebhaften lokalen Kunstszene zwischen Meer und Bergen.',
    img: '/images/praiano-hero.webp',
    href: '/de-de/amalfikueste/praiano/',
    tags: ['Sonnenuntergänge', 'Entspannung', 'Marina di Praia'],
  },
  {
    name: 'Maiori',
    subtitle: 'Der längste Strand',
    description: 'Die ausgedehnteste Uferpromenade der Küste - authentisch, weniger überfüllt, mit den Überresten einer römischen Villa.',
    img: '/images/maiori-hero.webp',
    href: '/de-de/amalfikueste/maiori/',
    tags: ['Strand', 'Entspannung', 'Authentizität'],
  },
  {
    name: 'Minori',
    subtitle: 'Die gastronomische Seele',
    description: 'Bekannt für Limoncello, frische Pasta und die Überreste einer römischen Villa mit Meerblick.',
    img: '/images/minori-hero.webp',
    href: '/de-de/amalfikueste/minori/',
    tags: ['Gastronomie', 'Römische Villa', 'Zitronen'],
  },
];

const topBeaches = [
  { name: 'Spiaggia Grande', location: 'Positano', href: '/de-de/strande/amalfikueste/spiaggia-grande-positano/' },
  { name: 'Spiaggia di Ieranto', location: 'Massa Lubrense', href: '/de-de/strande/sorrentinische-halbinsel/spiaggia-di-ieranto/' },
  { name: 'Marina Piccola', location: 'Capri', href: '/de-de/strande/inseln/marina-piccola-capri/' },
  { name: 'Fiordo di Furore', location: 'Praiano', href: '/de-de/strande/amalfikueste/fiordo-di-furore/' },
];

const editorial = [
  { label: 'Reiseführer', title: 'Wann die Amalfiküste besuchen', subtitle: 'Monat für Monat: Wetter, Menschenmassen und Preise', href: '/de-de/reisezeit/' },
  { label: 'Reiserouten', title: 'Von 1 Tag bis 1 Woche', subtitle: 'Die besten fertigen Reiserouten', href: '/de-de/reiserouten/' },
  { label: 'Strände', title: 'Die 8 schönsten Strände', subtitle: 'Von Positano bis Cetara', href: '/de-de/strande/' },
  { label: 'Anreise', title: 'Anreise und Fortbewegung', subtitle: 'Fähren, SITA-Bus, Auto', href: '/de-de/anreise/' },
];
---

<BaseLayout
  title="Amalfiküste Reiseführer 2026 - Positano, Amalfi, Ravello"
  description="Vollständiger Reiseführer zur Amalfiküste. Dörfer, Strände, Fähren, Reiserouten und praktische Tipps. UNESCO-Welterbe in Kampanien, Italien."
  lang={lang}
  schema={schema}
>

  <!-- HERO -->
  <section class="relative min-h-[67.5vh] sm:min-h-[67.5vh] sm:min-h-[90vh] flex items-center justify-center bg-charcoal overflow-hidden">
    <img src="/images/hero-hp.webp" alt="Amalfi Coast" referrerpolicy="no-referrer" class="absolute inset-0 w-full h-full object-cover object-center" loading="eager" fetchpriority="high" decoding="sync" />
    <div class="absolute inset-0 bg-gradient-to-b from-black/55 via-black/30 to-black/65"></div>

    <div class="relative text-center px-6 max-w-4xl mx-auto">
      <p class="text-med-gold text-xs font-medium uppercase tracking-[0.3em] mb-6">UNESCO-Welterbe · Kampanien, Italien</p>
      <h1 class="font-serif text-white leading-tight mb-6" style="font-size: clamp(2.8rem, 7vw, 5.5rem); letter-spacing: -0.02em;">
        Die Amalfi<br/>
        <em class="not-italic text-med-gold">küste</em>
      </h1>
      <p class="text-blue-100 text-lg md:text-xl leading-relaxed max-w-2xl mx-auto mb-10 font-light">
        Fünfzig Kilometer Steilküste mit Blick auf das Tyrrhenische Meer. Bergdörfer, Riesenzitronen,
        bunte Fähren und ein Italien, das nie aufhört zu überraschen.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/de-de/amalfikueste/positano/"
           class="inline-block bg-med-blue text-white font-semibold px-8 py-3.5 rounded-full hover:scale-105 hover:shadow-[0_8px_30px_rgba(0,91,150,0.5)] transition-all duration-300 text-xs sm:text-sm">
          Mit Positano beginnen
        </a>
        <a href="/de-de/reiserouten/"
           class="inline-block border-2 border-white/50 text-white font-medium px-8 py-3.5 rounded-full hover:bg-white/10 hover:border-white transition-all duration-300 text-xs sm:text-sm">
          Reiseroute wählen
        </a>
      </div>
    </div>

    <div class="absolute bottom-8 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2 text-white/40">
      <svg class="w-4 h-4 animate-bounce" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
      </svg>
    </div>
  </section>

  <!-- WARUM BESUCHEN - Why Visit -->
  <section class="py-16 bg-white">
    <div class="max-w-7xl mx-auto px-6">
      <div class="text-center mb-12">
        <h2 class="font-serif text-4xl md:text-5xl font-bold text-slate-900 mb-6">Warum die Amalfiküste besuchen</h2>
        <div class="w-20 h-1 bg-med-gold mx-auto rounded-full"></div>
      </div>
      <div class="grid grid-cols-2 md:grid-cols-2 lg:grid-cols-4 gap-8">
        <div class="text-center border-2 border-med-gold rounded-2xl p-8">
          <h3 class="text-xl font-serif font-bold text-slate-900 mb-4">Unvergleichliche Szenen</h3>
          <p class="text-slate-600 text-sm leading-relaxed">Steilküsten und Ausblicke, die einem den Atem rauben, an jeder Kurve der Amalfi-Straße.</p>
        </div>
        <div class="text-center border-2 border-med-gold rounded-2xl p-8">
          <h3 class="text-xl font-serif font-bold text-slate-900 mb-4">Tausendjährige Geschichte</h3>
          <p class="text-slate-600 text-sm leading-relaxed">Von antiken Seerepubliken bis zu glorreichen Villen und mittelalterlichen Klöstern.</p>
        </div>
        <div class="text-center border-2 border-med-gold rounded-2xl p-8">
          <h3 class="text-xl font-serif font-bold text-slate-900 mb-4">Authentische Aromen</h3>
          <p class="text-slate-600 text-sm leading-relaxed">Frische Pasta bis zu Rieszitronen - eine Reise in den authentischsten Mittelmeergeschmack.</p>
        </div>
        <div class="text-center border-2 border-med-gold rounded-2xl p-8">
          <h3 class="text-xl font-serif font-bold text-slate-900 mb-4">Einzigartige Erlebnisse</h3>
          <p class="text-slate-600 text-sm leading-relaxed">Bergpfade, Bootsausflüge und jahrhundertealte handwerkliche Traditionen.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- BORGHI INCANTATI -->
  <section id="orte" class="py-16 bg-med-cream">
    <div class="max-w-7xl mx-auto px-6">

      <div class="flex flex-col md:flex-row justify-between items-end mb-12 gap-6">
        <div class="max-w-2xl">
          <p class="text-med-gold text-xs font-bold uppercase tracking-[0.3em] mb-3">Die Küste entdecken</p>
          <h2 class="font-serif text-4xl md:text-5xl font-bold text-slate-900 tracking-tight mb-4">Die Verzauberten Dörfer</h2>
          <p class="text-slate-500 text-lg font-light">Entdecken Sie die Perlen der Küste, jede mit ihrer eigenen Seele und jahrhundertealten Traditionen.</p>
        </div>
        <a href="/de-de/amalfikueste/" class="group flex items-center gap-2 text-med-blue font-semibold hover:text-med-gold transition-colors flex-shrink-0">
          Alle Reiseziele
          <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
        </a>
      </div>

      <!-- MOBILE: Swiper slider -->
      <div class="swiper swiper-borghi md:hidden">
        <div class="swiper-wrapper pb-12">
          {borghi.map((b) => (
            <div class="swiper-slide">
              <a href={b.href} class="group cursor-pointer flex flex-col h-full">
                <div class="relative aspect-[4/5] overflow-hidden rounded-[3rem] mb-6 shadow-[0_20px_50px_rgba(0,0,0,0.3)]">
                  <img
                    src={b.img}
                    alt={b.name}
                    referrerpolicy="no-referrer"
                    class="w-full h-full object-cover transition-transform duration-1000 group-hover:scale-110"
                    loading="lazy"
                    decoding="async"
                  />
                  <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/20 to-transparent" />
                  <div class="absolute bottom-8 left-8 right-8">
                    <span class="text-med-gold text-xs font-bold uppercase tracking-[0.3em] mb-2 block">{b.subtitle}</span>
                    <h3 class="font-serif text-3xl font-bold text-white tracking-tight">{b.name}</h3>
                  </div>
                </div>
                <p class="text-slate-500 text-xs sm:text-sm leading-relaxed font-light mb-4">{b.description}</p>
                <div class="flex flex-wrap gap-2">
                  {b.tags.map(tag => (
                    <span class="text-[10px] uppercase tracking-wider font-bold text-med-blue bg-med-blue/5 px-3 py-1 rounded-full">{tag}</span>
                  ))}
                </div>
              </a>
            </div>
          ))}
        </div>
        <div class="swiper-pagination"></div>
      </div>

      <!-- DESKTOP: Griglia borghi -->
      <div class="hidden md:grid grid-cols-1 grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {borghi.map((b, i) => (
          <a href={b.href} class="group cursor-pointer fade-in-card" style={`animation-delay: ${i * 0.1}s`}>
            <div class="relative aspect-[4/5] overflow-hidden rounded-[3rem] mb-6 shadow-[0_20px_50px_rgba(0,0,0,0.3)]">
              <img
                src={b.img}
                alt={b.name}
                referrerpolicy="no-referrer"
                class="w-full h-full object-cover transition-transform duration-1000 group-hover:scale-110"
                loading="lazy"
                decoding="async"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/20 to-transparent" />
              <div class="absolute bottom-8 left-8 right-8">
                <span class="text-med-gold text-xs font-bold uppercase tracking-[0.3em] mb-2 block">{b.subtitle}</span>
                <h3 class="font-serif text-3xl font-bold text-white tracking-tight">{b.name}</h3>
              </div>
            </div>
            <p class="text-slate-500 text-xs sm:text-sm leading-relaxed font-light mb-4">{b.description}</p>
            <div class="flex flex-wrap gap-2">
              {b.tags.map(tag => (
                <span class="text-[10px] uppercase tracking-wider font-bold text-med-blue bg-med-blue/5 px-3 py-1 rounded-full">{tag}</span>
              ))}
            </div>
          </a>
        ))}
      </div>

      <div class="mt-20">
        <div class="text-center mb-12">
          <p class="text-med-gold text-xs font-bold uppercase tracking-[0.3em] mb-3">Kristallklares Wasser</p>
          <h2 class="font-serif text-4xl font-bold text-slate-900 tracking-tight mb-4">Die Schönsten Strände</h2>
          <div class="w-20 h-1 bg-med-gold mx-auto rounded-full"></div>
        </div>

        <!-- MOBILE: Swiper slider -->
        <div class="swiper swiper-spiagge md:hidden">
          <div class="swiper-wrapper pb-8">
            {topBeaches.map((beach) => (
              <div class="swiper-slide">
                <a href={beach.href} class="bg-med-cream p-6 rounded-[2rem] shadow-sm border border-slate-100 text-center hover:shadow-xl transition-all duration-500 hover:scale-105 block h-full flex flex-col justify-center">
                  <h4 class="font-serif font-bold text-slate-900 mb-1">{beach.name}</h4>
                  <p class="text-med-gold text-[10px] font-bold uppercase tracking-[0.3em]">{beach.location}</p>
                </a>
              </div>
            ))}
          </div>
          <div class="swiper-pagination"></div>
        </div>

        <!-- DESKTOP: Griglia spiagge -->
        <div class="hidden md:grid grid-cols-1 grid-cols-2 md:grid-cols-4 gap-4">
          {topBeaches.map((beach) => (
            <a href={beach.href} class="bg-med-cream p-6 rounded-[2rem] shadow-sm border border-slate-100 text-center hover:shadow-xl transition-all duration-500 hover:scale-105 block">
              <h4 class="font-serif font-bold text-slate-900 mb-1">{beach.name}</h4>
              <p class="text-med-gold text-[10px] font-bold uppercase tracking-[0.3em]">{beach.location}</p>
            </a>
          ))}
        </div>
      </div>

    </div>
  </section>

  <!-- 3 SILOS - Image Cards con Overlay -->
  <section class="bg-charcoal py-16">
    <div class="max-w-7xl mx-auto px-6">
      <div class="text-center mb-14">
        <p class="text-med-gold text-xs uppercase tracking-[0.3em] font-medium mb-3">Nach Region entdecken</p>
        <h2 class="font-serif text-3xl md:text-4xl text-white tracking-tight">Drei Landschaften, unendlich viele Geschichten</h2>
      </div>

      <!-- MOBILE: Swiper slider -->
      <div class="swiper swiper-silos md:hidden">
        <div class="swiper-wrapper pb-12">
          {silos.map(silo => (
            <div class="swiper-slide">
              <a href={silo.href} class="group relative aspect-[4/5] overflow-hidden rounded-[3rem] shadow-[0_20px_50px_rgba(0,0,0,0.3)] block hover:scale-[1.02] transition-transform duration-500">
                <img
                  src={silo.img}
                  alt={silo.title}
                  referrerpolicy="no-referrer"
                  class="w-full h-full object-cover transition-transform duration-1000 group-hover:scale-110"
                  loading="lazy"
                  decoding="async"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/20 to-transparent" />
                <div class="absolute bottom-8 left-8 right-8">
                  <span class="text-med-gold text-xs font-bold uppercase tracking-[0.3em] mb-2 block">{silo.subtitle}</span>
                  <h3 class="font-serif text-3xl font-bold text-white tracking-tight mb-3">{silo.title}</h3>
                  <div class="flex flex-wrap gap-2">
                    {silo.borghi.slice(0, 3).map(b => (
                      <span class="text-[10px] text-white/70 bg-white/10 px-2 py-0.5 rounded-full">{b}</span>
                    ))}
                  </div>
                </div>
              </a>
            </div>
          ))}
        </div>
        <div class="swiper-pagination"></div>
      </div>

      <!-- DESKTOP: Griglia silos -->
      <div class="hidden md:grid grid-cols-1 grid-cols-1 md:grid-cols-3 gap-8">
        {silos.map(silo => (
          <a href={silo.href} class="group relative aspect-[4/5] overflow-hidden rounded-[3rem] shadow-[0_20px_50px_rgba(0,0,0,0.3)] block hover:scale-[1.02] transition-transform duration-500">
            <img
              src={silo.img}
              alt={silo.title}
              referrerpolicy="no-referrer"
              class="w-full h-full object-cover transition-transform duration-1000 group-hover:scale-110"
              loading="lazy"
              decoding="async"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/20 to-transparent" />
            <div class="absolute bottom-8 left-8 right-8">
              <span class="text-med-gold text-xs font-bold uppercase tracking-[0.3em] mb-2 block">{silo.subtitle}</span>
              <h3 class="font-serif text-3xl font-bold text-white tracking-tight mb-3">{silo.title}</h3>
              <div class="flex flex-wrap gap-2">
                {silo.borghi.slice(0, 3).map(b => (
                  <span class="text-[10px] text-white/70 bg-white/10 px-2 py-0.5 rounded-full">{b}</span>
                ))}
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- GRID EDITORIALE -->
  <section class="py-16">
    <div class="max-w-7xl mx-auto px-6">
      <div class="flex items-end justify-between mb-12">
        <div>
          <p class="text-med-gold text-xs uppercase tracking-[0.3em] font-medium mb-3">Praktische Reiseführer</p>
          <h2 class="font-serif text-3xl md:text-4xl text-slate-900 tracking-tight">Alles, was Sie brauchen</h2>
        </div>
      </div>

      <!-- MOBILE: Swiper slider -->
      <div class="swiper swiper-editoriale md:hidden">
        <div class="swiper-wrapper pb-12">
          <div class="swiper-slide">
            <a href={editorial[0].href} class="group bg-med-gold/8 rounded-[2rem] p-8 shadow-sm border-2 border-med-gold/20 hover:shadow-xl transition-all duration-500 flex flex-col md:justify-between md:min-h-72 md:p-10">
              <div>
                <span class="text-[10px] uppercase tracking-[0.3em] text-med-gold font-bold">{editorial[0].label}</span>
                <h3 class="font-serif text-lg md:text-3xl lg:text-4xl text-slate-900 tracking-tight mt-2 md:mt-3 mb-2 md:mb-3 group-hover:text-med-gold transition-colors leading-tight">{editorial[0].title}</h3>
                <p class="text-slate-400 text-sm md:text-base font-light">{editorial[0].subtitle}</p>
              </div>
              <span class="text-xs sm:text-sm font-medium text-med-gold flex items-center gap-1 mt-4 md:mt-8">
                Reiseführer lesen
                <svg class="w-3.5 h-3.5 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
                </svg>
              </span>
            </a>
          </div>
          <div class="swiper-slide">
            <a href={editorial[1].href} class="group bg-med-blue/8 rounded-[2rem] p-8 shadow-sm border-2 border-med-blue/20 hover:shadow-xl transition-all duration-500 hover:scale-[1.02] flex flex-col">
              <span class="text-[10px] uppercase tracking-[0.3em] text-med-blue font-bold">{editorial[1].label}</span>
              <h3 class="font-serif text-xl text-slate-900 tracking-tight mt-2 mb-2 group-hover:text-med-blue transition-colors">{editorial[1].title}</h3>
              <p class="text-slate-400 text-xs sm:text-sm mb-6 font-light flex-grow">{editorial[1].subtitle}</p>
              <span class="text-xs sm:text-sm font-medium text-med-blue flex items-center gap-1">
                Lesen
                <svg class="w-3.5 h-3.5 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
                </svg>
              </span>
            </a>
          </div>
          <div class="swiper-slide">
            <a href={editorial[2].href} class="group bg-med-water/8 rounded-[2rem] p-8 shadow-sm border-2 border-med-water/20 hover:shadow-xl transition-all duration-500 hover:scale-[1.02] flex flex-col">
              <span class="text-[10px] uppercase tracking-[0.3em] text-med-water font-bold">{editorial[2].label}</span>
              <h3 class="font-serif text-xl text-slate-900 tracking-tight mt-2 mb-2 group-hover:text-med-water transition-colors">{editorial[2].title}</h3>
              <p class="text-slate-400 text-xs sm:text-sm mb-6 font-light flex-grow">{editorial[2].subtitle}</p>
              <span class="text-xs sm:text-sm font-medium text-med-water flex items-center gap-1">
                Lesen
                <svg class="w-3.5 h-3.5 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
                </svg>
              </span>
            </a>
          </div>
          <div class="swiper-slide">
            <a href={editorial[3].href} class="group bg-med-terracotta/8 rounded-[2rem] p-8 shadow-sm border-2 border-med-terracotta/20 hover:shadow-xl transition-all duration-500 hover:scale-[1.02] flex flex-col">
              <span class="text-[10px] uppercase tracking-[0.3em] text-med-terracotta font-bold">{editorial[3].label}</span>
              <h3 class="font-serif text-xl text-slate-900 tracking-tight mt-2 mb-2 group-hover:text-med-terracotta transition-colors">{editorial[3].title}</h3>
              <p class="text-slate-400 text-xs sm:text-sm mb-6 font-light flex-grow">{editorial[3].subtitle}</p>
