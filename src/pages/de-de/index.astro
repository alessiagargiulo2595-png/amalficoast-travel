---
import BaseLayout from '../../layouts/BaseLayout.astro';

const lang = 'de-de';

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "TouristDestination",
    "name": "Amalfiküste",
    "alternateName": "Amalfi Coast",
    "description": "UNESCO-Weltkulturerbe, 50 km Klippen an der Tyrrhenischen See in Kampanien, Italien.",
    "url": "https://amalficoast-travel.com/de-de/",
    "geo": { "@type": "GeoCoordinates", "latitude": "40.634", "longitude": "14.602" },
    "containedInPlace": { "@type": "Country", "name": "Italy" }
  }
];

const silos = [
  {
    title: 'Amalfiküste',
    subtitle: '50 km UNESCO-Klippen',
    href: '/de-de/amalfiküste/',
    borghi: ['Positano', 'Amalfi', 'Ravello', 'Praiano', 'Maiori', 'Minori'],
    img: '/images/costiera-hero.webp',
  },
  {
    title: 'Sorrentinische Halbinsel',
    subtitle: 'Das Tor nach Süditalien',
    href: '/de-de/sorrentinische-halbinsel/',
    borghi: ['Sorrento', 'Vico Equense', 'Massa Lubrense', "Sant'Agnello"],
    img: '/images/sorrento-hero.webp',
  },
  {
    title: 'Inseln im Golf',
    subtitle: 'Capri, Ischia, Procida',
    href: '/de-de/inseln/',
    borghi: ['Capri', 'Ischia', 'Procida'],
    img: '/images/capri-hero.webp',
  },
];

const borghi = [
  {
    name: 'Positano',
    subtitle: 'Die lebende Postkarte',
    description: 'Berühmt für die pastelfarbenen Häuser in Kaskaden, Luxusboutiquen und den spektakulären Spiaggia Grande Strand.',
    img: '/images/positano-hero.webp',
    href: '/de-de/amalfiküste/positano/',
    tags: ['Ikonisch', 'Mode', 'Spiaggia Grande'],
  },
  {
    name: 'Amalfi',
    subtitle: 'Die alte Seerepublik',
    description: 'Das historische Herz der Küste mit dem majestätischen Dom Sant\'Andrea, alten Papiermühlen und dem Hauptplatz.',
    img: '/images/amalfi-hero.webp',
    href: '/de-de/amalfiküste/amalfi/',
    tags: ['Geschichte', 'Dom', 'Platz'],
  },
  {
    name: 'Ravello',
    subtitle: 'Die Stadt der Musik',
    description: 'Zwischen Himmel und Meer schwebend, bietet es die spektakulärsten Aussichten von seinen prachtvollen Villen und Gärten.',
    img: '/images/ravello-hero.webp',
    href: '/de-de/amalfiküste/ravello/',
    tags: ['Musik', 'Villa Cimbrone', 'Aussicht'],
  },
  {
    name: 'Maiori',
    subtitle: 'Der längste Strand',
    description: 'Die längste Strandpromenade der Amalfiküste, authentisch und ruhig, mit Überresten einer römischen Villa.',
    img: '/images/maiori-hero.webp',
    href: '/de-de/amalfiküste/maiori/',
    tags: ['Strand', 'Entspannung', 'Authentizität'],
  },
  {
    name: 'Minori',
    subtitle: 'Das kulinarische Herz',
    description: 'Berühmt für Limoncello und authentische lokale Küche, mit den Überresten der römischen Villa mit Blick aufs Meer.',
    img: '/images/minori-hero.webp',
    href: '/de-de/amalfiküste/minori/',
    tags: ['Kulinarik', 'Römische Villa', 'Zitronen'],
  },
  {
    name: 'Vietri sul Mare',
    subtitle: 'Die Keramik-Hauptstadt',
    description: 'Das östliche Tor der Amalfiküste, berühmt für handbemalte Keramiken und lokale Handwerkskunst.',
    img: '/images/vietri-hero.webp',
    href: '/de-de/amalfiküste/vietri-sul-mare/',
    tags: ['Keramik', 'Handwerk', 'Museum'],
  },
];

const topBeaches = [
  { name: 'Spiaggia Grande', location: 'Positano', href: '/de-de/strände/amalfiküste/spiaggia-grande-positano/' },
  { name: 'Spiaggia di Ieranto', location: 'Massa Lubrense', href: '/de-de/sorrentinische-halbinsel/spiaggia-di-ieranto/' },
  { name: 'Marina Piccola', location: 'Capri', href: '/de-de/strände/inseln/marina-piccola-capri/' },
  { name: 'Fiordo di Furore', location: 'Praiano', href: '/de-de/strände/amalfiküste/fiordo-di-furore/' },
];

const reasonsToVisit = [
  {
    title: 'Unvergleichliche Landschaften',
    description: 'Senkrechte Klippen über dem Meer und atemberaubende Ausblicke an jeder Kurve der Strada Statale 163.'
  },
  {
    title: 'Tausendjährige Geschichte',
    description: 'Von den alten Seerepubliken bis zur Pracht der Adelsvillas und mittelalterlichen Klöster.'
  },
  {
    title: 'Authentische Geschmäcke',
    description: 'Von frischer Pasta bis zu herrlichen Zitronen - eine Reise in den echten mediterranen Geschmack.'
  },
  {
    title: 'Einzigartige Erlebnisse',
    description: 'Wanderungen in den Bergen, Bootstouren durch Grotten und Jahrhundert alte Handwerkstraditionen.'
  }
];

const experiences = [
  {
    title: 'Kochkurs',
    href: '/de-de/erlebnisse/kochkurs/',
    img: '/images/cooking-class-hero.webp',
  },
  {
    title: 'Limoncello Tour',
    href: '/de-de/erlebnisse/limoncello-tour/',
    img: '/images/limoncello-mercato-hero.webp',
  },
  {
    title: 'Mozzarella Erlebnis',
    href: '/de-de/erlebnisse/mozzarella-erlebnis/',
    img: '/images/mozzarella-provolone-hero.webp',
  },
  {
    title: 'Sternerestaurants',
    href: '/de-de/erlebnisse/sterne-restaurants/',
    img: '/images/ravello-hero.webp',
  }
];

const blogHighlights = [
  {
    title: 'Smaragdgrotte: Leitfaden zu der Perle von Conca dei Marini',
    category: 'Von der Redaktion',
    href: '/de-de/blog/smaragdgrotte/',
    img: '/images/grotta-smeraldo-hero.webp',
  },
  {
    title: 'Weniger bekannte Pfade: Valle delle Ferriere',
    category: 'Wandern',
    href: '/de-de/blog/weniger-bekannte-pfade/',
    img: '/images/ravello-hero.webp',
  },
  {
    title: 'Cetara und die Colatura: das Gold aus der Tiefe',
    category: 'Kulinarik',
    href: '/de-de/blog/cetara-colatura/',
    img: '/images/maiori-hero.webp',
  },
  {
    title: 'Weine der Amalfiküste',
    category: 'Kulinarik',
    href: '/de-de/blog/weine-amalfiküste/',
    img: '/images/positano-hero.webp',
  }
];
---

<BaseLayout
  title="Reiseführer zur Amalfiküste 2026 - Positano, Amalfi, Ravello"
  description="Kompletter Tourismusführer zur Amalfiküste. Dörfer, Strände, Fähren, Reiserouten und praktische Tipps. UNESCO-Weltkulturerbe in Kampanien, Italien."
  lang={lang}
  schema={schema}
  pageKey="home"
>

  <!-- HERO -->
  <section class="relative min-h-screen sm:min-h-[90vh] md:h-screen flex flex-col items-center justify-center bg-charcoal overflow-hidden pb-12 sm:pb-0 md:pb-24">
    <img src="/images/hero-hp.webp" alt="Amalfiküste von oben" referrerpolicy="no-referrer" class="absolute inset-0 w-full h-full object-cover object-center" loading="eager" fetchpriority="high" decoding="sync" />
    <div class="absolute inset-0 bg-gradient-to-b from-black/60 sm:from-black/55 via-black/40 sm:via-black/30 to-black/70 sm:to-black/65"></div>

    <div class="relative text-center px-6 max-w-4xl mx-auto md:flex md:flex-col md:justify-center">
      <p class="text-med-gold text-xs font-medium uppercase tracking-[0.3em] mb-6">UNESCO-Weltkulturerbe · Kampanien, Italien</p>
      <h1 class="font-serif text-white leading-tight mb-6" style="font-size: clamp(2.8rem, 7vw, 5.5rem); letter-spacing: -0.02em;">
        Die Amalfi<br/>
        <em class="not-italic text-med-gold">Küste</em>
      </h1>
      <p class="text-blue-100 text-lg md:text-xl leading-relaxed max-w-2xl mx-auto mb-10 md:mb-0 font-light">
        Fünfzig Kilometer senkrechte Klippen über der Tyrrhenischen See. Malerische Dörfer, riesige Zitronen,
        farbenfrohe Fähren und ein Italien, das dich immer wieder überrascht.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/de-de/amalfiküste/positano/"
           class="inline-block bg-med-blue text-white font-semibold px-8 py-3.5 rounded-full hover:scale-105 hover:shadow-[0_8px_30px_rgba(0,91,150,0.5)] transition-all duration-300 text-xs sm:text-sm">
          Beginne mit Positano
        </a>
        <a href="/de-de/reiserouten/"
           class="inline-block border-2 border-white/50 text-white font-medium px-8 py-3.5 rounded-full hover:bg-white/10 hover:border-white transition-all duration-300 text-xs sm:text-sm">
          Wähle deine Reiseroute
        </a>
      </div>
    </div>

    <!-- Scroll indicator -->
    <div class="absolute bottom-6 sm:bottom-8 md:bottom-6 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2 text-white/40 z-20">
      <svg class="w-4 h-4 animate-bounce" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
      </svg>
    </div>
  </section>

  <!-- 3 SILOS - TERRITORIES SECTION -->
  <section class="py-16 bg-white">
    <div class="max-w-7xl mx-auto px-6">
      <div class="text-center mb-12">
        <h2 class="font-serif text-4xl md:text-5xl font-bold text-slate-900 mb-4">Drei Regionen, unendliche Geschichten</h2>
        <div class="w-20 h-1 bg-med-gold mx-auto rounded-full"></div>
      </div>

      <!-- MOBILE: Swiper slider -->
      <div class="swiper swiper-silos md:hidden">
        <div class="swiper-wrapper pb-12">
          {silos.map(silo => (
            <div class="swiper-slide">
              <a href={silo.href} class="group relative aspect-[16/9] md:aspect-[4/5] overflow-hidden rounded-[3rem] shadow-none md:shadow-[0_20px_50px_rgba(0,0,0,0.3)] block hover:scale-[1.02] transition-transform duration-500">
                <img
                  src={silo.img}
                  alt={silo.title}
                  referrerpolicy="no-referrer"
                  class="w-full h-full object-cover transition-transform duration-1000 group-hover:scale-110"
                  loading="lazy"
                  decoding="async"
                />
                <div class="absolute inset-0 hidden sm:block bg-gradient-to-t from-black/90 via-black/20 to-transparent" />
                <div class="absolute bottom-8 left-8 right-8">
                  <span class="text-med-gold text-xs font-bold uppercase tracking-[0.3em] mb-2 block">{silo.subtitle}</span>
                  <h3 class="font-serif text-3xl font-bold text-white tracking-tight mb-3">{silo.title}</h3>
                  <div class="flex flex-wrap gap-2">
                    {silo.borghi.slice(0, 3).map(b => (
                      <span class="text-[10px] text-white/70 bg-white/10 px-2 py-0.5 rounded-full">{b}</span>
                    ))}
                  </div>
                </div>
              </a>
            </div>
          ))}
        </div>
        <div class="swiper-pagination"></div>
      </div>

      <!-- DESKTOP: Grid -->
      <div class="hidden md:grid grid-cols-1 md:grid-cols-3 gap-6">
        {silos.map(silo => (
          <a href={silo.href} class="group relative aspect-[4/5] overflow-hidden rounded-[3rem] shadow-none md:shadow-[0_20px_50px_rgba(0,0,0,0.3)] block hover:scale-[1.02] transition-transform duration-500">
            <img
              src={silo.img}
              alt={silo.title}
              referrerpolicy="no-referrer"
              class="w-full h-full object-cover transition-transform duration-1000 group-hover:scale-110"
              loading="lazy"
              decoding="async"
            />
            <div class="absolute inset-0 hidden sm:block bg-gradient-to-t from-black/90 via-black/20 to-transparent" />
            <div class="absolute bottom-8 left-8 right-8">
              <span class="text-med-gold text-xs font-bold uppercase tracking-[0.3em] mb-2 block">{silo.subtitle}</span>
              <h3 class="font-serif text-3xl font-bold text-white tracking-tight mb-3">{silo.title}</h3>
              <div class="flex flex-wrap gap-2">
                {silo.borghi.slice(0, 3).map(b => (
                  <span class="text-[10px] text-white/70 bg-white/10 px-2 py-0.5 rounded-full">{b}</span>
                ))}
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- WISSENSWERT - Did You Know -->
  <section class="bg-charcoal py-12">
    <div class="max-w-7xl mx-auto px-6">
      <p class="text-med-gold text-xs uppercase tracking-[0.3em] font-medium text-center mb-8">Wissenswert</p>

      <!-- MOBILE: Swiper slider -->
      <div class="swiper swiper-curiosita md:hidden">
        <div class="swiper-wrapper pb-12">
          <div class="swiper-slide">
            <div class="group bg-white/5 p-8 rounded-[2rem] border border-white/10 hover:bg-white/10 transition-all duration-300 h-full flex flex-col">
              <div class="w-14 h-14 rounded-2xl bg-med-gold/10 text-med-gold flex items-center justify-center mb-6 group-hover:scale-110 transition-transform flex-shrink-0">
                <svg class="w-7 h-7" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 6.75V15m6-6v8.25m.503-10.498 4.875 2.812M6.497 9.252 1.622 12.064m19.88 0-4.875 2.812M1.622 12.064l4.875 2.812m0 0 4.498 2.598a.75.75 0 0 0 .75 0l4.498-2.598m-9.746 0V17.25"/></svg>
              </div>
              <div class="font-serif text-5xl font-bold text-white mb-3 tracking-tight">50 km</div>
              <p class="text-white/70 font-medium mb-2">Küstenlänge</p>
              <p class="text-white/50 text-xs sm:text-sm leading-relaxed font-light">Von Positano bis Vietri sul Mare, 1997 zum UNESCO-Weltkulturerbe erklärt.</p>
            </div>
          </div>
          <div class="swiper-slide">
            <div class="group bg-white/5 p-8 rounded-[2rem] border border-white/10 hover:bg-white/10 transition-all duration-300 h-full flex flex-col">
              <div class="w-14 h-14 rounded-2xl bg-med-gold/10 text-med-gold flex items-center justify-center mb-6 group-hover:scale-110 transition-transform flex-shrink-0">
                <svg class="w-7 h-7" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 21a9.004 9.004 0 0 0 8.716-6.747M12 21a9.004 9.004 0 0 1-8.716-6.747M12 21c2.485 0 4.5-4.03 4.5-9S14.485 3 12 3m0 18c-2.485 0-4.5-4.03-4.5-9S9.515 3 12 3m0 0a8.997 8.997 0 0 1 7.843 4.582M12 3a8.997 8.997 0 0 0-7.843 4.582m15.686 0A11.953 11.953 0 0 1 12 10.5c-2.998 0-5.74-1.1-7.843-2.918m15.686 0A8.959 8.959 0 0 1 21 12c0 .778-.099 1.533-.284 2.253"/></svg>
              </div>
              <div class="font-serif text-5xl font-bold text-white mb-3 tracking-tight">IX Jh.</div>
              <p class="text-white/70 font-medium mb-2">Gründung von Amalfi</p>
              <p class="text-white/50 text-xs sm:text-sm leading-relaxed font-light">Erste Seemacht Europas, mit Handelsrouten bis nach Konstantinopel.</p>
            </div>
          </div>
          <div class="swiper-slide">
            <div class="group bg-white/5 p-8 rounded-[2rem] border border-white/10 hover:bg-white/10 transition-all duration-300 h-full flex flex-col">
              <div class="w-14 h-14 rounded-2xl bg-med-gold/10 text-med-gold flex items-center justify-center mb-6 group-hover:scale-110 transition-transform flex-shrink-0">
                <svg class="w-7 h-7" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z"/><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1 1 15 0Z"/></svg>
              </div>
              <div class="font-serif text-5xl font-bold text-white mb-3 tracking-tight">350 m</div>
              <p class="text-white/70 font-medium mb-2">Höhe von Ravello</p>
              <p class="text-white/50 text-xs sm:text-sm leading-relaxed font-light">Wagner schrieb hier Parsifal. Gore Vidal lebte dreißig Jahre lang in Ravello.</p>
            </div>
          </div>
        </div>
        <div class="swiper-pagination"></div>
      </div>

      <!-- DESKTOP: Griglia curiosità -->
      <div class="hidden md:grid grid-cols-1 grid-cols-1 md:grid-cols-3 gap-8">
        <div class="group bg-white/5 p-8 rounded-[2rem] border border-white/10 hover:bg-white/10 transition-all duration-300">
          <div class="w-14 h-14 rounded-2xl bg-med-gold/10 text-med-gold flex items-center justify-center mb-6 group-hover:scale-110 transition-transform">
            <svg class="w-7 h-7" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 6.75V15m6-6v8.25m.503-10.498 4.875 2.812M6.497 9.252 1.622 12.064m19.88 0-4.875 2.812M1.622 12.064l4.875 2.812m0 0 4.498 2.598a.75.75 0 0 0 .75 0l4.498-2.598m-9.746 0V17.25"/></svg>
          </div>
          <div class="font-serif text-5xl font-bold text-white mb-3 tracking-tight">50 km</div>
          <p class="text-white/70 font-medium mb-2">Küstenlänge</p>
          <p class="text-white/50 text-xs sm:text-sm leading-relaxed font-light">Von Positano bis Vietri sul Mare, 1997 zum UNESCO-Weltkulturerbe erklärt.</p>
        </div>
        <div class="group bg-white/5 p-8 rounded-[2rem] border border-white/10 hover:bg-white/10 transition-all duration-300">
          <div class="w-14 h-14 rounded-2xl bg-med-gold/10 text-med-gold flex items-center justify-center mb-6 group-hover:scale-110 transition-transform">
            <svg class="w-7 h-7" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 21a9.004 9.004 0 0 0 8.716-6.747M12 21a9.004 9.004 0 0 1-8.716-6.747M12 21c2.485 0 4.5-4.03 4.5-9S14.485 3 12 3m0 18c-2.485 0-4.5-4.03-4.5-9S9.515 3 12 3m0 0a8.997 8.997 0 0 1 7.843 4.582M12 3a8.997 8.997 0 0 0-7.843 4.582m15.686 0A11.953 11.953 0 0 1 12 10.5c-2.998 0-5.74-1.1-7.843-2.918m15.686 0A8.959 8.959 0 0 1 21 12c0 .778-.099 1.533-.284 2.253"/></svg>
          </div>
          <div class="font-serif text-5xl font-bold text-white mb-3 tracking-tight">IX Jh.</div>
          <p class="text-white/70 font-medium mb-2">Gründung von Amalfi</p>
          <p class="text-white/50 text-xs sm:text-sm leading-relaxed font-light">Erste Seemacht Europas, mit Handelsrouten bis nach Konstantinopel.</p>
        </div>
        <div class="group bg-white/5 p-8 rounded-[2rem] border border-white/10 hover:bg-white/10 transition-all duration-300">
          <div class="w-14 h-14 rounded-2xl bg-med-gold/10 text-med-gold flex items-center justify-center mb-6 group-hover:scale-110 transition-transform">
            <svg class="w-7 h-7" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z"/><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1 1 15 0Z"/></svg>
          </div>
          <div class="font-serif text-5xl font-bold text-white mb-3 tracking-tight">350 m</div>
          <p class="text-white/70 font-medium mb-2">Höhe von Ravello</p>
          <p class="text-white/50 text-xs sm:text-sm leading-relaxed font-light">Wagner schrieb hier Parsifal. Gore Vidal lebte dreißig Jahre lang in Ravello.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- WARUM DIE AMALFIKÜSTE BESUCHEN -->
  <section class="py-16 bg-white">
    <div class="max-w-7xl mx-auto px-6">
      <div class="text-center mb-12">
        <h2 class="font-serif text-4xl md:text-5xl font-bold text-slate-900 mb-6">Warum die Amalfiküste besuchen</h2>
        <div class="w-20 h-1 bg-med-gold mx-auto rounded-full"></div>
      </div>
      <div class="grid grid-cols-2 md:grid-cols-2 lg:grid-cols-4 gap-8">
        {reasonsToVisit.map((reason, i) => (
          <div class="text-center border-2 border-med-gold rounded-2xl p-8" style={`animation: fadeIn 0.8s ease-in-out ${i * 0.1}s both`}>
            <h3 class="text-xl font-serif font-bold text-slate-900 mb-4">{reason.title}</h3>
            <p class="text-slate-600 text-sm leading-relaxed">{reason.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ORTE - VILLAGES -->
  <section id="borghi" class="py-16 bg-med-cream">
    <div class="max-w-7xl mx-auto px-6">
      <div class="flex flex-col md:flex-row justify-between items-end mb-12 gap-6">
        <div class="max-w-2xl">
          <p class="text-med-gold text-xs font-bold uppercase tracking-[0.3em] mb-3">Erkunde die Küste</p>
          <h2 class="font-serif text-4xl md:text-5xl font-bold text-slate-900 tracking-tight mb-4">Die verzauberten Orte</h2>
          <p class="text-slate-500 text-lg font-light">Erkunde die Perlen der Küste, jedes mit seiner eigenen Seele und hundertjährigen Traditionen.</p>
        </div>
        <a href="/de-de/amalfiküste/" class="group flex items-center gap-2 text-med-blue font-semibold hover:text-med-gold transition-colors flex-shrink-0">
          Alle Ziele
          <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
        </a>
      </div>

      <!-- MOBILE: Swiper slider -->
      <div class="swiper swiper-borghi md:hidden">
        <div class="swiper-wrapper pb-12">
          {borghi.map((b) => (
            <div class="swiper-slide">
