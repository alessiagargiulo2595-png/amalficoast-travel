---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import CorrelationSlider from '../../../../components/CorrelationSlider.astro';
import Breadcrumbs from '../../../../components/Breadcrumbs.astro';

const lang = 'de-de';

const breadcrumbs = [
  { name: 'Startseite', url: '/de-de/' },
  { name: 'Sorrentinische Halbinsel', url: '/de-de/sorrentinische-halbinsel/' },
  { name: 'Meta', url: '/de-de/sorrentinische-halbinsel/meta/' },
];

const touristAttractionSchema = {
  "@context": "https://schema.org",
  "@type": "TouristAttraction",
  "name": "Meta di Sorrento",
  "description": "Meta di Sorrento ist ein authentisches Dorf auf der Sorrentinischen Halbinsel, bekannt für den Strand von Alimuri, die Basilika Madonna del Lauro, die historischen Schiffswerften und eine lokale Atmosphäre fernab vom Massentourismus.",
  "url": "https://amalficoast-travel.com/de-de/sorrentinische-halbinsel/meta/",
  "touristType": ["Strand", "Kultur", "Authentizität", "Familien"],
  "address": { "@type": "PostalAddress", "addressLocality": "Meta", "addressRegion": "Napoli", "addressCountry": "IT", "postalCode": "80062" },
  "geo": { "@type": "GeoCoordinates", "latitude": 40.6412, "longitude": 14.4097 }
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Wie kommt man nach Meta di Sorrento?",
      "acceptedAnswer": { "@type": "Answer", "text": "Mit dem Zug: Die Circumvesuviana hält in Meta (Haltestelle Meta, eine Station vor Sorrento). Von Neapel ca. 65 Minuten. Mit dem Auto: SS145 Sorrentina. Meta liegt nur 3 km von Sorrento entfernt und ist auch zu Fuß in 30 Minuten entlang des Corso Italia erreichbar." }
    },
    {
      "@type": "Question",
      "name": "Hat Meta di Sorrento Strände?",
      "acceptedAnswer": { "@type": "Answer", "text": "Ja, der Strand von Alimuri ist der größte und bekannteste: ein Streifen aus dunklem Sand, erreichbar per Aufzug oder Treppe von der Klippe. Es gibt auch den Strand der Marinai, kleiner und ruhiger. Beide haben ausgestattete Strandbäder." }
    },
    {
      "@type": "Question",
      "name": "Ist Meta besser als Sorrento als Unterkunftsort?",
      "acceptedAnswer": { "@type": "Answer", "text": "Für alle, die niedrigere Preise und eine weniger touristische Atmosphäre suchen, ja. Hotels und B&Bs in Meta kosten 20-30% weniger als in Sorrento, und die Circumvesuviana bringt dich überall hin. Abends ist es auch ruhiger." }
    },
    {
      "@type": "Question",
      "name": "Was kann man in Meta di Sorrento sehen?",
      "acceptedAnswer": { "@type": "Answer", "text": "Die Basilika Madonna del Lauro (mit der Wunderstatue und den Fresken), die Altstadt mit den Adelspalästen, der Strand von Alimuri, das Schifffahrtsmuseum (historische Werften). Von Meta aus beginnt auch der Wanderweg über die Colli di San Pietro nach Positano: eine spektakuläre Alternative zur SS163." }
    },
    {
      "@type": "Question",
      "name": "Warum ist Meta für seine Seefahrtstradition bekannt?",
      "acceptedAnswer": { "@type": "Answer", "text": "Meta war das wichtigste Schiffbau-Zentrum der Sorrentinischen Halbinsel. Die Werften von Meta bauten Segelschiffe und Brigantinen, die im Mittelmeer und im Atlantik fuhren. Die maritime Tradition ist noch heute in den Palästen der Kapitäne und im Schifffahrtsmuseum sichtbar." }
    }
  ]
};

const schemas = [touristAttractionSchema, faqSchema];

const fastFacts = [
  { dt: 'Lage', dd: 'Sorrentinische Halbinsel, NA' },
  { dt: 'Höhe', dd: '~100 m ü. NN' },
  { dt: 'Einwohner', dd: '~8.000' },
  { dt: 'Von Sorrent', dd: '3 km / 5 Min.' },
  { dt: 'Von Neapel', dd: '65 Min. (Circumvesuviana)' },
  { dt: 'Strand', dd: 'Alimuri (dunkler Sand)' },
  { dt: 'Spezialitäten', dd: 'Limoncello, Fisch, Pasta' },
  { dt: 'Beste Reisezeit', dd: 'Apr.–Okt.' },
  { dt: 'Ideal für', dd: 'Günstige Basis, Familien' },
];

const tips = [
  'Meta ist die perfekte und günstigere Basis als Sorrent: dieselbe Circumvesuviana-Haltestelle, Hotels 20-30% günstiger.',
  'Der Strand von Alimuri ist mit dem Aufzug von der Klippe erreichbar – meide die Treppe mit Kinderwagen oder kleinen Kindern.',
  'Das hausgemachte Eis aus Meta ist in der Region berühmt: Suche die Gelaterie im Ortskern entlang der Via Municipio.',
  'Von Meta startet der Wanderweg über die Colli di San Pietro nach Positano: ein Panorama-Trekking als Alternative zur SS163.',
];
---

<BaseLayout
  title="Meta di Sorrento 2026: Strand Alimuri, Basilika del Lauro und historische Werften"
  description="Reiseführer zu Meta di Sorrento: der Strand von Alimuri, die Basilika Madonna del Lauro, die Seefahrtstradition. Günstige und authentische Basis für die Sorrentinische Halbinsel."
  lang={lang}
  breadcrumbs={breadcrumbs}
  schema={schemas}
  pageKey="meta"
>

  <!-- Hero -->
  <section class="relative h-[75vh] sm:h-[90vh] flex items-center bg-charcoal overflow-hidden">
    <img src="/images/meta-hero.webp" alt="Meta di Sorrento, Sorrentinische Halbinsel" class="absolute inset-0 w-full h-full object-cover" loading="eager" fetchpriority="high" decoding="sync" referrerpolicy="no-referrer"/>
    <div class="absolute inset-0 bg-gradient-to-b from-black/10 via-black/40 to-black/80 z-10"></div>
    <div class="relative z-20 max-w-editorial mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <p class="text-med-gold text-xs sm:text-sm font-medium uppercase tracking-[0.3em] mb-3">Sorrentinische Halbinsel – Land der Seefahrer</p>
        <h1 class="font-serif text-display text-white mb-4">Meta di Sorrento</h1>
        <p class="text-xl text-white/80 leading-relaxed max-w-2xl">
          Dorf der Kapitäne und historischen Werften. Der Strand von Alimuri, die Basilika del Lauro und eine authentische Atmosphäre nur 3 km von Sorrent.
        </p>
        <div class="flex flex-wrap gap-3 mt-8">
          <a href="#fast-facts" class="px-5 py-2.5 bg-med-gold text-white text-xs sm:text-sm font-semibold rounded-full hover:scale-105 hover:shadow-[0_8px_25px_rgba(212,175,55,0.4)] transition-all duration-300">Fast Facts</a>
          <a href="#anreise" class="px-5 py-2.5 bg-white/10 backdrop-blur text-white text-xs sm:text-sm font-medium rounded-full border border-white/20 hover:bg-white/20 transition-colors">Anreise</a>
          <a href="#faq" class="px-5 py-2.5 bg-white/10 backdrop-blur text-white text-xs sm:text-sm font-medium rounded-full border border-white/20 hover:bg-white/20 transition-colors">FAQ</a>
        </div>
      </div>
    </div>
    <Breadcrumbs breadcrumbs={breadcrumbs} />
  </section>

  <section class="max-w-editorial mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="grid lg:grid-cols-[1fr_320px] gap-12">

      <div class="space-y-16">

        <div class="prose-editorial">
          <p class="text-xl leading-relaxed text-charcoal">
            Meta di Sorrento ist das Dorf, das Touristen in der Circumvesuviana durchfahren, ohne auszusteigen – eine Haltestelle vor <a href="/de-de/sorrentinische-halbinsel/sorrent/" class="text-med-blue hover:underline">Sorrent</a>. Dabei hat Meta alles, was man für einen perfekten Urlaub braucht: einen Sandstrand, eine beeindruckende Basilika, eine ruhige Altstadt und günstigere Preise als das benachbarte Sorrent.
          </p>
          <p class="mt-4 text-slate-600 leading-relaxed">
            Die Geschichte von Meta ist im Meer geschrieben: Jahrhundertelang war es das wichtigste Schiffbauzentrum der Sorrentinischen Halbinsel. Die Werften von Meta bauten Segelschiffe, die im Mittelmeer und im Atlantik fuhren. Noch heute zeugen die Paläste der Kapitäne in der Altstadt vom Reichtum, den der Seehandel brachte.
          </p>
        </div>

        <!-- Wusstest du das? -->
        <div class="bg-slate-900 border border-white/10 rounded-[3rem] p-8">
          <p class="text-[10px] uppercase tracking-[0.3em] text-med-gold font-medium mb-4">Wusstest du das?</p>
          <div class="grid sm:grid-cols-3 gap-6">
            <div class="text-center">
              <p class="font-serif text-5xl font-bold text-med-gold">3 km</p>
              <p class="text-white/60 text-xs italic mt-1">von Sorrent, zu Fuß erreichbar</p>
            </div>
            <div class="text-center">
              <p class="font-serif text-5xl font-bold text-med-gold">18. Jh.</p>
              <p class="text-white/60 text-xs italic mt-1">Blütezeit der Werften von Meta</p>
            </div>
            <div class="text-center">
              <p class="font-serif text-5xl font-bold text-med-gold">-30%</p>
              <p class="text-white/60 text-xs italic mt-1">Hotelkosten gegenüber Sorrent</p>
            </div>
          </div>
        </div>

        <!-- Sehenswürdigkeiten -->
        <div>
          <h2 class="font-serif text-3xl font-semibold text-slate-900 mb-8">Sehenswürdigkeiten in Meta</h2>
          <div class="space-y-8">
            {[
              { n: 1, title: 'Basilika Madonna del Lauro', text: 'Die bedeutendste Kirche Metas, geweiht der auf der ganzen Halbinsel verehrten Madonna del Lauro. Barockes Inneres mit Fresken, polychromem Marmor und der Wunderstatue der Jungfrau. Die Fassade dominiert den Hauptplatz des Ortes.' },
              { n: 2, title: 'Strand von Alimuri', text: 'Der Hauptstrand von Meta: ein Streifen aus dunklem Vulkansand unterhalb der Klippe, erreichbar per Aufzug oder Treppe. Ausgestattete Strandbäder und freier Abschnitt. Klares Wasser und Blick auf die Küste. Weniger überfüllt als die Strände von Sorrent.' },
              { n: 3, title: 'Altstadt und Kapitänspaläste', text: 'Die Via Municipio und die umliegenden Gassen bewahren die Adelspaläste der Kapitäne aus dem 18.–19. Jahrhundert. Portale aus Piperno-Stein, Innenhöfe und schmiedeeiserne Balkone erzählen vom Reichtum der Seefahrttradition Metas.' },
              { n: 4, title: 'Schifffahrtsmuseum', text: 'Das kleine Museum, das die Werft-Tradition von Meta erzählt: Segelschiffmodelle, Navigationsinstrumente, Seekarten und historische Fotos der Werften. Eintritt kostenlos oder nach freiwilliger Spende.' },
              { n: 5, title: 'Wanderweg Colli di San Pietro', text: 'Ein Panorama-Trekking, der in Meta beginnt und über die Hügel bis nach Positano führt. Etwa 4 Stunden Wanderung durch Zitronenhaine, Olivenhaine und mit Blick auf den Golf. Spektakuläre Alternative zur SS163.' },
            ].map(({ n, title, text }) => (
              <div class="grid sm:grid-cols-[auto_1fr] gap-4">
                <div class="w-14 h-14 rounded-[1rem] bg-med-gold/10 flex items-center justify-center flex-shrink-0 text-med-gold font-serif font-bold text-xl">{n}</div>
                <div>
                  <h3 class="font-semibold text-charcoal text-lg mb-1">{title}</h3>
                  <p class="text-slate-600 leading-relaxed">{text}</p>
                </div>
              </div>
            ))}
          </div>
        </div>

        <!-- Anreise -->
        <div id="anreise">
          <h2 class="font-serif text-3xl font-semibold text-slate-900 mb-6">Anreise nach Meta</h2>
          <div class="space-y-6">
            <div class="bg-white rounded-[3rem] p-8 border border-slate-100 hover:shadow-xl transition-all duration-300">
              <h3 class="font-semibold text-charcoal mb-3">Circumvesuviana</h3>
              <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">Haltestelle „Meta" auf der Linie Neapel–Sorrent. Von Neapel Centrale ca. 65 Minuten (~3,90 Euro). Eine Haltestelle vor Sorrent. Takt: alle 30–40 Minuten.</p>
            </div>
            <div class="bg-white rounded-[3rem] p-8 border border-slate-100 hover:shadow-xl transition-all duration-300">
              <h3 class="font-semibold text-charcoal mb-3">Von Sorrent</h3>
              <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">Zu Fuß entlang des Corso Italia in ca. 30 Minuten. Mit der Circumvesuviana 3 Minuten. Mit dem Auto 5 Minuten auf der SS145. Meta grenzt praktisch direkt an Sorrent.</p>
            </div>
          </div>
        </div>

        <!-- Lokaler Tipp -->
        <div class="relative overflow-hidden rounded-[3rem] bg-med-blue p-10 md:p-14 text-white shadow-2xl">
          <div class="relative z-10 flex flex-col md:flex-row items-start md:items-center gap-8">
            <div class="w-20 h-20 rounded-2xl bg-white/10 flex items-center justify-center flex-shrink-0 border border-white/20"><svg class="w-10 h-10 text-med-gold" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 3v2.25m6.364.386-1.591 1.591M21 12h-2.25m-.386 6.364-1.591-1.591M12 18.75V21m-4.773-4.227-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0Z"/></svg></div>
            <div>
              <p class="text-med-gold text-xs font-bold uppercase tracking-[0.3em] mb-2">Lokaler Tipp</p>
              <h3 class="font-serif text-2xl font-bold text-white mb-3 tracking-tight">Die geheime Basis für die Halbinsel</h3>
              <p class="text-white/70 leading-relaxed">Übernachte in Meta statt in Sorrent: dieselbe Circumvesuviana, dieselben Verbindungen nach Capri, an die Amalfiküste und nach Neapel – aber Hotels und Restaurants kosten 20–30% weniger. Abends ist das Zentrum von Meta ruhig und authentisch.</p>
            </div>
          </div>
          <div class="absolute bottom-0 left-0 translate-y-1/2 -translate-x-1/2 w-80 h-80 bg-med-gold/10 rounded-full blur-3xl pointer-events-none"></div>
        </div>

        <!-- FAQ -->
        <div id="faq">
          <h2 class="font-serif text-3xl font-semibold text-slate-900 mb-8">Häufige Fragen zu Meta</h2>
          <div class="space-y-4">
            {faqSchema.mainEntity.map((q) => (
              <details class="group border border-slate-200 rounded-2xl overflow-hidden">
                <summary class="flex items-center justify-between px-6 py-4 cursor-pointer select-none text-charcoal font-medium hover:bg-slate-50 transition-colors">
                  {q.name}
                  <svg class="w-4 h-4 text-slate-400 group-open:rotate-180 transition-transform flex-shrink-0 ml-3" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
                </summary>
                <div class="px-6 pb-5 text-slate-600 leading-relaxed text-xs sm:text-sm border-t border-slate-100 pt-4">
                  {q.acceptedAnswer.text}
                </div>
              </details>
            ))}
          </div>
        </div>

      </div>

      <aside class="space-y-6 lg:sticky lg:top-24 self-start">
        <div id="fast-facts" class="bg-slate-900 text-white rounded-[3rem] p-6">
          <p class="text-[10px] uppercase tracking-[0.3em] text-med-gold font-medium mb-4">Fast Facts – Meta</p>
          <dl class="space-y-3">
            {fastFacts.map(({ dt, dd }, i) => (
              <>
                <div class="flex justify-between items-start gap-3">
                  <dt class="text-white/40 text-xs sm:text-sm font-light flex-shrink-0">{dt}</dt>
                  <dd class="text-white font-medium text-xs sm:text-sm text-right">{dd}</dd>
                </div>
                {i < fastFacts.length - 1 && <div class="border-t border-white/5"></div>}
              </>
            ))}
          </dl>
        </div>

        <div class="bg-med-cream border border-med-gold/30 rounded-[2rem] p-6">
          <p class="text-[10px] uppercase tracking-[0.3em] text-med-gold font-medium mb-3">Insider-Tipps</p>
          <ul class="space-y-3">
            {tips.map(tip => (
              <li class="flex items-start gap-2 text-xs sm:text-sm text-charcoal">
                <span class="w-1.5 h-1.5 rounded-full bg-med-gold mt-1.5 flex-shrink-0"></span>
                <span>{tip}</span>
              </li>
            ))}
          </ul>
        </div>

        <div class="bg-white border border-slate-100 rounded-[2rem] p-6 shadow-sm">
          <p class="text-[10px] uppercase tracking-[0.3em] text-slate-400 font-medium mb-3">Sorrentinische Halbinsel</p>
          <nav class="space-y-1">
            {[
              { href: '/de-de/sorrentinische-halbinsel/sorrent/', label: 'Sorrent' },
              { href: '/de-de/sorrentinische-halbinsel/vico-equense/', label: 'Vico Equense' },
              { href: '/de-de/sorrentinische-halbinsel/massa-lubrense/', label: 'Massa Lubrense' },
              { href: '/de-de/sorrentinische-halbinsel/sant-agnello/', label: "Sant'Agnello" },
            ].map(({ href, label }) => (
              <a href={href} class="flex items-center gap-2 px-3 py-2 rounded-xl text-xs sm:text-sm text-charcoal hover:bg-med-blue/5 hover:text-med-blue transition-colors">
                <span class="w-1.5 h-1.5 rounded-full bg-med-blue/30"></span> {label}
              </a>
            ))}
          </nav>
        </div>
      </aside>

    </div>
  </section>

  <CorrelationSlider
    heading="Auch entdecken"
    items={[
      { name: 'Sorrent',         href: '/de-de/sorrentinische-halbinsel/sorrent/',       tag: 'Hub & Limoncello', desc: 'Piazza Tasso, das Kreuzgangskloster und der Ausgangspunkt für Capri.' },
      { name: 'Vico Equense',    href: '/de-de/sorrentinische-halbinsel/vico-equense/',   tag: 'Pizza al Metro',   desc: 'Die Pizza al Metro bei Da Gigino und das Castello Giusso.' },
      { name: 'Massa Lubrense',  href: '/de-de/sorrentinische-halbinsel/massa-lubrense/', tag: 'Natur & Küche',    desc: 'Punta Campanella und die Spaghetti alla Nerano.' },
      { name: 'Positano',        href: '/de-de/amalfikueste/positano/',                   tag: 'Fashion & Aussicht', desc: 'Die farbenprächtigen Häuser direkt über dem Meer der Amalfiküste.' },
      { name: 'Capri',           href: '/de-de/inseln/capri/',                            tag: 'Die Ikone',        desc: 'Blaue Grotte, Faraglioni und die Piazzetta.' },
    ]}
    lang="de-de"
  />

</BaseLayout>
