---
import BaseLayout from '../../../../layouts/BaseLayout.astro';

const lang = 'de-de';

const breadcrumbs = [
  { name: 'Startseite', url: '/de-de/' },
  { name: 'Planung', url: '/de-de/planung/' },
  { name: 'SITA-Bus', url: '/de-de/ratgeber/sita-bus/' },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Wie funktioniert der SITA-Bus an der Amalfiküste?",
      "acceptedAnswer": { "@type": "Answer", "text": "Der SITA-Bus (heute SITA Sud, betrieben von EAV) fährt auf der SS163 zwischen Sorrent und Salerno und hält in Positano, Praiano, Amalfi, Maiori und Minori. Tickets müssen vor dem Einsteigen gekauft werden - im Tabakgeschäft oder Zeitungskiosk. Preis: ca. €2,50-4 pro Fahrt; die Tarife wurden zum 1. Oktober 2026 angepasst, prüfen Sie den aktuellen Preis beim Kauf." }
    },
    {
      "@type": "Question",
      "name": "Wie lange dauert der Bus von Sorrent nach Amalfi?",
      "acceptedAnswer": { "@type": "Answer", "text": "Der offizielle Fahrplan ab 14. September 2026 sieht je nach Streckenvariante 75 bis 100 Minuten vor. Im Sommer (Juli-August) kann es wegen des Verkehrs auf der SS163 bis zu 2-2,5 Stunden dauern. Von Amalfi nach Positano sind es 40 Minuten bis zur Haltestelle Sponda und 50 bis Chiesa Nuova." }
    },
    {
      "@type": "Question",
      "name": "Kann ich großes Gepäck im SITA-Bus mitnehmen?",
      "acceptedAnswer": { "@type": "Answer", "text": "Die SITA-Busse auf der SS163 sind klein. Im Sommer sind sie überfüllt. Große Koffer sind schwierig zu handhaben: Verwenden Sie eine kompakte Reisetasche oder einen Rucksack." }
    },
    {
      "@type": "Question",
      "name": "Wo sind die SITA-Bus Haltestellen an der Amalfiküste?",
      "acceptedAnswer": { "@type": "Answer", "text": "Die wichtigsten Haltestellen auf der SS163 sind: Sorrent (Circumvesuviana), Meta, Positano (Chiesa Nuova und Sponda), Praiano, Furore, Amalfi, Atrani, Minori, Maiori, Cetara und Vietri sul Mare. Der Bus nach Ravello fährt separat ab Amalfi (Linie 5020)." }
    },
    {
      "@type": "Question",
      "name": "Wann fahren der erste und der letzte SITA-Bus zwischen Sorrent und Amalfi?",
      "acceptedAnswer": { "@type": "Answer", "text": "Laut Fahrplan ab 14. September 2026 fährt der erste Bus von Sorrent nach Amalfi montags bis samstags um 06:30 (sonn- und feiertags um 08:30), der letzte um 19:50 (sonn- und feiertags um 19:15). Von Amalfi nach Sorrent fährt der erste Bus täglich um 06:20, der letzte um 21:30 (sonn- und feiertags um 21:00). Prüfen Sie vor der Fahrt sitasudtrasporti.it, besonders an Feiertagen." }
    }
  ]
};

