---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../../components/Breadcrumbs.astro';

const lang = 'de-de';

const breadcrumbs = [
  { name: 'Startseite', url: '/de-de/' },
  { name: 'Planung', url: '/de-de/planung/' },
  { name: 'Fähren & Tragflügelboote', url: '/de-de/ratgeber/faehren/' },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Was ist der Unterschied zwischen Fähre und Tragflügelboot an der Amalfiküste?",
      "acceptedAnswer": { "@type": "Answer", "text": "Die Fähre (traghetto) ist langsamer (50–90 Min. Neapel–Capri), aber günstiger und stabiler. Das Tragflügelboot (aliscafo) ist schneller (40–50 Min.), teurer und fährt bei rauer See nicht. Im Sommer empfiehlt sich das Tragflügelboot; bei schlechtem Wetter ist die Fähre zuverlässiger." }
    },
    {
      "@type": "Question",
      "name": "Kann ich Fähren online buchen?",
      "acceptedAnswer": { "@type": "Answer", "text": "Ja, fast alle Reedereien bieten Online-Buchung an: nlg.it, alilauro.it, snav.it, travelmar.it, caremar.it. Im Sommer (Juli–August) empfiehlt es sich, mindestens 1–2 Tage im Voraus zu buchen." }
    },
    {
      "@type": "Question",
      "name": "Was kostet die Fähre von Neapel nach Capri?",
      "acceptedAnswer": { "@type": "Answer", "text": "Fähre Neapel–Capri (Caremar/SNAV): ~€13–15 einfache Fahrt. Tragflügelboot (NLG/Alilauro): ~€20–23 einfache Fahrt. Ab Sorrent: ~€18–22 mit Tragflügelboot." }
    },
    {
      "@type": "Question",
      "name": "Fahren Fähren auch im Winter?",
      "acceptedAnswer": { "@type": "Answer", "text": "Ja, aber mit reduzierter Häufigkeit. Neapel–Capri: mindestens 4–5 Fahrten täglich das ganze Jahr. Saisonale Verbindungen (Positano, Amalfi, Salerno) verkehren von April bis Oktober." }
    }
  ]
};

const routes = [
  { from: 'Neapel Beverello', to: 'Capri', time: '40–50 Min. (Tragflügelboot) / 75 Min. (Fähre)', price: '€20–23 / €13–15', companies: 'NLG, Alilauro, SNAV, Caremar', seasonal: false },
  { from: 'Neapel Beverello', to: 'Ischia (Casamicciola/Porto)', time: '50 Min. (Tragflügelboot) / 75 Min. (Fähre)', price: '€20–24 / €12–14', companies: 'Alilauro, SNAV, Caremar, Medmar', seasonal: false },
  { from: 'Neapel Beverello', to: 'Procida', time: '35 Min. (Tragflügelboot)', price: '€15–18', companies: 'Alilauro, SNAV', seasonal: false },
  { from: 'Sorrent', to: 'Capri', time: '20–25 Min. (Tragflügelboot)', price: '€18–22', companies: 'NLG, Alilauro', seasonal: false },
  { from: 'Pozzuoli', to: 'Ischia / Procida', time: '35 Min. / 15 Min. (Fähre)', price: '€10–13 / €7–9', companies: 'Medmar, Caremar', seasonal: false },
  { from: 'Salerno', to: 'Amalfi / Positano / Capri', time: '45 Min. / 65 Min. / 100 Min.', price: '€8–12 / €12–16 / €18–22', companies: 'Travelmar, NLG', seasonal: true },
  { from: 'Neapel Beverello', to: 'Positano / Amalfi', time: '75 Min. / 90 Min.', price: '€15–20 / €18–22', companies: 'NLG, Alilauro', seasonal: true },
];
---

<BaseLayout
  title="Fähren & Tragflügelboote Amalfiküste 2026 | Fahrpläne und Preise"
  description="Vollständiger Leitfaden zu Fähren und Tragflügelbooten an der Amalfiküste: Neapel–Capri, Neapel–Ischia, Sorrent–Capri, Salerno–Amalfi–Positano. Reedereien, Fahrpläne und aktuelle Preise."
  lang={lang}
  breadcrumbs={breadcrumbs}
  schema={[faqSchema]}
 pageKey="faehren">

  <section class="relative h-[75vh] sm:h-[90vh] flex items-center bg-charcoal overflow-hidden">
    <img src="/images/traghetti-hero.jpg" alt="Fähre an der Amalfiküste" class="absolute inset-0 w-full h-full object-cover" loading="eager" referrerpolicy="no-referrer"/>
    <div class="absolute inset-0 bg-gradient-to-b from-black/25 via-black/40 to-black/75"></div>
    <Breadcrumbs breadcrumbs={breadcrumbs} />
    <div class="relative z-10 max-w-7xl mx-auto px-6 py-20">
      <div class="max-w-3xl">
        <p class="text-med-gold text-xs sm:text-sm font-medium uppercase tracking-[0.3em] mb-3">Reiseratgeber</p>
        <h1 class="font-serif text-display text-white mb-4">Fähren & Tragflügelboote</h1>
        <p class="text-xl text-white/80 leading-relaxed">
          Alle Schiffsverbindungen in Kampanien: Neapel, Sorrent, Salerno, Positano, Amalfi, Capri, Ischia und Procida. Reedereien, Fahrpläne und aktuelle Preise für die Saison 2026.
        </p>
      </div>
    </div>
  </section>

  <div class="max-w-editorial mx-auto px-4 sm:px-6 lg:px-8 py-16 space-y-16">

    <section>
      <h2 class="font-serif text-2xl font-semibold text-slate-900 mb-0">Alle wichtigen Strecken</h2>
      <div class="overflow-x-auto rounded-2xl" style="margin-top: -8px;">
        <table class="w-full text-xs sm:text-sm">
          <thead>
            <tr class="bg-slate-900 text-white">
              <th class="text-left px-2 py-2 sm:px-4 sm:py-3 font-semibold text-xs sm:text-sm">Von</th>
              <th class="text-left px-2 py-2 sm:px-4 sm:py-3 font-semibold text-xs sm:text-sm">Nach</th>
              <th class="text-left px-2 py-2 sm:px-4 sm:py-3 font-semibold text-xs sm:text-sm">Dauer</th>
              <th class="text-left px-2 py-2 sm:px-4 sm:py-3 font-semibold text-xs sm:text-sm">Preis (einfach)</th>
              <th class="hidden sm:table-cell px-4 py-3 font-semibold text-sm">Reedereien</th>
              <th class="hidden sm:table-cell px-4 py-3 font-semibold text-sm">Saisonal</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100">
            {routes.map(r => (
              <tr class="hover:bg-slate-50 transition-colors">
                <td class="px-2 py-2 sm:px-4 sm:py-3 font-medium text-charcoal text-xs sm:text-sm">{r.from}</td>
                <td class="px-2 py-2 sm:px-4 sm:py-3 text-xs sm:text-sm">{r.to}</td>
                <td class="px-2 py-2 sm:px-4 sm:py-3 text-slate-600 text-xs sm:text-sm">{r.time}</td>
                <td class="px-2 py-2 sm:px-4 sm:py-3 font-mono text-xs">{r.price}</td>
                <td class="hidden sm:table-cell px-4 py-3 text-slate-500 text-sm">{r.companies}</td>
                <td class="hidden sm:table-cell px-4 py-3">
                  {r.seasonal
                    ? <span class="text-[10px] bg-med-cream text-med-gold px-2 py-0.5 rounded-full font-medium">Apr–Okt</span>
                    : <span class="text-[10px] bg-med-blue/5 text-med-blue px-2 py-0.5 rounded-full font-medium">Ganzjährig</span>
                  }
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="text-xs text-slate-400 mt-2">* Preise und Fahrzeiten sind Richtwerte. Bitte auf den Websites der Reedereien prüfen: nlg.it, alilauro.it, snav.it, caremar.it, medmar.it, travelmar.it</p>
    </section>

    <section class="bg-med-cream border border-med-gold/20 rounded-[2rem] p-8">
      <p class="font-semibold text-charcoal text-lg mb-3">Praktische Tipps</p>
      <ul class="space-y-2">
        {[
          'Im Juli und August Tickets am Vortag buchen: die ersten Abfahrten (7:00–8:30 Uhr) sind oft ausgebucht.',
          'Tragflügelboote fahren bei rauer See nicht (Beaufort 4–5): immer Seewettervorhersage prüfen.',
          'Der Abfahrtshafen in Neapel ist für fast alle Verbindungen Molo Beverello (Piazza Municipio). Medmar fährt ab Pozzuoli.',
          'Mit Kleinkindern ist die Fähre stabiler als das Tragflügelboot.',
          'Rückfahrkarten können auf der Insel gekauft werden.',
        ].map(tip => (
          <li class="flex items-start gap-2 text-xs sm:text-sm text-charcoal">
            <span class="w-1.5 h-1.5 rounded-full bg-med-gold mt-1.5 flex-shrink-0"></span>
            <span>{tip}</span>
          </li>
        ))}
      </ul>
    </section>

    <section id="faq">
      <h2 class="font-serif text-2xl font-semibold text-slate-900 mb-6">Häufig gestellte Fragen</h2>
      <div class="space-y-4">
        {faqSchema.mainEntity.map((q) => (
          <details class="group border border-slate-200 rounded-2xl overflow-hidden">
            <summary class="flex items-center justify-between px-6 py-4 cursor-pointer select-none text-charcoal font-medium hover:bg-slate-50 transition-colors">
              {q.name}
              <svg class="w-4 h-4 text-slate-400 group-open:rotate-180 transition-transform flex-shrink-0 ml-3" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
            </summary>
            <div class="px-6 pb-5 text-slate-600 leading-relaxed text-xs sm:text-sm border-t border-slate-100 pt-4">
              {q.acceptedAnswer.text}
            </div>
          </details>
        ))}
      </div>
    </section>

    <!-- EVERYTHING YOU NEED -->
    <section class="py-16 bg-white">
      <div class="max-w-editorial mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-12">
          <h2 class="font-serif text-2xl font-semibold text-slate-900 mb-6">Alles was du brauchst</h2>
          <div class="w-20 h-1 bg-med-gold mx-auto rounded-full"></div>
        </div>

        <!-- MOBILE: Swiper slider -->
        <div class="swiper swiper-guides md:hidden">
          <div class="swiper-wrapper pb-12">
            <div class="swiper-slide">
              <a href="/de-de/ratgeber/faehren/" class="block bg-slate-900 rounded-[2rem] p-6 border-0 hover:shadow-lg transition-all duration-300 h-full">
                <h3 class="font-serif text-xl font-bold text-med-gold mb-2">Fähren</h3>
                <p class="text-white text-sm mb-3">Wie man die Küste per Schiff erreicht</p>
                <p class="text-white/70 text-xs leading-relaxed mb-4">Fahrpläne, Tarife und Hauptrouten von Neapel und Salerno</p>
                <span class="text-med-gold font-semibold text-sm">Zur Anleitung →</span>
              </a>
            </div>
            <div class="swiper-slide">
              <a href="/de-de/ratgeber/sita-bus/" class="block bg-slate-900 rounded-[2rem] p-6 border-0 hover:shadow-lg transition-all duration-300 h-full">
                <h3 class="font-serif text-xl font-bold text-med-gold mb-2">SITA Bus</h3>
                <p class="text-white text-sm mb-3">Fahrpläne, Tarife und Hauptrouten</p>
                <p class="text-white/70 text-xs leading-relaxed mb-4">So kommt man an der Küste mit dem Bus voran: alle Linien und Haltestellen</p>
                <span class="text-med-gold font-semibold text-sm">Mehr erfahren →</span>
              </a>
            </div>
            <div class="swiper-slide">
              <a href="/de-de/planung/" class="block bg-slate-900 rounded-[2rem] p-6 border-0 hover:shadow-lg transition-all duration-300 h-full">
                <h3 class="font-serif text-xl font-bold text-med-gold mb-2">Planung</h3>
                <p class="text-white text-sm mb-3">Monat für Monat: Wetter und Besucherzahlen</p>
                <p class="text-white/70 text-xs leading-relaxed mb-4">Wähle die beste Zeit für deinen Besuch</p>
                <span class="text-med-gold font-semibold text-sm">Mehr erfahren →</span>
              </a>
            </div>
          </div>
          <div class="swiper-pagination"></div>
        </div>

        <!-- DESKTOP: Grid 3 colonne -->
        <div class="hidden md:grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          <a href="/de-de/ratgeber/faehren/" class="block bg-slate-900 rounded-[2rem] p-6 border-0 hover:shadow-lg transition-all duration-300">
            <h3 class="font-serif text-xl font-bold text-med-gold mb-2">Fähren</h3>
            <p class="text-white text-sm mb-3">Wie man die Küste per Schiff erreicht</p>
            <p class="text-white/70 text-xs leading-relaxed mb-4">Fahrpläne, Tarife und Hauptrouten von Neapel und Salerno</p>
            <span class="text-med-gold font-semibold text-sm">Zur Anleitung →</span>
          </a>

          <a href="/de-de/ratgeber/sita-bus/" class="block bg-slate-900 rounded-[2rem] p-6 border-0 hover:shadow-lg transition-all duration-300">
            <h3 class="font-serif text-xl font-bold text-med-gold mb-2">SITA Bus</h3>
            <p class="text-white text-sm mb-3">Fahrpläne, Tarife und Hauptrouten</p>
            <p class="text-white/70 text-xs leading-relaxed mb-4">So kommt man an der Küste mit dem Bus voran: alle Linien und Haltestellen</p>
            <span class="text-med-gold font-semibold text-sm">Mehr erfahren →</span>
          </a>

          <a href="/de-de/planung/" class="block bg-slate-900 rounded-[2rem] p-6 border-0 hover:shadow-lg transition-all duration-300">
            <h3 class="font-serif text-xl font-bold text-med-gold mb-2">Planung</h3>
            <p class="text-white text-sm mb-3">Monat für Monat: Wetter und Besucherzahlen</p>
            <p class="text-white/70 text-xs leading-relaxed mb-4">Wähle die beste Zeit für deinen Besuch</p>
            <span class="text-med-gold font-semibold text-sm">Mehr erfahren →</span>
          </a>
        </div>
      </div>
    </section>

    <!-- AUTHENTIC EXPERIENCES -->
    <section class="py-16 bg-white overflow-hidden">
      <div class="max-w-editorial mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex flex-col md:flex-row justify-between items-end mb-12 gap-6">
          <div class="max-w-2xl">
            <span class="text-med-gold font-bold uppercase tracking-[0.3em] text-xs mb-4 block">Erlebe das Territorium</span>
            <h2 class="font-serif text-2xl font-semibold text-slate-900 mb-6">Authentische Erfahrungen</h2>
            <p class="text-slate-600 text-lg">Von traditioneller Küche bis zu Zitronenhainen - entdecke die wahre Seele der Küste.</p>
          </div>
          <a href="/de-de/erlebnisse/" class="group flex items-center gap-2 text-med-blue font-semibold hover:text-med-gold transition-colors">
            Alle Erlebnisse
            <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
          </a>
        </div>

        <!-- MOBILE: Swiper slider -->
        <div class="swiper swiper-experiences md:hidden">
          <div class="swiper-wrapper pb-12">
            <div class="swiper-slide">
              <a href="/de-de/erlebnisse/kochkurs-amalfikueste/" class="group block">
                <div class="relative aspect-[16/10] rounded-[2.5rem] overflow-hidden mb-6 shadow-lg">
                  <img
                    src="/images/cooking-class-hero.webp"
                    alt="Kochkurs"
                    class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
                    loading="lazy"
                    decoding="async"
                  />
                  <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent" />
                  <div class="absolute bottom-6 left-6">
                    <h3 class="text-2xl font-serif font-bold text-white">Kochkurs</h3>
                  </div>
                </div>
              </a>
            </div>
            <div class="swiper-slide">
              <a href="/de-de/erlebnisse/limoncello-tour-amalfikueste/" class="group block">
                <div class="relative aspect-[16/10] rounded-[2.5rem] overflow-hidden mb-6 shadow-lg">
                  <img
                    src="/images/limoncello-mercato-hero.webp"
                    alt="Limoncello Tour"
                    class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
                    loading="lazy"
                    decoding="async"
                  />
                  <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent" />
                  <div class="absolute bottom-6 left-6">
                    <h3 class="text-2xl font-serif font-bold text-white">Limoncello Tour</h3>
                  </div>
                </div>
              </a>
            </div>
            <div class="swiper-slide">
              <a href="/de-de/erlebnisse/mozzarella-experience-agerola-tramonti/" class="group block">
                <div class="relative aspect-[16/10] rounded-[2.5rem] overflow-hidden mb-6 shadow-lg">
                  <img
                    src="/images/mozzarella-provolone-hero.webp"
                    alt="Mozzarella Experience"
                    class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
                    loading="lazy"
                    decoding="async"
                  />
                  <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent" />
                  <div class="absolute bottom-6 left-6">
                    <h3 class="text-2xl font-serif font-bold text-white">Mozzarella Experience</h3>
                  </div>
                </div>
              </a>
            </div>
            <div class="swiper-slide">
              <a href="/de-de/erlebnisse/sternrestaurants-amalfikueste/" class="group block">
                <div class="relative aspect-[16/10] rounded-[2.5rem] overflow-hidden mb-6 shadow-lg">
                  <img
                    src="/images/ravello-hero.webp"
                    alt="Sternrestaurants"
                    class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
                    loading="lazy"
                    decoding="async"
                  />
                  <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent" />
                  <div class="absolute bottom-6 left-6">
                    <h3 class="text-2xl font-serif font-bold text-white">Sternrestaurants</h3>
                  </div>
                </div>
              </a>
            </div>
          </div>
          <div class="swiper-pagination"></div>
        </div>

        <!-- DESKTOP: Grid -->
        <div class="hidden md:grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
          <a href="/de-de/erlebnisse/kochkurs-amalfikueste/" class="group block">
            <div class="relative aspect-[16/10] rounded-[2.5rem] overflow-hidden mb-6 shadow-lg">
              <img
                src="/images/cooking-class-hero.webp"
                alt="Kochkurs"
                class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
                loading="lazy"
                decoding="async"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent" />
              <div class="absolute bottom-6 left-6">
                <h3 class="text-2xl font-serif font-bold text-white">Kochkurs</h3>
              </div>
            </div>
          </a>

          <a href="/de-de/erlebnisse/limoncello-tour-amalfikueste/" class="group block">
            <div class="relative aspect-[16/10] rounded-[2.5rem] overflow-hidden mb-6 shadow-lg">
              <img
                src="/images/limoncello-mercato-hero.webp"
                alt="Limoncello Tour"
                class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
                loading="lazy"
                decoding="async"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent" />
              <div class="absolute bottom-6 left-6">
                <h3 class="text-2xl font-serif font-bold text-white">Limoncello Tour</h3>
              </div>
            </div>
          </a>

          <a href="/de-de/erlebnisse/mozzarella-experience-agerola-tramonti/" class="group block">
            <div class="relative aspect-[16/10] rounded-[2.5rem] overflow-hidden mb-6 shadow-lg">
              <img
                src="/images/mozzarella-provolone-hero.webp"
                alt="Mozzarella Experience"
                class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
                loading="lazy"
                decoding="async"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent" />
              <div class="absolute bottom-6 left-6">
                <h3 class="text-2xl font-serif font-bold text-white">Mozzarella Experience</h3>
              </div>
            </div>
          </a>

          <a href="/de-de/erlebnisse/sternrestaurants-amalfikueste/" class="group block">
            <div class="relative aspect-[16/10] rounded-[2.5rem] overflow-hidden mb-6 shadow-lg">
              <img
                src="/images/ravello-hero.webp"
                alt="Sternrestaurants"
                class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
                loading="lazy"
                decoding="async"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent" />
              <div class="absolute bottom-6 left-6">
                <h3 class="text-2xl font-serif font-bold text-white">Sternrestaurants</h3>
              </div>
            </div>
          </a>
        </div>
      </div>
    </section>

  </div>

<script>
  import Swiper from 'swiper';
  import { Pagination } from 'swiper/modules';

  // Guides slider
  new Swiper('.swiper-guides', {
    modules: [Pagination],
    slidesPerView: 1.2,
    spaceBetween: 16,
    pagination: { el: '.swiper-guides .swiper-pagination', clickable: true },
  });

  // Experiences slider
  new Swiper('.swiper-experiences', {
    modules: [Pagination],
    slidesPerView: 1.2,
    spaceBetween: 16,
    pagination: { el: '.swiper-experiences .swiper-pagination', clickable: true },
  });
</script>

<style is:global>
  @import 'swiper/css';
  @import 'swiper/css/pagination';

  :root {
    --swiper-pagination-color: #D4AF37;
  }

  .swiper-pagination-bullet {
    background-color: var(--swiper-pagination-color);
    opacity: 0.5;
  }

  .swiper-pagination-bullet-active {
    opacity: 1;
  }

  /* Hide sliders on desktop */
  @media (min-width: 768px) {
    .swiper {
      display: none !important;
    }
  }
</style>

</BaseLayout>
