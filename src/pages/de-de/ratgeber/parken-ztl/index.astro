---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../../components/Breadcrumbs.astro';
import Swiper from 'swiper';
import { Pagination } from 'swiper/modules';

const lang = 'de-de';

const breadcrumbs = [
  { name: 'Startseite', url: '/de-de/' },
  { name: 'Planung', url: '/de-de/planung/' },
  { name: 'Parken & ZTL', url: '/de-de/ratgeber/parken-ztl/' },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Kann ich mit dem Auto nach Positano fahren?",
      "acceptedAnswer": { "@type": "Answer", "text": "Im Sommer ist Positano von 9:00 bis 18:00 Uhr für den Verkehr gesperrt (ZTL). Nur Anwohner und Hotelgäste dürfen einfahren. Bester Rat: Auto in Sorrent oder Praiano parken und mit SITA-Bus oder Fähre fahren." }
    },
    {
      "@type": "Question",
      "name": "Wo soll ich parken, um die Amalfiküste zu besuchen?",
      "acceptedAnswer": { "@type": "Answer", "text": "Beste Optionen: 1) Auto in Salerno oder Vietri sul Mare lassen und Bus/Fähre nehmen. 2) In Sorrent parken (Garage Achille Lauro, ~€2/Std.) und SITA-Bus oder Tragflügelboot nehmen. 3) Parkplätze in Amalfi nutzen (Luna Rossa, Flavio Gioia, ~€4–5/Std.)." }
    },
    {
      "@type": "Question",
      "name": "Was kostet das Parken in Amalfi?",
      "acceptedAnswer": { "@type": "Answer", "text": "Die Hauptparkplätze in Amalfi (Luna Rossa und Flavio Gioia) kosten ~€4–5/Stunde oder ~€25–30/Tag. Im Juli und August fast immer voll. Empfehlung: vor 9:00 Uhr ankommen oder öffentliche Verkehrsmittel nutzen." }
    }
  ]
};

const ztlData = [
  { location: 'Positano', ztl: 'Ja', period: 'Jun–Sep (9:00–18:00)', note: 'Zugang nur für Anwohner und Hotelgäste. SITA-Bus oder Fähre empfohlen.' },
  { location: 'Amalfi', ztl: 'Ja', period: 'Ganzjährig (Zentrum)', note: 'Permanente ZTL im historischen Kern. Kostenpflichtige Parkplätze an der Uferpromenade (~€4/Std.).' },
  { location: 'Ravello', ztl: 'Ja', period: 'Sommer (10:00–19:00)', note: 'Nur SITA-Bus ab Amalfi (25 Min., ~€1,50) oder Auto mit Hotelgenehmigung.' },
  { location: 'Sorrent', ztl: 'Ja', period: 'Sommer (Zentrum)', note: 'Parkhäuser verfügbar. Piazza Lauro ~€2/Std.' },
  { location: 'Praiano', ztl: 'Nein', period: '-', note: 'Kostenlose und kostenpflichtige Parkplätze an der SS163. Guter Haltepunkt.' },
  { location: 'Maiori', ztl: 'Nein', period: '-', note: 'Parkplätze an der Uferpromenade. Einfacher als die westlichen Dörfer.' },
  { location: 'Minori', ztl: 'Nein', period: '-', note: 'Parkplätze an der Uferpromenade, kostenlos oder günstig.' },
];
---

<BaseLayout
  title="Parken & ZTL Amalfiküste 2026 | Wo das Auto abstellen"
  description="Vollständiger Leitfaden zu Parkplätzen und ZTL-Zonen an der Amalfiküste: Positano, Amalfi, Ravello, Sorrent. Wo parken und wie die Dörfer stressfrei erreichen."
  lang={lang}
  breadcrumbs={breadcrumbs}
  schema={[faqSchema]}
 pageKey="parken-ztl">

  <section class="relative h-[75vh] sm:h-[90vh] flex items-center bg-charcoal overflow-hidden">
    <img src="/images/parcheggi-hero.jpg" alt="Sorrent, Halbinsel Sorrent" class="absolute inset-0 w-full h-full object-cover" loading="eager" referrerpolicy="no-referrer"/>
    <div class="absolute inset-0 bg-gradient-to-b from-black/25 via-black/40 to-black/75"></div>
    <div class="relative z-10 max-w-7xl mx-auto px-6 py-20">
      <div class="max-w-3xl">
        <p class="text-med-gold text-xs sm:text-sm font-medium uppercase tracking-[0.3em] mb-3">Reiseratgeber</p>
        <h1 class="font-serif text-display text-white mb-4">Parken & ZTL-Zonen</h1>
        <p class="text-xl text-white/80 leading-relaxed">
          Die Amalfiküste ist im Sommer ein Albtraum für Autofahrer: ZTL überall, enge Straßen und teure Parkplätze. Hauptempfehlung: Auto stehen lassen und öffentliche Verkehrsmittel nutzen. So geht's.
        </p>
      </div>
    </div>
    <Breadcrumbs breadcrumbs={breadcrumbs} />
  </section>

  <div class="max-w-editorial mx-auto px-4 sm:px-6 lg:px-8 pt-0 pb-4 space-y-12">

    <section class="max-w-editorial">
      <div style="background-color: #E2725B; border-color: #E2725B; padding: 6px 12px 6px 12px;" class="border rounded-[2rem] mb-6 mt-8">
        <p class="font-semibold mb-0 mt-0 text-white text-sm leading-tight" style="margin-top: -2px;">⚠️ ZTL-Warnung</p>
        <p class="text-xs text-white/95 leading-tight">ZTL-Zonen an der Amalfiküste werden mit Kameras überwacht. Einfahren ohne Genehmigung führt zu einem Bußgeld von €80–160, das direkt an die Mietwagengesellschaft oder Ihre Heimatadresse geschickt wird.</p>
      </div>
      <p class="text-xl leading-relaxed text-charcoal">
        Die beste Strategie ist das „strategische Parken": Auto an einem gut erreichbaren Punkt abstellen (Salerno, Vietri, Sorrent oder Praiano) und von dort Busse, Fähren oder Tragflügelboote nutzen.
      </p>
    </section>

    <section>
      <h2 class="font-serif text-2xl font-semibold text-slate-900 mb-6">ZTL und Parken für jedes Dorf</h2>
      <div class="overflow-x-auto rounded-2xl border border-slate-200">
        <table class="w-full text-xs sm:text-sm">
          <thead>
            <tr class="bg-slate-900 text-white">
              <th class="text-left px-2 py-2 sm:px-4 sm:py-3 font-semibold text-xs sm:text-sm">Ort</th>
              <th class="text-left px-2 py-2 sm:px-4 sm:py-3 font-semibold text-xs sm:text-sm">ZTL</th>
              <th class="hidden sm:table-cell px-4 py-3 font-semibold text-sm">Zeitraum</th>
              <th class="hidden sm:table-cell px-4 py-3 font-semibold text-sm">Empfehlung</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100">
            {ztlData.map(r => (
              <tr class="hover:bg-slate-50 transition-colors">
                <td class="px-2 py-2 sm:px-4 sm:py-3 font-semibold text-charcoal text-xs sm:text-sm">{r.location}</td>
                <td class="px-2 py-2 sm:px-4 sm:py-3">
                  {r.ztl === 'Ja'
                    ? <span class="text-[10px] bg-red-50 text-red-600 px-2 py-0.5 rounded-full font-medium">Ja</span>
                    : <span class="text-[10px] bg-med-blue/5 text-med-blue px-2 py-0.5 rounded-full font-medium">Nein</span>
                  }
                </td>
                <td class="hidden sm:table-cell px-4 py-3 text-slate-500 text-sm">{r.period}</td>
                <td class="hidden sm:table-cell px-4 py-3 text-slate-600 text-sm">{r.note}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section id="faq">
      <h2 class="font-serif text-2xl font-semibold text-slate-900 mb-6">Häufig gestellte Fragen</h2>
      <div class="space-y-4">
        {faqSchema.mainEntity.map((q) => (
          <details class="group border border-slate-200 rounded-2xl overflow-hidden">
            <summary class="flex items-center justify-between px-6 py-4 cursor-pointer select-none text-charcoal font-medium hover:bg-slate-50 transition-colors">
              {q.name}
              <svg class="w-4 h-4 text-slate-400 group-open:rotate-180 transition-transform flex-shrink-0 ml-3" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
            </summary>
            <div class="px-6 pb-5 text-slate-600 leading-relaxed text-xs sm:text-sm border-t border-slate-100 pt-4">
              {q.acceptedAnswer.text}
            </div>
          </details>
        ))}
      </div>
    </section>

    <!-- EVERYTHING YOU NEED -->
    <section class="py-16 bg-white">
      <div class="max-w-editorial mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-12">
          <h2 class="font-serif text-2xl font-semibold text-slate-900 mb-6">Das Wichtigste für Ihre Reise</h2>
          <div class="w-20 h-1 bg-med-gold mx-auto rounded-full"></div>
        </div>

        <!-- MOBILE: Swiper slider -->
        <div class="swiper swiper-guides md:hidden">
          <div class="swiper-wrapper pb-12">
            <div class="swiper-slide">
              <a href="/de-de/ratgeber/faehren/" class="block bg-slate-900 rounded-[2rem] p-6 border-0 hover:shadow-lg transition-all duration-300 h-full">
                <h3 class="font-serif text-xl font-bold text-med-gold mb-2">Fähren & Tragflügelboote</h3>
                <p class="text-white text-sm mb-3">Wie Sie die Küste über das Meer erreichen</p>
                <p class="text-white/70 text-xs leading-relaxed mb-4">Fahrpläne, Tarife und Hauptrouten von Neapel und Salerno</p>
                <span class="text-med-gold font-semibold text-sm">Zur Anleitung →</span>
              </a>
            </div>
            <div class="swiper-slide">
              <a href="/de-de/ratgeber/sita-bus/" class="block bg-slate-900 rounded-[2rem] p-6 border-0 hover:shadow-lg transition-all duration-300 h-full">
                <h3 class="font-serif text-xl font-bold text-med-gold mb-2">SITA Bus</h3>
                <p class="text-white text-sm mb-3">Fahrpläne, Tarife und Hauptrouten</p>
                <p class="text-white/70 text-xs leading-relaxed mb-4">Entlang der Küste fahren: alle Linien und Haltestellen</p>
                <span class="text-med-gold font-semibold text-sm">Lesen →</span>
              </a>
            </div>
            <div class="swiper-slide">
              <a href="/de-de/ratgeber/reisezeit/" class="block bg-slate-900 rounded-[2rem] p-6 border-0 hover:shadow-lg transition-all duration-300 h-full">
                <h3 class="font-serif text-xl font-bold text-med-gold mb-2">Beste Reisezeit</h3>
                <p class="text-white text-sm mb-3">Monat für Monat: Wetter und Menschenmengen</p>
                <p class="text-white/70 text-xs leading-relaxed mb-4">Wählen Sie die beste Zeit für Ihren Besuch</p>
                <span class="text-med-gold font-semibold text-sm">Lesen →</span>
              </a>
            </div>
          </div>
          <div class="swiper-pagination"></div>
        </div>

        <!-- DESKTOP: Grid 3 colonne -->
        <div class="hidden md:grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          <a href="/de-de/ratgeber/faehren/" class="block bg-slate-900 rounded-[2rem] p-6 border-0 hover:shadow-lg transition-all duration-300">
            <h3 class="font-serif text-xl font-bold text-med-gold mb-2">Fähren & Tragflügelboote</h3>
            <p class="text-white text-sm mb-3">Wie Sie die Küste über das Meer erreichen</p>
            <p class="text-white/70 text-xs leading-relaxed mb-4">Fahrpläne, Tarife und Hauptrouten von Neapel und Salerno</p>
            <span class="text-med-gold font-semibold text-sm">Zur Anleitung →</span>
          </a>

          <a href="/de-de/ratgeber/sita-bus/" class="block bg-slate-900 rounded-[2rem] p-6 border-0 hover:shadow-lg transition-all duration-300">
            <h3 class="font-serif text-xl font-bold text-med-gold mb-2">SITA Bus</h3>
            <p class="text-white text-sm mb-3">Fahrpläne, Tarife und Hauptrouten</p>
            <p class="text-white/70 text-xs leading-relaxed mb-4">Entlang der Küste fahren: alle Linien und Haltestellen</p>
            <span class="text-med-gold font-semibold text-sm">Lesen →</span>
          </a>

          <a href="/de-de/ratgeber/reisezeit/" class="block bg-slate-900 rounded-[2rem] p-6 border-0 hover:shadow-lg transition-all duration-300">
            <h3 class="font-serif text-xl font-bold text-med-gold mb-2">Beste Reisezeit</h3>
            <p class="text-white text-sm mb-3">Monat für Monat: Wetter und Menschenmengen</p>
            <p class="text-white/70 text-xs leading-relaxed mb-4">Wählen Sie die beste Zeit für Ihren Besuch</p>
            <span class="text-med-gold font-semibold text-sm">Lesen →</span>
          </a>
        </div>
      </div>
    </section>

    <!-- AUTHENTIC EXPERIENCES -->
    <section class="py-16 bg-white overflow-hidden">
      <div class="max-w-editorial mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex flex-col md:flex-row justify-between items-end mb-12 gap-6">
          <div class="max-w-2xl">
            <span class="text-med-gold font-bold uppercase tracking-[0.3em] text-xs mb-4 block">Erleben Sie das Gebiet</span>
            <h2 class="font-serif text-2xl font-semibold text-slate-900 mb-6">Authentische Erlebnisse</h2>
            <p class="text-slate-600 text-lg">Von traditioneller Küche bis zu Zitronenplantagen - entdecken Sie die wahre Seele der Küste.</p>
          </div>
          <a href="/de-de/erlebnisse/" class="group flex items-center gap-2 text-med-blue font-semibold hover:text-med-gold transition-colors">
            Alle Erlebnisse
            <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
          </a>
        </div>

        <!-- MOBILE: Swiper slider -->
        <div class="swiper swiper-experiences md:hidden">
          <div class="swiper-wrapper pb-12">
            <div class="swiper-slide">
              <a href="/de-de/erlebnisse/kochkurs-amalfikueste/" class="group block">
                <div class="relative aspect-[16/10] rounded-[2.5rem] overflow-hidden mb-6 shadow-lg">
                  <img
                    src="/images/cooking-class-hero.webp"
                    alt="Kochkurs"
                    class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
                    loading="lazy"
                    decoding="async"
                  />
                  <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent" />
                  <div class="absolute bottom-6 left-6">
                    <h3 class="text-2xl font-serif font-bold text-white">Kochkurs</h3>
                  </div>
                </div>
              </a>
            </div>
            <div class="swiper-slide">
              <a href="/de-de/erlebnisse/limoncello-tour-amalfikueste/" class="group block">
                <div class="relative aspect-[16/10] rounded-[2.5rem] overflow-hidden mb-6 shadow-lg">
                  <img
                    src="/images/limoncello-mercato-hero.webp"
                    alt="Limoncello-Tour"
                    class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
                    loading="lazy"
                    decoding="async"
                  />
                  <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent" />
                  <div class="absolute bottom-6 left-6">
                    <h3 class="text-2xl font-serif font-bold text-white">Limoncello-Tour</h3>
                  </div>
                </div>
              </a>
            </div>
            <div class="swiper-slide">
              <a href="/de-de/erlebnisse/mozzarella-erlebnis-agerola-tramonti/" class="group block">
                <div class="relative aspect-[16/10] rounded-[2.5rem] overflow-hidden mb-6 shadow-lg">
                  <img
                    src="/images/mozzarella-provolone-hero.webp"
                    alt="Mozzarella-Erlebnis"
                    class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
                    loading="lazy"
                    decoding="async"
                  />
                  <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent" />
                  <div class="absolute bottom-6 left-6">
                    <h3 class="text-2xl font-serif font-bold text-white">Mozzarella-Erlebnis</h3>
                  </div>
                </div>
              </a>
            </div>
            <div class="swiper-slide">
              <a href="/de-de/erlebnisse/sternrestaurants/" class="group block">
                <div class="relative aspect-[16/10] rounded-[2.5rem] overflow-hidden mb-6 shadow-lg">
                  <img
                    src="/images/ravello-hero.webp"
                    alt="Sterne-Restaurants"
                    class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
                    loading="lazy"
                    decoding="async"
                  />
                  <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent" />
                  <div class="absolute bottom-6 left-6">
                    <h3 class="text-2xl font-serif font-bold text-white">Sterne-Restaurants</h3>
                  </div>
                </div>
              </a>
            </div>
          </div>
          <div class="swiper-pagination"></div>
        </div>

        <!-- DESKTOP: Grid -->
        <div class="hidden md:grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
          <a href="/de-de/erlebnisse/kochkurs-amalfikueste/" class="group block">
            <div class="relative aspect-[16/10] rounded-[2.5rem] overflow-hidden mb-6 shadow-lg">
              <img
                src="/images/cooking-class-hero.webp"
                alt="Kochkurs"
                class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
                loading="lazy"
                decoding="async"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent" />
              <div class="absolute bottom-6 left-6">
                <h3 class="text-2xl font-serif font-bold text-white">Kochkurs</h3>
              </div>
            </div>
          </a>

          <a href="/de-de/erlebnisse/limoncello-tour-amalfikueste/" class="group block">
            <div class="relative aspect-[16/10] rounded-[2.5rem] overflow-hidden mb-6 shadow-lg">
              <img
                src="/images/limoncello-mercato-hero.webp"
                alt="Limoncello-Tour"
                class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
                loading="lazy"
                decoding="async"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent" />
              <div class="absolute bottom-6 left-6">
                <h3 class="text-2xl font-serif font-bold text-white">Limoncello-Tour</h3>
              </div>
            </div>
          </a>

          <a href="/de-de/erlebnisse/mozzarella-erlebnis-agerola-tramonti/" class="group block">
            <div class="relative aspect-[16/10] rounded-[2.5rem] overflow-hidden mb-6 shadow-lg">
              <img
                src="/images/mozzarella-provolone-hero.webp"
                alt="Mozzarella-Erlebnis"
                class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
                loading="lazy"
                decoding="async"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent" />
              <div class="absolute bottom-6 left-6">
                <h3 class="text-2xl font-serif font-bold text-white">Mozzarella-Erlebnis</h3>
              </div>
            </div>
          </a>

          <a href="/de-de/erlebnisse/sternrestaurants/" class="group block">
            <div class="relative aspect-[16/10] rounded-[2.5rem] overflow-hidden mb-6 shadow-lg">
              <img
                src="/images/ravello-hero.webp"
                alt="Sterne-Restaurants"
                class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
                loading="lazy"
                decoding="async"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent" />
              <div class="absolute bottom-6 left-6">
                <h3 class="text-2xl font-serif font-bold text-white">Sterne-Restaurants</h3>
              </div>
            </div>
          </a>
        </div>
      </div>
    </section>

  </div>

<script>
  import Swiper from 'swiper';
  import { Pagination } from 'swiper/modules';

  // Guides slider
  new Swiper('.swiper-guides', {
    modules: [Pagination],
    slidesPerView: 1.2,
    spaceBetween: 16,
    pagination: { el: '.swiper-guides .swiper-pagination', clickable: true },
  });
</script>

<style is:global>
  @import 'swiper/css';
  @import 'swiper/css/pagination';

  :root {
    --swiper-pagination-color: #D4AF37;
  }

  .swiper-pagination-bullet {
    background-color: var(--swiper-pagination-color);
    opacity: 0.5;
  }

  .swiper-pagination-bullet-active {
    opacity: 1;
  }

  /* Hide sliders on desktop */
  @media (min-width: 768px) {
    .swiper {
      display: none !important;
    }
  }
</style>

</BaseLayout>
