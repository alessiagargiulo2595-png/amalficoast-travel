---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../../components/Breadcrumbs.astro';
import Swiper from 'swiper';
import { Pagination } from 'swiper/modules';

const lang = 'de-de';

const breadcrumbs = [
  { name: 'Startseite', url: '/de-de/' },
  { name: 'Planung', url: '/de-de/planung/' },
  { name: 'Parken & ZTL', url: '/de-de/ratgeber/parken-ztl/' },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Gibt es kostenlose Parkplätze an der Amalfiküste?",
      "acceptedAnswer": { "@type": "Answer", "text": "Sehr wenige. Weiße Parkflächen gibt es vor allem abseits der Ortszentren: Montepertuso und Nocelle oberhalb von Positano, einige Abschnitte am Straßenrand der SS163 und der Straße nach Agerola vor Amalfi, die Via Chiunzi in Maiori, die Via Rota und die Via Parsano in Sorrent. Im Juli und August sind sie meist bis 9:00 Uhr belegt. Lesen Sie immer das Schild neben der Markierung: Viele weiße Plätze sind Anwohnern vorbehalten oder mit Parkscheibe zeitlich begrenzt." }
    },
    {
      "@type": "Question",
      "name": "Was kostet Parken in Positano?",
      "acceptedAnswer": { "@type": "Answer", "text": "Private Garagen im Zentrum wie Mandara und De Gennaro verlangen im Sommer etwa €8-12 pro Stunde und €50-90 pro Tag. Die blauen Parkplätze der Gemeinde kosten etwa €3 pro Stunde, sind aber fast immer belegt. Kostenlose Plätze gibt es nur oben in Montepertuso und Nocelle, die per Ortsbus mit dem Zentrum verbunden sind." }
    },
    {
      "@type": "Question",
      "name": "Was kostet Parken in Amalfi?",
      "acceptedAnswer": { "@type": "Answer", "text": "Die Parkhäuser Luna Rossa und Berma kosten tagsüber etwa €5 pro Stunde und nachts €4 pro Stunde; die Parkplätze am Hafen (Darsena, Flavio Gioia) tagsüber etwa €6 pro Stunde. 2026 galt ein Aufschlag auf die ersten zwei Stunden am Tag. Im Juli und August sind sie bis zum Vormittag voll: Kommen Sie vor 9:00 Uhr oder mit Bus oder Fähre." }
    },
    {
      "@type": "Question",
      "name": "Wo parkt man am besten für einen Besuch der Amalfiküste?",
      "acceptedAnswer": { "@type": "Answer", "text": "Die praktischsten Optionen: 1) Vietri sul Mare oder Salerno, mit den größten Parkplätzen der Küste, dann SITA-Bus oder Travelmar-Fähre. 2) Sorrent (Garage Achille Lauro, etwa €2-3/h) oder ein Bahnhof der Circumvesuviana wie Vico Equense oder Sant'Agnello, dann Bus oder Tragflügelboot. 3) Praiano, mit blauen Gemeindeparkplätzen und 6- und 14-Stunden-Tickets, auf halbem Weg zwischen Positano und Amalfi." }
    },
    {
      "@type": "Question",
      "name": "Kann ich mit dem Auto nach Positano fahren?",
      "acceptedAnswer": { "@type": "Answer", "text": "Ja, die SS163 führt durch den oberen Teil von Positano, aber an vielen Tagen zwischen Ostern und Oktober gilt von 10:00 bis 18:00 Uhr die Regel der Wechselkennzeichen. Die Einbahnstraße durch den Ort (Via Pasitea, Piazza dei Mulini, Via Cristoforo Colombo) ist eine ZTL mit Kameraschleusen und nur für berechtigte Fahrzeuge offen. Wenn Sie eine Garage im Zentrum oder ein Hotel mit Parkplatz buchen, lassen Sie Ihr Kennzeichen vor der Ankunft registrieren." }
    },
    {
      "@type": "Question",
      "name": "Wo kann ich in Sorrent parken?",
      "acceptedAnswer": { "@type": "Answer", "text": "Die wichtigsten Optionen sind die Garage Achille Lauro in der Via Correale (etwa €2-3/h, €24-30 pro Tag, unter 30 Minuten kostenlos), Fuorimura Parking und Sorrento Parking (ab etwa €27 pro Tag) sowie die Garage Marina Piccola am Hafen (etwa €26 für 6 Stunden, €32 für 24 Stunden), praktisch für einen Tagesausflug nach Capri. Blaue Parkplätze kosten €1 für 30 Minuten oder €2 pro Stunde. Das Zentrum ist abends und sonntags ZTL." }
    },
    {
      "@type": "Question",
      "name": "Was bedeuten blaue, weiße und gelbe Linien in Italien?",
      "acceptedAnswer": { "@type": "Answer", "text": "Blaue Linien bedeuten gebührenpflichtiges Parken: am Automaten oder per App zahlen und das Ticket sichtbar hinlegen. Weiße Linien sind kostenlos, sofern kein Schild Einschränkungen nennt (Parkscheibe, nur Anwohner, Straßenreinigung). Gelbe Linien sind reserviert: Anwohner mit Genehmigung, Inhaber eines Behindertenausweises, Lieferverkehr, Taxis oder Busse. Wer auf gelben Plätzen parkt oder die bezahlte Zeit auf blauen überschreitet, zahlt ab etwa €42, und in ausgeschilderten Abschleppzonen kann das Auto entfernt werden." }
    }
  ]
};

const amalfiCoast = [
  { town: "Positano", where: "Private Garagen an der Ortsstraße (Mandara, De Gennaro); blaue Gemeindeparkplätze; kostenlose Plätze oben in Montepertuso und Nocelle", cost: "Garagen etwa €8-12/h, €50-90 pro Tag im Sommer. Blaue Linien etwa €3/h", notes: "Die Garagen im Zentrum sind im Juli und August bis zum Vormittag voll: vorher buchen. Die Ortsstraße ist eine Kamera-ZTL, lassen Sie das Kennzeichen von Garage oder Hotel registrieren." },
  { town: "Praiano", where: "Blaue Gemeindeparkplätze an der SS163 und den Ortsstraßen; privater Parkplatz in Marina di Praia", cost: "€3/h, €15 für 6 Std., €30 für 14 Std. (2026)", notes: "Gebührenpflichtig 08:00-22:00 Uhr von April bis Oktober, 08:00-20:00 Uhr von November bis März, auch an Feiertagen. Wenige weiße Plätze, viele davon für Anwohner." },
  { town: "Amalfi", where: "Luna Rossa (in den Fels zwischen Amalfi und Atrani gebaut, etwa 170 Plätze, Fußgängertunnel ins Zentrum); Berma; Hafenparkplätze Darsena und Flavio Gioia", cost: "Luna Rossa und Berma tagsüber etwa €5/h, nachts €4/h. Hafen tagsüber etwa €6/h. 2026: Aufschlag auf die ersten zwei Stunden am Tag", notes: "Luna Rossa: keine Autos mit Flüssiggas oder Erdgas, max. Höhe 2 m; Bargeld für den Kassenautomaten bereithalten. Im Sommer meist bis 10:00 Uhr voll. Die Altstadt ist ZTL." },
  { town: "Atrani", where: "Wenige blaue Plätze nahe dem Strand; Luna Rossa, dessen Tunnel auch nach Atrani führt", cost: "Blaue Linien etwa €2,50-3/h", notes: "Ein Ratgeber von 2026 nennt im Sommer ein Limit von 4 Stunden für Nicht-Anwohner und ein Parkverbot nachts (20:00-08:00 Uhr). Besser Luna Rossa nutzen." },
  { town: "Ravello", where: "Garage unter der Piazza Duomo (etwa 140 Plätze); Parkplatz des Auditorium Oscar Niemeyer; blaue Linien in der Via Boccaccio und Via della Repubblica", cost: "Piazza Duomo: laut Ratgebern von 2026 tagsüber etwa €5/h (ältere Listen: €2,50/h, €15 pro Tag). Auditorium: tagsüber etwa €4/h, nachts €2,50/h, €40 für 24 Std.", notes: "Das Zentrum ist ZTL. Straßenplätze nahe dem Zentrum können bis zu €5/h kosten. Die Garage an der Piazza Duomo kann bei Veranstaltungen und Hochzeiten schließen." },
  { town: "Minori", where: "Blaue Linien an der Uferpromenade; kleiner gebührenpflichtiger Parkplatz am Ende der Via Roma (etwa 20 Plätze)", cost: "Etwa €3/h", notes: "Die neuen Tarife für 2026 wurden im Februar 2026 beschlossen: maßgeblich ist der Automat. Im Sommer sehr wenige Plätze." },
  { town: "Maiori", where: "Blaue Linien entlang der Uferpromenade; Parkplatz am Hafen", cost: "Blaue Linien im Sommer etwa €3/h, werktags und feiertags. Hafen etwa €5/h", notes: "Kostenlose weiße Plätze in der Via Chiunzi (Straße nach Tramonti), weit vom Strand. Dank der langen Promenade einer der einfacheren Orte." },
  { town: "Cetara", where: "Parkplatz am Hafen (blaue Linien); Parkplatz Pastena im oberen Ortsteil (Via Cannillo)", cost: "Hafen etwa €3/h von März bis Oktober, €1,50/h von November bis Februar (eine Quelle nennt €4/h). Pastena etwa €3/h", notes: "Hafenparkplatz etwa 07:00-02:00 Uhr geöffnet. Ist er voll, kann die Zufahrt nach unten gesperrt werden und man wird zum Pastena geschickt." },
  { town: "Vietri sul Mare", where: "Piazza Matteotti; Bahnhofsparkplatz (etwa 150 Plätze); Piazza Mercato; blaue Linien an der Marina di Vietri", cost: "Piazza Matteotti €3 die erste Stunde, dann €1,50 je 30 Min. Bahnhof und Piazza Mercato etwa €2/h oder €20 pro Tag. Marina Juni-August werktags €2,50/h, am Wochenende €3/h", notes: "Das größte Parkplatzangebot der Küste. Nahe dem Bahnhof fährt ein kostenloser öffentlicher Aufzug. Die Piazza Matteotti ist in den frühen Morgenstunden kostenlos (genaues Zeitfenster am Automaten)." },
  { town: "Furore", where: "Parkplatz in Marina di Praia; blaue Linien im oberen Ortsteil", cost: "Etwa €2,50/h in Marina di Praia", notes: "Kein Parkplatz am Fiordo: etwa 2 km zu Fuß entlang der SS163. Nicht auf der Brücke anhalten." },
  { town: "Conca dei Marini", where: "Eine Handvoll blauer Gemeindeparkplätze", cost: "Ein Ratgeber von 2026 nennt €20 pro Tag; kein verlässlicher Stundentarif gefunden", notes: "Sehr wenige Plätze. Mit dem SITA-Bus ist es einfacher." },
];

const sorrentoPeninsula = [
  { town: "Sorrent", where: "Achille Lauro (Via Correale, unter der Piazza Lauro); Fuorimura Parking; Sorrento Parking (Via San Renato); Parcheggio Stinga (Via degli Aranci); Garage Marina Piccola am Hafen", cost: "Achille Lauro etwa €2-3/h, €24-30 pro Tag, unter 30 Min. kostenlos. Fuorimura etwa €2,50/h, ab €27 pro Tag. Sorrento Parking €3/h, ab €27 pro Tag. Marina Piccola etwa €26 für 6 Std., €32 für 24 Std. Blaue Linien €1 je 30 Min., €2/h", notes: "Kostenlose weiße Plätze in der Via Rota und Via Parsano, selten frei. Marina Piccola passt für einen Ausflug nach Capri. Das Zentrum ist abends und sonntags ZTL." },
  { town: "Sant'Agnello", where: "Blaue Linien in der Via Cocumella und am Viale dei Pini; Parkplatz am Bahnhof der Circumvesuviana (Piazzale Don Minzoni)", cost: "Tarif je nach Zone; keine verlässlichen aktuellen Zahlen gefunden", notes: "Eine Zugstation oder 15-20 Minuten zu Fuß vom Zentrum von Sorrent: eine ruhigere Basis als die Innenstadt." },
  { town: "Piano di Sorrento", where: "Blaue Linien, betrieben von SIS; Piazza della Repubblica; Parkplatz am Bahnhof der Circumvesuviana (Via Stazione)", cost: "Corso Italia und Piazza Cota €1,50/h. Die meisten Straßen €1/h, Randstraßen €0,50/h. Piazza della Repubblica: erste 30 Min. kostenlos, dann €1", notes: "Gebührenpflichtig Montag-Samstag 08:30-13:30 und 15:30-21:30 Uhr (Juni-September), 08:30-13:30 und 15:00-20:00 Uhr (Oktober-Mai). Die Mittagspause ist kostenlos." },
  { town: "Meta", where: "Strandparkplatz Marina di Meta mit Aufzug; blaue Linien im Ort (Zonen A, B, C)", cost: "Marina di Meta Juni-September €3/h oder €15 pro Tag (08:00-24:00 Uhr); März-Mai und Oktober €1,50/h oder €6 pro Tag; November-Februar €1/h. Blaue Linien im Ort etwa €1/h", notes: "Der Aufzug zum Strand kostet €1. Meta wendet im Zentrum eine eigene, umgekehrte Wechselkennzeichen-Regel an: siehe unseren Ratgeber." },
  { town: "Vico Equense", where: "Saisonparkplätze in Marina d'Aequa und Marina di Vico; blaue Linien im Zentrum", cost: "Marinas: €8 für die ersten 6 Std., dann €2/h (€10 für Autos mit mehr als 5 Sitzen); Abendtarif €5 ab 19:00 Uhr (Tarife 2025)", notes: "Die Hochsaison läuft vom 1. Juni bis 10. September. Vico hat einen Bahnhof der Circumvesuviana, ein guter Park-and-Ride-Punkt vor Sorrent." },
  { town: "Massa Lubrense (Marina del Cantone, Nerano)", where: "Blaue Gemeindeparkplätze; zwei kleine Parkplätze in Marina del Cantone; private Parkplätze, darunter Il Venione mit Shuttle", cost: "Blaue Linien €2/h von Mitte April bis Mitte Oktober (Beschluss von 2023), zuletzt etwa €3/h gemeldet. Parkplätze Marina del Cantone €3/h. Private etwa €10-25 pro Tag, reservierte Plätze in Nerano bis €50 pro Tag", notes: "Im August und an Wochenenden sind die Parkplätze bis 9:00 Uhr voll. 2025 öffnete die Gemeinde wegen des Platzmangels zusätzliche Behelfsparkplätze (Verordnung 79/2025)." },
  { town: "Sant'Agata sui Due Golfi", where: "Keine öffentlichen Parkplätze mit Namen gefunden", cost: "Keine verlässlichen veröffentlichten Tarife", notes: "Fragen Sie Ihre Unterkunft nach Parkmöglichkeiten. Ab Sorrent fahren Ortsbusse." },
];

const ztlData = [
  { location: "Positano", period: "Ganzjährig, Kameraschleusen", note: "Einbahnstraße durch den Ort (Via Pasitea, Piazza dei Mulini, Via Cristoforo Colombo) nur für berechtigte Fahrzeuge. Hotel- und Garagengäste brauchen ein registriertes Kennzeichen." },
  { location: "Amalfi", period: "Ganzjährig (Altstadt)", note: "Bei Luna Rossa, Berma oder am Hafen parken und zu Fuß hinein. Hotels können Gäste zum Ausladen anmelden." },
  { location: "Ravello", period: "Historisches Zentrum", note: "Garage an der Piazza Duomo oder Parkplatz des Auditoriums nutzen, beide knapp außerhalb der gesperrten Straßen." },
  { location: "Sorrent", period: "Abends ab 19:30 Uhr und sonntags (Zentrum)", note: "Die oben genannten Garagen bleiben erreichbar. Achten Sie auf die Schilder an den Zufahrten." },
  { location: "SS163 Amalfitana", period: "Ostern bis Oktober, 10:00-18:00 Uhr", note: "Wechselkennzeichen an festgelegten Tagen (ungerade Kennzeichen an ungeraden Daten). Motorräder und Roller ausgenommen." },
  { location: "Meta und SS145", period: "Frühjahr bis Oktober, festgelegte Tage", note: "Gemeindliche Wechselkennzeichen-Regeln, in Meta umgekehrt. Vor der Fahrt den Kalender prüfen." },
];
---

<BaseLayout
  title="Parken Amalfiküste 2026: Preise je Ort, Gratisparkplätze"
  description="Parken an der Amalfiküste und auf der Halbinsel Sorrent, Ort für Ort: Parkhäuser, Stunden- und Tagespreise, blaue Linien, wo es kostenlose weiße Parkplätze gibt, ZTL und Bußgelder."
  lang={lang}
  breadcrumbs={breadcrumbs}
  schema={[faqSchema]}
 pageKey="parken-ztl"
  heroImage="/images/parcheggi-hero.webp"
>

  <section class="relative h-[75vh] sm:h-[90vh] flex items-center bg-charcoal overflow-hidden">
    <img src="/images/parcheggi-hero.webp" alt="Sorrent, Halbinsel Sorrent" class="absolute inset-0 w-full h-full object-cover" loading="eager" fetchpriority="high" decoding="sync" referrerpolicy="no-referrer"/>
    <div class="absolute inset-0 bg-gradient-to-b from-black/25 via-black/40 to-black/75"></div>
    <div class="relative z-10 max-w-7xl mx-auto px-6 py-20">
      <div class="max-w-3xl">
        <p class="text-med-gold text-xs sm:text-sm font-medium uppercase tracking-[0.3em] mb-3">Reiseratgeber</p>
        <h1 class="font-serif text-display text-white mb-4">Parken an der Amalfiküste: Preise je Ort und kostenlose Plätze</h1>
        <p class="text-xl text-white/80 leading-relaxed">
          Parkplätze sind knapp und fast überall gebührenpflichtig. Hier finden Sie die Parkplätze Ort für Ort, was sie kosten, wo es noch kostenlose weiße Parkflächen gibt und wie die ZTL-Regeln funktionieren.
        </p>
      </div>
    </div>
    <Breadcrumbs breadcrumbs={breadcrumbs} />
  </section>

  <div class="max-w-editorial mx-auto px-4 sm:px-6 lg:px-8 pt-0 pb-4 space-y-12">

    <section class="max-w-editorial">
      <div style="background-color: #E2725B; border-color: #E2725B; padding: 6px 12px 6px 12px;" class="border rounded-[2rem] mb-6 mt-8">
        <p class="font-semibold mb-0 mt-0 text-white text-sm leading-tight" style="margin-top: -2px;">⚠️ ZTL-Warnung</p>
        <p class="text-xs text-white/95 leading-tight">ZTL-Zonen an der Amalfiküste werden mit Kameras überwacht. Einfahren ohne Genehmigung kostet ab €87 (Beträge 2026), und das Bußgeld erreicht die Mietwagenfirma oder Ihre Heimatadresse Monate später, oft mit einer zusätzlichen Bearbeitungsgebühr.</p>
      </div>
      <p class="text-xl leading-relaxed text-charcoal">
        Am besten besuchen Sie die Küste mit dem Auto nach dem Prinzip „strategisches Parken": Lassen Sie das Auto dort stehen, wo Plätze leichter zu finden sind (Vietri, Salerno, Sorrent, ein Bahnhof der Circumvesuviana oder Praiano), und fahren Sie mit Bus, Fähre oder Tragflügelboot weiter. Wenn Sie doch in die Orte fahren, zeigen Ihnen die Tabellen unten, wohin und mit welchen Kosten.
      </p>
      <p class="text-sm text-slate-500 leading-relaxed mt-4">
        Ungefähre Preise, im Oktober 2026 bei Betreibern, Gemeinden und in der Lokalpresse mit Daten von 2023-2026 erhoben. Die Tarife ändern sich jede Saison: Maßgeblich ist das Schild am Parkplatz oder Automaten.
      </p>
    </section>

    <section id="linien">
      <h2 class="font-serif text-2xl font-semibold text-slate-900 mb-6">Blaue, weiße und gelbe Linien: was sie bedeuten</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4 sm:gap-6">
        <div class="bg-med-cream rounded-[2rem] p-5 sm:p-6 border border-slate-100">
          <div class="w-12 h-1.5 rounded-full mb-3" style="background-color: #2563eb;"></div>
          <h3 class="font-semibold text-charcoal text-sm mb-2">Blaue Linien: gebührenpflichtig</h3>
          <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">Am Automaten (Münzen, oft Karte) oder per App wie EasyPark zahlen und das Ticket sichtbar hinlegen. Zeiten und Tarife stehen auf dem Schild; außerhalb dieser Zeiten ist Parken meist kostenlos.</p>
        </div>
        <div class="bg-med-cream rounded-[2rem] p-5 sm:p-6 border border-slate-100">
          <div class="w-12 h-1.5 rounded-full mb-3 bg-white border border-slate-300"></div>
          <h3 class="font-semibold text-charcoal text-sm mb-2">Weiße Linien: kostenlos</h3>
          <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">Kostenlos, sofern das Schild keine Einschränkung nennt: Parkscheibe (disco orario), nur Anwohner, Straßenreinigung oder Abschleppzeiten. Lesen Sie das Schild, bevor Sie gehen.</p>
        </div>
        <div class="bg-med-cream rounded-[2rem] p-5 sm:p-6 border border-slate-100">
          <div class="w-12 h-1.5 rounded-full mb-3" style="background-color: #eab308;"></div>
          <h3 class="font-semibold text-charcoal text-sm mb-2">Gelbe Linien: reserviert</h3>
          <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">Anwohner mit Genehmigung, Inhaber eines Behindertenausweises, Lieferzonen, Taxis und Busse. Ohne passende Genehmigung nie hier parken, auch nicht für fünf Minuten.</p>
        </div>
      </div>
    </section>

    <section id="kostenlos-parken">
      <h2 class="font-serif text-2xl font-semibold text-slate-900 mb-6">Kostenlos parken (weiße Linien): die ehrliche Lage</h2>
      <p class="text-lg leading-relaxed text-charcoal mb-6">
        Kostenlose Parkplätze sind an der Amalfiküste selten. In den Ortszentren ist fast jeder Platz blau oder gelb, und die wenigen weißen Flächen sind oft per kleinem Schild Anwohnern vorbehalten. Die kostenlosen Plätze liegen am Rand, oben am Hang oder an der Hauptstraße, und im Juli und August sind sie meist bis 9:00 Uhr weg. Im Mai, Anfang Juni und im Oktober, an einem Werktagmorgen, stehen die Chancen gut.
      </p>
      <h3 class="font-semibold text-charcoal mb-3">Wo es weiße Parkflächen gibt</h3>
      <ul class="space-y-3 mb-6">
        <li class="flex items-start gap-3"><span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span><span class="text-slate-700"><strong>Positano.</strong> Montepertuso und Nocelle, in den Hügeln oberhalb des Ortes. Von dort mit dem Ortsbus Flavio Gioia hinunter oder zu Fuß (etwa 35 Minuten).</span></li>
        <li class="flex items-start gap-3"><span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span><span class="text-slate-700"><strong>Amalfi.</strong> Abschnitte am Straßenrand der SS163 etwa 1,5 km vor dem Zentrum aus Richtung Positano und an der Straße nach Agerola (SS366) etwa 1 km oberhalb des Ortes. Der Fußweg zurück führt an der Straße entlang, mit wenig oder keinem Gehweg.</span></li>
        <li class="flex items-start gap-3"><span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span><span class="text-slate-700"><strong>Maiori.</strong> Via Chiunzi, die Straße Richtung Tramonti, weit weg von der Promenade.</span></li>
        <li class="flex items-start gap-3"><span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span><span class="text-slate-700"><strong>Praiano.</strong> Vereinzelte Plätze entlang der Straße. Viele sind für Anwohner: Das Schild zeigt, wo der reservierte Abschnitt beginnt.</span></li>
        <li class="flex items-start gap-3"><span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span><span class="text-slate-700"><strong>Sorrent.</strong> Via Rota (weit vom Zentrum) und Via Parsano (nahe dem Corso Italia). In der Saison selten frei.</span></li>
      </ul>
      <h3 class="font-semibold text-charcoal mb-3">Regeln, Bußgelder und Abschleppen</h3>
      <ul class="space-y-3">
        <li class="flex items-start gap-3"><span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span><span class="text-slate-700"><strong>Parkscheibe.</strong> Wo das Schild eine Parkscheibe und ein Zeitlimit zeigt, stellen Sie die blaue Scheibe (disco orario) auf Ihre Ankunftszeit, aufgerundet auf die nächste halbe Stunde, und legen sie aufs Armaturenbrett. Mietwagen haben nicht immer eine: Sie kostet ein paar Euro am Kiosk oder an der Tankstelle.</span></li>
        <li class="flex items-start gap-3"><span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span><span class="text-slate-700"><strong>Bußgelder.</strong> Parken auf gelben Plätzen, Überschreiten der Zeit auf blauen oder fehlende Parkscheibe beginnen bei etwa €42. Behindertenparkplätze und ZTL-Einfahrten kosten deutlich mehr.</span></li>
        <li class="flex items-start gap-3"><span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span><span class="text-slate-700"><strong>Abschleppen.</strong> Wo das Schild „zona rimozione" zeigt, kann das Auto abgeschleppt werden, und Sie zahlen Bußgeld, Abschleppen und Verwahrung. Im Sommer kontrolliert die Ortspolizei viel, vor allem auf der SS163, wo ein falsch geparktes Auto die Busse blockiert.</span></li>
        <li class="flex items-start gap-3"><span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span><span class="text-slate-700"><strong>Nie am Fahrbahnrand.</strong> Ein Auto, das halb auf der SS163 außerhalb markierter Flächen steht, wird schnell verwarnt und kann entfernt werden. Keine Markierung, kein Parkplatz.</span></li>
      </ul>
    </section>

    <section id="amalfikueste">
