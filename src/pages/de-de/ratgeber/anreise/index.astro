---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../../components/Breadcrumbs.astro';
import { getTranslations, getLocalePath } from '../../../../i18n/translations';

const lang = 'de-de';
const t = getTranslations(lang);

const breadcrumbs = [
  { name: 'Home', url: '/de-de/' },
  { name: 'Planung', url: '/de-de/planung/' },
  { name: 'Anreise', url: '/de-de/ratgeber/anreise/' },
];
---

<BaseLayout
  title={t.meta.getting_here_title}
  description={t.meta.getting_here_description}
  lang={lang}
  breadcrumbs={breadcrumbs}
  pageKey="anreise"
  heroImage="/images/come-arrivare-hero.jpg"
>
  <!-- Hero -->
  <section class="relative h-[75vh] sm:h-[90vh] flex items-center bg-charcoal overflow-hidden">
    <img src="/images/come-arrivare-hero.jpg" alt="Hafen von Sorrent, Amalfiküste" class="absolute inset-0 w-full h-full object-cover" loading="eager" fetchpriority="high" decoding="sync" referrerpolicy="no-referrer"/>
    <div class="absolute inset-0 bg-gradient-to-b from-black/25 via-black/40 to-black/75"></div>
    <div class="relative z-10 max-w-7xl mx-auto px-6 text-center">
      <p class="text-med-gold text-xs sm:text-sm uppercase tracking-[0.3em] mb-3 font-medium">Praktischer Ratgeber</p>
      <h1 class="font-serif text-4xl md:text-5xl font-bold text-white mb-4 tracking-tight">Anreise zur Amalfiküste</h1>
      <p class="text-white/80 text-lg max-w-2xl mx-auto font-light">Zug, Flugzeug, Fähre oder Auto: alle Möglichkeiten, um die Küste aus Italien und dem Ausland zu erreichen.</p>
    </div>
    <Breadcrumbs breadcrumbs={breadcrumbs} />
  </section>

  <section class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <p class="text-base sm:text-lg text-slate-600 leading-relaxed">
      Die Amalfiküste hat weder einen eigenen Flughafen noch einen Bahnhof an ihrer Hauptstrecke. Der bequemste Weg, sie zu erreichen, führt über Neapel (internationaler Flughafen und Hochgeschwindigkeitsbahnhof) oder Salerno (per Zug aus ganz Italien erreichbar). Von dort gibt es Fähren, Busse und private Transfers.
    </p>
  </section>

  <!-- Unser Tipp -->
  <section class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 pb-12">
    <div class="bg-slate-900 rounded-[2rem] p-6 sm:p-8">
      <div class="flex items-start gap-4">
        <div class="w-10 h-10 rounded-xl bg-med-gold/15 flex items-center justify-center flex-shrink-0 mt-1">
          <svg class="w-5 h-5 text-med-gold" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 18v-5.25m0 0a6.01 6.01 0 0 0 1.5-.189m-1.5.189a6.01 6.01 0 0 1-1.5-.189m3.75 7.478a12.06 12.06 0 0 1-4.5 0m3.75 2.383a14.406 14.406 0 0 1-3 0M14.25 18v-.192c0-.983.658-1.823 1.508-2.316a7.5 7.5 0 1 0-7.517 0c.85.493 1.509 1.333 1.509 2.316V18"/></svg>
        </div>
        <div>
          <p class="text-med-gold text-xs font-bold uppercase tracking-wider mb-2">Unser Tipp</p>
          <p class="text-white/80 text-sm sm:text-base leading-relaxed"><strong class="text-white">Hochsaison (Mai–Okt):</strong> Fliegen Sie nach Neapel und nehmen Sie die Direktfähre nach Positano oder Amalfi. Kein Stau, atemberaubende Aussichten.</p>
          <p class="text-white/80 text-sm sm:text-base leading-relaxed mt-2"><strong class="text-white">Nebensaison (Nov–Apr):</strong> Hochgeschwindigkeitszug bis Salerno + SITA Bus. Günstiger und die Fähren fahren nicht.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Schnellvergleich -->
  <section class="bg-slate-900 py-16">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-[10px] uppercase tracking-[0.3em] text-med-gold font-medium mb-3">Schnellvergleich</p>
      <h2 class="text-2xl font-bold font-serif text-white mb-10">Welches Verkehrsmittel wählen?</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-4">

        <div class="bg-white/5 border border-med-gold/30 rounded-2xl p-5 relative">
          <span class="absolute -top-3 left-4 bg-med-gold text-white text-[10px] font-bold uppercase tracking-wider px-3 py-1 rounded-full">Empfohlen</span>
          <div class="mt-2">
            <p class="text-white font-bold text-lg mb-1">Fähre</p>
            <p class="text-white/40 text-xs mb-4">Apr – Okt</p>
            <div class="space-y-2 text-xs text-white/60">
              <p><span class="text-white/80 font-medium">Kosten:</span> €15 – €25</p>
              <p><span class="text-white/80 font-medium">Zeit:</span> 1h – 1h30</p>
              <p><span class="text-white/80 font-medium">Komfort:</span> <span class="text-med-gold">Hoch</span></p>
              <p><span class="text-white/80 font-medium">Stau/Verkehr:</span> Kein</p>
            </div>
          </div>
        </div>

        <div class="bg-white/5 border border-white/10 rounded-2xl p-5">
          <p class="text-white font-bold text-lg mb-1">Zug + Bus</p>
          <p class="text-white/40 text-xs mb-4">Ganzjährig</p>
          <div class="space-y-2 text-xs text-white/60">
            <p><span class="text-white/80 font-medium">Kosten:</span> €6 – €10</p>
            <p><span class="text-white/80 font-medium">Zeit:</span> 2h30 – 3h</p>
            <p><span class="text-white/80 font-medium">Komfort:</span> Mittel</p>
            <p><span class="text-white/80 font-medium">Stau/Verkehr:</span> Möglich im Bus</p>
          </div>
        </div>

        <div class="bg-white/5 border border-white/10 rounded-2xl p-5">
          <p class="text-white font-bold text-lg mb-1">Privattransfer</p>
          <p class="text-white/40 text-xs mb-4">Ganzjährig</p>
          <div class="space-y-2 text-xs text-white/60">
            <p><span class="text-white/80 font-medium">Kosten:</span> €90 – €150</p>
            <p><span class="text-white/80 font-medium">Zeit:</span> 1h – 1h30</p>
            <p><span class="text-white/80 font-medium">Komfort:</span> <span class="text-med-gold">Hoch</span></p>
            <p><span class="text-white/80 font-medium">Stau/Verkehr:</span> Möglich</p>
          </div>
        </div>

        <div class="bg-white/5 border border-white/10 rounded-2xl p-5">
          <p class="text-white font-bold text-lg mb-1">Eigenes Auto</p>
          <p class="text-white/40 text-xs mb-4">Nur Nebensaison</p>
          <div class="space-y-2 text-xs text-white/60">
            <p><span class="text-white/80 font-medium">Kosten:</span> Kraftstoff + Parken</p>
            <p><span class="text-white/80 font-medium">Zeit:</span> Variabel</p>
            <p><span class="text-white/80 font-medium">Komfort:</span> Mittel</p>
            <p><span class="text-white/80 font-medium">Stau/Verkehr:</span> <span class="text-red-400">Stark im Sommer</span></p>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- Verkehrsmittel -->
  <section class="py-16">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">

      <!-- Ab Neapel -->
      <div class="bg-white rounded-[2rem] shadow-sm border border-slate-100 p-6 sm:p-8">
        <div class="flex items-center gap-4 mb-6">
          <div class="w-12 h-12 bg-med-gold rounded-2xl flex items-center justify-center">
            <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"/></svg>
          </div>
          <div>
            <h2 class="text-2xl font-bold font-serif">Ab Neapel</h2>
            <p class="text-med-gold text-xs sm:text-sm">Flughafen Capodichino · Neapel Hauptbahnhof</p>
          </div>
        </div>
        <p class="text-slate-600 leading-relaxed mb-6">
          Neapel ist das wichtigste Einfallstor zur Amalfiküste. Der internationale Flughafen Neapel-Capodichino (NAP) hat Direktflüge aus allen wichtigen europäischen Städten, darunter viele Billigflüge aus Rom, Mailand, London, Paris, Frankfurt und Madrid. Von Neapel gibt es drei Möglichkeiten, die Küste zu erreichen:
        </p>
        <div class="space-y-4">
          <div class="bg-med-gold/5 rounded-2xl p-4 sm:p-5">
            <h3 class="font-semibold text-slate-900 mb-2">Direktfähre (Sommer)</h3>
            <p class="text-slate-600 text-xs sm:text-sm">Von April bis Oktober fahren Schnellfähren vom Neapler Molo Beverello direkt nach Positano und Amalfi in etwa 1h30. Komfortabel, malerisch und staufrei. In der Hochsaison im Voraus buchen.</p>
          </div>
          <div class="bg-med-gold/5 rounded-2xl p-4 sm:p-5">
            <h3 class="font-semibold text-slate-900 mb-2">SITA Bus über Sorrent</h3>
            <p class="text-slate-600 text-xs sm:text-sm">Circumvesuviana von Neapel nach Sorrent (ca. 1h), dann SITA Bus entlang der Küste. Günstig aber langsam (2h30–3h gesamt). Gute Option, wenn Sie das Autofahren vermeiden möchten.</p>
          </div>
          <div class="bg-med-gold/5 rounded-2xl p-4 sm:p-5">
            <h3 class="font-semibold text-slate-900 mb-2">Privattransfer</h3>
            <p class="text-slate-600 text-xs sm:text-sm">Taxi oder NCC vom Flughafen Neapel: ca. 90–120 Euro bis Positano/Amalfi (1h–1h30 ohne Stau). Praktisch für Familien oder mit viel Gepäck.</p>
          </div>
        </div>
      </div>

      <!-- Ab Salerno -->
      <div class="bg-white rounded-[2rem] shadow-sm border border-slate-100 p-6 sm:p-8">
        <div class="flex items-center gap-4 mb-6">
          <div class="w-12 h-12 bg-med-gold rounded-2xl flex items-center justify-center">
            <svg class="w-6 h-6 text-white" fill="currentColor" viewBox="0 0 24 24"><rect x="2" y="7" width="20" height="10" rx="1"/><rect x="4" y="17" width="3" height="2"/><rect x="17" y="17" width="3" height="2"/><path d="M2 7L4 2h16l2 5"/></svg>
          </div>
          <div>
            <h2 class="text-2xl font-bold font-serif">Ab Salerno</h2>
            <p class="text-med-gold text-xs sm:text-sm">Östliches Eingangstor zur Amalfiküste</p>
          </div>
        </div>
        <p class="text-slate-600 leading-relaxed mb-6">
          Salerno ist ein oft unterschätzter, aber sehr bequemer Ausgangspunkt. Der Bahnhof Salerno wird von Hochgeschwindigkeitszügen bedient (1h40 ab Rom, 2h30 ab Mailand) und von vielen Regionalzügen. Der Flughafen Salerno-Amalfiküste (QSR) ist der nächstgelegene Flughafen zur Küste, mit nationalen und einigen europäischen Verbindungen. Ab Salerno fährt der SITA Bus zur Küste häufig und braucht 45 Minuten bis Amalfi. Im Sommer gibt es auch Fähren.
        </p>
        <div class="space-y-4">
          <div class="bg-med-gold/5 rounded-2xl p-4 sm:p-5">
            <h3 class="font-semibold text-slate-900 mb-2">Flughafen Salerno-Amalfiküste (QSR)</h3>
            <p class="text-slate-600 text-xs sm:text-sm">Der nächstgelegene Flughafen zur Amalfiküste, nur 20 km von Vietri sul Mare entfernt. Flüge aus Mailand, Rom und einigen europäischen Städten. Vom Flughafen erreichen Bus oder Privattransfer die Küste in etwa 30 Minuten.</p>
          </div>
          <div class="bg-med-gold/5 rounded-2xl p-4 sm:p-5">
            <h3 class="font-semibold text-slate-900 mb-2">Fähre ab Salerno (Sommer)</h3>
            <p class="text-slate-600 text-xs sm:text-sm">Fähren von Salerno nach Amalfi und Positano von April bis Oktober. Etwa 45 Minuten bis Amalfi, mit wunderschönen Küstenansichten. Günstiger als Fähren ab Neapel.</p>
          </div>
        </div>
      </div>

      <!-- Ab Sorrent -->
      <div class="bg-white rounded-[2rem] shadow-sm border border-slate-100 p-6 sm:p-8">
        <div class="flex items-center gap-4 mb-6">
          <div class="w-12 h-12 bg-med-gold rounded-2xl flex items-center justify-center">
            <svg class="w-6 h-6 text-white" fill="currentColor" viewBox="0 0 24 24"><path d="M3 13h18v2H3zm0-4h18v2H3zm0 8h18v2H3zm9-12L6 8h12l-6-3zm0 14l-6 3h12l-6-3z"/></svg>
          </div>
          <div>
            <h2 class="text-2xl font-bold font-serif">Ab Sorrent</h2>
            <p class="text-med-gold text-xs sm:text-sm">Per Fähre oder Panoramastraße</p>
          </div>
        </div>
        <p class="text-slate-600 leading-relaxed">
          Sorrent ist ein beliebter Ausgangspunkt für Ausflüge sowohl zur Sorrentiner Halbinsel als auch zur Amalfiküste. Fähren von Sorrent erreichen Positano in 25 Minuten: das ist der malerischste und schnellste Weg, die Küste zu betreten. Alternativ folgt der SITA Bus der SP145 und SS163 für etwa 1h30 bis Amalfi.
        </p>
      </div>

      <!-- Mit dem Auto -->
      <div class="bg-white rounded-[2rem] shadow-sm border border-slate-100 p-6 sm:p-8">
        <div class="flex items-center gap-4 mb-6">
          <div class="w-12 h-12 bg-med-gold rounded-2xl flex items-center justify-center">
            <svg class="w-6 h-6 text-white" fill="currentColor" viewBox="0 0 24 24"><path d="M18.92 6.01C18.72 5.42 18.16 5 17.5 5h-11c-.66 0-1.22.42-1.42 1.01L3 12v8c0 .55.45 1 1 1h1c.55 0 1-.45 1-1v-1h12v1c0 .55.45 1 1 1h1c.55 0 1-.45 1-1v-8l-2.08-5.99zM6.5 16c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2zm11 0c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2z"/></svg>
          </div>
          <div>
            <h2 class="text-2xl font-bold font-serif">Mit dem Auto</h2>
            <p class="text-med-gold text-xs sm:text-sm font-medium">⚠️ Im Juli und August nicht empfohlen</p>
          </div>
        </div>
        <p class="text-slate-600 leading-relaxed mb-6">
          Die SS163, die Küstenstraße durch die Amalfiküste, ist eine der spektakulärsten Straßen Europas, aber auch eine der engsten. In der Hochsaison kann der Verkehr lähmend sein, mit stundenlangen Staus. Wenn Sie mit dem Auto fahren, beachten Sie diese Tipps:
        </p>
        <ul class="space-y-3">
          <li class="flex gap-3 text-xs sm:text-sm text-slate-600">
            <svg class="w-5 h-5 text-med-gold flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
            Abfahrt vor 8 Uhr morgens oder nach 19 Uhr, um den schlimmsten Stau zu vermeiden
          </li>
          <li class="flex gap-3 text-xs sm:text-sm text-slate-600">
            <svg class="w-5 h-5 text-med-gold flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
            In Sorrent oder Salerno parken und öffentliche Verkehrsmittel oder Fähren entlang der Küste nutzen
          </li>
          <li class="flex gap-3 text-xs sm:text-sm text-slate-600">
            <svg class="w-5 h-5 text-med-gold flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
            Parkplätze in Amalfi und Positano kosten 3–5 Euro/Stunde und sind in der Hochsaison oft ausgebucht
          </li>
          <li class="flex gap-3 text-xs sm:text-sm text-slate-600">
            <svg class="w-5 h-5 text-med-gold flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
            Im Frühling (April–Mai) und Herbst (September–Oktober) ist das Autofahren angenehm und problemlos
          </li>
        </ul>
      </div>

    </div>
  </section>

  <!-- Woher reisen Sie an? -->
  <section class="pb-16">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl font-bold font-serif text-slate-900 mb-8">Woher reisen Sie an?</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4 sm:gap-6">

        <div class="bg-white rounded-[2rem] shadow-sm border border-slate-100 p-6">
          <p class="text-med-gold text-xs font-bold uppercase tracking-wider mb-3">Ab Rom</p>
          <ul class="space-y-2 text-slate-600 text-xs sm:text-sm">
            <li class="flex gap-2"><span class="text-med-gold font-bold">1.</span> Hochgeschwindigkeitszug Rom – Salerno (1h40, ab €19)</li>
            <li class="flex gap-2"><span class="text-med-gold font-bold">2.</span> SITA Bus Salerno – Amalfi (45 Min., €2.40)</li>
            <li class="flex gap-2"><span class="text-slate-400 text-xs">Gesamt: ca. 2h30 – der schnellste Weg</span></li>
          </ul>
        </div>

        <div class="bg-white rounded-[2rem] shadow-sm border border-slate-100 p-6">
          <p class="text-med-blue text-xs font-bold uppercase tracking-wider mb-3">Ab Mailand</p>
          <ul class="space-y-2 text-slate-600 text-xs sm:text-sm">
            <li class="flex gap-2"><span class="text-med-blue font-bold">A.</span> Flug Mailand – Neapel (1h15, ab €30) + Fähre</li>
            <li class="flex gap-2"><span class="text-med-blue font-bold">B.</span> Flug Mailand – Salerno (1h20) – nächstgelegener Flughafen zur Küste</li>
            <li class="flex gap-2"><span class="text-med-blue font-bold">C.</span> Hochgeschwindigkeitszug Mailand – Salerno (4h30, ab €39) + Bus</li>
            <li class="flex gap-2"><span class="text-slate-400 text-xs">Salerno ist näher, Neapel hat mehr Flüge</span></li>
          </ul>
        </div>

        <div class="bg-white rounded-[2rem] shadow-sm border border-slate-100 p-6">
          <p class="text-slate-500 text-xs font-bold uppercase tracking-wider mb-3">Aus dem Ausland</p>
          <ul class="space-y-2 text-slate-600 text-xs sm:text-sm">
            <li class="flex gap-2"><span class="text-slate-400 font-bold">✈</span> Fliegen Sie nach Neapel (NAP) – Direktflüge aus London, Paris, Berlin, Madrid, Amsterdam</li>
            <li class="flex gap-2"><span class="text-slate-400 font-bold">✈</span> Salerno (QSR) – Flughafen Amalfiküste, der nächstgelegene zur Küste</li>
            <li class="flex gap-2"><span class="text-slate-400 font-bold">✈</span> Alternative: Rom Fiumicino + Hochgeschwindigkeitszug nach Salerno</li>
            <li class="flex gap-2"><span class="text-slate-400 text-xs">Salerno ist näher, Neapel hat mehr Billigflüge, Rom mehr Interkontinentalverbindungen</span></li>
          </ul>
        </div>

      </div>
    </div>
  </section>

  <!-- Entfernungen und Reisezeiten - Tabs -->
  <section class="bg-slate-100 py-16">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl font-bold font-serif text-slate-900 mb-8 text-center">Entfernungen und Reisezeiten</h2>

      <!-- Tab-Schaltflächen -->
      <div class="flex flex-wrap justify-center gap-2 mb-8" role="tablist">
        <button role="tab" aria-selected="true" data-tab="costiera" class="tab-btn px-4 py-2 rounded-full text-xs sm:text-sm font-medium bg-slate-900 text-white transition-colors">Amalfiküste</button>
        <button role="tab" aria-selected="false" data-tab="penisola" class="tab-btn px-4 py-2 rounded-full text-xs sm:text-sm font-medium bg-white text-slate-600 hover:bg-slate-200 transition-colors">Sorrentiner Halbinsel</button>
        <button role="tab" aria-selected="false" data-tab="isole" class="tab-btn px-4 py-2 rounded-full text-xs sm:text-sm font-medium bg-white text-slate-600 hover:bg-slate-200 transition-colors">Inseln</button>
      </div>

      <!-- Tab: Amalfiküste -->
      <div data-panel="costiera" class="tab-panel">
        <div class="overflow-x-auto">
          <table class="w-full bg-white rounded-2xl shadow-sm overflow-hidden">
            <thead class="bg-slate-900 text-white">
              <tr>
                <th class="px-3 py-2 sm:px-6 sm:py-4 text-left text-xs sm:text-sm font-semibold">Von</th>
                <th class="px-3 py-2 sm:px-6 sm:py-4 text-left text-xs sm:text-sm font-semibold">Nach</th>
                <th class="px-3 py-2 sm:px-6 sm:py-4 text-left text-xs sm:text-sm font-semibold">Verkehrsmittel</th>
                <th class="px-3 py-2 sm:px-6 sm:py-4 text-left text-xs sm:text-sm font-semibold">Zeit</th>
                <th class="px-3 py-2 sm:px-6 sm:py-4 text-left text-xs sm:text-sm font-semibold">Preis</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
            <!-- Positano -->
            <tr class="hover:bg-slate-50">
              <td class="px-3 py-2 sm:px-6 sm:py-4 text-xs sm:text-sm">Neapel (Beverello)</td>
              <td class="px-3 py-2 sm:px-6 sm:py-4 text-xs sm:text-sm font-medium">Positano</td>
              <td class="px-3 py-2 sm:px-6 sm:py-4 text-xs sm:text-sm">Fähre (Sommer)</td>
              <td class="px-3 py-2 sm:px-6 sm:py-4 text-xs sm:text-sm text-med-gold font-medium">1h 30min</td>
