---
import BlogPostLayout from '../../../../layouts/BlogPostLayout.astro';

const lang = 'de-de';
const post = {
  title: 'Punta Campanella',
  subtitle: 'Wo Mythos auf zwei Golfe trifft',
  category: 'ENTDECKUNGEN',
  date: '10. Mai 2026',
  readTime: '10 min',
  image: '/images/punta-campanella-hero.jpg',
  imageAlt: 'Punta Campanella - Massa Lubrense, Halbinsel von Sorrent',
  path: '/de-de/blog/punta-campanella/',
};

const metaTitle = 'Punta Campanella: Wandern, Archäologie und der Mythos des Odysseus 2026';
const metaDescription = 'Kompletter Guide zu Punta Campanella: Trekking auf der Halbinsel von Sorrent mit Blick auf Capri, Tempel der Athena, mittelalterlicher Wachturm und Odysseus-Legenden.';

const breadcrumbs = [
  { name: 'Startseite', url: '/de-de/' },
  { name: 'Blog', url: '/de-de/blog/' },
  { name: 'Punta Campanella', url: '/de-de/blog/punta-campanella/' },
];

const quickInfo = [
  { label: 'Startpunkt', value: 'Piazza di Termini (Massa Lubrense)' },
  { label: 'Schwierigkeit', value: 'E (Wandern) - Leicht/Mittel' },
  { label: 'Dauer', value: 'Ca. 1 Stunde (pro Weg)' },
  { label: 'Ausrüstung', value: 'Wanderschuhe, Wasser, Hut' },
  { label: 'Zugang', value: 'Kostenlos (Meeresschutzgebiet)' },
  { label: 'Ausblick', value: 'Capri, Golf von Neapel, Amalfiküste' },
  { label: 'Was zu sehen', value: 'Tempel der Athena, Glockenturm, Faraglioni, Bucht von Ieranto' },
  { label: 'Beste Zeit', value: 'April - Oktober (Spektakulärer Sonnenuntergang)' },
];

const faq = [
  {
    q: 'Kann ich mit dem Auto zur Punta Campanella fahren?',
    a: 'Nein, es ist ein Wanderpfad. Parken Sie Ihr Auto in Termini und gehen Sie zu Fuß weiter.',
  },
  {
    q: 'Kann ich an der Punta Campanella schwimmen?',
    a: 'Ja, aber es gibt keine Sandstrände. Der Zugang zum Meer erfolgt über Felsen und Klippen. Empfohlen nur für erfahrene Schwimmer aufgrund starker Strömungen an der Grenze der beiden Golfe.',
  },
  {
    q: 'Ist es für Kinder geeignet?',
    a: 'Ja, der Hauptweg ist breit und sicher, aber vermeiden Sie die heißesten Tageszeiten, da es sehr wenig Schatten gibt.',
  },
  {
    q: 'Wann ist die beste Zeit für den Sonnenuntergang?',
    a: 'In der Hochsaison (Mai-September) verschwindet die Sonne direkt neben Capris Faraglioni gegen 19-20 Uhr. Bringen Sie eine Stirnlampe für den Rückweg mit.',
  },
  {
    q: 'Was ist die Odysseus-Legende?',
    a: 'Nach der griechischen Mythologie ist dies der Ort, wo Odysseus den Sirenen begegnete. Um ihrem Gesang zu widerstehen, ließ er sich am Mast seines Schiffes festbinden.',
  },
  {
    q: 'Gibt es Zugang zur Bucht von Ieranto von Punta Campanella?',
    a: 'Ja, von der Hauptgabelung können Sie zur Bucht von Ieranto abbiegen (für erfahrene Wanderer). Sie ist eine unberührte Bucht im Besitz des FAI mit Wasser primärer Klarheit.',
  },
];

const sidebarLinks = [
  { label: 'Wandern & Pfad der Götter', href: '/de-de/erlebnisse/trekking/' },
  { label: 'Entdecken Sie Massa Lubrense', href: '/de-de/sorrento-peninsula/massa-lubrense/' },
  { label: 'Bucht von Ieranto', href: '/de-de/beaches/sorrento-peninsula/ieranto/' },
  { label: 'Beste Reisezeit', href: '/de-de/beste-reisezeit/' },
  { label: 'Anreise', href: '/de-de/anreise/' },
];

const relatedArticles = [
  {
    title: 'Valle delle Ferriere',
    category: 'ENTDECKUNGEN',
    date: '22. April 2026',
    image: '/images/valle-ferriere-hero.jpg',
    imageAlt: 'Wasserfall in der Valle delle Ferriere, Amalfi - Amalfiküste',
    path: '/de-de/blog/valle-delle-ferriere/'
  },
  {
    title: 'Atrani',
    category: 'ENTDECKUNGEN',
    date: '22. April 2026',
    image: '/images/atrani-hero.jpg',
    imageAlt: 'Atrani - Italiens kleinstes Dorf an der Amalfiküste',
    path: '/de-de/blog/atrani/'
  }
];

const authorRole = 'Abenteuer- & Geschichtsführer · Halbinsel von Sorrent';

const keyTakeaways = [
  'Punta Campanella ist der Ort, wo Geografie zur Geschichte wird: die heilige Grenze zwischen dem Golf von Neapel und dem Golf von Salerno mit 360-Grad-Aussicht.',
  'Der majestätische Tempel der Athena (später von Römern Minerva geweiht) stand hier als Leuchtfeuer der antiken Zivilisation; heute ragen archäologische Überreste aus der mediterranen Vegetation hervor.',
  'Der Name "Campanella" stammt vom Wachturm des 14. Jahrhunderts mit einer Glocke, die Alarm gegen Sarazenen-Überfälle schlug.',
  'Der Wanderweg ist klassifiziert als E (Wandern): etwa 1 Stunde von Termini. Kostenloser Zugang zum Meeresschutzgebiet. 360-Grad-Aussicht: Vesuv, Sorrentiner Küste, Amalfiküste, Capri und Li Galli Inseln.',
  'Der Sonnenuntergang an Punta Campanella ist ein mystisches Erlebnis: die Sonne versinkt direkt neben Capris Faraglioni und färbt das Meer golden.',
];

const videoSchema = {
  "@context": "https://schema.org",
  "@type": "VideoObject",
  "name": "Punta Campanella: Wo Mythos auf zwei Golfe trifft",
  "description": "Video der Punta Campanella Location auf der Halbinsel von Sorrent mit 360-Grad-Aussicht über zwei Golfe, Archäologie und Odysseus-Legenden.",
  "thumbnailUrl": "/images/punta-campanella-hero.jpg",
  "uploadDate": "2026-05-10",
  "duration": "PT0M30S",
  "contentUrl": "/videos/punta-campanella-video.mp4",
  "videoDetails": {
    "width": "1280",
    "height": "720"
  }
};
---

<BlogPostLayout
  lang={lang}
  post={post}
  metaTitle={metaTitle}
  metaDescription={metaDescription}
  breadcrumbs={breadcrumbs}
  quickInfo={quickInfo}
  faq={faq}
  sidebarLinks={sidebarLinks}
  authorRole={authorRole}
  relatedArticles={relatedArticles}
  schema={[videoSchema]}
  pageKey="punta-campanella"
>

  <!-- Video Section -->
  <div class="rounded-[2rem] shadow-xl mb-8 flex justify-center bg-slate-900 py-4">
    <video muted="muted"
      controls controlsList="nofullscreen" id="disable-audio"
      poster="/images/punta-campanella-hero.jpg"
      class="max-w-full max-h-[500px]"
      width="1280"
      height="720"
    >
      <source src="/videos/punta-campanella-video.mp4?v=2" type="video/mp4" />
      Ihr Browser unterstützt HTML5-Video nicht.
    </video>
    <script>
      const video = document.getElementById("disable-audio");
      if (!video) video = document.querySelector('video');
      if (video) {
        const forceMuted = () => {
          video.muted = true;
          video.volume = 0;
        };
        forceMuted();
        video.addEventListener('play', forceMuted);
        video.addEventListener('playing', forceMuted);
        video.addEventListener('volumechange', forceMuted);
        video.addEventListener('timeupdate', forceMuted);
        video.addEventListener('seeked', forceMuted);
      }
    </script>
  </div>

  <!-- Key Takeaways -->
  <div class="bg-slate-900 text-white p-8 rounded-[2rem]">
    <div class="flex items-center gap-3 mb-6">
      <svg class="w-5 h-5 text-med-gold flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
      <h2 class="font-serif text-lg font-bold text-med-gold uppercase tracking-[0.15em]">Wichtige Punkte</h2>
    </div>
    <ul class="space-y-4">
      {keyTakeaways.map((point) => (
        <li class="flex items-start gap-3">
          <span class="w-1.5 h-1.5 rounded-full bg-med-gold flex-shrink-0 mt-2"></span>
          <span class="text-white/80 text-xs sm:text-sm leading-relaxed">{point}</span>
        </li>
      ))}
    </ul>
  </div>

  <!-- Intro -->
  <div>
    <p class="text-slate-600 text-xl leading-relaxed mb-6 font-light">
      Am äußersten Ende der Halbinsel von Sorrent gibt es einen Ort, an dem das Land so schmal wird, dass es wie eine felsige Zunge in Richtung Capri ragt: Punta Campanella. Es ist nicht nur ein Meeresschutzgebiet, sondern die heilige Grenze zwischen dem Golf von Neapel und dem Golf von Salerno – ein Ort, an dem antike Geschichte, der Mythos von Odysseus und wilde Natur zu einem unvergesslichen Erlebnis verschmelzen.
    </p>
  </div>

  <!-- Eine Reise zwischen Mythos und Archäologie -->
  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">Eine Reise zwischen Mythos und Archäologie</h2>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      Wer zur Punta Campanella wandert, folgt den Spuren der Griechen und Römer. Hier thronte einst der majestätische Tempel der Athena (von den Römern später Minerva geweiht), ein Leuchtfeuer der Zivilisation für die Seefahrer der Antike. Heute ragen archäologische Überreste aus der mediterranen Macchia hervor, Zeugen einer Vergangenheit, in der dieses Vorgebirge als heilig galt.
    </p>

    <div class="bg-white p-8 rounded-[2rem] border border-slate-100 shadow-sm my-6">
      <h3 class="font-serif text-xl font-bold text-slate-900 mb-4">Der Glockenturm des 14. Jahrhunderts</h3>
      <p class="text-slate-600 leading-relaxed mb-4">
        Der Name „Campanella" (Glöckchen) leitet sich von dem Wachturm aus dem 14. Jahrhundert ab, Teil des Verteidigungssystems gegen Sarazenen-Überfälle. Auf der Spitze des Turms befand sich eine <strong>Glocke, die Alarm schlug</strong> im Fall einer Gefahr, deren Läuten von Turm zu Turm entlang der gesamten Küste hallte.
      </p>
      <p class="text-slate-600 leading-relaxed">
        Noch heute, wenn auch in Ruinen, dominiert der Turm die Landschaft und erzählt Geschichten von nächtlicher Wachsamkeit, besorgten Seeleuten und einer Gemeinschaft, die ihr Territorium mit ständiger Aufmerksamkeit schützte.
      </p>
    </div>

    <blockquote class="border-l-4 border-med-gold pl-6 my-8">
      <p class="text-slate-700 text-xl font-serif italic leading-relaxed">
        "Punta Campanella ist der Ort, wo Geografie zur Geschichte wird, und Geschichte zur Legende."
      </p>
    </blockquote>
  </div>

  <!-- Der Weg -->
  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">Der Weg: Wandern zwischen Himmel und Meer</h2>
    <p class="text-slate-600 text-lg leading-relaxed mb-8">
      Die Route startet im Dorf Termini (Teil von Massa Lubrense). Der Weg ist für fast jeden machbar, bietet aber spektakuläre Ausblicke.
    </p>

    <div class="space-y-4 mb-8">
      <div class="bg-white p-6 rounded-[2rem] border border-slate-100 shadow-sm flex gap-5">
        <div class="w-10 h-10 rounded-full bg-med-gold/10 flex-shrink-0 flex items-center justify-center text-med-gold font-bold text-xs sm:text-sm">1</div>
        <div>
          <h4 class="font-bold text-slate-900 mb-1">Die Strecke</h4>
          <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Der Pfad führt durch jahrhundertealte Olivenhaine, vorbei an Myrte und Rosmarin. Je weiter man zum Leuchtturm absteigt, desto näher rückt die Silhouette von Capri.</p>
        </div>
      </div>
      <div class="bg-white p-6 rounded-[2rem] border border-slate-100 shadow-sm flex gap-5">
        <div class="w-10 h-10 rounded-full bg-med-gold/10 flex-shrink-0 flex items-center justify-center text-med-gold font-bold text-xs sm:text-sm">2</div>
        <div>
          <h4 class="font-bold text-slate-900 mb-1">Die Panoramaaussicht</h4>
          <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Am Turm angekommen, reicht der Blick über 360 Grad: auf der einen Seite der Vesuv und die Küste von Sorrent, auf der anderen die Amalfiküste mit den Li Galli-Inseln.</p>
        </div>
      </div>
    </div>

    <div class="overflow-hidden rounded-[2rem] border border-slate-100 shadow-sm">
      <table class="w-full text-xs sm:text-xs sm:text-sm">
        <thead class="bg-slate-900 text-white">
          <tr>
            <th class="text-left p-5 font-serif font-bold text-med-gold">Merkmal</th>
            <th class="text-left p-5 font-serif font-bold text-med-gold">Detail</th>
          </tr>
        </thead>
        <tbody class="bg-white">
          <tr class="border-b border-slate-100">
            <td class="p-5 font-bold text-slate-900">Startpunkt</td>
            <td class="p-5 text-slate-600">Piazza di Termini (Massa Lubrense)</td>
          </tr>
          <tr class="border-b border-slate-100">
            <td class="p-5 font-bold text-slate-900">Schwierigkeit</td>
            <td class="p-5 text-slate-600">E (Wandern) - Leicht/Mittel</td>
          </tr>
          <tr class="border-b border-slate-100">
            <td class="p-5 font-bold text-slate-900">Gehzeit</td>
            <td class="p-5 text-slate-600">Ca. 1 Stunde (pro Weg)</td>
          </tr>
          <tr class="border-b border-slate-100">
            <td class="p-5 font-bold text-slate-900">Ausrüstung</td>
            <td class="p-5 text-slate-600">Wanderschuhe, Wasser, Hut</td>
          </tr>
          <tr>
            <td class="p-5 font-bold text-slate-900">Zugang</td>
            <td class="p-5 text-slate-600">Kostenlos (Meeresschutzgebiet)</td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>

  <!-- Insider-Tipps -->
  <div class="bg-white p-8 rounded-[2rem] shadow-xl border border-slate-100">
    <div class="flex items-center gap-4 mb-6">
      <svg class="w-6 h-6 text-med-gold flex-shrink-0" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M9 18h6"/><path d="M10 22h4"/><path d="M15.09 14c.18-.98.65-1.74 1.41-2.5A4.65 4.65 0 0 0 18 8 6 6 0 0 0 6 8c0 1 .23 2.23 1.5 3.5A4.61 4.61 0 0 1 8.91 14"/></svg>
      <h3 class="text-xl font-bold text-slate-900">Insider-Tipps</h3>
    </div>
    <div class="space-y-6">
      <div>
        <p class="font-bold text-slate-900 mb-1">Der Magische Moment: Sonnenuntergang</p>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Der Sonnenuntergang ist ein mystisches Erlebnis. Die Sonne versinkt genau neben den Faraglioni von Capri. Wer den Sonnenuntergang genießt, sollte eine Stirnlampe für den Rückweg einpacken.</p>
      </div>
      <div>
        <p class="font-bold text-slate-900 mb-1">Abstieg zur Bucht von Ieranto</p>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Erfahrene Wanderer können zur <a href="/de-de/beaches/sorrento-peninsula/ieranto/" class="text-med-blue hover:underline">Bucht von Ieranto</a> abbiegen, einer unberührten Bucht im Besitz des FAI. Motorboote sind hier verboten.</p>
      </div>
      <div>
        <p class="font-bold text-slate-900 mb-1">Respekt für die Umwelt</p>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Sie befinden sich in einem Naturschutzgebiet. Hinterlassen Sie keinen Müll und bleiben Sie auf markierten Wegen, um die seltene endemische Flora zu schützen.</p>
      </div>
    </div>
  </div>

  <!-- Die Legende des Odysseus -->
  <div class="bg-slate-50 p-8 rounded-[2rem] border-l-4 border-med-gold my-8">
    <div class="flex items-start gap-4">
      <svg class="w-6 h-6 text-med-gold flex-shrink-0 mt-1" fill="currentColor" viewBox="0 0 24 24"><path d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
      <div>
        <h3 class="font-bold text-slate-900 mb-2 text-lg">Wussten Sie schon?</h3>
        <p class="text-slate-700 leading-relaxed">
          Die Legende besagt, dass es hier war, wo Odysseus den Sirenen begegnete. Um ihrem Gesang zu widerstehen, ließ er sich am Mast seines Schiffes festbinden. Jeden Sonnenuntergang von diesen Klippen scheint man noch diesen fernen Gesang zu hören, von den Wellen gewiegt.
        </p>
      </div>
    </div>
  </div>

</BlogPostLayout>
