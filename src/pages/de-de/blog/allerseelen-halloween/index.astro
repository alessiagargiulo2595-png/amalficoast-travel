---
import BlogPostLayout from '../../../../layouts/BlogPostLayout.astro';

const lang = 'de-de';
const post = {
  title: 'Allerseelen, Halloween und die Kapuzenbruderschaften',
  subtitle: 'Was am 1. und 2. November in Kampanien wirklich geschieht, warum die Süssigkeit der Saison wie ein Sarg aussieht, und wer die incappucciati von Sorrent sind',
  category: 'ENTDECKUNGEN',
  date: '7. Oktober 2026',
  readTime: '10 Min.',
  image: '/images/misteri-venerdi-santo-hero.webp',
  imageAlt: "Ein Mysterium der Passion, von Kapuzenbrüdern in einer Karfreitagsprozession getragen",
  path: '/de-de/blog/allerseelen-halloween/',
};

const metaTitle = 'Allerseelen in Kampanien: Torrone und Prozessionen';
const metaDescription = 'Am 1. und 2. November hält Kampanien an seinem eigenen Totenfest fest, mit dem torrone dei morti in jeder Konditorei. Wo Halloween hineinpasst, und wer die Kapuzenbruderschaften von Sorrent sind.';

const breadcrumbs = [
  { name: 'Home', url: '/de-de/' },
  { name: 'Blog', url: '/de-de/blog/' },
  { name: 'Allerseelen und Halloween', url: '/de-de/blog/allerseelen-halloween/' },
];

const quickInfo = [
  { label: 'Allerheiligen', value: '1. November, gesetzlicher Feiertag' },
  { label: 'Allerseelen', value: '2. November, kein Feiertag' },
  { label: 'Die Süssigkeit', value: 'Torrone dei morti, weich, auf Schokolade' },
  { label: 'Lokaler Name', value: '\'O muollo, der Weiche' },
  { label: 'Im Verkauf', value: 'In Konditoreien ab Mitte Oktober' },
  { label: 'Halloween', value: 'Vorhanden, vor allem für Kinder' },
  { label: 'Bruderschaften', value: 'Santa Monica und della Morte, Sorrent' },
  { label: 'Prozessionen', value: 'Karfreitag, nicht im November' },
];

const faq = [
  {
    q: 'Was ist der torrone dei morti?',
    a: 'Eine weiche neapolitanische Süssigkeit, die man um den 2. November isst. Anders als der harte Weihnachtstorrone baut er auf Schokolade auf: eine Hülle aus Zartbitterschokolade um eine weiche Füllung aus weisser oder Milchschokolade mit Haselnüssen, in einen Block geschnitten. In Neapel heisst er \'o muollo, der Weiche, oder \'o murticiell.',
  },
  {
    q: 'Warum isst man ihn am 2. November?',
    a: 'Wegen eines alten Glaubens, nach dem die Toten in der Nacht vom 1. auf den 2. November zurückkehren, um zu kosten, was ihre Familien zubereitet haben. Auf den Gräbern liess man Süssigkeiten zurück, um den Übergang in die andere Welt zu versüssen, und der torrone ist die überlebende Form dieser Gabe. Die Verbindung ist viel älter als das moderne Rezept.',
  },
  {
    q: 'Ist der 1. November in Italien ein Feiertag?',
    a: 'Ja. Ognissanti, Allerheiligen, ist ein nationaler Feiertag, Banken, Ämter und viele Geschäfte schliessen, und der Verkehr fährt nach Feiertagsfahrplan. Der Tag danach, die Commemorazione dei defunti am 2. November, ist kein Feiertag, auch wenn die Friedhöfe ab dem frühen Morgen voll sind.',
  },
  {
    q: 'Wird an der Amalfiküste Halloween gefeiert?',
    a: 'Zunehmend ja, vor allem als Kinderfest mit Kostümen und geschmückten Schaufenstern, und in den Städten mehr als in den Dörfern. Den älteren Ritus hat es nicht verdrängt. Für die meisten Familien hier ist der 31. Oktober ein Abend aus und der 2. November der Tag, auf den es ankommt.',
  },
  {
    q: 'Wer sind die incappucciati von Sorrent?',
    a: 'Die vermummten Mitglieder zweier Laienbruderschaften: die Venerabile Arciconfraternita di Santa Monica, die weiss trägt, und die Venerabile Arciconfraternita della Morte, die schwarz trägt. Letztere wurde 1586 gegründet und führt eine ältere Bruderschaft von San Catello fort, die bereits 1380 belegt ist. Die Kapuze verbirgt die Identität des Trägers, damit die Handlung anonym bleibt.',
  },
  {
    q: 'Wann finden die Kapuzenprozessionen statt?',
    a: 'Am Karfreitag, nicht im November. Die Weisse Prozession der Addolorata verlässt die Kirche der Santissima Annunziata um drei Uhr morgens und kehrt im ersten Licht zurück. Die Schwarze Prozession des toten Christus zieht um halb neun abends los. Beide Termine verschieben sich jedes Jahr mit Ostern.',
  },
];

const sidebarLinks = [
  { label: 'Sorrent', href: '/de-de/sorrentinische-halbinsel/sorrent/' },
  { label: 'Procida', href: '/de-de/inseln/procida/' },
  { label: 'Delizia al limone', href: '/de-de/blog/zitronen-koestlichkeit/' },
  { label: 'Amalfi', href: '/de-de/amalfikueste/amalfi/' },
  { label: 'Cuoppo fritto', href: '/de-de/blog/cuoppo-fritto/' },
];

const authorRole = 'Lokaler Experte · Sorrentinische Halbinsel';

const relatedArticles = [
  {
    title: 'Filme in Sorrent: Wenn das Kino die Halbinsel waehlt',
    category: 'ENTDECKUNGEN',
    date: '30. Juni 2026',
    image: '/images/film-fatti-a-sorrento-hero.webp',
    imageAlt: 'In Sorrent gedrehte Filme',
    path: '/de-de/blog/filme-in-sorrent/'
  },
  {
    title: 'Weihnachtsbeleuchtung in Sorrent und Salerno',
    category: 'REISEFÜHRER',
    date: '21. Oktober 2026',
    image: '/images/luci-artista-salerno-hero.webp',
    imageAlt: 'Weihnachtslichter in Sorrent und Salerno',
    path: '/de-de/blog/weihnachtsbeleuchtung-sorrent-salerno/'
  }
];

const imageCredit = {
  author: 'Rossella Sorvillo / Wikimedia Commons',
  sourceUrl: 'https://commons.wikimedia.org/wiki/File:L%27antico_rito_dei_Misteri_del_Venerd%C3%AC_Santo.jpg',
  license: 'CC BY-SA 4.0',
  licenseUrl: 'https://creativecommons.org/licenses/by-sa/4.0/',
};

const keyTakeaways = [
  'In Kampanien sind die ersten Novembertage das Totenfest, aufgebaut auf dem Friedhofsbesuch am 2. November und nicht auf Kostümen am 31. Oktober.',
  'Die Süssigkeit der Saison ist der torrone dei morti, weich und auf Schokolade gebaut, Nachfahre der Gaben, die man einst auf den Gräbern zurückliess.',
  'Halloween ist angekommen und bei Kindern beliebt, hat sich aber neben den älteren Ritus gestellt statt ihn zu ersetzen.',
  'Die Kapuzenbruderschaften von Sorrent existieren gerade wegen des Totenkults: gegründet wurden sie, um die Armen zu bestatten und für die Seelen zu beten.',
  'Ihr grosser öffentlicher Auftritt ist der Karfreitag, mit der Weissen Prozession um drei Uhr morgens und der Schwarzen am Abend, einer Tradition, die bis ins 14. Jahrhundert zurückgeführt wird.',
];
---

<BlogPostLayout
  lang={lang}
  post={post}
  metaTitle={metaTitle}
  metaDescription={metaDescription}
  breadcrumbs={breadcrumbs}
  quickInfo={quickInfo}
  faq={faq}
  sidebarLinks={sidebarLinks}
  authorRole={authorRole}
  relatedArticles={relatedArticles}
  imageCredit={imageCredit}
  pageKey="feast-of-the-dead-halloween"
>

  <!-- Key Takeaways -->
  <div class="bg-slate-900 text-white p-8 rounded-[2rem]">
    <div class="flex items-center gap-3 mb-6">
      <svg class="w-5 h-5 text-med-gold flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
      <h2 class="font-serif text-lg font-bold text-med-gold uppercase tracking-[0.15em]">Key Takeaways</h2>
    </div>
    <ul class="space-y-4">
      {keyTakeaways.map((point) => (
        <li class="flex items-start gap-3">
          <span class="w-1.5 h-1.5 rounded-full bg-med-gold flex-shrink-0 mt-2"></span>
          <span class="text-white/80 text-xs sm:text-sm leading-relaxed">{point}</span>
        </li>
      ))}
    </ul>
  </div>

  <!-- Intro -->
  <div>
    <p class="text-slate-600 text-xl leading-relaxed mb-6 font-light">
      Betreten Sie in der zweiten Oktoberhälfte eine Konditorei in <a href="/de-de/sorrentinische-halbinsel/sorrent/" class="text-med-blue hover:underline">Sorrent</a>, und die Auslage füllt sich mit Blöcken aus dunkler Schokolade, gross wie ein Ziegelstein. Niemand nennt sie Saisonartikel. Es ist der <em>torrone dei morti</em>, und er gehört zu einem Bündel von Vorstellungen über die ersten Novembertage, das still und leise das Beständigste im lokalen Kalender geblieben ist. Halloween gibt es inzwischen auch hier. Es hat sich schlicht auf etwas viel Älteres gelegt, und die beiden haben eine Art Frieden geschlossen.
    </p>
  </div>

  <!-- 1. und 2. November -->
  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">Was am 1. und 2. November Wirklich Geschieht</h2>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      Die beiden Tage sind verschieden, und es lohnt sich, sie zu trennen. Der <strong>1. November, Ognissanti</strong>, Allerheiligen, ist ein nationaler Feiertag: Ämter und Banken geschlossen, viele Geschäfte zu, Verkehr nach Sonntagsfahrplan. Es ist ein Familientag, und an der Küste oft der letzte halbwegs milde Tag, für den jemand überhaupt noch vor die Tür geht.
    </p>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      Der <strong>2. November, die Commemorazione dei defunti</strong>, ist kein Feiertag und trägt doch das Gewicht. Ab dem frühen Morgen füllen sich die Friedhöfe: Familien reinigen Gräber, bringen Chrysanthemen, zünden Kerzen an, und der Besuch wird persönlich gemacht, nicht symbolisch. In einer Region, in der fast jeder Verwandte wenige Kilometer von seinem Wohnort entfernt begraben hat, ist das keine abstrakte Übung.
    </p>
    <p class="text-slate-600 text-lg leading-relaxed mb-8">
      Darunter läuft eine ältere Vorstellung, die die Kirche eher aufgenommen als erfunden hat: dass die Toten in der Nacht vom ersten auf den zweiten in die Häuser zurückkehren, in denen sie gelebt haben, und kosten, was für sie bereitsteht. Neapel hat diesen Glauben weiter getrieben als jeder andere Ort in Italien, bis hin zum Beinhaus der Fontanelle und dem Brauch, einen namenlosen Schädel zu adoptieren und für ihn zu beten. Auf der Halbinsel ist die überlebende Fassung sanfter und fast vollständig essbar.
    </p>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div class="bg-white p-6 rounded-[2rem] border border-slate-100 shadow-sm">
        <h4 class="font-bold text-slate-900 mb-2">Was geöffnet hat</h4>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Am 1. November gelten Feiertagsöffnungszeiten: Banken und Ämter zu, Bus und Bahn reduziert, Restaurants entweder voll oder geschlossen. Am 2. November ist alles normal, abgesehen vom dichten Verkehr rund um die Friedhöfe am Vormittag.</p>
      </div>
      <div class="bg-white p-6 rounded-[2rem] border border-slate-100 shadow-sm">
        <h4 class="font-bold text-slate-900 mb-2">Was Reisenden auffällt</h4>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Überall Blumen, vor allem Chrysanthemen, die in Italien Grabblumen sind und nie verschenkt werden. Anfang November einen Strauss zur Abendeinladung mitzubringen ist der klassische Fehler von Ausländern.</p>
      </div>
    </div>
  </div>

  <!-- Torrone -->
  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">Torrone dei Morti: die Süssigkeit mit dem Ungeschönten Namen</h2>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      Das ist nicht der harte weisse Nougat der Weihnachtszeit. Der torrone dei morti ist weich, weshalb Neapel ihn <em>'o muollo</em> nennt, und er baut auf Schokolade statt auf Honig und Eiweiss. Die Standardvariante ist eine Hülle aus Zartbitterschokolade um eine weiche Füllung aus weisser oder Milchschokolade, mit einer Creme geschmeidig gehalten und mit Haselnüssen durchsetzt, in rechteckige Blöcke geschnitten.
    </p>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      Die Form ist der Teil, den alle erwähnen und dann schnell übergehen: sie soll an einen kleinen Sarg erinnern, und der andere lokale Name, <em>'o murticiell</em>, das Tote, tut nichts, um die Verbindung zu verbergen. Der Ursprung liegt in den Gaben, die man einst auf den Gräbern zurückliess, Scheiben von torrone zwischen Tellern mit Essen, dort abgelegt, um den Übergang der Toten zu versüssen und sie in der Nacht ihrer Heimkehr zu nähren.
    </p>

    <div class="overflow-x-auto rounded-[2rem] border border-slate-100 shadow-sm mb-6">
      <table class="w-full text-xs sm:text-sm">
        <thead class="bg-slate-900 text-white">
          <tr>
            <th class="text-left p-5 font-serif font-bold text-med-gold">Variante</th>
            <th class="text-left p-5 font-serif font-bold text-med-gold">Was darin steckt</th>
          </tr>
        </thead>
        <tbody class="bg-white">
          <tr class="border-b border-slate-100">
            <td class="p-5 font-bold">Classico</td>
            <td class="p-5 text-slate-600">Zartbitter aussen, weiche Schokolade und Haselnuss innen. Der erste, den man probieren sollte, und der Massstab für jede Konditorei.</td>
          </tr>
          <tr class="border-b border-slate-100">
            <td class="p-5 font-bold">Caffè</td>
            <td class="p-5 text-slate-600">Basis aus weisser Schokolade, mit Kaffee verarbeitet. In ganz Kampanien verbreitet und in Neapel vermutlich gefragter als das Original.</td>
          </tr>
          <tr class="border-b border-slate-100">
            <td class="p-5 font-bold">Pistacchio und mandorla</td>
            <td class="p-5 text-slate-600">Pistazie oder Mandel statt Haselnuss. Weicher und süsser, und die Varianten, die Leute überzeugen, die glauben, torrone nicht zu mögen.</td>
          </tr>
          <tr>
            <td class="p-5 font-bold">Torroncini</td>
            <td class="p-5 text-slate-600">Dasselbe in Einzelhappen geschnitten, lose nach Gewicht verkauft. Der praktische Weg, vier Sorten zu probieren, ohne vier Ziegel zu kaufen.</td>
          </tr>
        </tbody>
      </table>
    </div>

    <p class="text-slate-600 text-lg leading-relaxed">
      Er taucht ab Mitte Oktober in den Auslagen auf und verschwindet wenige Tage nach dem 2. November wieder. Anders als die <a href="/de-de/blog/zitronen-koestlichkeit/" class="text-med-blue hover:underline">delizia al limone</a>, die man das ganze Jahr bestellen kann, hängt dieser wirklich an rund zwei Wochen, und jeder Ort der Halbinsel hat die eine Konditorei, über deren Version sich die Einheimischen streiten.
    </p>
  </div>

  <!-- Halloween -->
  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">Und dann kam Halloween</h2>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      Halloween erreichte Italien in den 1990er Jahren richtig und richtete sich als Kinderfest ein: Kostüme, geschmückte Schaufenster, ein Discoabend für Jugendliche, Kürbisse in Barfenstern, die mit nichts zu tun haben, was hier wächst. In Sorrent und den grösseren Orten finden Sie es am 31. Oktober, ohne zu suchen. In den Dörfern entlang der Küstenstrasse finden Sie es womöglich gar nicht.
    </p>
    <p class="text-slate-600 text-lg leading-relaxed mb-8">
      Interessant ist, wie wenig Reibung es gab. Eine Kultur, die ohnehin glaubte, dass die Toten für eine Nacht im Jahr zurückkehren, und die sie mit einer sargförmigen Süssigkeit erinnerte, würde sich über eine Verkleidungsparty nie empören. Die beiden stehen einfach nebeneinander, drei Tage auseinander, und die meisten Familien hier machen beides, ohne darüber nachzudenken.
    </p>

    <blockquote class="border-l-4 border-med-gold pl-6 my-8">
      <p class="text-slate-700 text-xl font-serif italic leading-relaxed">
        "Halloween bittet Kinder, sich für einen Abend tot zu stellen. Hier wurden die Toten ohnehin zu Hause erwartet, und jemand hatte ihnen schon etwas zu essen hingestellt."
      </p>
    </blockquote>
  </div>

  <!-- Bruderschaften -->
  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">Die Kapuzenbruderschaften von Sorrent</h2>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      Betreten Sie irgendeine Kirche an dieser Küste, und Sie finden eine Seitenkapelle, die einer <em>confraternita</em> gehört: einer Laienbruderschaft, keinem Orden, zusammengesetzt aus gewöhnlichen Bürgern des Ortes. Viele wurden mit ausdrücklich dem Tod zugewandtem Zweck gegründet, um jene zu bestatten, die sich kein Begräbnis leisten konnten, Sterbende zu begleiten und für die Seelen zu beten. Der oben beschriebene Totenkult ist keine Folklore, die diesen Einrichtungen angeheftet wurde. Er ist der Grund, warum es sie gibt.
    </p>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      Sorrent hat zwei, die jeder kennt, und einmal im Jahr geht die ganze Stadt für sie auf die Strasse. Die <strong>Venerabile Arciconfraternita di Santa Monica</strong> trägt Weiss. Die <strong>Venerabile Arciconfraternita della Morte</strong> trägt Schwarz; sie wurde 1586 gegründet und übernahm das Erbe einer weit älteren Bruderschaft von San Catello, die schon 1380 belegt ist. Die Mitglieder ziehen vermummt, und das ist der Punkt: die Kapuze nimmt den Menschen heraus und lässt nur die Handlung übrig.
    </p>

    <div class="bg-white p-8 rounded-[2rem] border border-slate-100 shadow-sm mb-6">
      <h3 class="font-serif text-xl font-bold text-slate-900 mb-5">Die beiden Prozessionen des Karfreitags</h3>
      <div class="space-y-3">
        <div class="flex items-start gap-3">
          <div class="w-6 h-6 rounded-full bg-med-gold/15 flex-shrink-0 flex items-center justify-center text-med-gold font-bold text-xs">1</div>
          <p class="text-slate-600 text-xs sm:text-sm leading-relaxed"><strong>Die Weisse Prozession</strong>, jene der Addolorata, verlässt die Kirche der Santissima Annunziata um drei Uhr morgens und zieht bis zum ersten Licht durch die Altstadt. Sie stellt die Suche der Mutter Gottes nach ihrem Sohn dar, und für sie stellt man sich den Wecker.</p>
        </div>
        <div class="flex items-start gap-3">
          <div class="w-6 h-6 rounded-full bg-med-gold/15 flex-shrink-0 flex items-center justify-center text-med-gold font-bold text-xs">2</div>
          <p class="text-slate-600 text-xs sm:text-sm leading-relaxed"><strong>Die Schwarze Prozession</strong>, jene des toten Christus, setzt sich am Abend desselben Tages um halb neun in Bewegung, mit schwarzen Kapuzen, Trauermarsch und dem durch das Zentrum getragenen Leichnam. Die Tradition beider wird bis ins 14. Jahrhundert zurückgeführt.</p>
        </div>
      </div>
    </div>

    <p class="text-slate-600 text-lg leading-relaxed">
      Es sei klar gesagt, dass dies Riten der Karwoche sind und nicht des Novembers, wer also zum Totenfest kommt, wird sie nicht sehen. Die andere grosse Kapuzenprozession des Golfs, die Misteri von <a href="/de-de/inseln/procida/" class="text-med-blue hover:underline">Procida</a>, findet ebenfalls am Karfreitagmorgen statt. Wenn Sie die rituelle Seite dieser Küste interessiert, ist Ostern die Reise, die Sie planen sollten, und nicht Halloween.
    </p>
  </div>

  <!-- Tipps -->
  <div class="bg-white p-8 rounded-[2rem] shadow-xl border border-slate-100">
    <div class="flex items-center gap-4 mb-6">
      <svg class="w-6 h-6 text-med-gold flex-shrink-0" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M9 18h6"/><path d="M10 22h4"/><path d="M15.09 14c.18-.98.65-1.74 1.41-2.5A4.65 4.65 0 0 0 18 8 6 6 0 0 0 6 8c0 1 .23 2.23 1.5 3.5A4.61 4.61 0 0 1 8.91 14"/></svg>
      <h3 class="text-xl font-bold">Expertentipps</h3>
    </div>
    <div class="space-y-6">
      <div>
        <p class="font-bold text-slate-900 mb-1">Kaufen Sie den torrone in der letzten Oktoberwoche</p>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Er taucht ab Mitte Oktober auf, und in den guten Konditoreien sind die besseren Sorten in den letzten Tagen weg. Fragen Sie nach torroncini, wenn Sie mehrere probieren wollen, und nach dem <em>muollo</em>, wenn man Ihnen die Wahl lässt: die harte Variante ist eine andere Süssigkeit für eine andere Jahreszeit.</p>
      </div>
      <div>
        <p class="font-bold text-slate-900 mb-1">Planen Sie um den 1. November herum, nicht um den 2.</p>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Der Feiertag ist der erste, und an ihm erwischt Sie ein geschlossenes Museum oder ein Feiertagsfahrplan. Wenn Sie zwischen Orten unterwegs sind, prüfen Sie vorher den Feiertagsfahrplan des <a href="/de-de/ratgeber/sita-bus/" class="text-med-blue hover:underline">SITA-Busses</a>.</p>
      </div>
      <div>
        <p class="font-bold text-slate-900 mb-1">Behandeln Sie die Friedhöfe als privat</p>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Die Hangfriedhöfe der Halbinsel sind aussergewöhnliche Orte, und am 2. November sind sie voller Familien, die etwas Persönliches tun. Sie zu besuchen ist in Ordnung; Menschen dabei zu fotografieren nicht.</p>
      </div>
      <div>
        <p class="font-bold text-slate-900 mb-1">Wenn Sie die Prozessionen wollen, kommen Sie zu Ostern</p>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Karfreitag in Sorrent heisst um drei Uhr morgens auf der Strasse zu stehen und noch einmal um halb neun abends. Buchen Sie früh, denn das ist einer der wenigen Termine ausserhalb des Sommers, an dem sich die Stadt wirklich füllt, und lassen Sie Blitz und Handylicht aus, während die Brüder vorbeiziehen.</p>
      </div>
    </div>
  </div>

</BlogPostLayout>
