---
import BlogPostLayout from '../../../../layouts/BlogPostLayout.astro';

const lang = 'de-de';
const post = {
  title: 'Neapolitanisches Weihnachtsgebäck',
  subtitle: 'Struffoli, Roccocò und Mustaccioli: was sie sind, woher sie kommen, und ein Rezept für zu Hause zu jedem von ihnen',
  category: 'ESSEN',
  date: '14. November 2026',
  readTime: '11 Min.',
  image: '/images/struffoli-hero.webp',
  imageAlt: "Frisch frittierte Struffoli in einer Schaumkelle, noch ohne Honig",
  path: '/de-de/blog/weihnachtsgebaeck-neapel/',
};

const metaTitle = 'Neapolitanisches Weihnachtsgebäck: Struffoli, Roccocò & Co.';
const metaDescription = 'Struffoli, Roccocò und Mustaccioli: Zutaten, die Gewürzmischung Pisto, Geschichte, Rezepte mit Grammangaben und wo man sie im Dezember an der Amalfiküste kauft.';

const breadcrumbs = [
  { name: 'Startseite', url: '/de-de/' },
  { name: 'Blog', url: '/de-de/blog/' },
  { name: 'Neapolitanisches Weihnachtsgebäck', url: '/de-de/blog/weihnachtsgebaeck-neapel/' },
];

const quickInfo = [
  { label: 'Saison', value: 'Dezember und Weihnachtsfeiertage' },
  { label: 'Struffoli', value: 'Frittierte Teigkügelchen in Honig' },
  { label: 'Roccocò', value: 'Harte Mandelringe mit Pisto' },
  { label: 'Mustaccioli', value: 'Gewürzrauten mit Zartbitterglasur' },
  { label: 'Gewürzmischung', value: 'Pisto (Zimt, Nelken, Muskat, Sternanis und mehr)' },
  { label: 'Schwierigkeitsgrad', value: 'Einfach bis mittel' },
  { label: 'Haltbarkeit', value: 'Roccocò etwa 1 Monat in der Dose' },
  { label: 'Wo kaufen', value: 'Konditoreien an Küste und Halbinsel im Dezember' },
];

const faq = [
  {
    q: 'Was ist Pisto?',
    a: 'Pisto ist die neapolitanische Gewürzmischung für Roccocò und Mustaccioli. Dissapore beschreibt sie als gleiche Teile Zimtstangen, Kardamomsamen, Sternanis, weiße Pfefferkörner, Nelken und Muskatnuss, im Mörser zusammen zerstoßen. Andere Rezepte geben Koriander dazu. Pisto gibt es auch fertig gemischt zu kaufen.',
  },
  {
    q: 'Kann ich Struffoli im Voraus zubereiten?',
    a: 'Ja. Die Struffoli frittieren, vollständig trocknen lassen und verschlossen in einem Beutel aufbewahren (am besten vakuumiert). Warmen Honig, kandierte Früchte und Zuckerstreusel erst kurz vor dem Servieren dazugeben. Ohne Honig halten sie sich gut.',
  },
  {
    q: 'Meine Roccocò sind steinhart. Habe ich etwas falsch gemacht?',
    a: 'Nicht unbedingt: Roccocò sollen fest sein und werden traditionell in Süßwein wie Marsala oder Moscato getunkt. Für ein weicheres Ergebnis 15 statt 20 Minuten backen und herausnehmen, solange sie sich noch zu weich anfühlen. Beim Abkühlen werden sie fest.',
  },
  {
    q: 'Was ist Backammoniak und wodurch kann ich es ersetzen?',
    a: 'Backammoniak (ammoniaca per dolci) ist Ammoniumhydrogencarbonat, in Deutschland als Hirschhornsalz bekannt, ein Triebmittel für trockenes Gebäck. Manche Mustaccioli-Rezepte nehmen stattdessen Natron: Ricette dal Mondo verwendet 1 Teelöffel für einen Teig mit 500 g Mehl.',
  },
  {
    q: 'Wie lange halten Roccocò und Mustaccioli?',
    a: 'Roccocò halten sich in einer Blechdose, vor Feuchtigkeit geschützt, etwa einen Monat, deshalb reichen sie für die ganzen Feiertage. Mustaccioli halten sich nach dem Festwerden der Schokolade bis zu 10 Tage in einem Gefrierbeutel oder unter einer Glasglocke.',
  },
  {
    q: 'Mustaccioli oder Mostaccioli: was ist richtig?',
    a: 'Beides. Mostaccioli ist der italienische Name, Mustaccioli die neapolitanische Dialektform. Der Name hängt mit mosto zusammen, dem Traubenmost, der früher in den Teig kam.',
  },
];

const sidebarLinks = [
  { label: 'Limoncello Rezept', href: '/de-de/blog/limoncello-rezept/' },
  { label: 'Torrone Rezept', href: '/de-de/blog/torrone-rezept/' },
  { label: 'Allerseelen und Halloween', href: '/de-de/blog/allerseelen-halloween/' },
  { label: 'Weihnachtsbeleuchtung in Sorrent und Salerno', href: '/de-de/blog/weihnachtsbeleuchtung-sorrent-salerno/' },
  { label: 'Zitronen-Köstlichkeit', href: '/de-de/blog/zitronen-koestlichkeit/' },
];

const authorRole = 'Kulinarik & Reise-Spezialist · Amalfiküste';

const relatedArticles = [
  {
    title: 'Limoncello Rezept',
    category: 'ESSEN',
    date: '31. Mai 2026',
    image: '/images/limoncello-ricetta-hero.webp',
    imageAlt: 'Handgemachter Limoncello der Amalfiküste - Zitronen aus Amalfi und Sorrent',
    path: '/de-de/blog/limoncello-rezept/'
  },
  {
    title: 'Allerseelen, Halloween und die Kapuzenbruderschaften',
    category: 'ENTDECKUNGEN',
    date: '7. Oktober 2026',
    image: '/images/misteri-venerdi-santo-hero.webp',
    imageAlt: 'Ein Mysterium der Passion, von Kapuzenbrüdern in einer Karfreitagsprozession getragen',
    path: '/de-de/blog/allerseelen-halloween/'
  }
];

const keyTakeaways = [
  "Struffoli sind kleine Kugeln aus Eierteig, frittiert, in warmem Honig gewendet und mit kandierten Früchten und bunten Zuckerstreuseln, den diavulilli, belegt.",
  "Roccocò sind harte Ringe aus Mehl, Mandeln, Zucker, Zitrusschale und Pisto. Im Teig ist keine Butter, und man tunkt sie in Süßwein.",
  "Mustaccioli sind rautenförmige Gewürzkekse mit Honig und Kakao, mit Zartbitterschokolade glasiert. Der Name kommt von mosto, Traubenmost.",
  "Pisto ist die Gewürzmischung von Roccocò und Mustaccioli: Zimt, Nelken, Muskat, Sternanis, Kardamom und weißer Pfeffer, in den meisten Versionen.",
  "Im Dezember verkaufen die Konditoreien der Halbinsel von Sorrent und der Amalfiküste alle drei. Roccocò und Mustaccioli reisen gut, Struffoli weniger.",
];

const schemaStruffoli = {
  "@context": "https://schema.org",
  "@type": "Recipe",
  "name": "Neapolitanische Struffoli",
  "description": "Kleine frittierte Kugeln aus Eierteig in Honig, mit kandierten Früchten und bunten Zuckerstreuseln: der Klassiker der neapolitanischen Weihnacht.",
  "image": "https://amalficoast-travel.com/images/struffoli-hero.webp",
  "author": { "@type": "Organization", "name": "Amalfi Coast Travel" },
  "datePublished": "2026-10-16",
  "recipeCategory": "Dessert",
  "recipeCuisine": "Italienisch",
  "keywords": "Struffoli, neapolitanisches Weihnachtsgebäck",
  "recipeIngredient": [
    "500 g schwaches Mehl (eiweißarm, für Kekse)",
    "300 g ganze Eier (etwa 5)",
    "40 g Kristallzucker",
    "30 g weiche Butter",
    "3 g feines Salz",
    "5 g Backpulver",
    "Abgeriebene Schale von Orange und Zitrone",
    "Ein Schuss Strega-Likör oder Grappa",
    "Etwa 300 g Akazienhonig",
    "Kandierte Früchte und bunte Zuckerstreusel (diavulilli)",
    "2 Liter Erdnussöl zum Frittieren"
  ],
  "recipeInstructions": [
    { "@type": "HowToStep", "name": "Teig", "text": "Mehl mit Backpulver sieben und eine Mulde formen. Eier und Zucker hineingeben und mit einer Gabel verquirlen, dann das in wenig Wasser gelöste Salz, die Schale, den Likör und die weiche Butter dazugeben. Zu einem glatten, kompakten Teig kneten." },
    { "@type": "HowToStep", "name": "Ruhen", "text": "Den Teig in einem luftdichten Behälter etwa 2 Stunden ruhen lassen." },
    { "@type": "HowToStep", "name": "Formen", "text": "Stränge von etwa 1 cm Durchmesser rollen und in 1 cm lange Stücke schneiden. Überschüssiges Mehl abschütteln und die Stücke 10 Minuten auf Backpapier ruhen lassen." },
    { "@type": "HowToStep", "name": "Frittieren", "text": "Das Öl auf 180°C erhitzen, dann auf etwa 170°C reduzieren. Portionsweise goldbraun wie Brotkruste frittieren und auf Küchenpapier abtropfen lassen." },
    { "@type": "HowToStep", "name": "Honig", "text": "Den Honig in einer weiten Pfanne erwärmen, die abgekühlten Struffoli dazugeben und vorsichtig wenden. Kandierte Früchte und Streusel dazugeben und als Kranz oder Kuppel anrichten." }
  ]
};

const schemaRoccoco = {
  "@context": "https://schema.org",
  "@type": "Recipe",
  "name": "Neapolitanische Roccocò",
  "description": "Harte neapolitanische Weihnachtsringe aus Mehl, Mandeln, Zucker, Zitrusschale und der Gewürzmischung Pisto.",
  "author": { "@type": "Organization", "name": "Amalfi Coast Travel" },
  "datePublished": "2026-10-16",
  "recipeCategory": "Dessert",
  "recipeCuisine": "Italienisch",
  "keywords": "Roccocò, Pisto, neapolitanisches Weihnachtsgebäck",
  "prepTime": "PT15M",
  "cookTime": "PT20M",
  "totalTime": "PT35M",
  "recipeYield": "10 Roccocò",
  "recipeIngredient": [
    "250 g Weizenmehl",
    "150 g gemahlene Mandeln (Mandelmehl)",
    "50 g Mandelblättchen",
    "200 g Kristallzucker",
    "1 Prise feines Salz",
    "2 g Backammoniak (Hirschhornsalz)",
    "Abgeriebene Schale von 1 Orange",
    "Abgeriebene Schale von 1 Zitrone",
    "5 g Pisto",
    "80 g lauwarmes Wasser",
    "1 Eigelb zum Bestreichen"
  ],
  "recipeInstructions": [
    { "@type": "HowToStep", "name": "Mischen", "text": "Mehl, Zucker, Backammoniak, Pisto, Salz, Zitrusschale, Mandelmehl und Mandelblättchen mischen. Das lauwarme Wasser nach und nach zugeben, bis der Teig glatt und nicht mehr klebrig ist." },
    { "@type": "HowToStep", "name": "Formen", "text": "Den Teig in 10 Stücke teilen, jedes zu einer Rolle formen und die Enden zu einem Ring schließen. Auf ein mit Backpapier belegtes Blech legen." },
    { "@type": "HowToStep", "name": "Backen", "text": "Mit verquirltem Eigelb bestreichen und im Umluftofen bei 180°C 20 Minuten backen (15 für ein weicheres Ergebnis). Vollständig abkühlen lassen." }
  ]
};

const schemaMustaccioli = {
  "@context": "https://schema.org",
  "@type": "Recipe",
  "name": "Neapolitanische Mustaccioli",
  "description": "Weiche neapolitanische Gewürzkekse mit Honig, Kakao, Mandeln und Pisto, als Rauten geschnitten und mit Zartbitterschokolade glasiert.",
  "author": { "@type": "Organization", "name": "Amalfi Coast Travel" },
  "datePublished": "2026-10-16",
  "recipeCategory": "Dessert",
  "recipeCuisine": "Italienisch",
  "keywords": "Mustaccioli, Mostaccioli, Pisto, neapolitanisches Weihnachtsgebäck",
  "prepTime": "PT10M",
  "cookTime": "PT15M",
  "totalTime": "PT1H25M",
  "recipeYield": "16-18 Mustaccioli",
  "recipeIngredient": [
    "250 g Weizenmehl (Type 00 oder 405)",
    "4 g Backammoniak (Hirschhornsalz)",
    "3 g Pisto",
    "125 g Kristallzucker",
    "100 g gemahlene Mandeln (Mandelmehl)",
    "25 g ungesüßtes Kakaopulver",
    "1 Prise Salz",
    "75 g Honig",
    "60 g lauwarmes Wasser",
    "Saft und abgeriebene Schale einer halben Orange",
    "350 g Zartbitterschokolade (70 %) für die Glasur"
  ],
  "recipeInstructions": [
    { "@type": "HowToStep", "name": "Mischen", "text": "Mehl, Kakao und Backammoniak in eine Schüssel sieben. Pisto, Salz, Zucker, Honig, Mandelmehl sowie Orangensaft und -schale zugeben. Das lauwarme Wasser nach und nach einarbeiten und kneten." },
    { "@type": "HowToStep", "name": "Ruhen", "text": "Den Teig in Frischhaltefolie wickeln und 1 Stunde im Kühlschrank ruhen lassen." },
    { "@type": "HowToStep", "name": "Schneiden", "text": "Den Teig auf einer bemehlten Fläche etwa 6 mm dick ausrollen und gleich große Rauten schneiden. Mit Abstand auf ein mit Backpapier belegtes Blech legen." },
    { "@type": "HowToStep", "name": "Backen", "text": "Im vorgeheizten Ofen bei 170°C Ober- und Unterhitze 15 Minuten backen (2 bis 3 Minuten länger für festere Kekse). Auf dem Blech vollständig abkühlen lassen." },
    { "@type": "HowToStep", "name": "Glasieren", "text": "Die Schokolade schmelzen, die Mustaccioli einzeln mit einer Gabel eintauchen, abtropfen lassen und auf ein Gitter legen. Mindestens 10 Minuten in den Kühlschrank stellen, bis die Glasur fest ist." }
  ]
};
---

<BlogPostLayout
  lang={lang}
  post={post}
  metaTitle={metaTitle}
  metaDescription={metaDescription}
  breadcrumbs={breadcrumbs}
  quickInfo={quickInfo}
  faq={faq}
  sidebarLinks={sidebarLinks}
  authorRole={authorRole}
  relatedArticles={relatedArticles}
  pageKey="neapolitan-christmas-sweets"
  extraSchema={[schemaStruffoli, schemaRoccoco, schemaMustaccioli]}
>

  <!-- Key Takeaways -->
  <div class="bg-slate-900 text-white p-8 rounded-[2rem]">
    <div class="flex items-center gap-3 mb-6">
      <svg class="w-5 h-5 text-med-gold flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
      <h2 class="font-serif text-lg font-bold text-med-gold uppercase tracking-[0.15em]">Das Wichtigste</h2>
    </div>
    <ul class="space-y-4">
      {keyTakeaways.map((point) => (
        <li class="flex items-start gap-3">
          <span class="w-1.5 h-1.5 rounded-full bg-med-gold flex-shrink-0 mt-2"></span>
          <span class="text-white/80 text-xs sm:text-sm leading-relaxed">{point}</span>
        </li>
      ))}
    </ul>
  </div>

  <!-- Intro -->
  <div>
    <p class="text-slate-600 text-xl leading-relaxed mb-6 font-light">
      In Neapel, auf der Halbinsel von Sorrent und an der <a href="/de-de/amalfikueste/" class="text-med-blue hover:underline">Amalfiküste</a> hat der Dezember sein eigenes Gebäck. Drei Sorten stehen auf fast jedem Tisch: <strong>Struffoli</strong>, kleine frittierte Teigkugeln in Honig; <strong>Roccocò</strong>, harte Mandelringe; und <strong>Mustaccioli</strong>, Gewürzrauten mit Schokoladenglasur. Die Saison der Süßigkeiten beginnt schon früher, mit dem Gebäck für die Toten Anfang November (darüber schreiben wir im Artikel zu <a href="/de-de/blog/allerseelen-halloween/" class="text-med-blue hover:underline">Allerseelen und Halloween</a>), aber Weihnachten gehört diesen dreien.
    </p>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      Hier erfahren Sie, was jedes davon ist, was hineingehört, was die Quellen über die Geschichte sagen, und Sie finden ein Rezept mit Grammangaben aus italienischen Konditoreiquellen. Serviert wird es wie hier üblich, mit einem Gläschen Süßwein oder selbst gemachtem <a href="/de-de/blog/limoncello-rezept/" class="text-med-blue hover:underline">Limoncello</a>.
    </p>
  </div>

  <!-- Pisto -->
  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">Pisto: die Gewürzmischung der neapolitanischen Weihnacht</h2>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      Roccocò und Mustaccioli teilen eine Zutat, die ihnen den Duft von Weihnachten gibt: <strong>Pisto</strong>. Es ist eine gemahlene Gewürzmischung, und jede Familie und jede Konditorei hat ihre eigenen Anteile. Die von Dissapore beschriebene Version nimmt gleiche Teile von:
    </p>
    <ul class="space-y-3 mb-6">
      <li class="flex items-start gap-3"><span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span><span class="text-slate-700">Zimtstangen</span></li>
      <li class="flex items-start gap-3"><span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span><span class="text-slate-700">Kardamomsamen (aus den Kapseln gelöst)</span></li>
      <li class="flex items-start gap-3"><span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span><span class="text-slate-700">Sternanis</span></li>
      <li class="flex items-start gap-3"><span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span><span class="text-slate-700">weißen Pfefferkörnern</span></li>
      <li class="flex items-start gap-3"><span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span><span class="text-slate-700">Nelken</span></li>
      <li class="flex items-start gap-3"><span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span><span class="text-slate-700">Muskatnuss</span></li>
    </ul>
    <p class="text-slate-600 text-lg leading-relaxed">
      Alles im Mörser (oder in einer Gewürzmühle) zu feinem Pulver zerstoßen. Manche Rezepte geben Koriandersamen dazu. Pro Backrunde braucht man nur wenige Gramm, der Rest kommt in ein verschlossenes Glas für das nächste Mal.
    </p>
  </div>

  <!-- Struffoli -->
  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">Struffoli: frittierte Teigkugeln in Honig</h2>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      <strong>Struffoli</strong> sind winzige Stücke Eierteig, goldbraun frittiert, dann in warmem Honig gewendet und zu einem Kranz oder einer Kuppel aufgeschichtet. Die Dekoration gehört dazu: kandierte Orange und Zitronat sowie die bunten Zuckerstreusel, die man in Neapel <em>diavulilli</em> nennt. Außen sind sie knusprig, innen leicht, und der Honig hält alles zusammen. Viele Familien geben einen Likör in den Teig; Strega ist eine häufige Wahl.
    </p>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      Zur Herkunft äußern sich die Quellen vorsichtig. Der Name soll vom griechischen <em>strongoulos</em> kommen, was rundlich bedeutet, und die Struffoli wurden vielleicht von den Griechen eingeführt oder entstanden unter spanischer Herrschaft. Dissapore weist darauf hin, dass es ähnliches frittiertes Honiggebäck in den Abruzzen, in Spanien und in Griechenland gibt (die <em>loukoumades</em>), und dass Struffoli seit dem 17. Jahrhundert auf neapolitanischen Tischen stehen, mit Verweis auf die <em>Lucerna de corteggiani</em> von Giovan Battista Crisci. Sie gehören zu Weihnachten, manche Familien backen sie aber auch zum Karneval.
    </p>

    <div class="bg-white p-8 rounded-[2rem] border border-slate-100 shadow-sm mb-6">
      <h3 class="font-serif text-xl font-bold text-slate-900 mb-5">Zutaten für Struffoli</h3>
      <ul class="space-y-3">
        <li class="flex items-start gap-3"><span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span><span class="text-slate-700"><strong>500 g schwaches Mehl</strong> (eiweißarm, für Kekse)</span></li>
        <li class="flex items-start gap-3"><span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span><span class="text-slate-700"><strong>300 g ganze Eier</strong> (etwa 5)</span></li>
        <li class="flex items-start gap-3"><span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span><span class="text-slate-700"><strong>40 g Kristallzucker</strong> und <strong>30 g weiche Butter</strong></span></li>
        <li class="flex items-start gap-3"><span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span><span class="text-slate-700"><strong>3 g feines Salz</strong> und <strong>5 g Backpulver</strong>, mit dem Mehl gesiebt</span></li>
        <li class="flex items-start gap-3"><span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span><span class="text-slate-700">Abgeriebene Schale von Orange und Zitrone sowie ein Schuss Strega oder Grappa</span></li>
        <li class="flex items-start gap-3"><span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span><span class="text-slate-700"><strong>Etwa 300 g Akazienhonig</strong>, kandierte Früchte und bunte Zuckerstreusel</span></li>
        <li class="flex items-start gap-3"><span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span><span class="text-slate-700"><strong>2 Liter Erdnussöl</strong> zum Frittieren</span></li>
      </ul>
    </div>

    <div class="bg-white p-8 rounded-[2rem] border border-slate-100 shadow-sm">
      <h3 class="font-serif text-xl font-bold text-slate-900 mb-5">So werden Struffoli gemacht</h3>
      <div class="space-y-4">
        <div class="flex items-start gap-3">
          <div class="w-6 h-6 rounded-full bg-med-gold/15 flex-shrink-0 flex items-center justify-center text-med-gold font-bold text-xs">1</div>
          <p class="text-slate-600 text-xs sm:text-sm leading-relaxed"><strong>Teig.</strong> Aus dem Mehl eine Mulde formen, Eier und Zucker hineingeben und mit einer Gabel verquirlen. Das in wenig Wasser gelöste Salz, die Schale, den Likör und zum Schluss die weiche Butter dazugeben. Zu einem glatten, kompakten Teig kneten.</p>
        </div>
        <div class="flex items-start gap-3">
          <div class="w-6 h-6 rounded-full bg-med-gold/15 flex-shrink-0 flex items-center justify-center text-med-gold font-bold text-xs">2</div>
          <p class="text-slate-600 text-xs sm:text-sm leading-relaxed"><strong>Ruhen lassen</strong>, etwa 2 Stunden in einem luftdichten Behälter.</p>
        </div>
        <div class="flex items-start gap-3">
          <div class="w-6 h-6 rounded-full bg-med-gold/15 flex-shrink-0 flex items-center justify-center text-med-gold font-bold text-xs">3</div>
          <p class="text-slate-600 text-xs sm:text-sm leading-relaxed"><strong>Formen.</strong> Stränge von etwa 1 cm Durchmesser rollen, leicht bemehlen und in 1 cm lange Stücke schneiden. Das gesamte überschüssige Mehl abschütteln und die Stücke 10 Minuten auf Backpapier ruhen lassen.</p>
        </div>
        <div class="flex items-start gap-3">
          <div class="w-6 h-6 rounded-full bg-med-gold/15 flex-shrink-0 flex items-center justify-center text-med-gold font-bold text-xs">4</div>
          <p class="text-slate-600 text-xs sm:text-sm leading-relaxed"><strong>Frittieren.</strong> Das Öl auf 180°C erhitzen, dann auf etwa 170°C reduzieren. Portionsweise goldbraun frittieren, in der Farbe von Brotkruste, und auf Küchenpapier abtropfen lassen.</p>
        </div>
        <div class="flex items-start gap-3">
          <div class="w-6 h-6 rounded-full bg-med-gold/15 flex-shrink-0 flex items-center justify-center text-med-gold font-bold text-xs">5</div>
          <p class="text-slate-600 text-xs sm:text-sm leading-relaxed"><strong>In Honig wenden.</strong> Den Honig in einer weiten Pfanne erwärmen, die abgekühlten Struffoli dazugeben und vorsichtig wenden, bis sie überzogen sind. Kandierte Früchte und Streusel dazugeben und auf einer Servierplatte anrichten.</p>
        </div>
      </div>
    </div>
    <p class="text-slate-500 text-sm mt-4">
      Rezept nach der Version des Konditors Armando Palmieri, veröffentlicht von Dissapore. Derselbe Artikel enthält eine knusprigere Version von Sal De Riso ohne Backpulver.
    </p>
  </div>

  <!-- Roccocò -->
  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">Roccocò: harte Mandelringe</h2>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      <strong>Roccocò</strong> sind Ringe aus dichtem, hartem Teig mit Mehl, Zucker, Mandeln, Zitrus und Pisto. Im Teig sind weder Butter noch Milch, deshalb halten sie sich wochenlang. Manche Versionen enthalten kandierte Orangenschale oder Mandarinensaft. Die Konsistenz hängt von der Backzeit ab: länger gebacken werden sie knusprig und zum Eintunken gemacht, kürzer gebacken bleiben sie weicher. In Neapel tunkt man sie in Süßwein wie Marsala oder Moscato oder in einen Likör.
    </p>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      Die Quellen datieren die Roccocò auf etwa 1320 und schreiben sie neapolitanischen Nonnen zu, meist denen des Real Convento della Maddalena. Der Name wird mit dem französischen <em>rocaille</em> in Verbindung gebracht, einer rundlichen, felsartigen Form, derselben Wurzel wie beim Rokoko.
    </p>

    <div class="bg-white p-8 rounded-[2rem] border border-slate-100 shadow-sm mb-6">
      <h3 class="font-serif text-xl font-bold text-slate-900 mb-5">Zutaten für Roccocò (10 Stück)</h3>
      <ul class="space-y-3">
        <li class="flex items-start gap-3"><span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span><span class="text-slate-700"><strong>250 g Weizenmehl</strong> und <strong>150 g gemahlene Mandeln</strong></span></li>
        <li class="flex items-start gap-3"><span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span><span class="text-slate-700"><strong>50 g Mandelblättchen</strong></span></li>
        <li class="flex items-start gap-3"><span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span><span class="text-slate-700"><strong>200 g Kristallzucker</strong> und eine Prise feines Salz</span></li>
        <li class="flex items-start gap-3"><span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span><span class="text-slate-700"><strong>2 g Backammoniak</strong> (Hirschhornsalz)</span></li>
        <li class="flex items-start gap-3"><span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span><span class="text-slate-700"><strong>5 g Pisto</strong></span></li>
        <li class="flex items-start gap-3"><span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span><span class="text-slate-700">Abgeriebene Schale von <strong>1 Orange</strong> und <strong>1 Zitrone</strong></span></li>
        <li class="flex items-start gap-3"><span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span><span class="text-slate-700"><strong>80 g lauwarmes Wasser</strong> und <strong>1 Eigelb</strong> zum Bestreichen</span></li>
      </ul>
    </div>

    <div class="bg-white p-8 rounded-[2rem] border border-slate-100 shadow-sm">
      <h3 class="font-serif text-xl font-bold text-slate-900 mb-5">So werden Roccocò gemacht</h3>
      <div class="space-y-4">
        <div class="flex items-start gap-3">
          <div class="w-6 h-6 rounded-full bg-med-gold/15 flex-shrink-0 flex items-center justify-center text-med-gold font-bold text-xs">1</div>
          <p class="text-slate-600 text-xs sm:text-sm leading-relaxed"><strong>Trockene Zutaten mischen</strong>: Mehl, Zucker, Backammoniak, Pisto, Salz, Schale, gemahlene Mandeln und Mandelblättchen.</p>
        </div>
        <div class="flex items-start gap-3">
          <div class="w-6 h-6 rounded-full bg-med-gold/15 flex-shrink-0 flex items-center justify-center text-med-gold font-bold text-xs">2</div>
          <p class="text-slate-600 text-xs sm:text-sm leading-relaxed"><strong>Wasser zugeben</strong>, nach und nach, bis der Teig glatt und nicht mehr klebrig ist.</p>
        </div>
        <div class="flex items-start gap-3">
          <div class="w-6 h-6 rounded-full bg-med-gold/15 flex-shrink-0 flex items-center justify-center text-med-gold font-bold text-xs">3</div>
          <p class="text-slate-600 text-xs sm:text-sm leading-relaxed"><strong>Ringe formen.</strong> Den Teig in 10 Stücke teilen, jedes mit den Handflächen zu einer Rolle formen und die Enden verbinden. Auf ein mit Backpapier belegtes Blech legen.</p>
        </div>
        <div class="flex items-start gap-3">
          <div class="w-6 h-6 rounded-full bg-med-gold/15 flex-shrink-0 flex items-center justify-center text-med-gold font-bold text-xs">4</div>
          <p class="text-slate-600 text-xs sm:text-sm leading-relaxed"><strong>Backen.</strong> Leicht mit verquirltem Eigelb bestreichen und im Umluftofen bei 180°C 20 Minuten backen, oder 15 Minuten für ein weicheres Ergebnis. Herausnehmen, solange sie sich noch weich anfühlen: beim Abkühlen werden sie hart.</p>
        </div>
      </div>
    </div>
    <p class="text-slate-500 text-sm mt-4">
      Rezept von Dissapore. Für eine dunklere Farbe 1 Teelöffel ungesüßten Kakao in den Teig geben; Haselnüsse können die Mandeln ersetzen.
    </p>
  </div>

  <!-- Mustaccioli -->
  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">Mustaccioli: Gewürzrauten in Schokolade</h2>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      <strong>Mustaccioli</strong> (auf Italienisch Mostaccioli) sind rautenförmige Kekse aus Mehl, Honig, Zucker, Mandeln, Kakao und Pisto, die in Zartbitterschokolade getaucht werden. Je nach Rezept ist das Innere fest oder weich; die Version unten backt nur 15 Minuten und bleibt weich. Schokoladenhülle, Honig und Gewürze schmeckt man zuerst.
    </p>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      Der Name kommt von <em>mosto</em>, Traubenmost, der früher in den Teig kam; Ricette dal Mondo führt ihn auf das lateinische <em>mustaceum</em> zurück. Laut Dissapore geht der verlässlichste historische Beleg des Rezepts auf Bartolomeo Scappi zurück, den päpstlichen Koch des 16. Jahrhunderts.
    </p>

    <div class="bg-white p-8 rounded-[2rem] border border-slate-100 shadow-sm mb-6">
      <h3 class="font-serif text-xl font-bold text-slate-900 mb-5">Zutaten für Mustaccioli (16-18 Stück)</h3>
      <ul class="space-y-3">
        <li class="flex items-start gap-3"><span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span><span class="text-slate-700"><strong>250 g Weizenmehl</strong> (Type 00 oder 405) und <strong>100 g gemahlene Mandeln</strong></span></li>
        <li class="flex items-start gap-3"><span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span><span class="text-slate-700"><strong>125 g Kristallzucker</strong> und <strong>75 g Honig</strong></span></li>
        <li class="flex items-start gap-3"><span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span><span class="text-slate-700"><strong>25 g ungesüßter Kakao</strong> und eine Prise Salz</span></li>
        <li class="flex items-start gap-3"><span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span><span class="text-slate-700"><strong>4 g Backammoniak</strong> und <strong>3 g Pisto</strong></span></li>
        <li class="flex items-start gap-3"><span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span><span class="text-slate-700">Saft und abgeriebene Schale einer <strong>halben Orange</strong></span></li>
        <li class="flex items-start gap-3"><span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span><span class="text-slate-700"><strong>60 g lauwarmes Wasser</strong></span></li>
        <li class="flex items-start gap-3"><span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span><span class="text-slate-700"><strong>350 g Zartbitterschokolade (70 %)</strong> für die Glasur</span></li>
      </ul>
    </div>

    <div class="bg-white p-8 rounded-[2rem] border border-slate-100 shadow-sm">
      <h3 class="font-serif text-xl font-bold text-slate-900 mb-5">So werden Mustaccioli gemacht</h3>
      <div class="space-y-4">
        <div class="flex items-start gap-3">
          <div class="w-6 h-6 rounded-full bg-med-gold/15 flex-shrink-0 flex items-center justify-center text-med-gold font-bold text-xs">1</div>
          <p class="text-slate-600 text-xs sm:text-sm leading-relaxed"><strong>Mischen.</strong> Mehl, Kakao und Backammoniak in eine Schüssel sieben. Pisto, Salz, Zucker, Honig, gemahlene Mandeln sowie Orangensaft und -schale zugeben.</p>
        </div>
        <div class="flex items-start gap-3">
          <div class="w-6 h-6 rounded-full bg-med-gold/15 flex-shrink-0 flex items-center justify-center text-med-gold font-bold text-xs">2</div>
          <p class="text-slate-600 text-xs sm:text-sm leading-relaxed"><strong>Kneten</strong> und dabei das lauwarme Wasser nach und nach zugeben. Ist der Teig zu klebrig, etwas Mehl einarbeiten. In Frischhaltefolie wickeln und 1 Stunde im Kühlschrank ruhen lassen.</p>
        </div>
        <div class="flex items-start gap-3">
          <div class="w-6 h-6 rounded-full bg-med-gold/15 flex-shrink-0 flex items-center justify-center text-med-gold font-bold text-xs">3</div>
          <p class="text-slate-600 text-xs sm:text-sm leading-relaxed"><strong>Rauten schneiden.</strong> Den Teig auf einer bemehlten Fläche etwa 6 mm dick ausrollen, gleich große Rauten schneiden und mit Abstand auf ein mit Backpapier belegtes Blech legen.</p>
        </div>
        <div class="flex items-start gap-3">
          <div class="w-6 h-6 rounded-full bg-med-gold/15 flex-shrink-0 flex items-center justify-center text-med-gold font-bold text-xs">4</div>
          <p class="text-slate-600 text-xs sm:text-sm leading-relaxed"><strong>Backen</strong> im vorgeheizten Ofen bei 170°C Ober- und Unterhitze, 15 Minuten (2 bis 3 Minuten länger, wenn sie fester sein sollen). Auf dem Blech vollständig abkühlen lassen: warm brechen sie leicht.</p>
        </div>
        <div class="flex items-start gap-3">
          <div class="w-6 h-6 rounded-full bg-med-gold/15 flex-shrink-0 flex items-center justify-center text-med-gold font-bold text-xs">5</div>
          <p class="text-slate-600 text-xs sm:text-sm leading-relaxed"><strong>Glasieren.</strong> Die Schokolade im Wasserbad oder in der Mikrowelle schmelzen. Die Mustaccioli einzeln mit einer Gabel eintauchen, abtropfen lassen und auf ein Gitter legen. Mindestens 10 Minuten in den Kühlschrank stellen, bis die Schokolade fest ist.</p>
        </div>
      </div>
    </div>
    <p class="text-slate-500 text-sm mt-4">
      Rezept nach den weichen neapolitanischen Mostaccioli aus dem Blognetzwerk von GialloZafferano (Cuochinprogress).
    </p>
  </div>

