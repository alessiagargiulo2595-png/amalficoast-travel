---
import BlogPostLayout from '../../../../layouts/BlogPostLayout.astro';

const lang = 'de-de';
const post = {
  title: 'Pompeji und Herculaneum ab Sorrent und Positano',
  subtitle: 'Zug, Bus oder Fahrer zu den beiden vom Vesuv verschütteten Städten, mit Tickets 2026, Öffnungszeiten und einer klaren Antwort, welche man wählen sollte',
  category: 'REISEFÜHRER',
  date: '18. Oktober 2026',
  readTime: '11 Min.',
  image: '/images/pompei-basilica-hero.webp',
  imageAlt: "Ziegelsäulen und die zweigeschossige Säulenhalle der Basilika in Pompeji",
  path: '/de-de/blog/pompeji-herculaneum-ab-sorrent-positano/',
};

const metaTitle = 'Pompeji und Herculaneum ab Sorrent oder Positano 2026';
const metaDescription = 'So kommen Sie von Sorrent und Positano nach Pompeji und Herculaneum: Circumvesuviana, SITA-Bus, Ticketpreise 2026, Öffnungszeiten und ein Tagesplan.';

const breadcrumbs = [
  { name: 'Home', url: '/de-de/' },
  { name: 'Blog', url: '/de-de/blog/' },
  { name: 'Pompeji und Herculaneum ab Sorrent und Positano', url: '/de-de/blog/pompeji-herculaneum-ab-sorrent-positano/' },
];

const quickInfo = [
  { label: 'Sorrent nach Pompeji', value: 'Circumvesuviana, ca. 35 bis 45 Min.' },
  { label: 'Sorrent nach Herculaneum', value: 'Circumvesuviana, ca. 1 Std.' },
  { label: 'Positano nach Pompeji', value: 'SITA-Bus + Zug, 2 Std. oder mehr' },
  { label: 'Ticket Pompeji', value: 'Ab €20 (Express), €25 (Pompeii+)' },
  { label: 'Ticket Herculaneum', value: '€16 Vollpreis' },
  { label: 'Winterzeiten', value: 'Letzter Einlass 15:30 an beiden Orten' },
  { label: 'Freier Eintritt', value: 'Erster Sonntag im Monat' },
  { label: 'Zeitbedarf', value: 'Herculaneum 2 Std., Pompeji 3 bis 4 Std.' },
];

const faq = [
  {
    q: 'Wie komme ich von Sorrent nach Pompeji?',
    a: 'Mit der Circumvesuviana, Linie Napoli-Sorrento, ab dem Bahnhof Sorrent bis Pompei Scavi-Villa dei Misteri. Die Fahrt dauert etwa 35 bis 45 Minuten, der Eingang Porta Marina liegt wenige Gehminuten vom Bahnsteig entfernt. Steigen Sie nicht in Pompei Santuario aus: Diese Station liegt an einer anderen Linie und bedient den Eingang am Amphitheater. Der EAV-Fahrplan ab 17. Oktober 2026 sieht alle 30 Minuten einen Zug von und nach Sorrent vor.',
  },
  {
    q: 'Gibt es einen direkten Bus von Positano nach Pompeji?',
    a: 'Keinen, auf den man sich verlassen kann. Für Herbst und Winter 2026 konnten wir keinen direkten öffentlichen Bus zwischen Positano und Pompeji bestätigen. Die verlässliche öffentliche Verbindung ist der SITA-Bus von Positano nach Sorrent, bei normalem Verkehr etwa 50 Minuten, danach die Circumvesuviana. Sonst bleiben Mietwagen, privater Fahrer oder eine organisierte Tour.',
  },
  {
    q: 'Fährt der Campania Express?',
    a: 'Derzeit nicht. Der Touristenzug war am 28. März 2026 mit Halten in Ercolano, Pompei und Castellammare wieder gestartet, EAV hat ihn aber ab dem 1. Oktober 2026 bis auf Weiteres eingestellt. Wer Tickets für spätere Termine hat, kann die Erstattung über das Beschwerdeformular von EAV beantragen. Prüfen Sie eavsrl.it vor dem nächsten Frühjahr.',
  },
  {
    q: 'Was kostet das Ticket für Pompeji 2026?',
    a: 'Seit dem 12. Januar 2026 kostet das Ticket Pompeii Express, nur die antike Stadt, €20 und Pompeii+ €25, zusätzlich mit Mysterienvilla, Villa des Diomedes, Villa Regina in Boscoreale und Shuttle. EU-Bürger von 18 bis 24 Jahren zahlen €2. Die Tickets sind personalisiert, also Ausweis mitnehmen. Kauf auf der offiziellen Vivaticket-Seite oder an den Kassen des Parks.',
  },
  {
    q: 'Pompeji oder Herculaneum, wenn nur Zeit für eines bleibt?',
    a: 'Herculaneum, wenn Sie einen halben Tag haben, Schatten und weniger Menschen suchen und Details mögen: Holzbalken, Obergeschosse und bemalte Räume sind dort erhalten. Pompeji, wenn Sie die Dimension einer ganzen römischen Stadt sehen wollen, mit Forum, Theatern, Amphitheater und langen gepflasterten Straßen, und mindestens drei bis vier Stunden haben.',
  },
  {
    q: 'Kann man beide an einem Tag besuchen?',
    a: 'Ja, sie liegen an derselben Bahnlinie etwa 20 bis 25 Minuten auseinander. Von Sorrent aus klappt es, wenn Sie früh starten und im Winter Herculaneum am Vormittag und Pompeji am Nachmittag besuchen. Von Positano aus wird es ein sehr langer Tag, zwei getrennte Tage oder ein Fahrer sind die bessere Wahl.',
  },
];

const sidebarLinks = [
  { label: 'Sorrent', href: '/de-de/sorrentinische-halbinsel/sorrent/' },
  { label: 'Positano', href: '/de-de/amalfikueste/positano/' },
  { label: 'Sorrent, Pompeji und Geschichte in 3 Tagen', href: '/de-de/reiserouten/3-tage/sorrent-pompeji-geschichte/' },
  { label: 'SITA-Bus', href: '/de-de/ratgeber/sita-bus/' },
  { label: 'Die Amalfiküste mit dem Zug', href: '/de-de/blog/amalfikueste-mit-dem-zug/' },
  { label: 'Anreise', href: '/de-de/ratgeber/anreise/' },
];

const authorRole = 'Lokaler Experte · Amalfiküste';

const relatedArticles = [
  {
    title: 'Die Amalfiküste mit dem Zug',
    category: 'REISEFÜHRER',
    date: '10. August 2026',
    image: '/images/treno-costiera-hero.webp',
    imageAlt: 'Die Amalfiküste mit dem Zug',
    path: '/de-de/blog/amalfikueste-mit-dem-zug/'
  },
  {
    title: 'Sorrent oder Positano: Wo an der Amalfiküste übernachten',
    category: 'REISEFÜHRER',
    date: '15. Juni 2026',
    image: '/images/sorrento-vs-positano-hero.webp',
    imageAlt: 'Sorrent und Positano im Vergleich',
    path: '/de-de/blog/sorrento-vs-positano/'
  }
];

const keyTakeaways = [
  'Von Sorrent aus liegen beide Stätten an derselben Circumvesuviana-Linie: etwa 35 bis 45 Minuten bis Pompei Scavi-Villa dei Misteri und etwa eine Stunde bis Ercolano Scavi, laut dem ab 17. Oktober 2026 gültigen Fahrplan mit einem Zug alle 30 Minuten.',
  'Von Positano gibt es keine direkte öffentliche Verbindung, auf die man zählen kann. Nehmen Sie den SITA-Bus nach Sorrent und dort den Zug, oder Auto, privaten Fahrer oder Tour.',
  'Der Touristenzug Campania Express ist ab dem 1. Oktober 2026 bis auf Weiteres eingestellt. Bis dahin bleibt nur der normale Pendlerzug.',
  'Pompeji kostet seit dem 12. Januar 2026 €20 (Express) oder €25 (Pompeii+), die Tickets sind personalisiert und auf 20.000 Eintritte pro Tag begrenzt. Herculaneum kostet €16.',
  'Vom 15. Oktober bis 15. März ist an beiden Orten um 15:30 letzter Einlass. Am ersten Sonntag jedes Monats ist der Eintritt frei, ohne Online-Reservierung.',
];
---

<BlogPostLayout
  lang={lang}
  post={post}
  metaTitle={metaTitle}
  metaDescription={metaDescription}
  breadcrumbs={breadcrumbs}
  quickInfo={quickInfo}
  faq={faq}
  sidebarLinks={sidebarLinks}
  authorRole={authorRole}
  relatedArticles={relatedArticles}
  pageKey="pompeii-herculaneum-from-sorrento"
>

  <!-- Key Takeaways -->
  <div class="bg-slate-900 text-white p-8 rounded-[2rem]">
    <div class="flex items-center gap-3 mb-6">
      <svg class="w-5 h-5 text-med-gold flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
      <h2 class="font-serif text-lg font-bold text-med-gold uppercase tracking-[0.15em]">Key Takeaways</h2>
    </div>
    <ul class="space-y-4">
      {keyTakeaways.map((point) => (
        <li class="flex items-start gap-3">
          <span class="w-1.5 h-1.5 rounded-full bg-med-gold flex-shrink-0 mt-2"></span>
          <span class="text-white/80 text-xs sm:text-sm leading-relaxed">{point}</span>
        </li>
      ))}
    </ul>
  </div>

  <!-- Intro -->
  <div>
    <p class="text-slate-600 text-xl leading-relaxed mb-6 font-light">
      Pompeji und Herculaneum liegen an derselben Bahnstrecke zwischen Neapel und <a href="/de-de/sorrentinische-halbinsel/sorrent/" class="text-med-blue hover:underline">Sorrent</a>, und für alle, die auf der Halbinsel wohnen, sind sie der naheliegende Tagesausflug. Von Sorrent genügt eine Zugfahrt. Von <a href="/de-de/amalfikueste/positano/" class="text-med-blue hover:underline">Positano</a> braucht es mehr Planung, denn die Bahn endet in Sorrent und die Küstenstraße ist langsam. Dieser Ratgeber behandelt beide Ausgangsorte, die 2026 geänderten Ticketregeln, die Winter- und Sommerzeiten und die Frage, welche der beiden Stätten man wählt, wenn nur Zeit für eine bleibt.
    </p>
  </div>

  <!-- Which one -->
  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">Pompeji oder Herculaneum?</h2>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      Beide wurden beim Ausbruch des Vesuvs im Jahr 79 n. Chr. zerstört, aber auf unterschiedliche Weise verschüttet, und vor Ort wirken sie sehr verschieden. Pompeji wurde von Asche und Bimsstein bedeckt; es war eine große Handelsstadt, und seine ausgegrabene Fläche ist etwa zehnmal so groß wie die von Herculaneum. Herculaneum, eine kleinere und wohlhabendere Küstenstadt, lag unter rund 20 Metern vulkanischem Material, das sie vollständiger versiegelte. Deshalb sind dort Holzbalken, Treppen, Obergeschosse und bemalte Räume erhalten, wie man sie in Pompeji selten sieht.
    </p>

    <div class="overflow-x-auto rounded-[2rem] border border-slate-100 shadow-sm mb-6">
      <table class="w-full text-xs sm:text-sm">
        <thead class="bg-slate-900 text-white">
          <tr>
            <th class="text-left p-5 font-serif font-bold text-med-gold"></th>
            <th class="text-left p-5 font-serif font-bold text-med-gold">Pompeji</th>
            <th class="text-left p-5 font-serif font-bold text-med-gold">Herculaneum</th>
          </tr>
        </thead>
        <tbody class="bg-white">
          <tr class="border-b border-slate-100">
            <td class="p-5 font-bold">Größe</td>
            <td class="p-5 text-slate-600">Eine ganze Stadt, lange Wege zwischen den Bereichen</td>
            <td class="p-5 text-slate-600">Kompakt, von oben überblickt und als Rundgang begangen</td>
          </tr>
          <tr class="border-b border-slate-100">
            <td class="p-5 font-bold">Zeitbedarf</td>
            <td class="p-5 text-slate-600">Mindestens 3 bis 4 Stunden, ein ganzer Tag ist schnell gefüllt</td>
            <td class="p-5 text-slate-600">Etwa 2 Stunden</td>
          </tr>
          <tr class="border-b border-slate-100">
            <td class="p-5 font-bold">Erhaltung</td>
            <td class="p-5 text-slate-600">Stadtgrundriss, Forum, Theater, Amphitheater, Fresken</td>
            <td class="p-5 text-slate-600">Obergeschosse, Holz, Möbel, intakte Innenräume</td>
          </tr>
          <tr class="border-b border-slate-100">
            <td class="p-5 font-bold">Ab Sorrent</td>
            <td class="p-5 text-slate-600">Ca. 35 bis 45 Min. bis Pompei Scavi-Villa dei Misteri</td>
            <td class="p-5 text-slate-600">Ca. 1 Std. bis Ercolano Scavi, dann 6 Min. zu Fuß</td>
          </tr>
          <tr class="border-b border-slate-100">
            <td class="p-5 font-bold">Vollpreis 2026</td>
            <td class="p-5 text-slate-600">€20 Express, €25 Pompeii+</td>
            <td class="p-5 text-slate-600">€16</td>
          </tr>
          <tr class="border-b border-slate-100">
            <td class="p-5 font-bold">Andrang</td>
            <td class="p-5 text-slate-600">Bis zu 20.000 pro Tag, große Gruppen</td>
            <td class="p-5 text-slate-600">Deutlich weniger, nachmittags ruhiger</td>
          </tr>
          <tr>
            <td class="p-5 font-bold">Schatten</td>
            <td class="p-5 text-slate-600">Sehr wenig, im Juli und August anstrengend</td>
            <td class="p-5 text-slate-600">Mehr überdachte Räume, kürzere Wege</td>
          </tr>
        </tbody>
      </table>
    </div>

    <p class="text-slate-600 text-lg leading-relaxed">
      Unsere Einschätzung: Beim ersten Besuch mit einem ganzen Tag Pompeji, weil nichts anderes so deutlich das Bild einer vollständigen römischen Stadt vermittelt. Für einen halben Tag, für Familien mit kleinen Kindern, für alle, denen Hitze oder lange Wege zu schaffen machen, oder für alle, die Pompeji schon kennen, ist Herculaneum die bessere Wahl. Beachten Sie, dass die Villa dei Papiri und das antike Theater in Herculaneum derzeit wegen Bauarbeiten geschlossen sind, ohne angekündigtes Datum der Wiedereröffnung.
    </p>
  </div>

  <!-- From Sorrento -->
  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">Ab Sorrent: die Circumvesuviana</h2>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      Sorrent ist Endstation der Circumvesuviana Napoli-Sorrento, betrieben von EAV, und beide Stätten haben an dieser Linie einen eigenen Bahnhof. Es ist ein Pendlerzug, kein Touristenangebot: keine Gepäckablagen, zu Stoßzeiten Stehplätze und ein Ruf für Taschendiebstahl, den er sich verdient hat. Trotzdem ist er der schnellste Weg.
    </p>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-6">
      <div class="bg-white p-6 rounded-[2rem] border border-slate-100 shadow-sm">
        <h4 class="font-bold text-slate-900 mb-2">Für Pompeji</h4>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Aussteigen in Pompei Scavi-Villa dei Misteri, etwa 35 bis 45 Minuten ab Sorrent. Die Eingänge Porta Marina und Piazza Esedra sind wenige Gehminuten entfernt. Pompei Santuario liegt an der Linie nach Poggiomarino und bedient den Eingang Piazza Anfiteatro, ist also nicht die Station für Züge aus Sorrent.</p>
      </div>
      <div class="bg-white p-6 rounded-[2rem] border border-slate-100 shadow-sm">
        <h4 class="font-bold text-slate-900 mb-2">Für Herculaneum</h4>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Aussteigen in Ercolano Scavi, etwa eine Stunde ab Sorrent. Laut Park liegt der Eingang in der Corso Resina 187 sechs Gehminuten bergab vom Bahnhof, auf dem Rückweg also sechs Minuten bergauf.</p>
      </div>
      <div class="bg-white p-6 rounded-[2rem] border border-slate-100 shadow-sm">
        <h4 class="font-bold text-slate-900 mb-2">Takt</h4>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Der neue EAV-Fahrplan der Vesuv-Linien, gültig ab 17. Oktober 2026, sieht alle 30 Minuten einen Zug von und nach Sorrent vor. Prüfen Sie die Abfahrten am Reisetag auf orariotreni.eavsrl.it und schauen Sie vor der Abfahrt nach dem letzten Zug zurück.</p>
      </div>
      <div class="bg-white p-6 rounded-[2rem] border border-slate-100 shadow-sm">
        <h4 class="font-bold text-slate-900 mb-2">Fahrkarten</h4>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Eine einfache Fahrt ab Sorrent kostet wenige Euro (aktuelle Ratgeber nennen etwa €3,30 bis Pompei Scavi). Laut EAV sind die eigenen Fahrkarten von der regionalen Tarifanpassung zum 1. Oktober 2026 nicht betroffen. Kauf am Bahnhof, oder kontaktlose Karte an Tap&amp;Go-Sperren, wo vorhanden, mit derselben Karte beim Ein- und Ausstieg.</p>
      </div>
    </div>

    <h3 class="font-serif text-2xl font-bold text-slate-900 mb-4">Und der Campania Express?</h3>
    <p class="text-slate-600 text-lg leading-relaxed">
      Der Campania Express ist die touristische Variante von EAV auf derselben Strecke: reservierte Plätze, Klimaanlage, Platz für Gepäck und Halte nur in Ercolano, Pompei, Castellammare und an den wichtigsten Bahnhöfen der Halbinsel. Er war am 28. März 2026 mit acht Fahrten pro Tag wieder gestartet, EAV hat ihn aber ab dem <strong>1. Oktober 2026 bis auf Weiteres eingestellt</strong>. Wer ein Ticket für einen späteren Termin gekauft hat, erhält die Erstattung über das Beschwerdeformular von EAV oder beim Wiederverkäufer, falls über Dritte gebucht. Für eine Reise im Frühjahr 2027 prüfen Sie auf eavsrl.it, ob er wieder fährt, bevor Sie damit planen.
    </p>
  </div>

  <!-- From Positano -->
  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">Ab Positano: Bus, Auto oder Fahrer</h2>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      Positano hat keinen Bahnhof, und zwischen dem Ort und der Vesuvebene liegen die Monti Lattari. Jede Option führt entweder westlich um die Halbinsel über Sorrent oder über die Berge, und jede hat ihren Preis.
    </p>
    <ul class="space-y-3 mb-6">
      <li class="flex items-start gap-3"><span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span><span class="text-slate-700"><strong>SITA-Bus und Zug.</strong> Der <a href="/de-de/ratgeber/sita-bus/" class="text-med-blue hover:underline">SITA-Bus</a> von Positano nach Sorrent braucht bei normalem Verkehr etwa 50 Minuten und hält nahe am Bahnhof, danach geht es mit der Circumvesuviana weiter. Rechnen Sie mit zwei Stunden oder mehr pro Strecke bis Pompeji, für Herculaneum mit mehr. Bustickets vor dem Einsteigen kaufen; SITA Sud hat die Tarife zum 1. Oktober 2026 angepasst.</span></li>
      <li class="flex items-start gap-3"><span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span><span class="text-slate-700"><strong>Fähre nach Sorrent in der Saison.</strong> Wenn die Küstenfähren fahren, umgeht das Boot von Positano nach Sorrent im Sommer die Warteschlange am Bus. Sie verkehren saisonal und pausieren im Winter, prüfen Sie daher unseren <a href="/de-de/ratgeber/faehren/" class="text-med-blue hover:underline">Fähren-Ratgeber</a> für Ihre Reisedaten.</span></li>
      <li class="flex items-start gap-3"><span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span><span class="text-slate-700"><strong>Direktbus.</strong> Für Herbst und Winter 2026 konnten wir keinen direkten öffentlichen Bus von Positano nach Pompeji bestätigen. Routenplaner zeigen an manchen Tagen einen Fernbus, aber ohne Fahrplan des Betreibers würden wir keinen Ausflug darauf aufbauen.</span></li>
      <li class="flex items-start gap-3"><span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span><span class="text-slate-700"><strong>Auto.</strong> Pompeji liegt an der Autobahn A3 Napoli-Salerno, Ausfahrt Pompei Scavi. Ab Positano sind es je nach Verkehr etwa eine bis anderthalb Stunden, an Sommerwochenenden deutlich mehr, dazu kommt kostenpflichtiges Parken nahe den Eingängen. Lesen Sie vorher unsere Hinweise zu <a href="/de-de/ratgeber/parken-ztl/" class="text-med-blue hover:underline">Parken und ZTL</a>.</span></li>
      <li class="flex items-start gap-3"><span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span><span class="text-slate-700"><strong>Privater Fahrer oder Tour.</strong> Am teuersten und am wenigsten anstrengend. Ein Fahrer setzt Sie an einer Stätte ab, holt Sie an der anderen ab und bringt Sie zum Abendessen zurück nach Positano. Nur so sind beide Stätten an einem Tag ab Positano entspannt machbar. Gruppentouren ab Positano und Sorrent beinhalten meist einen Guide und ersparen den Zug.</span></li>
    </ul>

    <div class="overflow-x-auto rounded-[2rem] border border-slate-100 shadow-sm">
      <table class="w-full text-xs sm:text-sm">
        <thead class="bg-slate-900 text-white">
          <tr>
            <th class="text-left p-5 font-serif font-bold text-med-gold">Strecke</th>
            <th class="text-left p-5 font-serif font-bold text-med-gold">Wie</th>
            <th class="text-left p-5 font-serif font-bold text-med-gold">Dauer</th>
          </tr>
        </thead>
        <tbody class="bg-white">
          <tr class="border-b border-slate-100">
            <td class="p-5 font-bold">Sorrent nach Pompeji</td>
            <td class="p-5 text-slate-600">Circumvesuviana bis Pompei Scavi-Villa dei Misteri</td>
            <td class="p-5 text-slate-600">35 bis 45 Min.</td>
          </tr>
          <tr class="border-b border-slate-100">
            <td class="p-5 font-bold">Sorrent nach Herculaneum</td>
            <td class="p-5 text-slate-600">Circumvesuviana bis Ercolano Scavi</td>
            <td class="p-5 text-slate-600">Ca. 1 Std.</td>
          </tr>
          <tr class="border-b border-slate-100">
            <td class="p-5 font-bold">Herculaneum nach Pompeji</td>
            <td class="p-5 text-slate-600">Circumvesuviana, dieselbe Linie</td>
            <td class="p-5 text-slate-600">20 bis 25 Min.</td>
          </tr>
          <tr class="border-b border-slate-100">
            <td class="p-5 font-bold">Positano nach Pompeji</td>
            <td class="p-5 text-slate-600">SITA-Bus bis Sorrent, dann Zug</td>
            <td class="p-5 text-slate-600">2 Std. oder mehr</td>
          </tr>
          <tr>
            <td class="p-5 font-bold">Positano nach Pompeji</td>
            <td class="p-5 text-slate-600">Auto oder privater Fahrer</td>
            <td class="p-5 text-slate-600">Ca. 1 Std. bis 1 Std. 30, je nach Verkehr</td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>

  <!-- Tickets and hours -->
  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">Tickets und Öffnungszeiten 2026</h2>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      Preise und Regeln unten entsprechen den Angaben des Parco Archeologico di Pompei und des Parco Archeologico di Ercolano zum Zeitpunkt der Veröffentlichung. Beide Parks ändern Details kurzfristig, prüfen Sie daher vor dem Besuch die offiziellen Seiten.
    </p>

    <h3 class="font-serif text-2xl font-bold text-slate-900 mb-4">Pompeji</h3>
    <ul class="space-y-3 mb-6">
      <li class="flex items-start gap-3"><span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span><span class="text-slate-700"><strong>Pompeii Express, €20.</strong> Nur die antike Stadt. Die Mysterienvilla außerhalb der Mauern ist nicht enthalten, die Vorstadtvillen lassen sich aber an der Porta Ercolano für €8 per Karte dazubuchen.</span></li>
      <li class="flex items-start gap-3"><span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span><span class="text-slate-700"><strong>Pompeii+, €25.</strong> Zusätzlich Mysterienvilla, Villa des Diomedes, Villa Regina in Boscoreale und Shuttlebus zwischen den Stätten.</span></li>
      <li class="flex items-start gap-3"><span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span><span class="text-slate-700"><strong>Pompeii Plus, €30.</strong> Drei Tage gültig, ein Eintritt pro Stätte, zusätzlich mit Oplontis, Stabiae und Boscoreale.</span></li>
      <li class="flex items-start gap-3"><span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span><span class="text-slate-700"><strong>Ermäßigt, €2.</strong> EU-Bürger von 18 bis 24 Jahren. Unter 18-Jährige haben nach den Regeln der staatlichen Museen freien Eintritt. Diese Preise gelten seit dem 12. Januar 2026.</span></li>
      <li class="flex items-start gap-3"><span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span><span class="text-slate-700"><strong>Personalisierte Tickets.</strong> Jedes Ticket trägt den Namen des Besuchers, ist nicht übertragbar und außer bei außerordentlichen Schließungen nicht erstattbar. Das Personal kann am Eingang einen Ausweis verlangen. Es gilt eine Obergrenze von 20.000 Eintritten pro Tag, ein Wiedereintritt ist nicht möglich.</span></li>
      <li class="flex items-start gap-3"><span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span><span class="text-slate-700"><strong>Zeitfenster in der Hauptsaison.</strong> Vom 16. März bis 14. Oktober ist der Einlass in ein Fenster von 9:00 bis 13:00 und eines von 13:00 bis 17:30 geteilt, jeweils mit eigenem Kontingent. Buchung online auf der offiziellen Vivaticket-Seite oder Kauf an den Eingängen.</span></li>
    </ul>

    <h3 class="font-serif text-2xl font-bold text-slate-900 mb-4">Herculaneum</h3>
    <ul class="space-y-3 mb-6">
      <li class="flex items-start gap-3"><span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span><span class="text-slate-700"><strong>Vollpreis, €16.</strong> Ermäßigt €2 für 18- bis 24-Jährige, frei für die gesetzlich vorgesehenen Gruppen. Kinder unter 12 Jahren müssen begleitet werden.</span></li>
      <li class="flex items-start gap-3"><span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span><span class="text-slate-700"><strong>Ercolano Card, €30.</strong> 365 Tage ab erster Nutzung gültig, lohnt sich nur, wenn Sie wiederkommen. Die Campania Artecard wird ebenfalls akzeptiert und an der Kasse aktiviert.</span></li>
      <li class="flex items-start gap-3"><span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span><span class="text-slate-700"><strong>Täglich geöffnet außer am 25. Dezember.</strong> Tickets gibt es online über die Ticketseite des Parks und an der Kasse.</span></li>
    </ul>

    <div class="overflow-x-auto rounded-[2rem] border border-slate-100 shadow-sm mb-6">
