---
import BlogPostLayout from '../../../../layouts/BlogPostLayout.astro';

const lang = 'de-de';
const post = {
  title: "Thermen und Spas zwischen Ischia und Sorrent",
  subtitle: "Die Thermalparks von Ischia, die Schwefelquellen von Scrajo in Vico Equense und das Ulysse-Spa in Sorrent: Saison, Preise 2026, Anreise und welches zu wem passt",
  category: 'REISEFÜHRER',
  date: '24. Oktober 2026',
  readTime: '12 Min.',
  image: '/images/terme-spa-hero.webp',
  imageAlt: "Ein Schwimmer im Hallenbecken eines Spas, hinter der Glasfront ein Garten",
  path: '/de-de/blog/thermen-spa-ischia-sorrent/',
};

const metaTitle = "Thermen Ischia und Sorrent: Parks, Preise, Saison 2026";
const metaDescription = "Die Thermalparks von Ischia, die Schwefelquellen von Scrajo in Vico Equense und das Ulysse-Spa in Sorrent: Preise 2026, Saison und Anreise ab Sorrent.";

const breadcrumbs = [
  { name: 'Home', url: '/de-de/' },
  { name: 'Blog', url: '/de-de/blog/' },
  { name: "Thermen und Spas zwischen Ischia und Sorrent", url: '/de-de/blog/thermen-spa-ischia-sorrent/' },
];

const quickInfo = [
  { label: 'Größter Park', value: 'Poseidon, Forio: 20 Becken' },
  { label: 'Poseidon 2026', value: '50 Euro Tageskarte, geöffnet bis 31. Oktober' },
  { label: 'Negombo 2026', value: '55 bis 70 Euro Tageskarte, seit 13. Oktober geschlossen' },
  { label: 'Saison auf Ischia', value: 'Etwa Ende April bis Oktober' },
  { label: 'Sorrent-Ischia', value: 'Direktes Tragflügelboot, ca. 1 Stunde, April bis Oktober' },
  { label: 'Scrajo', value: 'Kühles Schwefelbecken, Vico Equense, nur im Sommer' },
  { label: 'Ganzjährig', value: 'Ulysse-Spa, Sorrent (überdacht)' },
  { label: 'Immer dabei', value: 'Badekappe und rutschfeste Badeschuhe' },
];

const faq = [
  {
    q: "Welcher Thermalpark auf Ischia ist der beste?",
    a: "Das hängt davon ab, was Sie suchen. Poseidon in Forio ist der größte, mit 20 Becken, einem langen Strand und der längsten Saison. Negombo in Lacco Ameno hat den schönsten Garten und eine Sandbucht, ist aber am teuersten. Castiglione und Aphrodite Apollon kosten weniger und sind ruhiger, Cavascura ist eher ein historisches, schlichtes Badehaus als ein Park.",
  },
  {
    q: "Was kostet ein Tag in einem Thermalpark auf Ischia?",
    a: "2026 kostete die Tageskarte 50 Euro im Poseidon, je nach Zeitraum 55 bis 70 Euro im Negombo, etwa 40 Euro im Aphrodite Apollon und etwa 28 Euro im Castiglione. Nachmittagskarten sind überall günstiger. Die Preise ändern sich jede Saison, prüfen Sie daher vorher die offizielle Website.",
  },
  {
    q: "Kann man die Thermen auf Ischia als Tagesausflug von Sorrent besuchen?",
    a: "Ja, zwischen April und Oktober, wenn an einigen Wochentagen ein direktes Tragflügelboot in etwa einer Stunde von Sorrent nach Ischia fährt. Prüfen Sie vor der Abfahrt die Rückfahrtzeit. Außerhalb der Saison geht es über Neapel, und der Tag wird lang.",
  },
  {
    q: "Haben die Thermalparks im Winter geöffnet?",
    a: "Nein. Die großen Parks öffnen etwa Ende April und schließen im Oktober: 2026 hat Negombo am 13. Oktober geschlossen, Poseidon schließt am 31. Oktober. Castiglione ist bereits zu und veröffentlicht die Termine für 2027. Im Winter ist das überdachte Ulysse-Spa in Sorrent die praktische Alternative in der Nähe.",
  },
  {
    q: "Ist Scrajo in Vico Equense eine heiße Quelle?",
    a: "Nein. Das Schwefelwasser von Scrajo tritt mit etwa 18 Grad aus dem Fels: Es ist ein kühles Mineralbecken am Meer, kein warmes Bad. Genutzt wird es vom Frühling bis zum Frühherbst, zusammen mit dem Strandbad, das darum herum gebaut ist.",
  },
  {
    q: "Dürfen Kinder in die Thermalbecken?",
    a: "Die Regeln sind unterschiedlich. Im Poseidon dürfen Kinder unter 12 Jahren nicht in die Thermalbecken, haben aber Meerwasserbecken und den Strand; unter 4 Jahren ist der Eintritt frei, von 4 bis 11 zahlt man die Hälfte. Im Negombo richtet sich der Kinderpreis nach der Größe: unter 1 Meter frei. Heiße Becken sind für kleine Kinder überall nicht zu empfehlen.",
  },
];

const sidebarLinks = [
  { label: 'Ischia', href: '/de-de/inseln/ischia/' },
  { label: 'Forio', href: '/de-de/inseln/forio/' },
  { label: 'Maronti-Strand', href: '/de-de/strande/inseln/spiaggia-maronti/' },
  { label: 'Vico Equense', href: '/de-de/sorrentinische-halbinsel/vico-equense/' },
  { label: 'Sorrent', href: '/de-de/sorrentinische-halbinsel/sorrent/' },
  { label: 'Fähren-Ratgeber', href: '/de-de/ratgeber/faehren/' },
];

const authorRole = 'Lokaler Experte · Amalfiküste';

const relatedArticles = [
  {
    title: 'Capri oder Ischia',
    category: 'REISEFÜHRER',
    date: '4. Juni 2026',
    image: '/images/capri-vs-ischia-hero.webp',
    imageAlt: 'Capri und Ischia im Vergleich',
    path: '/de-de/blog/capri-vs-ischia/'
  },
  {
    title: 'Procida oder Ischia',
    category: 'REISEFÜHRER',
    date: '26. Juni 2026',
    image: '/images/procida-vs-ischia-hero.webp',
    imageAlt: 'Procida und Ischia im Vergleich',
    path: '/de-de/blog/procida-vs-ischia/'
  }
];

const keyTakeaways = [
  "Die Thermalparks liegen auf Ischia: Poseidon in Forio, Negombo in Lacco Ameno, Castiglione in Casamicciola, Aphrodite Apollon und Cavascura bei Sant'Angelo. Sie sind saisonal geöffnet, etwa von Ende April bis Oktober.",
  "2026 kostete die Tageskarte 50 Euro im Poseidon und 55 bis 70 Euro im Negombo. Castiglione und Aphrodite Apollon sind die günstigeren Parks. Die Preise ändern sich jedes Jahr, sehen Sie sie als Richtwert.",
  "Scrajo in Vico Equense ist die historische Schwefelquelle der Sorrentinischen Halbinsel. Das Wasser ist kühl, um die 18 Grad, und gebadet wird heute in einem Strandbad, das vom Frühling bis zum Frühherbst geöffnet ist.",
  "Das Ulysse-Spa in Sorrent ist ein überdachtes Wellnesszentrum mit warmem Salzwasserbecken, Sauna und Dampfbad. Es ist keine natürliche Quelle, aber die Option, die auch im Winter funktioniert.",
  "Ab Sorrent erreicht ein direktes Tragflügelboot Ischia in etwa einer Stunde, von April bis Oktober und nur an einigen Wochentagen. Vico Equense liegt wenige Minuten entfernt an der Circumvesuviana.",
];
---

<BlogPostLayout
  lang={lang}
  post={post}
  metaTitle={metaTitle}
  metaDescription={metaDescription}
  breadcrumbs={breadcrumbs}
  quickInfo={quickInfo}
  faq={faq}
  sidebarLinks={sidebarLinks}
  authorRole={authorRole}
  relatedArticles={relatedArticles}
  pageKey="thermal-spas-ischia-sorrento"
>

  <!-- Key Takeaways -->
  <div class="bg-slate-900 text-white p-8 rounded-[2rem]">
    <div class="flex items-center gap-3 mb-6">
      <svg class="w-5 h-5 text-med-gold flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
      <h2 class="font-serif text-lg font-bold text-med-gold uppercase tracking-[0.15em]">Key Takeaways</h2>
    </div>
    <ul class="space-y-4">
      {keyTakeaways.map((point) => (
        <li class="flex items-start gap-3">
          <span class="w-1.5 h-1.5 rounded-full bg-med-gold flex-shrink-0 mt-2"></span>
          <span class="text-white/80 text-xs sm:text-sm leading-relaxed">{point}</span>
        </li>
      ))}
    </ul>
  </div>

  <!-- Intro -->
  <div>
    <p class="text-slate-600 text-xl leading-relaxed mb-6 font-light">
      Der Golf von Neapel liegt auf vulkanischem Boden, und das warme Wasser, das damit einhergeht, wird seit griechischer und römischer Zeit zum Baden genutzt. Das meiste davon tritt auf <a href="/de-de/inseln/ischia/" class="text-med-blue hover:underline">Ischia</a> zutage, wo heiße Quellen eine Reihe von Thermalparks speisen. Auf der Sorrentinischen Halbinsel gibt es eine einzige historische Quelle, das Schwefelwasser von Scrajo in <a href="/de-de/sorrentinische-halbinsel/vico-equense/" class="text-med-blue hover:underline">Vico Equense</a>, und in <a href="/de-de/sorrentinische-halbinsel/sorrent/" class="text-med-blue hover:underline">Sorrent</a> selbst ein überdachtes Spa, das geöffnet bleibt, wenn die Inseln schließen. Hier steht, was jedes bietet, was es 2026 gekostet hat und wie Sie von Sorrent oder Positano hinkommen.
    </p>
  </div>

  <!-- Ischia -->
  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">Ischia: die Thermalparks</h2>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      Ein Thermalpark auf Ischia ist ein Garten mit mehreren Becken unterschiedlicher Temperatur, gespeist aus den Quellen der Insel, meist ergänzt durch Meerwasserbecken, einen Strand, ein Restaurant und ein Behandlungszentrum. Man zahlt einmal am Eingang und wechselt den Tag über von Becken zu Becken. Alle großen Parks sind saisonal: Sie öffnen im April und schließen im Oktober, und die Saison 2026 geht bereits zu Ende.
    </p>

    <h3 class="font-serif text-2xl font-bold text-slate-900 mb-4">Giardini Poseidon Terme, Forio</h3>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      Der größte Park der Insel, an der Bucht von Citara in <a href="/de-de/inseln/forio/" class="text-med-blue hover:underline">Forio</a>. Er hat 20 Thermal- und Meerwasserbecken auf sechs Hektar Terrassengärten, rund 500 Meter Sandstrand, drei Restaurants und ein Wellnesszentrum mit Dampfgrotte, türkischem und japanischem Bad. Die Saison 2026 läuft vom <strong>18. April bis 31. Oktober</strong>, von 9:00 bis 19:00 Uhr (ab 1. Oktober bis 18:00 Uhr). Damit ist er der Park, der auch im Herbst noch offen ist.
    </p>
    <ul class="space-y-3 mb-8">
      <li class="flex items-start gap-3"><span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span><span class="text-slate-700"><strong>Preise 2026.</strong> 50 Euro für den ganzen Tag, 45 Euro für den Nachmittag (ab 13:00 Uhr), dazu 5 Euro Pfand für das Armband, das beim Ausgang zurückerstattet wird. Mehrtageskarten senken den Tagespreis.</span></li>
      <li class="flex items-start gap-3"><span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span><span class="text-slate-700"><strong>Kinder.</strong> Unter 4 Jahren frei, von 4 bis 11 halber Preis. Kinder unter 12 dürfen nicht in die Thermalbecken, haben aber drei Meerwasserbecken und den Strand.</span></li>
      <li class="flex items-start gap-3"><span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span><span class="text-slate-700"><strong>Regeln.</strong> In allen Becken ist eine Badekappe Pflicht, und eine halbe Stunde vor Schließung beginnt das Ablassen der Becken.</span></li>
    </ul>

    <h3 class="font-serif text-2xl font-bold text-slate-900 mb-4">Parco Termale Negombo, Lacco Ameno</h3>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      Negombo füllt die Bucht von San Montano in Lacco Ameno mit über neun Hektar botanischem Garten, einem Sandstrand, etwa einem Dutzend Thermal- und Meerwasserbecken und einem Wellnesszentrum. Es ist der teuerste Park, und viele erzählen von ihm wegen des Gartens ebenso wie wegen des Wassers. Die Saison 2026 lief vom <strong>23. April bis 13. Oktober</strong>, der Park ist also bis zum nächsten Frühjahr geschlossen.
    </p>
    <ul class="space-y-3 mb-8">
      <li class="flex items-start gap-3"><span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span><span class="text-slate-700"><strong>Preise 2026.</strong> In der Hochsaison (3. Juli bis 14. September) etwa 70 Euro für den ganzen Tag, 50 für den halben Tag und 35 für den späten Nachmittag. Außerhalb dieser Wochen etwa 55, 40 und 30 Euro.</span></li>
      <li class="flex items-start gap-3"><span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span><span class="text-slate-700"><strong>Kinder.</strong> Der Preis richtet sich nach der Körpergröße: unter 1 Meter frei, zwischen 1 und 1,40 Meter ermäßigt, größere Kinder zahlen den Erwachsenenpreis.</span></li>
      <li class="flex items-start gap-3"><span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span><span class="text-slate-700"><strong>Buchung.</strong> Tickets lassen sich online buchen, was sich an Sommerwochenenden lohnt. Handtücher und Bademäntel kann man an der Garderobe leihen.</span></li>
    </ul>

    <h3 class="font-serif text-2xl font-bold text-slate-900 mb-4">Parco Termale Castiglione, Casamicciola</h3>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      Ein kleinerer Park an der Nordküste mit Innen- und Außenbecken über dem Meer, jedes mit Thermalwasser unterschiedlicher Temperatur gespeist, dazu ein Spa, ein Restaurant und ein eigenes Hotel. Er gehört zu den günstigsten Optionen: 2026 kostete der Eintritt für Erwachsene etwa <strong>28 Euro</strong> (29 im August), für Kinder von 2 bis 12 Jahren 10 Euro (17,50 im Juli und August). Der Park hat für diese Saison geschlossen und kündigt an, die Öffnungstermine für 2027 bald zu veröffentlichen.
    </p>

    <h3 class="font-serif text-2xl font-bold text-slate-900 mb-4">Giardini Aphrodite Apollon, Sant'Angelo</h3>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      Oberhalb des Fischerdorfs Sant'Angelo an der Südküste. Der Park hat zwölf Thermalbecken zwischen 20 und 40 Grad, ein überdachtes Whirlpoolbecken, zwei Meerwasserwannen und eine Sauna in einer natürlichen Grotte, mit einem Privatstrand, der zu Fuß oder per Taxiboot in wenigen Minuten erreichbar ist. 2026 kostete der ganze Tag etwa <strong>40 Euro</strong>, der halbe Tag etwa 30. Das diesjährige Schließdatum konnten wir beim Park selbst nicht bestätigen: Rufen Sie gegen Saisonende vorher an.
    </p>

    <h3 class="font-serif text-2xl font-bold text-slate-900 mb-4">Terme di Cavascura, Maronti</h3>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      Die älteste und schlichteste Anlage. Cavascura liegt in einer Schlucht etwa 300 Meter landeinwärts vom <a href="/de-de/strande/inseln/spiaggia-maronti/" class="text-med-blue hover:underline">Maronti-Strand</a>, gebadet wird in einzelnen, in den Tuff gehauenen Wannen, dazu gibt es eine natürliche Dampfgrotte, warmen Schlamm und Massagen. Das Personal sagt Ihnen Reihenfolge und Dauer. Man erreicht die Thermen zu Fuß über den Schluchtweg vom Maronti-Strand oder per Boot von Sant'Angelo und dann zu Fuß. Die Saison dauert meist von Ende April bis Anfang November, von 8:30 bis 18:00 Uhr. Cavascura veröffentlicht keine Preise online, und Weg und Eingang sind für Menschen mit eingeschränkter Mobilität nicht geeignet.
    </p>

    <blockquote class="border-l-4 border-med-gold pl-6 my-8">
      <p class="text-slate-700 text-xl font-serif italic leading-relaxed">
        "Poseidon und Negombo sind ein Ausflug. Cavascura ist ein Bad."
      </p>
    </blockquote>
  </div>

  <!-- Scrajo -->
  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">Vico Equense: das Schwefelwasser von Scrajo</h2>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      Zwei Kilometer nördlich des Zentrums von Vico Equense, wo die Küstenstraße Richtung Castellammare abfällt, treten am Fuß der Steilküste Schwefelquellen aus dem Kalkstein. Die Thermen von Scrajo wurden 1895 gegründet und machten Vico Equense im späten 19. Jahrhundert zum Kurort, mit Anwendungen bei Haut- und Atemwegserkrankungen. Die Familie Scala besitzt die Quellen seit mehr als sechs Generationen.
    </p>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      Heute funktioniert der Ort anders. Das historische Jugendstilgebäude von Scrajo Terme präsentiert sich vor allem als Location für Hochzeiten und Veranstaltungen von April bis Oktober. Gebadet wird weiter unten, im Strandbad <strong>Scrajo Mare 1899</strong> an der SS145, wo das Schwefelwasser in ein Becken am Fels direkt neben dem Meer geleitet wird. Das Wasser hat rund <strong>18 Grad</strong>: ein kühles Mineralbad, keine heiße Quelle, und der Schwefelgeruch gehört dazu.
    </p>
    <ul class="space-y-3 mb-8">
      <li class="flex items-start gap-3"><span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span><span class="text-slate-700"><strong>Saison.</strong> Etwa von Ostern bis Oktober, je nach Wetter, tagsüber. Das Restaurant im Obergeschoss serviert Mittagessen.</span></li>
      <li class="flex items-start gap-3"><span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span><span class="text-slate-700"><strong>Preise.</strong> Eine Preisliste ist online nicht veröffentlicht. Bewertungen aus dem Sommer 2026 beschreiben es in der Hochsaison als teuer, eine nennt etwa 80 Euro für Schirm und zwei Liegen. Rufen Sie vorher an.</span></li>
      <li class="flex items-start gap-3"><span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span><span class="text-slate-700"><strong>Ausstattung.</strong> Liegen und Schirme, Umkleidekabinen, warme und kalte Duschen, Snackbar, Restaurant und eigener Parkplatz.</span></li>
    </ul>
  </div>

  <!-- Ulysse -->
  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">Sorrent: das Ulysse-Spa</h2>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      Das "Ulisse", von dem man in Sorrent spricht, ist das Wellnesszentrum Ulysse in der Via del Mare, im selben Komplex wie das Hotel Ulisse Deluxe. Es ist ein Gebäude mit vier Ebenen und rund 2.500 Quadratmetern, mit Fitnessstudio, halbolympischem Hallenbad, Kosmetikstudio und Spa. Zum Spa-Rundgang gehören ein großes warmes Salzwasserbecken mit Whirlpool und Farblicht, eine Dampfgrotte, eine finnische Sauna, Erlebnisduschen, eine Eisgrotte und ein Ruheraum mit Kräutertees.
    </p>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      Man sollte klar sagen, was es ist: ein modernes Hallen-Spa mit beheiztem Salzwasser, keine natürliche Quelle. Sein Vorteil ist, dass es in der Stadt liegt, öffentlich zugänglich ist und nicht an die Sommersaison gebunden. Das Spa verkauft den Wellness-Rundgang, allein oder mit Massagen, auch an Besucher, die nicht im Hotel wohnen, und Hotelgäste erhalten einen Rabatt. Angegeben sind Öffnungszeiten von 9:00 bis 20:00 Uhr von Montag bis Samstag und von 10:00 bis 19:00 Uhr am Sonntag, der Betreiber weist aber darauf hin, dass Spa und Becken zu bestimmten Zeiten im Jahr wegen Wartung schließen können. Preise sind online nicht veröffentlicht, rufen Sie also vorher an.
    </p>
  </div>

  <!-- Comparison -->
  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">Im Vergleich</h2>
    <div class="overflow-x-auto rounded-[2rem] border border-slate-100 shadow-sm">
      <table class="w-full text-xs sm:text-sm">
        <thead class="bg-slate-900 text-white">
          <tr>
            <th class="text-left p-5 font-serif font-bold text-med-gold">Ort</th>
            <th class="text-left p-5 font-serif font-bold text-med-gold">Saison</th>
            <th class="text-left p-5 font-serif font-bold text-med-gold">Tageskarte (2026)</th>
            <th class="text-left p-5 font-serif font-bold text-med-gold">Ideal für</th>
          </tr>
        </thead>
        <tbody class="bg-white">
          <tr class="border-b border-slate-100">
            <td class="p-5 font-bold">Poseidon, Forio</td>
            <td class="p-5 text-slate-600">18. April bis 31. Oktober</td>
            <td class="p-5 text-slate-600">50 Euro</td>
            <td class="p-5 text-slate-600">Vielfalt, langer Strand, Besuche am Saisonende</td>
          </tr>
          <tr class="border-b border-slate-100">
            <td class="p-5 font-bold">Negombo, Lacco Ameno</td>
            <td class="p-5 text-slate-600">23. April bis 13. Oktober</td>
            <td class="p-5 text-slate-600">Etwa 55 bis 70 Euro</td>
            <td class="p-5 text-slate-600">Gärten, Sandbucht, Familien mit kleinen Kindern</td>
          </tr>
          <tr class="border-b border-slate-100">
            <td class="p-5 font-bold">Castiglione, Casamicciola</td>
            <td class="p-5 text-slate-600">Frühling bis Oktober, Termine 2027 folgen</td>
            <td class="p-5 text-slate-600">Etwa 28 Euro</td>
            <td class="p-5 text-slate-600">Kleines Budget, ruhige Tage</td>
          </tr>
          <tr class="border-b border-slate-100">
            <td class="p-5 font-bold">Aphrodite Apollon, Sant'Angelo</td>
            <td class="p-5 text-slate-600">Thermalsaison, Termine prüfen</td>
            <td class="p-5 text-slate-600">Etwa 40 Euro</td>
            <td class="p-5 text-slate-600">Kombination mit dem Dorf Sant'Angelo</td>
          </tr>
          <tr class="border-b border-slate-100">
            <td class="p-5 font-bold">Cavascura, Maronti</td>
            <td class="p-5 text-slate-600">Ende April bis Anfang November</td>
            <td class="p-5 text-slate-600">Nicht veröffentlicht</td>
            <td class="p-5 text-slate-600">Geschichte, schlichtes Bad, Strandtag am Maronti</td>
          </tr>
          <tr class="border-b border-slate-100">
            <td class="p-5 font-bold">Scrajo Mare, Vico Equense</td>
            <td class="p-5 text-slate-600">Ostern bis Oktober</td>
            <td class="p-5 text-slate-600">Nicht veröffentlicht, Strandbadpreise</td>
            <td class="p-5 text-slate-600">Halber Tag ab Sorrent, kühles Schwefelbad</td>
          </tr>
          <tr>
            <td class="p-5 font-bold">Ulysse, Sorrent</td>
            <td class="p-5 text-slate-600">Ganzjährig, mit Wartungspausen</td>
            <td class="p-5 text-slate-600">Nicht veröffentlicht</td>
            <td class="p-5 text-slate-600">Winter, Regentage, keine Anreise</td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>

  <!-- Getting there -->
  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">Anreise ab Sorrent und Positano</h2>
    <ul class="space-y-3 mb-6">
      <li class="flex items-start gap-3"><span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span><span class="text-slate-700"><strong>Sorrent-Ischia.</strong> Alilauro fährt vom 1. April bis 31. Oktober ein direktes Tragflügelboot, Fahrzeit etwa eine Stunde, ab etwa 24 Euro pro Strecke. 2026 fuhr es morgens und nur an einigen Wochentagen: Prüfen Sie Fahrplan und Rückfahrt, bevor Sie einen Tagesausflug planen.</span></li>
      <li class="flex items-start gap-3"><span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span><span class="text-slate-700"><strong>Positano-Ischia.</strong> Alicost fährt von Juni bis September ein Tragflügelboot über Capri, in der Nebensaison nur am Wochenende, ab etwa 28 Euro. Die Fahrt ist lang und eignet sich eher für eine oder zwei Nächte auf der Insel.</span></li>
      <li class="flex items-start gap-3"><span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span><span class="text-slate-700"><strong>Außerhalb der Saison.</strong> Mit der Circumvesuviana nach Neapel und von dort mit Fähre oder Tragflügelboot. Die Verbindungen stehen in unserem <a href="/de-de/ratgeber/faehren/" class="text-med-blue hover:underline">Fähren-Ratgeber</a>.</span></li>
      <li class="flex items-start gap-3"><span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span><span class="text-slate-700"><strong>Auf Ischia.</strong> EAV-Busse fahren rund um die Insel: Die Linien 1 und 2 und die beiden Ringlinien (CS und CD) halten etwa 500 Meter vom Negombo entfernt, und Poseidon liegt an der Straße nach Citara außerhalb von Forio. Taxis und Mikrotaxis warten an den Häfen. Für Cavascura steigt man zum Maronti-Strand ab oder nimmt das Boot ab Sant'Angelo.</span></li>
      <li class="flex items-start gap-3"><span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span><span class="text-slate-700"><strong>Sorrent-Scrajo.</strong> Die Circumvesuviana erreicht Vico Equense in etwa 15 Minuten. Scrajo liegt rund 2 km weiter nördlich: Nehmen Sie ab Bahnhof einen Ortsbus oder ein Taxi, denn die SS145 hat keinen Gehweg. Früher gab es auf der Strecke einen Halt Scrajo nur im Sommer, prüfen Sie daher den EAV-Fahrplan. Mit dem Auto liegt Scrajo an der SS145 zwischen Castellammare und Vico Equense.</span></li>
      <li class="flex items-start gap-3"><span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span><span class="text-slate-700"><strong>Ulysse.</strong> Es liegt in der Via del Mare in Sorrent und ist von den meisten Hotels im Ort zu Fuß erreichbar.</span></li>
    </ul>
  </div>

  <!-- Which one -->
  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">Welches, und wann</h2>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      Für einen ersten Thermentag mit viel Auswahl ist Poseidon die sichere Wahl, und als einziger großer Park ist er Ende Oktober noch offen. Für Gärten und Sandstrand mit kleinen Kindern Negombo. Für einen günstigeren, ruhigeren Tag Castiglione oder Aphrodite Apollon. Für etwas Älteres und Eigenwilligeres Cavascura, kombiniert mit einem Bad am Maronti-Strand. Wer in Sorrent wohnt und keinen ganzen Tag für die Insel hat, macht im Sommer einen halben Tag in Scrajo, und im Winter oder an einem Regennachmittag ist Ulysse die Antwort.
    </p>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      Die besten Monate für Ischias Parks sind Mai, Juni, September und Anfang Oktober: Heiße Becken sind angenehmer, wenn die Luft es nicht ist, im Negombo gelten die Nebensaisonpreise, und die Parks sind ruhiger. Juli und August bedeuten höhere Preise, volle Becken, und ohne Reservierung wird es schwierig. Wenn Sie einen längeren Aufenthalt abwägen, helfen unsere Vergleiche <a href="/de-de/blog/capri-vs-ischia/" class="text-med-blue hover:underline">Capri oder Ischia</a> und <a href="/de-de/blog/procida-vs-ischia/" class="text-med-blue hover:underline">Procida oder Ischia</a>.
    </p>
  </div>

  <!-- Local Tips -->
  <div class="bg-white p-8 rounded-[2rem] shadow-xl border border-slate-100">
    <div class="flex items-center gap-4 mb-6">
      <svg class="w-6 h-6 text-med-gold flex-shrink-0" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M9 18h6"/><path d="M10 22h4"/><path d="M15.09 14c.18-.98.65-1.74 1.41-2.5A4.65 4.61 0 0 0 18 8 6 6 0 0 0 6 8c0 1 .23 2.23 1.5 3.5A4.61 4.61 0 0 1 8.91 14"/></svg>
      <h3 class="text-xl font-bold">Expertentipps</h3>
    </div>
    <div class="space-y-6">
      <div>
        <p class="font-bold text-slate-900 mb-1">Badekappe und rutschfeste Schuhe einpacken</p>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Im Poseidon ist die Badekappe Pflicht, in Hallenbädern wie dem Ulysse wird sie erwartet. Die Steinwege und Stufen der Parks sind nass rutschig, lassen Sie elegante Sandalen also im Hotel. Bringen Sie Handtuch oder Bademantel mit oder planen Sie die Leihgebühr ein, dazu etwas Bargeld für das Pfand.</p>
      </div>
      <div>
        <p class="font-bold text-slate-900 mb-1">Von heiß zu kühl, und nicht zu lange</p>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Thermalwasser mit 38 bis 40 Grad macht müde. Kurze Bäder, Pausen im Schatten und viel Trinken sind besser als eine Stunde im heißesten Becken. In der Schwangerschaft oder bei Herz- und Blutdruckproblemen fragen Sie vor einem Thermentag Ihren Arzt.</p>
      </div>
      <div>
        <p class="font-bold text-slate-900 mb-1">Die Nachmittagskarte nutzen</p>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Wer mit dem Morgenboot aus Sorrent kommt, ist ohnehin erst gegen Mittag im Park. Die Nachmittagskarte des Poseidon gilt ab 13:00 Uhr und kostet weniger, passend für einen Tagesausflug.</p>
      </div>
      <div>
        <p class="font-bold text-slate-900 mb-1">Die Zahlen des Jahres prüfen</p>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Preise und Termine hier sind die von 2026. Die Parks veröffentlichen die neue Saison im Frühjahr, und die Fahrpläne der Tragflügelboote ändern sich im Lauf des Jahres. Bestätigen Sie beides auf den offiziellen Websites, bevor Sie etwas darum herum buchen.</p>
      </div>
    </div>
  </div>

