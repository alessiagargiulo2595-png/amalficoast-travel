---
import BlogPostLayout from '../../../../layouts/BlogPostLayout.astro';

const lang = 'de-de';
const post = {
  title: 'Neapolitanische Tombola und Smorfia: Was die Zahlen bedeuten',
  subtitle: "Das Weihnachtsspiel jeder Familie in Kampanien, wie es funktioniert, und warum die 47 ein Toter ist, die 48 ein Toter, der spricht, und die 71 jemand, dem man lieber nicht begegnet",
  category: 'ENTDECKUNGEN',
  date: '19. November 2026',
  readTime: '11 Min.',
  image: '/images/tombola-numeri-hero.webp',
  imageAlt: "Tombola-Zahlen aus Holz mit der 31 und der 73 in Rot",
  path: '/de-de/blog/neapolitanische-tombola-smorfia/',
};

const metaTitle = 'Tombola und Smorfia in Neapel: Was die Zahlen bedeuten';
const metaDescription = "Wie die neapolitanische Tombola an Weihnachten gespielt wird und was die Smorfia-Zahlen bedeuten: 33, 47, 48, 71, 77, 90 und mehr, auf Neapolitanisch und übersetzt.";

const breadcrumbs = [
  { name: 'Home', url: '/de-de/' },
  { name: 'Blog', url: '/de-de/blog/' },
  { name: 'Neapolitanische Tombola und Smorfia', url: '/de-de/blog/neapolitanische-tombola-smorfia/' },
];

const quickInfo = [
  { label: 'Was es ist', value: 'Ein Lotto für zu Hause, ähnlich wie Bingo' },
  { label: 'Wann', value: 'Die Weihnachtsfeiertage' },
  { label: 'Zahlen', value: '1 bis 90' },
  { label: 'Karte', value: '15 Zahlen in 3 Reihen' },
  { label: 'Gewinne', value: 'Ambo, Terno, Quaterna, Cinquina, Tombola' },
  { label: 'Der Korb', value: 'Panariello' },
  { label: 'Die Smorfia', value: 'Eine Bedeutung für jede Zahl' },
  { label: 'Am meisten zitiert', value: '47, 48, 71, 90' },
];

const faq = [
  {
    q: 'Was ist die neapolitanische Tombola?',
    a: "Ein Glücksspiel für die Familie, das über die Weihnachtsfeiertage gespielt wird. Die Zahlen von 1 bis 90 werden einzeln aus einem Korb gezogen, und die Spieler decken sie auf ihren Karten ab, ähnlich wie beim Bingo. Gewinne gibt es für den Ersten mit zwei, drei, vier oder fünf Zahlen in derselben Reihe, den Hauptgewinn, die Tombola, für den, der zuerst die ganze Karte voll hat. In Neapel wird jede Zahl mit ihrer Bedeutung aus der Smorfia ausgerufen.",
  },
  {
    q: 'Wann wird Tombola gespielt?',
    a: "Über die Weihnachtsfeiertage: nach dem Essen an Heiligabend, am ersten Weihnachtstag, an Silvester und an den ruhigeren Abenden dazwischen. Die Überlieferung verbindet das Spiel mit der weihnachtlichen Pause des Lottos, in der die Familien ihre eigene Version zu Hause spielten.",
  },
  {
    q: 'Was bedeutet die 71 in der Smorfia?',
    a: "Die 71 ist \"L'ommo 'e merda\", wörtlich der Scheißkerl: ein wertloser Mensch ohne Anstand und Wort. Sie gehört zu den vulgären Zahlen der Smorfia und zu den meistzitierten, weil man sie am Tisch gern ausruft, während man einen bestimmten Verwandten ansieht.",
  },
  {
    q: 'Was ist der Unterschied zwischen 47 und 48?',
    a: "In Neapel ist die 47 \"'O muorto\", der Tote, und die 48 \"'O muorto che parla\", der Tote, der spricht, was im Traum eine Botschaft von einem Verstorbenen bedeutet. In vielen anderen italienischen Städten ist der sprechende Tote die 47, deshalb heißt Totòs Film von 1950 47 morto che parla.",
  },
  {
    q: 'Warum macht die Angst 90?',
    a: "Weil die 90 in der Smorfia \"'A paura\" ist, die Angst. Die italienische Redensart la paura fa novanta, die Angst macht neunzig, stammt direkt daher und wird in ganz Italien benutzt, auch von Leuten, die nie in Neapel Tombola gespielt haben.",
  },
  {
    q: 'Was ist die Tombola scostumata?',
    a: "Die unanständige Version, auch Tombola vajassa oder Tombola dei femminielli genannt. Wer den Korb hält, zieht die Zahlen, verkündet ihre Bedeutung auf Neapolitanisch und verknüpft sie zu einer improvisierten, sehr pikanten Geschichte. Traditionell leiteten sie die Femminielli der Armenviertel, heute sieht man sie vor allem als Weihnachtsshow in Theatern in Neapel.",
  },
];

const sidebarLinks = [
  { label: 'Krippen in Neapel und Sorrent', href: '/de-de/blog/krippen-neapel-sorrent/' },
  { label: 'Neapolitanisches Weihnachtsgebäck', href: '/de-de/blog/weihnachtsgebaeck-neapel/' },
  { label: 'Allerseelen und Halloween', href: '/de-de/blog/allerseelen-halloween/' },
  { label: 'Sorrent', href: '/de-de/sorrentinische-halbinsel/sorrent/' },
];

const authorRole = 'Lokaler Experte · Sorrentinische Halbinsel';

const relatedArticles = [
  {
    title: 'Krippen in Neapel und Sorrent: Ein Ratgeber für Dezember',
    category: 'REISEFÜHRER',
    date: '10. November 2026',
    image: '/images/presepe-natale-hero.webp',
    imageAlt: 'Krippe in Neapel',
    path: '/de-de/blog/krippen-neapel-sorrent/'
  },
  {
    title: 'Neapolitanisches Weihnachtsgebäck',
    category: 'ESSEN',
    date: '14. November 2026',
    image: '/images/struffoli-hero.webp',
    imageAlt: 'Struffoli, das neapolitanische Weihnachtsgebäck',
    path: '/de-de/blog/weihnachtsgebaeck-neapel/'
  }
];

const keyTakeaways = [
  "Die neapolitanische Tombola ist ein Lotto für zu Hause mit den Zahlen von 1 bis 90, das Familien über die Weihnachtsfeiertage spielen.",
  "Die Überlieferung datiert sie auf Neapel im Jahr 1734, als das Lotto über Weihnachten ausgesetzt wurde und die Familien die Zahlen zu Hause zogen.",
  "Gewinne gibt es für Ambo, Terno, Quaterna und Cinquina (zwei bis fünf Zahlen in einer Reihe) und für die Tombola, die volle Karte.",
  "Jede Zahl wird mit ihrer Bedeutung aus der Smorfia ausgerufen, dem neapolitanischen Traumbuch: 47 ist der Tote, 48 der Tote, der spricht, 90 die Angst.",
  "Manche Bedeutungen sind absichtlich vulgär, allen voran die 71, und die unanständige Version des Spiels, die Tombola scostumata, ist heute eine Weihnachtsshow.",
];

const numbers = [
  { n: 1, nap: "L'Italia", lit: "Italien", text: "Die erste Zahl gehört dem Land. Ältere Smorfie gaben ihr andere Bilder, aber heute steht auf jedem Spielbrett Italien." },
  { n: 10, nap: "'E fasule", lit: "Die Bohnen", text: "Eine bescheidene Zahl für ein bescheidenes Essen. Passend, denn getrocknete Bohnen sind genau das, womit viele Familien die Zahlen auf den Karten abdecken." },
  { n: 13, nap: "Sant'Antuono", lit: "Der heilige Antonius", text: "Sant'Antuono ist der heilige Antonius der Große, einer der beliebtesten Heiligen Kampaniens. Die 13 bringt hier kein Unglück: Diese Aufgabe hat die 17." },
  { n: 16, nap: "'O culo", lit: "Der Hintern", text: "Wörtlich der Hintern, im übertragenen Sinn das Glück, denn avere culo heißt auf Italienisch Schwein haben. Wer zu oft gewinnt, bekommt diese Zahl zu hören." },
  { n: 17, nap: "'A disgrazzia", lit: "Das Unglück", text: "Die 17 ist in Italien die Unglückszahl. Die übliche Erklärung: Die römische XVII ergibt umgestellt VIXI, lateinisch ich habe gelebt, also ich bin tot." },
  { n: 22, nap: "'O pazzo", lit: "Der Verrückte", text: "Wird mit einem Blick auf den ausgerufen, der sich am Tisch am seltsamsten benimmt, was an einem Weihnachtsabend selten schwer zu entscheiden ist." },
  { n: 25, nap: "Natale", lit: "Weihnachten", text: "Das Datum spricht für sich. Wenn bei einer Weihnachtstombola die 25 kommt, gibt es kleinen Applaus." },
  { n: 28, nap: "'E zizze", lit: "Die Brüste", text: "Eine der frechen Zahlen. Großmütter sagen sie, ohne mit der Wimper zu zucken, Teenager kichern." },
  { n: 33, nap: "L'anne 'e Cristo", lit: "Die Jahre Christi", text: "Dreiunddreißig, das Alter, in dem Christus starb. Auch ll'anne 'e Criste geschrieben, näher an der Aussprache." },
  { n: 34, nap: "'A capa", lit: "Der Kopf", text: "Schlicht und anatomisch: capa ist das neapolitanische Wort für Kopf. Wer von einem Kopf träumt, dem eigenen oder einem fremden, landet hier." },
  { n: 37, nap: "'O monaco", lit: "Der Mönch", text: "Eine Stadt mit so vielen Klöstern wie Neapel musste dem Mönch eine eigene Zahl geben. Wer von einem Mönch oder Bruder träumt, spielt die 37." },
  { n: 43, nap: "'Onna Pereta fore 'o balcone", lit: "Donna Pereta draußen auf dem Balkon", text: "Eine Frau, die sich über ihren Balkon lehnt, die ewige Figur der neapolitanischen Gasse, die alles sieht und alles kommentiert. Pereta ist kein Name, den man im Melderegister findet." },
  { n: 45, nap: "'O vino bbuono", lit: "Der gute Wein", text: "Der gute Wein, ausdrücklich. Passend für einen Tisch, an dem seit dem Nachmittag gegessen wird." },
  { n: 47, nap: "'O muorto", lit: "Der Tote", text: "Einfach der Tote. Wer von einem Verstorbenen träumt, landet traditionell hier, es sei denn, der Tote spricht." },
  { n: 48, nap: "'O muorto che parla", lit: "Der Tote, der spricht", text: "Spricht der Tote im Traum, ist es die 48, und was er sagt, soll weitere Zahlen nahelegen. Außerhalb Neapels geben viele Städte den sprechenden Toten der 47, daher Totòs Film von 1950 47 morto che parla." },
  { n: 55, nap: "'A musica", lit: "Die Musik", text: "Die Musik, in einer Stadt, die Lieder exportiert. Auch 'a museca geschrieben, so wie man es ausspricht." },
  { n: 69, nap: "Sotto e 'ncoppa", lit: "Drunter und drüber", text: "Wörtlich unten und oben. Ein Blick auf die beiden Ziffern genügt, die Logik braucht keinen weiteren Kommentar." },
  { n: 71, nap: "L'ommo 'e merda", lit: "Der Scheißkerl", text: "Wörtlich der Mann aus Scheiße: ein wertloser Mensch ohne Anstand und Wort. Die berühmteste vulgäre Zahl wird mit Genuss ausgerufen, oft mit Blick auf einen bestimmten Onkel. Auch l'omm 'e mmerd geschrieben, so wie es klingt." },
  { n: 75, nap: "Pulecenella", lit: "Pulcinella", text: "Die Maskenfigur der neapolitanischen Komödie, weißes Gewand und schwarze Halbmaske, arm, hungrig und immer mit einem Ausweg." },
  { n: 77, nap: "'E riavule", lit: "Die Teufel", text: "In Neapel ist die 77 die Teufel. Die Deutung der 77 als Frauenbeine, die viele zitieren, gehört zu anderen Traditionen: Ein römisches Sonett von 1883 gibt ihr schon diese Bedeutung." },
  { n: 85, nap: "Ll'aneme d''o priatorio", lit: "Die Seelen im Fegefeuer", text: "Die Seelen der Verstorbenen, die im Fegefeuer warten, ein Kernstück der neapolitanischen Volksfrömmigkeit und des Totengedenkens im November." },
  { n: 89, nap: "'A vecchia", lit: "Die alte Frau", text: "Die Alte, feste Figur in Märchen und Gassen. Wird üblicherweise nicht mit Blick auf die Großmutter ausgerufen, die gerade den Korb hält." },
  { n: 90, nap: "'A paura", lit: "Die Angst", text: "Die letzte Zahl und der Ursprung der Redensart la paura fa novanta, die Angst macht neunzig, für Momente, in denen der Schreck jemanden zu Dingen treibt, die er sonst nie täte." },
];
---

<BlogPostLayout
  lang={lang}
  post={post}
  metaTitle={metaTitle}
  metaDescription={metaDescription}
  breadcrumbs={breadcrumbs}
  quickInfo={quickInfo}
  faq={faq}
  sidebarLinks={sidebarLinks}
  authorRole={authorRole}
  relatedArticles={relatedArticles}
  pageKey="neapolitan-tombola-smorfia"
>

  <!-- Key Takeaways -->
  <div class="bg-slate-900 text-white p-8 rounded-[2rem]">
    <div class="flex items-center gap-3 mb-6">
      <svg class="w-5 h-5 text-med-gold flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
      <h2 class="font-serif text-lg font-bold text-med-gold uppercase tracking-[0.15em]">Key Takeaways</h2>
    </div>
    <ul class="space-y-4">
      {keyTakeaways.map((point) => (
        <li class="flex items-start gap-3">
          <span class="w-1.5 h-1.5 rounded-full bg-med-gold flex-shrink-0 mt-2"></span>
          <span class="text-white/80 text-xs sm:text-sm leading-relaxed">{point}</span>
        </li>
      ))}
    </ul>
  </div>

  <!-- Intro -->
  <div>
    <p class="text-slate-600 text-xl leading-relaxed mb-6 font-light">
      Das Weihnachtsessen ist vorbei, der Tisch ist gerade so weit abgeräumt, dass Platz entsteht, und jemand holt einen kleinen Weidenkorb voller Holzzahlen hervor. Die nächsten drei Stunden streitet eine ganze neapolitanische Familie um getrocknete Bohnen. Das Spiel heißt <em>Tombola</em>, eine Art Lotto für zu Hause, das ziemlich genau wie Bingo funktioniert, und neapolitanisch macht es die Stimme dessen, der den Korb hält: Jede Zahl kommt mit ihrer Bedeutung aus der <em>Smorfia</em> heraus, dem Traumbuch, und manche dieser Bedeutungen sind nichts für den Pfarrer.
    </p>
  </div>

  <!-- What it is -->
  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">Was die Tombola ist und wann sie gespielt wird</h2>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      Die Tombola ist ein Glücksspiel mit 90 Zahlen. Eine Person zieht sie einzeln aus einem Korb und ruft sie aus, alle anderen decken sie auf ihren eigenen Karten ab. Gewinne gibt es für den, der als Erster zwei, drei, vier oder fünf Zahlen in derselben Reihe hat, den großen Gewinn für den, der die ganze Karte abgedeckt hat. Wer Bingo kennt, kennt das meiste schon.
    </p>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      Sie gehört zu den Weihnachtsfeiertagen, die in Italien bis zum Dreikönigstag am 6. Januar dauern. Die klassischen Abende sind Heiligabend nach dem Fischessen, der erste Weihnachtstag nach dem Mittagessen und Silvester beim Warten auf Mitternacht, aber in vielen Häusern kommt der Korb an jedem Abend auf den Tisch, an dem die Familie zusammen ist und niemand in die Kälte hinaus will. Großeltern und Kinder spielen am selben Tisch, mit ein paar Münzen pro Karte, und das Geld bleibt ohnehin in der Familie.
    </p>
    <p class="text-slate-600 text-lg leading-relaxed">
      Gespielt wird in ganz Kampanien, von Neapel über <a href="/de-de/sorrentinische-halbinsel/sorrent/" class="text-med-blue hover:underline">Sorrent</a> bis in die Orte der Amalfiküste. Wer Weihnachten hier verbringt und gefragt wird, ob er eine Karte möchte, sagt ja.
    </p>
  </div>

  <!-- Origin -->
  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">Woher sie kommt: ein König, ein Dominikaner und das Lotto</h2>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      Neapel setzte schon lange vor der Tombola aufs Lotto. Das Schema mit 90 Zahlen geht auf ein genuesisches Spiel des 16. Jahrhunderts zurück, und das Lotto war Ende des 17. Jahrhunderts nach Neapel gekommen, wo es zu gleichen Teilen legal und illegal gespielt wurde.
    </p>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      Die Überlieferung verlegt die Geburt der Tombola ins Jahr <strong>1734</strong>, unter Karl von Bourbon, dem späteren Karl III. von Spanien. Der König wollte das Lotto unter staatliche Kontrolle bringen, damit die Staatskasse daran verdiente und nicht die heimlichen Bankhalter. Gegen ihn stand der Dominikaner <strong>Gregorio Maria Rocco</strong>, ein berühmter Prediger, der das Spiel einen trügerischen und unmoralischen Zeitvertreib nannte, der das Volk vom Gebet abhalte. Der Kompromiss, so die Geschichte, bestand darin, das Lotto über die Weihnachtsfeiertage ruhen zu lassen. Da sie nicht öffentlich spielen konnten, legten die neapolitanischen Familien die Zahlen in einen Korb und zogen sie zu Hause.
    </p>
    <p class="text-slate-600 text-lg leading-relaxed">
      Die Einzelheiten sind eher gefestigte Überlieferung als ein dokumentiertes Dekret: Es ist die Geschichte, die alle neapolitanischen Quellen wiederholen, und eine bessere hat niemand vorgelegt. Der Name kommt wahrscheinlich vom Purzeln der Zahlen im Korb vor jeder Ziehung, auf Italienisch tombolare.
    </p>
  </div>

  <!-- How to play -->
  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">So wird gespielt</h2>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      Man braucht drei Dinge: die <strong>cartelle</strong>, die Spielkarten; den <strong>cartellone</strong>, das große Brett mit allen 90 Zahlen; und den <strong>panariello</strong>, den kleinen Weidenkorb mit den 90 Zahlen aus Holz oder Plastik. Jede Karte hat drei Reihen mit je fünf Zahlen, insgesamt fünfzehn, verteilt auf neun Spalten. Jeder kauft so viele Karten, wie er will, oft für ein paar Cent das Stück, und das eingesammelte Geld wird zum Gewinntopf.
    </p>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      Wer den Cartellone hat, zieht und ruft, legt jede Zahl auf das Brett und spielt selbst mit: Das Brett zählt wie sechs Karten und kann gewinnen wie alle anderen. Abgedeckt wird mit dem, was die Küche hergibt. Getrocknete Bohnen sind der Klassiker, Stückchen von Mandarinenschale kommen gleich danach.
    </p>

    <div class="overflow-x-auto rounded-[2rem] border border-slate-100 shadow-sm mb-6">
      <table class="w-full text-xs sm:text-sm">
        <thead class="bg-slate-900 text-white">
          <tr>
            <th class="text-left p-5 font-serif font-bold text-med-gold">Gewinn</th>
            <th class="text-left p-5 font-serif font-bold text-med-gold">Was man braucht</th>
          </tr>
        </thead>
        <tbody class="bg-white">
          <tr class="border-b border-slate-100">
            <td class="p-5 font-bold">Ambo</td>
            <td class="p-5 text-slate-600">Zwei Zahlen in derselben Reihe einer Karte.</td>
          </tr>
          <tr class="border-b border-slate-100">
            <td class="p-5 font-bold">Terno</td>
            <td class="p-5 text-slate-600">Drei Zahlen in derselben Reihe.</td>
          </tr>
          <tr class="border-b border-slate-100">
            <td class="p-5 font-bold">Quaterna</td>
            <td class="p-5 text-slate-600">Vier Zahlen in derselben Reihe.</td>
          </tr>
          <tr class="border-b border-slate-100">
            <td class="p-5 font-bold">Cinquina</td>
            <td class="p-5 text-slate-600">Alle fünf Zahlen einer Reihe.</td>
          </tr>
          <tr class="border-b border-slate-100">
            <td class="p-5 font-bold">Tombola</td>
            <td class="p-5 text-slate-600">Alle fünfzehn Zahlen einer Karte. Der Hauptgewinn, angekündigt durch lautes Rufen des Spielnamens.</td>
          </tr>
          <tr>
            <td class="p-5 font-bold">Tombolino</td>
            <td class="p-5 text-slate-600">Ein freiwilliger Gewinn für die zweite volle Karte, damit die Runde etwas länger dauert.</td>
          </tr>
        </tbody>
      </table>
    </div>

    <ul class="space-y-3">
      <li class="flex items-start gap-3"><span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span><span class="text-slate-700"><strong>Laut ansagen.</strong> Jeder Gewinn muss gemeldet werden, bevor die nächste Zahl gezogen wird, sonst geht er an den, der sich danach meldet.</span></li>
      <li class="flex items-start gap-3"><span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span><span class="text-slate-700"><strong>Gewinne der Reihe nach.</strong> Erst Ambo, dann Terno und so weiter bis zur Tombola. Niemand kann ein Terno gewinnen, bevor jemand Ambo gemacht hat.</span></li>
      <li class="flex items-start gap-3"><span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span><span class="text-slate-700"><strong>Der Korb wandert.</strong> In vielen Familien übernimmt, wer die Tombola gewinnt, den Cartellone für die nächste Runde.</span></li>
    </ul>
  </div>

  <!-- Smorfia -->
  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">Die Smorfia, erklärt</h2>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      Die <em>Smorfia</em> ist das neapolitanische Traumbuch: ein volkstümliches Wörterbuch, das Träume und Alltagsereignisse in Zahlen von 1 bis 90 übersetzt, ursprünglich um zu wissen, was man im Lotto setzen soll. Man träumt von einer Katze, man setzt die 3. Ein verstorbener Verwandter spricht im Traum, man setzt die 48. Der Name wird meist mit Morpheus verbunden, dem griechischen Gott der Träume; die Ursprünge sind unklar, die Theorien reichen von der Kabbala bis zur pythagoreischen Zahlenlehre.
    </p>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      Sie wurde lange mündlich weitergegeben, bevor sie gedruckt wurde, und als man sie aufschrieb, ordnete man sie nach Bildern, damit auch Menschen sie nutzen konnten, die nicht lesen konnten. Deshalb zeigt der neapolitanische Cartellone bis heute in jedem Feld ein kleines Bild. Die Bedeutungen können von Stadt zu Stadt abweichen, und selbst innerhalb Neapels findet man Varianten und mehrere Schreibweisen desselben Ausdrucks.
    </p>
    <p class="text-slate-600 text-lg leading-relaxed">
      Bei der Tombola wird die Smorfia zum Theater. Wer ausruft, sagt selten nur die Zahl: Er sagt die Bedeutung, manchmal nur die Bedeutung, und der Tisch muss die Zahl erraten. Ein guter Ausrufer macht aus den Zahlen Sticheleien gegen die Anwesenden. Ende der 1970er-Jahre nannten Massimo Troisi, Lello Arena und Enzo De Caro ihr Komikertrio sogar La Smorfia.
    </p>
  </div>

  <!-- Numbers -->
  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">Was die Zahlen bedeuten</h2>
    <p class="text-slate-600 text-lg leading-relaxed mb-8">
      Hier die meistgesuchten Zahlen und die, die man an einem neapolitanischen Tisch am ehesten hört. Zu jeder: der Ausdruck auf Neapolitanisch in der üblichsten Schreibweise, die wörtliche Übersetzung und eine kurze Erklärung. Einige sind vulgär; sie gehören zum Spiel, und sie wegzulassen wäre gelogen.
    </p>
    <div class="space-y-4">
      {numbers.map((item) => (
        <div class="bg-white p-6 rounded-[2rem] border border-slate-100 shadow-sm">
          <h3 class="font-serif text-xl font-bold text-slate-900 mb-2">Was bedeutet die {item.n}?</h3>
          <p class="text-slate-900 font-semibold mb-2"><span class="text-med-gold">{item.n}</span> · <em>{item.nap}</em> · {item.lit}</p>
          <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">{item.text}</p>
        </div>
      ))}
    </div>
  </div>

  <!-- Scostumata -->
  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">Die Tombola scostumata</h2>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      Es gibt die Familien-Tombola, und es gibt die <em>Tombola scostumata</em>, die unanständige, auch <em>Tombola vajassa</em> oder <em>Tombola dei femminielli</em> genannt. Die Regeln sind dieselben. Anders ist der Ausrufer, der jede Zahl mit ihrer derbsten Bedeutung ankündigt, streng auf Neapolitanisch, und eine Ziehung an die nächste hängt, bis eine improvisierte Geschichte entsteht, die mit jedem Feld auf dem Brett unanständiger wird.
    </p>
    <p class="text-slate-600 text-lg leading-relaxed">
      Traditionell leiteten sie die <em>Femminielli</em>, eine anerkannte Figur der neapolitanischen Volksviertel, in Runden, die Frauen und Kindern vorbehalten waren. Heute lebt sie vor allem als Weihnachtsshow weiter: Theater und Kabaretts in Neapel bringen jeden Dezember Tombolate scostumate auf die Bühne, oft mit Abendessen. Gutes Neapolitanisch braucht man nicht. Die Gesten erledigen fast alles.
    </p>
  </div>

  <!-- Where to buy -->
  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">Wo man ein Tombola-Spiel kauft</h2>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      Im Dezember tauchen Tombola-Spiele in ganz Kampanien auf: Schreibwarenläden, Spielzeuggeschäfte, Tabakläden und Supermärkte stapeln sie an der Kasse. Gesucht ist die neapolitanische Version mit dem illustrierten Cartellone und dem Smorfia-Bild in jedem Feld; ein Brett nur mit Zahlen tut es auch, aber dann fehlt der halbe Spaß.
    </p>
    <p class="text-slate-600 text-lg leading-relaxed">
      Wer in Neapel ist: Die Werkstätten der Via San Gregorio Armeno verkaufen neben den Krippenfiguren auch neapolitanische Souvenirs, und die Straße eignet sich gut, um nach Gegenständen rund um die Smorfia zu suchen. Das Angebot ist von Laden zu Laden verschieden, also eher ein Stöbern als ein garantierter Kauf. Unser Ratgeber zu den <a href="/de-de/blog/krippen-neapel-sorrent/" class="text-med-blue hover:underline">Krippen in Neapel und Sorrent</a> erklärt, wie man von der Halbinsel dorthin kommt.
    </p>
  </div>

