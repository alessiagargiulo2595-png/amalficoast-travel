---
import BlogPostLayout from '../../../../layouts/BlogPostLayout.astro';

const lang = 'de-de';
const post = {
  title: 'Weihnachtsbeleuchtung in Sorrent und Salerno',
  subtitle: 'Luci d\'Artista und M\'illumino d\'Inverno, die beiden Lichtfeste des Golfs, mit Terminen, Orten und wie man beide auf einer Reise sieht',
  category: 'REISEFÜHRER',
  date: '21. Oktober 2026',
  readTime: '10 Min.',
  image: '/images/luci-artista-salerno-hero.webp',
  imageAlt: "Lichtinstallation mit rosa Flamingos im Villa Comunale in Salerno während Luci d'Artista",
  path: '/de-de/blog/weihnachtsbeleuchtung-sorrent-salerno/',
};

const metaTitle = 'Weihnachtslichter Sorrent und Salerno: Termine 2026/2027';
const metaDescription = 'Luci d\'Artista in Salerno und M\'illumino d\'Inverno in Sorrent: erwartete Termine für die Saison 2026/2027, wo die Installationen stehen, später Nahverkehr und wie man beide Städte verbindet.';

const breadcrumbs = [
  { name: 'Home', url: '/de-de/' },
  { name: 'Blog', url: '/de-de/blog/' },
  { name: 'Weihnachtsbeleuchtung in Sorrent und Salerno', url: '/de-de/blog/weihnachtsbeleuchtung-sorrent-salerno/' },
];

const quickInfo = [
  { label: 'Salerno', value: 'Luci d\'Artista, 21. Ausgabe' },
  { label: 'Erwartete Termine', value: '14. November 2026 bis 1. Februar 2027' },
  { label: 'Kosten', value: 'Kostenlos, die ganze Stadt ist die Ausstellung' },
  { label: 'Sorrent', value: 'M\'illumino d\'Inverno, 18. Ausgabe' },
  { label: 'Erwartete Termine', value: 'Ende November bis Mitte Januar' },
  { label: 'Einschalten', value: 'Piazza Tasso, Anfang Dezember' },
  { label: 'Entfernung', value: 'Rund 1h30 mit dem Zug über Neapel' },
  { label: 'Beste Zeit', value: 'Wochentagabende, ab 17:00 Uhr' },
];

const faq = [
  {
    q: 'Wann beginnen die Luci d\'Artista in Salerno 2026?',
    a: 'Die zwanzigste Ausgabe lief vom 14. November 2025 bis 1. Februar 2026, und der veröffentlichte Kalender für die einundzwanzigste nennt den 14. November 2026 bis 1. Februar 2027. Die Gemeinde bestätigt den Einschalttermin im Herbst, prüfen Sie ihn also auf der kommunalen Website, bevor Sie eine Reise auf einen bestimmten Abend legen.',
  },
  {
    q: 'Ist Luci d\'Artista kostenlos?',
    a: 'Ja. Die Installationen stehen in öffentlichen Strassen, Plätzen und Parks, das Ablaufen der Route kostet also nichts. Ausnahme sind die umzäunten Installationen, allen voran jene im Villa Comunale, wo der Zutritt an vollen Abenden über eine Warteschlange und zeitlich gestaffelte Einlässe geregelt wird.',
  },
  {
    q: 'Wo genau stehen die Installationen in Salerno?',
    a: 'Die Hauptroute führt durch den Villa Comunale an der Via Roma, das Domviertel, die Piazza della Libertà, den Corso Vittorio Emanuele, die mittelalterliche Via dei Mercanti und die Lungomare Trieste. Weitere Werke stehen in Aussenvierteln wie Pastena, weshalb die Metro und die Busse eine Rolle spielen.',
  },
  {
    q: 'Wann leuchten die Lichter in Sorrent?',
    a: 'M\'illumino d\'Inverno umfasst üblicherweise Ende November bis Mitte Januar. Die siebzehnte Ausgabe lief vom 30. November 2025 bis 18. Januar 2026, der Baum auf der Piazza Tasso und die Strassenbeleuchtung gingen am Abend des 6. Dezember an, begleitet von der Stadtkapelle. Die achtzehnte Ausgabe wird auf einem ähnlichen Kalender erwartet.',
  },
  {
    q: 'Kann man beides an einem Tag sehen?',
    a: 'Technisch ja, die beiden liegen rund anderthalb Stunden mit dem Zug über Neapel auseinander, aber es wird ein sehr langer Tag mit zwei Abendprogrammen in einem. Besser, man nimmt eine der beiden Städte als Basis und gibt der anderen einen eigenen Abend, mit später Rückfahrt im Zug.',
  },
  {
    q: 'Fahren die Küstenfähren im Winter?',
    a: 'Nein. Die Fährverbindungen entlang der Amalfiküste und zu den Inseln ruhen im Winter, der Weg zwischen Sorrent und Salerno im Dezember führt also über die Circumvesuviana nach Neapel und von dort mit dem Zug weiter. SITA-Busse fahren, allerdings nach reduziertem Winterfahrplan.',
  },
];

const sidebarLinks = [
  { label: 'Salerno', href: '/de-de/amalfikueste/salerno/' },
  { label: 'Sorrent', href: '/de-de/sorrentinische-halbinsel/sorrent/' },
  { label: 'Die Amalfiküste mit dem Zug', href: '/de-de/blog/amalfikueste-mit-dem-zug/' },
  { label: 'SITA-Bus', href: '/de-de/ratgeber/sita-bus/' },
  { label: 'Parken und ZTL', href: '/de-de/ratgeber/parken-ztl/' },
];

const authorRole = 'Lokaler Experte · Amalfiküste';

const relatedArticles = [
  {
    title: 'Die Amalfiküste mit dem Zug',
    category: 'REISEFÜHRER',
    date: '10. August 2026',
    image: '/images/treno-costiera-hero.webp',
    imageAlt: 'Die Amalfiküste mit dem Zug',
    path: '/de-de/blog/amalfikueste-mit-dem-zug/'
  },
  {
    title: 'Sorrent oder Positano: Wo an der Amalfiküste übernachten',
    category: 'REISEFÜHRER',
    date: '15. Juni 2026',
    image: '/images/sorrento-vs-positano-hero.webp',
    imageAlt: 'Sorrent und Positano im Vergleich',
    path: '/de-de/blog/sorrento-vs-positano/'
  }
];

const imageCredit = {
  author: 'Marco Ebreo / Wikimedia Commons',
  sourceUrl: 'https://commons.wikimedia.org/wiki/File:Luci_D%27Artista_2.jpg',
  license: 'CC BY-SA 4.0',
  licenseUrl: 'https://creativecommons.org/licenses/by-sa/4.0/',
};

const keyTakeaways = [
  'Es sind zwei getrennte Feste mit unterschiedlichem Charakter: Salernos Luci d\'Artista ist eine stadtweite Lichtkunstausstellung, Sorrents M\'illumino d\'Inverno ein zweimonatiges Programm rund um einen geschmückten Ort.',
  'Salernos einundzwanzigste Ausgabe wird vom 14. November 2026 bis 1. Februar 2027 erwartet, mit denselben Daten wie die zwanzigste, und ist kostenlos.',
  'Sorrent schaltet üblicherweise in den ersten Dezembertagen auf der Piazza Tasso ein und hält das Programm bis Mitte Januar.',
  'Die Dezemberwochenenden in Salerno sind wirklich voll, mit Warteschlange an der Installation im Villa Comunale und Verkehr auf den Zufahrten. Wochentagabende sind eine andere Erfahrung.',
  'Im Winter fahren keine Fähren. Von Sorrent nach Salerno geht es mit der Circumvesuviana nach Neapel und weiter mit dem Zug, insgesamt rund anderthalb Stunden.',
];
---

<BlogPostLayout
  lang={lang}
  post={post}
  metaTitle={metaTitle}
  metaDescription={metaDescription}
  breadcrumbs={breadcrumbs}
  quickInfo={quickInfo}
  faq={faq}
  sidebarLinks={sidebarLinks}
  authorRole={authorRole}
  relatedArticles={relatedArticles}
  imageCredit={imageCredit}
  pageKey="christmas-lights-sorrento-salerno"
>

  <!-- Key Takeaways -->
  <div class="bg-slate-900 text-white p-8 rounded-[2rem]">
    <div class="flex items-center gap-3 mb-6">
      <svg class="w-5 h-5 text-med-gold flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
      <h2 class="font-serif text-lg font-bold text-med-gold uppercase tracking-[0.15em]">Key Takeaways</h2>
    </div>
    <ul class="space-y-4">
      {keyTakeaways.map((point) => (
        <li class="flex items-start gap-3">
          <span class="w-1.5 h-1.5 rounded-full bg-med-gold flex-shrink-0 mt-2"></span>
          <span class="text-white/80 text-xs sm:text-sm leading-relaxed">{point}</span>
        </li>
      ))}
    </ul>
  </div>

  <!-- Intro -->
  <div>
    <p class="text-slate-600 text-xl leading-relaxed mb-6 font-light">
      Die Amalfiküste leert sich im November, und dann schalten zwei Städte an den beiden Enden der Bucht die Lichter ein und füllen sich wieder, mit einem fast ausschliesslich italienischen Publikum. <a href="/de-de/amalfikueste/salerno/" class="text-med-blue hover:underline">Salerno</a> verwandelt seine Strassen seit zwei Jahrzehnten jeden Winter in eine Freiluftausstellung für Lichtkunst, und <a href="/de-de/sorrentinische-halbinsel/sorrent/" class="text-med-blue hover:underline">Sorrent</a> bringt unter seinem eigenen Schmuck ein zweimonatiges Programm aus Konzerten, Krippen und Märkten. Luftlinie liegen vierzig Kilometer dazwischen, im Winter praktisch anderthalb Stunden. So funktionieren beide.
    </p>
  </div>

  <!-- Salerno -->
  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">Salerno: Luci d'Artista</h2>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      Luci d'Artista begann in der Saison 2006 und ist zur grössten Veranstaltung ihrer Art in Süditalien gewachsen, mit hunderttausenden Besuchern jeden Winter. Gemeint sind nicht Lichterketten über einer Einkaufsstrasse: die Installationen sind gebaute Werke, oft riesig, jedes Jahr um ein anderes Thema herum gruppiert, zwischen Mythos, Natur, Märchen und Nachthimmel, und die Stadt ist als Route angelegt, die man abgeht, nicht als Platz, an dem man steht.
    </p>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      Die zwanzigste Ausgabe wurde am <strong>14. November 2025</strong> im Villa Comunale an der Via Roma eröffnet und lief bis zum <strong>1. Februar 2026</strong>. Der für die einundzwanzigste veröffentlichte Kalender nennt <strong>14. November 2026 bis 1. Februar 2027</strong>, also genau dieselben Daten. Nehmen Sie das als Arbeitshypothese und prüfen Sie es auf der Website der Gemeinde, bevor Sie ein Datum festlegen, denn der Einschalttermin ist in der Vergangenheit um einige Tage verrutscht.
    </p>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-6">
      <div class="bg-white p-6 rounded-[2rem] border border-slate-100 shadow-sm">
        <h4 class="font-bold text-slate-900 mb-2">Die Route</h4>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Villa Comunale, Domviertel, Piazza della Libertà, Corso Vittorio Emanuele, Via dei Mercanti und Lungomare Trieste, dazu Werke in den Aussenvierteln. Rechnen Sie mit einem ganzen Abend und bequemen Schuhen.</p>
      </div>
      <div class="bg-white p-6 rounded-[2rem] border border-slate-100 shadow-sm">
        <h4 class="font-bold text-slate-900 mb-2">Abends unterwegs</h4>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Die städtische Metrolinie verlängert den Betrieb über die Saison, an gewöhnlichen Tagen bis etwa 23 Uhr und vor Feiertagen bis in die frühen Morgenstunden. Genau das macht Park and Ride am Stadtrand praktikabel.</p>
      </div>
      <div class="bg-white p-6 rounded-[2rem] border border-slate-100 shadow-sm">
        <h4 class="font-bold text-slate-900 mb-2">Der Villa Comunale</h4>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Die Hauptinstallation steht im öffentlichen Park und ist die mit der Schlange. An Dezemberwochenenden kann die Wartezeit deutlich über eine Stunde gehen, gehen Sie also früh am Abend oder an einem Wochentag.</p>
      </div>
      <div class="bg-white p-6 rounded-[2rem] border border-slate-100 shadow-sm">
        <h4 class="font-bold text-slate-900 mb-2">Reisebusse und Wohnmobile</h4>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Salerno veröffentlicht jedes Jahr eine eigene Regelung für Zufahrt und Parken von Reisebussen und Wohnmobilen während der Veranstaltung. Wenn Sie mit einem der beiden anreisen, lesen Sie sie vorher: kontrolliert wird wirklich, und die Bussgelder sind nicht klein.</p>
      </div>
    </div>
  </div>

  <!-- Sorrent -->
  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">Sorrent: M'illumino d'Inverno</h2>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      Die sorrentinische Variante ist kleiner, wärmer und um ein Programm herum gebaut statt um Objekte. M'illumino d'Inverno umfasst etwa zwei Monate und bündelt über hundert Termine: Konzerte mit klassischer Musik, Jazz und neapolitanischem Liedgut, Puppentheater, Krippen in den Kirchen der Altstadt, Handwerkermärkte, Ausstellungen und einen Garten für Kinder.
    </p>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      Die siebzehnte Ausgabe lief vom <strong>30. November 2025 bis 18. Januar 2026</strong>. Baum und Strassenbeleuchtung gingen am Abend des <strong>6. Dezember</strong> auf der Piazza Tasso an, mit der Stadtkapelle Caruso: das ist der Moment, den die Einheimischen als eigentlichen Saisonbeginn betrachten. Die achtzehnte Ausgabe wird in derselben Form erwartet, Eröffnung Ende November, Einschalten in den ersten Dezembertagen, Abschluss Mitte Januar.
    </p>
    <p class="text-slate-600 text-lg leading-relaxed mb-8">
      Alle Schauplätze sind zu Fuss erreichbar: Piazza Tasso, Corso Italia, die Kirchen und Plätze der Altstadt, der Villa Comunale mit Blick über den Golf und das Teatro Tasso. Weil der Ort kompakt und grösstenteils Fussgängerzone ist, ist dies die einfachere der beiden Varianten für kleine Kinder oder für alle, die nicht mehrere Kilometer in der Kälte laufen wollen.
    </p>

    <blockquote class="border-l-4 border-med-gold pl-6 my-8">
      <p class="text-slate-700 text-xl font-serif italic leading-relaxed">
        "Salerno ist etwas, das man sich ansieht. Sorrent ist ein Ort, an dem man den Abend verbringt."
      </p>
    </blockquote>
  </div>

  <!-- Beides -->
  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">Beides auf Einer Reise</h2>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      Im Sommer wäre das eine Bootsfahrt. Im Winter liegen die Küstenfähren still, die beiden Städte sind also über Neapel verbunden, und der Weg ist unkomplizierter, als die Karte vermuten lässt.
    </p>

    <div class="overflow-x-auto rounded-[2rem] border border-slate-100 shadow-sm">
      <table class="w-full text-xs sm:text-sm">
        <thead class="bg-slate-900 text-white">
          <tr>
            <th class="text-left p-5 font-serif font-bold text-med-gold">Etappe</th>
            <th class="text-left p-5 font-serif font-bold text-med-gold">Wie</th>
            <th class="text-left p-5 font-serif font-bold text-med-gold">Dauer</th>
          </tr>
        </thead>
        <tbody class="bg-white">
          <tr class="border-b border-slate-100">
            <td class="p-5 font-bold">Sorrent - Neapel</td>
            <td class="p-5 text-slate-600">Circumvesuviana, oder Campania Express, wo er im Winter fährt</td>
            <td class="p-5 text-slate-600">Rund 1h</td>
          </tr>
          <tr class="border-b border-slate-100">
            <td class="p-5 font-bold">Neapel - Salerno</td>
            <td class="p-5 text-slate-600">Hochgeschwindigkeitszug ab Napoli Centrale oder Regionalzug</td>
            <td class="p-5 text-slate-600">35 Min. bis 1h15</td>
          </tr>
          <tr>
            <td class="p-5 font-bold">Salerno - Küstenorte</td>
            <td class="p-5 text-slate-600">SITA-Bus nach reduziertem Winterfahrplan, keine Fähren</td>
            <td class="p-5 text-slate-600">40 Min. bis Amalfi</td>
          </tr>
        </tbody>
      </table>
    </div>

    <p class="text-slate-600 text-lg leading-relaxed mt-6">
      Praktisch heisst das: eine der beiden als Basis nehmen und die andere als Abendausflug behandeln. Salerno ist die bessere Basis, wenn die Lichter der Zweck der Reise sind, denn von einem zentralen Hotel aus läuft man die ganze Route ab und der Bahnhof liegt mitten in der Stadt. Sorrent ist die bessere Basis für alles andere, weil von dort der Rest der Halbinsel und die Küstenstrasse auch im Winter erreichbar bleiben. Unser Ratgeber zur <a href="/de-de/blog/amalfikueste-mit-dem-zug/" class="text-med-blue hover:underline">Amalfiküste mit dem Zug</a> beschreibt die Anschlüsse im Detail.
    </p>
  </div>

  <!-- Tipps -->
  <div class="bg-white p-8 rounded-[2rem] shadow-xl border border-slate-100">
    <div class="flex items-center gap-4 mb-6">
      <svg class="w-6 h-6 text-med-gold flex-shrink-0" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M9 18h6"/><path d="M10 22h4"/><path d="M15.09 14c.18-.98.65-1.74 1.41-2.5A4.65 4.65 0 0 0 18 8 6 6 0 0 0 6 8c0 1 .23 2.23 1.5 3.5A4.61 4.61 0 0 1 8.91 14"/></svg>
      <h3 class="text-xl font-bold">Expertentipps</h3>
    </div>
    <div class="space-y-6">
      <div>
        <p class="font-bold text-slate-900 mb-1">Gehen Sie unter der Woche und früh am Abend</p>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Die Lichter brennen ab der Dämmerung, im Dezember also etwa ab 17:00 Uhr. Ein Dienstag um sechs und ein Samstag um neun sind zwei verschiedene Städte. Wenn Sie nur ein Wochenende haben, beginnen Sie die Route am entfernten Ende und laufen gegen den Strom zurück ins Zentrum.</p>
      </div>
      <div>
        <p class="font-bold text-slate-900 mb-1">Parken Sie draussen und nehmen Sie die Metro</p>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">An einem Dezemberabend mit dem Auto ins Zentrum von Salerno zu fahren ist eine schlechte Idee. Stellen Sie den Wagen auf einem der Parkplätze am Stadtrand ab, die an der Metrolinie liegen, die in der Saison länger fährt. Dasselbe gilt in Sorrent, wo das Zentrum weitgehend gesperrt ist: prüfen Sie vorher die <a href="/de-de/ratgeber/parken-ztl/" class="text-med-blue hover:underline">Park- und ZTL-Regeln</a>.</p>
      </div>
      <div>
        <p class="font-bold text-slate-900 mb-1">Bestätigen Sie die Termine vor der Flugbuchung</p>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Beide Veranstaltungen werden von ihrer Gemeinde wenige Wochen vorher angekündigt, und der Starttermin kann rutschen. Die hier genannten Daten geben den veröffentlichten Kalender und das Muster der letzten Ausgaben wieder: verlässlich für die Planung einer Woche, nicht für die Wette auf einen bestimmten Abend.</p>
      </div>
      <div>
        <p class="font-bold text-slate-900 mb-1">Nehmen Sie die Krippen mit ins Programm</p>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Der Dezember ist an dieser Küste Krippenzeit, und die Kirchen der Altstadt von Sorrent und der Orte entlang der Küstenstrasse stellen aufwendige Exemplare auf. Zusammen mit einem halb leeren <a href="/de-de/amalfikueste/amalfi/" class="text-med-blue hover:underline">Amalfi</a> und Winterpreisen in den Hotels spricht das stark für eine Reise ausserhalb der Saison.</p>
      </div>
    </div>
  </div>

</BlogPostLayout>
