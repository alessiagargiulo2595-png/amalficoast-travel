---
import BlogPostLayout from '../../../../layouts/BlogPostLayout.astro';

const lang = 'de-de';
const post = {
  title: 'Der Zitronenweg: Der duftende Spaziergang zwischen Maiori und Minori',
  subtitle: 'Pergolen, antike Stufen und Sfusato Amalfitano IGP-Zitronen',
  category: 'ENTDECKUNGEN',
  date: '15. Juli 2026',
  readTime: '9 min',
  image: '/images/sentiero-dei-limoni-hero.webp',
  imageAlt: 'Der Zitronenweg zwischen Maiori und Minori: Pergola mit Sfusato Amalfitano-Zitronen an der Amalfiküste',
  path: '/de-de/blog/zitronenweg/',
};

const metaTitle = 'Zitronenweg Maiori-Minori: Guide, Karte und Tipps 2026';
const metaDescription = 'Leichte Wanderung zwischen Maiori, Minori und Ravello durch Pergolen mit Sfusato Amalfitano IGP-Zitronen. Route, Dauer, Schwierigkeit, beste Zeit und was unterwegs zu sehen ist.';

const breadcrumbs = [
  { name: 'Startseite', url: '/de-de/' },
  { name: 'Blog', url: '/de-de/blog/' },
  { name: 'Der Zitronenweg', url: '/de-de/blog/zitronenweg/' },
];

const quickInfo = [
  { label: 'Bekanntester Abschnitt', value: 'Maiori → Minori' },
  { label: 'Länge', value: 'Etwa 2 km' },
  { label: 'Dauer', value: '45-60 Minuten (einfache Strecke)' },
  { label: 'Schwierigkeit', value: 'T/E (Leicht, Stufen)' },
  { label: 'Höhenunterschied', value: '~150 m' },
  { label: 'Beste Zeit', value: 'April - Juni / September - Oktober' },
  { label: 'Ausrüstung', value: 'Trekkingschuhe, Wasser, Hut' },
  { label: 'Zugang', value: 'Kostenlos, immer geöffnet' },
];

const faq = [
  { q: 'Wie lang ist der Zitronenweg?', a: 'Der bekannteste Abschnitt zwischen Maiori und Minori ist etwa 2 km lang und dauert 45-60 Minuten. Eine Verlängerung führt von Minori nach Ravello über eine antike Treppe und verdoppelt die Strecke (2-3 Stunden insgesamt). Der gesamte Weg verläuft auf antiken Steinstufen unter Zitronenpergolen.' },
  { q: 'Wo beginnt der Zitronenweg?', a: 'Die beiden Hauptstartpunkte sind: (1) von Maiori, die Stufen, die von der Via Capone nahe der Collegiata di Santa Maria a Mare aufsteigen; (2) von Minori, Via Casamare oder die Treppe zu den oberen Ortsteilen. Die Richtung Minori → Maiori ist abwärts und bequemer; Maiori → Minori ist aufwärts und anstrengender.' },
  { q: 'Ist der Weg für Kinder geeignet?', a: 'Ja, er ist einer der sichersten Wege der Amalfiküste. Fast vollständig von Zitronenpergolen überdacht (natürlicher Schatten), der Belag ist Stein in gutem Zustand, ohne ausgesetzte oder schwindelerregende Stellen. Zu beachten ist nur die Anzahl der Stufen: ca. 1500-2000 hin und zurück. Geeignet ab 6-7 Jahren.' },
  { q: 'Was sind Sfusato Amalfitano-Zitronen?', a: 'Der Sfusato Amalfitano IGP ist die Zitronensorte, die seit dem Mittelalter auf den Terrassen der Amalfiküste angebaut wird. Erkennbar an der länglichen "Spindelform", der dicken duftenden Schale, dem süßen Saft mit wenig Säure. Es ist die Sorte für den traditionellen Limoncello, die Delizia al Limone und die Küche der Küste.' },
  { q: 'Wann ist die beste Zeit für den Zitronenweg?', a: 'Frühling (April-Juni) und Herbst (September-Oktober) sind ideal. Im Frühling blühen die Zitronen und die Luft duftet intensiv nach Zagara (Blüte). Im Herbst sind die Früchte reif und an den Ästen sichtbar. Sommer wegen Hitze nicht empfohlen, obwohl die Pergolen Schatten spenden. Winter immer begehbar bei klarem Wetter.' },
  { q: 'Gibt es eine Karte des Zitronenwegs?', a: 'Ein offizielles PDF zum Herunterladen gibt es nicht. Die Route ist vollständig in OpenStreetMap erfasst und erscheint damit in Komoot, AllTrails, Organic Maps und den meisten Wander-Apps: nach Sentiero dei Limoni suchen und das Gebiet Maiori-Minori vor dem Start offline laden, denn zwischen den Terrassen bricht das Signal weg. Vor Ort folgt man Holzschildern mit der Aufschrift Sentiero dei Limoni und aufgemalten Markierungen an den Abzweigungen. Die Eckdaten: rund 2 km, 45-60 Minuten, etwa 150 Höhenmeter.' },
  { q: 'Wie lange dauert der Zitronenweg von Minori nach Maiori?', a: 'Dieselben 2 km, aber 35-50 Minuten statt 45-60, denn von Minori aus geht es nach einem kurzen Anstieg netto bergab nach Maiori. Das ist die Richtung für Familien mit Kindern, bei Hitze oder am späten Nachmittag. In der Richtung Maiori-Minori nimmt man zuerst die Treppen bergauf und endet bergab. In beiden Fällen dauert der Rückweg 5 Minuten mit dem SITA-Bus oder 20 Minuten zu Fuß am Meer entlang.' },
  { q: 'Darf man Zitronen vom Weg pflücken?', a: 'Nein, die Zitronenhaine sind Privatbesitz der lokalen Bauern. Berühren oder Pflücken gilt als Diebstahl. Allerdings gibt es entlang des Weges kleine Bauernläden, wo man Zitronen, handwerklichen Limoncello, Zitronenmarmelade und andere Produkte direkt von den Erzeugern kaufen kann. Preise niedriger als in touristischen Läden in Amalfi.' },
];

const sidebarLinks = [
  { label: 'Maiori', href: '/de-de/amalfikueste/maiori/' },
  { label: 'Minori', href: '/de-de/amalfikueste/minori/' },
  { label: 'Ravello', href: '/de-de/amalfikueste/ravello/' },
  { label: 'Maiori vs Minori', href: '/de-de/blog/maiori-vs-minori/' },
  { label: 'SITA-Bus', href: '/de-de/ratgeber/sita-bus/' },
];

const relatedArticles = [
  {
    title: 'Maiori vs Minori',
    category: 'GUIDES',
    date: '23. Juni 2026',
    image: '/images/maiori-vs-minori-hero.webp',
    imageAlt: 'Maiori und Minori im Vergleich: die zwei Zwillings-Dörfer der Küste',
    path: '/de-de/blog/maiori-vs-minori/'
  },
  {
    title: 'Ferriere-Tal',
    category: 'ENTDECKUNGEN',
    date: '8. April 2026',
    image: '/images/valle-ferriere-hero.webp',
    imageAlt: 'Wasserfall im Ferriere-Tal, Amalfi - Amalfiküste',
    path: '/de-de/blog/ferriere-tal/'
  }
];

const authorRole = 'Wandern und Kulturgeschichte · Amalfiküste';
---

<BlogPostLayout
  lang={lang}
  post={post}
  dateModifiedISO="2026-08-10"
  metaTitle={metaTitle}
  metaDescription={metaDescription}
  breadcrumbs={breadcrumbs}
  quickInfo={quickInfo}
  faq={faq}
  sidebarLinks={sidebarLinks}
  authorRole={authorRole}
  relatedArticles={relatedArticles}
  pageKey="lemon-path"
>

  <!-- Intro -->
  <div>
    <p class="text-slate-600 text-xl leading-relaxed mb-6 font-light">
      Es gibt weltweit wenige Wege, auf denen die Anstrengung mit einem Duft belohnt wird, der jedem anderen Eindruck vorausgeht. Der Zitronenweg, der <a href="/de-de/amalfikueste/maiori/" class="text-med-blue hover:underline">Maiori</a> mit <a href="/de-de/amalfikueste/minori/" class="text-med-blue hover:underline">Minori</a> in etwas mehr als zwei Kilometern verbindet, ist einer davon. Antike Steinstufen unter Pergolen mit Sfusato Amalfitano IGP-Zitronen, überraschende Aussichten auf das Meer und auf die oberen Ortsteile, Halte bei familiengeführten Bauernhöfen.
    </p>
    <p class="text-slate-600 text-lg leading-relaxed">
      Es ist eine leichte Wanderung, auch für Kinder zugänglich, aber mit einer Dichte an Landschaft, Geschichte und Natur, die viele Hochgebirgs-Wanderungen übersteigt. Dies ist der vollständige Guide: Strecke, Karte, beste Zeit, was unterwegs zu sehen ist.
    </p>
  </div>

  <!-- The route -->
  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">Die Strecke: Maiori, Minori und Ravello</h2>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      Der Zitronenweg hat zwei Hauptvarianten. Die bekannteste verbindet Maiori mit Minori über die oberen Ortsteile (ca. 2 km, 45-60 Min.). Die längere führt von Minori nach Ravello über eine historische Treppe (insgesamt 4-5 km, 2-3 Stunden).
    </p>
    <div class="grid sm:grid-cols-2 gap-6">
      <div class="bg-white rounded-[2rem] p-8 border border-slate-100 shadow-sm">
        <p class="text-med-gold font-bold text-xs uppercase tracking-wider mb-2">Klassische Version</p>
        <h3 class="font-semibold text-charcoal mb-2">Maiori → Minori (45-60 Min.)</h3>
        <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">Etwa 2 km, anfangs überwiegend bergauf aus Maiori, dann flach durch die Zitronenhaine, danach bergab zu Minori. Einfachster und ikonischster Abschnitt. Für alle geeignet, einschließlich Kinder.</p>
      </div>
      <div class="bg-white rounded-[2rem] p-8 border border-slate-100 shadow-sm">
        <p class="text-med-gold font-bold text-xs uppercase tracking-wider mb-2">Verlängerung</p>
        <h3 class="font-semibold text-charcoal mb-2">Minori → Ravello (1-1,5 h zusätzlich)</h3>
        <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">Vom oberen Teil Minoris setzt man etwa 1.500 Stufen einer historischen mittelalterlichen Treppe fort. Anstrengender Aufstieg, kompensiert durch die Ankunft am Platz von Ravello mit seinen Gärten.</p>
      </div>
      <div class="bg-white rounded-[2rem] p-8 border border-slate-100 shadow-sm">
        <p class="text-med-gold font-bold text-xs uppercase tracking-wider mb-2">Umgekehrte Richtung</p>
        <h3 class="font-semibold text-charcoal mb-2">Minori → Maiori (bequemer)</h3>
        <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">Umgekehrter Weg: von der Treppe Minoris kurz hoch zum Weg, dann überwiegend bergab nach Maiori. Im Schnitt einfacher und weniger anstrengend. Die Aussichten sind dieselben in umgekehrter Reihenfolge.</p>
      </div>
      <div class="bg-white rounded-[2rem] p-8 border border-slate-100 shadow-sm">
        <p class="text-med-gold font-bold text-xs uppercase tracking-wider mb-2">Kombiniert</p>
        <h3 class="font-semibold text-charcoal mb-2">Von Ravello zum Meer (bergab)</h3>
        <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">Man startet mit dem SITA-Bus bis Ravello, besucht die Gärten der Villa Rufolo und Villa Cimbrone, dann steigt man durch die Zitronenhaine bis Minori ab. Insgesamt ca. 3 Stunden, einer der spektakulärsten der Küste.</p>
      </div>
    </div>
  </div>

  <!-- Karte -->
  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">Karte des Zitronenwegs: So findet man den Weg</h2>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      Eine gedruckte Karte braucht man nicht, aber wer die Orientierungspunkte vorher kennt, spart sich die zwei bis drei Fehlabzweigungen, die fast alle oben an der Treppe von Maiori machen.
    </p>
    <div class="bg-white p-8 rounded-[2rem] border border-slate-100 shadow-sm mb-6">
      <h3 class="font-serif text-xl font-bold text-slate-900 mb-4">Die Orientierungspunkte, von Maiori nach Minori</h3>
      <ul class="space-y-4 text-slate-600">
        <li class="flex items-start gap-3">
          <span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span>
          <span class="text-slate-700"><strong>Start in Maiori.</strong> Von der Strandpromenade die Treppengasse neben der Collegiata di Santa Maria a Mare hinauf. Ab dem ersten Absatz bleibt das Meer den ganzen Weg im Rücken.</span>
        </li>
        <li class="flex items-start gap-3">
          <span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span>
          <span class="text-slate-700"><strong>Der Aufstieg.</strong> Rund 15 Minuten Stufen bis auf Terrassenhöhe. Von dieser Seite die einzige echte Anstrengung der Strecke.</span>
        </li>
        <li class="flex items-start gap-3">
          <span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span>
          <span class="text-slate-700"><strong>Der Abschnitt unter den Pergolen.</strong> Der flache mittlere Kilometer unter den Zitronendächern, mit Ausblicken auf das Tal von Minori. Das ist der Teil, den alle fotografieren.</span>
        </li>
        <li class="flex items-start gap-3">
          <span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span>
          <span class="text-slate-700"><strong>Der Abstieg nach Minori.</strong> Stufen hinunter Richtung Via Casamare, Ankunft wenige Minuten von der römischen Villa Marittima und der Promenade entfernt.</span>
        </li>
        <li class="flex items-start gap-3">
          <span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span>
          <span class="text-slate-700"><strong>Die Beschilderung.</strong> Holzschilder mit der Aufschrift Sentiero dei Limoni und aufgemalte Markierungen an den Abzweigungen. Es gibt wenige Abzweigungen, aber die bei den oberen Ortsteilen sind die kritischen.</span>
        </li>
      </ul>
    </div>
    <p class="text-slate-600 text-lg leading-relaxed">
      Eine offizielle PDF-Karte der beiden Gemeinden gibt es nicht: maßgeblich ist die Beschilderung vor Ort. Die Route ist aber vollständig in OpenStreetMap erfasst und erscheint damit in Komoot, AllTrails, Organic Maps und den meisten Wander-Apps. Laden Sie das Gebiet Maiori-Minori vor dem Start offline herunter, denn zwischen den Terrassen bricht das Signal weg.
    </p>
  </div>

  <!-- Sfusato lemons -->
  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">Der Sfusato Amalfitano: Der König der Zitronen</h2>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      Die Sfusato Amalfitano IGP-Zitrone ist die Sorte, die die Amalfiküste weltberühmt gemacht hat. Seit dem Mittelalter auf den steilen Terrassen zwischen Vietri sul Mare und Positano angebaut, hat sie einzigartige Eigenschaften.
    </p>
    <div class="bg-white p-8 rounded-[2rem] border border-slate-100 shadow-sm my-8">
      <h3 class="font-serif text-xl font-bold text-slate-900 mb-4">Einzigartige Eigenschaften</h3>
      <p class="text-slate-600 leading-relaxed mb-4">
        Längliche "Spindelform" (daher der Name "Sfusato"), dicke rauhe Schale, blassgelbes Fruchtfleisch mit wenigen Kernen, süßer Saft mit geringer Säure. Der Duft der Schale ist zehnmal intensiver als bei Industrie-Zitronen. Sie halten sich wochenlang, ohne Eigenschaften zu verlieren.
      </p>
      <p class="text-slate-600 leading-relaxed">
        IGP-Anerkennung 2001 erworben, schützt heute die Sorte vor Imitationen. Auf den Pergolen des Zitronenwegs wiegen die Früchte oft mehr als 250 Gramm und erreichen 15 Zentimeter Länge.
      </p>
    </div>
    <p class="text-slate-600 text-lg leading-relaxed">
      Entlang des Weges durchquert man Dutzende familiengeführte Bauernhöfe, viele davon verkaufen direkt ans Publikum: frische Zitronen, Zitronenmarmelade, handwerklichen Limoncello, Delizia al Limone. Hier zu kaufen bedeutet, die Bauernterrassen zu unterstützen, die seit tausend Jahren die Küstenlandschaft prägen.
    </p>
  </div>

  <!-- What to see -->
  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">Was unterwegs zu sehen ist</h2>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      Entlang des Zitronenwegs trifft man auch auf antike Kirchen, Panoramablicke und Ecken ländlicher Archäologie.
    </p>
    <div class="space-y-4">
      <div class="bg-white p-6 rounded-[2rem] border border-slate-100 shadow-sm flex gap-5">
        <div class="w-10 h-10 rounded-full bg-med-gold/10 flex-shrink-0 flex items-center justify-center text-med-gold font-bold text-xs sm:text-sm">1</div>
        <div>
          <h4 class="font-bold text-slate-900 mb-1">Kirche San Pietro Apostolo (Torre)</h4>
          <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Kleine Kirche im oberen Ortsteil Maioris, datiert 13. Jahrhundert. Panoramablick auf den Golf von Salerno und die bebauten Terrassen. Nur während der Sonntagsmessen geöffnet.</p>
        </div>
      </div>
      <div class="bg-white p-6 rounded-[2rem] border border-slate-100 shadow-sm flex gap-5">
        <div class="w-10 h-10 rounded-full bg-med-gold/10 flex-shrink-0 flex items-center justify-center text-med-gold font-bold text-xs sm:text-sm">2</div>
        <div>
          <h4 class="font-bold text-slate-900 mb-1">Aussichtspunkt auf beide Dörfer</h4>
          <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Etwa auf der Hälfte des Weges bietet eine Öffnung in den Pergolen eine der meistfotografierten Aussichten der Küste: Maiori rechts mit seinem kilometerlangen Strand, Minori links mit seiner geschützten Bucht, das blaue Meer in der Mitte.</p>
        </div>
      </div>
      <div class="bg-white p-6 rounded-[2rem] border border-slate-100 shadow-sm flex gap-5">
        <div class="w-10 h-10 rounded-full bg-med-gold/10 flex-shrink-0 flex items-center justify-center text-med-gold font-bold text-xs sm:text-sm">3</div>
        <div>
          <h4 class="font-bold text-slate-900 mb-1">Familiengeführte Bauernhöfe</h4>
          <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Drei oder vier Höfe entlang des Weges öffnen ihre Läden für Wanderer. Oft kann man Limoncello und Marmelade vor dem Kauf probieren. Preise im Schnitt halb so hoch wie im Touristenzentrum.</p>
        </div>
      </div>
      <div class="bg-white p-6 rounded-[2rem] border border-slate-100 shadow-sm flex gap-5">
        <div class="w-10 h-10 rounded-full bg-med-gold/10 flex-shrink-0 flex items-center justify-center text-med-gold font-bold text-xs sm:text-sm">4</div>
        <div>
          <h4 class="font-bold text-slate-900 mb-1">Basilika Santa Trofimena (Minori)</h4>
          <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Bei der Ankunft in Minori bewahrt die Basilika aus dem 12. Jahrhundert die Reliquien der Schutzheiligen des Ortes. 15-minütiger Besuch lohnt sich für Krypta und Majolika-Böden.</p>
        </div>
      </div>
    </div>
  </div>

  <!-- Local Tips -->
  <div class="bg-white p-8 rounded-[2rem] shadow-xl border border-slate-100">
    <div class="flex items-center gap-4 mb-6">
      <svg class="w-6 h-6 text-med-gold flex-shrink-0" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M9 18h6"/><path d="M10 22h4"/><path d="M15.09 14c.18-.98.65-1.74 1.41-2.5A4.65 4.65 0 0 0 18 8 6 6 0 0 0 6 8c0 1 .23 2.23 1.5 3.5A4.61 4.61 0 0 1 8.91 14"/></svg>
      <h3 class="text-xl font-bold">5 Tipps für den Zitronenweg</h3>
    </div>
    <div class="space-y-6">
      <div>
        <p class="font-bold text-slate-900 mb-1">1. Im Frühling früh morgens</p>
        <p class="text-slate-600 leading-relaxed text-xs sm:text-sm">Von April bis Juni blühen die Zitronen und die Luft duftet nach Zagara. Früh morgens (bis 9 Uhr) sind die Pergolen kühl und fast leer. Empfohlen: Frühstück in Maiori vor dem Start.</p>
      </div>
      <div>
        <p class="font-bold text-slate-900 mb-1">2. Direkt bei Bauern kaufen</p>
        <p class="text-slate-600 leading-relaxed text-xs sm:text-sm">Kleine Bauernläden entlang des Weges bieten Limoncello, Marmelade und Zitronen zu halbem Preis der Touristenläden. Bedeutet auch, die Bauernterrassen zu unterstützen.</p>
      </div>
      <div>
        <p class="font-bold text-slate-900 mb-1">3. Mit dem Strand von Minori kombinieren</p>
        <p class="text-slate-600 leading-relaxed text-xs sm:text-sm">Nach dem Weg ist der Strand von Minori 5 Minuten zu Fuß von der Basilika entfernt. Baden und Pasta al limone in einem der Restaurants an der Strandpromenade.</p>
      </div>
      <div>
        <p class="font-bold text-slate-900 mb-1">4. SITA-Bus für die Rückkehr</p>
        <p class="text-slate-600 leading-relaxed text-xs sm:text-sm">Von Minori fahren die <a href="/de-de/ratgeber/sita-bus/" class="text-med-blue hover:underline">SITA</a>-Busse in 5 Minuten zurück nach Maiori. Frequenz alle 15-30 Minuten. Den umgekehrten Aufstieg zu Fuß vermeiden.</p>
      </div>
      <div>
        <p class="font-bold text-slate-900 mb-1">5. Verlängerung nach Ravello</p>
        <p class="text-slate-600 leading-relaxed text-xs sm:text-sm">Wer trainiert ist, kann von Minori über die historische Treppe nach Ravello aufsteigen. Insgesamt drei Stunden, aber Villa Rufolo nach den Zitronenhainen zu erreichen, ist ein Erlebnis, das die Reise wert ist.</p>
      </div>
    </div>
  </div>

</BlogPostLayout>
