---
import BlogPostLayout from '../../../../layouts/BlogPostLayout.astro';

const lang = 'de-de';
const post = {
  title: 'Crapolla-Fjord',
  subtitle: 'Der verborgene Schatz der 700 Stufen',
  category: 'ENTDECKUNGEN',
  date: '15. Mai 2026',
  readTime: '12 min',
  image: '/images/fiordo-crapolla-hero.jpg',
  imageAlt: 'Crapolla-Fjord - Massa Lubrense, Sorrentinische Halbinsel',
  path: '/de-de/blog/fiordo-di-crapolla/',
};

const metaTitle = 'Crapolla-Fjord: Der verborgene Schatz der Sorrentinischen Halbinsel 2026';
const metaDescription = 'Vollständiger Reiseführer zum Crapolla-Fjord: 700 Stufen, Kapelle aus dem Mittelalter, römische Ruinen, Archäologiegeschichte und praktische Tipps für diesen geheimen Ort in Massa Lubrense.';

const breadcrumbs = [
  { name: 'Startseite', url: '/de-de/' },
  { name: 'Blog', url: '/de-de/blog/' },
  { name: 'Crapolla-Fjord', url: '/de-de/blog/fiordo-di-crapolla/' },
];

const quickInfo = [
  { label: 'Startpunkt', value: 'Via Casal di Torca (Massa Lubrense)' },
  { label: 'Stufenanzahl', value: '~700 (natürlicher Stein)' },
  { label: 'Höhenunterschied', value: 'Etwa 160 Meter' },
  { label: 'Schwierigkeitsgrad', value: 'Mittel/Hoch (wegen der körperlichen Anstrengung)' },
  { label: 'Wasser', value: 'Keine vor Ort (mindestens 2 Liter mitnehmen)' },
  { label: 'Zeit bergab', value: 'Etwa 45-60 Minuten' },
  { label: 'Was man sehen kann', value: 'Kapelle San Pietro, römische Ruinen, Monazeni' },
  { label: 'Beste Jahreszeit', value: 'April-Juni, September-Oktober' },
];

const faq = [
  {
    q: 'Wie viele Stufen gibt es genau?',
    a: 'Es gibt keine genaue Zahl: Die Anzahl variiert zwischen 680 und 700, je nach Startpunkt und wie die letzten Stufen gezählt werden. Die meisten Besucher berichten von etwa 700 Stufen.',
  },
  {
    q: 'Wie lange dauert der Aufstieg?',
    a: 'Der Aufstieg dauert normalerweise 60-90 Minuten. Dies hängt von Ihrer Fitness ab und davon, zu welcher Tageszeit Sie kommen (in den heißen Monaten verlangsamt die Hitze des Steins Ihren Schritt erheblich).',
  },
  {
    q: 'Ist es obligatorisch, Wasser mitzunehmen?',
    a: 'Absolut ja. Es gibt keine Brunnen oder Erfrischungsstände auf der Route. Bringen Sie mindestens 2 Liter pro Person mit, im Sommer noch mehr.',
  },
  {
    q: 'Gibt es Gefahren auf dem Weg?',
    a: 'Die Route ist technisch nicht schwierig, aber Kalkstein kann rutschig sein, besonders mit unangemessenem Schuhwerk. Verwenden Sie immer Wanderstiefel mit guter Bodenhaftung.',
  },
  {
    q: 'Kann ich schwimmen?',
    a: 'Ja, das Wasser ist kristallklar und der Strand ist wunderbar. Das Gebiet ist Teil des Meeresschutzgebietes Punta Campanella, daher ist das Ökosystem geschützt.',
  },
  {
    q: 'Muss ich reservieren oder um Erlaubnis bitten?',
    a: 'Eine Reservierung ist nicht erforderlich. Es ist ein öffentliches Gebiet, aber denken Sie daran, Ihren Müll mitzunehmen und die Umgebung zu respektieren.',
  },
];

const sidebarLinks = [
  { label: 'Massa Lubrense', href: '/de-de/strande/sorrentinische-halbinsel/' },
  { label: 'Punta Campanella', href: '/de-de/blog/punta-campanella/' },
  { label: 'Beste Reisezeit', href: '/de-de/beste-reisezeit/' },
  { label: 'So kommen Sie hin', href: '/de-de/so-kommen-sie-hin/' },
];

const relatedArticles = [
  {
    title: 'Punta Campanella',
    category: 'ENTDECKUNGEN',
    date: '10. Mai 2026',
    image: '/images/punta-campanella-hero.jpg',
    imageAlt: 'Punta Campanella - Massa Lubrense, Sorrentinische Halbinsel',
    path: '/de-de/blog/punta-campanella/'
  },
  {
    title: 'Ferrera-Tal: Wandern im grünen Herzen von Amalfi',
    category: 'ENTDECKUNGEN',
    date: '22. April 2026',
    image: '/images/valle-ferriere-hero.jpg',
    imageAlt: 'Wasserfall im Ferrera-Tal, Amalfi - Amalfiküste',
    path: '/de-de/blog/ferrera-tal/'
  }
];

const authorRole = 'Archäologie- & Wanderführer · Sorrentinische Halbinsel';

const keyTakeaways = [
  'Der Crapolla-Fjord ist nicht nur ein geheimer Strand, sondern ein Natur- und Archäologiedenkmal mit Wurzeln in der klassischen Antike, das dem Gott Apollo gewidmet ist.',
  'Die ~700 Kalksteinstufen wurden mit antiker Weisheit gebaut, um einen schwindelerregenden Höhenunterschied von etwa 160 Metern zu bewältigen, und sind immer noch das Erkennungszeichen des Ortes.',
  'Die Kapelle San Pietro steht auf den Ruinen eines Tempels, der dem Gott Apollo gewidmet ist; im Mittelalter gab es hier eine wichtige Benediktinerabtei.',
  'Die Monazeni (von den Römern in den Felsen gehauene Hohlräume) zeugen davon, dass der Ort jahrhundertelang als natürliche Zuflucht und Bootsanlage genutzt wurde.',
  'Die beste Besuchszeit ist zwischen 6:00 Uhr und 12:00 Uhr im Sommer, um die sengende Hitze des Kalksteins in den Mittagsstunden zu vermeiden.',
];

const videoSchema = {
  "@context": "https://schema.org",
  "@type": "VideoObject",
  "name": "Crapolla-Fjord: Der verborgene Schatz der 700 Stufen",
  "description": "Video des Crapolla-Fjords - einer der faszinierendsten Orte auf der Sorrentinischen Halbinsel mit 700 Steinstufen, der Kapelle San Pietro und antiker archäologischer Geschichte.",
  "thumbnailUrl": "/images/fiordo-crapolla-hero.jpg",
  "uploadDate": "2026-05-15",
  "duration": "PT1M30S",
  "contentUrl": "/videos/fiordo-crapolla-video.mp4",
  "videoDetails": {
    "width": "1280",
    "height": "720"
  }
};
---

<BlogPostLayout
  lang={lang}
  post={post}
  metaTitle={metaTitle}
  metaDescription={metaDescription}
  breadcrumbs={breadcrumbs}
  quickInfo={quickInfo}
  faq={faq}
  sidebarLinks={sidebarLinks}
  authorRole={authorRole}
  relatedArticles={relatedArticles}
  schema={[videoSchema]}
>

  <!-- Key Takeaways -->
  <div class="bg-slate-900 text-white p-8 rounded-[2rem]">
    <div class="flex items-center gap-3 mb-6">
      <svg class="w-5 h-5 text-med-gold flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
      <h2 class="font-serif text-lg font-bold text-med-gold uppercase tracking-[0.15em]">Wichtige Erkenntnisse</h2>
    </div>
    <ul class="space-y-4">
      {keyTakeaways.map((point) => (
        <li class="flex items-start gap-3">
          <span class="w-1.5 h-1.5 rounded-full bg-med-gold flex-shrink-0 mt-2"></span>
          <span class="text-white/80 text-xs sm:text-sm leading-relaxed">{point}</span>
        </li>
      ))}
    </ul>
  </div>

  <!-- Intro -->
  <div>
    <p class="text-slate-600 text-xl leading-relaxed mb-6 font-light">
      Der Fjord von Crapolla in Massa Lubrense ist ein natürliches und archäologisches Freilichtmuseum. Diese Bucht ist von hohen Felswänden geschützt und nur für diejenigen zugänglich, die bereit sind, sich den Strand mit einer langen Wanderung zu "verdienen".
    </p>
  </div>

  <!-- Video Section -->
  <div class="rounded-[2rem] shadow-xl mb-8 flex justify-center bg-slate-900 py-4">
    <video muted
      controls
      poster="/images/fiordo-crapolla-hero.jpg"
      class="max-w-full max-h-[500px]"
      width="1280"
      height="720"
    >
      <source src="/videos/fiordo-crapolla-video.mp4" type="video/mp4" />
      Ihr Browser unterstützt das Video-Tag nicht. Bitte laden Sie das Video herunter, um es anzusehen.
    </video>
  </div>

  <!-- Der Pfad -->
  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">Der Pfad: Zwischen Macchia und Mythen</h2>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      Die Reise beginnt in Torca. Der Weg führt durch antike Trockenmauern und duftende mediterrane Vegetation. Man hat einen fantastischen Blick auf die Li Galli Inseln und die Insel Isca.
    </p>

    <div class="bg-white p-8 rounded-[2rem] border border-slate-100 shadow-sm my-6">
      <h3 class="font-serif text-xl font-bold text-slate-900 mb-4">Die Herausforderung: 700 Stufen</h3>
      <p class="text-slate-600 leading-relaxed mb-4">
        Das Markenzeichen von Crapolla ist die Treppe mit etwa 700 Steinstufen. Jede Stufe wurde von Hand gesetzt, um den steilen Abgrund der Klippe zu überwinden.
      </p>
      <p class="text-slate-600 leading-relaxed">
        Kleine Keramikkacheln zeigen die Anzahl der Stufen an – eine wichtige psychologische Hilfe beim anstrengenden Aufstieg.
      </p>
    </div>
  </div>

  <!-- Die Kapelle -->
  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">Die Kapelle San Pietro und der Apollo-Tempel</h2>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      Kurz vor dem Strand erreicht man die Kapelle San Pietro. Diese kleine weiße Kirche hat eine faszinierende historische Bedeutung.
    </p>

    <div class="space-y-6 mb-8">
      <div class="bg-white p-6 rounded-[2rem] border border-slate-100 shadow-sm">
        <h4 class="font-bold text-slate-900 mb-2">Antike Wurzeln</h4>
        <p class="text-slate-600 text-sm leading-relaxed">Der Name leitet sich von Acra-Apollo ab. Die Kapelle steht auf den Ruinen eines römischen Apollo-Tempels.</p>
      </div>
      <div class="bg-white p-6 rounded-[2rem] border border-slate-100 shadow-sm">
        <h4 class="font-bold text-slate-900 mb-2">Die Abtei</h4>
        <p class="text-slate-600 text-sm leading-relaxed">Im Mittelalter gab es hier eine wichtige Benediktinerabtei; heute sind noch römische Marmorsäulen in der Kapelle sichtbar.</p>
      </div>
      <div class="bg-white p-6 rounded-[2rem] border border-slate-100 shadow-sm">
        <h4 class="font-bold text-slate-900 mb-2">Die Legende</h4>
        <p class="text-slate-600 text-sm leading-relaxed">Es wird erzählt, dass der Apostel Petrus hier auf seinem Weg nach Rom landete.</p>
      </div>
    </div>

    <blockquote class="border-l-4 border-med-gold pl-6 my-8">
      <p class="text-slate-700 text-xl font-serif italic leading-relaxed">
        "Crapolla ist der Ort, wo klassische Geschichte, mittelalterliche Geschichte und wilde Natur in einem unglaublich kleinen und unberührten Raum aufeinandertreffen."
      </p>
    </blockquote>
  </div>

  <!-- Das Fischerdorf -->
  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">Das Fischerdorf und der Strand</h2>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      Am Fuße finden Sie die Überreste eines alten Fischerdorfes. Hier befinden sich die Monazeni: Von den Römern ausgehöhlte Hohlräume, die jahrhundertelang zum Lagern von Booten genutzt wurden. Der Strand ist ein kleiner Streifen weißer Kiesel mit kristallklarem Wasser.
    </p>

    <div class="overflow-hidden rounded-[2rem] border border-slate-100 shadow-sm">
      <table class="w-full text-xs sm:text-sm">
        <thead class="bg-slate-900 text-white">
          <tr>
            <th class="text-left p-5 font-serif font-bold text-med-gold">Merkmal</th>
            <th class="text-left p-5 font-serif font-bold text-med-gold">Detail</th>
          </tr>
        </thead>
        <tbody class="bg-white">
          <tr class="border-b border-slate-100">
            <td class="p-5 font-bold text-slate-900">Startpunkt</td>
            <td class="p-5 text-slate-600">Via Casal di Torca (Massa Lubrense)</td>
          </tr>
          <tr class="border-b border-slate-100">
            <td class="p-5 font-bold text-slate-900">Stufenanzahl</td>
            <td class="p-5 text-slate-600">ca. 700</td>
          </tr>
          <tr class="border-b border-slate-100">
            <td class="p-5 font-bold text-slate-900">Höhenunterschied</td>
            <td class="p-5 text-slate-600">ca. 160 Meter</td>
          </tr>
          <tr class="border-b border-slate-100">
            <td class="p-5 font-bold text-slate-900">Schwierigkeitsgrad</td>
            <td class="p-5 text-slate-600">Mittel/Hoch (wegen des Rückwegs)</td>
          </tr>
          <tr>
            <td class="p-5 font-bold text-slate-900">Wasser</td>
            <td class="p-5 text-slate-600">Nicht vorhanden (mind. 2 Liter mitnehmen)</td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>

  <!-- Expert Tips -->
  <div class="bg-white p-8 rounded-[2rem] shadow-xl border border-slate-100">
    <div class="flex items-center gap-4 mb-6">
      <svg class="w-6 h-6 text-med-gold flex-shrink-0" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M9 18h6"/><path d="M10 22h4"/><path d="M15.09 14c.18-.98.65-1.74 1.41-2.5A4.65 4.65 0 0 0 18 8 6 6 0 0 0 6 8c0 1 .23 2.23 1.5 3.5A4.61 4.61 0 0 1 8.91 14"/></svg>
      <h3 class="text-xl font-bold text-slate-900">Expertentipps</h3>
    </div>
    <div class="space-y-6">
      <div>
        <p class="font-bold text-slate-900 mb-1">Die beste Zeit</p>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Vermeiden Sie den Aufstieg zwischen 12:00 und 16:00 Uhr im Sommer. Die Treppe ist südorientiert und die Hitze des Steins kann erschöpfend sein.</p>
      </div>
      <div>
        <p class="font-bold text-slate-900 mb-1">Schuhwerk</p>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Begehen Sie nicht den Fehler, in Flip-Flops hinabzugehen. Der Stein ist rutschig und die Stufen sind uneben. Verwenden Sie Wanderstiefel mit guter Bodenhaftung.</p>
      </div>
      <div>
        <p class="font-bold text-slate-900 mb-1">Respekt</p>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Crapolla ist eine archäologische und natürliche Stätte. Nehmen Sie Ihren Müll mit: Es gibt hier keine Reinigungsdienste und die Schönheit des Ortes hängt vom Respekt der Besucher ab.</p>
      </div>
    </div>
  </div>

</BlogPostLayout>
