---
import BlogPostLayout from '../../../../layouts/BlogPostLayout.astro';

const lang = 'de-de';
const post = {
  title: 'Hotels und Restaurants in Positano: Acht Adressen',
  subtitle: 'Villa Rosa, Posa Posa, Villa Franca, Villa Santa Chiara, Buca di Bacco, Don Giovanni, Casa e Bottega und Lucibello, und wo jede davon am Hang liegt',
  category: 'REISEFÜHRER',
  date: '31. August 2026',
  readTime: '11 Min.',
  image: '/images/positano-spiaggia-grande-colombo-hero.webp',
  imageAlt: "Die Spiaggia Grande in Positano von der Via Cristoforo Colombo aus, mit Hotelterrassen über dem Strand",
  path: '/de-de/blog/positano-hotels-restaurants/',
};

const metaTitle = 'Hotels und Restaurants Positano: 8 Adressen | 2026';
const metaDescription = 'Villa Rosa, Posa Posa, Villa Franca, Villa Santa Chiara und Buca di Bacco, dazu Don Giovanni, Casa e Bottega und Lucibello. Genaue Strassen, wie hoch jede Adresse liegt und wie viele Stufen bis zum Strand.';

const breadcrumbs = [
  { name: 'Home', url: '/de-de/' },
  { name: 'Blog', url: '/de-de/blog/' },
  { name: 'Hotels und Restaurants in Positano', url: '/de-de/blog/positano-hotels-restaurants/' },
];

const quickInfo = [
  { label: 'Ort', value: 'Positano, Amalfiküste' },
  { label: 'Form', value: 'Senkrecht: alles liegt über oder unter Ihnen' },
  { label: 'Hauptstrassen', value: 'Viale Pasitea und Via Cristoforo Colombo' },
  { label: 'Ganz unten', value: 'Spiaggia Grande, nur zu Fuss erreichbar' },
  { label: 'Aussenlage', value: 'Laurito, östlich des Ortes' },
  { label: 'Autos', value: 'Keine Zufahrt zum Strandbereich' },
  { label: 'Saison', value: 'Die meisten Adressen von April bis Oktober' },
  { label: 'Buchung', value: 'Hotels Monate, Abendessen Tage im Voraus' },
];

const faq = [
  {
    q: 'Wo liegt das Hotel Villa Rosa in Positano?',
    a: 'In der Via Cristoforo Colombo 127, an der östlichen Zufahrt zum Ort. Es ist eine rund 150 Jahre alte Villa, die in den Fels gebaut wurde, mit privaten Terrassen zum Meer und handbemalten Fliesen, wenige Gehminuten vom Zentrum entfernt.',
  },
  {
    q: 'Welches dieser Hotels liegt am nächsten am Strand?',
    a: 'Buca di Bacco, Via Rampa Teglia 4. Es steht direkt an der Spiaggia Grande, man tritt also ohne eine einzige Treppe auf die Strandpromenade hinaus. Bei allen anderen Adressen auf dieser Liste sind Stufen im Spiel, bei manchen mehrere Hundert.',
  },
  {
    q: 'Was ist Casa e Bottega in Positano?',
    a: 'Ein kleines Bistro mit Designladen in der Viale Pasitea 100, seit 2012 von derselben Familie geführt. Serviert werden nur Frühstück und Mittagessen, mit frischen Säften, Bowls, Eiern und Salaten, Reservierungen nimmt man nicht an. Im selben Raum gibt es eine Abteilung für Keramik und Wohnaccessoires.',
  },
  {
    q: 'Ist Lucibello ein Bootsverleih?',
    a: 'Ja. Lucibello arbeitet von der Spiaggia Grande aus, unter dem grossen weissen Pavillon direkt vor der Treppe, die aus dem Ortszentrum herunterführt. Begonnen hat es, als der Positaner Fischer Salvatore Lucibello in den 1940er Jahren zwei Ruderboote kaufte, und bis heute führen seine Kinder und Enkel den Betrieb.',
  },
  {
    q: 'Welches Hotel liegt in Positano am höchsten?',
    a: 'Von diesen das Hotel Villa Franca in der Viale Pasitea 318, nahe der Stelle, an der die Küstenstrasse in den Ort führt. Sein Dachpool gehört zu den höchstgelegenen in Positano, und genau deshalb bucht man dort, aber es bedeutet auch, dass der Strand sehr weit unten liegt.',
  },
  {
    q: 'Braucht man für diese Adressen ein Auto?',
    a: 'Nein, und meistens ist ein Auto eher eine Last. Positano hat sehr wenige Parkplätze, die Tarife sind in der Saison hoch und der untere Ortsteil ist für den Verkehr gesperrt. Die Anreise mit dem SITA-Bus oder der Fähre ist einfacher. Wer doch fährt, sollte vorher die Parkregeln und die ZTL-Zonen lesen.',
  },
];

const sidebarLinks = [
  { label: 'Positano', href: '/de-de/amalfikueste/positano/' },
  { label: 'Spiaggia Grande', href: '/de-de/strande/amalfikueste/spiaggia-grande-positano/' },
  { label: 'SITA-Bus', href: '/de-de/ratgeber/sita-bus/' },
  { label: 'Fähren', href: '/de-de/ratgeber/faehren/' },
  { label: 'Parken und ZTL', href: '/de-de/ratgeber/parken-ztl/' },
];

const authorRole = 'Lokaler Experte · Amalfiküste';

const relatedArticles = [
  {
    title: 'Positano oder Amalfi: Zwei Ikonen, Eine Wahl',
    category: 'REISEFÜHRER',
    date: '11. Juni 2026',
    image: '/images/positano-vs-amalfi-hero.webp',
    imageAlt: 'Positano und Amalfi im Vergleich',
    path: '/de-de/blog/positano-vs-amalfi/'
  },
  {
    title: 'Sorrent oder Positano: Wo an der Amalfiküste übernachten',
    category: 'REISEFÜHRER',
    date: '15. Juni 2026',
    image: '/images/sorrento-vs-positano-hero.webp',
    imageAlt: 'Sorrent und Positano im Vergleich',
    path: '/de-de/blog/sorrento-vs-positano/'
  }
];

const imageCredit = {
  author: 'Rudolfo Kithera / Wikimedia Commons',
  sourceUrl: 'https://commons.wikimedia.org/wiki/File:Blick_auf_die_Spiaggia_Grande_(Positano)_von_der_Via_Cristoforo_Colombo.jpg',
  license: 'CC0',
  licenseUrl: 'https://creativecommons.org/publicdomain/zero/1.0/',
};

const keyTakeaways = [
  'In Positano sagt der Strassenname mehr aus als die Sternezahl, denn der Ort ist senkrecht und jede Adresse liegt auf einer anderen Höhe über dem Strand.',
  'Buca di Bacco ist die einzige dieser Adressen, die wirklich an der Spiaggia Grande liegt, und damit die richtige für alle, die keine Treppen wollen.',
  'Die Viale Pasitea ist die obere Schleife: Casa e Bottega bei Nummer 100, Posa Posa bei 165 und Villa Franca bei 318 liegen immer weiter vom Meer entfernt.',
  'Die Via Cristoforo Colombo ist die östliche Zufahrt: Villa Rosa bei 127 und das Ristorante Don Giovanni bei 141 sind fast Nachbarn.',
  'Villa Santa Chiara liegt in Laurito, ausserhalb des eigentlichen Ortes: Ruhe gegen den Spaziergang ins Zentrum eingetauscht.',
];
---

<BlogPostLayout
  lang={lang}
  post={post}
  metaTitle={metaTitle}
  metaDescription={metaDescription}
  breadcrumbs={breadcrumbs}
  quickInfo={quickInfo}
  faq={faq}
  sidebarLinks={sidebarLinks}
  authorRole={authorRole}
  relatedArticles={relatedArticles}
  imageCredit={imageCredit}
  pageKey="positano-hotels-restaurants"
>

  <!-- Key Takeaways -->
  <div class="bg-slate-900 text-white p-8 rounded-[2rem]">
    <div class="flex items-center gap-3 mb-6">
      <svg class="w-5 h-5 text-med-gold flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
      <h2 class="font-serif text-lg font-bold text-med-gold uppercase tracking-[0.15em]">Key Takeaways</h2>
    </div>
    <ul class="space-y-4">
      {keyTakeaways.map((point) => (
        <li class="flex items-start gap-3">
          <span class="w-1.5 h-1.5 rounded-full bg-med-gold flex-shrink-0 mt-2"></span>
          <span class="text-white/80 text-xs sm:text-sm leading-relaxed">{point}</span>
        </li>
      ))}
    </ul>
  </div>

  <!-- Intro -->
  <div>
    <p class="text-slate-600 text-xl leading-relaxed mb-6 font-light">
      Ein Zimmer in <a href="/de-de/amalfikueste/positano/" class="text-med-blue hover:underline">Positano</a> zu buchen ist anders als überall sonst, denn hier gibt es keinen ebenen Boden. Der Ort ist eine Schale aus Häusern, die an einer Felswand übereinanderstehen, und die nützlichste Information zu jedem Hotel, Restaurant oder Café ist nicht die Bewertung, sondern die Hausnummer. Sie sagt, wie hoch über dem Meer Sie wohnen, wie viele Stufen zwischen Ihnen und dem Abendessen liegen und ob ein Taxi überhaupt in die Nähe Ihres Gepäcks kommt. Diese acht Adressen tauchen in Suchanfragen immer wieder auf, und sie verteilen sich über alle Ebenen des Hangs.
    </p>
  </div>

  <!-- Geografie -->
  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">Zuerst: Wie Positano Aufgebaut Ist</h2>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      Eine Adresse in Positano kann nur an drei oder vier Stellen liegen, und zu wissen, um welche es sich handelt, beantwortet die meisten praktischen Fragen im Voraus.
    </p>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div class="bg-white p-6 rounded-[2rem] border border-slate-100 shadow-sm">
        <h4 class="font-bold text-slate-900 mb-2">Viale Pasitea</h4>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Die obere Schleife, über die die Strasse durch den Ort führt. Die Nummern steigen nach Westen und nach oben: eine niedrige Nummer liegt nah am Zentrum, eine hohe oben, wo der SITA-Bus aus Sorrent ankommt.</p>
      </div>
      <div class="bg-white p-6 rounded-[2rem] border border-slate-100 shadow-sm">
        <h4 class="font-bold text-slate-900 mb-2">Via Cristoforo Colombo</h4>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Die östliche Zufahrt von der Amalfi-Seite. Sie verläuft am Hang mit freiem Blick aufs Meer und liegt in einer machbaren Höhe über dem Strand, deshalb drängen sich hier mehrere kleine Hotels und Restaurants.</p>
      </div>
      <div class="bg-white p-6 rounded-[2rem] border border-slate-100 shadow-sm">
        <h4 class="font-bold text-slate-900 mb-2">Spiaggia Grande</h4>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Der Grund der Schale, zu Fuss über die Treppengassen oder mit der Fähre erreichbar. Keine Autos. Von hier fahren die Boote ab, und hier liegen die einzigen wirklich stufenfreien Adressen Positanos.</p>
      </div>
      <div class="bg-white p-6 rounded-[2rem] border border-slate-100 shadow-sm">
        <h4 class="font-bold text-slate-900 mb-2">Laurito und die Aussenlagen</h4>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Östlich des Ortes an der Strasse Richtung Praiano. Ruhiger, mit eigener kleiner Bucht darunter, aber für einen Kaffee spaziert man nicht eben ins Zentrum. Es braucht Shuttle, Boot oder Bus.</p>
      </div>
    </div>
  </div>

  <!-- Die acht -->
  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">Die Acht Adressen im Überblick</h2>
    <div class="overflow-x-auto rounded-[2rem] border border-slate-100 shadow-sm">
      <table class="w-full text-xs sm:text-sm">
        <thead class="bg-slate-900 text-white">
          <tr>
            <th class="text-left p-5 font-serif font-bold text-med-gold">Name</th>
            <th class="text-left p-5 font-serif font-bold text-med-gold">Was es ist</th>
            <th class="text-left p-5 font-serif font-bold text-med-gold">Wo</th>
          </tr>
        </thead>
        <tbody class="bg-white">
          <tr class="border-b border-slate-100">
            <td class="p-5 font-bold">Buca di Bacco</td>
            <td class="p-5 text-slate-600">Vier-Sterne-Hotel und Restaurant, eröffnet 1916</td>
            <td class="p-5 text-slate-600">Via Rampa Teglia 4, an der Spiaggia Grande</td>
          </tr>
          <tr class="border-b border-slate-100">
            <td class="p-5 font-bold">Lucibello</td>
            <td class="p-5 text-slate-600">Bootsverleih und private Touren, Familienbetrieb seit den 1940ern</td>
            <td class="p-5 text-slate-600">Spiaggia Grande, unter dem weissen Pavillon</td>
          </tr>
          <tr class="border-b border-slate-100">
            <td class="p-5 font-bold">Casa e Bottega</td>
            <td class="p-5 text-slate-600">Bistro für Frühstück und Mittagessen mit Design- und Keramikladen</td>
            <td class="p-5 text-slate-600">Viale Pasitea 100</td>
          </tr>
          <tr class="border-b border-slate-100">
            <td class="p-5 font-bold">Villa Rosa</td>
            <td class="p-5 text-slate-600">Kleines Hotel in einer Felsvilla aus dem 19. Jahrhundert, lauter Terrassen</td>
            <td class="p-5 text-slate-600">Via Cristoforo Colombo 127</td>
          </tr>
          <tr class="border-b border-slate-100">
            <td class="p-5 font-bold">Don Giovanni</td>
            <td class="p-5 text-slate-600">Familiengeführtes Fischrestaurant mit Meerblickterrasse</td>
            <td class="p-5 text-slate-600">Via Cristoforo Colombo 141</td>
          </tr>
          <tr class="border-b border-slate-100">
            <td class="p-5 font-bold">Posa Posa</td>
            <td class="p-5 text-slate-600">Vier-Sterne-Hotel aus den 1950ern, Tauchbecken auf dem Dach</td>
            <td class="p-5 text-slate-600">Viale Pasitea 165</td>
          </tr>
          <tr class="border-b border-slate-100">
            <td class="p-5 font-bold">Villa Franca</td>
            <td class="p-5 text-slate-600">Fünf-Sterne-Hotel im oberen Ortsteil, Pool Club auf dem Dach</td>
            <td class="p-5 text-slate-600">Viale Pasitea 318</td>
          </tr>
          <tr>
            <td class="p-5 font-bold">Villa Santa Chiara</td>
            <td class="p-5 text-slate-600">Vier-Sterne-Suiten mit Garten und Terrasse, ausserhalb des Zentrums</td>
            <td class="p-5 text-slate-600">Via Laurito 68</td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>

  <!-- Wo schlafen -->
  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">Wo Übernachten, vom Strand Aufwärts</h2>

    <h3 class="font-serif text-xl font-bold text-slate-900 mb-3">Buca di Bacco, direkt am Strand</h3>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      Das Buca di Bacco öffnete 1916 und gehört zu den Häusern, die den Tourismus an dieser Küste erfunden haben. Die Geschichte dahinter ist gut: Salvatore Rispoli und Carolina Pollio waren nach New York ausgewandert und führten dort ein Lebensmittelgeschäft mit einer Kundschaft aus Film und Theater; zurück in der Heimat machten sie aus dieser Welt ein Hotel. Jahrzehntelang war es der Rückzugsort ausländischer Schriftsteller und Maler, die Positano für den richtigen Ort hielten, um mit Stil arm zu sein. Der Speisesaal mündet in eine Veranda über der <a href="/de-de/strande/amalfikueste/spiaggia-grande-positano/" class="text-med-blue hover:underline">Spiaggia Grande</a>, mit der ganzen Häuserpyramide im Rücken.
    </p>

    <h3 class="font-serif text-xl font-bold text-slate-900 mb-3">Villa Rosa, am Osthang</h3>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      Villa Rosa ist eine rund 150 Jahre alte Villa, direkt in den Fels der Via Cristoforo Colombo gebaut und zu einem kleinen Hotel umgewandelt, in dem fast jedes Zimmer eine eigene Terrasse über dem Wasser hat. Die Architektur ist die der Gegend und nicht die eines Hotels: Gewölbe, Bögen, Loggien, originale handbemalte Fliesen in den Bädern. Ins Zentrum geht man kurz hinunter und deutlich länger wieder hinauf.
    </p>

    <h3 class="font-serif text-xl font-bold text-slate-900 mb-3">Posa Posa, auf halber Höhe</h3>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      In den 1950er Jahren gebaut und bis heute an der originalen Ausstattung erkennbar, einschliesslich der handbemalten Fliesen, die das Alter verraten, liegt das Posa Posa in der Viale Pasitea 165: hoch genug, um aus dem Strassenlärm heraus zu sein, tief genug, dass der Abstieg keine Expedition wird. Die Terrasse im siebten Stock hat ein Tauchbecken und ein Solarium, und das Hoteleigene Restaurant Mirage deckt auf einer Panoramaterrasse über der Bucht ein.
    </p>

    <h3 class="font-serif text-xl font-bold text-slate-900 mb-3">Villa Franca, ganz oben</h3>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      In der Viale Pasitea 318 ist man nahe an der Stelle, an der die Küstenstrasse in den Ort führt, und das bedeutet den weitesten Blick, den ein Hotel in Positano bieten kann. Der Dachpool, der Gold Sky Pool Club, zählt zu den höchstgelegenen im Ort. Das Hotelrestaurant Li Galli ist ein Gourmetraum mit sieben Tischen, dessen Glasdach und Glaswände sich im Sommer öffnen, mit Blick auf die Inselchen Li Galli, die ihm den Namen geben. So weit oben zu wohnen ist der ganze Sinn der Sache, und es heisst auch, dass Sie für den Strand öfter Bus oder Auto nehmen werden, als Sie denken.
    </p>

    <h3 class="font-serif text-xl font-bold text-slate-900 mb-3">Villa Santa Chiara, draussen in Laurito</h3>
    <p class="text-slate-600 text-lg leading-relaxed mb-8">
      Via Laurito 68 ist nicht mehr das Positano der Postkarten. Der Weiler Laurito liegt östlich des Ortes über seiner eigenen Bucht, und die Suiten hier kommen mit Garten, Terrasse und der Art von Stille, die das Zentrum im August nicht bieten kann. Der Preis dafür ist die Erreichbarkeit: in den Ort kommt man mit dem SITA-Bus, dem Taxi oder dem kleinen Bootsdienst, der in der Saison vom Strand aus verkehrt.
    </p>

    <div class="bg-white p-8 rounded-[2rem] border border-slate-100 shadow-sm">
      <h3 class="font-serif text-xl font-bold text-slate-900 mb-5">Auswählen nach gewünschtem Kletterpensum</h3>
      <div class="space-y-3">
        <div class="flex items-start gap-3">
          <div class="w-6 h-6 rounded-full bg-med-gold/15 flex-shrink-0 flex items-center justify-center text-med-gold font-bold text-xs">1</div>
          <p class="text-slate-600 text-xs sm:text-sm leading-relaxed"><strong>Gar keine Stufen:</strong> Buca di Bacco. Sie sind an der Strandpromenade, neben dem Fähranleger und den Bootsanbietern.</p>
        </div>
        <div class="flex items-start gap-3">
          <div class="w-6 h-6 rounded-full bg-med-gold/15 flex-shrink-0 flex items-center justify-center text-med-gold font-bold text-xs">2</div>
          <p class="text-slate-600 text-xs sm:text-sm leading-relaxed"><strong>Zehn bis fünfzehn Minuten hinunter, zwanzig hinauf:</strong> Villa Rosa und Posa Posa. Das ist das normale Positano-Erlebnis, und für die meisten völlig in Ordnung.</p>
        </div>
        <div class="flex items-start gap-3">
          <div class="w-6 h-6 rounded-full bg-med-gold/15 flex-shrink-0 flex items-center justify-center text-med-gold font-bold text-xs">3</div>
          <p class="text-slate-600 text-xs sm:text-sm leading-relaxed"><strong>Sie werden ein Verkehrsmittel brauchen:</strong> Villa Franca und Villa Santa Chiara. Beide lohnen sich aus anderen Gründen, aber planen Sie kein Bad vor dem Frühstück ein.</p>
        </div>
      </div>
    </div>
  </div>

  <!-- Wo essen -->
  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">Wo Essen und Wo der Tag Beginnt</h2>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      Zwei der meistgesuchten Namen in Positano sind gar keine Hotels, und sie stehen an den beiden Enden des Tages.
    </p>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      Das <strong>Ristorante Don Giovanni</strong> in der Via Cristoforo Colombo 141 ist eine familiengeführte Küche mit Terrasse über dem Meer, von April bis Oktober täglich geöffnet. Sein Ruf gründet auf Fisch, und die Gerichte, die in Bewertungen am häufigsten auftauchen, sind der Oktopus als Vorspeise oder mit Linguine, dazu die Meeresfrüchtepasta und der ganze Fisch. Diese Reservierung macht man besser vor der Anreise als am selben Tag.
    </p>
    <p class="text-slate-600 text-lg leading-relaxed mb-8">
      <strong>Casa e Bottega</strong> in der Viale Pasitea 100 ist die andere Hälfte der Gleichung. Seit 2012 von derselben Familie geführt, ist es ein kleiner weiss-grüner Raum, der morgens als Bistro und gleichzeitig als Laden für Keramik und Wohnaccessoires funktioniert. Die Karte reicht von kaltgepressten Säften über Bowls, Eier und Avocado-Toast bis zu Salaten, mit vegetarischen, veganen und glutenfreien Optionen, und serviert wird nur Frühstück und Mittagessen. Reserviert wird nicht: entweder früh kommen oder warten.
    </p>

    <blockquote class="border-l-4 border-med-gold pl-6 my-8">
      <p class="text-slate-700 text-xl font-serif italic leading-relaxed">
        "In Positano fragt niemand, wie viele Sterne ein Hotel hat. Man fragt, wie hoch es liegt."
      </p>
    </blockquote>
  </div>

  <!-- Lucibello -->
  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">Lucibello: Vom Strand aufs Wasser</h2>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      Von allen acht Namen ist Lucibello der einzige, der kein Gebäude ist. Es ist ein Bootsbetrieb an der Spiaggia Grande, zu finden unter dem grossen weissen Pavillon genau vor der Treppe, die aus dem Ortszentrum herunterkommt.
    </p>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      Angefangen hat es mit Salvatore Lucibello, einem Fischer aus Positano, der in den 1940er Jahren zwei Ruderboote kaufte, zu einer Zeit, als die ersten Postdampfer anliefen und absehbar wurde, dass aus dem Dorf etwas anderes werden würde. Er baute grössere Boote für die neue Nachfrage, seine Kinder stiegen ein, und drei Generationen später führt immer noch die Familie den Betrieb. Heute heisst das Verleih mit oder ohne Skipper und private Fahrten entlang der Küste und hinüber nach <a href="/de-de/inseln/capri/" class="text-med-blue hover:underline">Capri</a>.
    </p>
    <p class="text-slate-600 text-lg leading-relaxed">
      Das praktische Argument für ein Boot in Positano ist einfach: die besten Strände in der Nähe, von Arienzo über Laurito bis Fornillo, sind vom Wasser aus leichter zu erreichen als von der Strasse. Und wer oben in der Villa Franca oder draussen in Laurito wohnt, löst mit einem Vormittag auf dem Boot gleich auch das Treppenproblem.
    </p>
  </div>

  <!-- Tipps -->
  <div class="bg-white p-8 rounded-[2rem] shadow-xl border border-slate-100">
    <div class="flex items-center gap-4 mb-6">
      <svg class="w-6 h-6 text-med-gold flex-shrink-0" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M9 18h6"/><path d="M10 22h4"/><path d="M15.09 14c.18-.98.65-1.74 1.41-2.5A4.65 4.65 0 0 0 18 8 6 6 0 0 0 6 8c0 1 .23 2.23 1.5 3.5A4.61 4.61 0 0 1 8.91 14"/></svg>
      <h3 class="text-xl font-bold">Expertentipps</h3>
    </div>
    <div class="space-y-6">
      <div>
        <p class="font-bold text-slate-900 mb-1">Fragen Sie vor der Buchung nach dem Gepäck</p>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Die meisten Hotels an den oberen Strassen organisieren einen Träger für das letzte Stück, weil ein Taxi physisch nicht hinkommt. Das ist ein üblicher und meist kostenpflichtiger Service. Lassen Sie sich bestätigen, dass es ihn für Ihre Adresse gibt, statt die Treppe mit zwei Koffern zu entdecken.</p>
      </div>
      <div>
        <p class="font-bold text-slate-900 mb-1">Kommen Sie über das Meer, wenn der Fahrplan es hergibt</p>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Die <a href="/de-de/ratgeber/faehren/" class="text-med-blue hover:underline">Fähre</a> setzt Sie an der Spiaggia Grande ab, ganz unten im Ort, dem einzigen Ankunftspunkt, von dem aus alles schlicht bergauf geht. Ausserhalb der Saison fahren die Boote nicht und es bleibt der <a href="/de-de/ratgeber/sita-bus/" class="text-med-blue hover:underline">SITA-Bus</a>.</p>
      </div>
      <div>
        <p class="font-bold text-slate-900 mb-1">Lassen Sie das Auto zu Hause</p>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Parkplätze sind in Positano knapp, teuer und weit vom Strand entfernt, und der untere Ortsteil ist gesperrt. Wenn es nicht anders geht, lesen Sie vorher die <a href="/de-de/ratgeber/parken-ztl/" class="text-med-blue hover:underline">Park- und ZTL-Regeln</a> und fragen Sie Ihr Hotel, mit welcher Garage es zusammenarbeitet.</p>
      </div>
      <div>
        <p class="font-bold text-slate-900 mb-1">Frühstück auf gut Glück, Abendessen reserviert</p>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Die beiden Mahlzeiten funktionieren verschieden. Frühstücks- und Mittagsadressen wie Casa e Bottega arbeiten nach dem Prinzip kommen und warten, während jede Terrasse mit Aussicht, Don Giovanni eingeschlossen, in der Hochsaison eine Reservierung will. Buchen Sie am ersten Morgen die Abendessen für den ganzen Aufenthalt.</p>
