---
import BlogPostLayout from '../../../../layouts/BlogPostLayout.astro';

const lang = 'de-de';
const post = {
  title: "Der Ciuccio di Fuoco: Silvester in Sorrent und Sant'Agata",
  subtitle: "Der Feueresel, der am Nachmittag des 31. Dezember das alte Jahr verabschiedet, auf der Piazza Tasso und auf dem Dorfplatz von Sant'Agata sui Due Golfi: was er ist, wann er brennt und wie er in den Rest des Abends passt",
  category: 'ENTDECKUNGEN',
  date: '28. November 2026',
  readTime: '8 Min.',
  image: '/images/ciuccio-di-fuoco-hero.webp',
  imageAlt: "Eine Flamme vor schwarzem Hintergrund",
  path: '/de-de/blog/ciuccio-di-fuoco-sorrent-santagata/',
};

const metaTitle = "Ciuccio di Fuoco: Silvester in Sorrent und Sant'Agata";
const metaDescription = "Der Feueresel vom 31. Dezember auf der Piazza Tasso in Sorrent und in Sant'Agata sui Due Golfi: Bedeutung, letzte Uhrzeiten, Anreise und der Rest des Abends.";

const breadcrumbs = [
  { name: 'Home', url: '/de-de/' },
  { name: 'Blog', url: '/de-de/blog/' },
  { name: 'Der Ciuccio di Fuoco', url: '/de-de/blog/ciuccio-di-fuoco-sorrent-santagata/' },
];

const quickInfo = [
  { label: 'Datum', value: '31. Dezember, später Nachmittag' },
  { label: 'Sorrent', value: 'Piazza Tasso, zuletzt um 18:00 Uhr' },
  { label: 'Davor', value: 'Folkloreumzug ab 17:00 Uhr, Corso Italia' },
  { label: "Sant'Agata", value: 'Dorfplatz, nach dem Lied um 16:00/16:30 Uhr' },
  { label: "Veranstalter Sant'Agata", value: 'Pro Loco Due Golfi' },
  { label: 'Kosten', value: 'Kostenlos, offene Plätze' },
  { label: 'Dauer', value: 'Wenige Minuten Feuerwerk' },
  { label: 'Programm 2026', value: 'Erscheint meist Ende Dezember' },
];

const faq = [
  {
    q: 'Was ist der Ciuccio di Fuoco?',
    a: 'Eine Eselsfigur aus Pappmaché, gefüllt mit Feuerwerkskörpern, die am Nachmittag des 31. Dezember auf dem Hauptplatz angezündet wird. Einige Minuten lang zünden die Ladungen nacheinander, und die Figur brennt ab. Sie steht für das Jahr, das zu Ende geht: Der Esel wird verabschiedet, damit das neue Jahr unbelastet beginnen kann.',
  },
  {
    q: 'Um wie viel Uhr ist der Ciuccio di Fuoco in Sorrent?',
    a: 'Bei den letzten Ausgaben um 18:00 Uhr auf der Piazza Tasso, nach einem Folkloreumzug, der gegen 17:00 Uhr zwischen Corso Italia und Altstadt beginnt. Die Gemeinde Sorrent veröffentlicht das Silvesterprogramm in den letzten Dezembertagen; prüfen Sie die Uhrzeit dann.',
  },
  {
    q: "Gibt es auch in Sant'Agata sui Due Golfi einen Ciuccio di Fuoco?",
    a: "Ja. Sant'Agata, der hoch gelegene Ortsteil von Massa Lubrense, zündet seinen eigenen auf dem Dorfplatz an, am Ende der Canzone de lo Capo d'Anno, dem traditionellen Neujahrslied, das am Nachmittag durch die Straßen getragen wird. Organisiert hat ihn in früheren Jahren die Pro Loco Due Golfi, 2024 war das Anzünden für 16:30 Uhr angekündigt. Er findet früher statt als der in Sorrent.",
  },
  {
    q: 'Ist das für Kinder geeignet?',
    a: 'Es richtet sich vor allem an sie, und einheimische Familien bringen jedes Jahr auch kleine Kinder mit. Es ist laut und es fliegen Funken: Halten Sie einige Meter Abstand zur Figur, bleiben Sie mit kleinen Kindern am Rand der Menge und denken Sie an Gehörschutz für Babys.',
  },
  {
    q: 'Kann man beide am selben Nachmittag sehen?',
    a: "Theoretisch ja, denn Sant'Agata ist meist zuerst dran und die beiden Orte liegen etwa 8 km auseinander. In der Praxis hängt es von den genauen Zeiten des Jahres und vom Verkehr ab, und am Abend des 31. ist das Zentrum von Sorrent für Autos gesperrt. Entscheiden Sie sich für einen, außer beide Zeiten sind bestätigt und liegen klar auseinander.",
  },
  {
    q: 'Was passiert in Sorrent nach dem Ciuccio?',
    a: 'Die Piazza Tasso bleibt das Zentrum der Nacht. 2024 und 2025 gab es von 23:00 bis 3:00 Uhr Livemusik und DJ-Set, den Countdown auf dem Platz und um 1:00 Uhr ein Feuerwerk von der Marina Piccola. Der Tag selbst beginnt am späten Vormittag mit dem Jahresabschlusskonzert im Teatro Tasso.',
  },
];

const sidebarLinks = [
  { label: 'Sorrent', href: '/de-de/sorrentinische-halbinsel/sorrent/' },
  { label: 'Massa Lubrense', href: '/de-de/sorrentinische-halbinsel/massa-lubrense/' },
  { label: 'Silvester in Sorrent', href: '/de-de/veranstaltungen/sorrentinische-halbinsel/capodanno-sorrento/' },
  { label: 'SITA-Bus', href: '/de-de/ratgeber/sita-bus/' },
  { label: 'Silvester in Positano', href: '/de-de/blog/silvester-positano-feuerwerk/' },
];

const authorRole = 'Lokaler Experte · Amalfiküste';

const relatedArticles = [
  {
    title: 'Silvester in Positano: Das Feuerwerk',
    category: 'REISEFÜHRER',
    date: '24. November 2026',
    image: '/images/spiaggia-grande-positano-hero.webp',
    imageAlt: 'Die Spiaggia Grande in Positano',
    path: '/de-de/blog/silvester-positano-feuerwerk/'
  },
  {
    title: 'Weihnachtsbeleuchtung in Sorrent und Salerno',
    category: 'REISEFÜHRER',
    date: '21. Oktober 2026',
    image: '/images/luci-artista-salerno-hero.webp',
    imageAlt: 'Weihnachtsbeleuchtung in Salerno',
    path: '/de-de/blog/weihnachtsbeleuchtung-sorrent-salerno/'
  }
];


const keyTakeaways = [
  'Der Ciuccio di Fuoco ist ein Esel aus Pappmaché voller Feuerwerkskörper, der am 31. Dezember auf dem Platz verbrannt wird, um das alte Jahr zu verabschieden. In Sorrent gehört er seit den 1960er Jahren zu Silvester.',
  'Er brennt am späten Nachmittag, nicht um Mitternacht. In Sorrent fanden die letzten Ausgaben um 18:00 Uhr auf der Piazza Tasso statt, nach einem Folkloreumzug ab 17:00 Uhr.',
  "Sant'Agata sui Due Golfi, in den Hügeln von Massa Lubrense, hat seinen eigenen, der am Ende der Canzone de lo Capo d'Anno auf dem Dorfplatz angezündet wird, früher als der in Sorrent.",
  'Beide sind kostenlos und kurz: wenige Minuten Feuerwerk. Kommen Sie früh, um gut zu sehen, und halten Sie Kinder von den Funken fern.',
  'Die Programme für 2026 sind noch nicht erschienen. Sorrent veröffentlicht seines meist in den letzten Dezembertagen, Massa Lubrense den Weihnachtskalender im Dezember.',
];
---

<BlogPostLayout
  lang={lang}
  post={post}
  metaTitle={metaTitle}
  metaDescription={metaDescription}
  breadcrumbs={breadcrumbs}
  quickInfo={quickInfo}
  faq={faq}
  sidebarLinks={sidebarLinks}
  authorRole={authorRole}
  relatedArticles={relatedArticles}
  pageKey="ciuccio-di-fuoco"
>

  <!-- Key Takeaways -->
  <div class="bg-slate-900 text-white p-8 rounded-[2rem]">
    <div class="flex items-center gap-3 mb-6">
      <svg class="w-5 h-5 text-med-gold flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
      <h2 class="font-serif text-lg font-bold text-med-gold uppercase tracking-[0.15em]">Key Takeaways</h2>
    </div>
    <ul class="space-y-4">
      {keyTakeaways.map((point) => (
        <li class="flex items-start gap-3">
          <span class="w-1.5 h-1.5 rounded-full bg-med-gold flex-shrink-0 mt-2"></span>
          <span class="text-white/80 text-xs sm:text-sm leading-relaxed">{point}</span>
        </li>
      ))}
    </ul>
  </div>

  <!-- Intro -->
  <div>
    <p class="text-slate-600 text-xl leading-relaxed mb-6 font-light">
      Auf der Sorrentinischen Halbinsel wartet das alte Jahr nicht bis Mitternacht, um zu gehen. Am späten Nachmittag des 31. Dezember, wenn man noch beim Kaffee sitzt oder die letzten Einkäufe erledigt, wird auf dem Hauptplatz ein Esel aus Pappmaché und Feuerwerk angezündet, und ein paar Minuten lang ist der Platz voller Knallen, Funken und Rauch. Das passiert in <a href="/de-de/sorrentinische-halbinsel/sorrent/" class="text-med-blue hover:underline">Sorrent</a> auf der Piazza Tasso und etwas früher oben in Sant'Agata sui Due Golfi, in der Gemeinde <a href="/de-de/sorrentinische-halbinsel/massa-lubrense/" class="text-med-blue hover:underline">Massa Lubrense</a>. Er heißt <em>ciuccio di fuoco</em>, der Feueresel, und für viele einheimische Familien beginnt Silvester erst mit ihm.
    </p>
  </div>

  <!-- What it is -->
  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">Was der Ciuccio di Fuoco ist</h2>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      <em>Ciuccio</em> ist das neapolitanische Wort für Esel. Die Figur wird aus Pappmaché gebaut, mit Feuerwerk gefüllt und umwickelt und in der Mitte des Platzes aufgestellt. Sobald die Lunte brennt, zünden die Ladungen nacheinander, mit Funkenfontänen, Pfeifen und Knallen, und der Esel brennt ab. Das Ganze dauert wenige Minuten. In Sorrent hat 2024 der Bürgermeister die Lunte angezündet, vor einem Platz voller Einwohner und Besucher.
    </p>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      Woher der Brauch genau stammt, kann niemand sagen. Örtliche Überlieferungen verbinden ihn mit dem bäuerlichen Leben auf der Halbinsel, als man am letzten Tag des Jahres Strohhaufen verbrannte, um Unglück, böse Geister und Hunger fernzuhalten. Der Esel, das Lasttier der Höfe und Terrassen, wurde zum Jahr selbst: Man verbrennt ihn, damit er das alte Jahr mitnimmt. In Sorrent gehört das Ritual seit den 1960er Jahren zu San Silvestro, wie der 31. in Italien heißt.
    </p>

    <blockquote class="border-l-4 border-med-gold pl-6 my-8">
      <p class="text-slate-700 text-xl font-serif italic leading-relaxed">
        „Das Feuer dient hier nicht dem Zerstören, sondern dem Abschließen."
      </p>
    </blockquote>

    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      Der Ciuccio kommt selten allein. An beiden Orten steht er am Ende eines Umzugs mit der <strong>Canzone di Capodanno</strong> (in Sant'Agata die <em>Canzone de lo Capo d'Anno</em>), dem alten Neujahrslied, das Musikgruppen zwischen dem 30. Dezember und Neujahr durch die Straßen tragen, um allen, denen sie begegnen, ein gutes Jahr zu wünschen. Gesungen wird im Dialekt, und die Idee ist dieselbe: das alte Jahr gemeinsam auf der Straße zu verabschieden.
    </p>
  </div>

  <!-- Sorrento -->
  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">Sorrent: Piazza Tasso um 18:00 Uhr</h2>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      In Sorrent ist der Ciuccio Teil des offiziellen Silvesterprogramms, eingebettet in die Winterreihe M'illumino d'Inverno, die von der Gemeinde getragen wird. Der Ablauf des Nachmittags ist seit Jahren derselbe:
    </p>
    <ul class="space-y-3 mb-6">
      <li class="flex items-start gap-3"><span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span><span class="text-slate-700"><strong>Ab 17:00 Uhr, der Umzug.</strong> Die Folkloregruppe Piedigrotta Sorrentina zieht zwischen Corso Italia und Altstadt umher und spielt die Canzone di Capodanno.</span></li>
      <li class="flex items-start gap-3"><span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span><span class="text-slate-700"><strong>18:00 Uhr, der Ciuccio.</strong> Der Esel wird auf der Piazza Tasso angezündet. In den Programmen von 2017 und 2025 wirkte der Schauspieler Marco Palmieri mit.</span></li>
      <li class="flex items-start gap-3"><span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span><span class="text-slate-700"><strong>Kostenlos.</strong> Alles findet auf dem offenen Platz statt, ohne Tickets und ohne reservierte Bereiche.</span></li>
    </ul>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      Diese Zeiten stammen aus den Programmen der letzten Ausgaben. Das Programm für 2026 ist noch nicht veröffentlicht: Sorrent gibt es meist in den letzten Dezembertagen bekannt, und Details können sich ändern. Unsere Seite zu <a href="/de-de/veranstaltungen/sorrentinische-halbinsel/capodanno-sorrento/" class="text-med-blue hover:underline">Silvester in Sorrent</a> wird nach der offiziellen Ankündigung aktualisiert.
    </p>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      Die Piazza Tasso füllt sich lange vor sechs, denn der Umzug bringt seine eigene Menge mit. Mit kleinen Kindern ist ein Platz am Rand angenehmer als die Mitte: Das Feuerwerk sieht man genauso gut, und man kann sich zurückziehen, wenn es laut wird.
    </p>
  </div>

  <!-- Sant'Agata -->
  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">Sant'Agata sui Due Golfi: die Dorfversion</h2>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      Sant'Agata ist der größte Ortsteil von Massa Lubrense, auf dem Höhenrücken über Sorrent, von wo man auf der einen Seite den Golf von Neapel und auf der anderen den Golf von Salerno sieht. Sein Ciuccio ist mehr ein Dorffest als der in Sorrent, auf einem kleineren Platz und mit weniger Publikum.
    </p>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      Hier gilt: erst das Lied, dann das Feuer. Am Nachmittag des 31. zieht die <em>Canzone de lo Capo d'Anno</em> durch die Straßen des Ortes, in den letzten Jahren mit Start am Corso Sant'Agata an der Kreuzung mit der Via Torricella, und zum Schluss wird der Esel auf dem Platz angezündet. In früheren Ausgaben hat die Pro Loco Due Golfi das Anzünden organisiert. Die jüngsten Programme setzen das Lied auf 16:00 oder 16:30 Uhr an, und 2024 war das Anzünden für 16:30 Uhr angekündigt, zusammen mit einem Brunch der Gemeinde.
    </p>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-6">
      <div class="bg-white p-6 rounded-[2rem] border border-slate-100 shadow-sm">
        <h4 class="font-bold text-slate-900 mb-2">Früher als in Sorrent</h4>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Da das Lied gegen vier Uhr beginnt, kommt der Ciuccio in Sant'Agata vor dem auf der Piazza Tasso. Wenn Sie oben auf dem Hügel wohnen, ist das der richtige.</p>
      </div>
      <div class="bg-white p-6 rounded-[2rem] border border-slate-100 shadow-sm">
        <h4 class="font-bold text-slate-900 mb-2">Nicht immer im Kalender</h4>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Der Kalender 2025/2026 von Massa Lubrense nannte das Lied, aber nicht den Ciuccio. Im Ort rechnet man trotzdem am 31. damit, doch prüfen Sie das Dezemberprogramm oder fragen Sie bei der Pro Loco nach.</p>
      </div>
    </div>
  </div>

  <!-- Getting there -->
  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">Anreise am 31. Dezember</h2>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      Es ist Winter, und das verändert die Möglichkeiten. Entlang der Küste fahren keine Fähren, und die Busse verkehren nach Feiertagsfahrplan, der früh endet.
    </p>

    <div class="overflow-x-auto rounded-[2rem] border border-slate-100 shadow-sm">
      <table class="w-full text-xs sm:text-sm">
        <thead class="bg-slate-900 text-white">
          <tr>
            <th class="text-left p-5 font-serif font-bold text-med-gold">Ziel</th>
            <th class="text-left p-5 font-serif font-bold text-med-gold">Wie</th>
            <th class="text-left p-5 font-serif font-bold text-med-gold">Hinweis</th>
          </tr>
        </thead>
        <tbody class="bg-white">
          <tr class="border-b border-slate-100">
            <td class="p-5 font-bold">Sorrent, ab Neapel</td>
            <td class="p-5 text-slate-600">Circumvesuviana bis zum Bahnhof Sorrent</td>
            <td class="p-5 text-slate-600">Etwa 1 Std.; die Piazza Tasso ist fünf Gehminuten vom Bahnhof entfernt</td>
          </tr>
          <tr class="border-b border-slate-100">
            <td class="p-5 font-bold">Sorrent, mit dem Auto</td>
            <td class="p-5 text-slate-600">Parkplätze außerhalb des Zentrums</td>
            <td class="p-5 text-slate-600">Am Abend des 31. ist das Zentrum für den Verkehr gesperrt</td>
          </tr>
          <tr class="border-b border-slate-100">
            <td class="p-5 font-bold">Sant'Agata, ab Sorrent</td>
            <td class="p-5 text-slate-600">Bus ab dem Bahnhofsbereich oder Auto</td>
            <td class="p-5 text-slate-600">Etwa 8 km, rund 20 Minuten Fahrt</td>
          </tr>
          <tr>
            <td class="p-5 font-bold">Beide, ab der Amalfiküste</td>
            <td class="p-5 text-slate-600">SITA-Bus über die Küstenstraße</td>
            <td class="p-5 text-slate-600">Eingeschränkter Winterbetrieb, planen Sie zuerst die Rückfahrt</td>
          </tr>
        </tbody>
      </table>
    </div>

    <p class="text-slate-600 text-lg leading-relaxed mt-6">
      SITA-Busse verbinden Sorrent mit den Ortsteilen von Massa Lubrense, Sant'Agata eingeschlossen, und EAV betreibt die lokalen Linien auf der Halbinsel. Am 31. fahren die Busse seltener und die letzten früh, prüfen Sie also die Rückfahrt, bevor Sie losgehen: Unser <a href="/de-de/ratgeber/sita-bus/" class="text-med-blue hover:underline">Ratgeber zum SITA-Bus</a> erklärt, wo man Fahrpläne findet und Tickets kauft. Von Positano oder Amalfi aus ist der Bus im Winter die einzige öffentliche Verbindung, und spät in der Nacht kommt man nicht mehr zurück.
    </p>
  </div>

  <!-- Combining -->
  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">So planen Sie den Rest des Abends</h2>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      Weil er brennt, bevor es richtig Nacht ist, lässt sich der Ciuccio gut in einen Silvesterplan einbauen, statt mit ihm zu konkurrieren. In Sorrent lief der Tag bei den letzten Ausgaben so ab:
    </p>
    <ul class="space-y-3 mb-6">
      <li class="flex items-start gap-3"><span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span><span class="text-slate-700"><strong>11:30 Uhr, Teatro Tasso.</strong> Das Jahresabschlusskonzert der Società dei Concerti di Sorrento eröffnet den Tag.</span></li>
      <li class="flex items-start gap-3"><span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span><span class="text-slate-700"><strong>17:00 bis 18:00 Uhr, Umzug und Ciuccio.</strong> Das Lied in den Straßen, dann der Esel auf der Piazza Tasso.</span></li>
      <li class="flex items-start gap-3"><span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span><span class="text-slate-700"><strong>Abendessen.</strong> Restaurants, die am 31. geöffnet haben, arbeiten meist mit einem festen Silvestermenü; reservieren Sie vor der Reise.</span></li>
      <li class="flex items-start gap-3"><span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span><span class="text-slate-700"><strong>23:00 bis 3:00 Uhr, Piazza Tasso.</strong> Livemusik und DJ-Set, mit dem Countdown auf dem Platz.</span></li>
      <li class="flex items-start gap-3"><span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span><span class="text-slate-700"><strong>1:00 Uhr, Feuerwerk.</strong> 2024 und 2025 wurde es von einer Plattform vor der Marina Piccola abgeschossen, eine Stunde nach Mitternacht.</span></li>
    </ul>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      Wenn Sie in Sant'Agata oder anderswo in Massa Lubrense wohnen, liegt es nahe, nachmittags den Ciuccio im Dorf zu sehen und oben auf dem Hügel zu Abend zu essen und dann zu entscheiden, ob Sie für Mitternacht nach Sorrent hinunterfahren, was Auto, Taxi oder einen langen Fußweg zurück bedeutet. Wer lieber um Mitternacht Feuerwerk an einem Strand sieht, findet mit <a href="/de-de/blog/silvester-positano-feuerwerk/" class="text-med-blue hover:underline">Silvester in Positano</a> die andere Möglichkeit an diesem Küstenabschnitt, aber das ist ein eigener Abend: Positano und Sorrent lassen sich in derselben Nacht praktisch nicht verbinden.
    </p>
  </div>

  <!-- Local Tips -->
  <div class="bg-white p-8 rounded-[2rem] shadow-xl border border-slate-100">
    <div class="flex items-center gap-4 mb-6">
      <svg class="w-6 h-6 text-med-gold flex-shrink-0" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M9 18h6"/><path d="M10 22h4"/><path d="M15.09 14c.18-.98.65-1.74 1.41-2.5A4.65 4.61 0 0 0 18 8 6 6 0 0 0 6 8c0 1 .23 2.23 1.5 3.5A4.61 4.61 0 0 1 8.91 14"/></svg>
      <h3 class="text-xl font-bold">Expertentipps</h3>
    </div>
    <div class="space-y-6">
      <div>
        <p class="font-bold text-slate-900 mb-1">Eine halbe Stunde früher da sein</p>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Die Vorführung ist kurz, und die Menge kommt mit dem Umzug. Wer um 17:30 Uhr auf der Piazza Tasso steht oder auf dem Platz in Sant'Agata, bevor das Lied endet, sieht den Esel und nicht nur die Hinterköpfe der anderen.</p>
      </div>
      <div>
        <p class="font-bold text-slate-900 mb-1">Abstand halten</p>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Es ist Feuerwerk mitten auf einem Platz. Bleiben Sie einige Meter von der Figur entfernt, lassen Sie Kinder nicht darauf zulaufen und denken Sie an Gehörschutz für Babys.</p>
      </div>
      <div>
        <p class="font-bold text-slate-900 mb-1">Kein Glas auf dem Platz</p>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">In den letzten Jahren hat Sorrent an Silvester Getränke in Glas im Zentrum verboten, und es wird streng kontrolliert. Nehmen Sie einen Plastikbecher mit oder stoßen Sie in der Bar an.</p>
      </div>
      <div>
        <p class="font-bold text-slate-900 mb-1">Das Programm in der letzten Dezemberwoche prüfen</p>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Die Zeiten hier stammen aus den letzten Ausgaben. Die Gemeinde Sorrent und das Tourismusbüro von Massa Lubrense veröffentlichen die endgültigen erst im Dezember, und ein verregneter Nachmittag kann alles verschieben.</p>
      </div>
    </div>
  </div>

</BlogPostLayout>
