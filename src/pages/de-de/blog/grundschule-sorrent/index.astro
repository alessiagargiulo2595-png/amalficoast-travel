---
import BlogPostLayout from '../../../../layouts/BlogPostLayout.astro';

const lang = 'de-de';
const post = {
  title: 'Grundschule in Sorrent: Ein Leitfaden für Familien',
  subtitle: 'Wie die italienische scuola primaria funktioniert, welche Schulen Sorrent tatsächlich hat, wann die Anmeldung läuft und worauf Familien ohne Italienisch sich einstellen müssen',
  category: 'REISEFÜHRER',
  date: '25. September 2026',
  readTime: '10 Min.',
  image: '/images/piazza-tasso-sorrento-hero.webp',
  imageAlt: "Piazza Tasso, der Hauptplatz von Sorrent und das Zentrum des Alltags in der Stadt",
  path: '/de-de/blog/grundschule-sorrent/',
};

const metaTitle = 'Grundschule in Sorrent: Schulen und Anmeldung | 2026';
const metaDescription = 'Sorrent hat vier Grundschulen, zwei staatliche und zwei anerkannte private, in zwei istituti comprensivi. Altersregeln, Anmeldefenster im Januar über die Plattform Unica, Ganztag und die nächste englischsprachige Option.';

const breadcrumbs = [
  { name: 'Home', url: '/de-de/' },
  { name: 'Blog', url: '/de-de/blog/' },
  { name: 'Grundschule in Sorrent', url: '/de-de/blog/grundschule-sorrent/' },
];

const quickInfo = [
  { label: 'Schulform', value: 'Scuola primaria, 5 Jahre' },
  { label: 'Alter', value: '6 bis 11 Jahre' },
  { label: 'Einschulungsregel', value: 'Sechs Jahre bis zum 31. Dezember' },
  { label: 'Vorzeitig', value: 'Möglich, wenn sechs bis zum 30. April' },
  { label: 'Schulen in Sorrent', value: '4: zwei staatlich, zwei anerkannt privat' },
  { label: 'Istituti comprensivi', value: '2: Sorrento Capoluogo und Tasso' },
  { label: 'Anmeldung', value: 'Online im Januar, SPID oder CIE nötig' },
  { label: 'Unterrichtssprache', value: 'Italienisch' },
];

const faq = [
  {
    q: 'Mit welchem Alter beginnt die Grundschule in Italien?',
    a: 'Ein Kind kommt im September des Jahres in die classe prima, in dem es sechs Jahre alt wird, sofern der Geburtstag auf den 31. Dezember oder davor fällt. Familien können auch eine vorzeitige Einschulung beantragen, die iscrizione anticipata, für Kinder, die bis zum 30. April des Folgejahres sechs werden. Die Grundschule dauert dann fünf Jahre, bis etwa elf.',
  },
  {
    q: 'Wie viele Grundschulen gibt es in Sorrent?',
    a: 'Vier in der Gemeinde Sorrent: zwei staatliche, Sorrento Capoluogo in der Via Vittorio Veneto und Angelina Lauro in der Via Capasso, sowie zwei anerkannte private, das Conservatorio Santa Maria della Pietà in der Via Pietà und Santa Maria delle Grazie an der Piazza Sant\'Antonino. Die staatlichen gehören zu zwei istituti comprensivi, die auch Kindergarten und Mittelschule umfassen.',
  },
  {
    q: 'Wann öffnet die Anmeldung?',
    a: 'Im Januar, für das Schuljahr, das im folgenden September beginnt. Für 2026/2027 lief das Fenster vom 13. Januar bis 14. Februar 2026. Das Ministerium veröffentlicht das Rundschreiben mit den genauen Terminen im Dezember, das Fenster des Folgejahres steht also meist erst wenige Wochen vorher fest.',
  },
  {
    q: 'Wie reicht man den Antrag ein?',
    a: 'Online, über die Plattform Unica des Bildungsministeriums. Ein Elternteil meldet sich mit digitaler Identität an, SPID, CIE oder eIDAS, trägt die Daten des Kindes ein und nennt eine Schule als Erstwunsch plus bis zu zwei Alternativen. Die codice fiscale des Kindes wird gebraucht. Kinder, die während des Schuljahres ankommen, werden stattdessen direkt an der Schule angemeldet.',
  },
  {
    q: 'Gibt es eine englischsprachige Grundschule in Sorrent?',
    a: 'Nein. Auf der Sorrentinischen Halbinsel gibt es keine internationale oder englischsprachige Grundschule. Die nächstgelegene Möglichkeit ist die International School of Naples in Bagnoli, die einen amerikanischen Lehrplan auf Englisch von der Vorschule bis zur zwölften Klasse anbietet. Von Sorrent sind es rund anderthalb Stunden, was sie als täglichen Schulweg für die meisten Familien ausschliesst.',
  },
  {
    q: 'Geht es auf dieser Seite um die Sorrento Primary School in Australien?',
    a: 'Nein. Schulen dieses Namens gibt es in Sorrento, Westaustralien, und in Sorrento, Victoria, und sie haben damit nichts zu tun. Diese Seite behandelt die Grundschule in Sorrent in Kampanien, der Stadt am Golf von Neapel.',
  },
];

const sidebarLinks = [
  { label: 'Sorrent', href: '/de-de/sorrentinische-halbinsel/sorrent/' },
  { label: 'Auslandsstudium in Sorrent', href: '/de-de/blog/auslandsstudium-sorrent/' },
  { label: 'Sorrent oder Positano', href: '/de-de/blog/sorrento-vs-positano/' },
  { label: 'SITA-Bus', href: '/de-de/ratgeber/sita-bus/' },
  { label: 'Fähren', href: '/de-de/ratgeber/faehren/' },
];

const authorRole = 'Lokaler Experte · Sorrentinische Halbinsel';

const relatedArticles = [
  {
    title: 'Auslandsstudium in Sorrent: Studieren auf der Sorrentinischen Halbinsel',
    category: 'REISEFÜHRER',
    date: '4. Juli 2026',
    image: '/images/study-abroad-sorrento-hero.webp',
    imageAlt: 'Studieren in Sorrent',
    path: '/de-de/blog/auslandsstudium-sorrent/'
  },
  {
    title: 'Filme in Sorrent: Wenn das Kino die Halbinsel waehlt',
    category: 'ENTDECKUNGEN',
    date: '30. Juni 2026',
    image: '/images/film-fatti-a-sorrento-hero.webp',
    imageAlt: 'In Sorrent gedrehte Filme',
    path: '/de-de/blog/filme-in-sorrent/'
  }
];

const imageCredit = {
  author: 'Berthold Werner / Wikimedia Commons',
  sourceUrl: 'https://commons.wikimedia.org/wiki/File:Piazza_Tasso_-_Sorrento_BW_2013-05-12.jpg',
  license: 'CC BY-SA 3.0',
  licenseUrl: 'https://creativecommons.org/licenses/by-sa/3.0/',
};

const keyTakeaways = [
  'Die italienische scuola primaria dauert fünf Jahre, beginnt im September des Jahres, in dem das Kind sechs wird, und ist an staatlichen Schulen kostenlos.',
  'Sorrent hat vier Grundschulen, zwei staatliche und zwei anerkannte private, zusammengefasst in zwei istituti comprensivi mit Sitz in der Via Vittorio Veneto und der Via Marziale.',
  'Die Anmeldung läuft im Januar online über die Plattform Unica des Ministeriums, und ein Elternteil braucht dafür eine italienische digitale Identität wie SPID oder CIE.',
  'Die wichtigste Entscheidung vor Ort ist tempo normale gegen tempo pieno, denn Ganztagsplätze mit Mensa sind begrenzt und nicht in jedem Gebäude vorhanden.',
  'Unterrichtet wird auf Italienisch. Eine englischsprachige Grundschule gibt es auf der Halbinsel nicht, und die nächste internationale Schule liegt in Neapel, zu weit für den täglichen Weg.',
];
---

<BlogPostLayout
  lang={lang}
  post={post}
  metaTitle={metaTitle}
  metaDescription={metaDescription}
  breadcrumbs={breadcrumbs}
  quickInfo={quickInfo}
  faq={faq}
  sidebarLinks={sidebarLinks}
  authorRole={authorRole}
  relatedArticles={relatedArticles}
  imageCredit={imageCredit}
  pageKey="sorrento-primary-school"
>

  <!-- Key Takeaways -->
  <div class="bg-slate-900 text-white p-8 rounded-[2rem]">
    <div class="flex items-center gap-3 mb-6">
      <svg class="w-5 h-5 text-med-gold flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
      <h2 class="font-serif text-lg font-bold text-med-gold uppercase tracking-[0.15em]">Key Takeaways</h2>
    </div>
    <ul class="space-y-4">
      {keyTakeaways.map((point) => (
        <li class="flex items-start gap-3">
          <span class="w-1.5 h-1.5 rounded-full bg-med-gold flex-shrink-0 mt-2"></span>
          <span class="text-white/80 text-xs sm:text-sm leading-relaxed">{point}</span>
        </li>
      ))}
    </ul>
  </div>

  <!-- Intro -->
  <div>
    <p class="text-slate-600 text-xl leading-relaxed mb-6 font-light">
      Die meisten kommen für eine Woche nach <a href="/de-de/sorrentinische-halbinsel/sorrent/" class="text-med-blue hover:underline">Sorrent</a>. Eine kleinere Zahl kommt für ein Jahr oder länger, meist wegen einer Arbeit im Tourismus, eines Remote-Jobs, der überall möglich wäre, oder der Rückkehr in ein Familienhaus, und stellt dann fest, dass die Frage, wo ein Sechsjähriger zur Schule geht, in keinem Reiseführer steht. Diese Seite beschreibt, was die Stadt tatsächlich zu bieten hat, wie das italienische System für ein Kind von aussen funktioniert und welche wenigen Termine über alles entscheiden.
    </p>
  </div>

  <!-- Wie es funktioniert -->
  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">Wie die Italienische Scuola Primaria Funktioniert</h2>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      Die Grundschule in Italien dauert fünf Jahre, von der <em>classe prima</em> bis zur <em>classe quinta</em>, und umfasst ungefähr das Alter von sechs bis elf. Sie ist Pflicht und an staatlichen Schulen kostenlos: Familien zahlen Material, Ausflüge und Mensa, nicht den Unterricht. Davor liegt die freiwillige <em>scuola dell'infanzia</em> ab drei Jahren, danach folgen die drei Jahre <em>scuola secondaria di primo grado</em>, die alle Mittelschule nennen.
    </p>
    <p class="text-slate-600 text-lg leading-relaxed mb-8">
      In Kampanien läuft das Schuljahr normalerweise von Mitte September bis in die ersten Junitage, mit Schliessungen zu Weihnachten, Ostern und an nationalen wie lokalen Feiertagen. Die eine strukturelle Entscheidung, die Familien bei der Anmeldung treffen, betrifft den Stundenplan.
    </p>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div class="bg-white p-6 rounded-[2rem] border border-slate-100 shadow-sm">
        <h4 class="font-bold text-slate-900 mb-2">Tempo normale</h4>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Nur vormittags, meist 27 bis 30 Wochenstunden, Schluss am frühen Nachmittag und ohne Mensa. Im Süden die Regel und die günstigere Variante, setzt aber voraus, dass mittags jemand zu Hause ist.</p>
      </div>
      <div class="bg-white p-6 rounded-[2rem] border border-slate-100 shadow-sm">
        <h4 class="font-bold text-slate-900 mb-2">Tempo pieno</h4>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Ganztags, etwa 40 Wochenstunden inklusive Mittagessen in der Mensa und Nachmittagsunterricht. Die Plätze sind begrenzt, nicht in jedem Gebäude vorhanden und werden nach Nachfrage vergeben. Das ist die erste Frage beim Anruf in einer Schule.</p>
      </div>
    </div>
  </div>

  <!-- Die Schulen -->
  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">Die Grundschulen in Sorrent</h2>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      Sorrent ist eine kleine Stadt, und die Liste ist kurz. In der Gemeinde arbeiten vier Grundschulen, zwei staatliche und zwei anerkannte private, die an religiöse Einrichtungen angebunden sind. Die staatlichen liegen innerhalb der <em>istituti comprensivi</em>, der italienischen Einheit, die Kindergarten, Grundschule und Mittelschule unter einer Leitung zusammenfasst.
    </p>

    <div class="overflow-x-auto rounded-[2rem] border border-slate-100 shadow-sm">
      <table class="w-full text-xs sm:text-sm">
        <thead class="bg-slate-900 text-white">
          <tr>
            <th class="text-left p-5 font-serif font-bold text-med-gold">Schule</th>
            <th class="text-left p-5 font-serif font-bold text-med-gold">Art</th>
            <th class="text-left p-5 font-serif font-bold text-med-gold">Adresse</th>
          </tr>
        </thead>
        <tbody class="bg-white">
          <tr class="border-b border-slate-100">
            <td class="p-5 font-bold">Sorrento Capoluogo</td>
            <td class="p-5 text-slate-600">Staatlich, I.C. Sorrento</td>
            <td class="p-5 text-slate-600">Via Vittorio Veneto, Sorrent</td>
          </tr>
          <tr class="border-b border-slate-100">
            <td class="p-5 font-bold">Angelina Lauro</td>
            <td class="p-5 text-slate-600">Staatlich</td>
            <td class="p-5 text-slate-600">Via Capasso, Sorrent</td>
          </tr>
          <tr class="border-b border-slate-100">
            <td class="p-5 font-bold">Conservatorio Santa Maria della Pietà</td>
            <td class="p-5 text-slate-600">Anerkannt privat, religiöse Einrichtung</td>
            <td class="p-5 text-slate-600">Via Pietà 24, Sorrent</td>
          </tr>
          <tr>
            <td class="p-5 font-bold">Santa Maria delle Grazie</td>
            <td class="p-5 text-slate-600">Anerkannt privat</td>
            <td class="p-5 text-slate-600">Piazza Sant'Antonino 14, Sorrent</td>
          </tr>
        </tbody>
      </table>
    </div>

    <p class="text-slate-600 text-lg leading-relaxed mt-6">
      Innerhalb des staatlichen Systems verteilen sich die Grundschulklassen auf zwei Gebäude: den Hauptsitz Vittorio Veneto in der Via Vittorio Veneto 16 und einen zweiten Standort in der Via Marziale 18, die zugleich die Adresse des istituto comprensivo Tasso ist und in der die Ganztagszüge untergebracht waren. Welches Gebäude Ihr Kind besucht, hängt von der Klasse ab, in die es eingeteilt wird, nicht allein von der Schule, bei der Sie sich beworben haben. Fragen Sie also bei der Anmeldung nach, statt es vorauszusetzen.
    </p>
  </div>

  <!-- Anmeldung -->
  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">Die Anmeldung, Schritt für Schritt</h2>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      Die Anmeldung zur classe prima ist ein landesweites Online-Verfahren mit festem Zeitfenster, und wer es verpasst, verhandelt danach direkt mit einer Schule über das, was übrig ist. Die folgende Abfolge gilt für eine Familie, die bereits in Sorrent wohnt oder es bald tun wird.
    </p>

    <div class="bg-white p-8 rounded-[2rem] border border-slate-100 shadow-sm">
      <h3 class="font-serif text-xl font-bold text-slate-900 mb-5">Die fünf Schritte</h3>
      <div class="space-y-3">
        <div class="flex items-start gap-3">
          <div class="w-6 h-6 rounded-full bg-med-gold/15 flex-shrink-0 flex items-center justify-center text-med-gold font-bold text-xs">1</div>
          <p class="text-slate-600 text-xs sm:text-sm leading-relaxed"><strong>Papiere ordnen.</strong> Das Kind braucht eine italienische <em>codice fiscale</em>, und mindestens ein Elternteil eine digitale Identität, SPID, CIE oder einen gleichwertigen europäischen eIDAS-Zugang. Beides dauert, beginnen Sie also im Herbst und nicht im Januar.</p>
        </div>
        <div class="flex items-start gap-3">
          <div class="w-6 h-6 rounded-full bg-med-gold/15 flex-shrink-0 flex items-center justify-center text-med-gold font-bold text-xs">2</div>
          <p class="text-slate-600 text-xs sm:text-sm leading-relaxed"><strong>Auf das Rundschreiben warten.</strong> Es erscheint im Dezember und legt das Fenster fest. Für 2026/2027 liefen die Anträge vom 13. Januar bis 14. Februar 2026, und in den letzten Jahren war die Öffnung stets im Januar.</p>
        </div>
        <div class="flex items-start gap-3">
          <div class="w-6 h-6 rounded-full bg-med-gold/15 flex-shrink-0 flex items-center justify-center text-med-gold font-bold text-xs">3</div>
          <p class="text-slate-600 text-xs sm:text-sm leading-relaxed"><strong>Zu den open days gehen.</strong> Die Schulen veranstalten sie in den Wochen vor der Öffnung. Dort sehen Sie die Gebäude, lernen die Lehrkräfte kennen und erfahren, ob im kommenden Jahr ein Ganztagszug eingerichtet wird.</p>
        </div>
        <div class="flex items-start gap-3">
          <div class="w-6 h-6 rounded-full bg-med-gold/15 flex-shrink-0 flex items-center justify-center text-med-gold font-bold text-xs">4</div>
          <p class="text-slate-600 text-xs sm:text-sm leading-relaxed"><strong>Antrag auf Unica stellen.</strong> Eine Schule als Erstwunsch, bis zu zwei Alternativen. Bei Überbuchung ist der Wohnsitz im Einzugsgebiet meist das erste Kriterium, danach folgen die weiteren Familienumstände, die jede Schule in ihrer eigenen Ordnung festlegt.</p>
        </div>
        <div class="flex items-start gap-3">
          <div class="w-6 h-6 rounded-full bg-med-gold/15 flex-shrink-0 flex items-center justify-center text-med-gold font-bold text-xs">5</div>
          <p class="text-slate-600 text-xs sm:text-sm leading-relaxed"><strong>Die Zusatzleistungen mit der Gemeinde klären.</strong> Mensa, Früh- und Spätbetreuung sowie Schülerbeförderung sind kommunale Dienste mit eigenen Anträgen und nicht Teil der Schulanmeldung.</p>
        </div>
      </div>
    </div>
  </div>

  <!-- Kein Italienisch -->
  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">Wenn in der Familie Kein Italienisch Gesprochen Wird</h2>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      Die ehrliche Antwort lautet: ein Kind an einer Grundschule in Sorrent wird auf Italienisch unterrichtet, von Lehrkräften, die meist ausschliesslich auf Italienisch arbeiten, neben Mitschülern, die es alle zu Hause sprechen. Italienische staatliche Schulen nehmen Kinder zu jedem Zeitpunkt des Schuljahres auf, unabhängig von Sprache und Papieren, was eine echte Stärke des Systems ist, und Förderung in Italienisch als Zweitsprache existiert. Wie viel davon eine einzelne Schule leisten kann, schwankt allerdings erheblich.
    </p>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      Für die meisten Sechs- und Siebenjährigen erweist sich das als machbar, und oft als bemerkenswert schnell. Ab etwa neun oder zehn in einen Lehrplan einzusteigen, der in Geschichte, Erdkunde und Grammatik bereits anspruchsvoll ist, ohne ein Wort Italienisch, ist deutlich härter und sollte gut überlegt sein.
    </p>
    <p class="text-slate-600 text-lg leading-relaxed mb-8">
      Eine englischsprachige Grundschule gibt es auf der Halbinsel nicht. Die nächste Alternative ist die <strong>International School of Naples</strong> in Bagnoli am westlichen Rand der Stadt, die einen amerikanischen Lehrplan auf Englisch von der Vorschule bis zur zwölften Klasse unterrichtet, rund 300 Schülerinnen und Schüler aus vielen Nationen hat und ihre Gebührenordnung nur über das Zulassungsbüro herausgibt. Von Sorrent aus sind es etwa anderthalb Stunden pro Weg, quer durch ganz Neapel. In der Praxis ziehen Familien, die das brauchen, näher an die Stadt, statt zu pendeln.
    </p>

    <blockquote class="border-l-4 border-med-gold pl-6 my-8">
      <p class="text-slate-700 text-xl font-serif italic leading-relaxed">
        "In Sorrent lautet die Schulfrage nicht, welchen internationalen Lehrplan man wählt. Sie lautet, wie schnell ein Kind Italienisch lernt, und die Antwort ist meist: schneller als seine Eltern."
      </p>
    </blockquote>
  </div>

  <!-- Tipps -->
  <div class="bg-white p-8 rounded-[2rem] shadow-xl border border-slate-100">
    <div class="flex items-center gap-4 mb-6">
      <svg class="w-6 h-6 text-med-gold flex-shrink-0" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M9 18h6"/><path d="M10 22h4"/><path d="M15.09 14c.18-.98.65-1.74 1.41-2.5A4.65 4.65 0 0 0 18 8 6 6 0 0 0 6 8c0 1 .23 2.23 1.5 3.5A4.61 4.61 0 0 1 8.91 14"/></svg>
      <h3 class="text-xl font-bold">Expertentipps</h3>
    </div>
    <div class="space-y-6">
      <div>
        <p class="font-bold text-slate-900 mb-1">Fragen Sie nach dem Gebäude, nicht nur nach der Schule</p>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Die staatlichen Grundschulklassen in Sorrent verteilen sich auf mehrere Standorte, und der Weg von der Via Vittorio Veneto zur Via Marziale fällt ins Gewicht, wenn man ihn zweimal täglich mit einem Sechsjährigen geht. Lassen Sie sich den Standort bestätigen, bevor Sie einen Platz annehmen.</p>
      </div>
      <div>
        <p class="font-bold text-slate-900 mb-1">Behandeln Sie den Wohnsitz als entscheidenden Faktor</p>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Bei Überbuchung gewinnt in der Regel das Einzugsgebiet. Wenn Sie noch suchen, wo Sie in der Stadt mieten, prüfen Sie vor der Unterschrift, zu welcher Schule die Adresse gehört. Es ist viel einfacher, die Wohnung um die Schule herum zu wählen als umgekehrt.</p>
      </div>
      <div>
        <p class="font-bold text-slate-900 mb-1">Verlassen Sie sich nicht auf die vorzeitige Einschulung</p>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Den Weg der anticipataria gibt es für Kinder, die bis zum 30. April des Folgejahres sechs werden, aber die Schulen wägen Reife und die Zahl der bildbaren Klassen ab. Stellen Sie den Antrag, wenn Sie ihn wollen, und halten Sie einen Plan für ein weiteres Jahr scuola dell'infanzia bereit.</p>
      </div>
      <div>
        <p class="font-bold text-slate-900 mb-1">Die Halbinsel ist grösser als Sorrent</p>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Sant'Agnello, Piano di Sorrento, Meta und Massa Lubrense haben eigene istituti comprensivi, wenige Minuten entfernt mit der Circumvesuviana oder dem <a href="/de-de/ratgeber/sita-bus/" class="text-med-blue hover:underline">SITA-Bus</a>. Wenn Sie den Ganztag brauchen und Sorrent ihn nicht bietet, hat die Nachbargemeinde ihn oft.</p>
      </div>
    </div>
  </div>

</BlogPostLayout>
