---
import BlogPostLayout from '../../../../layouts/BlogPostLayout.astro';

const lang = 'de-de';
const post = {
  title: 'Spaghetti alla Nerano',
  subtitle: "Die Pasta mit gebratenen Zucchini, 1952 in einer winzigen Bucht entstanden, und wo man das Original heute isst",
  category: 'KULINARIK',
  date: '17. August 2026',
  readTime: '8 Min.',
  image: '/images/nerano-hero.webp',
  imageAlt: 'Spaghetti alla Nerano, die Pasta mit gebratenen Zucchini aus Marina del Cantone',
  path: '/de-de/blog/spaghetti-alla-nerano/',
};

const metaTitle = 'Spaghetti alla Nerano: Wo das Original essen | Guide 2026';
const metaDescription = 'Das Gericht entstand 1952 in Nerano im Ristorante Maria Grazia. Wo man es an der Marina del Cantone isst, wie man die Bucht von Sorrent mit dem SITA-Bus oder per Boot erreicht, und was es von gewöhnlicher Zucchini-Pasta unterscheidet.';

const breadcrumbs = [
  { name: 'Home', url: '/de-de/' },
  { name: 'Blog', url: '/de-de/blog/' },
  { name: 'Spaghetti alla Nerano', url: '/de-de/blog/spaghetti-alla-nerano/' },
];

const quickInfo = [
  { label: 'Gericht', value: 'Spaghetti mit gebratenen Zucchini und Käse' },
  { label: 'Entstanden in', value: 'Nerano, Marina del Cantone (1952)' },
  { label: 'Erfunden von', value: 'Donna Rosa, Ristorante Maria Grazia' },
  { label: 'Wo', value: 'Massa Lubrense, Sorrentinische Halbinsel' },
  { label: 'Käse', value: 'Provolone del Monaco g.U. oder lokale Caciotta' },
  { label: 'Ab Sorrent', value: 'Etwa 50 Min. mit dem SITA-Bus' },
  { label: 'Reservierung', value: 'Im Juli und August unerlässlich' },
  { label: 'Beste Zeit', value: 'Juni bis September, wegen der Zucchini' },
];

const faq = [
  {
    q: 'Wo wurden die Spaghetti alla Nerano erfunden?',
    a: 'Im Ristorante Maria Grazia an der Marina del Cantone, der kleinen Bucht unterhalb des Dorfes Nerano in der Gemeinde Massa Lubrense. Das Gericht entstand 1952 durch Donna Rosa, und das 1901 gegründete Lokal wird bis heute von ihren Nachfahren geführt.',
  },
  {
    q: 'Wo sollte man sie in Nerano essen?',
    a: 'Maria Grazia ist das Ursprungslokal und der Grund, warum das Gericht den Namen des Dorfes trägt. Lo Scoglio da Tommaso, direkt über dem Wasser in derselben Bucht, ist die zweite bekannte Adresse und wurde international berühmt, nachdem Stanley Tucci dort gedreht hatte. Beide liegen wenige Gehminuten auseinander.',
  },
  {
    q: 'Wie kommt man von Sorrent nach Nerano?',
    a: 'Mit dem SITA-Bus ab Bahnhof Sorrent, etwa 50 Minuten, teils mit Umstieg in Sant Agata sui Due Golfi. Mit dem Auto sind es rund 30 Minuten, doch die Parkplätze an der Marina del Cantone sind begrenzt und im Sommer kostenpflichtig. Viele kommen per Boot aus Sorrent, Positano oder von Capri.',
  },
  {
    q: 'Welcher Käse gehört in die Spaghetti alla Nerano?',
    a: 'Traditionell Provolone del Monaco g.U., der gereifte Kuhmilchkäse der Sorrentinischen Halbinsel, manchmal ergänzt oder ersetzt durch eine lokale Caciotta. Der Käse gibt der Sauce ihren Körper: Sahne kommt im Original nicht vor.',
  },
  {
    q: 'Worin unterscheiden sie sich von gewöhnlicher Zucchini-Pasta?',
    a: 'In zwei Punkten. Die Zucchini werden separat gebraten und ruhen gelassen, sodass sie weich und konzentriert werden statt zu dünsten. Dann wird die Sauce abseits der Hitze gebunden: geriebener Käse wird mit stärkehaltigem Nudelwasser emulgiert, was einen glänzenden Überzug ergibt statt einer wässrigen Lache.',
  },
  {
    q: 'Muss man reservieren?',
    a: 'In der Hochsaison ja. Die Marina del Cantone ist eine sehr kleine Bucht mit wenigen Restaurants und empfängt Gäste von der Straße und vom Meer gleichzeitig. Für Juli und August sollte man weit im Voraus buchen, besonders für einen Tisch zum Mittagessen.',
  },
];

const sidebarLinks = [
  { label: 'Marina del Cantone', href: '/de-de/strande/sorrentinische-halbinsel/marina-del-cantone/' },
  { label: 'Massa Lubrense', href: '/de-de/sorrentinische-halbinsel/massa-lubrense/' },
  { label: 'Baia di Recommone', href: '/de-de/blog/baia-recommone/' },
  { label: 'SITA-Bus', href: '/de-de/ratgeber/sita-bus/' },
  { label: 'Punta Campanella', href: '/de-de/blog/punta-campanella/' },
];

const authorRole = 'Lokaler Experte · Amalfiküste';

const relatedArticles = [
  {
    title: 'Cetara-Sardellen: Das Silbergold der Amalfiküste',
    category: 'KULINARIK',
    date: '4. April 2026',
    image: '/images/alici-cetara-hero.webp',
    imageAlt: 'Cetara-Sardellen und Colatura g.U. - Amalfiküste',
    path: '/de-de/blog/cetara-sardellen/'
  },
  {
    title: 'Scialatielli: Die Pasta der Amalfiküste',
    category: 'ESSEN',
    date: '27. Mai 2026',
    image: '/images/scialatielli-hero.webp',
    imageAlt: 'Scialatielli, die frische Pasta der Amalfiküste',
    path: '/de-de/blog/scialatielli/'
  }
];

const keyTakeaways = [
  'Die Spaghetti alla Nerano entstanden 1952 durch Donna Rosa im Ristorante Maria Grazia, in der Bucht Marina del Cantone unterhalb des Dorfes Nerano.',
  'Das Dorf gehört zu Massa Lubrense auf der Sorrentinischen Halbinsel und nicht zur eigentlichen Amalfiküste, weshalb so viele Besucher es nie finden.',
  'Die Sauce beruht auf gebratenen Zucchini und geriebenem Käse, der mit Nudelwasser emulgiert wird. Im Original gibt es keine Sahne.',
  'Maria Grazia ist der Geburtsort des Gerichts; Lo Scoglio da Tommaso in derselben Bucht ist die Adresse, die Stanley Tucci im Ausland bekannt machte.',
  'Von Sorrent dauert die Fahrt mit dem SITA-Bus etwa 50 Minuten, und im Juli und August ist eine Reservierung zum Mittagessen unerlässlich.',
];
---

<BlogPostLayout
  lang={lang}
  post={post}
  metaTitle={metaTitle}
  metaDescription={metaDescription}
  breadcrumbs={breadcrumbs}
  quickInfo={quickInfo}
  faq={faq}
  sidebarLinks={sidebarLinks}
  authorRole={authorRole}
  relatedArticles={relatedArticles}
  pageKey="spaghetti-alla-nerano"
>

  <!-- Key Takeaways -->
  <div class="bg-slate-900 text-white p-8 rounded-[2rem]">
    <div class="flex items-center gap-3 mb-6">
      <svg class="w-5 h-5 text-med-gold flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
      <h2 class="font-serif text-lg font-bold text-med-gold uppercase tracking-[0.15em]">Key Takeaways</h2>
    </div>
    <ul class="space-y-4">
      {keyTakeaways.map((point) => (
        <li class="flex items-start gap-3">
          <span class="w-1.5 h-1.5 rounded-full bg-med-gold flex-shrink-0 mt-2"></span>
          <span class="text-white/80 text-xs sm:text-sm leading-relaxed">{point}</span>
        </li>
      ))}
    </ul>
  </div>

  <!-- Intro -->
  <div>
    <p class="text-slate-600 text-xl leading-relaxed mb-6 font-light">
      Die meisten berühmten italienischen Gerichte tragen den Namen einer Stadt. Dieses trägt den Namen eines Weilers mit ein paar hundert Einwohnern, versteckt an der äußersten Spitze der Sorrentinischen Halbinsel. Nerano liegt über einer Bucht namens <a href="/de-de/strande/sorrentinische-halbinsel/marina-del-cantone/" class="text-med-blue hover:underline">Marina del Cantone</a>, gegenüber von Capri, und die Pasta, die seinen Namen trägt, wurde dort erfunden, in einer einzigen Küche, an einem Abend im Jahr 1952. Heute serviert sie fast jedes Restaurant zwischen Neapel und Salerno. Nur ein Ort kann das Original für sich beanspruchen.
    </p>
  </div>

  <!-- Origin -->
  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">Nerano, 1952: Wie das Gericht entstand</h2>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      Die Küche gehörte zum <strong>Ristorante Maria Grazia</strong>, einem 1901 eröffneten Familienbetrieb am Strand der Marina del Cantone. Gekocht hat Donna Rosa, und was sie 1952 zusammenstellte, nutzte, was Garten und lokale Käserei hergaben: Zucchini, Käse, Basilikum, Olivenöl. Nichts, was angeliefert werden musste, was bei einer so steilen Straße erheblich ins Gewicht fiel.
    </p>
    <p class="text-slate-600 text-lg leading-relaxed mb-8">
      Das Lokal wird noch heute von ihren Nachfahren geführt, und die Familie hat das Binden der Sauce stets für sich behalten. Diese Verschwiegenheit gehört zur Legende, doch der wahre Grund für die Verbreitung ist schlichter: Die Bucht wurde zum Ankerplatz für Boote aus Capri und <a href="/de-de/amalfikueste/positano/" class="text-med-blue hover:underline">Positano</a>, und wer dort von Bord ging, nahm den Namen mit nach Hause.
    </p>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div class="bg-white p-6 rounded-[2rem] border border-slate-100 shadow-sm">
        <h4 class="font-bold text-slate-900 mb-2">Ein Weiler, keine Stadt</h4>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Nerano ist ein Ortsteil von <a href="/de-de/sorrentinische-halbinsel/massa-lubrense/" class="text-med-blue hover:underline">Massa Lubrense</a>, das aus siebzehn solcher Weiler über die Landzunge verteilt besteht. Es hat kein Zentrum im üblichen Sinn, nur einen Platz und eine Straße hinunter ans Wasser.</p>
      </div>
      <div class="bg-white p-6 rounded-[2rem] border border-slate-100 shadow-sm">
        <h4 class="font-bold text-slate-900 mb-2">Nicht die Amalfiküste</h4>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Die Bucht blickt auf den Golf von Salerno, gehört verwaltungstechnisch aber zur Sorrentinischen Halbinsel. Wer nur entlang der Amalfitana sucht, kommt nie an, und genau deshalb ist sie klein geblieben.</p>
      </div>
    </div>
  </div>

  <!-- Where to eat -->
  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">Wo man Spaghetti alla Nerano in Nerano isst</h2>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      Beide Adressen, die zählen, liegen am selben kurzen Strandabschnitt, wenige Gehminuten auseinander. Es sind sehr unterschiedliche Erlebnisse, und die Wahl hängt wirklich davon ab, was Sie suchen.
    </p>

    <div class="overflow-hidden rounded-[2rem] border border-slate-100 shadow-sm">
      <table class="w-full text-xs sm:text-xs sm:text-sm">
        <thead class="bg-slate-900 text-white">
          <tr>
            <th class="text-left p-5 font-serif font-bold text-med-gold">Restaurant</th>
            <th class="text-left p-5 font-serif font-bold text-med-gold">Was Sie wissen sollten</th>
          </tr>
        </thead>
        <tbody class="bg-white">
          <tr class="border-b border-slate-100">
            <td class="p-5 font-bold">Maria Grazia</td>
            <td class="p-5 text-slate-600">Der Ursprungsort. Seit 1901 geöffnet, noch immer in Familienhand, und der Grund, warum das Gericht überhaupt alla Nerano heißt. Man kommt für die Version, von der das Rezept abstammt, nicht für die Aussicht.</td>
          </tr>
          <tr class="border-b border-slate-100">
            <td class="p-5 font-bold">Lo Scoglio da Tommaso</td>
            <td class="p-5 text-slate-600">Auf einem eigenen Steg über dem Wasser gebaut, mit Erzeugnissen aus dem Familiengarten. Von Stanley Tucci für "Searching for Italy" gefilmt, weshalb es im Sommer Monate im Voraus ausgebucht ist.</td>
          </tr>
          <tr>
            <td class="p-5 font-bold">Überall sonst</td>
            <td class="p-5 text-slate-600">Sie finden das Gericht auf Speisekarten beider Küsten. Betrachten Sie diese als Interpretationen. Wird es mit Sahne serviert, folgt die Küche nicht der Methode von Nerano.</td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>

  <!-- Getting there -->
  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">Wie man Nerano und die Marina del Cantone erreicht</h2>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      Die Bucht liegt etwa 30 Fahrminuten von Sorrent entfernt, doch die Straße ist eng und das letzte Stück fällt steil zum Meer ab. Entscheiden Sie sich für ein Verkehrsmittel vor der Abfahrt, nicht erst am Tag selbst.
    </p>

    <div class="bg-white p-8 rounded-[2rem] border border-slate-100 shadow-sm">
      <h3 class="font-serif text-xl font-bold text-slate-900 mb-5">Drei Wege hinunter in die Bucht</h3>
      <div class="space-y-3">
        <div class="flex items-start gap-3">
          <div class="w-6 h-6 rounded-full bg-med-gold/15 flex-shrink-0 flex items-center justify-center text-med-gold font-bold text-xs">1</div>
          <p class="text-slate-600 text-xs sm:text-sm leading-relaxed"><strong>Mit dem <a href="/de-de/ratgeber/sita-bus/" class="text-med-blue hover:underline">SITA-Bus</a></strong> ab Bahnhof Sorrent, etwa 50 Minuten. Einige Fahrten erfordern einen Umstieg in Sant Agata sui Due Golfi, prüfen Sie also den Fahrplan der Direktverbindung nach Nerano.</p>
        </div>
        <div class="flex items-start gap-3">
          <div class="w-6 h-6 rounded-full bg-med-gold/15 flex-shrink-0 flex items-center justify-center text-med-gold font-bold text-xs">2</div>
          <p class="text-slate-600 text-xs sm:text-sm leading-relaxed"><strong>Mit dem Auto</strong>, etwa 30 Minuten ab Sorrent über Massa Lubrense. Die Parkplätze an der Marina del Cantone sind begrenzt und kostenpflichtig, im August bereits am Vormittag belegt.</p>
        </div>
        <div class="flex items-start gap-3">
          <div class="w-6 h-6 rounded-full bg-med-gold/15 flex-shrink-0 flex items-center justify-center text-med-gold font-bold text-xs">3</div>
          <p class="text-slate-600 text-xs sm:text-sm leading-relaxed"><strong>Per Boot</strong> aus Sorrent, Positano oder von Capri. So kommen im Sommer die meisten Gäste, und mehrere Restaurants haben eigene Anlegestellen.</p>
        </div>
      </div>
    </div>
  </div>

  <!-- The technique -->
  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">Was sie von gewöhnlicher Zucchini-Pasta unterscheidet</h2>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      Die Zutatenliste ist fast peinlich kurz, also hängt alles an der Methode. Zwei Schritte trennen das Echte von einem Teller Nudeln mit Zucchini.
    </p>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      Erstens werden die Zucchini <strong>separat gebraten und ruhen gelassen</strong>, oft stundenlang. Sie fallen zusammen und werden süßer, statt in der Pfanne zu dünsten, und das Öl, das sie abgeben, trägt ihren Geschmack in die fertige Sauce. Zweitens wird die Sauce abseits der Hitze vollendet: geriebener Käse, traditionell <strong>Provolone del Monaco g.U.</strong> von der Halbinsel oder eine lokale Caciotta, wird mit stärkehaltigem Nudelwasser emulgiert, bis er überzieht statt sich abzusetzen.
    </p>

    <blockquote class="border-l-4 border-med-gold pl-6 my-8">
      <p class="text-slate-700 text-xl font-serif italic leading-relaxed">
        "In den Spaghetti alla Nerano steckt keine Sahne. Was wie Sahne aussieht, ist Käse, Wasser und Geduld."
      </p>
    </blockquote>
  </div>

  <!-- Local Tips -->
  <div class="bg-white p-8 rounded-[2rem] shadow-xl border border-slate-100">
    <div class="flex items-center gap-4 mb-6">
      <svg class="w-6 h-6 text-med-gold flex-shrink-0" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M9 18h6"/><path d="M10 22h4"/><path d="M15.09 14c.18-.98.65-1.74 1.41-2.5A4.65 4.65 0 0 0 18 8 6 6 0 0 0 6 8c0 1 .23 2.23 1.5 3.5A4.61 4.61 0 0 1 8.91 14"/></svg>
      <h3 class="text-xl font-bold">Expertentipps</h3>
    </div>
    <div class="space-y-6">
      <div>
        <p class="font-bold text-slate-900 mb-1">Reservieren Sie vor der Reise, nicht bei der Ankunft</p>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Die Marina del Cantone hat nur eine Handvoll Restaurants und empfängt Gäste von der Straße und vom Meer zugleich. Im Juli und August sind Mittagstische in den beiden historischen Häusern Monate im Voraus vergeben.</p>
      </div>
      <div>
        <p class="font-bold text-slate-900 mb-1">Kommen Sie zur Zucchini-Saison</p>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Das Gericht hängt vollständig von der Qualität des Gemüses ab und ist daher von Juni bis September am besten. Außerhalb der Saison bekommen Sie es auch, aber mit Ware, die nicht auf der Landzunge gewachsen ist.</p>
      </div>
      <div>
        <p class="font-bold text-slate-900 mb-1">Machen Sie einen ganzen Tag daraus</p>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Das Mittagessen verbindet sich natürlich mit einem Bad. <a href="/de-de/blog/baia-recommone/" class="text-med-blue hover:underline">Baia di Recommone</a> ist die nächste Bucht, und der Weg zur Baia di Ieranto beginnt am Platz von Nerano und führt hinaus Richtung <a href="/de-de/blog/punta-campanella/" class="text-med-blue hover:underline">Punta Campanella</a>, mit Capri die ganze Zeit vor Augen.</p>
      </div>
    </div>
  </div>

</BlogPostLayout>
