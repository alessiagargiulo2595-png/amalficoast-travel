---
import BlogPostLayout from '../../../../layouts/BlogPostLayout.astro';

const lang = 'de-de';
const post = {
  title: 'Wetter Amalfiküste Juli und August 2026',
  subtitle: 'Positano und Amalfi im Sommer: Temperaturen, Relief, Survival-Kit und drei Wetter-Hacks, um cool zu bleiben',
  category: 'REISEFÜHRER',
  date: '6. Juli 2026',
  readTime: '8 Min.',
  image: '/images/meteo-costiera-luglio-agosto-hero.webp',
  imageAlt: 'Panoramablick auf Positano an der Amalfiküste im Sommer',
  path: '/de-de/blog/wetter-juli-august-2026/',
};

const metaTitle = 'Wetter Amalfiküste Juli August 2026 | Positano und Amalfi';
const metaDescription = "Juli 31°C, August 32°C mit 66% Luftfeuchtigkeit. Wie das Mikroklima der Küste funktioniert, welche Strände ab 15:30 Uhr im Schatten liegen, was in den Koffer gehört und 3 Wetter-Hacks für Positano und Amalfi.";

const breadcrumbs = [
  { name: 'Startseite', url: '/de-de/' },
  { name: 'Blog', url: '/de-de/blog/' },
  { name: 'Wetter Juli und August 2026', url: '/de-de/blog/wetter-juli-august-2026/' },
];

const quickInfo = [
  { label: 'Höchsttemperatur Juli', value: '31°C (Spitzen 34°C)' },
  { label: 'Höchsttemperatur August', value: '32°C (Luftfeuchte 66%)' },
  { label: 'Nachttiefstwerte', value: '22-23°C' },
  { label: 'Meerestemperatur', value: '25°C Jul, 27°C Aug' },
  { label: 'Sonnenstunden', value: '10-11 pro Tag' },
  { label: 'UV-Index', value: '9-10 (sehr hoch)' },
  { label: 'Regenrisiko', value: 'Seltene Wärmegewitter Ende August' },
  { label: 'Lokaler Wind', value: '"Faugn", warme Abendbrise' },
];

const faq = [
  {
    q: 'Ist es an der Amalfiküste im Juli oder im August heißer?',
    a: "Im August. Juli hat einen Durchschnitt von 31°C mit trockenerer Luft, während August sich bei 32-33°C mit 66-70% Luftfeuchtigkeit einpendelt und das Kalkgestein seit Wochen Wärme speichert. Das Hitzegefühl, besonders in den engen Gassen von Amalfi und Atrani, ist im August spürbar höher.",
  },
  {
    q: 'Um wie viel Uhr liegt der Strand von Amalfi im Schatten?',
    a: "Die Strände von Amalfi, Atrani und Minori sind nach Südosten ausgerichtet: die Sonne verschwindet im Hochsommer gegen 15:30-16:00 Uhr hinter dem Berg. Ideal für eine Abkühlung am Nachmittag, weniger schön, wenn Sie bis zum Sonnenuntergang in der Sonne bleiben wollen. In diesem Fall lohnt sich der Wechsel nach Positano oder Praiano (Gavitella), die bis 19:30-20:00 Uhr beleuchtet bleiben.",
  },
  {
    q: 'Brauche ich wirklich Sonnencreme LSF 50, auch wenn ich schnell braun werde?',
    a: "Ja, immer. Der UV-Index erreicht im Juli und August 9-10, und die weißen Kalkfelsen reflektieren das Licht wie ein Spiegel. Die Reflexion ist aggressiver als an einem durchschnittlichen italienischen Strand: LSF 50, ein breitkrempiger Hut und polarisierte Sonnenbrille sind die drei Verbündeten, die den ersten Tag retten.",
  },
  {
    q: 'Wann ist das Meer wärmer, im Juli oder im August?',
    a: "Im August. Im Juli schwankt das Wasser um 25°C, perfekt für lange Bäder. Im August erreicht es seinen Höhepunkt bei 27°C, praktisch ein beheiztes Schwimmbecken, mit außergewöhnlicher Sichtweite unter Wasser an windstillen Tagen.",
  },
  {
    q: 'Regnet es im August an der Amalfiküste?',
    a: "Sehr selten. Im August zählt man durchschnittlich 3 Tage mit Niederschlag, fast immer Wärmegewitter am späten Nachmittag, die 20-30 Minuten dauern, die Luft abkühlen und danach spektakuläre Himmel hinterlassen. Sie ruinieren selten einen ganzen Tag, aber ab 17:00 Uhr sollte man das Radar im Blick behalten.",
  },
  {
    q: 'Wie kleide ich mich an der Küste im Hochsommer?',
    a: "Natürliche, leichte Stoffe: Leinen, Baumwolle, Seide. Vermeiden Sie Synthetik, die das Schwitzen verstärkt. Zum Laufen tragen Sie Sandalen mit Gummisohle oder Segeltuchschuhe mit gutem Grip: die Kalksteinstufen und Pflasterwege in Positano werden durch die Mischung aus Hitze und Salz rutschig. Lassen Sie die Absätze im Hotel.",
  },
  {
    q: 'Bewegt man sich zwischen Juli und August besser mit Bus oder Fähre?',
    a: "Fähre, ohne Frage. Der SITA-Bus zwischen 11:00 und 15:00 Uhr im Hochsommer bedeutet Warten unter der brennenden Sonne im stehenden Verkehr. Die Travelmar-Fähren kosten mehr, aber die Meeresbrise macht die Fahrt zu einer belüfteten Panorama-Rundfahrt. Die Strecke Salerno-Amalfi-Positano dauert etwa 60-70 Minuten.",
  },
  {
    q: "Was ist der 'Faugn' der Amalfiküste?",
    a: "Es ist der lokale Name einer warmen, trockenen Brise, die nachts von den Bergen herunterweht, typisch für Sommerabende. Manchmal spürt man um 23:00 Uhr einen plötzlichen warmen Windstoß, vor allem auf Bootstouren im Mondschein oder auf den höchsten Terrassen. Packen Sie für abendliche Ausflüge auf dem Meer immer ein leichtes langärmeliges Hemd ein.",
  },
  {
    q: 'Ist Ravello wirklich kühler als die Küste?',
    a: "Ja. Auf 365 Metern Höhe gelegen, verzeichnet Ravello konstant 3-4°C weniger als Amalfi oder Positano, mit einer trockenen Brise, die neue Energie spendet. Es ist die perfekte Auszeit von der Hitze am Strand, besonders an den schwülsten Tagen Ende August.",
  },
  {
    q: 'Welcher Strand an der Amalfiküste bekommt am meisten Sonne?',
    a: "Die Gavitella in Praiano. Nach Westen ausgerichtet, erhält sie direktes Licht bis 19:30-20:00 Uhr und sieht die Sonne direkt im Meer vor Capri untergehen: es ist der einzige Strand der Küste, an dem man im Badeanzug einen Aperitif nehmen kann, während die Sonne am Meereshorizont versinkt.",
  },
];

const sidebarLinks = [
  { label: 'Positano', href: '/de-de/amalfikueste/positano/' },
  { label: 'Amalfi', href: '/de-de/amalfikueste/amalfi/' },
  { label: 'Praiano', href: '/de-de/amalfikueste/praiano/' },
  { label: 'Ravello', href: '/de-de/amalfikueste/ravello/' },
  { label: 'Strände der Amalfiküste', href: '/de-de/strande/' },
];

const authorRole = 'Lokale Redaktion · Amalfiküste';

const relatedArticles = [
  {
    title: 'Goldene Stunde Sonnenuntergänge',
    category: 'ENTDECKUNGEN',
    date: '2. Mai 2026',
    image: '/images/tramonto-costiera.webp',
    imageAlt: 'Sonnenuntergang am Strand der Amalfiküste',
    path: '/de-de/blog/sonnenuntergang-strande/'
  },
  {
    title: 'Komfortable und ausgestattete Strände',
    category: 'REISEFÜHRER',
    date: '18. April 2026',
    image: '/images/spiagge-bambini.webp',
    imageAlt: 'Komfortable ausgestattete Strände der Amalfiküste',
    path: '/de-de/blog/komfortable-ausgestattete-strande/'
  }
];

const keyTakeaways = [
  "Juli bringt 31°C im Schnitt mit trockener Luft und Meer bei 25°C: der perfekte Monat zum Bräunen. August steigt auf 32-33°C mit 66-70% Luftfeuchte und Meer bei 27°C.",
  "Die Strände von Amalfi, Atrani und Minori liegen zwischen 15:30 und 16:00 Uhr im Schatten; Positano, Praiano und die Gavitella bleiben bis zum Abend besonnt.",
  "Ravello auf 365 Metern Höhe ist stets 3-4°C kühler als die Küste: die regenerierende Flucht vor schwülen Tagen.",
  "Ende August bringt seltene Wärmegewitter am späten Nachmittag: 20-30 Minuten, die die Luft abkühlen und spektakuläre Himmel hinterlassen.",
  "In der Hochsaison schlagen die Travelmar-Fähren die SITA-Busse an allen Fronten: schneller, belüftet und ohne Wartezeit in der prallen Sonne.",
];
---

<BlogPostLayout
  lang={lang}
  post={post}
  metaTitle={metaTitle}
  metaDescription={metaDescription}
  breadcrumbs={breadcrumbs}
  quickInfo={quickInfo}
  faq={faq}
  sidebarLinks={sidebarLinks}
  authorRole={authorRole}
  relatedArticles={relatedArticles}
  pageKey="wetter-juli-august-2026"
>

  <!-- Key Takeaways -->
  <div class="bg-slate-900 text-white p-8 rounded-[2rem]">
    <h2 class="font-serif text-lg font-bold text-med-gold uppercase tracking-[0.15em] mb-6">Key Takeaways</h2>
    <ul class="space-y-4">
      {keyTakeaways.map((point) => (
        <li class="flex items-start gap-3">
          <span class="w-1.5 h-1.5 rounded-full bg-med-gold flex-shrink-0 mt-2"></span>
          <span class="text-white/80 text-xs sm:text-sm leading-relaxed">{point}</span>
        </li>
      ))}
    </ul>
  </div>

  <!-- Intro -->
  <div>
    <p class="text-slate-600 text-xl leading-relaxed mb-6 font-light">
      Genau in diesem Moment läuft der Sommer 2026 auf Hochtouren, und <a href="/de-de/amalfikueste/positano/" class="text-med-blue hover:underline">Positano</a> und <a href="/de-de/amalfikueste/amalfi/" class="text-med-blue hover:underline">Amalfi</a> sind buchstäblich der Mittelpunkt der Welt. Juli und August bedeuten kristallklares Wasser, endlose Sonnenuntergänge und die legendäre Dolce Vita. Sie bedeuten aber auch: heiße Temperaturen, brennende Sonne und eine anspruchsvolle Logistik.
    </p>
    <p class="text-slate-600 text-lg leading-relaxed">
      Die <a href="/de-de/amalfikueste/" class="text-med-blue hover:underline">Küste</a> hat ein einzigartiges Mikroklima: Die Lattari-Berge blockieren die Nordwinde und bilden eine Wärmebarriere, während sich das Meer in einen beheizten Pool verwandelt. So deuten Sie das Wetter richtig und planen Ihre Tage so, dass Sie die größte Hitze umgehen und die Reise Ihres Lebens erleben.
    </p>
  </div>

  <!-- Temperatur-Bericht -->
  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">Der Temperatur-Bericht: Was Sie Wirklich Erwartet</h2>
    <p class="text-slate-600 text-lg leading-relaxed mb-8">
      Machen wir uns nichts vor: in diesen beiden Monaten ist es heiß. Aber Hitze ist nicht gleich Hitze, und die zwei Monate haben sehr unterschiedliche Charaktere.
    </p>

    <div class="bg-white p-8 rounded-[2rem] border border-slate-100 shadow-sm mb-6">
      <p class="text-med-gold text-xs font-medium uppercase tracking-[0.25em] mb-3">Juli</p>
      <h3 class="font-serif text-2xl font-bold text-slate-900 mb-4">Pralle Sonne und Trockene Hitze</h3>
      <p class="text-slate-600 text-lg leading-relaxed mb-5">
        Der perfekte Monat für Sonnenanbeter. Die Tage bieten bis zu 15 Stunden Tageslicht und die Luftfeuchtigkeit bleibt moderat.
      </p>
      <ul class="space-y-4">
        <li class="flex items-start gap-3">
          <span class="w-1.5 h-1.5 rounded-full bg-med-gold flex-shrink-0 mt-2"></span>
          <span class="text-slate-600 text-xs sm:text-sm leading-relaxed"><strong>Die Temperaturen.</strong> Tagsüber liegt der Durchschnitt bei 31°C, bei afrikanischen Hitzewellen werden schnell 34°C erreicht.</span>
        </li>
        <li class="flex items-start gap-3">
          <span class="w-1.5 h-1.5 rounded-full bg-med-gold flex-shrink-0 mt-2"></span>
          <span class="text-slate-600 text-xs sm:text-sm leading-relaxed"><strong>Am Abend.</strong> Es kühlt auf angenehme 22°C ab. Die Meeresbrise sorgt für genau die richtige Abkühlung, um perfekt draußen zu essen.</span>
        </li>
        <li class="flex items-start gap-3">
          <span class="w-1.5 h-1.5 rounded-full bg-med-gold flex-shrink-0 mt-2"></span>
          <span class="text-slate-600 text-xs sm:text-sm leading-relaxed"><strong>Das Meer.</strong> Traumhaftes Wasser bei 25°C. Ideal, um stundenlang zu treiben, ohne beim Verlassen des Wassers zu frieren.</span>
        </li>
      </ul>
    </div>

    <div class="bg-white p-8 rounded-[2rem] border border-slate-100 shadow-sm">
      <p class="text-med-gold text-xs font-medium uppercase tracking-[0.25em] mb-3">August</p>
      <h3 class="font-serif text-2xl font-bold text-slate-900 mb-4">Der Hitze- und Feuchtigkeits-Peak</h3>
      <p class="text-slate-600 text-lg leading-relaxed mb-5">
        Im August macht sich die von den Kalkfelsen gespeicherte Hitze deutlich bemerkbar, und die Luftfeuchtigkeit steigt auf 65-70%.
      </p>
      <ul class="space-y-4">
        <li class="flex items-start gap-3">
          <span class="w-1.5 h-1.5 rounded-full bg-med-gold flex-shrink-0 mt-2"></span>
          <span class="text-slate-600 text-xs sm:text-sm leading-relaxed"><strong>Die Temperaturen.</strong> Das Thermometer pendelt sich bei 32-33°C ein, aber die Schwüle lässt es deutlich heißer wirken, besonders in den engen Gassen.</span>
        </li>
        <li class="flex items-start gap-3">
          <span class="w-1.5 h-1.5 rounded-full bg-med-gold flex-shrink-0 mt-2"></span>
          <span class="text-slate-600 text-xs sm:text-sm leading-relaxed"><strong>Sommergewitter.</strong> Ende August trifft die kochende Luft auf das warme Meer. Das Ergebnis? Kurze, aber heftige Wärmegewitter am späten Nachmittag. Sie dauern 20 Minuten, kühlen die Luft ab und hinterlassen spektakuläre Himmel.</span>
        </li>
        <li class="flex items-start gap-3">
          <span class="w-1.5 h-1.5 rounded-full bg-med-gold flex-shrink-0 mt-2"></span>
          <span class="text-slate-600 text-xs sm:text-sm leading-relaxed"><strong>Das Meer.</strong> Erreicht seinen Jahreshöchstwert bei 27°C. Wie ein Thermalbad, in dem man das Zeitgefühl verliert.</span>
        </li>
      </ul>
    </div>
  </div>

  <!-- Schatten-Falle -->
  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">Die Schatten-Falle: Warum die Landschaft Ihre Pläne Durchkreuzt</h2>
    <p class="text-slate-600 text-lg leading-relaxed mb-8">
      Das ist der klassische Anfängerfehler, der Strandtage ruiniert. Die Berge der Küste fallen steil ins Meer ab und blockieren das Sonnenlicht früher, als man denkt. Jeder Küstenabschnitt hat seinen eigenen Schattenzeitplan.
    </p>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
      <div class="bg-white p-6 rounded-[2rem] border border-slate-100 shadow-sm">
        <p class="text-med-gold text-xs font-medium uppercase tracking-[0.2em] mb-2">Amalfi · Atrani · Minori</p>
        <h4 class="font-bold text-slate-900 mb-2 text-lg">Sonne am Morgen, Schatten ab 15:30 Uhr</h4>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Diese Strände sind nach Südosten ausgerichtet. Das bedeutet herrliche Sonne am Morgen, aber gegen 15:30-16:00 Uhr verschwindet die Sonne hinter dem Berg und der Strand liegt im Schatten. Super, wenn Sie die Hitze meiden; fatal, wenn Sie den Aperitif in der Sonne genießen wollen.</p>
      </div>
      <div class="bg-white p-6 rounded-[2rem] border border-slate-100 shadow-sm">
        <p class="text-med-gold text-xs font-medium uppercase tracking-[0.2em] mb-2">Positano · Praiano</p>
        <h4 class="font-bold text-slate-900 mb-2 text-lg">Sonne bis zum Abend, das Gavitella-Paradies</h4>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Hier sind Sie auf der gegenüberliegenden Seite. Die Sonne verwöhnt die Küste bis spät in den Tag. In Praiano, genauer gesagt am Gavitella-Strand, gibt es die längste Sonne der Küste: Sie können bis 20:00 Uhr im Badeanzug bleiben und sehen, wie die Sonne hinter Capri direkt im Meer versinkt.</p>
      </div>
      <div class="bg-white p-6 rounded-[2rem] border border-slate-100 shadow-sm">
        <p class="text-med-gold text-xs font-medium uppercase tracking-[0.2em] mb-2">Ravello</p>
        <h4 class="font-bold text-slate-900 mb-2 text-lg">Wenn Sie keine Luft bekommen, steigen Sie</h4>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Auf 365 Metern Höhe gelegen, ist <a href="/de-de/amalfikueste/ravello/" class="text-med-blue hover:underline">Ravello</a> stets 3 bis 4°C kühler als der Strand, mit einer trockenen Brise, die Ihre Lungen rettet. Die regenerierende Flucht vor schwülen Tagen.</p>
      </div>
    </div>
  </div>

  <!-- Koffer & Survival Kit -->
  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">Koffer und Survival-Kit für die Küste</h2>
    <p class="text-slate-600 text-lg leading-relaxed mb-8">
      Die Küste im August zu erkunden, hat nichts von einem flachen Spaziergang in Miami. Es ist ein vertikales Workout, und jede Kleiderwahl zählt.
    </p>

    <div class="bg-white p-8 rounded-[2rem] border border-slate-100 shadow-sm">
      <div class="space-y-6">
        <div>
          <p class="font-bold text-slate-900 mb-2 text-lg">Das Schuh-Drama</p>
          <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Lassen Sie Absätze im Hotel und vergessen Sie billige Plastik-Flip-Flops zum Gehen. Die Kalksteinstufen und Lavasteinpflaster (besonders in Positano) werden durch die Kombi aus Hitze und Salz spiegelglatt. Tragen Sie flache Sandalen mit Gummisohle oder Segeltuchschuhe mit gutem Grip.</p>
        </div>
        <div class="border-t border-slate-100 pt-6">
          <p class="font-bold text-slate-900 mb-2 text-lg">Leinen, Leinen, Leinen</p>
          <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Synthetikstoffe lassen Sie doppelt so viel schwitzen. Wählen Sie weite Hemden, Kleider und Hosen aus Leinen oder leichter Baumwolle. Seide ist ideal für den Abend. Vermeiden Sie enge Jeans und figurbetonte Polos: die Küste lebt von entspannter Eleganz, nicht von einengender Kleidung.</p>
        </div>
        <div class="border-t border-slate-100 pt-6">
          <p class="font-bold text-slate-900 mb-2 text-lg">Die brutale Reflexion</p>
          <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Die weißen Felsen der Küste reflektieren das Licht wie ein Spiegel. Der UV-Index erreicht gefährliche 9 oder 10. Polarisierte Sonnenbrille, breitkrempiger Hut und Sonnencreme mit LSF 50 sind Pflicht, wenn Sie am ersten Tag nicht wie ein Krebs enden wollen.</p>
        </div>
      </div>
    </div>
  </div>

  <!-- 3 Wetter-Hacks -->
  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">Die 3 Wetter-Hacks vom Experten, um Cool zu Bleiben</h2>
    <p class="text-slate-600 text-lg leading-relaxed mb-8">
      Drei Locals-Tricks, die den Unterschied machen zwischen einem überstandenen und einem wirklich gelebten Urlaub.
    </p>

    <div class="space-y-4">
      <div class="bg-white p-6 rounded-[2rem] border border-slate-100 shadow-sm">
        <div class="flex items-start gap-4">
          <div class="w-8 h-8 rounded-full bg-med-gold/15 flex-shrink-0 flex items-center justify-center text-med-gold font-serif font-bold">1</div>
          <div>
            <h4 class="font-bold text-slate-900 mb-2 text-lg">Meiden Sie Busse zu den Stoßzeiten</h4>
            <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Den <a href="/de-de/ratgeber/sita-bus/" class="text-med-blue hover:underline">SITA-Bus</a> zwischen 11:00 und 15:00 Uhr im August zu nehmen, ist Extremsport. Warten in der prallen Sonne und brutaler Stau. Nutzen Sie die <a href="/de-de/ratgeber/faehren/" class="text-med-blue hover:underline">Travelmar-Fähren</a>. Sie kosten mehr, aber die Meeresbrise macht die Fahrt zu einer erfrischenden Panorama-Minikreuzfahrt.</p>
          </div>
        </div>
      </div>
      <div class="bg-white p-6 rounded-[2rem] border border-slate-100 shadow-sm">
        <div class="flex items-start gap-4">
          <div class="w-8 h-8 rounded-full bg-med-gold/15 flex-shrink-0 flex items-center justify-center text-med-gold font-serif font-bold">2</div>
          <div>
            <h4 class="font-bold text-slate-900 mb-2 text-lg">Der abendliche "Faugn"</h4>
            <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">So nennen die Einheimischen die warme Brise, die nachts von den Bergen weht. Manchmal kommt um 23:00 Uhr ein plötzlicher heißer, trockener Windstoß auf. Denken Sie bei Bootstouren im Mondschein daran: Packen Sie immer ein leichtes, langärmeliges Hemd ein.</p>
          </div>
        </div>
      </div>
      <div class="bg-white p-6 rounded-[2rem] border border-slate-100 shadow-sm">
        <div class="flex items-start gap-4">
          <div class="w-8 h-8 rounded-full bg-med-gold/15 flex-shrink-0 flex items-center justify-center text-med-gold font-serif font-bold">3</div>
          <div>
            <h4 class="font-bold text-slate-900 mb-2 text-lg">Taktische Granita</h4>
            <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Wenn Sie die Hitze erschlägt, suchen Sie die Stände am Straßenrand, die frische Granita aus echten Amalfi-Sfusato-Zitronen g.g.A. machen. Das ist kein Instagram-Klischee, sondern das einzige echte lokale Mittel, um den Kreislauf zu pushen und der Dehydrierung durch die vielen Stufen entgegenzuwirken.</p>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Sommer in Zahlen -->
  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">Der Sommer in Zahlen</h2>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      Für Datenliebhaber hier die saubere Zusammenfassung von Juli und August 2026 an der Amalfiküste.
    </p>

    <div class="overflow-hidden rounded-[2rem] border border-slate-100 shadow-sm">
      <table class="w-full text-xs sm:text-sm">
        <thead class="bg-slate-900 text-white">
          <tr>
            <th class="text-left p-5 font-serif font-bold text-med-gold">Wetter-Indikator</th>
            <th class="text-left p-5 font-serif font-bold text-med-gold">Juli</th>
            <th class="text-left p-5 font-serif font-bold text-med-gold">August</th>
          </tr>
        </thead>
        <tbody class="bg-white">
          <tr class="border-b border-slate-100">
            <td class="p-5 font-bold">Durchschnittliche Tageshöchsttemperatur</td>
            <td class="p-5 text-slate-600">31°C</td>
            <td class="p-5 text-slate-600">32°C</td>
          </tr>
          <tr class="border-b border-slate-100">
            <td class="p-5 font-bold">Durchschnittliche Nachttiefsttemperatur</td>
            <td class="p-5 text-slate-600">22°C</td>
            <td class="p-5 text-slate-600">23°C</td>
          </tr>
          <tr class="border-b border-slate-100">
