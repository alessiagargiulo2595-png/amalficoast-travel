---
import BlogPostLayout from '../../../../layouts/BlogPostLayout.astro';

const lang = 'de-de';
const post = {
  title: 'Krippen in Neapel und Sorrent: Ein Ratgeber für Dezember',
  subtitle: "Via San Gregorio Armeno, die Krippen in den Kirchen von Sorrent und die lebenden Krippen der Sorrentinischen Halbinsel, mit den Terminen der letzten Ausgabe",
  category: 'REISEFÜHRER',
  date: '10. November 2026',
  readTime: '11 Min.',
  image: '/images/presepe-natale-hero.webp',
  imageAlt: "Krippe mit Maria, Josef, dem Jesuskind, Ochs, Esel und Schafen",
  path: '/de-de/blog/krippen-neapel-sorrent/',
};

const metaTitle = 'Krippen in Neapel und Sorrent: Ratgeber Dezember';
const metaDescription = "Die Via San Gregorio Armeno in Neapel und die lebenden Krippen der Sorrentinischen Halbinsel: Orte, Termine und Zeiten der letzten Ausgabe, Anreise ab Sorrent.";

const breadcrumbs = [
  { name: 'Home', url: '/de-de/' },
  { name: 'Blog', url: '/de-de/blog/' },
  { name: 'Krippen in Neapel und Sorrent', url: '/de-de/blog/krippen-neapel-sorrent/' },
];

const quickInfo = [
  { label: 'Neapel', value: 'Via San Gregorio Armeno, ganzjährig geöffnet' },
  { label: 'Hochsaison', value: 'Ende November bis Anfang Januar' },
  { label: 'Ab Sorrent', value: 'Circumvesuviana, etwa 1 Std. bis Neapel' },
  { label: 'Sorrent (2025)', value: 'Lebende Krippe in der Altstadt, 28. bis 30. Dez.' },
  { label: 'Vico Equense (2025/26)', value: 'Fornacelle, 26. Dez. bis 6. Jan.' },
  { label: 'Massa Lubrense (2025/26)', value: 'Monticchio, 27. Dez. bis 6. Jan.' },
  { label: 'Eintritt', value: 'Frei für die hier genannten lebenden Krippen' },
  { label: 'Programme 2026', value: 'Von den Gemeinden im Dezember veröffentlicht' },
];

const faq = [
  {
    q: 'Wann besucht man die Via San Gregorio Armeno am besten?',
    a: 'Die Werkstätten haben das ganze Jahr geöffnet, am vollsten ist die Straße aber von Ende November bis Anfang Januar. Wer die Figuren in Ruhe ansehen will, kommt an einem Werktag am Vormittag. Die Wochenenden im Dezember und die Tage um den 8. Dezember sind am stärksten besucht, und 2025 hat die Stadt an diesen Tagen eine Einbahnregelung für Fußgänger eingeführt.',
  },
  {
    q: 'Wie komme ich von Sorrent zur San Gregorio Armeno?',
    a: 'Mit der Circumvesuviana von Sorrent nach Napoli Garibaldi, etwa eine Stunde. Von dort mit der Metro-Linie 1 eine Station bis Duomo und zu Fuß die Via Duomo hinauf, oder den ganzen Weg über den Corso Umberto I und die Via Duomo in rund fünfundzwanzig Minuten zu Fuß. Die Straße verbindet die Via San Biagio dei Librai mit der Via dei Tribunali.',
  },
  {
    q: 'Was kosten die Figuren?',
    a: 'Das hängt ganz von Größe, Material und Werkstatt ab. In einem Bericht von 2019 nannten Ladenbesitzer der Straße zwanzig bis dreißig Euro für eine mittelgroße Figur. Handgearbeitete Stücke mit Seidengewändern aus den alteingesessenen Werkstätten kosten deutlich mehr. Das sind Richtwerte: Fragen Sie im Laden.',
  },
  {
    q: 'Wo gibt es lebende Krippen auf der Sorrentinischen Halbinsel?',
    a: 'In der Saison 2025/26 waren es drei: in den Hauseingängen der Altstadt von Sorrent (28. bis 30. Dezember), in Fornacelle oberhalb von Vico Equense (26. Dezember bis 6. Januar) und im Kloster von Monticchio, einem Ortsteil von Massa Lubrense (27. Dezember bis 6. Januar). Piano di Sorrento und Sant\'Agnello hatten Kunst- und bewegliche Krippen, keine lebenden.',
  },
  {
    q: 'Stehen die Termine für 2026 schon fest?',
    a: 'Stand Mitte Oktober 2026 noch nicht. Gemeinden und Pfarreien veröffentlichen ihre Weihnachtsprogramme Ende November oder im Dezember. Die Termine in diesem Ratgeber stammen aus der Ausgabe 2025/26 und zeigen das Muster zuverlässig: Fast alles findet zwischen dem 26. Dezember und dem 6. Januar statt.',
  },
  {
    q: 'Kostet der Besuch der lebenden Krippen Eintritt?',
    a: 'Die Krippe von Fornacelle ist kostenlos, Spenden sind willkommen, und die Ausgabe 2025 in Sorrent stand auf der Liste der kostenlosen Veranstaltungen der Stadt. Das Programm von Monticchio nannte keine Eintrittskarte. Etwas Bargeld für Spenden sollten Sie trotzdem dabeihaben.',
  },
];

const sidebarLinks = [
  { label: 'Sorrent', href: '/de-de/sorrentinische-halbinsel/sorrent/' },
  { label: 'Vico Equense', href: '/de-de/sorrentinische-halbinsel/vico-equense/' },
  { label: 'Massa Lubrense', href: '/de-de/sorrentinische-halbinsel/massa-lubrense/' },
  { label: 'Sant\'Agnello', href: '/de-de/sorrentinische-halbinsel/sant-agnello/' },
  { label: 'Lebende Krippen an der Amalfiküste', href: '/de-de/veranstaltungen/amalfikueste/presepi-viventi-costiera/' },
  { label: "M'illumino d'Inverno", href: '/de-de/veranstaltungen/sorrentinische-halbinsel/millumino-inverno-sorrento/' },
];

const authorRole = 'Lokaler Experte · Amalfiküste';

const relatedArticles = [
  {
    title: 'Weihnachtsbeleuchtung in Sorrent und Salerno',
    category: 'REISEFÜHRER',
    date: '21. Oktober 2026',
    image: '/images/luci-artista-salerno-hero.webp',
    imageAlt: 'Weihnachtsbeleuchtung in Sorrent und Salerno',
    path: '/de-de/blog/weihnachtsbeleuchtung-sorrent-salerno/'
  },
  {
    title: 'Die Amalfiküste mit dem Zug',
    category: 'REISEFÜHRER',
    date: '10. August 2026',
    image: '/images/treno-costiera-hero.webp',
    imageAlt: 'Die Amalfiküste mit dem Zug',
    path: '/de-de/blog/amalfikueste-mit-dem-zug/'
  }
];


const keyTakeaways = [
  'Die Via San Gregorio Armeno in Neapel ist die Straße der Krippenwerkstätten: ganzjährig geöffnet, am vollsten von Ende November bis Anfang Januar und eine Stunde von Sorrent entfernt mit der Circumvesuviana.',
  '2025 machte Neapel die Straße an den Dezemberwochenenden und über den Feiertag am 8. Dezember von 9:00 bis 20:00 Uhr zur Einbahnstraße für Fußgänger. Die beste Zeit sind Vormittage unter der Woche.',
  'Auf der Sorrentinischen Halbinsel konzentrieren sich die lebenden Krippen auf die Zeit vom 26. Dezember bis 6. Januar: die Altstadt von Sorrent, Fornacelle oberhalb von Vico Equense und das Kloster von Monticchio in Massa Lubrense.',
  'Die Programme für 2026 sind noch nicht erschienen. Alle Termine hier stammen aus der Ausgabe 2025/26 und sind entsprechend gekennzeichnet.',
  'Die lebenden Krippen auf der Seite der Amalfiküste (Agerola, Albori, Pontone, Furore) behandelt ein eigener Ratgeber.',
];
---

<BlogPostLayout
  lang={lang}
  post={post}
  metaTitle={metaTitle}
  metaDescription={metaDescription}
  breadcrumbs={breadcrumbs}
  quickInfo={quickInfo}
  faq={faq}
  sidebarLinks={sidebarLinks}
  authorRole={authorRole}
  relatedArticles={relatedArticles}
  pageKey="nativity-scenes-naples-sorrento"
>

  <!-- Key Takeaways -->
  <div class="bg-slate-900 text-white p-8 rounded-[2rem]">
    <div class="flex items-center gap-3 mb-6">
      <svg class="w-5 h-5 text-med-gold flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
      <h2 class="font-serif text-lg font-bold text-med-gold uppercase tracking-[0.15em]">Key Takeaways</h2>
    </div>
    <ul class="space-y-4">
      {keyTakeaways.map((point) => (
        <li class="flex items-start gap-3">
          <span class="w-1.5 h-1.5 rounded-full bg-med-gold flex-shrink-0 mt-2"></span>
          <span class="text-white/80 text-xs sm:text-sm leading-relaxed">{point}</span>
        </li>
      ))}
    </ul>
  </div>

  <!-- Intro -->
  <div>
    <p class="text-slate-600 text-xl leading-relaxed mb-6 font-light">
      Rund um Neapel nimmt man den Presepe, die Weihnachtskrippe, ernst. Familien bauen jedes Jahr eine zu Hause auf, die Pfarreien wetteifern mit ihren, und in den Tagen zwischen Weihnachten und Dreikönig verwandeln sich ganze Ortsteile in Bethlehem. Für eine Dezemberreise mit Standort <a href="/de-de/sorrentinische-halbinsel/sorrent/" class="text-med-blue hover:underline">Sorrent</a> heißt das: ein Tag in Neapel in der Straße, in der die Figuren entstehen, und die Abende, an denen die Orte der Halbinsel ihre lebenden Krippen aufführen. Die Programme für 2026 sind noch nicht veröffentlicht, deshalb stammen die folgenden Termine aus der letzten Ausgabe, 2025/26, und sind so gekennzeichnet.
    </p>
  </div>

  <!-- San Gregorio Armeno -->
  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">Via San Gregorio Armeno, Neapel</h2>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      San Gregorio Armeno ist eine schmale Fußgängerstraße von etwa 200 Metern in der Altstadt von Neapel, die seit 1995 zum UNESCO-Welterbe gehört. Sie steigt von der Via San Biagio dei Librai, dem Abschnitt von Spaccanapoli, hinauf zur Piazza San Gaetano und zur Via dei Tribunali. Auf beiden Seiten reihen sich Werkstätten, die Krippenfiguren herstellen und verkaufen, und im Dezember reicht die Ware bis an Mauern und Türrahmen.
    </p>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      Hier gibt es alles, was eine Krippe braucht: die Hirten, die Heilige Familie und die Heiligen Drei Könige, aber auch Marktleute, die Taverne, den Fischhändler, Körbe mit Brot und Obst, fließendes Wasser und Beleuchtung. Neben den traditionellen Stücken fertigen viele Läden Figuren von Fußballern, Politikern und Prominenten des Jahres, und genau die fotografieren die meisten Besucher. Mehrere Werkstätten sind seit Generationen in derselben Familie: Die Brüder Capuano arbeiten seit 1840, und Namen wie Di Virgilio und Ferrigno stehen für Figuren mit Stoffgewändern, auch aus Seide von San Leucio.
    </p>
    <p class="text-slate-600 text-lg leading-relaxed mb-8">
      Auf halber Höhe stehen Kirche und Kloster San Gregorio Armeno, der Komplex, der der Straße ihren Namen gibt, mit barockem Innenraum und Fresken von Luca Giordano. Der Kreuzgang ist vormittags gegen ein kleines Eintrittsgeld geöffnet.
    </p>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-8">
      <div class="bg-white p-6 rounded-[2rem] border border-slate-100 shadow-sm">
        <h4 class="font-bold text-slate-900 mb-2">Wann hingehen</h4>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Die Werkstätten sind das ganze Jahr geöffnet. Hochsaison ist von Ende November bis Anfang Januar. Werktags haben die Läden meist etwa von 9:30 bis 19:30 Uhr geöffnet, an Dezemberwochenenden länger. Am ruhigsten sind Vormittage unter der Woche.</p>
      </div>
      <div class="bg-white p-6 rounded-[2rem] border border-slate-100 shadow-sm">
        <h4 class="font-bold text-slate-900 mb-2">Gedränge und Einbahnregelung</h4>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">2025 galt eine Einbahnregelung für Fußgänger von 9:00 bis 20:00 Uhr vom 28. bis 30. November, vom 5. bis 8. Dezember, vom 12. bis 14. Dezember und vom 19. bis 22. Dezember, am 23. Dezember von 9:00 bis 14:00 Uhr. Mitte des Monats wechselte die Richtung. Die Verordnung wird jedes Jahr neu erlassen.</p>
      </div>
      <div class="bg-white p-6 rounded-[2rem] border border-slate-100 shadow-sm">
        <h4 class="font-bold text-slate-900 mb-2">Preise</h4>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Eine Preisliste für die Straße gibt es nicht. In einem Bericht von 2019 nannten Ladenbesitzer zwanzig bis dreißig Euro für eine mittelgroße Figur. Kleines Zubehör kostet weniger, handgearbeitete Stücke aus den alteingesessenen Werkstätten deutlich mehr. Fragen Sie, bevor Sie etwas in die Hand nehmen.</p>
      </div>
      <div class="bg-white p-6 rounded-[2rem] border border-slate-100 shadow-sm">
        <h4 class="font-bold text-slate-900 mb-2">Der Transport nach Hause</h4>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Terrakottafiguren sind zerbrechlich. Lassen Sie sie gut verpacken und nehmen Sie sie ins Handgepäck. Die meisten Werkstätten verkaufen auch online mit Versand, was sich bei größeren Stücken lohnt.</p>
      </div>
    </div>

    <h3 class="font-serif text-2xl font-bold text-slate-900 mb-4">Anreise ab Sorrent</h3>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      Im Winter ist der Zug die einfachste Lösung. Die Circumvesuviana fährt von Sorrent nach Neapel und hält in Napoli Garibaldi, im selben Komplex wie der Hauptbahnhof.
    </p>
    <div class="overflow-x-auto rounded-[2rem] border border-slate-100 shadow-sm mb-6">
      <table class="w-full text-xs sm:text-sm">
        <thead class="bg-slate-900 text-white">
          <tr>
            <th class="text-left p-5 font-serif font-bold text-med-gold">Strecke</th>
            <th class="text-left p-5 font-serif font-bold text-med-gold">Wie</th>
            <th class="text-left p-5 font-serif font-bold text-med-gold">Dauer</th>
          </tr>
        </thead>
        <tbody class="bg-white">
          <tr class="border-b border-slate-100">
            <td class="p-5 font-bold">Sorrent nach Napoli Garibaldi</td>
            <td class="p-5 text-slate-600">Circumvesuviana, Linie nach Neapel</td>
            <td class="p-5 text-slate-600">Etwa 1 Std.</td>
          </tr>
          <tr class="border-b border-slate-100">
            <td class="p-5 font-bold">Garibaldi nach Duomo</td>
            <td class="p-5 text-slate-600">Metro-Linie 1, eine Station</td>
            <td class="p-5 text-slate-600">Wenige Minuten</td>
          </tr>
          <tr>
            <td class="p-5 font-bold">Duomo zur San Gregorio Armeno</td>
            <td class="p-5 text-slate-600">Zu Fuß die Via Duomo hinauf, dann links in die Via San Biagio dei Librai oder die Via dei Tribunali</td>
            <td class="p-5 text-slate-600">Etwa 10 Min.</td>
          </tr>
        </tbody>
      </table>
    </div>
    <p class="text-slate-600 text-lg leading-relaxed">
      Wer lieber direkt ab Garibaldi läuft, ist über den Corso Umberto I und die Via Duomo in rund fünfundzwanzig Minuten da. Regionaltickets vor dem Einsteigen entwerten und in der Circumvesuviana, einer Pendlerbahn, die Taschen vor dem Körper tragen. Unser Ratgeber zur <a href="/de-de/blog/amalfikueste-mit-dem-zug/" class="text-med-blue hover:underline">Amalfiküste mit dem Zug</a> beschreibt die Linie ausführlicher.
    </p>
  </div>

  <!-- Sorrento churches -->
  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">Sorrent: Krippen in der Altstadt</h2>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      In Sorrent gehören die Krippen zu <a href="/de-de/veranstaltungen/sorrentinische-halbinsel/millumino-inverno-sorrento/" class="text-med-blue hover:underline">M'illumino d'Inverno</a>, dem Winterprogramm von Ende November bis Mitte Januar. Kirchen und Museen der Altstadt stellen Krippen aus, und ein eigener Wettbewerb, Il Presepe Oggi, findet seit mehr als vierzig Jahren statt. Das waren die Krippentermine im Programm 2025/26:
    </p>
    <ul class="space-y-3 mb-6">
      <li class="flex items-start gap-3"><span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span><span class="text-slate-700"><strong>Villa Fiorentino.</strong> Die Ausstellung „Giuseppe Ercolano e i maestri del presepe“ über die neapolitanische Krippentradition, geöffnet bis 18. Januar 2026.</span></li>
      <li class="flex items-start gap-3"><span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span><span class="text-slate-700"><strong>Il Presepe Oggi.</strong> Die 46. Ausgabe des städtischen Krippenwettbewerbs, mit Preisverleihung am 18. Januar in der Kirche Santissima Annunziata.</span></li>
      <li class="flex items-start gap-3"><span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span><span class="text-slate-700"><strong>Prozession des Jesuskindes.</strong> Am 6. Januar um 19:30 Uhr ab der Kirche del Carmine, mit Hirten und Dudelsackspielern.</span></li>
    </ul>
    <p class="text-slate-600 text-lg leading-relaxed">
      Das Zentrum ist klein und fast ganz Fußgängerzone, die Kirchen lassen sich also an einem Nachmittag zwischen Piazza Tasso, Dom und Via San Cesareo besuchen. Die Öffnungszeiten der Kirchen schwanken und hängen nicht immer aus, planen Sie daher etwas Spielraum ein.
    </p>
  </div>

  <!-- Living nativities -->
  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">Lebende Krippen auf der Sorrentinischen Halbinsel</h2>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      Ein Presepe vivente ist eine Krippe mit echten Menschen: die Heilige Familie in der Grotte und rundherum die Handwerke eines alten Dorfes, mit Bäckern, Schustern, Spinnerinnen und Wirten bei der Arbeit. Auf der Halbinsel organisieren sie Pfarreien und örtliche Vereine, abends, zwischen Weihnachten und Dreikönig. Die Tabelle nennt die für die letzte Ausgabe bestätigten.
    </p>

    <div class="overflow-x-auto rounded-[2rem] border border-slate-100 shadow-sm mb-8">
      <table class="w-full text-xs sm:text-sm">
        <thead class="bg-slate-900 text-white">
          <tr>
            <th class="text-left p-5 font-serif font-bold text-med-gold">Ort</th>
            <th class="text-left p-5 font-serif font-bold text-med-gold">Wo</th>
            <th class="text-left p-5 font-serif font-bold text-med-gold">Termine 2025/26</th>
            <th class="text-left p-5 font-serif font-bold text-med-gold">Zeiten</th>
          </tr>
        </thead>
        <tbody class="bg-white">
          <tr class="border-b border-slate-100">
            <td class="p-5 font-bold">Sorrent</td>
            <td class="p-5 text-slate-600">Hauseingänge und Höfe der Altstadt, Start an der Piazza Tasso</td>
            <td class="p-5 text-slate-600">28., 29., 30. Dezember</td>
            <td class="p-5 text-slate-600">17:30 bis 20:30 Uhr</td>
          </tr>
          <tr class="border-b border-slate-100">
            <td class="p-5 font-bold">Vico Equense</td>
            <td class="p-5 text-slate-600">Fornacelle, Località Torricella</td>
            <td class="p-5 text-slate-600">26., 27., 28. Dezember; 1., 2., 3., 5., 6. Januar</td>
            <td class="p-5 text-slate-600">18:00 bis 21:00 Uhr</td>
          </tr>
          <tr>
            <td class="p-5 font-bold">Massa Lubrense</td>
            <td class="p-5 text-slate-600">Kloster Santissimo Rosario, Monticchio</td>
            <td class="p-5 text-slate-600">27., 28. Dezember; 1., 2., 4., 5., 6. Januar</td>
            <td class="p-5 text-slate-600">18:00 bis 20:30 Uhr</td>
          </tr>
        </tbody>
      </table>
    </div>

    <h3 class="font-serif text-2xl font-bold text-slate-900 mb-4">Sorrent: die Krippe in den Hauseingängen</h3>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      Die Ausgabe 2025 mit dem Titel „Araprite 'e purtune, ce sta 'o presepio“ („Öffnet die Tore, die Krippe ist da“) organisierte Officina Solidale im Rahmen des Programms Surriento Gentile. Statt einer einzigen Bühne verteilten sich die Szenen auf 18 Tore und Eingangshallen historischer Palazzi, jeweils mit einer Laterne markiert. Der Rundgang begann an der Piazza Tasso, wo der Infopunkt einen QR-Code mit dem Plan ausgab. Die vorherige Ausgabe 2024/25 fand in den Gärten neben der Kathedrale mit mehr als 250 Mitwirkenden statt, das Format kann sich also von Jahr zu Jahr ändern.
    </p>

    <h3 class="font-serif text-2xl font-bold text-slate-900 mb-4">Vico Equense: Fornacelle</h3>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      Fornacelle ist ein Ortsteil in den Hügeln oberhalb von <a href="/de-de/sorrentinische-halbinsel/vico-equense/" class="text-med-blue hover:underline">Vico Equense</a>, und seine lebende Krippe, organisiert von der Pfarrei Santi Pietro e Paolo, erreichte 2025 die zehnte Ausgabe mit mehr als 250 Mitwirkenden aus dem Ort. Sie findet in der Località Torricella statt, wenige Schritte vom Dorfplatz. Der Eintritt ist frei, Spenden sind willkommen. 2025 hatten die Veranstalter drei Parkplätze und barrierefreie Wege eingerichtet. Eine Auflistung nannte zusätzlich den 4. Januar, prüfen Sie daher vor dem Besuch die offizielle Website presepefornacelle.it.
    </p>

    <h3 class="font-serif text-2xl font-bold text-slate-900 mb-4">Massa Lubrense: das Kloster von Monticchio</h3>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      In <a href="/de-de/sorrentinische-halbinsel/massa-lubrense/" class="text-med-blue hover:underline">Massa Lubrense</a> inszeniert der Verein Carpe Diem seine Krippe im Kloster Santissimo Rosario aus dem 18. Jahrhundert in Monticchio, mit Unterstützung der Gemeinde. Der Rundgang führt von Szenen in Judäa ins neapolitanische 18. Jahrhundert, mit Taverne, Marktständen und Wahrsagerin. Eine Auflistung nennt für die nächste Ausgabe bereits den 27. Dezember 2026 bis 6. Januar 2027, bestätigt hatte die Gemeinde das zum Zeitpunkt des Schreibens aber nicht.
    </p>

    <h3 class="font-serif text-2xl font-bold text-slate-900 mb-4">Piano di Sorrento und Sant'Agnello</h3>
    <ul class="space-y-3 mb-6">
      <li class="flex items-start gap-3"><span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span><span class="text-slate-700"><strong>Piano di Sorrento.</strong> Keine lebende Krippe, sondern ein Krippenweg im Rahmen des Projekts „Borghi e Casali“, aufgebaut in Kirchen, öffentlichen Räumen, Geschäften und Privathäusern und bis 11. Januar 2026 geöffnet, teils mit Führungen durch die Erbauer selbst. Das Programm erschien auf der Facebook-Seite Città di Piano di Sorrento.</span></li>
      <li class="flex items-start gap-3"><span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span><span class="text-slate-700"><strong><a href="/de-de/sorrentinische-halbinsel/sant-agnello/" class="text-med-blue hover:underline">Sant'Agnello</a>.</strong> Eine fünf Meter lange bewegliche Krippe mit Figuren in Bewegung und Alltagsszenen, in einem Raum in der Via Balsamo. 2025/26 war sie täglich von 16:00 bis 20:00 Uhr geöffnet, am 1., 3. und 6. Januar zusätzlich von 10:30 bis 13:00 Uhr.</span></li>
    </ul>
    <p class="text-slate-600 text-lg leading-relaxed">
      Für Meta haben wir für die letzte Ausgabe keine bestätigte lebende Krippe gefunden, und die von Casarlano, einem Hügelviertel von Sorrent, taucht in den Auflistungen nur bis 2018 auf. Ob sie zurückkehren, zeigen die Programme im Dezember.
    </p>
  </div>

  <!-- Planning -->
  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">So lässt sich alles verbinden</h2>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      Neapel ist ein Tagesausflug, die lebenden Krippen sind Abendprogramm, beides passt also gut zusammen. Verbringen Sie einen Vormittag unter der Woche in der San Gregorio Armeno, essen Sie in der Altstadt zu Mittag und seien Sie am Nachmittag zurück in Sorrent. An den Abenden zwischen dem 26. Dezember und dem 6. Januar wählen Sie eine der lebenden Krippen: Die in Sorrent erreicht man zu Fuß vom Zentrum, Fornacelle und Monticchio sind Hügelorte, die man am besten mit Auto oder Taxi ansteuert.
    </p>
    <p class="text-slate-600 text-lg leading-relaxed">
      Wer auch auf die andere Seite der Lattari-Berge fährt, findet dort weitere: siehe unseren Ratgeber zu den <a href="/de-de/veranstaltungen/amalfikueste/presepi-viventi-costiera/" class="text-med-blue hover:underline">lebenden Krippen der Amalfiküste</a>. Und für die Abende vor Weihnachten sind die Lichter in Sorrent und Salerno in <a href="/de-de/blog/weihnachtsbeleuchtung-sorrent-salerno/" class="text-med-blue hover:underline">Weihnachtsbeleuchtung in Sorrent und Salerno</a> beschrieben.
    </p>
  </div>

