---
import BaseLayout from '../../../../../layouts/BaseLayout.astro';
import CorrelationSlider from '../../../../../components/CorrelationSlider.astro';
import Breadcrumbs from '../../../../../components/Breadcrumbs.astro';

const lang = 'de-de';

const breadcrumbs = [
  { name: 'Home', url: '/de-de/' },
  { name: 'Planung', url: '/de-de/planung/' },
  { name: 'Weg der Götter Trekking', url: '/de-de/reiserouten/1-tag/weg-der-goetter-trekking/' },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Wie organisiert man den Weg der Götter an einem Tag ab Neapel?",
      "acceptedAnswer": { "@type": "Answer", "text": "Ab Neapel mit der Circumvesuviana nach Sorrent (70 Min.), dann SITA-Bus nach Amalfi (90 Min.), dann lokaler Bus nach Bomerano/Agerola (45 Min.). Der Wanderweg Bomerano→Nocelle ist 7,8 km, 3–4h. Von Nocelle lokaler Bus nach Positano (15 Min.), dann SITA-Bus oder Fähre nach Sorrent und Circumvesuviana nach Neapel." }
    },
    {
      "@type": "Question",
      "name": "Muss man den Weg der Götter vorbuchen?",
      "acceptedAnswer": { "@type": "Answer", "text": "In der Hochsaison (Juli–August) ist für den Weg der Götter eine Pflichtbuchung über das Portal des Parco dei Monti Lattari erforderlich. Die Kosten sind symbolisch (~€5). Außerhalb der Saison ist keine Buchung notwendig. Vor der Abreise immer die aktuellen Bedingungen auf der offiziellen Website prüfen." }
    },
    {
      "@type": "Question",
      "name": "Was muss man für den Weg der Götter mitbringen?",
      "acceptedAnswer": { "@type": "Answer", "text": "Pflichtausrüstung: Wanderschuhe (keine Sandalen oder glatten Sneaker), mindestens 1,5 L Wasser, Sonnenschutz, Hut. Der Weg hat weder Brunnen noch Läden. Einen Snack mitnehmen. Im Frühling/Herbst eine leichte Jacke gegen den Wind in der Höhe empfohlen." }
    },
    {
      "@type": "Question",
      "name": "Ist der Weg der Götter gefährlich?",
      "acceptedAnswer": { "@type": "Answer", "text": "Der Weg der Götter ist nicht gefährlich für Wanderer mit geeignetem Schuhwerk und normaler Fitness. Er ist als E/EE (mittelschwer) eingestuft. Ausgesetzte Abschnitte haben Schutzmauern oder Geländer. Bei Regen nicht empfohlen (rutschiger Boden). Nicht geeignet für Personen mit Höhenangst oder Kinder unter 6 Jahren." }
    },
    {
      "@type": "Question",
      "name": "Wie lange dauert der Weg der Götter?",
      "acceptedAnswer": { "@type": "Answer", "text": "Die klassische Route Bomerano→Nocelle ist 7,8 km lang und dauert 3–4 Stunden bei moderatem Tempo mit Fotopausen. Die Höhenvariante (Sentiero degli Dei Alto) fügt ca. 2 km und 1 Stunde hinzu. Von Nocelle nach Positano kommen 45 Minuten zu Fuß (1.700 Stufen) oder 15 Minuten mit dem Bus hinzu." }
    },
    {
      "@type": "Question",
      "name": "Ist der Weg der Götter kostenlos?",
      "acceptedAnswer": { "@type": "Answer", "text": "Von Juli bis August ist eine Pflichtbuchung (~€5) über das Portal des Parco dei Monti Lattari erforderlich. In den übrigen Monaten ist der Zugang frei und kostenlos. Die Gebühr deckt die Instandhaltung des Weges und den Rettungsdienst." }
    }
  ]
};

const hikingTrailSchema = {
  "@context": "https://schema.org",
  "@type": "TouristAttraction",
  "name": "Weg der Götter (Sentiero degli Dei)",
  "description": "Atemberaubender 7,8 km langer Küstenwanderweg von Bomerano (Agerola) nach Nocelle (Positano) an der Amalfiküste, mit Blick auf das Meer und Capri.",
  "geo": { "@type": "GeoCoordinates", "latitude": 40.6389, "longitude": 14.5472 },
  "touristType": ["Hiking", "Nature", "Adventure"],
  "isAccessibleForFree": false,
  "address": { "@type": "PostalAddress", "addressLocality": "Agerola", "addressRegion": "Campania", "addressCountry": "IT" }
};

const schedule = [
  { time: '07:00', place: 'Neapel', action: 'Circumvesuviana nach Sorrent (70 Min., ~€3,90)', transport: 'train' },
  { time: '08:15', place: 'Sorrent', action: 'SITA-Bus nach Amalfi (90 Min., ~€3,50) - Abfahrt 8:30 Uhr', transport: 'bus' },
  { time: '10:00', place: 'Amalfi', action: 'Lokaler Bus nach Bomerano, Ortsteil von Agerola (45 Min., ~€1,50). Wanderbeginn.', transport: 'bus' },
  { time: '11:00', place: 'Bomerano, Agerola (618 m)', action: 'Start Weg der Götter. 7,8 km, ~500 m Abstieg, Schwierigkeit E/EE. Atemberaubende Landschaften.', transport: 'walk' },
  { time: '14:30', place: 'Nocelle', action: 'Ankunft Nocelle. Pause und Mittagessen in einem der lokalen Rifugi/Bars.', transport: 'visit' },
  { time: '15:15', place: 'Nocelle → Positano', action: 'Lokaler Bus nach Positano Zentrum (15 Min., ~€1,50) oder zu Fuß (~1.700 Stufen, 45 Min.)', transport: 'bus' },
  { time: '16:00', place: 'Positano', action: 'Spaziergang, Eis, Strand (1h frei)', transport: 'visit' },
  { time: '17:15', place: 'Positano → Neapel', action: 'SITA-Bus nach Sorrent (~50 Min.), dann Circumvesuviana nach Neapel (70 Min.)', transport: 'bus' },
];

const tips = [
  'Ideale Saison: April–Juni und September–Oktober. Juli–August ist sehr heiß und überfüllt.',
  'Der Bus von Amalfi nach Bomerano (Agerola) fährt selten: Abfahrtzeiten am Vorabend auf eavsrl.it prüfen.',
  'Immer in Richtung Bomerano→Nocelle gehen: fast durchgehend bergab, Beschilderung für diese Richtung.',
  'Kein Trinkwasser auf dem Weg: mindestens 1,5 L mitbringen. Die letzte Bar ist am Platz in Bomerano vor dem Start.',
  'Von Nocelle nach Positano: zu Fuß bergab (~1.700 Stufen, 45 Min.) oder mit Bus (15 Min., ~€1,50).',
];

const transportBadge: Record<string, { label: string; cls: string }> = {
  train: { label: 'ZUG', cls: 'bg-orange-100 text-orange-700' },
  ferry: { label: 'FÄHRE', cls: 'bg-blue-100 text-blue-700' },
  bus:   { label: 'BUS', cls: 'bg-green-100 text-green-700' },
  walk:  { label: 'WANDERN', cls: 'bg-red-100 text-red-700' },
  visit: { label: '', cls: '' },
};
---

<BaseLayout
  title="Weg der Götter 2026: Karte, Schwierigkeit, Wanderweg Bomerano–Nocelle"
  description="Kompletter Wanderführer Weg der Götter (Sentiero degli Dei): Karte, Schwierigkeitsgrad, ist er gefährlich?, Buchung, Anreise ab Neapel. 7,8 km Bomerano→Nocelle an der Amalfiküste."
  lang={lang}
  breadcrumbs={breadcrumbs}
  schema={[faqSchema, hikingTrailSchema]}
 pageKey="weg-der-goetter-trekking">

  <section class="relative bg-charcoal overflow-hidden min-h-[70vh] sm:min-h-[75vh] flex items-center justify-center">
    <img src="/images/trekking-hero.jpg" alt="Weg der Götter, Amalfiküste" class="absolute inset-0 w-full h-full object-cover opacity-30" loading="eager" fetchpriority="high" decoding="sync" referrerpolicy="no-referrer"/>
    <div class="absolute inset-0 bg-gradient-to-b from-black/75 via-black/40 to-black/70"></div>
    <div class="relative max-w-editorial mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <div class="max-w-3xl mx-auto">
        <p class="text-med-gold text-xs sm:text-sm font-medium uppercase tracking-[0.3em] mb-3">Reiseroute · 1 Tag Trek</p>
        <h1 class="font-serif text-display text-white mb-4">Weg der Götter Trek</h1>
        <p class="text-xl text-white/80 leading-relaxed max-w-2xl mx-auto">
          Bomerano nach Nocelle: 7,8 km atemberaubende Aussichten über die Amalfiküste. Zug, Bus und Wanderung ab Neapel an einem Tag.
        </p>
      </div>
    </div>
    <Breadcrumbs breadcrumbs={breadcrumbs} />
  </section>

  <div class="max-w-editorial mx-auto px-4 sm:px-6 lg:px-8 pt-6 pb-10 space-y-10">

    <section class="text-center mb-2">
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-2 sm:gap-4 mb-6 overflow-x-auto snap-x snap-mandatory sm:overflow-visible pb-2 sm:pb-0">
        <div class="bg-slate-900 rounded-2xl p-6 hover:shadow-md transition-shadow flex flex-col items-center justify-center aspect-square snap-start">
          <svg class="w-8 h-8 text-med-gold mb-3" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg>
          <p class="text-xs text-white/60 font-semibold uppercase tracking-wide mb-2">Dauer</p>
          <p class="font-serif text-lg font-semibold text-med-gold">1 Tag</p>
        </div>
        <div class="bg-slate-900 rounded-2xl p-6 hover:shadow-md transition-shadow flex flex-col items-center justify-center aspect-square snap-start">
          <svg class="w-8 h-8 text-med-gold mb-3" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
          <p class="text-xs text-white/60 font-semibold uppercase tracking-wide mb-2">Höhenmeter</p>
          <p class="font-serif text-lg font-semibold text-med-gold">~500 m<br/>Abstieg</p>
        </div>
        <div class="bg-slate-900 rounded-2xl p-6 hover:shadow-md transition-shadow flex flex-col items-center justify-center aspect-square snap-start">
          <svg class="w-8 h-8 text-med-gold mb-3" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M6 9l6-6 6 6M5 9v9a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V9M9 14h6"/></svg>
          <p class="text-xs text-white/60 font-semibold uppercase tracking-wide mb-2">Distanz</p>
          <p class="font-serif text-lg font-semibold text-med-gold">7,8 km<br/>3–4 Stunden</p>
        </div>
        <div class="bg-slate-900 rounded-2xl p-6 hover:shadow-md transition-shadow flex flex-col items-center justify-center aspect-square snap-start">
          <svg class="w-8 h-8 text-med-gold mb-3" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><circle cx="12" cy="12" r="1"/><path d="M12 1v6M12 17v6M4.22 4.22l4.24 4.24M15.54 15.54l4.24 4.24M1 12h6M17 12h6M4.22 19.78l4.24-4.24M15.54 8.46l4.24-4.24"/></svg>
          <p class="text-xs text-white/60 font-semibold uppercase tracking-wide mb-2">Verkehrsbudget</p>
          <p class="font-serif text-lg font-semibold text-med-gold">€11–14<br/><span class="text-xs">p.P.</span></p>
        </div>
      </div>

      <div>
        <p class="text-lg text-slate-700 leading-relaxed">
          Der <strong>Weg der Götter</strong> (Sentiero degli Dei) ist die berühmteste Wanderung an der <strong>Amalfiküste</strong>: 7,8 km von <strong>Bomerano</strong> (Agerola) nach <strong>Nocelle</strong>, überwiegend bergab, mit atemberaubenden Ausblicken auf Capri und die Küste. Schwierigkeit E/EE, geeignet für Wanderer mit normaler Fitness. Ab Neapel ca. 4 Stunden zum Startpunkt (Circumvesuviana + SITA-Bus + Lokalbus). Die Wanderung dauert 3–4 Stunden. <strong>Pflichtbuchung Juli–August</strong> (~€5). Verkehrsbudget: €11–14.
        </p>
      </div>
    </section>

    <section>
      <h2 class="font-serif text-2xl font-semibold text-slate-900 mb-8">Tagesablauf</h2>
      <div class="bg-white border border-slate-200 rounded-2xl overflow-hidden">
        <div class="px-6 py-8 space-y-6">
          {schedule.map((item, idx) => {
            const badge = transportBadge[item.transport];
            const isLastItem = idx === schedule.length - 1;
            return (
              <div class="flex gap-4">
                <div class="flex flex-col items-center flex-shrink-0">
                  <div class="w-16 bg-slate-900 text-med-gold rounded-full px-2 py-1 text-center text-sm font-semibold flex items-center justify-center">{item.time}</div>
                  {!isLastItem && <div class="w-0.5 h-12 bg-med-blue/30 mt-2"></div>}
                </div>
                <div class="pb-4 flex-1">
                  <p class="font-semibold text-slate-900 mb-1">{item.place}</p>
                  <p class="text-slate-700 text-sm mb-2" set:html={item.action} />
                  {badge.label && <span class={`text-xs font-semibold px-2 py-1 rounded-full ${badge.cls}`}>{badge.label}</span>}
                </div>
              </div>
            );
          })}
        </div>
      </div>
    </section>

    <!-- Karte des Wanderwegs -->
    <section id="karte">
      <h2 class="font-serif text-2xl font-semibold text-slate-900 mb-4">Karte des Weg der Götter</h2>
      <p class="text-slate-600 mb-6 leading-relaxed">Der Weg beginnt an der <strong>Piazza Paolo Capasso in Bomerano</strong> (Ortsteil von Agerola, 618 m ü.M.) und folgt dem CAI-Wanderweg Nr. 327 in westlicher Richtung entlang des Lattari-Gebirges bis <strong>Nocelle</strong> (420 m ü.M.), dem Höhenortsteil von Positano. Der Weg ist mit rot-weißen CAI-Markierungen beschildert.</p>
      <div class="rounded-2xl overflow-hidden border border-slate-200">
        <iframe
          src="https://www.openstreetmap.org/export/embed.html?bbox=14.475%2C40.618%2C14.565%2C40.655&layer=mapnik&marker=40.638%2C14.547"
          width="100%"
          height="450"
          style="border:0;"
          allowfullscreen=""
          loading="lazy"
          title="Karte Weg der Götter: Wanderweg Bomerano - Nocelle">
        </iframe>
      </div>
      <div class="mt-4 grid grid-cols-1 sm:grid-cols-3 gap-3">
        <div class="bg-slate-50 rounded-xl p-4 text-center">
          <p class="text-xs text-slate-500 uppercase tracking-wide mb-1">Start</p>
          <p class="font-semibold text-slate-900">Bomerano (618 m)</p>
          <p class="text-xs text-slate-500">Piazza Paolo Capasso</p>
        </div>
        <div class="bg-slate-50 rounded-xl p-4 text-center">
          <p class="text-xs text-slate-500 uppercase tracking-wide mb-1">Ziel</p>
          <p class="font-semibold text-slate-900">Nocelle (420 m)</p>
          <p class="text-xs text-slate-500">Piazzetta di Nocelle</p>
        </div>
        <div class="bg-slate-50 rounded-xl p-4 text-center">
          <p class="text-xs text-slate-500 uppercase tracking-wide mb-1">Höhenmeter</p>
          <p class="font-semibold text-slate-900">+200 m / −400 m</p>
          <p class="text-xs text-slate-500">Überwiegend bergab</p>
        </div>
      </div>
    </section>

    <!-- Schwierigkeit und Sicherheit -->
    <section id="schwierigkeit">
      <h2 class="font-serif text-2xl font-semibold text-slate-900 mb-4">Schwierigkeit und Sicherheit</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div class="bg-white border border-slate-200 rounded-2xl p-6">
          <h3 class="font-semibold text-slate-900 mb-3 flex items-center gap-2">
            <span class="w-8 h-8 bg-green-100 text-green-700 rounded-full flex items-center justify-center text-sm font-bold">E</span>
            Einstufung: E / EE
          </h3>
          <p class="text-slate-600 text-sm leading-relaxed mb-3">
            Der Weg der Götter ist als <strong>E</strong> (Wanderweg) mit einigen <strong>EE</strong>-Abschnitten (Erfahrene Wanderer) eingestuft. Keine Seile, Steigeisen oder Kletterausrüstung erforderlich. Der Untergrund ist Erde und Fels mit in Stein gehauenen Stufen.
          </p>
          <ul class="text-sm text-slate-600 space-y-1">
            <li class="flex items-start gap-2"><span class="text-green-600 mt-0.5">&#10003;</span> Keine Klettersteige oder Kletterpassagen</li>
            <li class="flex items-start gap-2"><span class="text-green-600 mt-0.5">&#10003;</span> Klare CAI rot-weiße Wegmarkierungen</li>
            <li class="flex items-start gap-2"><span class="text-green-600 mt-0.5">&#10003;</span> Ausgesetzte Stellen mit Schutzmauern</li>
          </ul>
        </div>
        <div class="bg-white border border-slate-200 rounded-2xl p-6">
          <h3 class="font-semibold text-slate-900 mb-3 flex items-center gap-2">
            <span class="w-8 h-8 bg-amber-100 text-amber-700 rounded-full flex items-center justify-center text-sm font-bold">!</span>
            Ist der Weg der Götter gefährlich?
          </h3>
          <p class="text-slate-600 text-sm leading-relaxed mb-3">
            <strong>Nein, mit der richtigen Ausrüstung und normaler Fitness.</strong> Der Weg ist sicher für alle mit Wanderschuhen und angemessener Kondition. Dennoch ist Vorsicht geboten:
          </p>
          <ul class="text-sm text-slate-600 space-y-1">
            <li class="flex items-start gap-2"><span class="text-amber-600 mt-0.5">&#9888;</span> Bei Regen wird der Boden rutschig: Wanderung vermeiden</li>
            <li class="flex items-start gap-2"><span class="text-amber-600 mt-0.5">&#9888;</span> Steilabschnitte: nicht für Personen mit Höhenangst</li>
            <li class="flex items-start gap-2"><span class="text-amber-600 mt-0.5">&#9888;</span> Nicht geeignet für Kinder unter 6 Jahren</li>
            <li class="flex items-start gap-2"><span class="text-amber-600 mt-0.5">&#9888;</span> Mindestens 1,5 L Wasser mitnehmen (keine Brunnen)</li>
          </ul>
        </div>
      </div>
    </section>

  </div>

  <CorrelationSlider
    heading="Trek-Destinationen"
    lang="de-de"
    items={[
      { name: 'Positano', href: '/de-de/amalfikueste/positano/', tag: 'Dorf & Strände', desc: 'Ziel der Wanderung, farbenfrohes Juwel der Amalfiküste.' },
      { name: 'Amalfi', href: '/de-de/amalfikueste/amalfi/', tag: 'Kunst & Geschichte', desc: 'Ihr Ausgangspunkt zum Wanderweg via Bus nach Bomerano.' },
      { name: 'Ravello', href: '/de-de/amalfikueste/ravello/', tag: 'Musik & Gärten', desc: 'Die Terrasse der Unendlichkeit, Villa Rufolo und Panoramablicke 350 m über dem Meer.' },
      { name: 'Praiano', href: '/de-de/amalfikueste/praiano/', tag: 'Sonnenuntergang', desc: 'Nahe Nocelle, spektakuläre Sonnenuntergänge und der Strand Gavitella.' },
    ]}
  />

  <div class="max-w-editorial mx-auto px-4 sm:px-6 lg:px-8 pb-10 space-y-10">

    <section class="bg-med-cream border border-med-gold/20 rounded-[2rem] p-6">
      <h2 class="font-serif text-xl font-semibold text-charcoal mb-6">Praktische Tipps</h2>
      <ul class="space-y-4">
        {tips.map((text, idx) => {
          const nums = ['❶', '❷', '❸', '❹', '❺'];
          return (
            <li class="flex items-start gap-4 text-sm text-charcoal">
              <span class="text-2xl font-bold text-white flex-shrink-0 leading-none mt-0.5 bg-[#E2725B] w-9 h-9 flex items-center justify-center rounded-full">{nums[idx] || '•'}</span>
              <span class="leading-relaxed" set:html={text} />
            </li>
          );
        })}
      </ul>
    </section>

    <section id="faq">
      <h2 class="font-serif text-2xl font-semibold text-slate-900 mb-6">Häufig gestellte Fragen</h2>
      <div class="space-y-4">
        {faqSchema.mainEntity.map((q) => (
          <details class="group border border-slate-200 rounded-2xl overflow-hidden">
            <summary class="flex items-center justify-between px-6 py-4 cursor-pointer select-none text-charcoal font-medium hover:bg-slate-50 transition-colors">
              {q.name}
              <svg class="w-4 h-4 text-slate-400 group-open:rotate-180 transition-transform flex-shrink-0 ml-3" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
            </summary>
            <div class="px-6 pb-5 text-slate-600 leading-relaxed text-sm border-t border-slate-100 pt-4">{q.acceptedAnswer.text}</div>
          </details>
        ))}
      </div>
    </section>

    <!-- BANNER: Reiserouten-Planer -->
    <section class="relative overflow-hidden rounded-[2rem] bg-gradient-to-br from-slate-900 via-slate-950 to-blue-950 px-6 sm:px-10 py-8 md:py-10 shadow-[0_20px_60px_rgba(0,0,0,0.35)]">
      <div class="absolute -top-20 -left-20 w-72 h-72 bg-blue-500/15 rounded-full blur-3xl pointer-events-none"></div>
      <div class="absolute -bottom-20 -right-20 w-72 h-72 bg-amber-500/10 rounded-full blur-3xl pointer-events-none"></div>
      <div class="relative z-10 md:flex md:items-center md:justify-between gap-8">
        <div>
          <span class="inline-block px-3 py-1 rounded-full text-[10px] font-semibold tracking-wide uppercase bg-med-gold/15 text-med-gold border border-med-gold/25 mb-4">Neu: Reiseplaner</span>
          <h2 class="text-2xl md:text-3xl font-bold text-white leading-tight mb-2">Gestalte deine <span class="font-serif italic text-med-blue">perfekte Reiseroute</span></h2>
          <p class="text-white/60 text-sm md:text-base leading-relaxed max-w-xl">Beantworte ein paar einfache Fragen und erhalte eine personalisierte Reiseroute mit Transport, Kosten und Zeiten.</p>
        </div>
        <div class="mt-6 md:mt-0 flex-shrink-0">
          <a href="/de-de/reiserouten-planer/" class="inline-flex items-center gap-2.5 px-7 py-3.5 bg-gradient-to-r from-med-gold to-yellow-600 text-slate-900 font-bold rounded-xl hover:shadow-[0_0_30px_rgba(212,175,55,0.4)] hover:scale-105 transition-all duration-300">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 2L2 12l4 0 0 6 4 0 0-4 4 0 0 4 4 0 0-6 4 0L12 2z"/></svg>
            Jetzt planen
          </a>
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="bg-gradient-to-r from-med-blue to-med-blue/80 rounded-2xl p-10 text-center text-white">
      <h2 class="font-serif text-3xl font-bold mb-3">Planen Sie Ihren Weg der Götter</h2>
      <p class="text-white/90 mb-6 max-w-2xl mx-auto">Erfahren Sie mehr über Wanderungen an der Amalfiküste, Bedingungen, beste Jahreszeit und Buchungsanforderungen für den legendären Sentiero degli Dei.</p>
      <a href="/de-de/ratgeber/faehren/" class="inline-block bg-white text-med-blue font-semibold px-8 py-3 rounded-full hover:bg-slate-100 transition-colors">Reiseführer →</a>
    </section>

  </div>

