---
import BaseLayout from '../../../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../../../components/Breadcrumbs.astro';

const lang = 'de-de';

const breadcrumbs = [
  { name: 'Home', url: '/de-de/' },
  { name: 'Planung', url: '/de-de/planung/' },
  { name: 'Sorrentinische Halbinsel von Neapel', url: '/de-de/reiserouten/1-tag/sorrentinische-halbinsel-von-neapel/' },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Wie kommt man von Neapel nach Sorrent?",
      "acceptedAnswer": { "@type": "Answer", "text": "Am einfachsten mit der Circumvesuviana: Zug ab Neapel Porta Nolana oder Piazza Garibaldi bis Sorrent (70 Min., ~€3,90). Züge alle 30–40 Minuten. Alternativ: Tragflügelboot ab Neapel Beverello (Alilauro/NLG, ~60 Min., ~€15), aber teurer." }
    },
    {
      "@type": "Question",
      "name": "Was gibt es auf der Sorrentinischen Halbinsel an einem Tag zu sehen?",
      "acceptedAnswer": { "@type": "Answer", "text": "Ab Sorrent: Altstadt und Vallone dei Mulini (30 Min.), dann Bus nach Massa Lubrense (20 Min.) mit Blick auf Capri und den Golf. Sant'Agata sui Due Golfi bietet eines der schönsten Panoramen der Gegend. Punta Campanella ist zu Fuß erreichbar (Wanderweg 6 km A/R, 2,5h)." }
    }
  ]
};

const destinations = [
  { name: 'Sorrent', url: '/de-de/sorrentinische-halbinsel/sorrent/' },
  { name: 'Massa Lubrense', url: '/de-de/sorrentinische-halbinsel/massa-lubrense/' },
  { name: 'Sant\'Agnello', url: '/de-de/sorrentinische-halbinsel/sant-agnello/' },
];

const destinationHighlights = destinations.map(d => ({ name: d.name, desc: '', url: d.url }));

const schedule = [
  { time: '08:00', place: 'Neapel Porta Nolana', action: 'Circumvesuviana nach <a href="/de-de/sorrentinische-halbinsel/sorrent/" class="text-med-blue hover:underline font-medium">Sorrent</a> (70 Min., ~€3,90)', transport: 'train' },
  { time: '09:15', place: 'Sorrent', action: 'Altstadt, Piazza Tasso, Vallone dei Mulini, Limoncello-Läden (1,5h)', transport: 'visit' },
  { time: '11:00', place: 'Sorrent → Massa Lubrense', action: 'SITA-Bus nach <a href="/de-de/sorrentinische-halbinsel/massa-lubrense/" class="text-med-blue hover:underline font-medium">Massa Lubrense</a> (20 Min., ~€1,50). Panorama auf Capri.', transport: 'bus' },
  { time: '12:00', place: 'Massa Lubrense', action: 'Mittagessen in einer lokalen Trattoria. Doppelgolf-Panorama von Punta Campanella.', transport: 'visit' },
  { time: '13:30', place: "Sant'Agata sui Due Golfi", action: 'Bus oder Taxi (15 Min.). Belvedere del Deserto (Panorama Golf von Neapel + Salerno).', transport: 'bus' },
  { time: '15:00', place: "Sant'Agata → Sorrent", action: 'Rückbus nach <a href="/de-de/sorrentinische-halbinsel/sorrent/" class="text-med-blue hover:underline font-medium">Sorrent</a> (30 Min.). Freie Zeit am Hafen.', transport: 'bus' },
  { time: '16:30', place: 'Sorrent', action: 'Marina Piccola, Spaziergang, Aperitivo mit Vesuv-Blick', transport: 'visit' },
  { time: '18:00', place: 'Sorrent → Neapel', action: 'Circumvesuviana nach Neapel (70 Min.)', transport: 'train' },
];

const tips = [
  'Die Circumvesuviana ist günstig, aber langsam und im Sommer oft überfüllt: Gepäck im Auge behalten.',
  "Sant'Agata sui Due Golfi: Vom Aussichtspunkt sieht man sowohl den Golf von Neapel als auch den Golf von Salerno.",
  'Massa Lubrense eignet sich ideal für ein günstiges Mittagessen mit Tagesfang: weniger touristisch als Sorrent.',
  'Für den Punta-Campanella-Wanderweg (6 km A/R) spätestens um 10:00 Uhr ab Massa Lubrense starten.',
  'Der Sorrentiner Limoncello wird aus IGP-Zitronen der Region hergestellt: In lokalen Geschäften kaufen.',
];

const transportBadge: Record<string, { label: string; cls: string }> = {
  train: { label: 'ZUG', cls: 'bg-orange-100 text-orange-700' },
  ferry: { label: 'FÄHRE', cls: 'bg-blue-100 text-blue-700' },
  bus:   { label: 'BUS', cls: 'bg-green-100 text-green-700' },
  walk:  { label: 'ZU FUSS', cls: 'bg-gray-100 text-slate-500' },
  visit: { label: '', cls: '' },
};
---

<BaseLayout
  title="Sorrentinische Halbinsel in 1 Tag von Neapel 2026"
  description="Tagesausflug zur Sorrentinischen Halbinsel ab Neapel: Sorrent, Massa Lubrense, Sant'Agata. Doppelgolf, Circumvesuviana, SITA-Bus."
  lang={lang}
  breadcrumbs={breadcrumbs}
  schema={[faqSchema]}
  pageKey="sorrentinische-halbinsel-von-neapel"
>

  <section class="relative bg-charcoal overflow-hidden min-h-[70vh] sm:min-h-[75vh] flex items-center justify-center">
    <img src="/images/costiera-hero.jpg" alt="Sorrentinische Halbinsel" class="absolute inset-0 w-full h-full object-cover opacity-30" loading="eager" referrerpolicy="no-referrer"/>
    <div class="absolute inset-0 bg-gradient-to-b from-black/20 via-black/40 to-black/80"></div>
    <div class="relative max-w-editorial mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <div class="max-w-3xl mx-auto">
        <p class="text-med-gold text-xs sm:text-sm font-medium uppercase tracking-[0.3em] mb-3">Reiseroute · 1 Tag</p>
        <h1 class="font-serif text-display text-white mb-4">Sorrentinische Halbinsel von Neapel</h1>
        <p class="text-xl text-white/80 leading-relaxed max-w-2xl mx-auto">
          Sorrent, Massa Lubrense und Sant'Agata sui Due Golfi in einem Tag. Doppelgolf-Ausblick, Limoncello und Circumvesuviana.
        </p>
      </div>
    </div>
    <Breadcrumbs breadcrumbs={breadcrumbs} />
  </section>

  <div class="max-w-editorial mx-auto px-4 sm:px-6 lg:px-8 pt-6 pb-10 space-y-10">

    <section class="text-center mb-2">
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-2 sm:gap-4 mb-6 overflow-x-auto snap-x snap-mandatory sm:overflow-visible pb-2 sm:pb-0">
        <div class="w-full bg-slate-900 rounded-2xl p-4 sm:p-6 hover:shadow-md transition-shadow flex flex-col items-center justify-center aspect-square snap-start">
          <svg class="w-8 h-8 text-med-gold mb-3" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg>
          <p class="text-xs text-white/60 font-semibold uppercase tracking-wide mb-2">Dauer</p>
          <p class="font-serif text-lg font-semibold text-med-gold">1 Tag</p>
        </div>
        <div class="w-full bg-slate-900 rounded-2xl p-4 sm:p-6 hover:shadow-md transition-shadow flex flex-col items-center justify-center aspect-square snap-start">
          <svg class="w-8 h-8 text-med-gold mb-3" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
          <p class="text-xs text-white/60 font-semibold uppercase tracking-wide mb-2">Ausgangspunkt</p>
          <p class="font-serif text-lg font-semibold text-med-gold">Neapel</p>
        </div>
        <div class="w-full bg-slate-900 rounded-2xl p-4 sm:p-6 hover:shadow-md transition-shadow flex flex-col items-center justify-center aspect-square snap-start">
          <svg class="w-8 h-8 text-med-gold mb-3" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M6 9l6-6 6 6M5 9v9a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V9M9 14h6"/></svg>
          <p class="text-xs text-white/60 font-semibold uppercase tracking-wide mb-2">Verkehr</p>
          <p class="font-serif text-lg font-semibold text-med-gold">Circumvesuviana<br/>+ Linienbus</p>
        </div>
        <div class="w-full bg-slate-900 rounded-2xl p-4 sm:p-6 hover:shadow-md transition-shadow flex flex-col items-center justify-center aspect-square snap-start">
          <svg class="w-8 h-8 text-med-gold mb-3" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><circle cx="12" cy="12" r="1"/><path d="M12 1v6M12 17v6M4.22 4.22l4.24 4.24M15.54 15.54l4.24 4.24M1 12h6M17 12h6M4.22 19.78l4.24-4.24M15.54 8.46l4.24-4.24"/></svg>
          <p class="text-xs text-white/60 font-semibold uppercase tracking-wide mb-2">Verkehrsbudget</p>
          <p class="font-serif text-lg font-semibold text-med-gold">€10–15<br/><span class="text-xs">p.P.</span></p>
        </div>
      </div>

      <div>
        <p class="text-lg text-slate-700 leading-relaxed">
          Ein Tag auf der <strong>Sorrentinischen Halbinsel</strong> ab <strong>Neapel</strong>: Nehmen Sie die günstige <strong>Circumvesuviana</strong> nach <strong>Sorrent</strong>, erkunden Sie die Altstadt und Vallone dei Mulini, fahren Sie per Bus zu <strong>Massa Lubrense</strong> und Sant'Agata für das legendäre Doppelgolf-Panorama. Entdecken Sie Limoncello, frische Fischgerichtе und die ruhigere Seite der Küste. <strong>Verkehrsbudget: €10–15</strong>.
        </p>
      </div>
    </section>

    <section>
      <h2 class="font-serif text-2xl font-semibold text-slate-900 mb-8">Tagesablauf</h2>
      <div class="bg-white border border-slate-200 rounded-2xl overflow-hidden">
        <div class="px-6 py-8 space-y-6">
          {schedule.map((item, idx) => {
            const badge = transportBadge[item.transport];
            const isLastItem = idx === schedule.length - 1;
            return (
              <div class="flex gap-4">
                <div class="flex flex-col items-center flex-shrink-0">
                  <div class="w-16 bg-slate-900 text-med-gold rounded-full px-2 py-1 text-center text-sm font-semibold flex items-center justify-center">{item.time}</div>
                  {!isLastItem && <div class="w-0.5 h-12 bg-med-blue/30 mt-2"></div>}
                </div>
                <div class="pb-4 flex-1">
                  <p class="font-semibold text-slate-900 mb-1">{item.place}</p>
                  <p class="text-slate-700 text-sm mb-2" set:html={item.action} />
                  {badge.label && <span class={`text-xs font-semibold px-2 py-1 rounded-full ${badge.cls}`}>{badge.label}</span>}
                </div>
              </div>
            );
          })}
        </div>
      </div>
    </section>

    <section>
      <h2 class="font-serif text-2xl font-semibold text-slate-900 mb-8">Orte der Reiseroute</h2>
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4">
        {destinationHighlights.map((dest) => (
          <a href={dest.url} class="group block bg-white border border-slate-200 rounded-2xl p-5 hover:shadow-lg hover:border-med-blue/30 transition-all">
            <h3 class="font-semibold text-charcoal mb-2 group-hover:text-med-blue transition-colors">{dest.name}</h3>
            <p class="text-xs text-slate-500 leading-relaxed mb-3">{dest.desc}</p>
            <span class="text-xs font-semibold text-med-blue inline-flex items-center gap-1 group-hover:gap-2 transition-all">Entdecken →</span>
          </a>
        ))}
      </div>
    </section>

    <section class="bg-med-cream border border-med-gold/20 rounded-[2rem] p-6">
      <h2 class="font-serif text-xl font-semibold text-charcoal mb-6">Praktische Tipps</h2>
      <ul class="space-y-4">
        {tips.map((text, idx) => {
          const nums = ['❶', '❷', '❸', '❹', '❺'];
          return (
            <li class="flex items-start gap-4 text-sm text-charcoal">
              <span class="text-2xl font-bold text-white flex-shrink-0 leading-none mt-0.5 bg-[#E2725B] w-9 h-9 flex items-center justify-center rounded-full">{nums[idx] || '•'}</span>
              <span class="leading-relaxed" set:html={text} />
            </li>
          );
        })}
      </ul>
    </section>

    <section id="faq">
      <h2 class="font-serif text-2xl font-semibold text-slate-900 mb-6">Häufig gestellte Fragen</h2>
      <div class="space-y-4">
        {faqSchema.mainEntity.map((q) => (
          <details class="group border border-slate-200 rounded-2xl overflow-hidden">
            <summary class="flex items-center justify-between px-6 py-4 cursor-pointer select-none text-charcoal font-medium hover:bg-slate-50 transition-colors">
              {q.name}
              <svg class="w-4 h-4 text-slate-400 group-open:rotate-180 transition-transform flex-shrink-0 ml-3" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
            </summary>
            <div class="px-6 pb-5 text-slate-600 leading-relaxed text-sm border-t border-slate-100 pt-4">{q.acceptedAnswer.text}</div>
          </details>
        ))}
      </div>
    </section>

    <section class="bg-gradient-to-r from-med-blue to-med-blue/80 rounded-2xl p-10 text-center text-white">
      <h2 class="font-serif text-3xl font-bold mb-3">Sorrentinische Halbinsel entdecken</h2>
      <p class="text-white/90 mb-6 max-w-2xl mx-auto">Lesen Sie unseren kompletten Reiseführer zur Sorrentinischen Halbinsel: Wanderwege, Küstenaussichten, lokale Küche und Reisetipps.</p>
      <a href="/de-de/reiseführer/faehren/" class="inline-block bg-white text-med-blue font-semibold px-8 py-3 rounded-full hover:bg-slate-100 transition-colors">Reiseführer →</a>
    </section>

  </div>

</BaseLayout>
