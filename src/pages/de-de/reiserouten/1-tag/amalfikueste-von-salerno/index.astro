---
import BaseLayout from '../../../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../../../components/Breadcrumbs.astro';

const lang = 'de-de';

const breadcrumbs = [
  { name: 'Home', url: '/de-de/' },
  { name: 'Planung', url: '/de-de/planung/' },
  { name: 'Amalfiküste von Salerno', url: '/de-de/reiserouten/1-tag/amalfikueste-von-salerno/' },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Wie kommt man von Salerno zur Amalfiküste?",
      "acceptedAnswer": { "@type": "Answer", "text": "Von Salerno gibt es zwei Optionen: Fähre Travelmar nach Amalfi (45 Min., ~€8, saisonal Apr.–Okt.) oder SITA-Bus vom Bahnhof Salerno (Richtung Amalfi über SS163, ~60 Min., ~€2,80). Die Fähre ist landschaftlich schöner und schneller; der Bus fährt das ganze Jahr." }
    },
    {
      "@type": "Question",
      "name": "Lohnt sich der Start am östlichen Eingang der Küste (Vietri, Maiori)?",
      "acceptedAnswer": { "@type": "Answer", "text": "Ja, besonders in der Nebensaison, wenn die Orte weniger überfüllt sind. Vietri sul Mare ist berühmt für seine Keramiken, Maiori hat die längste Strandpromenade der Küste und eine entspannte Atmosphäre. Minori lohnt einen Stopp wegen der Ruinen der Römischen Villa." }
    }
  ]
};

const destinations = [
  { name: 'Amalfi', url: '/de-de/amalfikueste/amalfi/' },
  { name: 'Maiori', url: '/de-de/amalfikueste/maiori/' },
  { name: 'Minori', url: '/de-de/amalfikueste/minori/' },
  { name: 'Vietri sul Mare', url: '/de-de/amalfikueste/vietri-sul-mare/' },
];

const destinationHighlights = destinations.map(d => ({ name: d.name, desc: '', url: d.url }));

const schedule = [
  { time: '08:30', place: 'Salerno', action: 'Fähre Travelmar nach Amalfi (Apr.–Okt., 45 Min., ~€8) oder SITA-Bus (60 Min., ~€2,80)', transport: 'ferry' },
  { time: '09:30', place: 'Amalfi', action: 'Dom Sant\'Andrea, Kreuzgang des Paradieses, Papiermuseum (2,5h)', transport: 'visit' },
  { time: '12:00', place: 'Amalfi', action: 'Mittagessen im Zentrum (Trattorien am Corso oder am Hafen)', transport: 'visit' },
  { time: '13:30', place: 'Amalfi → Maiori', action: 'SITA-Bus Ost nach Maiori (20 Min., ~€1,50). Strandpromenade und Strand.', transport: 'bus' },
  { time: '15:00', place: 'Maiori → Minori', action: 'Zu Fuß entlang der Promenade (20 Min.) oder mit Bus. Römische Villa Minori (kostenlos).', transport: 'walk' },
  { time: '16:00', place: 'Minori → Vietri sul Mare', action: 'SITA-Bus nach Vietri (~30 Min.). Keramiken, Keramikmuseum, Spaziergang.', transport: 'bus' },
  { time: '17:30', place: 'Vietri → Salerno', action: 'Bus nach Salerno (15 Min.) oder zu Fuß entlang der Küste (45 Min. mit Aussicht)', transport: 'bus' },
];

const tips = [
  'Salerno ist per Hochgeschwindigkeitszug mit Neapel und Rom verbunden: ein idealer Ausgangspunkt.',
  'Die Travelmar-Fähre ab Salerno bietet landschaftliche Highlights und erreicht Amalfi ohne die SS163.',
  'Der östliche Teil der Küste (Maiori, Minori, Vietri) ist viel weniger überlaufen als Positano.',
  'Vietri sul Mare ist die italienische Hauptstadt der Keramik: ideal für hochwertige Souvenirs.',
  'In der Nebensaison ist der SITA-Bus die einzige Option (Fähre eingestellt): Abfahrt am Piazza della Concordia.',
];

const transportBadge: Record<string, { label: string; cls: string }> = {
  train: { label: 'ZUG', cls: 'bg-orange-100 text-orange-700' },
  ferry: { label: 'FÄHRE', cls: 'bg-blue-100 text-blue-700' },
  bus:   { label: 'BUS', cls: 'bg-green-100 text-green-700' },
  walk:  { label: 'ZU FUSS', cls: 'bg-gray-100 text-slate-500' },
  visit: { label: '', cls: '' },
};
---

<BaseLayout
  title="Amalfiküste ab Salerno in 1 Tag 2026 | Östliche Küstenroute"
  description="Tagesausflug vom östlichen Eingang der Amalfiküste: Amalfi, Maiori, Minori und Vietri sul Mare ab Salerno. Fähr- und SITA-Busfahrpläne für 2026."
  lang={lang}
  breadcrumbs={breadcrumbs}
  schema={[faqSchema]}
 pageKey="amalfikueste-von-salerno"
  heroImage="/images/costiera-hero.jpg"
>

  <!-- Hero Section -->
  <section class="relative bg-charcoal overflow-hidden min-h-[70vh] sm:min-h-[75vh] flex items-center justify-center">
    <img src="/images/costiera-hero.jpg" alt="Amalfiküste von Salerno" class="absolute inset-0 w-full h-full object-cover opacity-30" loading="eager" fetchpriority="high" decoding="sync" referrerpolicy="no-referrer"/>
    <div class="absolute inset-0 bg-gradient-to-b from-black/75 via-black/40 to-black/70"></div>
    <div class="relative max-w-editorial mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <div class="max-w-3xl mx-auto">
        <p class="text-med-gold text-xs sm:text-sm font-medium uppercase tracking-[0.3em] mb-3">Reiseroute · 1 Tag</p>
        <h1 class="font-serif text-display text-white mb-4">Amalfiküste von Salerno</h1>
        <p class="text-xl text-white/80 leading-relaxed max-w-2xl mx-auto">
          Das östliche Tor: Amalfi, Maiori, Minori und Vietri sul Mare. Fähre, Keramik, ruhiges Ufer und weniger überlaufen.
        </p>
      </div>
    </div>
    <Breadcrumbs breadcrumbs={breadcrumbs} />
  </section>

  <div class="max-w-editorial mx-auto px-4 sm:px-6 lg:px-8 pt-6 pb-10 space-y-10">

    <!-- Intro & Stats Section - Featured -->
    <section class="text-center mb-2">
      <!-- Quick Stats Grid - Scrollable on Mobile -->
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-2 sm:gap-4 mb-6 overflow-x-auto snap-x snap-mandatory sm:overflow-visible pb-2 sm:pb-0">
        <div class="bg-slate-900 rounded-2xl p-6 hover:shadow-md transition-shadow flex flex-col items-center justify-center aspect-square snap-start">
          <svg class="w-8 h-8 text-med-gold mb-3" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
            <rect x="3" y="4" width="18" height="18" rx="2"/>
            <path d="M16 2v4M8 2v4M3 10h18"/>
          </svg>
          <p class="text-xs text-white/60 font-semibold uppercase tracking-wide mb-2">Dauer</p>
          <p class="font-serif text-lg font-semibold text-med-gold">1 Tag</p>
        </div>
        <div class="bg-slate-900 rounded-2xl p-6 hover:shadow-md transition-shadow flex flex-col items-center justify-center aspect-square snap-start">
          <svg class="w-8 h-8 text-med-gold mb-3" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
            <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/>
            <circle cx="12" cy="10" r="3"/>
          </svg>
          <p class="text-xs text-white/60 font-semibold uppercase tracking-wide mb-2">Ausgangspunkt</p>
          <p class="font-serif text-lg font-semibold text-med-gold">Salerno</p>
        </div>
        <div class="bg-slate-900 rounded-2xl p-6 hover:shadow-md transition-shadow flex flex-col items-center justify-center aspect-square snap-start">
          <svg class="w-8 h-8 text-med-gold mb-3" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
            <path d="M6 9l6-6 6 6M5 9v9a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V9M9 14h6"/>
          </svg>
          <p class="text-xs text-white/60 font-semibold uppercase tracking-wide mb-2">Verkehr</p>
          <p class="font-serif text-lg font-semibold text-med-gold">Fähre oder Bus<br/>+ Linienbus</p>
        </div>
        <div class="bg-slate-900 rounded-2xl p-6 hover:shadow-md transition-shadow flex flex-col items-center justify-center aspect-square snap-start">
          <svg class="w-8 h-8 text-med-gold mb-3" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
            <circle cx="12" cy="12" r="1"/>
            <path d="M12 1v6M12 17v6M4.22 4.22l4.24 4.24M15.54 15.54l4.24 4.24M1 12h6M17 12h6M4.22 19.78l4.24-4.24M15.54 8.46l4.24-4.24"/>
          </svg>
          <p class="text-xs text-white/60 font-semibold uppercase tracking-wide mb-2">Verkehrsbudget</p>
          <p class="font-serif text-lg font-semibold text-med-gold">€15–20<br/><span class="text-xs">p.P.</span></p>
        </div>
      </div>

      <!-- SEO Text Below -->
      <div>
        <p class="text-lg text-slate-700 leading-relaxed">
          Erkunden Sie das östliche Tor der <strong>Amalfiküste</strong> von <strong>Salerno</strong> aus: Nehmen Sie die malerische <strong>Travelmar-Fähre</strong> nach <strong>Amalfi</strong>, dann fahren Sie ostwärts zu den ruhigeren Dörfern. Besuchen Sie <strong>Maiori</strong> für seine lange Strandpromenade, <strong>Minori</strong> für römische Villenruinen und <strong>Vietri sul Mare</strong> für weltberühmte Keramiken. Weniger überlaufen als Positano, authentischer. <strong>Verkehrsbudget: €15–20</strong>.
        </p>
      </div>
    </section>


    <!-- Day by Day Itinerary -->
    <section>
      <h2 class="font-serif text-2xl font-semibold text-slate-900 mb-8">Tagesablauf</h2>
      <div class="bg-white border border-slate-200 rounded-2xl overflow-hidden">
        <div class="px-6 py-8 space-y-6">
          {schedule.map((item, idx) => {
            const badge = transportBadge[item.transport];
            const isLastItem = idx === schedule.length - 1;
            return (
              <div class="flex gap-4">
                <div class="flex flex-col items-center flex-shrink-0">
                  <div class="w-16 bg-slate-900 text-med-gold rounded-full px-2 py-1 text-center text-sm font-semibold flex items-center justify-center">
                    {item.time}
                  </div>
                  {!isLastItem && <div class="w-0.5 h-12 bg-med-blue/30 mt-2"></div>}
                </div>
                <div class="pb-4 flex-1">
                  <p class="font-semibold text-slate-900 mb-1">{item.place}</p>
                  <p class="text-slate-700 text-sm mb-2" set:html={item.action} />
                  {badge.label && (
                    <span class={`text-xs font-semibold px-2 py-1 rounded-full ${badge.cls}`}>
                      {badge.label}
                    </span>
                  )}
                </div>
              </div>
            );
          })}
        </div>
      </div>
    </section>

    <!-- Destinations Highlighted -->
    <section>
      <h2 class="font-serif text-2xl font-semibold text-slate-900 mb-8">Orte der Reiseroute</h2>
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4">
        {destinationHighlights.map((dest) => (
          <a href={dest.url} class="group block bg-white border border-slate-200 rounded-2xl p-5 hover:shadow-lg hover:border-med-blue/30 transition-all">
            <h3 class="font-semibold text-charcoal mb-2 group-hover:text-med-blue transition-colors">{dest.name}</h3>
            <p class="text-xs text-slate-500 leading-relaxed mb-3">{dest.desc}</p>
            <span class="text-xs font-semibold text-med-blue inline-flex items-center gap-1 group-hover:gap-2 transition-all">
              Entdecken →
            </span>
          </a>
        ))}
      </div>
    </section>

    <!-- Planning Tips -->
    <section class="bg-med-cream border border-med-gold/20 rounded-[2rem] p-6">
      <h2 class="font-serif text-xl font-semibold text-charcoal mb-6">Praktische Tipps</h2>
      <ul class="space-y-4">
        {tips.map((text, idx) => {
          const nums = ['❶', '❷', '❸', '❹', '❺'];
          return (
            <li class="flex items-start gap-4 text-sm text-charcoal">
              <span class="text-2xl font-bold text-white flex-shrink-0 leading-none mt-0.5 bg-[#E2725B] w-9 h-9 flex items-center justify-center rounded-full">{nums[idx] || '•'}</span>
              <span class="leading-relaxed" set:html={text} />
            </li>
          );
        })}
      </ul>
    </section>

    <!-- FAQ -->
    <section id="faq">
      <h2 class="font-serif text-2xl font-semibold text-slate-900 mb-6">Häufig gestellte Fragen</h2>
      <div class="space-y-4">
        {faqSchema.mainEntity.map((q) => (
          <details class="group border border-slate-200 rounded-2xl overflow-hidden">
            <summary class="flex items-center justify-between px-6 py-4 cursor-pointer select-none text-charcoal font-medium hover:bg-slate-50 transition-colors">
              {q.name}
              <svg class="w-4 h-4 text-slate-400 group-open:rotate-180 transition-transform flex-shrink-0 ml-3" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
            </summary>
            <div class="px-6 pb-5 text-slate-600 leading-relaxed text-sm border-t border-slate-100 pt-4">
              {q.acceptedAnswer.text}
            </div>
          </details>
        ))}
      </div>
    </section>

    <!-- BANNER: Reiserouten-Planer -->
    <section class="relative overflow-hidden rounded-[2rem] bg-gradient-to-br from-slate-900 via-slate-950 to-blue-950 px-6 sm:px-10 py-8 md:py-10 shadow-[0_20px_60px_rgba(0,0,0,0.35)]">
      <div class="absolute -top-20 -left-20 w-72 h-72 bg-blue-500/15 rounded-full blur-3xl pointer-events-none"></div>
      <div class="absolute -bottom-20 -right-20 w-72 h-72 bg-amber-500/10 rounded-full blur-3xl pointer-events-none"></div>
      <div class="relative z-10 md:flex md:items-center md:justify-between gap-8">
        <div>
          <span class="inline-block px-3 py-1 rounded-full text-[10px] font-semibold tracking-wide uppercase bg-med-gold/15 text-med-gold border border-med-gold/25 mb-4">Neu: Reiseplaner</span>
          <h2 class="text-2xl md:text-3xl font-bold text-white leading-tight mb-2">Gestalte deine <span class="font-serif italic text-med-blue">perfekte Reiseroute</span></h2>
          <p class="text-white/60 text-sm md:text-base leading-relaxed max-w-xl">Beantworte ein paar einfache Fragen und erhalte eine personalisierte Reiseroute mit Transport, Kosten und Zeiten.</p>
        </div>
        <div class="mt-6 md:mt-0 flex-shrink-0">
          <a href="/de-de/reiserouten-planer/" class="inline-flex items-center gap-2.5 px-7 py-3.5 bg-gradient-to-r from-med-gold to-yellow-600 text-slate-900 font-bold rounded-xl hover:shadow-[0_0_30px_rgba(212,175,55,0.4)] hover:scale-105 transition-all duration-300">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 2L2 12l4 0 0 6 4 0 0-4 4 0 0 4 4 0 0-6 4 0L12 2z"/></svg>
            Jetzt planen
          </a>
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="bg-gradient-to-r from-med-blue to-med-blue/80 rounded-2xl p-10 text-center text-white">
      <h2 class="font-serif text-3xl font-bold mb-3">Entdecken Sie die Amalfiküste</h2>
      <p class="text-white/90 mb-6 max-w-2xl mx-auto">
        Lesen Sie den vollständigen Reiseführer für die Amalfiküste: Fähren, SITA-Busse, Fahrtzeiten und Spartipps.
      </p>
      <a href="/de-de/ratgeber/faehren/" class="inline-block bg-white text-med-blue font-semibold px-8 py-3 rounded-full hover:bg-slate-100 transition-colors">
        Fährenleitfaden →
      </a>
    </section>

  </div>

</BaseLayout>
