---
import BaseLayout from '../../../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../../../components/Breadcrumbs.astro';

const lang = 'de-de';

const breadcrumbs = [
  { name: 'Home', url: '/de-de/' },
  { name: 'Planung', url: '/de-de/planung/' },
  { name: 'Capri von Sorrent', url: '/de-de/reiserouten/1-tag/capri-von-sorrent/' },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Wie lange dauert die Fahrt von Sorrent nach Capri mit dem Tragflügelboot?",
      "acceptedAnswer": { "@type": "Answer", "text": "Das Tragflügelboot von Sorrent (Marina Piccola) nach Capri (Marina Grande) dauert etwa 20–25 Minuten. Die wichtigsten Anbieter sind NLG und Alilauro. Im Sommer fahren Boote alle 30–60 Minuten von 7:00 bis 20:00 Uhr. Das Hin- und Rückfahrticket kostet ~€18–22." }
    },
    {
      "@type": "Question",
      "name": "Kann man die Blaue Grotte an einem Tag von Sorrent aus besuchen?",
      "acceptedAnswer": { "@type": "Answer", "text": "Ja, aber es erfordert genaue Planung. Das erste Tragflügelboot ab Sorrent nehmen (7:30–8:00 Uhr), nach Capri fahren und sofort zur Blauen Grotte gehen, bevor es voll wird (am besten vor 10:00 Uhr). Danach Capri und Anacapri am Nachmittag erkunden. Rückfahrt nach Sorrent mit dem letzten Tragflügelboot (gegen 18:30–19:00 Uhr)." }
    },
    {
      "@type": "Question",
      "name": "Capri vs. Anacapri: Was an einem Tag besuchen?",
      "acceptedAnswer": { "@type": "Answer", "text": "Beide lohnen sich, aber mit einem Tag wählt man je nach Interessen: Capri-Stadt ist schicker, voller Geschäfte und mit den Faraglioni. Anacapri ist ruhiger, mit der Villa San Michele und dem Sessellift zum Monte Solaro (589 m). Ein guter Tag: Morgens Blaue Grotte, Mittagessen in Anacapri, Nachmittag in Capri und Faraglioni." }
    }
  ]
};

const destinations = [
  { name: 'Sorrent', url: '/de-de/sorrentinische-halbinsel/sorrent/' },
  { name: 'Capri', url: '/de-de/' },
  { name: 'Anacapri', url: '/de-de/inseln/capri/' },
];

const destinationHighlights = destinations.map(d => ({ name: d.name, desc: '', url: d.url }));

const schedule = [
  { time: '07:30', place: 'Sorrent, Marina Piccola', action: 'Tragflügelboot NLG/Alilauro nach Capri (20–25 Min., ~€9–11)', transport: 'ferry' },
  { time: '08:00', place: 'Capri, Marina Grande', action: 'Bus zur Blauen Grotte (20 Min., ~€2). Vor 10 Uhr ankommen, um Schlangen zu vermeiden.', transport: 'bus' },
  { time: '08:30', place: 'Blaue Grotte', action: 'Ruderboot in die Grotte (€15 + Eintritt €14). Wartezeit variiert.', transport: 'ferry' },
  { time: '10:00', place: 'Anacapri', action: 'Bus von Capri nach Anacapri (15 Min.). Villa San Michele (~€7). Sessellift Monte Solaro (589 m, ~€13 A/R).', transport: 'bus' },
  { time: '12:30', place: 'Anacapri', action: 'Mittagessen in einer lokalen Trattoria (günstiger als Capri-Zentrum)', transport: 'visit' },
  { time: '14:00', place: 'Capri Zentrum', action: 'Bus nach Capri. Piazzetta, Via Camerelle, Giardini di Augusto, Faraglioni-Aussicht.', transport: 'bus' },
  { time: '16:00', place: 'Marina Grande', action: 'Bootsrundfahrt um die Faraglioni (~€18–25 p.P., 1–2h)', transport: 'ferry' },
  { time: '18:00', place: 'Capri → Sorrent', action: 'Rückfahrt mit Tragflügelboot nach Sorrent (20–25 Min.)', transport: 'ferry' },
];

const tips = [
  'Blaue Grotte: Vor 10:00 Uhr fast ohne Warteschlange. Nach 11 Uhr kann die Wartezeit 1–2 Stunden betragen.',
  'Im Juli–August das Tragflügelboot online am Vortag buchen: Die ersten Fahrten sind schnell ausverkauft.',
  'Capri ist teuer: Ein Mittagessen in Anacapri kostet 30–40% weniger als auf der Piazzetta.',
  'Der Sessellift zum Monte Solaro ab Anacapri ist ein Muss: 589 m, 360°-Aussicht auf Küste und Neapel.',
  'Das Tragflügelboot fährt bei rauher See nicht: Seewetter prüfen und Plan B parat haben.',
];

const transportBadge: Record<string, { label: string; cls: string }> = {
  train: { label: 'ZUG', cls: 'bg-orange-100 text-orange-700' },
  ferry: { label: 'FÄHRE', cls: 'bg-blue-100 text-blue-700' },
  bus:   { label: 'BUS', cls: 'bg-green-100 text-green-700' },
  walk:  { label: 'ZU FUSS', cls: 'bg-gray-100 text-slate-500' },
  visit: { label: '', cls: '' },
};
---

<BaseLayout
  title="Capri von Sorrent in 1 Tag 2026 | Blaue Grotte & Faraglioni"
  description="Tagesausflug nach Capri von Sorrent: Blaue Grotte, Anacapri, Monte Solaro, Faraglioni. Tragflügelboot, Wanderungen, Tipps."
  lang={lang}
  breadcrumbs={breadcrumbs}
  schema={[faqSchema]}
 pageKey="capri-von-sorrent">

  <section class="relative bg-charcoal overflow-hidden min-h-[70vh] sm:min-h-[75vh] flex items-center justify-center">
    <img src="/images/costiera-hero.jpg" alt="Capri von Sorrent" class="absolute inset-0 w-full h-full object-cover opacity-30" loading="eager" referrerpolicy="no-referrer"/>
    <div class="absolute inset-0 bg-gradient-to-b from-black/75 via-black/40 to-black/70"></div>
    <div class="relative max-w-editorial mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <div class="max-w-3xl mx-auto">
        <p class="text-med-gold text-xs sm:text-sm font-medium uppercase tracking-[0.3em] mb-3">Reiseroute · 1 Tag</p>
        <h1 class="font-serif text-display text-white mb-4">Capri von Sorrent</h1>
        <p class="text-xl text-white/80 leading-relaxed max-w-2xl mx-auto">
          Blaue Grotte, Faraglioni und Anacapri in einer Tagesfahrt: Tragflügelboot von Sorrent.
        </p>
      </div>
    </div>
    <Breadcrumbs breadcrumbs={breadcrumbs} />
  </section>

  <div class="max-w-editorial mx-auto px-4 sm:px-6 lg:px-8 pt-6 pb-10 space-y-10">

    <section class="text-center mb-2">
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-2 sm:gap-4 mb-6 overflow-x-auto snap-x snap-mandatory sm:overflow-visible pb-2 sm:pb-0">
        <div class="bg-slate-900 rounded-2xl p-6 hover:shadow-md transition-shadow flex flex-col items-center justify-center aspect-square snap-start">
          <svg class="w-8 h-8 text-med-gold mb-3" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg>
          <p class="text-xs text-white/60 font-semibold uppercase tracking-wide mb-2">Dauer</p>
          <p class="font-serif text-lg font-semibold text-med-gold">1 Tag</p>
        </div>
        <div class="bg-slate-900 rounded-2xl p-6 hover:shadow-md transition-shadow flex flex-col items-center justify-center aspect-square snap-start">
          <svg class="w-8 h-8 text-med-gold mb-3" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
          <p class="text-xs text-white/60 font-semibold uppercase tracking-wide mb-2">Ausgangspunkt</p>
          <p class="font-serif text-lg font-semibold text-med-gold">Sorrent</p>
        </div>
        <div class="bg-slate-900 rounded-2xl p-6 hover:shadow-md transition-shadow flex flex-col items-center justify-center aspect-square snap-start">
          <svg class="w-8 h-8 text-med-gold mb-3" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M6 9l6-6 6 6M5 9v9a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V9M9 14h6"/></svg>
          <p class="text-xs text-white/60 font-semibold uppercase tracking-wide mb-2">Verkehr</p>
          <p class="font-serif text-lg font-semibold text-med-gold">Tragflügelboot<br/>+ Bus</p>
        </div>
        <div class="bg-slate-900 rounded-2xl p-6 hover:shadow-md transition-shadow flex flex-col items-center justify-center aspect-square snap-start">
          <svg class="w-8 h-8 text-med-gold mb-3" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><circle cx="12" cy="12" r="1"/><path d="M12 1v6M12 17v6M4.22 4.22l4.24 4.24M15.54 15.54l4.24 4.24M1 12h6M17 12h6M4.22 19.78l4.24-4.24M15.54 8.46l4.24-4.24"/></svg>
          <p class="text-xs text-white/60 font-semibold uppercase tracking-wide mb-2">Verkehrsbudget</p>
          <p class="font-serif text-lg font-semibold text-med-gold">€60–80<br/><span class="text-xs">p.P.</span></p>
        </div>
      </div>

      <div>
        <p class="text-lg text-slate-700 leading-relaxed">
          Ein Tag auf <strong>Capri</strong> von <strong>Sorrent</strong> aus: Schnelles <strong>Tragflügelboot</strong> zur <strong>Blauen Grotte</strong>, dann hinauf nach <strong>Anacapri</strong> für die <strong>Villa San Michele</strong> und den Sessellift zum <strong>Monte Solaro</strong>. Nachmittags Capri-Stadt mit Piazzetta und <strong>Faraglioni</strong>-Bootsrundfahrt. Ein luxuriöser, atemberaubender Tag. <strong>Verkehrsbudget: €60–80</strong>.
        </p>
      </div>
    </section>

    <section>
      <h2 class="font-serif text-2xl font-semibold text-slate-900 mb-8">Tagesablauf</h2>
      <div class="bg-white border border-slate-200 rounded-2xl overflow-hidden">
        <div class="px-6 py-8 space-y-6">
          {schedule.map((item, idx) => {
            const badge = transportBadge[item.transport];
            const isLastItem = idx === schedule.length - 1;
            return (
              <div class="flex gap-4">
                <div class="flex flex-col items-center flex-shrink-0">
                  <div class="w-16 bg-slate-900 text-med-gold rounded-full px-2 py-1 text-center text-sm font-semibold flex items-center justify-center">{item.time}</div>
                  {!isLastItem && <div class="w-0.5 h-12 bg-med-blue/30 mt-2"></div>}
                </div>
                <div class="pb-4 flex-1">
                  <p class="font-semibold text-slate-900 mb-1">{item.place}</p>
                  <p class="text-slate-700 text-sm mb-2" set:html={item.action} />
                  {badge.label && <span class={`text-xs font-semibold px-2 py-1 rounded-full ${badge.cls}`}>{badge.label}</span>}
                </div>
              </div>
            );
          })}
        </div>
      </div>
    </section>

    <section>
      <h2 class="font-serif text-2xl font-semibold text-slate-900 mb-8">Orte der Reiseroute</h2>
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4">
        {destinationHighlights.map((dest) => (
          <a href={dest.url} class="group block bg-white border border-slate-200 rounded-2xl p-5 hover:shadow-lg hover:border-med-blue/30 transition-all">
            <h3 class="font-semibold text-charcoal mb-2 group-hover:text-med-blue transition-colors">{dest.name}</h3>
            <p class="text-xs text-slate-500 leading-relaxed mb-3">{dest.desc}</p>
            <span class="text-xs font-semibold text-med-blue inline-flex items-center gap-1 group-hover:gap-2 transition-all">Entdecken →</span>
          </a>
        ))}
      </div>
    </section>

    <section class="bg-med-cream border border-med-gold/20 rounded-[2rem] p-6">
      <h2 class="font-serif text-xl font-semibold text-charcoal mb-6">Praktische Tipps</h2>
      <ul class="space-y-4">
        {tips.map((text, idx) => {
          const nums = ['❶', '❷', '❸', '❹', '❺'];
          return (
            <li class="flex items-start gap-4 text-sm text-charcoal">
              <span class="text-2xl font-bold text-white flex-shrink-0 leading-none mt-0.5 bg-[#E2725B] w-9 h-9 flex items-center justify-center rounded-full">{nums[idx] || '•'}</span>
              <span class="leading-relaxed" set:html={text} />
            </li>
          );
        })}
      </ul>
    </section>

    <section id="faq">
      <h2 class="font-serif text-2xl font-semibold text-slate-900 mb-6">Häufig gestellte Fragen</h2>
      <div class="space-y-4">
        {faqSchema.mainEntity.map((q) => (
          <details class="group border border-slate-200 rounded-2xl overflow-hidden">
            <summary class="flex items-center justify-between px-6 py-4 cursor-pointer select-none text-charcoal font-medium hover:bg-slate-50 transition-colors">
              {q.name}
              <svg class="w-4 h-4 text-slate-400 group-open:rotate-180 transition-transform flex-shrink-0 ml-3" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
            </summary>
            <div class="px-6 pb-5 text-slate-600 leading-relaxed text-sm border-t border-slate-100 pt-4">{q.acceptedAnswer.text}</div>
          </details>
        ))}
      </div>
    </section>

    <section class="bg-gradient-to-r from-med-blue to-med-blue/80 rounded-2xl p-10 text-center text-white">
      <h2 class="font-serif text-3xl font-bold mb-3">Capri entdecken</h2>
      <p class="text-white/90 mb-6 max-w-2xl mx-auto">Lesen Sie unseren kompletten Capri-Reiseführer mit Fährenplänen, Aktivitäten und Insider-Tipps.</p>
      <a href="/de-de/ratgeber/faehren/" class="inline-block bg-white text-med-blue font-semibold px-8 py-3 rounded-full hover:bg-slate-100 transition-colors">Fährenleitfaden →</a>
    </section>

  </div>

</BaseLayout>
