---
import BaseLayout from '../../../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../../../components/Breadcrumbs.astro';

const lang = 'de-de';

const breadcrumbs = [
  { name: 'Home', url: '/de-de/' },
  { name: 'Planung', url: '/de-de/planung/' },
  { name: 'Inseln: Ischia & Procida - 3 Tage', url: '/de-de/reiserouten/3-tage/inseln-ischia-procida/' },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Was ist besser für ein Wochenende: Ischia oder Procida?",
      "acceptedAnswer": { "@type": "Answer", "text": "Das hängt davon ab, was Sie suchen: Ischia ist groß (46 km²), mit Thermalbädern, vielfältigen Stränden, Burgen und Nachtleben - es braucht mindestens 2 Tage. Procida ist klein (4 km²), authentisch, mit ikonischen Pastellfarben, Fischern und wenig Trubel. Mit 3 Tagen können Sie 2 Nächte auf Ischia verbringen und einen Tagesausflug nach Procida machen." }
    },
    {
      "@type": "Question",
      "name": "Wie kommt man von Neapel nach Ischia und Procida?",
      "acceptedAnswer": { "@type": "Answer", "text": "Von Neapel Beverello: Tragflügelboot nach Ischia Porto (~50 Min., €20–24) oder Fähre (~75 Min., €12–14). Nach Procida: Tragflügelboot von Neapel (~35 Min., €15–18). Von Pozzuoli: Medmar/Caremar-Fähre nach Ischia und Procida, günstiger (~€10–13). Im Sommer online buchen." }
    }
  ]
};

const days = [
  {
    day: 'Tag 1',
    title: 'Ankunft auf Ischia',
    items: [
      'Fähre oder Tragflügelboot von Neapel Beverello nach Ischia Porto (50–75 Min.).',
      'Check-in. Nachmittag: Ischia Ponte und das Aragonische Kastell (Eintritt ~€24, 2 Std.).',
      'Strand Maronti (längster der Insel, schwarzer Vulkansand) oder Aperitivo in Forio.',
      'Abendessen in Lacco Ameno oder Ischia Porto: Ischitanische Küche, Kaninchen nach Ischitaner Art.',
    ],
  },
  {
    day: 'Tag 2',
    title: 'Thermalquellen und Strände',
    items: [
      'Morgens: Thermalgärten (Poseidon oder Negombo, ~€35–40 Eintritt). Thermalbecken, Saunen.',
      'Nachmittag: Strand Citara (Forio), einer der schönsten der Insel.',
      'Sonnenuntergang vom Aussichtspunkt Sant\'Angelo, dem malerischsten Dorf Ischias.',
      'Abendessen in Sant\'Angelo oder Rückkehr nach Ischia Porto.',
    ],
  },
  {
    day: 'Tag 3',
    title: 'Tagesausflug nach Procida',
    items: [
      'Tragflügelboot von Ischia nach Procida (20 Min., ~€9). Erste Abfahrt 08:00.',
      'Marina Corricella: der Fischerhafen, pastellfarbene Häuser, Bar am Pier.',
      'Terra Murata: das höchste mittelalterliche Dorf der Insel, Blick über den Golf.',
      'Strand Pozzo Vecchio (der Strand aus "Der Postmann") für ein Mittagsbad.',
      'Rückreise nach Neapel per Tragflügelboot von Procida (35 Min.).',
    ],
  },
];
---

<BaseLayout
  title="Ischia und Procida in 3 Tagen 2026 | Inseln im Golf von Neapel"
  description="3-Tage-Reiseroute auf Ischia und Procida: Thermalbäder, Vulkanstrände, Marina Corricella und Aragonisches Kastell. Anreise, Unterkunft und Sehenswürdigkeiten."
  lang={lang}
  breadcrumbs={breadcrumbs}
  schema={[faqSchema]}
 pageKey="inseln-ischia-procida">

  <section class="relative bg-charcoal overflow-hidden">
    <img src="/images/isole-hero.jpg" alt="Ischia und Procida, Golf von Neapel" class="absolute inset-0 w-full h-full object-cover opacity-30" loading="eager" referrerpolicy="no-referrer"/>

    <div class="absolute inset-0 bg-gradient-to-b from-black/60 via-black/40 to-black/70"></div>
    <div class="relative max-w-editorial mx-auto px-4 sm:px-6 lg:px-8 py-20">
      <div class="max-w-3xl">
        <p class="text-med-gold text-xs sm:text-sm font-medium uppercase tracking-[0.3em] mb-3">Reiseroute · 3 Tage</p>
        <h1 class="font-serif text-display text-white mb-4">Inseln: Ischia & Procida</h1>
        <p class="text-xl text-white/80 leading-relaxed max-w-2xl">
          Capri, Ischia und Procida in drei Tagen. Wilde Inseln und kulturelle Geschichten.
        </p>
      </div>
    </div>
    <Breadcrumbs breadcrumbs={breadcrumbs} />
  </section>

  <div class="max-w-editorial mx-auto px-4 sm:px-6 lg:px-8 py-16 space-y-16">

    <!-- Intro Section -->
    <section class="text-center mb-2 -mt-3">
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-2 sm:gap-4 mb-6 overflow-x-auto snap-x snap-mandatory sm:overflow-visible pb-2 sm:pb-0">
        <!-- Box 1: Duration -->
        <div class="w-full bg-slate-900 rounded-2xl p-4 sm:p-6 hover:shadow-md transition-shadow flex flex-col items-center justify-center aspect-square snap-start">
          <svg class="w-8 h-8 text-med-gold mb-3" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg>
          <p class="text-xs text-white/60 font-semibold uppercase tracking-wide mb-2">Dauer</p>
          <p class="font-serif text-lg font-semibold text-med-gold">3 Tage</p>
        </div>
        <!-- Box 2: Bases -->
        <div class="w-full bg-slate-900 rounded-2xl p-4 sm:p-6 hover:shadow-md transition-shadow flex flex-col items-center justify-center aspect-square snap-start">
          <svg class="w-8 h-8 text-med-gold mb-3" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
          <p class="text-xs text-white/60 font-semibold uppercase tracking-wide mb-2">Stützpunkte</p>
          <p class="font-serif text-lg font-semibold text-med-gold">Ischia Porto<br/>Forio</p>
        </div>
        <!-- Box 3: Transport -->
        <div class="w-full bg-slate-900 rounded-2xl p-4 sm:p-6 hover:shadow-md transition-shadow flex flex-col items-center justify-center aspect-square snap-start">
          <svg class="w-8 h-8 text-med-gold mb-3" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M6 9l6-6 6 6M5 9v9a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V9M9 14h6"/></svg>
          <p class="text-xs text-white/60 font-semibold uppercase tracking-wide mb-2">Verkehr</p>
          <p class="font-serif text-lg font-semibold text-med-gold">Tragflügelboote<br/>Inselbus</p>
        </div>
        <!-- Box 4: Budget -->
        <div class="w-full bg-slate-900 rounded-2xl p-4 sm:p-6 hover:shadow-md transition-shadow flex flex-col items-center justify-center aspect-square snap-start">
          <svg class="w-8 h-8 text-med-gold mb-3" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><circle cx="12" cy="12" r="1"/><path d="M12 1v6M12 17v6M4.22 4.22l4.24 4.24M15.54 15.54l4.24 4.24M1 12h6M17 12h6M4.22 19.78l4.24-4.24M15.54 8.46l4.24-4.24"/></svg>
          <p class="text-xs text-white/60 font-semibold uppercase tracking-wide mb-2">Budget</p>
          <p class="font-serif text-lg font-semibold text-med-gold">€60–120<br/><span class="text-xs">p.P.</span></p>
        </div>
      </div>

      <!-- SEO paragraph -->
      <div>
        <p class="text-lg text-slate-700 leading-relaxed">
          Erkunden Sie die <strong>Inseln des Golfs von Neapel</strong> in <strong>3 Tagen</strong>: Genießen Sie die Thermalbäder von <strong>Ischia</strong>, vulkanische schwarze Sandstrände und malerische Häfen, unternehmen Sie dann einen Tagesausflug nach <strong>Procida</strong> mit seinen ikonischen Pastellhäusern und authentischen Fischerdörfern. Alles leicht zugänglich mit Tragflügelboot und Inselbussen.
        </p>
      </div>
    </section>

    <section>
      <h2 class="font-serif text-2xl font-semibold text-slate-900 mb-8">Tagesplan</h2>
      <div class="space-y-8">
        {days.map(d => (
          <div class="bg-white border border-slate-200 rounded-2xl overflow-hidden">
            <div class="bg-med-blue/5 px-6 py-4 flex items-center gap-3">
              <span class="text-[10px] uppercase tracking-wide bg-med-blue text-white px-2 py-1 rounded-full font-medium">{d.day}</span>
              <h3 class="font-semibold text-charcoal">{d.title}</h3>
            </div>
            <ul class="px-6 py-4 space-y-2">
              {d.items.map(item => (
                <li class="flex items-start gap-2 text-xs sm:text-sm text-charcoal">
                  <span class="w-1.5 h-1.5 rounded-full bg-med-blue/50 mt-1.5 flex-shrink-0"></span>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </section>

    <section class="bg-med-cream border border-med-gold/20 rounded-[2rem] p-8">
      <p class="font-semibold text-charcoal text-lg mb-3">Praktische Tipps</p>
      <ul class="space-y-2">
        {[
          'Auf Ischia fährt der Rundbus (CS/CD) ganztägig: Einzelfahrt ~€1,50, Tagesticket ~€6.',
          'Thermalgärten online buchen: Poseidon und Negombo sind im Sommer ausgebucht.',
          'Procida als Tagesausflug: erstes Tragflügelboot (08:00) nehmen, um vor der Menge da zu sein.',
          'Ischia in der Nebensaison (Oktober–November): Thermen geöffnet, kaum Touristen, günstige Preise.',
          'Das Tragflügelboot fährt bei starkem Seegang nicht: Wetter vor der Buchung prüfen.',
        ].map(tip => (
          <li class="flex items-start gap-2 text-xs sm:text-sm text-charcoal">
            <span class="w-1.5 h-1.5 rounded-full bg-med-cream0 mt-1.5 flex-shrink-0"></span>
            <span>{tip}</span>
          </li>
        ))}
      </ul>
    </section>

    <section id="faq">
      <h2 class="font-serif text-2xl font-semibold text-slate-900 mb-6">Häufig gestellte Fragen</h2>
      <div class="space-y-4">
        {faqSchema.mainEntity.map((q) => (
          <details class="group border border-slate-200 rounded-2xl overflow-hidden">
            <summary class="flex items-center justify-between px-6 py-4 cursor-pointer select-none text-charcoal font-medium hover:bg-slate-50 transition-colors">
              {q.name}
              <svg class="w-4 h-4 text-slate-400 group-open:rotate-180 transition-transform flex-shrink-0 ml-3" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
            </summary>
            <div class="px-6 pb-5 text-slate-600 leading-relaxed text-xs sm:text-sm border-t border-slate-100 pt-4">
              {q.acceptedAnswer.text}
            </div>
          </details>
        ))}
      </div>
    </section>

  </div>

</BaseLayout>
