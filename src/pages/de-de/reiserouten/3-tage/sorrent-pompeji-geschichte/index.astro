---
import BaseLayout from '../../../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../../../components/Breadcrumbs.astro';

const lang = 'de-de';

const breadcrumbs = [
  { name: 'Home', url: '/de-de/' },
  { name: 'Planung', url: '/de-de/planung/' },
  { name: 'Sorrent, Pompeji & Geschichte - 3 Tage', url: '/de-de/reiserouten/3-tage/sorrent-pompeji-geschichte/' },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Wie lange braucht man für den Besuch von Pompeji?",
      "acceptedAnswer": { "@type": "Answer", "text": "Für einen gründlichen Besuch benötigen Sie mindestens 3–4 Stunden. Ein wesentlicher Besuch (Forum, Via dell'Abbondanza, Casa del Fauno, Amphitheater) ist in 2–2,5 Stunden möglich. Kommen Sie bei Öffnung (09:00), um Nachmittagshitze und Warteschlangen zu vermeiden. Eintrittspreis ~€18–20, kostenlos für unter 18-Jährige." }
    },
    {
      "@type": "Question",
      "name": "Lohnt sich ein Besuch von Herculaneum zusätzlich zu Pompeji?",
      "acceptedAnswer": { "@type": "Answer", "text": "Ja, Herculaneum wird von erfahrenen Besuchern oft bevorzugt: kleiner als Pompeji (2 Std. reichen), aber besser erhalten, da es in Schlamm statt Asche begraben wurde. Es gibt ein Kombi-Ticket Pompeji + Herculaneum. Mit 3 Tagen: Herculaneum am Nachmittag von Tag 2, Pompeji am Morgen von Tag 3." }
    }
  ]
};

const days = [
  {
    day: 'Tag 1',
    title: 'Sorrent',
    highlight: 'Entdecken Sie die malerische Klilfstadt über dem Meer',
    items: [
      'Ankunft in Sorrent per Circumvesuviana von Neapel (70 Min., ~€3,90).',
      'Altstadt: Piazza Tasso, Dom, Vallone dei Mulini (Vulkanschlucht im Stadtzentrum).',
      'Museo Correale: Römische Artefakte und Stadtansichten aus dem 18. Jahrhundert.',
      'Marina Grande: der Fischerhafen, Abendessen mit Meerblick.',
      'Lokaler Tipp: Marina Grande ist touristisch, aber Sie finden authentische Restaurants direkt auf den Hafenmauern. Fragen Sie nach der Fischsuppe des Tages.',
    ],
  },
  {
    day: 'Tag 2',
    title: 'Herculaneum und Vesuv',
    highlight: 'Erkunden Sie die von Schlamm verschüttete römische Stadt und den Vulkan',
    items: [
      'Circumvesuviana nach Herculaneum Scavi (20 Min. von Neapel, 50 Min. von Sorrent).',
      'Archäologische Stätte Herculaneum: außergewöhnliche Erhaltung, 2–3 Stunden.',
      'Nachmittag: Bus/Shuttle zum Vesuv (Krater auf 1.281 m, ~€12 + Pflichtführer). Blick über den Golf von Neapel.',
      'Rückkehr nach Sorrent per Circumvesuviana.',
      'Lokaler Tipp: Herculaneum ist weniger überlaufen als Pompeji. Der Führer am Vesuv ist obligatorisch, aber nehmen Sie einen englischsprachigen Führer für bessere Geologie.',
    ],
  },
  {
    day: 'Tag 3',
    title: 'Pompeji',
    highlight: 'Gehen Sie durch die gefrorenen Straßen der antiken römischen Stadt',
    items: [
      'Circumvesuviana nach Pompei Scavi – Villa dei Misteri (35 Min. von Neapel, 45 Min. von Sorrent).',
      'Ausgrabungen von Pompeji: Forum, Thermen, Amphitheater, Patrizierhäuser. Mindestens 3 Std.',
      'Mittagessen im modernen Pompeji, dann Besuch des Schatzmuseums San Gennaro (optional).',
      'Rückreise nach Neapel oder Sorrent am Nachmittag.',
      'Lokaler Tipp: Mieten Sie einen Audioguide (€10), um der Menge zu entgehen. Beginnen Sie mit dem Amphitheater, enden Sie mit der Villa dei Misteri.',
    ],
  },
];
---

<BaseLayout
  title="Sorrent, Pompeji und Herculaneum in 3 Tagen 2026 | Historische Reiseroute"
  description="3-Tage-Reiseroute mit Geschichte und Meer: Sorrent, Herculaneum, Vesuv und Pompeji. Circumvesuviana-Fahrplan, Eintrittspreise und praktische Tipps."
  lang={lang}
  breadcrumbs={breadcrumbs}
  schema={[faqSchema]}
 pageKey="sorrent-pompeji-geschichte">

  <section class="relative bg-charcoal overflow-hidden">
    <img src="/images/sorrento-hero.jpg" alt="Sorrent und Pompeji" class="absolute inset-0 w-full h-full object-cover" loading="eager" referrerpolicy="no-referrer"/>

    <div class="absolute inset-0 bg-gradient-to-b from-black/75 via-black/40 to-black/70"></div>
    <div class="relative z-10 max-w-7xl mx-auto px-6">
      <div class="max-w-3xl">
        <p class="text-med-gold text-xs sm:text-sm font-medium uppercase tracking-[0.3em] mb-3">Reiseroute · 3 Tage</p>
        <h1 class="font-serif text-display text-white mb-4">Sorrent, Pompeji & Geschichte</h1>
        <p class="text-xl text-white/80 leading-relaxed max-w-2xl">
          Sorrent, Pompeji, römische Geschichte. Drei Tage in Campaniens Vergangenheit.
        </p>
      </div>
    </div>
    <Breadcrumbs breadcrumbs={breadcrumbs} />
  </section>

  <div class="max-w-editorial mx-auto px-4 sm:px-6 lg:px-8 py-16 space-y-16">

    <!-- Intro Section -->
    <section class="text-center mb-2 -mt-3">
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-2 sm:gap-4 mb-6 overflow-x-auto snap-x snap-mandatory sm:overflow-visible pb-2 sm:pb-0">
        <!-- Box 1: Duration -->
        <div class="w-full bg-slate-900 rounded-2xl p-4 sm:p-6 hover:shadow-md transition-shadow flex flex-col items-center justify-center aspect-square snap-start">
          <svg class="w-8 h-8 text-med-gold mb-3" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg>
          <p class="text-xs text-white/60 font-semibold uppercase tracking-wide mb-2">Dauer</p>
          <p class="font-serif text-lg font-semibold text-med-gold">3 Tage</p>
        </div>
        <!-- Box 2: Bases -->
        <div class="w-full bg-slate-900 rounded-2xl p-4 sm:p-6 hover:shadow-md transition-shadow flex flex-col items-center justify-center aspect-square snap-start">
          <svg class="w-8 h-8 text-med-gold mb-3" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
          <p class="text-xs text-white/60 font-semibold uppercase tracking-wide mb-2">Basis</p>
          <p class="font-serif text-lg font-semibold text-med-gold">Sorrent</p>
        </div>
        <!-- Box 3: Transport -->
        <div class="w-full bg-slate-900 rounded-2xl p-4 sm:p-6 hover:shadow-md transition-shadow flex flex-col items-center justify-center aspect-square snap-start">
          <svg class="w-8 h-8 text-med-gold mb-3" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M6 9l6-6 6 6M5 9v9a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V9M9 14h6"/></svg>
          <p class="text-xs text-white/60 font-semibold uppercase tracking-wide mb-2">Verkehr</p>
          <p class="font-serif text-lg font-semibold text-med-gold">Circumvesuviana<br/>Bahn</p>
        </div>
        <!-- Box 4: Budget -->
        <div class="w-full bg-slate-900 rounded-2xl p-4 sm:p-6 hover:shadow-md transition-shadow flex flex-col items-center justify-center aspect-square snap-start">
          <svg class="w-8 h-8 text-med-gold mb-3" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><circle cx="12" cy="12" r="1"/><path d="M12 1v6M12 17v6M4.22 4.22l4.24 4.24M15.54 15.54l4.24 4.24M1 12h6M17 12h6M4.22 19.78l4.24-4.24M15.54 8.46l4.24-4.24"/></svg>
          <p class="text-xs text-white/60 font-semibold uppercase tracking-wide mb-2">Budget</p>
          <p class="font-serif text-lg font-semibold text-med-gold">€70–130<br/><span class="text-xs">p.P.</span></p>
        </div>
      </div>

      <!-- SEO paragraph -->
      <div>
        <p class="text-lg text-slate-700 leading-relaxed">
          Entdecken Sie <strong>Campaniens römisches Erbe</strong> in <strong>3 Tagen</strong>: erkunden Sie die Klifftstadt <strong>Sorrent</strong>, besuchen Sie das außergewöhnlich erhaltene <strong>Herculaneum</strong>, wandern Sie auf den Krater des <strong>Vesuvs</strong>, und spazieren Sie durch die antiken Straßen von <strong>Pompeji</strong>. Alles bequem mit der Circumvesuviana-Bahn erreichbar.
        </p>
      </div>
    </section>

    <section>
      <h2 class="font-serif text-2xl font-semibold text-slate-900 mb-8">Tagesplan</h2>
      <div class="space-y-8">
        {days.map(d => (
          <div class="bg-white border border-slate-200 rounded-2xl overflow-hidden">
            <div class="bg-slate-900 px-6 py-4 flex items-start gap-3">
              <div class="flex-1">
                <div class="flex items-center gap-3 mb-2">
                  <span class="text-[10px] uppercase tracking-wide bg-med-gold text-slate-900 px-2 py-1 rounded-full font-medium">{d.day}</span>
                  <h3 class="font-semibold text-white">{d.title}</h3>
                </div>
                {d.highlight && <p class="text-xs text-med-gold">{d.highlight}</p>}
              </div>
            </div>
            <ul class="px-6 py-4 space-y-3">
              {d.items.map(item => (
                <li class="flex items-start gap-3 text-xs sm:text-sm">
                  {item.startsWith('Lokaler Tipp:') ? (
                    <div class="w-full">
                      <p class="font-semibold text-med-blue mb-1">Lokaler Tipp:</p>
                      <p class="text-charcoal">{item.replace('Lokaler Tipp: ', '')}</p>
                    </div>
                  ) : (
                    <>
                      <span class="w-1.5 h-1.5 rounded-full bg-med-blue/50 mt-1.5 flex-shrink-0"></span>
                      <span class="text-charcoal">{item}</span>
                    </>
                  )}
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </section>

    <section class="bg-med-cream border border-med-gold/20 rounded-[2rem] p-8">
      <p class="font-semibold text-charcoal text-lg mb-3">Praktische Tipps</p>
      <ul class="space-y-2">
        {[
          'Pompeji und Herculaneum: bei Öffnung ankommen (09:00). Nachmittagshitze und Warteschlangen erschweren den Besuch.',
          'Kombi-Ticket Pompeji + Herculaneum: lohnt sich, wenn Sie beide an denselben oder aufeinanderfolgenden Tagen besuchen.',
          'Die Circumvesuviana ist häufig, aber langsam: Sorrent nach Pompei Scavi ~45 Min., von Neapel ~35 Min.',
          'Vesuv: Shuttle-Bus fährt von Herculaneum und Pompeji (saisonale Zeiten prüfen). Ein Führer ist gesetzlich vorgeschrieben.',
          'Sorrent am Abend ist wunderbar: Aperitivo an der Marina Grande, Abendessen auf dem Corso.',
        ].map(tip => (
          <li class="flex items-start gap-2 text-xs sm:text-sm text-charcoal">
            <span class="w-1.5 h-1.5 rounded-full bg-med-cream0 mt-1.5 flex-shrink-0"></span>
            <span>{tip}</span>
          </li>
        ))}
      </ul>
    </section>

    <section id="faq">
      <h2 class="font-serif text-2xl font-semibold text-slate-900 mb-6">Häufig gestellte Fragen</h2>
      <div class="space-y-4">
        {faqSchema.mainEntity.map((q) => (
          <details class="group border border-slate-200 rounded-2xl overflow-hidden">
            <summary class="flex items-center justify-between px-6 py-4 cursor-pointer select-none text-charcoal font-medium hover:bg-slate-50 transition-colors">
              {q.name}
              <svg class="w-4 h-4 text-slate-400 group-open:rotate-180 transition-transform flex-shrink-0 ml-3" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
            </summary>
            <div class="px-6 pb-5 text-slate-600 leading-relaxed text-xs sm:text-sm border-t border-slate-100 pt-4">
              {q.acceptedAnswer.text}
            </div>
          </details>
        ))}
      </div>
    </section>

    <section class="bg-gradient-to-r from-med-blue to-med-blue/80 rounded-[2rem] p-8 text-center">
      <h2 class="font-serif text-2xl font-semibold text-white mb-3">Bereit für eine historische Reise?</h2>
      <p class="text-white/90 mb-6 max-w-2xl mx-auto">Drei Tage zur Erkundung von Sorrent, Herculaneum, dem Vesuv und Pompeji. Buchen Sie Ihre Circumvesuviana-Tickets im Voraus.</p>
      <a href="/de-de/planung/" class="inline-block bg-white text-med-blue font-semibold px-6 py-3 rounded-lg hover:bg-white/90 transition-colors">
        Geschichte entdecken
      </a>
    </section>

  </div>

</BaseLayout>
