---
import BaseLayout from '../../../../../layouts/BaseLayout.astro';
import ItineraryMap from '../../../../../components/ItineraryMap.astro';
import Breadcrumbs from '../../../../../components/Breadcrumbs.astro';

const lang = 'de-de';

const breadcrumbs = [
  { name: 'Home', url: '/de-de/' },
  { name: 'Planung', url: '/de-de/planung/' },
  { name: 'Grand Tour - 7 Tage', url: '/de-de/reiserouten/7-tage/grand-tour-kueste-halbinsel/' },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Wie organisiert man am besten 7 Tage zwischen Amalfiküste und Sorrentinischer Halbinsel?",
      "acceptedAnswer": { "@type": "Answer", "text": "Die klassische Route: 2 Nächte in Neapel (Tage 1–2), dann nach Sorrent oder Amalfi als Basis für die Küste (Tage 3–5), mit einem Capri-Ausflug (Tag 4 oder 5), dann Inseln zum Abschluss (Tage 6–7). Mit SITA-Bus, Circumvesuviana und Tragflügelbooten ist kein Auto nötig." }
    },
    {
      "@type": "Question",
      "name": "Wie viele Nächte in Neapel lohnen sich vor der Küste?",
      "acceptedAnswer": { "@type": "Answer", "text": "1–2 Nächte reichen für Neapel: Spaccanapoli, Nationales Archäologisches Museum, authentische Pizza, Certosa di San Martino. Mit 2 Nächten können Sie Herculaneum oder Pompeji als Tagesausflug einschließen. Neapel ist der natürliche Ankunfts- und Abfahrtspunkt für die gesamte Region." }
    }
  ]
};

const days = [
  { day: 'Tag 1', title: 'Neapel', items: ['Ankunft in Neapel. Spaccanapoli, historisches UNESCO-Zentrum.', 'Nationales Archäologisches Museum: Funde aus Pompeji, Mosaiken, Bronzen.', 'Authentische Pizza im historischen Viertel: Da Michele, Sorbillo oder Brandi.'] },
  { day: 'Tag 2', title: 'Pompeji oder Herculaneum', items: ['Tagesausflug per Circumvesuviana: Ausgrabungen Herculaneum (Morgen, 2–3 Std.) + Vesuv (Nachmittag).', 'Alternative: ganztägig Pompeji (3–4 Std. vor Ort).', 'Rückkehr nach Neapel zum Abendessen.'] },
  { day: 'Tag 3', title: 'Sorrent und Ankunft an der Küste', items: ['Circumvesuviana Neapel→Sorrent (70 Min.). Check-in Sorrent oder Amalfi.', 'Nachmittag: Stadtzentrum Sorrent, Vallone dei Mulini, Marina Grande.', 'SITA-Bus nach Positano (optional, 50 Min.): erster Eindruck der Küste.'] },
  { day: 'Tag 4', title: 'Capri', items: ['Tragflügelboot von Sorrent nach Capri (20–25 Min.). Erste Abfahrt 07:30.', 'Blaue Grotte früh morgens. Anacapri und Monte Solaro per Sessellift.', 'Faraglioni am Nachmittag. Aperitivo auf der Piazzetta. Abends zurück.'] },
  { day: 'Tag 5', title: 'Amalfi und Ravello', items: ['SITA-Bus Sorrent→Amalfi (90 Min.) oder Fähre Sorrent→Amalfi.', 'Dom, Kreuzgang des Paradieses, Papiermuseum.', 'Bus nach Ravello (25 Min.): Villa Rufolo, Villa Cimbrone. Abendessen in Amalfi.'] },
  { day: 'Tag 6', title: 'Positano und Bootsausflug', items: ['SITA-Bus nach Positano (45 Min. von Amalfi). Freier Morgen am Strand.', 'Bootsausflug ab Positano (Smaragdgrotte, Buchten, ~€50–80, 4 Std.).', 'Rückkehr nach Amalfi oder Positano. Abendessen am Hafen.'] },
  { day: 'Tag 7', title: 'Ischia oder Procida und Abreise', items: ['Fähre Amalfi/Neapel→Ischia oder Procida (halbtägiger Ausflug).', 'Procida: Marina Corricella, Terra Murata, Strand Pozzo Vecchio.', 'Rückkehr nach Neapel zur Abreise.'] },
];
const touristTripSchema = {
  "@context": "https://schema.org",
  "@type": "TouristTrip",
  "name": "Grand Tour - 7 Tage",
  "description": "Vollständige 7-Tage-Reiseroute: Neapel, Amalfiküste, Capri und Golfinseln. Pompeji, Sorrent, Positano, Amalfi, Ravello - der Grand Tour Süditaliens.",
  "image": "https://amalficoast-travel.com/images/costiera-hero.jpg",
  "url": "https://amalficoast-travel.com/de-de/reiserouten/7-tage/grand-tour-kueste-halbinsel/",
  "itinerary": {
    "@type": "ItemList",
    "numberOfItems": days.length,
    "itemListElement": days.map((d, i) => ({
      "@type": "ListItem",
      "position": i + 1,
      "name": `${d.day}: ${d.title}`,
      "description": d.items.join(' \u00b7 ')
    }))
  },
  "touristType": "Sightseeing"
};

const destinationHighlights = [];
const planningTips = [];

const itineraryStops = [
  {
    "name": "Neapel",
    "lat": 40.8518,
    "lon": 14.2681
  },
  {
    "name": "Pompeji",
    "lat": 40.7497,
    "lon": 14.4869
  },
  {
    "name": "Herculaneum",
    "lat": 40.8062,
    "lon": 14.348
  },
  {
    "name": "Sorrent",
    "lat": 40.626,
    "lon": 14.3752
  },
  {
    "name": "Amalfi",
    "lat": 40.6339,
    "lon": 14.6027
  },
  {
    "name": "Positano",
    "lat": 40.6281,
    "lon": 14.4849
  },
  {
    "name": "Capri",
    "lat": 40.553,
    "lon": 14.227
  },
  {
    "name": "Anacapri",
    "lat": 40.552,
    "lon": 14.215
  },
  {
    "name": "Ravello",
    "lat": 40.6492,
    "lon": 14.6122
  },
  {
    "name": "Ischia",
    "lat": 40.73,
    "lon": 13.9
  },
  {
    "name": "Procida",
    "lat": 40.762,
    "lon": 14.027
  }
];
const itineraryMapTitle = "Streckenkarte";
---

<BaseLayout
  title="Grand Tour Amalfiküste 7 Tage 2026 | Neapel, Capri, Positano, Amalfi"
  description="Vollständige 7-Tage-Reiseroute: Neapel, Amalfiküste, Capri und Golfinseln. Pompeji, Sorrent, Positano, Amalfi, Ravello - der Grand Tour Süditaliens."
  lang={lang}
  breadcrumbs={breadcrumbs}
  schema={[faqSchema, touristTripSchema]}
 pageKey="grand-tour-kueste-halbinsel"
  heroImage="/images/costiera-hero.jpg"
>

  <!-- Hero Section -->
  <section class="relative bg-charcoal overflow-hidden min-h-[70vh] sm:min-h-[75vh] flex items-center justify-center">
    <img src="/images/costiera-hero.jpg" alt="Grand Tour Amalfiküste" class="absolute inset-0 w-full h-full object-cover opacity-30" loading="eager" fetchpriority="high" decoding="sync" referrerpolicy="no-referrer"/>
    <div class="absolute inset-0 bg-gradient-to-b from-black/75 via-black/40 to-black/70"></div>
    <div class="relative max-w-editorial mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <div class="max-w-3xl mx-auto">
        <p class="text-med-gold text-xs sm:text-sm font-medium uppercase tracking-[0.3em] mb-3">Reiseroute · 7 Tage</p>
        <h1 class="font-serif text-display text-white mb-4">Grand Tour: Küste & Halbinsel</h1>
        <p class="text-xl text-white/80 leading-relaxed max-w-2xl mx-auto">
          Sieben Tage: Küste, Halbinsel, Capri und Grand Tour. Mach alles langsam.
        </p>
      </div>
    </div>
    <Breadcrumbs breadcrumbs={breadcrumbs} />
  </section>

  <div class="max-w-editorial mx-auto px-4 sm:px-6 lg:px-8 pt-6 pb-10 space-y-10">

    <!-- Quick Stats Grid -->
    <section class="grid grid-cols-2 sm:grid-cols-4 gap-2 sm:gap-4 overflow-x-auto snap-x snap-mandatory sm:overflow-visible">
      <div class="bg-slate-900 rounded-2xl p-6 hover:shadow-md transition-shadow flex flex-col items-center justify-center aspect-square snap-start">
        <svg class="w-8 h-8 text-med-gold mb-3" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
          <rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/>
        </svg>
        <p class="text-xs text-white/60 font-semibold uppercase tracking-wide mb-2">Dauer</p>
        <p class="font-serif text-lg font-semibold text-med-gold text-center">7 Tage<br/>6 Nächte</p>
      </div>
      <div class="bg-slate-900 rounded-2xl p-6 hover:shadow-md transition-shadow flex flex-col items-center justify-center aspect-square snap-start">
        <svg class="w-8 h-8 text-med-gold mb-3" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
          <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/>
        </svg>
        <p class="text-xs text-white/60 font-semibold uppercase tracking-wide mb-2">Standorte</p>
        <p class="font-serif text-lg font-semibold text-med-gold text-center">Neapel +<br/>Amalfi/Sorrent</p>
      </div>
      <div class="bg-slate-900 rounded-2xl p-6 hover:shadow-md transition-shadow flex flex-col items-center justify-center aspect-square snap-start">
        <svg class="w-8 h-8 text-med-gold mb-3" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
          <path d="M6 9l6-6 6 6M5 9v9a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V9M9 14h6"/>
        </svg>
        <p class="text-xs text-white/60 font-semibold uppercase tracking-wide mb-2">Verkehr</p>
        <p class="font-serif text-lg font-semibold text-med-gold text-center">Zug + Bus<br/>+ Tragflügelboot</p>
      </div>
      <div class="bg-slate-900 rounded-2xl p-6 hover:shadow-md transition-shadow flex flex-col items-center justify-center aspect-square snap-start">
        <svg class="w-8 h-8 text-med-gold mb-3" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
          <circle cx="12" cy="12" r="1"/><path d="M12 1v6M12 17v6M4.22 4.22l4.24 4.24M15.54 15.54l4.24 4.24M1 12h6M17 12h6M4.22 19.78l4.24-4.24M15.54 8.46l4.24-4.24"/>
        </svg>
        <p class="text-xs text-white/60 font-semibold uppercase tracking-wide mb-2">Transportbudget</p>
        <p class="font-serif text-lg font-semibold text-med-gold text-center">€80–120<br/><span class="text-xs">p.P.</span></p>
      </div>
    </section>


    <!-- Day by Day Itinerary -->
    <section>
      <h2 class="font-serif text-2xl font-semibold text-slate-900 mb-8">Programm Tag für Tag</h2>
      <div class="space-y-6">
        {days.map((d) => (
          <div class="bg-white border border-slate-200 rounded-2xl overflow-hidden hover:shadow-md transition-shadow">
            <div class="bg-slate-900 px-6 py-6 flex items-start gap-4 sm:items-center sm:gap-3">
              <span class="text-[10px] uppercase tracking-wide bg-white/15 text-white px-3 py-1.5 rounded-full font-bold flex-shrink-0">{d.day}</span>
              <div class="flex-1 min-w-0">
                <h3 class="font-serif font-semibold text-white text-lg">{d.title}</h3>
                {d.highlight && <p class="text-xs text-med-gold mt-1 font-medium">{d.highlight}</p>}
              </div>
            </div>
            <ul class="px-6 py-5 space-y-3">
              {d.items.map((item, itemIdx) => {
                const isLocalTip = item.includes('Local tip:');
                const displayText = item.replace('Local tip: ', '');
                const isLastItem = itemIdx === d.items.length - 1;
                return (
                  <li class={`flex gap-3 text-sm relative ${isLocalTip ? 'bg-med-gold/10 p-3 rounded-lg border border-med-gold/20' : ''}`}>
                    <div class="flex flex-col items-center">
                      {isLocalTip ? (
                        <svg class="w-5 h-5 text-med-gold flex-shrink-0 self-center" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
                          <circle cx="12" cy="8" r="5"/>
                          <path d="M12 13v2"/>
                          <rect x="10" y="15" width="4" height="3" rx="0.5"/>
                        </svg>
                      ) : (
                        <span class="w-2 h-2 rounded-full bg-med-blue flex-shrink-0"></span>
                      )}
                      {!isLastItem && <div class="w-0.5 h-6 bg-med-blue/30 mt-1"></div>}
                    </div>
                    <span class={`leading-relaxed ${isLocalTip ? 'font-semibold text-slate-800' : 'text-slate-700'}`}>
                      {isLocalTip && <strong>Local tip: </strong>}
                      {displayText}
                    </span>
                  </li>
                );
              })}
            </ul>
          </div>
        ))}
      </div>
    </section>

    {destinationHighlights.length > 0 && (
      <section>
        <h2 class="font-serif text-2xl font-semibold text-slate-900 mb-8">Reiseziele der Route</h2>
        <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4">
          {destinationHighlights.map((dest) => (
            <a href={dest.url} class="group block bg-white border border-slate-200 rounded-2xl p-5 hover:shadow-lg hover:border-med-blue/30 transition-all">
              <h3 class="font-semibold text-charcoal mb-2 group-hover:text-med-blue transition-colors">{dest.name}</h3>
              <p class="text-xs text-slate-500 leading-relaxed mb-3">{dest.desc}</p>
              <span class="text-xs font-semibold text-med-blue inline-flex items-center gap-1 group-hover:gap-2 transition-all">
                Entdecken →
              </span>
            </a>
          ))}
        </div>
      </section>
    )}

    {planningTips.length > 0 && (
      <section class="bg-med-cream border border-med-gold/20 rounded-[2rem] p-6">
        <h2 class="font-serif text-xl font-semibold text-charcoal mb-6">Praktische Tipps</h2>
        <ul class="space-y-4">
          {planningTips.map(({ num, text }) => (
            <li class="flex items-start gap-4 text-sm text-charcoal">
              <span class="text-2xl font-bold text-white flex-shrink-0 leading-none mt-0.5 bg-[#E2725B] w-9 h-9 flex items-center justify-center rounded-full">{num}</span>
              <span class="leading-relaxed">{text}</span>
            </li>
          ))}
        </ul>
      </section>
    )}

    <!-- FAQ -->
    <section id="faq">
      <h2 class="font-serif text-2xl font-semibold text-slate-900 mb-6">Häufige Fragen</h2>
      <div class="space-y-4">
        {faqSchema.mainEntity.map((q) => (
          <details class="group border border-slate-200 rounded-2xl overflow-hidden">
            <summary class="flex items-center justify-between px-6 py-4 cursor-pointer select-none text-charcoal font-medium hover:bg-slate-50 transition-colors">
              {q.name}
              <svg class="w-4 h-4 text-slate-400 group-open:rotate-180 transition-transform flex-shrink-0 ml-3" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
            </summary>
            <div class="px-6 pb-5 text-slate-600 leading-relaxed text-sm border-t border-slate-100 pt-4">
              {q.acceptedAnswer.text}
            </div>
          </details>
        ))}
      </div>
    </section>

    <ItineraryMap stops={itineraryStops} title={itineraryMapTitle} />

    <!-- Banner: Itinerary Planner -->
    <section class="relative overflow-hidden rounded-[2.5rem] bg-gradient-to-br from-slate-900 via-slate-950 to-blue-950 px-6 sm:px-10 md:px-14 py-10 md:py-14 shadow-[0_20px_60px_rgba(0,0,0,0.35)]">
      <div class="absolute -top-20 -left-20 w-72 h-72 bg-blue-500/15 rounded-full blur-3xl pointer-events-none"></div>
      <div class="absolute -bottom-20 -right-20 w-72 h-72 bg-amber-500/10 rounded-full blur-3xl pointer-events-none"></div>
      <div class="relative z-10 grid md:grid-cols-[3fr_2fr] md:items-center gap-8">
        <div>
          <span class="inline-block px-4 py-1.5 rounded-full text-xs font-semibold tracking-wide uppercase bg-med-gold/15 text-med-gold border border-med-gold/25 mb-6">Neu: Maßgeschneiderte Reise</span>
          <h2 class="text-3xl md:text-4xl font-bold text-white leading-tight mb-2">Gestalte deinen</h2>
          <p class="font-serif text-3xl md:text-4xl italic text-med-blue mb-5">idealen Reiseplan</p>
          <p class="text-white/60 text-base md:text-lg leading-relaxed max-w-xl mb-8">Beantworte ein paar einfache Fragen - Startpunkt, Tage und Interessen - und erhalte einen personalisierten Reiseplan mit Transport, Kosten und Zeiten.</p>
          <div class="flex flex-wrap gap-6">
            <div class="flex items-center gap-2.5">
              <div class="w-9 h-9 rounded-xl bg-white/5 border border-white/10 flex items-center justify-center">
                <svg class="w-4 h-4 text-med-gold" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
              </div>
              <span class="text-white/50 text-sm">30 Sekunden zur Konfiguration</span>
            </div>
            <div class="flex items-center gap-2.5">
              <div class="w-9 h-9 rounded-xl bg-white/5 border border-white/10 flex items-center justify-center">
                <svg class="w-4 h-4 text-med-gold" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 6.75V15m6-6v8.25m.503 3.498l4.875-2.437c.381-.19.622-.58.622-1.006V4.82c0-.836-.88-1.38-1.628-1.006l-3.869 1.934c-.317.159-.69.159-1.006 0L9.503 3.252a1.125 1.125 0 00-1.006 0L3.622 5.689C3.24 5.88 3 6.27 3 6.695V19.18c0 .836.88 1.38 1.628 1.006l3.869-1.934c.317-.159.69-.159 1.006 0l4.994 2.497c.317.158.69.158 1.006 0z"/></svg>
              </div>
              <span class="text-white/50 text-sm">Anti-Crowd-Tipps inklusive</span>
            </div>
          </div>
        </div>
        <div class="mt-8 md:mt-0 md:flex md:justify-center">
          <a href="/de-de/reiserouten-planer/" class="inline-flex items-center gap-2.5 px-7 py-3.5 bg-gradient-to-r from-med-gold to-yellow-600 text-slate-900 font-bold rounded-xl hover:shadow-[0_0_30px_rgba(212,175,55,0.4)] hover:scale-105 transition-all duration-300">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 2L2 12l4 0 0 6 4 0 0-4 4 0 0 4 4 0 0-6 4 0L12 2z"/></svg>
            Jetzt konfigurieren
          </a>
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="bg-gradient-to-r from-med-blue to-med-blue/80 rounded-2xl p-10 text-center text-white">
      <h2 class="font-serif text-3xl font-bold mb-3">Bereit zur Abreise?</h2>
      <p class="text-white/90 mb-6 max-w-2xl mx-auto">
        Lies den kompletten Reiseführer zu den öffentlichen Verkehrsmitteln der Amalfiküste: Anreise, Fahrpläne, Tickets und Spartipps.
      </p>
      <a href="/de-de/ratgeber/anreise/" class="inline-block bg-white text-med-blue font-semibold px-8 py-3 rounded-full hover:bg-slate-100 transition-colors">
        Transportführer →
      </a>
    </section>

  </div>

</BaseLayout>
