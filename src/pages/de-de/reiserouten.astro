---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getTranslations, getLocalePath } from '../../i18n/translations';

const lang = 'de-de';
const breadcrumbs = [
  { name: 'Home', url: '/de-de/' },
  { name: 'Planung', url: '/de-de/planung/' },
  { name: 'Reiserouten', url: '/de-de/reiserouten/' },
];
const t = getTranslations(lang);

// Card data organized by duration
const itineraries = {
  d1: [
    { title: 'Amalfiküste von Neapel', desc: 'Mit Fähre von Neapel: Amalfi, Ravello und Positano mit Sonnenuntergang am Meer.', img: '/images/costiera-hero.jpg', href: '/de-de/', tag: '1 Tag' },
    { title: 'Amalfiküste von Salerno', desc: 'Start von Salerno: weniger Menschenmassen, mehr Ruhe. Perfekt im Sommer mit Rückfahrt am Abend.', img: '/images/costiera-hero.jpg', href: '/de-de/', tag: '1 Tag' },
    { title: 'Sorrentinische Halbinsel', desc: 'Sorrent, Massa Lubrense und Marina del Cantone in einem Tag von Neapel.', img: '/images/sorrento-hero.jpg', href: '/de-de/reiserouten/1-tag/sorrentinische-halbinsel-von-neapel/', tag: '1 Tag' },
    { title: 'Wanderung Weg der Götter', desc: '7,8 km atemberaubender Ausblick von Bomerano nach Nocelle über Positano.', img: '/images/trekking-hero.jpg', href: '/de-de/reiserouten/1-tag/weg-der-goetter-trekking/', tag: '1 Tag' },
    { title: 'Capri von Sorrent', desc: 'Blaue Grotte, Faraglioni, Villa Jovis: Capri essentiell in einem Tag.', img: '/images/capri-hero.jpg', href: '/de-de/reiserouten/1-tag/capri-von-sorrent/', tag: '1 Tag' },
  ],
  d3: [
    { title: 'Klassische Amalfiküste', desc: 'Amalfi, Positano, Ravello und Cetara: das Beste der Küste in 3 Tagen.', img: '/images/costiera-hero.jpg', href: '/de-de/', tag: '3 Tage' },
    { title: 'Inseln: Ischia & Procida', desc: 'Zwei Inseln im Golf von Neapel mit Stränden, Thermalquellen und Pastellfarben.', img: '/images/ischia-hero.jpg', href: '/de-de/reiserouten/3-tage/inseln-ischia-procida/', tag: '3 Tage' },
    { title: 'Sorrent, Pompeji & Geschichte', desc: 'Kunst, Geschichte und Meer: Sorrent, Pompeji und die Halbinsel in 3 Tagen.', img: '/images/sorrento-hero.jpg', href: '/de-de/reiserouten/3-tage/sorrent-pompeji-geschichte/', tag: '3 Tage' },
  ],
  d7: [
    { title: 'Große Rundreise Küste & Halbinsel', desc: 'Eine komplette Woche: Küste, Halbinsel, Inseln und versteckte Dörfer.', img: '/images/costiera-hero.jpg', href: '/de-de/', tag: '7 Tage' },
    { title: 'Slow Travel: Dörfer & Gastronomie', desc: 'Keine Eile. Märkte, Trattorien, Wanderwege und Sonnenuntergänge im Slow Travel.', img: '/images/atrani-hero.jpg', href: '/de-de/', tag: '7 Tage' },
  ],
};
---

<BaseLayout
  title={t.meta.itineraries_title}
  description={t.meta.itineraries_description}
  lang={lang}
  pageKey="itineraries"

  heroImage="/images/itinerari-hero.jpg"
>
  <!-- Hero -->
  <section class="relative h-[45vh] sm:h-[60vh] flex items-center bg-charcoal overflow-hidden">
    <img src="/images/itinerari-hero.jpg" alt="Amalfiküste Reiserouten" class="absolute inset-0 w-full h-full object-cover" loading="eager" fetchpriority="high" decoding="sync" referrerpolicy="no-referrer"/>
    <div class="absolute inset-0 bg-gradient-to-b from-black/25 via-black/40 to-black/75"></div>
    <div class="relative z-10 max-w-7xl mx-auto px-6 py-16">
      <nav class="flex items-center gap-2 text-white/60 text-xs mb-6">
        <a href="/de-de/" class="hover:text-white transition-colors">Home</a>
        <span>/</span>
        <a href="/de-de/planung/" class="hover:text-white transition-colors">Planung</a>
        <span>/</span>
        <span class="text-white">Reiserouten</span>
      </nav>
      <div class="max-w-3xl">
        <p class="text-med-gold text-xs sm:text-sm font-medium uppercase tracking-[0.3em] mb-3">Plane deine Reise</p>
        <h1 class="font-serif text-display text-white mb-4">Reiserouten Amalfiküste</h1>
        <p class="text-xl text-white/80 leading-relaxed">1 Tag, 3 Tage oder 1 Woche: detaillierte Reiserouten um die Amalfiküste optimal zu erleben, je nachdem wie viel Zeit du hast.</p>
      </div>
    </div>
  </section>

  <!-- Intro -->
  <section class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <p class="text-lg text-slate-600 leading-relaxed">
      Die Amalfiküste bietet je nach verfügbarer Zeit unterschiedliche Erlebnisse. Ein Tag für die Highlights, drei Tage um Dörfer und lokale Rhythmen zu entdecken, eine Woche um über die Postkarte hinauszugehen. Wähle die Reiseroute die zu dir passt.
    </p>
  </section>

  <!-- 1 Tag -->
  <section class="py-12 border-t border-slate-100">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center gap-4 mb-10">
        <span class="inline-block bg-med-blue/80 text-white text-xs font-bold uppercase tracking-wider px-3 py-1.5 rounded-full">1 Tag</span>
        <h2 class="text-3xl font-bold font-serif text-charcoal">Das Beste der Küste</h2>
        <div class="flex-1 h-px bg-slate-100"></div>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {itineraries.d1.map((it) => (
          <a href={it.href} class="group block bg-white rounded-2xl border border-slate-100 overflow-hidden hover:shadow-lg hover:border-med-blue/20 transition-all duration-300">
            <!-- Image with overlay -->
            <div class="relative h-44 overflow-hidden">
              <img src={it.img} alt={it.title} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
              <div class="absolute inset-0 bg-gradient-to-t from-black/50 to-transparent" />
              <!-- Duration badge -->
              <span class="absolute bottom-3 left-3 text-[10px] font-bold uppercase tracking-wider text-white bg-med-blue/80 backdrop-blur-sm px-2.5 py-1 rounded-full">
                {it.tag}
              </span>
            </div>
            <!-- Text section -->
            <div class="p-5">
              <h3 class="font-semibold text-charcoal text-sm mb-1.5 group-hover:text-med-blue transition-colors">{it.title}</h3>
              <p class="text-xs text-slate-500 leading-relaxed">{it.desc}</p>
              <span class="mt-3 inline-flex items-center text-xs font-semibold text-med-blue gap-1 group-hover:gap-2 transition-all">
                Entdecke die Route →
              </span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- 3 Tage -->
  <section class="py-12 border-t border-slate-100">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center gap-4 mb-10">
        <span class="inline-block bg-med-gold/90 text-white text-xs font-bold uppercase tracking-wider px-3 py-1.5 rounded-full">3 Tage</span>
        <h2 class="text-3xl font-bold font-serif text-charcoal">Perfektes Tempo zwischen Entdeckungen</h2>
        <div class="flex-1 h-px bg-slate-100"></div>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {itineraries.d3.map((it) => (
          <a href={it.href} class="group block bg-white rounded-2xl border border-slate-100 overflow-hidden hover:shadow-lg hover:border-med-gold/20 transition-all duration-300">
            <!-- Image with overlay -->
            <div class="relative h-44 overflow-hidden">
              <img src={it.img} alt={it.title} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
              <div class="absolute inset-0 bg-gradient-to-t from-black/50 to-transparent" />
              <!-- Duration badge -->
              <span class="absolute bottom-3 left-3 text-[10px] font-bold uppercase tracking-wider text-white bg-med-gold/90 backdrop-blur-sm px-2.5 py-1 rounded-full">
                {it.tag}
              </span>
            </div>
            <!-- Text section -->
            <div class="p-5">
              <h3 class="font-semibold text-charcoal text-sm mb-1.5 group-hover:text-med-gold transition-colors">{it.title}</h3>
              <p class="text-xs text-slate-500 leading-relaxed">{it.desc}</p>
              <span class="mt-3 inline-flex items-center text-xs font-semibold text-med-gold gap-1 group-hover:gap-2 transition-all">
                Entdecke die Route →
              </span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- 7 Tage -->
  <section class="py-12 border-t border-slate-100">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center gap-4 mb-10">
        <span class="inline-block bg-med-terracotta/80 text-white text-xs font-bold uppercase tracking-wider px-3 py-1.5 rounded-full">7 Tage</span>
        <h2 class="text-3xl font-bold font-serif text-charcoal">Slow Travel ohne Eile</h2>
        <div class="flex-1 h-px bg-slate-100"></div>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 max-w-2xl">
        {itineraries.d7.map((it) => (
          <a href={it.href} class="group block bg-white rounded-2xl border border-slate-100 overflow-hidden hover:shadow-lg hover:border-med-terracotta/20 transition-all duration-300">
            <!-- Image with overlay -->
            <div class="relative h-44 overflow-hidden">
              <img src={it.img} alt={it.title} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
              <div class="absolute inset-0 bg-gradient-to-t from-black/50 to-transparent" />
              <!-- Duration badge -->
              <span class="absolute bottom-3 left-3 text-[10px] font-bold uppercase tracking-wider text-white bg-med-terracotta/80 backdrop-blur-sm px-2.5 py-1 rounded-full">
                {it.tag}
              </span>
            </div>
            <!-- Text section -->
            <div class="p-5">
              <h3 class="font-semibold text-charcoal text-sm mb-1.5 group-hover:text-med-terracotta transition-colors">{it.title}</h3>
              <p class="text-xs text-slate-500 leading-relaxed">{it.desc}</p>
              <span class="mt-3 inline-flex items-center text-xs font-semibold text-med-terracotta gap-1 group-hover:gap-2 transition-all">
                Entdecke die Route →
              </span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- BANNER: Reiserouten-Planer -->
  <section class="py-10 md:py-14">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="relative overflow-hidden rounded-[2.5rem] bg-gradient-to-br from-slate-900 via-slate-950 to-blue-950 px-6 sm:px-10 md:px-14 py-10 md:py-14 shadow-[0_20px_60px_rgba(0,0,0,0.35)]">
        <div class="absolute -top-20 -left-20 w-72 h-72 bg-blue-500/15 rounded-full blur-3xl pointer-events-none"></div>
        <div class="absolute -bottom-20 -right-20 w-72 h-72 bg-amber-500/10 rounded-full blur-3xl pointer-events-none"></div>
        <div class="relative z-10 grid md:grid-cols-[3fr_2fr] md:items-center gap-8">
          <div>
            <span class="inline-block px-4 py-1.5 rounded-full text-xs font-semibold tracking-wide uppercase bg-med-gold/15 text-med-gold border border-med-gold/25 mb-6">Neu: Reiseplaner</span>
            <h2 class="text-3xl md:text-4xl font-bold text-white leading-tight mb-2">Gestalte deine</h2>
            <p class="font-serif text-3xl md:text-4xl italic text-med-blue mb-5">perfekte Reiseroute</p>
            <p class="text-white/60 text-base md:text-lg leading-relaxed max-w-xl mb-8">Beantworte ein paar einfache Fragen - Startpunkt, Tage und Interessen - und erhalte eine personalisierte Reiseroute mit Transport, Kosten und Zeiten.</p>
            <div class="flex flex-wrap gap-6">
              <div class="flex items-center gap-2.5">
                <div class="w-9 h-9 rounded-xl bg-white/5 border border-white/10 flex items-center justify-center">
                  <svg class="w-4.5 h-4.5 text-med-gold" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                </div>
                <span class="text-white/50 text-sm">30 Sekunden zum Einrichten</span>
              </div>
              <div class="flex items-center gap-2.5">
                <div class="w-9 h-9 rounded-xl bg-white/5 border border-white/10 flex items-center justify-center">
                  <svg class="w-4.5 h-4.5 text-med-gold" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 6.75V15m6-6v8.25m.503 3.498l4.875-2.437c.381-.19.622-.58.622-1.006V4.82c0-.836-.88-1.38-1.628-1.006l-3.869 1.934c-.317.159-.69.159-1.006 0L9.503 3.252a1.125 1.125 0 00-1.006 0L3.622 5.689C3.24 5.88 3 6.27 3 6.695V19.18c0 .836.88 1.38 1.628 1.006l3.869-1.934c.317-.159.69-.159 1.006 0l4.994 2.497c.317.158.69.158 1.006 0z"/></svg>
                </div>
                <span class="text-white/50 text-sm">Anti-Massen-Tipps inklusive</span>
              </div>
            </div>
          </div>
          <div class="mt-8 md:mt-0 md:flex md:justify-center">
            <a href="/de-de/reiserouten-planer/" class="inline-flex items-center gap-2.5 px-7 py-3.5 bg-gradient-to-r from-med-gold to-yellow-600 text-slate-900 font-bold rounded-xl hover:shadow-[0_0_30px_rgba(212,175,55,0.4)] hover:scale-105 transition-all duration-300">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 2L2 12l4 0 0 6 4 0 0-4 4 0 0 4 4 0 0-6 4 0L12 2z"/></svg>
              Jetzt planen
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="bg-med-blue py-16 text-center">
    <div class="max-w-2xl mx-auto px-4">
      <h2 class="text-2xl font-bold text-white mb-4">Wie komme ich zur Küste?</h2>
      <p class="text-white mb-6">Alle Möglichkeiten: Zug, Fähre, Bus und private Transfers.</p>
      <a href={getLocalePath(lang, 'getting-here')}
        class="inline-block bg-med-blue text-white font-semibold px-8 py-3 rounded-full hover:bg-med-blue transition-colors">
        Reiseführer
      </a>
    </div>
  </section>
</BaseLayout>
