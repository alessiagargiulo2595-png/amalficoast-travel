---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../../components/Breadcrumbs.astro';
import CorrelationSlider from '../../../../components/CorrelationSlider.astro';

const lang = 'de-de';

const breadcrumbs = [
  { name: 'Startseite', url: '/de-de/' },
  { name: 'Erlebnisse', url: '/de-de/erlebnisse/' },
  { name: 'Wanderungen & Pfad der Götter', url: '/de-de/experiences/trekking/' },
];

const trails = [
  { name: 'Pfad der Götter', difficulty: 'EE', km: '8 km', time: '3–4h', start: 'Agerola (S. Lazzaro)', end: 'Nocelle (Positano)', highlights: 'Atemberaubende Küstenblicke, Mittelmeerflora, ohne Asphalt', cta: { href: '/de-de/reiserouten/1-tag/weg-der-goetter-trekking/' } },
  { name: 'Valle delle Ferriere', difficulty: 'E', km: '7 km RT', time: '2.5–3h', start: 'Amalfi-Zentrum', end: 'Amalfi (Rückfahrt)', highlights: 'Wasserfälle, tropische Farne, wilder Papyrus, natürlicher Schatten', cta: { href: '/de-de/blog/ferriere-tal/' } },
  { name: "Via dell'Infinito (Ravello)", difficulty: 'E', km: '5 km RT', time: '2h', start: 'Ravello', end: 'Ravello', highlights: 'Panoramablick auf die Küste, Olivenhaine, totale Stille' },
  { name: 'Punta Campanella', difficulty: 'E', km: '6 km RT', time: '2.5h', start: 'Termini (Massa Lubrense)', end: 'Termini', highlights: 'Südlichste Spitze, römische Ruinen, Capri-Blick, Meeresschutzgebiet', cta: { href: '/de-de/blog/punta-campanella/' } },
  { name: 'Fiordo di Furore', difficulty: 'E', km: '3 km RT', time: '1.5–2h', start: 'Furore', end: 'Furore', highlights: 'Verborgener Fjord, Wasserfall, natürlicher Pool, Süßwasserquelle', cta: { href: '/de-de/strande/amalfikueste/fiordo-di-furore/' } },
  { name: 'Ieranto Bay', difficulty: 'E', km: '4 km RT', time: '1.5–2h', start: 'Termini (Massa Lubrense)', end: 'Termini', highlights: 'Isolierter wilder Strand, kristallklare Bucht, Schutzgebiet, Meerblick', cta: { href: '/de-de/strande/sorrentinische-halbinsel/spiaggia-di-ieranto/' } },
  { name: 'Monte Solaro (Capri)', difficulty: 'E', km: '4 km', time: '2h (Aufstieg)', start: 'Anacapri', end: 'Anacapri (Sessellift zurück)', highlights: '589 m, 360°-Panorama, Heiligtum, Stille' },
  { name: 'Crapolla-Fjord', difficulty: 'E', km: '6 km RT', time: '2.5h', start: 'Via Casal di Torca (Massa Lubrense)', end: 'Via Casal di Torca', highlights: '700 Stufen, Felsentreppe, mittelalterliche Kapelle, römische Ruinen, Meeresschutzgebiet', cta: { href: '/de-de/blog/fiordo-di-crapolla/' } },
  { name: 'Reccumone', difficulty: 'E', km: '0.5 km RT', time: '15–20 Min', start: 'Marina del Cantone (Nerano)', end: 'Marina del Cantone', highlights: 'Wilder und ausgestatteter Strand, kristallklares Wasser, Zugang zu Fuß oder per Boot, Restaurant', cta: { href: '/de-de/blog/baia-recommone/' } },
];
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    { "@type": "Question", "name": "Ist Wandern an der Amalfiküste anstrengend?",
      "acceptedAnswer": { "@type": "Answer", "text": "Das hängt vom Weg ab. Die meisten Routen sind mit E (mittel) bewertet: ein paar Stunden auf Stein- und Treppenwegen, ohne technische Anforderungen. Nur der Pfad der Götter trägt die härtere Bewertung EE, wegen ausgesetzter Passagen ohne Geländer. Die eigentliche Schwierigkeit sind hier nicht die Höhenmeter, sondern die Stufen: Fast jeder Weg beginnt oder endet mit mehreren Hundert davon." } },
    { "@type": "Question", "name": "Welche ist die schönste Wanderung an der Amalfiküste?",
      "acceptedAnswer": { "@type": "Answer", "text": "Der Pfad der Götter ist die Signaturroute: 8 km von Agerola nach Nocelle, 3 bis 4 Stunden hoch über dem Meer, mit Positano und Capri fast durchgehend im Blick. Wer es sanfter und schattiger mag, nimmt das Valle delle Ferriere oberhalb von Amalfi, 7 km hin und zurück durch Wasserfälle und Farne." } },
    { "@type": "Question", "name": "Wann ist die beste Zeit zum Wandern an der Amalfiküste?",
      "acceptedAnswer": { "@type": "Answer", "text": "April bis Anfang Juni und September bis Oktober. Die Temperaturen liegen zwischen 16 und 24°C, das Licht ist klar und die Wege sind trocken. Juli und August sind wirklich hart: Die meisten Routen haben weder Schatten noch Wasserstellen, und mittags werden 32°C erreicht. Im Winter ist Gehen möglich, aber die Pfade werden schlammig und die Steinstufen rutschig." } },
    { "@type": "Question", "name": "In welcher Richtung sollte ich den Pfad der Götter gehen?",
      "acceptedAnswer": { "@type": "Answer", "text": "Von Agerola nach Nocelle, bergab. In der Gegenrichtung steigt man rund 500 Höhenmeter in praller Sonne, und die 1.500 Stufen hinunter nach Positano lägen dann noch vor Ihnen. Nehmen Sie morgens den SITA-Bus von Amalfi hinauf nach Agerola und gehen Sie dem Meer entgegen." } },
    { "@type": "Question", "name": "Brauche ich einen Wanderführer an der Amalfiküste?",
      "acceptedAnswer": { "@type": "Answer", "text": "Nein. Der Pfad der Götter und die anderen Hauptwege sind mit den rot-weißen CAI-Zeichen markiert und so gut besucht, dass man selten allein ist. Eine Führung lohnt sich, wenn Sie Geschichte und Pflanzenwelt verstehen wollen, wenn Sie in der Nebensaison unterwegs sind oder für weniger offensichtliche Routen wie den Fjord von Crapolla." } },
    { "@type": "Question", "name": "Welche Schuhe brauche ich zum Wandern an der Amalfiküste?",
      "acceptedAnswer": { "@type": "Answer", "text": "Wanderschuhe oder Trailschuhe mit griffiger Gummisohle. Der Kalkstein hier ist über Jahrhunderte glatt poliert und wird schon bei etwas Staub oder Feuchtigkeit tückisch. Sandalen und flache Sneaker verursachen jeden Sommer die meisten Knöchelverletzungen auf dem Pfad der Götter." } },
    { "@type": "Question", "name": "Wie komme ich zum Start des Pfads der Götter?",
      "acceptedAnswer": { "@type": "Answer", "text": "Von Amalfi mit dem SITA-Bus nach Agerola, etwa 45 Minuten, Ausstieg in Bomerano (San Lazzaro). Die Verbindungen sind dünn, fahren Sie also gegen 8:30 Uhr ab Amalfi für die Abfahrt um 9:15 Uhr. Von Positano aus müssen Sie erst nach Amalfi, was den Morgen lang macht: Erfahrene Wanderer übernachten deshalb vorher in Agerola." } },
    { "@type": "Question", "name": "Kann man zwischen den Orten der Amalfiküste wandern?",
      "acceptedAnswer": { "@type": "Answer", "text": "Ja. Die Küste ist von einem alten Netz aus Saumpfaden und Treppenwegen durchzogen, das die Dörfer verband, bevor es die SS163 gab. Der Zitronenweg zwischen Maiori und Minori ist das einfachste Beispiel, rund 2 km. Auch Nocelle nach Positano und Ravello nach Atrani verwandeln einen Transfer in eine Wanderung." } },
  ]
};

---

<BaseLayout
  title="Wandern an der Amalfiküste 2026 | Pfad der Götter & 9 Wege"
  description="Wandern an der Amalfiküste: 9 Wege im Vergleich nach Schwierigkeit, Länge und Dauer, vom Pfad der Götter (Agerola-Nocelle) bis zum Valle delle Ferriere. Beste Zeit, Ausrüstung, Anfahrt zu jedem Startpunkt."
  lang={lang}
  breadcrumbs={breadcrumbs}
  pageKey="trekking"
  schema={[faqSchema]}

  heroImage="/images/trekking-hero.jpg"
>

  <section class="relative min-h-[75vh] flex items-end bg-charcoal overflow-hidden">
    <img src="/images/trekking-hero.jpg" alt="Pfad der Götter, Amalfi Coast" class="absolute inset-0 w-full h-full object-cover" loading="eager" fetchpriority="high" decoding="sync" referrerpolicy="no-referrer"/>

    <div class="absolute inset-0 bg-gradient-to-b from-black/75 via-black/40 to-black/70"></div>
    <div class="relative z-10 max-w-7xl mx-auto px-6 pb-16 pt-32">
      <div class="max-w-3xl">
        <p class="text-med-gold text-xs sm:text-sm font-medium uppercase tracking-[0.3em] mb-3">Erlebnisse</p>
        <h1 class="font-serif text-display text-white mb-4">Wandern an der Amalfiküste</h1>
        <p class="text-xl text-white/80 leading-relaxed max-w-2xl">
          Die Amalfiküste ist nicht nur Strände und Fähren: Sie ist auch eine der spektakulärsten Landschaften Europas zum Erkunden zu Fuß. Vom legendären Pfad der Götter zu den Wasserfällen des Valle delle Ferriere.
        </p>
      </div>
    </div>
    <Breadcrumbs breadcrumbs={breadcrumbs} />
  </section>

  <div class="max-w-editorial mx-auto px-4 sm:px-6 lg:px-8 py-16 space-y-12">

    <section>
      <h2 class="font-serif text-3xl font-bold text-slate-900 mb-3 text-center">Wichtige Wanderwege</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {trails.map((t, i) => {
          const isGold = i % 2 === 0;
          return (
          <div class={`border rounded-[2rem] p-7 hover:shadow-lg transition-all w-full sm:w-auto ${isGold ? 'bg-med-gold border-med-gold' : 'bg-med-blue border-med-blue'}`}>
            <div class="mb-5">
              <h3 class={`font-bold text-lg mb-3 ${isGold ? 'text-charcoal' : 'text-white'}`}>{t.name}</h3>
              <span class={`text-[10px] uppercase tracking-wide px-3 py-1.5 rounded-full font-medium flex-shrink-0 w-fit ${t.difficulty === 'EE' ? 'bg-red-50 text-red-600' : isGold ? 'bg-white/40 text-charcoal' : 'bg-white/20 text-white'}`}>
                {t.difficulty === 'EE' ? 'EE - Anspruchsvoll' : 'E - Moderat'}
              </span>
            </div>
            <div class="space-y-3 mb-5">
              <div><span class={`text-xs font-semibold ${isGold ? 'text-charcoal/70' : 'text-white/70'}`}>ENTFERNUNG</span><br /><span class={`font-semibold ${isGold ? 'text-charcoal' : 'text-white'}`}>{t.km}</span></div>
              <div><span class={`text-xs font-semibold ${isGold ? 'text-charcoal/70' : 'text-white/70'}`}>DAUER</span><br /><span class={`font-semibold ${isGold ? 'text-charcoal' : 'text-white'}`}>{t.time}</span></div>
              <div><span class={`text-xs font-semibold ${isGold ? 'text-charcoal/70' : 'text-white/70'}`}>START</span><br /><span class={`font-semibold text-sm ${isGold ? 'text-charcoal' : 'text-white'}`}>{t.start}</span></div>
              <div><span class={`text-xs font-semibold ${isGold ? 'text-charcoal/70' : 'text-white/70'}`}>ENDE</span><br /><span class={`font-semibold text-sm ${isGold ? 'text-charcoal' : 'text-white'}`}>{t.end}</span></div>
            </div>
            <p class={`text-xs sm:text-sm leading-relaxed font-medium mb-4 ${isGold ? 'text-charcoal' : 'text-white'}`}>{t.highlights}</p>
            {t.cta && (
              <a href={t.cta.href} class={`inline-flex items-center gap-2 font-semibold text-xs px-4 py-2 rounded-lg transition-all ${isGold ? 'bg-med-blue text-white hover:bg-med-blue/90' : 'bg-med-gold text-white hover:bg-med-gold/90'}`}>
                Mehr erfahren →
              </a>
            )}
          </div>
        );
        })}
      </div>
    </section>

    <section class="bg-charcoal text-white rounded-[2rem] p-8">
      <h2 class="font-serif text-2xl font-bold text-med-gold mb-8">Schnellleitfaden zu Küstenwanderwegen</h2>
      <div class="grid sm:grid-cols-2 gap-6">
        <div>
          <p class="text-white/60 text-xs sm:text-sm mb-1">Anreise zum Start</p>
          <p class="text-xs sm:text-sm leading-relaxed">Aus Amalfi: SITA-Bus nach Agerola (begrenzte Verbindungen, ca. 45 Min). Empfohlen: Amalfi um 8:30 verlassen, um den 9:15-Bus nach Agerola zu erreichen.</p>
        </div>
        <div>
          <p class="text-white/60 text-xs sm:text-sm mb-1">Rückkehr vom Ziel</p>
          <p class="text-xs sm:text-sm leading-relaxed">Von Nocelle: Minibus nach Positano (ca. 15 Min) oder zu Fuß hinunter (~1.000 Stufen, 45 Min). Von Positano: SITA-Bus oder Fähre zu Amalfi/Sorrento/Neapel.</p>
        </div>
        <div>
          <p class="text-white/60 text-xs sm:text-sm mb-1">Was du mitnehmen solltest</p>
          <p class="text-xs sm:text-sm leading-relaxed">Wanderschuhe (keine Sandalen), 1,5L Wasser, Hut, Sonnencreme, Snacks, leichte Jacke. Der Weg hat keine Wasserquellen oder Läden.</p>
        </div>
        <div>
          <p class="text-white/60 text-xs sm:text-sm mb-1">Beste Jahreszeit</p>
          <p class="text-xs sm:text-sm leading-relaxed">April-Juni und September-Oktober. Im Juli und August macht die Hitze es anstrengend und überfüllt. Im Winter möglich, aber schlammig und rutschig.</p>
        </div>
      </div>
    </section>


    <!-- Quale sentiero scegliere -->
    <section>
      <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">Welchen Weg sollten Sie wählen</h2>
      <p class="text-slate-600 text-lg leading-relaxed mb-8">Neun Optionen sind zu viele für eine Reise. In der Praxis entscheidet, wie viel Zeit Sie haben und was am Ende auf Sie warten soll.</p>
      <ul class="space-y-4 text-slate-600">
        <li class="flex items-start gap-3">
          <span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span>
          <span class="text-slate-700"><strong>Nur eine Wanderung, und es soll die berühmte sein.</strong> Der <a href="/de-de/reiserouten/1-tag/weg-der-goetter-trekking/" class="text-med-blue hover:underline">Pfad der Götter</a>. Nichts sonst an dieser Küste bietet dieses Verhältnis von Aufwand zu Aussicht, und am Ende wartet in <a href="/de-de/amalfikueste/positano/" class="text-med-blue hover:underline">Positano</a> ein Bad.</span>
        </li>
        <li class="flex items-start gap-3">
          <span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span>
          <span class="text-slate-700"><strong>Sie sind im Juli oder August hier.</strong> Das <a href="/de-de/blog/ferriere-tal/" class="text-med-blue hover:underline">Valle delle Ferriere</a>, die einzige große Route mit echtem Schatten und fließendem Wasser. Eine feuchte Schlucht oberhalb von <a href="/de-de/amalfikueste/amalfi/" class="text-med-blue hover:underline">Amalfi</a> voller Farne, die dort seit der letzten Eiszeit wachsen.</span>
        </li>
        <li class="flex items-start gap-3">
          <span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span>
          <span class="text-slate-700"><strong>Sie wandern mit Kindern oder nach einem großen Mittagessen.</strong> Der <a href="/de-de/blog/zitronenweg/" class="text-med-blue hover:underline">Zitronenweg</a> zwischen Maiori und Minori, rund 2 km unter Zitronenpergolen, oder die Runde der Via dell’Infinito in <a href="/de-de/amalfikueste/ravello/" class="text-med-blue hover:underline">Ravello</a>.</span>
        </li>
        <li class="flex items-start gap-3">
          <span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span>
          <span class="text-slate-700"><strong>Die Wanderung soll am Strand enden.</strong> Die <a href="/de-de/strande/sorrentinische-halbinsel/spiaggia-di-ieranto/" class="text-med-blue hover:underline">Bucht von Ieranto</a> oder der <a href="/de-de/blog/fiordo-di-crapolla/" class="text-med-blue hover:underline">Fjord von Crapolla</a>, beide auf der Sorrentinischen Halbinsel und nur zu Fuß oder über das Meer erreichbar, weshalb sie ruhig bleiben.</span>
        </li>
        <li class="flex items-start gap-3">
          <span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span>
          <span class="text-slate-700"><strong>Sie haben einen halben Tag auf den Inseln.</strong> Der Monte Solaro auf <a href="/de-de/inseln/capri/" class="text-med-blue hover:underline">Capri</a>: In zwei Stunden von Anacapri hinauf und mit dem Sessellift zurück, oder umgekehrt, wenn die Knie das lieber mögen.</span>
        </li>
      </ul>
    </section>

    <!-- Difficolta -->
    <section>
      <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">Was die Schwierigkeitsgrade bedeuten</h2>
      <p class="text-slate-600 text-lg leading-relaxed mb-8">Die Karten oben verwenden die Skala des Italienischen Alpenvereins, die Sie auch auf den rot-weißen Markierungen entlang der Wege wiederfinden. Zwei Grade decken alles an dieser Küste ab.</p>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div class="bg-white p-6 rounded-[2rem] border border-slate-100 shadow-sm">
          <p class="text-med-gold text-xs font-medium uppercase tracking-[0.2em] mb-2">Grad E</p>
          <h3 class="font-bold text-slate-900 mb-2 text-lg">Mittel, keine Erfahrung nötig</h3>
          <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Ein markierter Weg mit klarem Untergrund. Sie brauchen eine vernünftige Grundkondition und ordentliche Schuhe, mehr nicht. Acht der neun Routen liegen auf diesem Niveau, inklusive Valle delle Ferriere und allem auf der Sorrentinischen Halbinsel.</p>
        </div>
        <div class="bg-white p-6 rounded-[2rem] border border-slate-100 shadow-sm">
          <p class="text-med-gold text-xs font-medium uppercase tracking-[0.2em] mb-2">Grad EE</p>
          <h3 class="font-bold text-slate-900 mb-2 text-lg">Anspruchsvoll, Trittsicherheit erforderlich</h3>
          <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Nur der Pfad der Götter. Der Grad kommt von kurzen ausgesetzten Abschnitten, wo der Weg über einem tiefen Abbruch ohne Geländer schmal wird. Es wird nicht geklettert und keine Ausrüstung gebraucht, aber es ist nicht der Ort, um Höhenangst zu entdecken.</p>
        </div>
      </div>
      <p class="text-slate-600 text-lg leading-relaxed mt-8">Auf das eigentliche Markenzeichen dieser Küste bereitet Sie aber keiner der beiden Grade vor: die Stufen. Der Abstieg von Nocelle nach Positano sind rund 1.500 Stufen, Crapolla etwa 700, und der Weg zu den meisten Stränden misst sich eher in Treppenläufen als in Metern. Es ist das Bergabgehen, das am nächsten Morgen in den Beinen sitzt, weshalb Stöcke hier mehr bringen, als die Höhenmeter vermuten lassen.</p>
    </section>

    <!-- Stagione -->
    <section>
      <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">Wann man gehen sollte, und wann nicht</h2>
      <p class="text-slate-600 text-lg leading-relaxed mb-8">Die Jahreszeit zählt hier mehr als in den meisten Wandergebieten, denn diese Wege sind nach Süden ausgerichteter Kalkstein, fast ohne Baumbestand und ohne Wasserstellen unterwegs.</p>
      <div class="overflow-hidden rounded-[2rem] border border-slate-100 shadow-sm">
        <table class="w-full text-xs sm:text-sm">
          <thead class="bg-slate-900 text-white">
            <tr>
              <th class="text-left p-5 font-serif font-bold text-med-gold">Zeitraum</th>
              <th class="text-left p-5 font-serif font-bold text-med-gold">Bedingungen</th>
              <th class="text-left p-5 font-serif font-bold text-med-gold">Urteil</th>
            </tr>
          </thead>
          <tbody class="bg-white">
            <tr class="border-b border-slate-100">
              <td class="p-5 font-bold">April bis Anfang Juni</td>
              <td class="p-5 text-slate-600">13-24°C, blühende Hänge, trockene Wege</td>
              <td class="p-5 text-slate-600">Das beste Fenster des Jahres</td>
            </tr>
            <tr class="border-b border-slate-100">
              <td class="p-5 font-bold">Ende Juni</td>
              <td class="p-5 text-slate-600">Schnell wärmer, längeres Licht</td>
              <td class="p-5 text-slate-600">In Ordnung bei Start im Morgengrauen</td>
            </tr>
            <tr class="border-b border-slate-100">
              <td class="p-5 font-bold">Juli und August</td>
              <td class="p-5 text-slate-600">Bis 32°C, kein Schatten, UV-Index 9-10</td>
              <td class="p-5 text-slate-600">Vor 8:00 Uhr oder gar nicht</td>
            </tr>
            <tr class="border-b border-slate-100">
              <td class="p-5 font-bold">September und Oktober</td>
              <td class="p-5 text-slate-600">16-27°C, klare Luft, weniger Andrang</td>
              <td class="p-5 text-slate-600">Ebenbürtig zum Frühling, wärmeres Meer</td>
            </tr>
            <tr class="border-b border-slate-100">
              <td class="p-5 font-bold">November bis März</td>
              <td class="p-5 text-slate-600">Regen, Schlamm, polierter Stein</td>
              <td class="p-5 text-slate-600">Möglich, und oft menschenleer</td>
            </tr>
          </tbody>
        </table>
      </div>
      <p class="text-slate-600 text-lg leading-relaxed mt-8">Wenn Ihre Termine im Hochsommer feststehen, hilft die Uhr mehr als der Kalender. Starten Sie mit dem ersten Licht, verlassen Sie den Grat bis elf und verbringen Sie den Nachmittag auf Meereshöhe. Das vollständige Bild zu Temperaturen und Meer im Jahresverlauf finden Sie im Ratgeber zur <a href="/de-de/ratgeber/reisezeit/" class="text-med-blue hover:underline">besten Reisezeit</a>.</p>
    </section>

    <!-- FAQ -->
    <section>
      <h2 class="font-serif text-3xl font-bold text-slate-900 mb-8">Häufige Fragen</h2>
      <div class="space-y-4">
        {faqSchema.mainEntity.map((item) => (
          <details class="bg-white rounded-[2rem] border border-slate-100 shadow-sm p-6 group">
            <summary class="font-bold text-slate-900 cursor-pointer list-none flex items-start justify-between gap-4">
              <span>{item.name}</span>
              <span class="text-med-gold flex-shrink-0 transition-transform group-open:rotate-45">+</span>
            </summary>
            <p class="text-slate-600 text-xs sm:text-sm leading-relaxed mt-4">{item.acceptedAnswer.text}</p>
          </details>
        ))}
      </div>
    </section>

  </div>

  <CorrelationSlider
    heading="Erkunden Sie Wanderziele"
    items={[
      { name: 'Positano',       href: '/de-de/amalfikueste/positano/',             tag: 'Wendepunkt des Pfads',      desc: 'Das bunte Dorf, wo der Pfad der Götter endet.' },
      { name: 'Amalfi',         href: '/de-de/amalfikueste/amalfi/',               tag: 'Startpunkt des Tals',    desc: 'Ausgangspunkt für das Valle delle Ferriere.' },
      { name: 'Massa Lubrense', href: '/de-de/', tag: 'Punta Campanella', desc: 'Meeresschutzgebiet mit dem Weg zu Punta Campanella.' },
      { name: 'Capri',          href: '/de-de/inseln/capri/',                        tag: 'Monte Solaro',   desc: 'Sessellift oder Wanderung zum 589-m-Gipfel des Monte Solaro.' },
    ]}
  />

</BaseLayout>
