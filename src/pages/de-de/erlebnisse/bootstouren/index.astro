---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../../components/Breadcrumbs.astro';
import CorrelationSlider from '../../../../components/CorrelationSlider.astro';

const lang = 'de-de';

const breadcrumbs = [
  { name: 'Startseite', url: '/de-de/' },
  { name: 'Erlebnisse', url: '/de-de/erlebnisse/' },
  { name: 'Bootstouren', url: '/de-de/erlebnisse/bootstouren/' },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Was kostet eine Bootstour an der Amalfiküste?",
      "acceptedAnswer": { "@type": "Answer", "text": "Eine Gruppenbootstour an der Amalfiküste (4-6 Stunden) kostet €50-€80 pro Person. Private Bootsmiete (ohne Skipper) ab €200/Tag für kleine Boote; mit Skipper €400-800/Tag. In Capri kosten Ruderbootfahrten zur Blauen Grotte ~€15." }
    },
    {
      "@type": "Question",
      "name": "Von wo starten die Bootstouren?",
      "acceptedAnswer": { "@type": "Answer", "text": "Bootstouren starten hauptsächlich von: Positano (für die Küste und Capri), Amalfi (für die Küste und Grotten), Sorrent (für Capri und die Küste), Marina Grande di Capri (für Faraglioni und Blaue Grotte). Im Sommer 1-2 Tage im Voraus buchen." }
    },
    {
      "@type": "Question",
      "name": "Werden Bootstouren bei schlechtem Wetter abgesagt?",
      "acceptedAnswer": { "@type": "Answer", "text": "Ja, alle Bootstouren werden bei rauer See (Wellen über 0,8-1m) oder starkem Wind abgesagt. Absagen sind im April, Oktober und bei Tramontana häufig. Immer die Meeresbedingungen am Vortag auf windguru.cz oder windy.com prüfen." }
    }
  ]
};

const tours = [
  { name: 'Faraglioni-Tour, Capri', from: 'Marina Grande, Capri', duration: '1-2 Std.', price: '€18-25', highlights: 'Faraglioni, Grotta Verde, Durchfahrt unterm Mezzo-Bogen, Schnorcheln', type: 'Gruppe', img: '/images/faraglioni-capri.webp' },
  { name: 'Blaue Grotte (Ruderboot)', from: 'Marina Grande, Capri', duration: '30 Min.', price: '€15 + €14 Eintritt', highlights: 'Einzigartiges blaues Licht, Ruderboote, unvergessliches Erlebnis', type: 'Einzeln', img: '/images/marina-piccola-capri.webp' },
  { name: 'Küstentour ab Positano', from: 'Positano, Spiaggia Grande', duration: '4-6 Std.', price: '€50-80', highlights: 'Smaragdgrotte, Praiano, Amalfi vom Meer, Schnorcheln in versteckten Buchten', type: 'Gruppe', img: '/images/positano-hero.webp' },
  { name: 'Küstentour ab Amalfi', from: 'Amalfi, Hafen', duration: '3-5 Std.', price: '€40-70', highlights: 'Smaragdgrotte, Positano, unzugängliche Buchten, Mittagessen auf See', type: 'Gruppe', img: '/images/amalfi-hero.webp' },
  { name: 'Privatboot Sorrent → Capri', from: 'Sorrent, Marina Piccola', duration: 'Ganztag', price: '€400-800', highlights: 'Individuelle Route, keine Massen, Schnorcheln, Mittagessen an Bord', type: 'Privat', img: '/images/sorrento-hero.webp' },
  { name: 'Sonnenuntergangs-Cruise', from: 'Positano / Amalfi', duration: '2-3 Std.', price: '€60-90', highlights: 'Goldene Stunde, Prosecco an Bord, die Küste im Sonnenuntergangslicht', type: 'Gruppe', img: '/images/tramonto-costiera.webp' },
];

const tips = [
  'Für die Blaue Grotte in Capri: vor 10:00 Uhr ankommen. Die Nachmittagsschlange kann 2 Stunden dauern.',
  'Gruppenführungen ab Positano sind ideal für Alleinreisende: Leute kennenlernen, die Küste sehen, weniger ausgeben.',
  'Mit Familie (Kindern): Touren von max. 3-4 Std. wählen und schnelle Schlauchboote meiden (mehr Rollen).',
  'Die Smaragdgrotte ab Amalfi ist auch zu Fuß erreichbar (€5 Eintritt): keine Tour nötig, wenn man ein Transportmittel hat.',
  'Online mindestens 1-2 Tage im Voraus buchen im Juli-August: die Plätze sind schnell weg.',
];
---

<BaseLayout
  title="Bootstouren Amalfiküste 2026 | Capri, Positano, Blaue Grotte"
  description="Beste Bootstouren an der Amalfiküste: Capri Faraglioni, Blaue Grotte, Touren ab Positano und Amalfi. Preise, Dauer und Tipps für die richtige Tour."
  lang={lang}
  breadcrumbs={breadcrumbs}
  schema={[faqSchema]}
  pageKey="boat-tours"
  heroImage="/images/capri-hero.webp"
>

  <!-- HERO -->
  <section class="relative h-[90svh] sm:min-h-[90vh] md:h-screen flex flex-col items-center justify-center bg-charcoal overflow-hidden">
    <img src="/images/capri-hero.webp" alt="Bootstour, Amalfiküste" referrerpolicy="no-referrer" class="absolute inset-0 w-full h-full object-cover object-center" loading="eager" fetchpriority="high" decoding="sync" />
    <div class="absolute inset-0 bg-gradient-to-b from-black/60 sm:from-black/55 via-black/40 sm:via-black/30 to-black/70 sm:to-black/65"></div>

    <div class="relative text-center px-6 max-w-4xl mx-auto md:flex md:flex-col md:justify-center">
      <p class="text-med-gold text-xs font-medium uppercase tracking-[0.3em] mb-6 mt-6">Erlebnisse · Meer & Boote</p>
      <h1 class="font-serif text-white leading-tight mb-6" style="font-size: clamp(2.5rem, 6vw, 5rem); letter-spacing: -0.02em;">
        Boots <em class="not-italic text-med-gold">touren</em>
      </h1>
      <p class="text-blue-100 text-lg md:text-xl leading-relaxed max-w-2xl mx-auto mb-[4vh] md:mb-0 font-light">
        Die Amalfiküste vom Meer aus ist eine andere Welt: vom Land unerreichbare Grotten, versteckte Buchten und die <strong>Faraglioni von Capri</strong> über deinem Kopf. Von günstigen Gruppentouren bis zu privaten Charter.
      </p>
      <div class="flex flex-row gap-3 justify-center md:mt-6">
        <a href="https://gyg.me/XJThZqw1" target="_blank" rel="sponsored noopener"
           class="inline-block bg-med-gold text-slate-900 font-semibold px-8 py-3.5 rounded-full hover:scale-105 hover:shadow-[0_8px_30px_rgba(212,175,55,0.4)] transition-all duration-300 text-xs sm:text-sm">
          Auf GetYourGuide buchen
        </a>
        <a href="#tours"
           class="inline-block border-2 border-white/50 text-white font-medium px-8 py-3.5 rounded-full hover:bg-white/10 hover:border-white transition-all duration-300 text-xs sm:text-sm">
          Touren ansehen
        </a>
      </div>
    </div>

    <div class="absolute bottom-[2vh] md:bottom-[4vh] left-1/2 -translate-x-1/2 flex flex-col items-center gap-2 text-white/40 z-20">
      <svg class="w-4 h-4 animate-bounce" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
      </svg>
    </div>

    <Breadcrumbs breadcrumbs={breadcrumbs} />
  </section>

  <!-- KEY FACTS -->
  <section class="bg-white py-16">
    <div class="max-w-7xl mx-auto px-6">
      <p class="text-med-gold text-xs uppercase tracking-[0.3em] font-medium text-center mb-3">Im Überblick</p>
      <div class="w-20 h-1 bg-med-gold mx-auto rounded-full mb-12"></div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 md:gap-8">
        <div class="group bg-slate-900 p-8 rounded-[2rem] border border-slate-800 hover:border-med-gold/40 transition-all duration-300">
          <div class="w-14 h-14 rounded-2xl bg-med-gold/15 text-med-gold flex items-center justify-center mb-6 group-hover:scale-110 transition-transform">
            <svg class="w-7 h-7" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6l4 2"/><circle cx="12" cy="12" r="9" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </div>
          <div class="font-serif text-5xl font-bold text-white mb-3 tracking-tight">4-6 Std.</div>
          <p class="text-white/80 font-medium mb-2">durchschnittliche Tourdauer</p>
          <p class="text-white/60 text-xs sm:text-sm leading-relaxed font-light">Komplette Küste und Capri; kürzere Optionen (1-2 Std.) nur für die Faraglioni.</p>
        </div>

        <div class="group bg-slate-900 p-8 rounded-[2rem] border border-slate-800 hover:border-med-gold/40 transition-all duration-300">
          <div class="w-14 h-14 rounded-2xl bg-med-gold/15 text-med-gold flex items-center justify-center mb-6 group-hover:scale-110 transition-transform">
            <svg class="w-7 h-7" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 1v22M5 8h14M5 16h14"/></svg>
          </div>
          <div class="font-serif text-5xl font-bold text-white mb-3 tracking-tight">€50-80</div>
          <p class="text-white/80 font-medium mb-2">Gruppentour, pro Person</p>
          <p class="text-white/60 text-xs sm:text-sm leading-relaxed font-light">Private Charter ab €400/Tag. Blaue Grotte mit Ruderboot ~€15 plus €14 Eintritt.</p>
        </div>

        <div class="group bg-slate-900 p-8 rounded-[2rem] border border-slate-800 hover:border-med-gold/40 transition-all duration-300">
          <div class="w-14 h-14 rounded-2xl bg-med-gold/15 text-med-gold flex items-center justify-center mb-6 group-hover:scale-110 transition-transform">
            <svg class="w-7 h-7" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0Z"/><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0Z"/></svg>
          </div>
          <div class="font-serif text-5xl font-bold text-white mb-3 tracking-tight">4</div>
          <p class="text-white/80 font-medium mb-2">Abfahrtshäfen</p>
          <p class="text-white/60 text-xs sm:text-sm leading-relaxed font-light">Positano, Amalfi, Sorrent und Marina Grande di Capri. Nach Standort wählen.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- TOURS GRID -->
  <section id="tours" class="py-16 bg-med-cream">
    <div class="max-w-7xl mx-auto px-6">
      <div class="flex flex-col md:flex-row justify-between items-end mb-12 gap-6">
        <div class="max-w-2xl">
          <p class="text-med-gold text-xs font-bold uppercase tracking-[0.3em] mb-3">Wähle deine Tour</p>
          <h2 class="font-serif text-4xl md:text-5xl font-bold text-slate-900 tracking-tight mb-4">Beliebteste Touren</h2>
          <div class="w-20 h-1 bg-med-gold rounded-full mb-4"></div>
          <p class="text-slate-500 text-lg font-light">Sechs Touren für jeden Geschmack und jedes Budget, von den ikonischen Faraglioni bis zur Sonnenuntergangs-Cruise mit Prosecco an Bord.</p>
        </div>
        <a href="https://gyg.me/XJThZqw1" target="_blank" rel="sponsored noopener" class="group flex items-center gap-2 text-med-blue font-semibold hover:text-med-gold transition-colors flex-shrink-0">
          Alle auf GetYourGuide ansehen
          <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {tours.map((t) => (
          <a href="https://gyg.me/XJThZqw1" target="_blank" rel="sponsored noopener" class="group cursor-pointer bg-transparent">
            <div class="relative aspect-square md:aspect-[4/5] overflow-hidden rounded-[3rem] mb-6 sm:shadow-none md:shadow-[0_20px_50px_rgba(0,0,0,0.3)]">
              <img src={t.img} alt={t.name} referrerpolicy="no-referrer" class="w-full h-full object-cover transition-transform duration-1000 group-hover:scale-110" loading="lazy" decoding="async" />
              <div class="absolute inset-0 hidden xl:block bg-gradient-to-t from-black/90 via-black/20 to-transparent" />
              <div class="absolute top-6 right-6">
                <span class={`text-[10px] uppercase tracking-wider px-3 py-1 rounded-full font-bold backdrop-blur-sm ${t.type === 'Privat' ? 'bg-med-gold/90 text-slate-900' : t.type === 'Einzeln' ? 'bg-white/90 text-med-blue' : 'bg-white/80 text-slate-700'}`}>
                  {t.type}
                </span>
              </div>
              <div class="absolute bottom-8 left-8 right-8">
                <span class="text-med-gold text-xs font-bold uppercase tracking-[0.3em] mb-2 block">{t.duration} · {t.price}</span>
                <h3 class="font-serif text-xl md:text-3xl font-bold text-white tracking-tight">{t.name}</h3>
              </div>
            </div>
            <p class="text-slate-500 text-xs sm:text-sm leading-relaxed font-light mb-4">{t.highlights}</p>
            <div class="flex items-center gap-2 text-[10px] uppercase tracking-wider font-bold text-med-blue">
              <svg class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0Z"/><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0Z"/></svg>
              {t.from}
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- BANNER: Reiserouten-Planer -->
  <section class="py-10 md:py-14 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6">
      <div class="relative overflow-hidden rounded-[2.5rem] bg-gradient-to-br from-slate-900 via-slate-950 to-blue-950 px-6 sm:px-10 md:px-14 py-10 md:py-14 shadow-[0_20px_60px_rgba(0,0,0,0.35)]">
        <div class="absolute -top-20 -left-20 w-72 h-72 bg-blue-500/15 rounded-full blur-3xl pointer-events-none"></div>
        <div class="absolute -bottom-20 -right-20 w-72 h-72 bg-amber-500/10 rounded-full blur-3xl pointer-events-none"></div>

        <div class="relative z-10 grid md:grid-cols-[3fr_2fr] md:items-center gap-8">
          <div>
            <span class="inline-block px-4 py-1.5 rounded-full text-xs font-semibold tracking-wide uppercase bg-med-gold/15 text-med-gold border border-med-gold/25 mb-6">Neu: Persönlicher Reiseplaner</span>

            <h2 class="text-3xl md:text-4xl font-bold text-white leading-tight mb-2">Gestalte deine</h2>
            <p class="font-serif text-3xl md:text-4xl italic text-med-blue mb-5">perfekte Route</p>

            <p class="text-white/60 text-base md:text-lg leading-relaxed max-w-xl mb-8">
              Beantworte ein paar einfache Fragen - Ausgangspunkt, Tage und Interessen - und erhalte eine personalisierte Reiseroute mit Transport, Kosten und Zeiten.
            </p>

            <div class="flex flex-wrap gap-6">
              <div class="flex items-center gap-2.5">
                <div class="w-9 h-9 rounded-xl bg-white/5 border border-white/10 flex items-center justify-center">
                  <svg class="w-4.5 h-4.5 text-med-gold" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                </div>
                <span class="text-white/50 text-sm">30 Sekunden zum Einrichten</span>
              </div>
              <div class="flex items-center gap-2.5">
                <div class="w-9 h-9 rounded-xl bg-white/5 border border-white/10 flex items-center justify-center">
                  <svg class="w-4.5 h-4.5 text-med-gold" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 6.75V15m6-6v8.25m.503 3.498l4.875-2.437c.381-.19.622-.58.622-1.006V4.82c0-.836-.88-1.38-1.628-1.006l-3.869 1.934c-.317.159-.69.159-1.006 0L9.503 3.252a1.125 1.125 0 00-1.006 0L3.622 5.689C3.24 5.88 3 6.27 3 6.695V19.18c0 .836.88 1.38 1.628 1.006l3.869-1.934c.317-.159.69-.159 1.006 0l4.994 2.497c.317.158.69.158 1.006 0z"/></svg>
                </div>
                <span class="text-white/50 text-sm">Anti-Massen-Tipps inklusive</span>
              </div>
            </div>
          </div>

          <div class="mt-8 md:mt-0 md:flex md:justify-center">
            <a href="/de-de/reiserouten-planer/" class="inline-flex items-center gap-2.5 px-7 py-3.5 bg-gradient-to-r from-med-gold to-yellow-600 text-slate-900 font-bold rounded-xl hover:shadow-[0_0_30px_rgba(212,175,55,0.4)] hover:scale-105 transition-all duration-300">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 2L2 12l4 0 0 6 4 0 0-4 4 0 0 4 4 0 0-6 4 0L12 2z"/></svg>
              Jetzt planen
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- TIPS -->
  <section class="py-16 bg-white">
    <div class="max-w-7xl mx-auto px-6">
      <div class="text-center mb-12">
        <p class="text-med-gold text-xs font-bold uppercase tracking-[0.3em] mb-3">Insider-Tipps</p>
        <h2 class="font-serif text-4xl md:text-5xl font-bold text-slate-900 mb-4">Die richtige Tour wählen</h2>
        <div class="w-20 h-1 bg-med-gold mx-auto rounded-full"></div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 max-w-5xl mx-auto">
        {tips.map((tip, i) => (
          <div class="group bg-med-cream p-7 rounded-[2rem] border border-med-gold/20 hover:border-med-gold/50 transition-colors flex items-start gap-4">
            <div class="w-10 h-10 rounded-xl bg-med-gold/15 text-med-gold flex-shrink-0 flex items-center justify-center font-serif font-bold text-lg">
              {String(i + 1).padStart(2, '0')}
            </div>
            <p class="text-charcoal text-xs sm:text-sm leading-relaxed pt-1.5">{tip}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section id="faq" class="py-16 bg-med-cream">
    <div class="max-w-4xl mx-auto px-6">
      <div class="text-center mb-12">
        <p class="text-med-gold text-xs font-bold uppercase tracking-[0.3em] mb-3">Wissenswertes</p>
        <h2 class="font-serif text-4xl md:text-5xl font-bold text-slate-900 mb-4">Häufig gestellte Fragen</h2>
        <div class="w-20 h-1 bg-med-gold mx-auto rounded-full"></div>
      </div>

      <div class="space-y-4">
        {faqSchema.mainEntity.map((q) => (
          <details class="group bg-white border border-slate-200 rounded-2xl overflow-hidden hover:border-med-gold/40 transition-colors">
            <summary class="flex items-center justify-between px-6 py-5 cursor-pointer select-none text-charcoal font-medium">
              <span class="text-sm sm:text-base">{q.name}</span>
              <svg class="w-4 h-4 text-med-gold group-open:rotate-180 transition-transform flex-shrink-0 ml-3" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
            </summary>
            <div class="px-6 pb-5 text-slate-600 leading-relaxed text-xs sm:text-sm border-t border-slate-100 pt-4">
              {q.acceptedAnswer.text}
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <CorrelationSlider
    heading="Tour-Ziele entdecken"
    items={[
      { name: 'Capri',    href: '/de-de/inseln/capri/',                       tag: 'Faraglioni',         desc: 'Blaue Grotte, Faraglioni-Tour und unzugängliche Buchten.' },
      { name: 'Positano', href: '/de-de/amalfikueste/positano/',              tag: 'Küstentouren',       desc: 'Ausgangspunkt für Küstentouren nach Osten.' },
      { name: 'Amalfi',   href: '/de-de/amalfikueste/amalfi/',                tag: 'Smaragdgrotte',      desc: 'Die Smaragdgrotte und Touren in Richtung Positano.' },
      { name: 'Procida',  href: '/de-de/inseln/procida/',                     tag: 'Authentische Insel', desc: 'Bootsausflüge um die kleine Fischerinsel.' },
    ]}
  />

</BaseLayout>
