---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getTranslations, getLocalePath } from '../../../i18n/translations';

const lang = 'de-de';
const t = getTranslations(lang);

const breadcrumbs = [
  { name: 'Home', url: '/de-de/' },
  { name: 'Planung', url: '/de-de/planung/' },
];

// Guide articles data
const guides = [
  {
    title: 'Anreise',
    desc: 'Zug, Flugzeug, Fähre oder Auto: alle Optionen um die Amalfiküste zu erreichen.',
    img: '/images/come-arrivare-hero.jpg',
    href: '/de-de/ratgeber/anreise/',
    tag: 'Verkehr'
  },
  {
    title: 'SITA-Bus',
    desc: 'Der komplette Leitfaden zu den lokalen Bussen: Fahrpläne, Tarife, Fahrkarten und Routen entlang der Küste.',
    img: '/images/bus-sita-hero.jpg',
    href: '/de-de/ratgeber/sita-bus/',
    tag: 'Verkehr'
  },
  {
    title: 'Fähren',
    desc: 'Von lokalen Fähren zu Sommerrouten von Neapel und Salerno: wie man jede Stadt auf dem Meer erreicht.',
    img: '/images/traghetti-hero.jpg',
    href: '/de-de/ratgeber/faehren/',
    tag: 'Verkehr'
  },
  {
    title: 'Parkplätze & ZTL-Zonen',
    desc: 'Wo man parkt, Öffnungszeiten und Kosten. Wie man Zones mit Fahrverboten und Bußgelder vermeidet.',
    img: '/images/parcheggi-hero.jpg',
    href: '/de-de/ratgeber/parken-ztl/',
    tag: 'Praktisch'
  },
  {
    title: 'Beste Reisezeit',
    desc: 'Jahreszeiten, Wetter, Feiertage und Menschenmassen. Wann ist die beste Zeit für deinen Besuch.',
    img: '/images/quando-visitare-hero.jpg',
    href: '/de-de/ratgeber/reisezeit/',
    tag: 'Planung'
  },
];
---

<BaseLayout
  title="Planung - Amalfiküste"
  description="Praktische Leitfäden zur Amalfiküste: Anreise, Parkplätze, Bus SITA, Fähren und beste Reisezeit."
  lang={lang}
  pageKey="planning"

  heroImage="/images/itinerari-hero.jpg"
>
  <!-- Hero -->
  <section class="relative h-[45vh] sm:h-[60vh] flex items-center bg-charcoal overflow-hidden">
    <img src="/images/itinerari-hero.jpg" alt="Planung Amalfiküste" class="absolute inset-0 w-full h-full object-cover" loading="eager" fetchpriority="high" decoding="sync" referrerpolicy="no-referrer"/>
    <div class="absolute inset-0 bg-gradient-to-b from-black/25 via-black/40 to-black/75"></div>
    <div class="relative z-10 max-w-7xl mx-auto px-6 py-16">
      <nav class="flex items-center gap-2 text-white/60 text-xs mb-6">
        <a href="/de-de/" class="hover:text-white transition-colors">Home</a>
        <span>/</span>
        <span class="text-white">Planung</span>
      </nav>
      <div class="max-w-3xl">
        <p class="text-med-gold text-xs sm:text-sm font-medium uppercase tracking-[0.3em] mb-3">Plane deine Reise</p>
        <h1 class="font-serif text-display text-white mb-4">Praktische Leitfäden</h1>
        <p class="text-xl text-white/80 leading-relaxed">Wie man anreist, wie man sich fortbewegt, wann man besucht und wo man parkt an der Amalfiküste. Alles, was du für eine perfekte Reise brauchst.</p>
      </div>
    </div>
  </section>

  <!-- Intro -->
  <section class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <p class="text-lg text-slate-600 leading-relaxed">
      Die Amalfiküste ist leicht zu erkunden, wenn du weißt, wie man anreist, wie man sich fortbewegt und die beste Zeit zum Besuchen ist. Hier findest du alle praktischen Informationen die du brauchst: Von Transportmöglichkeiten bis zu Parkplatzpreisen, von Linienbussen bis zu Sommerfahrten.
    </p>
  </section>

  <!-- Guides Grid -->
  <section class="py-12 border-t border-slate-100">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {guides.map((guide) => (
          <a href={guide.href} class="group block bg-white rounded-2xl border border-slate-100 overflow-hidden hover:shadow-lg hover:border-med-blue/20 transition-all duration-300">
            <!-- Image with overlay -->
            <div class="relative h-44 overflow-hidden">
              <img src={guide.img} alt={guide.title} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
              <div class="absolute inset-0 bg-gradient-to-t from-black/50 to-transparent" />
              <!-- Category badge -->
              <span class="absolute bottom-3 left-3 text-[10px] font-bold uppercase tracking-wider text-white bg-med-blue/80 backdrop-blur-sm px-2.5 py-1 rounded-full">
                {guide.tag}
              </span>
            </div>
            <!-- Text section -->
            <div class="p-5">
              <h3 class="font-semibold text-charcoal text-sm mb-1.5 group-hover:text-med-blue transition-colors">{guide.title}</h3>
              <p class="text-xs text-slate-500 leading-relaxed">{guide.desc}</p>
              <span class="mt-3 inline-flex items-center text-xs font-semibold text-med-blue gap-1 group-hover:gap-2 transition-all">
                Leitfaden lesen →
              </span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Itineraries CTA -->
  <section class="bg-med-blue py-16 text-center">
    <div class="max-w-2xl mx-auto px-4">
      <h2 class="text-2xl font-bold text-white mb-4">Bereit die Küste zu erkunden?</h2>
      <p class="text-white mb-6">Wähle zwischen 1 Tag, 3 Tagen oder 1 Woche empfohlener Routen.</p>
      <a href={getLocalePath(lang, 'itineraries')}
        class="inline-block bg-white text-med-blue font-semibold px-8 py-3 rounded-full hover:bg-slate-100 transition-colors">
        Reiserouten ansehen
      </a>
    </div>
  </section>
</BaseLayout>
