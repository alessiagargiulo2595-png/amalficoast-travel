---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import CorrelationSlider from '../../../../components/CorrelationSlider.astro';
import Breadcrumbs from '../../../../components/Breadcrumbs.astro';

const lang = 'de-de';

const breadcrumbs = [
  { name: 'Startseite', url: '/de-de/' },
  { name: 'Amalfiküste', url: '/de-de/amalfikueste/' },
  { name: 'Salerno', url: '/de-de/amalfikueste/salerno/' },
];

const touristAttractionSchema = {
  "@context": "https://schema.org",
  "@type": "TouristAttraction",
  "name": "Salerno",
  "description": "Salerno ist das Tor zur Amalfiküste, eine lebendige Universitätsstadt mit dem normannischen Dom, dem Lungomare Trieste, dem mittelalterlichen Stadtzentrum und den berühmten Luci d'Artista im Winter.",
  "url": "https://amalficoast-travel.com/de-de/amalfikueste/salerno/",
  "touristType": ["Kultur", "Geschichte", "Gastronomie", "Reisebasis"],
  "address": { "@type": "PostalAddress", "addressLocality": "Salerno", "addressRegion": "Salerno", "addressCountry": "IT", "postalCode": "84121" },
  "geo": { "@type": "GeoCoordinates", "latitude": 40.6824, "longitude": 14.7681 }
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Wie kommt man von Neapel nach Salerno?",
      "acceptedAnswer": { "@type": "Answer", "text": "Mit dem Regionalzug der Trenitalia von Napoli Centrale nach Salerno: ca. 35–40 Minuten, rund 4–7 Euro. Mit Frecce oder Italo in ca. 25 Minuten. Mit dem Auto ca. 60 km über die Autobahn A3 Neapel–Salerno (Maut ca. 3 Euro)." }
    },
    {
      "@type": "Question",
      "name": "Was kann man in Salerno an einem Tag sehen?",
      "acceptedAnswer": { "@type": "Answer", "text": "Dom und Krypta des heiligen Matthäus, mittelalterliches Zentrum mit der Via dei Mercanti, Garten der Minerva, Lungomare Trieste, Castello Arechi für den Panoramablick. Im Winter (November–Januar) sind die Luci d'Artista ein absolutes Muss." }
    },
    {
      "@type": "Question",
      "name": "Ist Salerno eine gute Basis für die Amalfiküste?",
      "acceptedAnswer": { "@type": "Answer", "text": "Ja, es ist die praktischste und günstigste Basis. Von Salerno fahren Travelmar-Fähren nach Amalfi, Positano, Minori und Maiori (April–Oktober). Die SITA-Busse verbinden die gesamte Küste. Hotels kosten 40–50 % weniger als in Amalfi oder Positano." }
    },
    {
      "@type": "Question",
      "name": "Wann sollte man Salerno besuchen?",
      "acceptedAnswer": { "@type": "Answer", "text": "April–Juni und September–Oktober für das Klima und die Nähe zur Küste. November–Januar für die Luci d'Artista, die Lichtinstallation, die über 2 Millionen Besucher anzieht. Juli und August sind heiß, aber die Stadt ist nicht so überfüllt wie die Küste." }
    },
    {
      "@type": "Question",
      "name": "Was isst man in Salerno?",
      "acceptedAnswer": { "@type": "Answer", "text": "Die gefüllte Milz (o' pere e o' musso), die Scazzetta del Cardinale (Süßspeise mit Biskuit, Creme und Erdbeeren), die salernitanische Pizza, frischer Fisch auf dem Markt der Via Roma. Die Via dei Mercanti ist voll von authentischen Trattorien." }
    }
  ]
};

const schemas = [touristAttractionSchema, faqSchema];

const fastFacts = [
  { dt: 'Lage', dd: 'Golf von Salerno, SA' },
  { dt: 'Höhe', dd: '0–300 m ü. M.' },
  { dt: 'Einwohner', dd: '~130.000' },
  { dt: 'Ab Neapel', dd: '35 Min. (Regionalzug)' },
  { dt: 'Fährhafen', dd: 'Piazza della Concordia' },
  { dt: 'Nach Amalfi', dd: '75 Min. (Fähre)' },
  { dt: 'Beste Reisezeit', dd: 'Apr–Jun / Nov–Jan' },
  { dt: 'Spezialitäten', dd: 'Milz, Scazzetta, Fisch' },
  { dt: 'Top-Event', dd: 'Luci d\'Artista (Nov–Jan)' },
];

const tips = [
  'Der Garten der Minerva ist der erste botanische Garten Europas (13. Jh.) und kaum besucht: eine verborgene Perle im historischen Zentrum.',
  'Die Via dei Mercanti ist die wahre Seele Salernos: Handwerksbetriebe, Trattorien und Konditoreien zu lokalen, nicht touristischen Preisen.',
  'Nehme die morgendliche Fähre nach Amalfi: der Ausblick auf die Küste vom Meer aus ist unschlagbar.',
  'Das Castello Arechi (mit dem Bus oder in 30 Min. zu Fuß erreichbar) bietet den schönsten Blick auf den Golf und die Stadt.',
];
---

<BaseLayout
  title="Salerno 2026: Tor zur Amalfikueste | Komplett-Guide"
  description="Vollständiger Reiseführer für Salerno: Dom, Garten der Minerva, Luci d'Artista, Lungomare Trieste. Das Tor zur Amalfiküste mit Fähren nach Amalfi und Positano."
  lang={lang}
  breadcrumbs={breadcrumbs}
  schema={schemas}
  pageKey="salerno"
>

  <!-- Hero -->
  <section class="relative h-[75vh] sm:h-[90vh] flex items-center bg-charcoal overflow-hidden">
    <img src="/images/salerno-hero.webp" alt="Salerno, Tor zur Amalfiküste" class="absolute inset-0 w-full h-full object-cover" loading="eager" referrerpolicy="no-referrer"/>
    <div class="absolute inset-0 bg-gradient-to-b from-black/10 via-black/40 to-black/80 z-10"></div>
    <div class="relative z-20 max-w-editorial mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <p class="text-med-gold text-xs sm:text-sm font-medium uppercase tracking-[0.3em] mb-3">Tor zur Amalfikueste</p>
        <h1 class="font-serif text-display text-white mb-4">Salerno</h1>
        <p class="text-xl text-white/80 leading-relaxed max-w-2xl">
          Jahrtausendealte Universitätsstadt und ideale Basis für die Küste. Normannischer Dom, Luci d'Artista und die schönste Strandpromenade Kampaniens.
        </p>
        <div class="flex flex-wrap gap-3 mt-8">
          <a href="#fast-facts" class="px-5 py-2.5 bg-med-gold text-white text-xs sm:text-sm font-semibold rounded-full hover:scale-105 hover:shadow-[0_8px_25px_rgba(212,175,55,0.4)] transition-all duration-300">Schnellinfos</a>
          <a href="#anreise" class="px-5 py-2.5 bg-white/10 backdrop-blur text-white text-xs sm:text-sm font-medium rounded-full border border-white/20 hover:bg-white/20 transition-colors">Anreise</a>
          <a href="#faq" class="px-5 py-2.5 bg-white/10 backdrop-blur text-white text-xs sm:text-sm font-medium rounded-full border border-white/20 hover:bg-white/20 transition-colors">FAQ</a>
        </div>
      </div>
    </div>
    <Breadcrumbs breadcrumbs={breadcrumbs} />
  </section>

  <section class="max-w-editorial mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="grid lg:grid-cols-[1fr_320px] gap-12">

      <div class="space-y-16">

        <div class="prose-editorial">
          <p class="text-xl leading-relaxed text-charcoal">
            Salerno ist die Stadt, die alle durchqueren, aber nur wenige wirklich kennenlernen. Dabei verdient sie mit ihrem mittelalterlichen Zentrum, dem normannischen Dom, der die Reliquien des heiligen Matthäus beherbergt, und einer der schönsten Strandpromenaden Italiens mindestens einen vollen Tag.
          </p>
          <p class="mt-4 text-slate-600 leading-relaxed">
            Als römische Kolonie im Jahr 197 v. Chr. gegründet, erlebte Salerno seinen Höhepunkt mit der <strong>Medizinischen Schule von Salerno</strong>, der ersten und bedeutendsten medizinischen Einrichtung Europas im Mittelalter. Heute ist es eine lebhafte und überschaubare Stadt mit einem Hafen, der direkt mit <a href="/de-de/amalfikueste/amalfi/" class="text-med-blue hover:underline">Amalfi</a>, <a href="/de-de/amalfikueste/positano/" class="text-med-blue hover:underline">Positano</a> und <a href="/de-de/amalfikueste/minori/" class="text-med-blue hover:underline">Minori</a> per Fähre verbunden ist.
          </p>
        </div>

        <!-- Wusstest du? -->
        <div class="bg-slate-900 border border-white/10 rounded-[3rem] p-8">
          <p class="text-[10px] uppercase tracking-[0.3em] text-med-gold font-medium mb-4">Wusstest du?</p>
          <div class="grid sm:grid-cols-3 gap-6">
            <div class="text-center">
              <p class="font-serif text-5xl font-bold text-med-gold">XI Jh.</p>
              <p class="text-white/60 text-xs italic mt-1">Medizinische Schule von Salerno, erste Europas</p>
            </div>
            <div class="text-center">
              <p class="font-serif text-5xl font-bold text-med-gold">2 Mio+</p>
              <p class="text-white/60 text-xs italic mt-1">Besucher bei den Luci d'Artista jedes Jahr</p>
            </div>
            <div class="text-center">
              <p class="font-serif text-5xl font-bold text-med-gold">1,5 km</p>
              <p class="text-white/60 text-xs italic mt-1">der Fußgänger-Lungomare Trieste</p>
            </div>
          </div>
          <p class="text-white/40 text-xs mt-6 italic">
            Robert Guiskard, der normannische Heerführer, machte Salerno 1077 zur Hauptstadt des Herzogtums. Der Dom, den er errichten ließ, ist noch heute das Herzstück der Stadt.
          </p>
        </div>

        <!-- Sehenswürdigkeiten -->
        <div>
          <h2 class="font-serif text-3xl font-semibold text-slate-900 mb-8">Sehenswuerdigkeiten in Salerno</h2>
          <div class="space-y-8">
            {[
              { n: 1, title: 'Dom des heiligen Matthäus', text: 'Das Wahrzeichen Salernos, gegründet 1080 von Robert Guiskard. Die romanische Fassade mit dem bronzenen Portal aus dem 11. Jahrhundert führt in ein barockes Inneres mit der Krypta, die die Reliquien des Apostels Matthäus beherbergt. Der Vorhof mit römischen Spolien-Säulen ist einer der schönsten Süditaliens. Eintritt frei.' },
              { n: 2, title: 'Garten der Minerva', text: 'Der erste botanische Garten Europas, im 13. Jahrhundert vom Arzt Matteo Silvatico der Medizinischen Schule Salernos gegründet. Terrassenförmig auf dem Hügel des historischen Zentrums angelegt, mit Heilpflanzen, Brunnen und spektakulärem Blick auf den Golf. Eintritt ca. 3 Euro. Unbedingt sehenswert.' },
              { n: 3, title: 'Lungomare Trieste', text: '1,5 km Fußgängerpromenade mit Blick auf den Golf von Salerno, gilt als eine der schönsten Strandpromenaden Italiens. Palmen, Bänke, Cafés und bei klarem Wetter Sicht auf Capri. Perfekt für den Aperitivo bei Sonnenuntergang.' },
              { n: 4, title: 'Castello Arechi', text: 'Die lombardische Festung auf 300 m Höhe dominiert die Stadt und den Golf. Erreichbar mit dem Bus (Linie 19) oder zu Fuß in 30 Minuten vom Zentrum. Beherbergt ein Museum mit mittelalterlicher Keramik und bietet den weitesten Panoramablick der Gegend. Eintritt ca. 5 Euro.' },
              { n: 5, title: 'Via dei Mercanti und historisches Zentrum', text: 'Die mittelalterliche Handelsachse Salernos, eine Abfolge von Geschäften, Trattorien und Kirchen. Durchquere sie von der Piazza Sedile del Campo bis zum Arco di Arechi. Die Seitenstraßen verbergen historische Konditoreien und verborgene Innenhöfe.' },
            ].map(({ n, title, text }) => (
              <div class="grid sm:grid-cols-[auto_1fr] gap-4">
                <div class="w-14 h-14 rounded-[1rem] bg-med-gold/10 flex items-center justify-center flex-shrink-0 text-med-gold font-serif font-bold text-xl">{n}</div>
                <div>
                  <h3 class="font-semibold text-charcoal text-lg mb-1">{title}</h3>
                  <p class="text-slate-600 leading-relaxed">{text}</p>
                </div>
              </div>
            ))}
          </div>
        </div>

        <!-- Anreise -->
        <div id="anreise">
          <h2 class="font-serif text-3xl font-semibold text-slate-900 mb-6">Anreise nach Salerno</h2>
          <div class="space-y-6">
            <div class="bg-white rounded-[3rem] p-8 border border-slate-100 hover:shadow-xl transition-all duration-300">
              <h3 class="font-semibold text-charcoal mb-3">Zug (ab Neapel)</h3>
              <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">Trenitalia Regionalzug von Napoli Centrale: ca. 35–40 Min., rund 4–7 Euro. Frecce und Italo: ca. 25 Min. Der Bahnhof Salerno liegt 10 Gehminuten vom historischen Zentrum und dem Fährhafen entfernt.</p>
            </div>
            <div class="bg-white rounded-[3rem] p-8 border border-slate-100 hover:shadow-xl transition-all duration-300">
              <h3 class="font-semibold text-charcoal mb-3">Faehren zur Amalfikueste</h3>
              <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">Vom Hafen an der Piazza della Concordia (5 Min. vom Bahnhof) verbindet Travelmar Salerno mit <a href="/de-de/amalfikueste/cetara/" class="text-med-blue hover:underline">Cetara</a>, <a href="/de-de/amalfikueste/maiori/" class="text-med-blue hover:underline">Maiori</a>, <a href="/de-de/amalfikueste/minori/" class="text-med-blue hover:underline">Minori</a>, <a href="/de-de/amalfikueste/amalfi/" class="text-med-blue hover:underline">Amalfi</a> und <a href="/de-de/amalfikueste/positano/" class="text-med-blue hover:underline">Positano</a> (April–Oktober). Ticket ca. 8–10 Euro.</p>
            </div>
            <div class="bg-white rounded-[3rem] p-8 border border-slate-100 hover:shadow-xl transition-all duration-300">
              <h3 class="font-semibold text-charcoal mb-3">SITA-Bus</h3>
              <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">Die SITA-Busse fahren vom Bahnhof ab und fahren die gesamte SS163 bis <a href="/de-de/amalfikueste/amalfi/" class="text-med-blue hover:underline">Amalfi</a> entlang (ca. 75 Min., 2,50 Euro). Ganzjährig, Takt ca. 60–90 Min.</p>
            </div>
          </div>
        </div>

        <!-- Geheimtipps -->
        <div>
          <h2 class="font-serif text-3xl font-semibold text-slate-900 mb-6">Salerno abseits der Touristenpfade</h2>
          <div class="grid sm:grid-cols-2 gap-6">
            {[
              { title: 'Komplex San Pietro a Corte', text: 'Eine einzigartige archäologische Stätte mit übereinanderliegenden römischen, frühchristlichen und lombardischen Überresten. Die Palastakapelle aus dem 8. Jahrhundert ist ein verborgenes Juwel unter dem Straßenniveau. Eintritt kostenlos oder nahezu kostenlos.' },
              { title: 'Viertel Fornelle', text: 'Das älteste Viertel Salernos, am Hang unterhalb des Castello Arechi. Enge Gassen, unzählige Treppen und zeitgenössische Streetart. Für Touristen kaum bekannt, voller lokalen Lebens.' },
              { title: 'Markt der Via Roma', text: 'Der überdachte Markt Salernos, auf dem die Einwohner jeden Morgen frischen Fisch, Obst und Gemüse kaufen. Farben, Düfte und lokale Preise. Morgens geöffnet, sonntags geschlossen.' },
              { title: 'Mittelalterliches Aquaedukt', text: 'Die Reste des Aquädukts, der die Benediktinerklöster versorgte, sind entlang der Via Arce im historischen Zentrum sichtbar. Ein beeindruckendes Bogenbauwerk, das kaum jemand kennt.' },
            ].map(({ title, text }) => (
              <div class="bg-white rounded-[3rem] p-8 border border-slate-100 hover:shadow-xl transition-all duration-300">
                <h3 class="font-semibold text-charcoal mb-2">{title}</h3>
                <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">{text}</p>
              </div>
            ))}
          </div>
        </div>

        <!-- Lokaler Tipp -->
        <div class="relative overflow-hidden rounded-[3rem] bg-med-blue p-10 md:p-14 text-white shadow-2xl">
          <div class="relative z-10 flex flex-col md:flex-row items-start md:items-center gap-8">
            <div class="w-20 h-20 rounded-2xl bg-white/10 flex items-center justify-center flex-shrink-0 border border-white/20"><svg class="w-10 h-10 text-med-gold" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 3v2.25m6.364.386-1.591 1.591M21 12h-2.25m-.386 6.364-1.591-1.591M12 18.75V21m-4.773-4.227-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0Z"/></svg></div>
            <div>
              <p class="text-med-gold text-xs font-bold uppercase tracking-[0.3em] mb-2">Lokaler Tipp</p>
              <h3 class="font-serif text-2xl font-bold text-white mb-3 tracking-tight">Perfekte Basis für die Küste</h3>
              <p class="text-white/70 leading-relaxed">Übernachte in Salerno und nimm die Morgenfähre nach Amalfi: Du sparst 40–50 % bei den Hotelkosten und genießt den Küstenpanoramablick vom Meer. Abends bietet das historische Zentrum Salernos authentische Restaurants zu lokalen Preisen.</p>
            </div>
          </div>
          <div class="absolute bottom-0 left-0 translate-y-1/2 -translate-x-1/2 w-80 h-80 bg-med-gold/10 rounded-full blur-3xl pointer-events-none"></div>
        </div>

        <!-- FAQ -->
        <div id="faq">
          <h2 class="font-serif text-3xl font-semibold text-slate-900 mb-8">Haeufig gestellte Fragen zu Salerno</h2>
          <div class="space-y-4">
            {faqSchema.mainEntity.map((q) => (
              <details class="group border border-slate-200 rounded-2xl overflow-hidden">
                <summary class="flex items-center justify-between px-6 py-4 cursor-pointer select-none text-charcoal font-medium hover:bg-slate-50 transition-colors">
                  {q.name}
                  <svg class="w-4 h-4 text-slate-400 group-open:rotate-180 transition-transform flex-shrink-0 ml-3" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
                </summary>
                <div class="px-6 pb-5 text-slate-600 leading-relaxed text-xs sm:text-sm border-t border-slate-100 pt-4">
                  {q.acceptedAnswer.text}
                </div>
              </details>
            ))}
          </div>
        </div>

      </div>

      <aside class="space-y-6 lg:sticky lg:top-24 self-start">
        <div id="fast-facts" class="bg-slate-900 text-white rounded-[3rem] p-6">
          <p class="text-[10px] uppercase tracking-[0.3em] text-med-gold font-medium mb-4">Schnellinfos - Salerno</p>
          <dl class="space-y-3">
            {fastFacts.map(({ dt, dd }, i) => (
              <>
                <div class="flex justify-between items-start gap-3">
                  <dt class="text-white/40 text-xs sm:text-sm font-light flex-shrink-0">{dt}</dt>
                  <dd class="text-white font-medium text-xs sm:text-sm text-right">{dd}</dd>
                </div>
                {i < fastFacts.length - 1 && <div class="border-t border-white/5"></div>}
              </>
            ))}
          </dl>
        </div>

        <div class="bg-med-cream border border-med-gold/30 rounded-[2rem] p-6">
          <p class="text-[10px] uppercase tracking-[0.3em] text-med-gold font-medium mb-3">Insider-Tipps</p>
          <ul class="space-y-3">
            {tips.map(tip => (
              <li class="flex items-start gap-2 text-xs sm:text-sm text-charcoal">
                <span class="w-1.5 h-1.5 rounded-full bg-med-gold mt-1.5 flex-shrink-0"></span>
                <span>{tip}</span>
              </li>
            ))}
          </ul>
        </div>

        <div class="bg-white border border-slate-100 rounded-[2rem] p-6 shadow-sm">
          <p class="text-[10px] uppercase tracking-[0.3em] text-slate-400 font-medium mb-3">Erkunde die Amalfikueste</p>
          <nav class="space-y-1">
            {[
              { href: '/de-de/amalfikueste/amalfi/', label: 'Amalfi' },
              { href: '/de-de/amalfikueste/positano/', label: 'Positano' },
              { href: '/de-de/amalfikueste/ravello/', label: 'Ravello' },
              { href: '/de-de/amalfikueste/cetara/', label: 'Cetara' },
              { href: '/de-de/amalfikueste/vietri-sul-mare/', label: 'Vietri sul Mare' },
            ].map(({ href, label }) => (
              <a href={href} class="flex items-center gap-2 px-3 py-2 rounded-xl text-xs sm:text-sm text-charcoal hover:bg-med-blue/5 hover:text-med-blue transition-colors">
                <span class="w-1.5 h-1.5 rounded-full bg-med-blue/30"></span> {label}
              </a>
            ))}
          </nav>
        </div>
      </aside>

    </div>
  </section>

  <CorrelationSlider
    heading="Entdecke mehr an der Amalfikueste"
    items={[
      { name: 'Amalfi',   href: '/de-de/amalfikueste/amalfi/',   tag: 'Seerepublik', desc: 'Die historische Hauptstadt mit der Kathedrale Sant\'Andrea und dem Papiermuseum.' },
      { name: 'Cetara',   href: '/de-de/amalfikueste/cetara/',   tag: 'Fischerdorf',  desc: 'Das Fischerdorf und der Ursprungsort der Colatura di Alici g.U.' },
      { name: 'Vietri',   href: '/de-de/amalfikueste/vietri-sul-mare/', tag: 'Keramik', desc: 'Das Tor zur Küste, berühmt für seine Kunstkeramik.' },
      { name: 'Ravello',  href: '/de-de/amalfikueste/ravello/',  tag: 'Musik & Gärten', desc: 'Villa Rufolo, Villa Cimbrone und das Musikfestival auf 350 m.' },
      { name: 'Positano', href: '/de-de/amalfikueste/positano/', tag: 'Mode & Aussichten', desc: 'Bunte Häuser auf dem Meer und der Strand Fornillo.' },
    ]}
    lang="de-de"
  />

</BaseLayout>
