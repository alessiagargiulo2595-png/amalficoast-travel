---
import BaseLayout from '../../../layouts/BaseLayout.astro';

const lang = 'de-de';

const breadcrumbs = [
  { name: 'Home', url: '/de-de/' },
  { name: 'Amalfiküste', url: '/de-de/amalfikueste/' },
];

const borghi = [
  {
    name: 'Positano',
    href: '/de-de/amalfikueste/positano/',
    desc: 'Das meistfotografierte Dorf der Küste, mit bunten Häusern, die über dem Meer thronen, und dem berühmten Spiaggia Grande.',
    tag: 'Das ikonischste',
  },
  {
    name: 'Amalfi',
    href: '/de-de/amalfikueste/amalfi/',
    desc: 'Historische Hauptstadt der Küste, mit dem Dom von Sant\'Andrea und dem Papiermuseum.',
    tag: 'Historische Hauptstadt',
  },
  {
    name: 'Ravello',
    href: '/de-de/amalfikueste/ravello/',
    desc: 'Auf 350 m über dem Meer, die „Stadt der Musik" mit der Villa Rufolo und der Villa Cimbrone.',
    tag: 'Panoramablick',
  },
  {
    name: 'Praiano',
    href: '/de-de/amalfikueste/praiano/',
    desc: 'Das bestgehütete Geheimnis: weniger Trubel, spektakuläre Sonnenuntergänge über der Bucht von Praia.',
    tag: 'Das authentischste',
  },
  {
    name: 'Marina di Praia',
    href: '/de-de/amalfikueste/marina-di-praia/',
    desc: 'Der Wildbad von Praiano, versteckt hinter einer in den Felsen gehauenen Treppe. Reine Authentizität und spektakuläre Sonnenuntergänge.',
    tag: 'Wild & authentisch',
  },
  {
    name: 'Maiori',
    href: '/de-de/amalfikueste/maiori/',
    desc: 'Der längste Sandstrand der Küste: ideal für alle, die das Meer ohne Komfortverzicht suchen.',
    tag: 'Sandstrand',
  },
  {
    name: 'Minori',
    href: '/de-de/amalfikueste/minori/',
    desc: 'Dorf der Zitronenhaine, mit Überresten einer römischen Villa aus dem 1. Jh. n. Chr. und ausgezeichneten Konditoreien.',
    tag: 'Authentische Aromen',
  },
  {
    name: 'Vietri sul Mare',
    href: '/de-de/amalfikueste/vietri-sul-mare/',
    desc: 'Das östliche Tor der Amalfiküste, berühmt für seine handbemalten Keramiken, die Kirchen und Terrassen in Süditalien schmücken.',
    tag: 'Keramik-Hauptstadt',
  },
];

const destinationSchema = {
  "@context": "https://schema.org",
  "@type": "TouristDestination",
  "name": "Amalfiküste",
  "description": "Die Amalfiküste ist ein 50 km langer Küstenabschnitt in Kampanien, seit 1997 UNESCO-Welterbe, mit bunten Dörfern, Klippen und dem Blau des Tyrrhenischen Meeres.",
  "url": "https://amalficoast-travel.com/de-de/amalfikueste/",
  "touristType": ["Kultur", "Meer", "Natur", "Gastronomie", "Wandern"],
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": 40.6333,
    "longitude": 14.6027
  }
};
---

<BaseLayout
  title="Amalfiküste 2026: Vollständiger Reiseführer zu den Dörfern"
  description="Reiseführer zur Amalfiküste: zu besichtigende Dörfer, Strände, Anreise, Reisezeit. Von Positano bis Amalfi – alles, was Sie wissen müssen."
  lang={lang}
  pageKey="costiera-amalfitana"
  breadcrumbs={breadcrumbs}
  schema={[destinationSchema]}
>

  <!-- Hero -->
  <section class="relative bg-charcoal overflow-hidden">
    <img src="/images/costiera-hero.jpg" alt="" class="absolute inset-0 w-full h-full object-cover" loading="eager"  referrerpolicy="no-referrer"/>
    <div class="absolute inset-0 bg-gradient-to-b from-transparent via-black/20 to-black/60"></div>
    <div class="relative max-w-editorial mx-auto px-4 sm:px-6 lg:px-8 py-24">
      <nav class="flex items-center gap-2 text-white/60 text-xs mb-6">
        <a href="/de-de/" class="hover:text-white transition-colors">Home</a>
        <span>/</span>
        <span class="text-white">Amalfiküste</span>
      </nav>
      <div class="max-w-3xl">
        <p class="text-med-gold text-xs sm:text-sm font-medium uppercase tracking-[0.3em] mb-3">UNESCO-Welterbe</p>
        <h1 class="font-serif text-display text-white mb-4">Amalfiküste</h1>
        <p class="text-xl text-white/80 leading-relaxed">
          Fünfzig Kilometer Klippen, bunte Dörfer und türkisfarbenes Wasser. Italiens berühmteste Küste in einem vollständigen, aktuellen Reiseführer für 2026.
        </p>
      </div>
    </div>
  </section>

  <div class="max-w-editorial mx-auto px-4 sm:px-6 lg:px-8 py-16 space-y-20">

    <!-- Intro -->
    <section class="max-w-text">
      <p class="text-xl leading-relaxed text-charcoal">
        Die Amalfiküste ist einer jener Orte, die jede Erwartung übertreffen. Egal wie viele Fotos Sie schon gesehen haben: die Wirklichkeit - der Duft von Zitronen, das Funkeln der Sonne auf dem Meer, die an den Felsen klebenden Häuser - ist immer intensiver.
      </p>
      <p class="mt-4 text-slate-600 leading-relaxed">
        Seit 1997 UNESCO-Welterbe, erstreckt sie sich über 50 km von der Sorrentinischen Halbinsel bis nach Vietri sul Mare in der Provinz Salerno. Das Herzstück ist die SS163, eine kurvenreiche Straße, die in den Felsen gehauen wurde und 13 Gemeinden verbindet, jede mit ihrer eigenen Geschichte, Landschaft und Aromen.
      </p>
    </section>

    <!-- Borghi Grid -->
    <section>
      <div class="flex items-end justify-between mb-8">
        <h2 class="font-serif text-3xl font-semibold text-slate-900">Dörfer der Küste</h2>
        <p class="text-xs sm:text-sm text-slate-400 hidden sm:block">Von West nach Ost entlang der SS163</p>
      </div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {borghi.map(b => (
          <a href={b.href} class="group bg-white border border-slate-100 rounded-[2rem] p-6 shadow-sm hover:border-med-blue/30 hover:shadow-xl transition-all duration-300">
            <div class="flex items-start justify-between mb-3">
              <h3 class="font-serif text-xl font-semibold text-slate-900 group-hover:text-med-blue transition-colors">{b.name}</h3>
              <span class="text-[10px] uppercase tracking-wide bg-med-blue/5 text-med-blue px-2 py-1 rounded-full font-medium flex-shrink-0 ml-2">{b.tag}</span>
            </div>
            <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">{b.desc}</p>
            <p class="text-med-blue text-xs sm:text-sm font-medium mt-4 group-hover:translate-x-1 transition-transform inline-flex items-center gap-1">
              {b.name} entdecken
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 18l6-6-6-6"/></svg>
            </p>
          </a>
        ))}
      </div>
    </section>

    <!-- Did You Know -->
    <section class="bg-charcoal text-white rounded-[2rem] p-10">
      <p class="text-[10px] uppercase tracking-[0.3em] text-med-gold font-medium mb-8">Die Küste in Zahlen</p>
      <div class="grid sm:grid-cols-4 gap-8 text-center">
        <div>
          <p class="font-serif text-5xl font-bold text-med-gold">50 km</p>
          <p class="text-white/60 text-xs sm:text-sm mt-2">UNESCO-Küstenlinie</p>
        </div>
        <div>
          <p class="font-serif text-5xl font-bold text-med-gold">13</p>
          <p class="text-white/60 text-xs sm:text-sm mt-2">Küstengemeinden</p>
        </div>
        <div>
          <p class="font-serif text-5xl font-bold text-med-gold">1997</p>
          <p class="text-white/60 text-xs sm:text-sm mt-2">UNESCO-Jahr</p>
        </div>
        <div>
          <p class="font-serif text-5xl font-bold text-med-gold">2 Mio.+</p>
          <p class="text-white/60 text-xs sm:text-sm mt-2">Touristen/Jahr</p>
        </div>
      </div>
    </section>

    <!-- Quick Links -->
    <section>
      <h2 class="font-serif text-3xl font-semibold text-slate-900 mb-8">Praktische Reiseführer</h2>
      <div class="grid sm:grid-cols-3 gap-6">
        <a href="/de-de/anreise/" class="block bg-charcoal rounded-[2rem] p-8 border-2 border-med-gold hover:shadow-lg transition-all duration-300 group">
          <div class="mb-4">
            <span class="text-[10px] uppercase tracking-[0.3em] font-bold text-med-gold">Planung</span>
          </div>
          <h3 class="font-serif text-2xl font-bold text-med-gold mb-3 group-hover:text-white transition-colors">Anreise</h3>
          <p class="text-white leading-relaxed">Fähren, Bus, Auto</p>
        </a>

        <a href="/de-de/beste-reisezeit/" class="block bg-charcoal rounded-[2rem] p-8 border-2 border-med-gold hover:shadow-lg transition-all duration-300 group">
          <div class="mb-4">
            <span class="text-[10px] uppercase tracking-[0.3em] font-bold text-med-gold">Planung</span>
          </div>
          <h3 class="font-serif text-2xl font-bold text-med-gold mb-3 group-hover:text-white transition-colors">Beste Reisezeit</h3>
          <p class="text-white leading-relaxed">Monat für Monat</p>
        </a>

        <a href="/de-de/strande/" class="block bg-charcoal rounded-[2rem] p-8 border-2 border-med-gold hover:shadow-lg transition-all duration-300 group">
          <div class="mb-4">
            <span class="text-[10px] uppercase tracking-[0.3em] font-bold text-med-gold">Erkunden</span>
          </div>
          <h3 class="font-serif text-2xl font-bold text-med-gold mb-3 group-hover:text-white transition-colors">Die Strände</h3>
          <p class="text-white leading-relaxed">8 ausgewählte Strände</p>
        </a>
      </div>
    </section>

    <!-- Spiagge Card -->
    <section>
      <h2 class="font-serif text-3xl font-semibold text-slate-900 mb-8">Die schönsten Strände der Amalfiküste</h2>
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
        <a href="/de-de/straende/amalfikueste/fiordo-di-furore/" class="group relative aspect-[4/5] overflow-hidden rounded-[2rem] shadow-lg hover:shadow-xl transition-all duration-300">
          <img src="/images/fiordo-furore-hero.webp" alt="Fiordo di Furore" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500" loading="lazy" referrerpolicy="no-referrer" />
          <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent" />
          <div class="absolute bottom-6 left-6 right-6">
            <h3 class="font-serif text-xl font-bold text-white">Fiordo di Furore</h3>
          </div>
        </a>

        <a href="/de-de/straende/amalfikueste/spiaggia-grande-positano/" class="group relative aspect-[4/5] overflow-hidden rounded-[2rem] shadow-lg hover:shadow-xl transition-all duration-300">
          <img src="/images/spiaggia-grande-positano.webp" alt="Spiaggia Grande" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500" loading="lazy" referrerpolicy="no-referrer" />
          <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent" />
          <div class="absolute bottom-6 left-6 right-6">
            <h3 class="font-serif text-xl font-bold text-white">Spiaggia Grande</h3>
          </div>
        </a>

        <a href="/de-de/straende/amalfikueste/santa-croce/" class="group relative aspect-[4/5] overflow-hidden rounded-[2rem] shadow-lg hover:shadow-xl transition-all duration-300">
          <img src="/images/santa-croce-amalfi.webp" alt="Santa Croce" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500" loading="lazy" referrerpolicy="no-referrer" />
          <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent" />
          <div class="absolute bottom-6 left-6 right-6">
            <h3 class="font-serif text-xl font-bold text-white">Santa Croce</h3>
          </div>
        </a>

        <a href="/de-de/straende/amalfikueste/marina-di-praia/" class="group relative aspect-[4/5] overflow-hidden rounded-[2rem] shadow-lg hover:shadow-xl transition-all duration-300">
          <img src="/images/praia-hero.webp" alt="Marina di Praia" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500" loading="lazy" referrerpolicy="no-referrer" />
          <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent" />
          <div class="absolute bottom-6 left-6 right-6">
            <h3 class="font-serif text-xl font-bold text-white">Marina di Praia</h3>
          </div>
        </a>
      </div>
    </section>

  </div>

</BaseLayout>
