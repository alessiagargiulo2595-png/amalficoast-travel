---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import CorrelationSlider from '../../../../components/CorrelationSlider.astro';
import Breadcrumbs from '../../../../components/Breadcrumbs.astro';

const lang = 'de-de';

const breadcrumbs = [
  { name: 'Startseite', url: '/de-de/' },
  { name: 'Amalfiküste', url: '/de-de/amalfikueste/' },
  { name: 'Tramonti', url: '/de-de/amalfikueste/tramonti/' },
];

const touristAttractionSchema = {
  "@context": "https://schema.org",
  "@type": "TouristAttraction",
  "name": "Tramonti",
  "description": "Tramonti ist die grüne Lunge der Amalfiküste, eine über 13 Ortsteile verteilte Gemeinde inmitten von Weinbergen, Zitronenhainen und alten Kirchen. Land der Costa d'Amalfi DOC-Weine, der Pizza-Tradition und ländlicher Bräuche.",
  "url": "https://amalficoast-travel.com/de-de/amalfikueste/tramonti/",
  "touristType": ["Wein & Gastronomie", "Natur", "Authentizität", "Traditionen"],
  "address": { "@type": "PostalAddress", "addressLocality": "Tramonti", "addressRegion": "Salerno", "addressCountry": "IT", "postalCode": "84010" },
  "geo": { "@type": "GeoCoordinates", "latitude": 40.6933, "longitude": 14.6333 }
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Wie kommt man nach Tramonti?",
      "acceptedAnswer": { "@type": "Answer", "text": "Mit dem Auto: über den Valico di Chiunzi (SS373) ab Angri/Nocera, ca. 20 Min. von der Autobahn A3. Mit dem SITA-Bus: ab Amalfi oder Maiori (ca. 30 Min.). Es gibt keinen Bahnhof. Das Auto ist am bequemsten, da die 13 Ortsteile verstreut liegen." }
    },
    {
      "@type": "Question",
      "name": "Warum ist Tramonti fuer die Pizza beruehmt?",
      "acceptedAnswer": { "@type": "Answer", "text": "Tramonti gilt als eine der Wiegen der neapolitanischen Pizza. Viele aus Tramonti ausgewanderte Pizzaiolos haben weltweit Pizzerien eröffnet. Die lokale Tradition sieht die Verwendung von Zutaten aus der Region vor: lokale Tomaten, Fior di Latte aus lokalen Käsereien und Olivenöl von den Hügeln." }
    },
    {
      "@type": "Question",
      "name": "Welche Weine werden in Tramonti produziert?",
      "acceptedAnswer": { "@type": "Answer", "text": "Tramonti ist das Hauptanbaugebiet des DOC Costa d'Amalfi Unterzone Tramonti. Es werden Weißweine aus Falanghina, Biancolella und Pepella sowie Rotweine aus Tintore di Tramonti (Piedirosso) hergestellt. Weingüter wie Apicella, Reale und Monte di Grazia bieten Verkostungen auf Anfrage." }
    },
    {
      "@type": "Question",
      "name": "Lohnt sich ein Besuch in Tramonti?",
      "acceptedAnswer": { "@type": "Answer", "text": "Absolut, vor allem für alle, die Authentizität suchen. Kein Massentourismus, sehr niedrige Preise, unberührte Natur und eine außergewöhnliche Gastronomie. Es ist das Gegenteil der glänzenden Küste: Hier lebt man noch wie vor 50 Jahren." }
    },
    {
      "@type": "Question",
      "name": "Was gibt es in Tramonti zu sehen?",
      "acceptedAnswer": { "@type": "Answer", "text": "Das Kloster San Giuseppe (Fresken aus dem 17. Jh.), die 13 verstreuten Ortsteile mit ihren Kirchen, die terrassierten Weinberge, wo der Costa d'Amalfi DOC-Wein entsteht, der Valico di Chiunzi mit Panoramablick und die Naturwanderwege in die Monti Lattari." }
    }
  ]
};

const schemas = [touristAttractionSchema, faqSchema];

const fastFacts = [
  { dt: 'Lage', dd: 'Hinterland Amalfiküste, SA' },
  { dt: 'Höhe', dd: '300–800 m ü. M.' },
  { dt: 'Einwohner', dd: '~4.000' },
  { dt: 'Ortsteile', dd: '13 verstreute Weiler' },
  { dt: 'Ab Amalfi', dd: '30 Min. (Bus/Auto)' },
  { dt: 'Zufahrt Auto', dd: 'Valico di Chiunzi' },
  { dt: 'Spezialitäten', dd: 'DOC-Wein, Pizza, Fior di Latte' },
  { dt: 'Beste Reisezeit', dd: 'Apr–Okt' },
  { dt: 'Ideal für', dd: 'Wein & Gastronomie, Natur' },
];

const tips = [
  'Buche eine Weinverkostung im Weingut Apicella (das älteste der Amalfiküste, seit 1870) oder Monte di Grazia für den Tintore.',
  'Der Valico di Chiunzi ist der höchste mit dem Auto erreichbare Punkt: Der Blick auf das Sarno-Tal und den Vesuv ist außergewöhnlich.',
  'Die Pizzerien von Tramonti sind die Lieblinge der Küsteneinheimischen, nicht der Touristen: niedrige Preise und höchste Qualität.',
  'Im Herbst (Oktober) findet die Kastanienmesse statt: lokale Produkte, Wein und authentische Atmosphäre in den Ortsteilen.',
];
---

<BaseLayout
  title="Tramonti 2026: Die gruene Lunge der Amalfikueste"
  description="Reiseführer zu Tramonti: Costa d'Amalfi DOC-Weine, 13 authentische Ortsteile, traditionelle Pizza, Wanderwege in den Monti Lattari. Das geheime Hinterland der Amalfiküste."
  lang={lang}
  breadcrumbs={breadcrumbs}
  schema={schemas}
  pageKey="tramonti"
>

  <!-- Hero -->
  <section class="relative h-[75vh] sm:h-[90vh] flex items-center bg-charcoal overflow-hidden">
    <img src="/images/tramonti-hero.webp" alt="Tramonti, die grüne Lunge der Amalfiküste" class="absolute inset-0 w-full h-full object-cover" loading="eager" referrerpolicy="no-referrer"/>
    <div class="absolute inset-0 bg-gradient-to-b from-black/10 via-black/40 to-black/80 z-10"></div>
    <div class="relative z-20 max-w-editorial mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <p class="text-med-gold text-xs sm:text-sm font-medium uppercase tracking-[0.3em] mb-3">Hinterland der Amalfikueste</p>
        <h1 class="font-serif text-display text-white mb-4">Tramonti</h1>
        <p class="text-xl text-white/80 leading-relaxed max-w-2xl">
          Die grüne Lunge der Küste. DOC-Weine, authentische Pizza und 13 Ortsteile, in denen die Zeit stehen geblieben ist.
        </p>
        <div class="flex flex-wrap gap-3 mt-8">
          <a href="#fast-facts" class="px-5 py-2.5 bg-med-gold text-white text-xs sm:text-sm font-semibold rounded-full hover:scale-105 hover:shadow-[0_8px_25px_rgba(212,175,55,0.4)] transition-all duration-300">Schnellinfos</a>
          <a href="#weine" class="px-5 py-2.5 bg-white/10 backdrop-blur text-white text-xs sm:text-sm font-medium rounded-full border border-white/20 hover:bg-white/20 transition-colors">DOC-Weine</a>
          <a href="#faq" class="px-5 py-2.5 bg-white/10 backdrop-blur text-white text-xs sm:text-sm font-medium rounded-full border border-white/20 hover:bg-white/20 transition-colors">FAQ</a>
        </div>
      </div>
    </div>
    <Breadcrumbs breadcrumbs={breadcrumbs} />
  </section>

  <section class="max-w-editorial mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="grid lg:grid-cols-[1fr_320px] gap-12">

      <div class="space-y-16">

        <div class="prose-editorial">
          <p class="text-xl leading-relaxed text-charcoal">
            Tramonti ist die Amalfiküste, die man nicht erwartet. Kein Meer, keine Touristen, keine Staus: nur terrassierte Hügel, der Schwerkraft trotzende Weinberge, 13 über schmale Straßen verbundene Weiler und eine Wein- und Gastronomietradition, die mit jedem Gourmet-Reiseziel Italiens mithalten kann.
          </p>
          <p class="mt-4 text-slate-600 leading-relaxed">
            Der Name selbst verrät seine Natur: <em>tra i monti</em> — zwischen den Bergen. Erreichbar über den <strong>Valico di Chiunzi</strong> (einer der malerischsten Pässe Kampaniens), ist Tramonti die Wiege des <strong>Costa d'Amalfi DOC</strong>-Weins und der Pizzabäcker-Tradition, die die Welt erobert hat.
          </p>
        </div>

        <!-- Wusstest du? -->
        <div class="bg-slate-900 border border-white/10 rounded-[3rem] p-8">
          <p class="text-[10px] uppercase tracking-[0.3em] text-med-gold font-medium mb-4">Wusstest du?</p>
          <div class="grid sm:grid-cols-3 gap-6">
            <div class="text-center">
              <p class="font-serif text-5xl font-bold text-med-gold">13</p>
              <p class="text-white/60 text-xs italic mt-1">verstreute Ortsteile, jeder mit eigener Kirche</p>
            </div>
            <div class="text-center">
              <p class="font-serif text-5xl font-bold text-med-gold">1870</p>
              <p class="text-white/60 text-xs italic mt-1">Gründungsjahr des Weinguts Apicella</p>
            </div>
            <div class="text-center">
              <p class="font-serif text-5xl font-bold text-med-gold">DOC</p>
              <p class="text-white/60 text-xs italic mt-1">Costa d'Amalfi Unterzone Tramonti</p>
            </div>
          </div>
        </div>

        <!-- Die Weine von Tramonti -->
        <div id="weine">
          <h2 class="font-serif text-3xl font-semibold text-slate-900 mb-6">Die Weine von Tramonti</h2>
          <p class="text-slate-600 text-lg leading-relaxed mb-6">
            Tramonti ist das Herzstück der Weinproduktion der Amalfiküste. Die terrassierten Weinberge, nach Süden ausgerichtet zwischen 200 und 600 m Höhe, bringen einzigartige Trauben hervor.
          </p>
          <div class="space-y-6">
            <div class="bg-med-gold/10 p-6 rounded-2xl border border-med-gold/20">
              <h3 class="font-bold text-slate-900 mb-2 text-lg">Tintore di Tramonti</h3>
              <p class="text-slate-600 leading-relaxed">Die wichtigste einheimische Rotweinsorte: Sie produziert intensive, tannische Weine mit einer fast schwarzen Tieffarbe. Es ist ein lokaler Klon des Piedirosso, aber mit einzigartigen Eigenschaften durch Höhenlage und vulkanischen Boden.</p>
            </div>
            <div class="bg-med-gold/10 p-6 rounded-2xl border border-med-gold/20">
              <h3 class="font-bold text-slate-900 mb-2 text-lg">Weiss- und Roséweine</h3>
              <p class="text-slate-600 leading-relaxed">Falanghina, Biancolella und die seltene Pepella bringen frische, mineralische Weißweine hervor. Die Rosés aus Piedirosso sind perfekt zum Fisch. Zu besuchende Weingüter: Apicella, Reale, Monte di Grazia, Tenuta San Francesco.</p>
            </div>
          </div>
        </div>

        <!-- Sehenswürdigkeiten -->
        <div>
          <h2 class="font-serif text-3xl font-semibold text-slate-900 mb-8">Sehenswuerdigkeiten in Tramonti</h2>
          <div class="space-y-8">
            {[
              { n: 1, title: 'Konservatorium San Giuseppe e Teresa', text: 'Das bedeutendste Denkmal von Tramonti, mit Fresken aus dem 17. Jahrhundert und einer historischen Orgel. Es befindet sich im Ortsteil Polvica und ist auf Anfrage besuchbar. Ein vergessenes Juwel.' },
              { n: 2, title: 'Die 13 Ortsteile', text: 'Jeder Ortsteil hat seine eigene Kirche, seine Identität und seine Traditionen. Die malerischsten: Gete (Panorama), Corsano (mit Burg), Campinola (mit der Kirche San Michele), Polvica (mit dem Konservatorium).' },
              { n: 3, title: 'Valico di Chiunzi', text: 'Der Gebirgspass auf 656 m, der die Küste von der Agro Nocerino trennt. Der Blick auf das Sarno-Tal, den Vesuv und die kampanische Ebene ist atemberaubend, besonders bei Sonnenuntergang.' },
              { n: 4, title: 'Wanderwege und Natur', text: 'Tramonti wird von CAI-markierten Wanderwegen durchzogen, die die Ortsteile verbinden und in die Monti Lattari führen. Kastanienwälder, Haselnusshaine und intakte Agrarlandschaft.' },
            ].map(({ n, title, text }) => (
              <div class="grid sm:grid-cols-[auto_1fr] gap-4">
                <div class="w-14 h-14 rounded-[1rem] bg-med-gold/10 flex items-center justify-center flex-shrink-0 text-med-gold font-serif font-bold text-xl">{n}</div>
                <div>
                  <h3 class="font-semibold text-charcoal text-lg mb-1">{title}</h3>
                  <p class="text-slate-600 leading-relaxed">{text}</p>
                </div>
              </div>
            ))}
          </div>
        </div>

        <!-- Lokaler Tipp -->
        <div class="relative overflow-hidden rounded-[3rem] bg-med-blue p-10 md:p-14 text-white shadow-2xl">
          <div class="relative z-10 flex flex-col md:flex-row items-start md:items-center gap-8">
            <div class="w-20 h-20 rounded-2xl bg-white/10 flex items-center justify-center flex-shrink-0 border border-white/20"><svg class="w-10 h-10 text-med-gold" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 3v2.25m6.364.386-1.591 1.591M21 12h-2.25m-.386 6.364-1.591-1.591M12 18.75V21m-4.773-4.227-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0Z"/></svg></div>
            <div>
              <p class="text-med-gold text-xs font-bold uppercase tracking-[0.3em] mb-2">Lokaler Tipp</p>
              <h3 class="font-serif text-2xl font-bold text-white mb-3 tracking-tight">Die Pizza von Tramonti</h3>
              <p class="text-white/70 leading-relaxed">Tramonti ist die Heimat der Pizzabäcker: Hunderte tramontanische Familien betreiben Pizzerien in aller Welt. Die lokalen Pizzerien verwenden frischen Fior di Latte und Tomaten aus dem Garten: höchste Qualität zu Preisen, die es an der Küste nicht mehr gibt.</p>
            </div>
          </div>
          <div class="absolute bottom-0 left-0 translate-y-1/2 -translate-x-1/2 w-80 h-80 bg-med-gold/10 rounded-full blur-3xl pointer-events-none"></div>
        </div>

        <!-- FAQ -->
        <div id="faq">
          <h2 class="font-serif text-3xl font-semibold text-slate-900 mb-8">Haeufig gestellte Fragen zu Tramonti</h2>
          <div class="space-y-4">
            {faqSchema.mainEntity.map((q) => (
              <details class="group border border-slate-200 rounded-2xl overflow-hidden">
                <summary class="flex items-center justify-between px-6 py-4 cursor-pointer select-none text-charcoal font-medium hover:bg-slate-50 transition-colors">
                  {q.name}
                  <svg class="w-4 h-4 text-slate-400 group-open:rotate-180 transition-transform flex-shrink-0 ml-3" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
                </summary>
                <div class="px-6 pb-5 text-slate-600 leading-relaxed text-xs sm:text-sm border-t border-slate-100 pt-4">
                  {q.acceptedAnswer.text}
                </div>
              </details>
            ))}
          </div>
        </div>

      </div>

      <aside class="space-y-6 lg:sticky lg:top-24 self-start">
        <div id="fast-facts" class="bg-slate-900 text-white rounded-[3rem] p-6">
          <p class="text-[10px] uppercase tracking-[0.3em] text-med-gold font-medium mb-4">Schnellinfos - Tramonti</p>
          <dl class="space-y-3">
            {fastFacts.map(({ dt, dd }, i) => (
              <>
                <div class="flex justify-between items-start gap-3">
                  <dt class="text-white/40 text-xs sm:text-sm font-light flex-shrink-0">{dt}</dt>
                  <dd class="text-white font-medium text-xs sm:text-sm text-right">{dd}</dd>
                </div>
                {i < fastFacts.length - 1 && <div class="border-t border-white/5"></div>}
              </>
            ))}
          </dl>
        </div>

        <div class="bg-med-cream border border-med-gold/30 rounded-[2rem] p-6">
          <p class="text-[10px] uppercase tracking-[0.3em] text-med-gold font-medium mb-3">Insider-Tipps</p>
          <ul class="space-y-3">
            {tips.map(tip => (
              <li class="flex items-start gap-2 text-xs sm:text-sm text-charcoal">
                <span class="w-1.5 h-1.5 rounded-full bg-med-gold mt-1.5 flex-shrink-0"></span>
                <span>{tip}</span>
              </li>
            ))}
          </ul>
        </div>

        <div class="bg-white border border-slate-100 rounded-[2rem] p-6 shadow-sm">
          <p class="text-[10px] uppercase tracking-[0.3em] text-slate-400 font-medium mb-3">Erkunde die Amalfikueste</p>
          <nav class="space-y-1">
            {[
              { href: '/de-de/amalfikueste/agerola/', label: 'Agerola' },
              { href: '/de-de/amalfikueste/ravello/', label: 'Ravello' },
              { href: '/de-de/amalfikueste/maiori/', label: 'Maiori' },
              { href: '/de-de/amalfikueste/minori/', label: 'Minori' },
              { href: '/de-de/amalfikueste/amalfi/', label: 'Amalfi' },
            ].map(({ href, label }) => (
              <a href={href} class="flex items-center gap-2 px-3 py-2 rounded-xl text-xs sm:text-sm text-charcoal hover:bg-med-blue/5 hover:text-med-blue transition-colors">
                <span class="w-1.5 h-1.5 rounded-full bg-med-blue/30"></span> {label}
              </a>
            ))}
          </nav>
        </div>
      </aside>

    </div>
  </section>

  <CorrelationSlider
    heading="Entdecke mehr an der Amalfikueste"
    items={[
      { name: 'Agerola',  href: '/de-de/amalfikueste/agerola/',  tag: 'Wandern & Natur', desc: 'Götterweg, Fior di Latte und Panoramen auf 600 m.' },
      { name: 'Ravello',  href: '/de-de/amalfikueste/ravello/',  tag: 'Musik & Gärten', desc: 'Villa Rufolo, Villa Cimbrone und das Musikfestival.' },
      { name: 'Maiori',   href: '/de-de/amalfikueste/maiori/',   tag: 'Strand & Entspannung', desc: 'Der längste Sandstrand der Küste: 300 m.' },
      { name: 'Minori',   href: '/de-de/amalfikueste/minori/',   tag: 'Genuss & Kultur', desc: 'Römische Villa und frische Scialatielli.' },
      { name: 'Furore',   href: '/de-de/amalfikueste/furore/',   tag: 'Das Dorf das nicht existiert', desc: 'Der spektakuläre Fjord und das bemalte Dorf.' },
    ]}
    lang="de-de"
  />

</BaseLayout>
