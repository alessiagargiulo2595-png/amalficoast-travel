---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import CorrelationSlider from '../../../../components/CorrelationSlider.astro';
import Breadcrumbs from '../../../../components/Breadcrumbs.astro';

const lang = 'de-de';

const breadcrumbs = [
  { name: 'Startseite', url: '/de-de/' },
  { name: 'Amalfiküste', url: '/de-de/amalfikueste/' },
  { name: 'Erchie', url: '/de-de/amalfikueste/erchie/' },
];

const touristAttractionSchema = {
  "@context": "https://schema.org",
  "@type": "TouristAttraction",
  "name": "Erchie",
  "description": "Erchie ist ein kleines Fischerdorf an der Amalfiküste, ein Ortsteil von Maiori, mit einem seltenen Sandstrand, der von einem sarazenischen Turm geschützt wird, und einer authentischen Atmosphäre fernab des Massentourismus.",
  "url": "https://amalficoast-travel.com/de-de/amalfikueste/erchie/",
  "touristType": ["Meer", "Erholung", "Authentizität", "Familien"],
  "address": { "@type": "PostalAddress", "addressLocality": "Erchie", "addressRegion": "Salerno", "addressCountry": "IT", "postalCode": "84010" },
  "geo": { "@type": "GeoCoordinates", "latitude": 40.6278, "longitude": 14.6792 }
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Wie kommt man nach Erchie?",
      "acceptedAnswer": { "@type": "Answer", "text": "Mit dem Auto: Auf der SS163 zwischen Cetara und Maiori führt eine Abzweigung hinunter ins Dorf (wenige Parkplätze). Mit dem SITA-Bus: Haltestelle Erchie auf der Linie Salerno–Amalfi. Per Boot: Von Maiori oder Cetara aus auf dem Seeweg erreichbar." }
    },
    {
      "@type": "Question",
      "name": "Hat Erchie einen Sandstrand?",
      "acceptedAnswer": { "@type": "Answer", "text": "Ja, Erchie besitzt einen der sehr wenigen Sandstrände an der Amalfiküste. Es ist eine geschützte Bucht mit ruhigem, flachem Wasser in Ufernähe — ideal für Familien mit kleinen Kindern. Es gibt einen freien Abschnitt und einen ausgestatteten Abschnitt mit Sonnenliegen und Sonnenschirmen zur Miete." }
    },
    {
      "@type": "Question",
      "name": "Ist Erchie im Sommer überfüllt?",
      "acceptedAnswer": { "@type": "Answer", "text": "Weit weniger als Positano oder Amalfi. Erchie ist hauptsächlich Einheimischen und kampanischen Urlaubern bekannt. Im August kann es belebter werden, aber wirklich überfüllt ist es nie. Komm früh morgens, um den besten Platz zu ergattern." }
    },
    {
      "@type": "Question",
      "name": "Gibt es Restaurants in Erchie?",
      "acceptedAnswer": { "@type": "Answer", "text": "Ja, es gibt mehrere Trattorien und Fischrestaurants direkt am Strand und im Dorf. Unglaublich frische Meeresfrüchte zu günstigeren Preisen als in den Hauptrestaurants der Küste." }
    },
    {
      "@type": "Question",
      "name": "Was ist der Turm von Erchie?",
      "acceptedAnswer": { "@type": "Answer", "text": "Es handelt sich um einen sarazenischen Wachturm aus dem 16. Jahrhundert, der die Bucht dominiert. Er wurde zum Schutz des Dorfes vor Piratenüberfällen erbaut und ist heute eines der meistfotografierten Wahrzeichen der Gegend. Er ist nicht von innen zugänglich, bildet aber eine beeindruckende Kulisse." }
    }
  ]
};

const schemas = [touristAttractionSchema, faqSchema];

const fastFacts = [
  { dt: 'Lage', dd: 'Amalfiküste, SA' },
  { dt: 'Gemeinde', dd: 'Ortsteil von Maiori' },
  { dt: 'Von Salerno', dd: '25 Min. (Auto/Bus)' },
  { dt: 'Von Amalfi', dd: '20 Min. (Auto/Bus)' },
  { dt: 'Strand', dd: 'Sand (selten an der Küste!)' },
  { dt: 'Turm', dd: 'Sarazenischer Turm, XVI. Jh.' },
  { dt: 'Angebote', dd: 'Restaurants, Badeclubs, Parkplätze' },
  { dt: 'Beste Reisezeit', dd: 'Mai–Sep' },
  { dt: 'Ideal für', dd: 'Familien, Erholung, Schwimmen' },
];

const tips = [
  'Erchie hat einen der sehr wenigen Sandstrände an der Amalfiküste — perfekt für Familien mit kleinen Kindern.',
  'Parkmöglichkeiten sind extrem begrenzt: Komm früh oder nimm den SITA-Bus ab Salerno oder Maiori.',
  'Mittagessen in einer der Strandtrattorien: frischer Fisch zum halben Preis von Amalfi.',
  'Die Bucht ist windgeschützt — selbst wenn das Meer anderswo rau ist, bleibt das Wasser hier oft ruhig.',
];
---

<BaseLayout
  title="Erchie 2026: Der geheime Sandstrand der Amalfiküste"
  description="Reiseführer für Erchie: der versteckte Sandstrand der Amalfiküste, der sarazenische Turm und frische Fischrestaurants. Das authentische Fischerdorf zwischen Cetara und Maiori."
  lang={lang}
  breadcrumbs={breadcrumbs}
  schema={schemas}
  pageKey="erchie"
>

  <!-- Hero -->
  <section class="relative h-[75vh] sm:h-[90vh] flex items-center bg-charcoal overflow-hidden">
    <img src="/images/erchie-hero.webp" alt="Erchie, Fischerdorf an der Amalfiküste" class="absolute inset-0 w-full h-full object-cover" loading="eager" referrerpolicy="no-referrer"/>
    <div class="absolute inset-0 bg-gradient-to-b from-black/10 via-black/40 to-black/80 z-10"></div>
    <div class="relative z-20 max-w-editorial mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <p class="text-med-gold text-xs sm:text-sm font-medium uppercase tracking-[0.3em] mb-3">Fischerdorf der Küste</p>
        <h1 class="font-serif text-display text-white mb-4">Erchie</h1>
        <p class="text-xl text-white/80 leading-relaxed max-w-2xl">
          Ein Amphitheater weißer Häuser rund um eine Sandbucht, bewacht von einem sarazenischen Turm. Das bestgehütete Geheimnis der Amalfiküste.
        </p>
        <div class="flex flex-wrap gap-3 mt-8">
          <a href="#fast-facts" class="px-5 py-2.5 bg-med-gold text-white text-xs sm:text-sm font-semibold rounded-full hover:scale-105 hover:shadow-[0_8px_25px_rgba(212,175,55,0.4)] transition-all duration-300">Kurzinfos</a>
          <a href="#the-beach" class="px-5 py-2.5 bg-white/10 backdrop-blur text-white text-xs sm:text-sm font-medium rounded-full border border-white/20 hover:bg-white/20 transition-colors">Der Strand</a>
          <a href="#faq" class="px-5 py-2.5 bg-white/10 backdrop-blur text-white text-xs sm:text-sm font-medium rounded-full border border-white/20 hover:bg-white/20 transition-colors">FAQ</a>
        </div>
      </div>
    </div>
    <Breadcrumbs breadcrumbs={breadcrumbs} />
  </section>

  <section class="max-w-editorial mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="grid lg:grid-cols-[1fr_320px] gap-12">

      <div class="space-y-16">

        <div class="prose-editorial">
          <p class="text-xl leading-relaxed text-charcoal">
            Erchie ist das Dorf, das Touristen nicht finden. Versteckt in einer Bucht zwischen <a href="/de-de/amalfikueste/cetara/" class="text-med-blue hover:underline">Cetara</a> und <a href="/de-de/amalfikueste/maiori/" class="text-med-blue hover:underline">Maiori</a>, ist dieses kleine Amphitheater weißer Häuser mit Blick auf einen Sandstrand der Ort, an dem kampanische Einheimische ans Meer fahren, wenn sie dem Trubel entfliehen möchten.
          </p>
          <p class="mt-4 text-slate-600 leading-relaxed">
            Als Ortsteil von Maiori hat Erchie die Atmosphäre eines Fischerdorfes bewahrt, die der Rest der Küste längst verloren hat. Der sarazenische Turm aus dem 16. Jahrhundert dominiert die Bucht, bunte Boote liegen im Sand, und die Restaurants servieren Fisch, der noch am selben Morgen gefangen wurde.
          </p>
        </div>

        <!-- Wusstest du das? -->
        <div class="bg-slate-900 border border-white/10 rounded-[3rem] p-8">
          <p class="text-[10px] uppercase tracking-[0.3em] text-med-gold font-medium mb-4">Wusstest du das?</p>
          <div class="grid sm:grid-cols-3 gap-6">
            <div class="text-center">
              <p class="font-serif text-5xl font-bold text-med-gold">XVI Jh.</p>
              <p class="text-white/60 text-xs italic mt-1">der sarazenische Turm über der Bucht</p>
            </div>
            <div class="text-center">
              <p class="font-serif text-5xl font-bold text-med-gold">Sand</p>
              <p class="text-white/60 text-xs italic mt-1">eine Seltenheit an der Amalfiküste</p>
            </div>
            <div class="text-center">
              <p class="font-serif text-5xl font-bold text-med-gold">~200</p>
              <p class="text-white/60 text-xs italic mt-1">Einwohner im Dorf</p>
            </div>
          </div>
        </div>

        <!-- Der Strand -->
        <div id="the-beach">
          <h2 class="font-serif text-3xl font-semibold text-slate-900 mb-6">Der Strand von Erchie</h2>
          <p class="text-slate-600 text-lg leading-relaxed mb-6">
            Der Strand von Erchie ist einer der sehr wenigen Sandstrände an der Amalfiküste. Eine geschützte Bucht mit ruhigem, in Ufernähe flachem Wasser — ideal für Familien.
          </p>
          <div class="space-y-6">
            <div class="bg-white p-6 rounded-2xl border border-slate-100">
              <h3 class="font-bold text-slate-900 mb-2">Hauptstrand</h3>
              <p class="text-slate-600 text-sm">Feiner Sand mit einem freien Abschnitt und einem ausgestatteten Abschnitt (Sonnenliegen und Sonnenschirme zur Miete). Der sarazenische Turm bildet eine malerische Kulisse. Ruhiges Wasser dank der Form der Bucht.</p>
            </div>
            <div class="bg-white p-6 rounded-2xl border border-slate-100">
              <h3 class="font-bold text-slate-900 mb-2">Östliche Bucht</h3>
              <p class="text-slate-600 text-sm">Eine kleine Kiesbucht, zu Fuß vom Dorf erreichbar — wilder und ruhiger. Ideal für alle, die Einsamkeit und Schnorcheln in klarem Wasser suchen.</p>
            </div>
          </div>
        </div>

        <!-- Was besichtigen -->
        <div>
          <h2 class="font-serif text-3xl font-semibold text-slate-900 mb-8">Was in Erchie besichtigen</h2>
          <div class="space-y-8">
            {[
              { n: 1, title: 'Sarazenischer Turm', text: 'Das Wahrzeichen von Erchie: ein Wachturm aus dem 16. Jahrhundert, erbaut zum Schutz der Küste vor Piratenüberfällen. Er dominiert die Bucht mit seiner imposanten Masse. Nicht von innen zugänglich, aber eine unverzichtbare fotografische Kulisse.' },
              { n: 2, title: 'Abtei Santa Maria de Erchie', text: 'Eine alte Benediktinerabtei aus dem 11. Jahrhundert, hoch über dem Dorf gelegen. Die Reste des mittelalterlichen Bauwerks sind teilweise zugänglich und bieten einen Panoramablick über die Bucht.' },
              { n: 3, title: 'Das Fischerdorf', text: 'Schlendere durch die weißen Häuser, blumengesäumten Treppen und bunten Boote im Sand. Erchie hat seinen Charakter als Fischerdorf dank seiner abgelegenen Lage abseits der Hauptstraße bewahrt.' },
              { n: 4, title: 'Küstenweg Erchie–Cetara', text: 'Ein Küstenpfad, der Erchie mit Cetara durch mediterrane Macchie verbindet. Rund 3 km, 1 Stunde Wanderung, mit Blick auf die Küste und das Meer. Leichter Schwierigkeitsgrad.' },
            ].map(({ n, title, text }) => (
              <div class="grid sm:grid-cols-[auto_1fr] gap-4">
                <div class="w-14 h-14 rounded-[1rem] bg-med-gold/10 flex items-center justify-center flex-shrink-0 text-med-gold font-serif font-bold text-xl">{n}</div>
                <div>
                  <h3 class="font-semibold text-charcoal text-lg mb-1">{title}</h3>
                  <p class="text-slate-600 leading-relaxed">{text}</p>
                </div>
              </div>
            ))}
          </div>
        </div>

        <!-- Lokaler Tipp -->
        <div class="relative overflow-hidden rounded-[3rem] bg-med-blue p-10 md:p-14 text-white shadow-2xl">
          <div class="relative z-10 flex flex-col md:flex-row items-start md:items-center gap-8">
            <div class="w-20 h-20 rounded-2xl bg-white/10 flex items-center justify-center flex-shrink-0 border border-white/20"><svg class="w-10 h-10 text-med-gold" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 3v2.25m6.364.386-1.591 1.591M21 12h-2.25m-.386 6.364-1.591-1.591M12 18.75V21m-4.773-4.227-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0Z"/></svg></div>
            <div>
              <p class="text-med-gold text-xs font-bold uppercase tracking-[0.3em] mb-2">Lokaler Tipp</p>
              <h3 class="font-serif text-2xl font-bold text-white mb-3 tracking-tight">Das kampanische Geheimnis</h3>
              <p class="text-white/70 leading-relaxed">Erchie ist der Ort, an den Salernitaner und Kampaner ans Meer fahren, wenn sie die Küste ohne den Trubel möchten. Echter Sand, ruhiges Wasser, frischer Fisch und faire Preise. An einem Wochentag außerhalb der Hauptsaison könnte man den Strand fast für sich allein haben.</p>
            </div>
          </div>
          <div class="absolute bottom-0 left-0 translate-y-1/2 -translate-x-1/2 w-80 h-80 bg-med-gold/10 rounded-full blur-3xl pointer-events-none"></div>
        </div>

        <!-- FAQ -->
        <div id="faq">
          <h2 class="font-serif text-3xl font-semibold text-slate-900 mb-8">Häufig gestellte Fragen zu Erchie</h2>
          <div class="space-y-4">
            {faqSchema.mainEntity.map((q) => (
              <details class="group border border-slate-200 rounded-2xl overflow-hidden">
                <summary class="flex items-center justify-between px-6 py-4 cursor-pointer select-none text-charcoal font-medium hover:bg-slate-50 transition-colors">
                  {q.name}
                  <svg class="w-4 h-4 text-slate-400 group-open:rotate-180 transition-transform flex-shrink-0 ml-3" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
                </summary>
                <div class="px-6 pb-5 text-slate-600 leading-relaxed text-xs sm:text-sm border-t border-slate-100 pt-4">
                  {q.acceptedAnswer.text}
                </div>
              </details>
            ))}
          </div>
        </div>

      </div>

      <aside class="space-y-6 lg:sticky lg:top-24 self-start">
        <div id="fast-facts" class="bg-slate-900 text-white rounded-[3rem] p-6">
          <p class="text-[10px] uppercase tracking-[0.3em] text-med-gold font-medium mb-4">Kurzinfos - Erchie</p>
          <dl class="space-y-3">
            {fastFacts.map(({ dt, dd }, i) => (
              <>
                <div class="flex justify-between items-start gap-3">
                  <dt class="text-white/40 text-xs sm:text-sm font-light flex-shrink-0">{dt}</dt>
                  <dd class="text-white font-medium text-xs sm:text-sm text-right">{dd}</dd>
                </div>
                {i < fastFacts.length - 1 && <div class="border-t border-white/5"></div>}
              </>
            ))}
          </dl>
        </div>

        <div class="bg-med-cream border border-med-gold/30 rounded-[2rem] p-6">
          <p class="text-[10px] uppercase tracking-[0.3em] text-med-gold font-medium mb-3">Insider-Tipps</p>
          <ul class="space-y-3">
            {tips.map(tip => (
              <li class="flex items-start gap-2 text-xs sm:text-sm text-charcoal">
                <span class="w-1.5 h-1.5 rounded-full bg-med-gold mt-1.5 flex-shrink-0"></span>
                <span>{tip}</span>
              </li>
            ))}
          </ul>
        </div>

        <div class="bg-white border border-slate-100 rounded-[2rem] p-6 shadow-sm">
          <p class="text-[10px] uppercase tracking-[0.3em] text-slate-400 font-medium mb-3">Entdecke die Küste</p>
          <nav class="space-y-1">
            {[
              { href: '/de-de/amalfikueste/cetara/', label: 'Cetara' },
              { href: '/de-de/amalfikueste/maiori/', label: 'Maiori' },
              { href: '/de-de/amalfikueste/vietri-sul-mare/', label: 'Vietri sul Mare' },
              { href: '/de-de/amalfikueste/minori/', label: 'Minori' },
              { href: '/de-de/amalfikueste/amalfi/', label: 'Amalfi' },
            ].map(({ href, label }) => (
              <a href={href} class="flex items-center gap-2 px-3 py-2 rounded-xl text-xs sm:text-sm text-charcoal hover:bg-med-blue/5 hover:text-med-blue transition-colors">
                <span class="w-1.5 h-1.5 rounded-full bg-med-blue/30"></span> {label}
              </a>
            ))}
          </nav>
        </div>
      </aside>

    </div>
  </section>

  <CorrelationSlider
    heading="Mehr an der Amalfiküste entdecken"
    items={[
      { name: 'Cetara',   href: '/de-de/amalfikueste/cetara/',   tag: 'Fischerdorf',          desc: 'Das Fischerdorf und die Heimat der Colatura di Alici DOP.' },
      { name: 'Maiori',   href: '/de-de/amalfikueste/maiori/',   tag: 'Strand & Erholung',    desc: 'Der längste Sandstrand der Küste: 300 m.' },
      { name: 'Vietri',   href: '/de-de/amalfikueste/vietri-sul-mare/', tag: 'Keramik',       desc: 'Das Eingangstor zur Küste, bekannt für seine Kunstkeramik.' },
      { name: 'Minori',   href: '/de-de/amalfikueste/minori/',   tag: 'Genuss & Kultur',      desc: 'Römische Villa und frische Scialatielli-Pasta.' },
      { name: 'Amalfi',   href: '/de-de/amalfikueste/amalfi/',   tag: 'Seerepublik',          desc: 'Die historische Hauptstadt mit dem Dom und dem Papiermuseum.' },
    ]}
    lang="de-de"
  />

</BaseLayout>
