---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import CorrelationSlider from '../../../../components/CorrelationSlider.astro';
import Breadcrumbs from '../../../../components/Breadcrumbs.astro';

const lang = 'de-de';

const breadcrumbs = [
  { name: 'Startseite', url: '/de-de/' },
  { name: 'Amalfiküste', url: '/de-de/amalfikueste/' },
  { name: 'Agerola', url: '/de-de/amalfikueste/agerola/' },
];

const touristAttractionSchema = {
  "@context": "https://schema.org",
  "@type": "TouristAttraction",
  "name": "Agerola",
  "description": "Agerola ist der grüne Balkon der Amalfiküste, Ausgangspunkt des Götterwegs (Sentiero degli Dei) und Heimat des Fior di Latte. Auf 600 m Höhe bietet es Wanderungen, frische Luft und atemberaubende Ausblicke.",
  "url": "https://amalficoast-travel.com/de-de/amalfikueste/agerola/",
  "touristType": ["Wandern", "Natur", "Gastronomie", "Panoramen"],
  "address": { "@type": "PostalAddress", "addressLocality": "Agerola", "addressRegion": "Napoli", "addressCountry": "IT", "postalCode": "80051" },
  "geo": { "@type": "GeoCoordinates", "latitude": 40.6383, "longitude": 14.5417 }
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Wie kommt man nach Agerola?",
      "acceptedAnswer": { "@type": "Answer", "text": "Mit dem SITA-Bus ab Amalfi (ca. 40 Min.) oder ab Castellammare di Stabia/Gragnano (ca. 30 Min.). Mit dem Auto ab Neapel: Autobahn A3, Ausfahrt Castellammare di Stabia, dann SS366 Richtung Agerola. Parkplätze in Bomerano und San Lazzaro vorhanden." }
    },
    {
      "@type": "Question",
      "name": "Startet der Goetterweg in Agerola?",
      "acceptedAnswer": { "@type": "Answer", "text": "Ja, die klassische Route startet in Bomerano (Ortsteil von Agerola) und endet in Nocelle oberhalb von Positano, ca. 7,8 km, 3–4 Stunden Gehzeit. Der Weg ist als mittelschwer eingestuft. Bei Regen oder dichtem Nebel nicht begehbar." }
    },
    {
      "@type": "Question",
      "name": "Was ist der Fior di Latte von Agerola?",
      "acceptedAnswer": { "@type": "Answer", "text": "Es ist ein frischer Stracchinata-Käse aus Kuhmilch der Agerola-Rinder. Er hat einen zarten Geschmack und eine einzigartig weiche Konsistenz. Jede Käserei in Agerola hat ihre eigene Version: Am besten kauft man ihn direkt beim Erzeuger." }
    },
    {
      "@type": "Question",
      "name": "Ist Agerola familienfreundlich?",
      "acceptedAnswer": { "@type": "Answer", "text": "Ja, die Höhenlage (600 m) sorgt selbst im Sommer für angenehmes Klima. Es gibt leichte Wanderwege, Spielplätze, Agriturismo mit Tieren und besuchbare Käsereien. Eine perfekte Alternative zur Sommerhitze an der Küste für einen anderen Ausflugstag." }
    },
    {
      "@type": "Question",
      "name": "Was isst man in Agerola?",
      "acceptedAnswer": { "@type": "Answer", "text": "Fior di Latte und Käseprodukte sind die Hauptattraktion. Empfehlenswert sind auch Fusilli mit Kaninchen-Ragù, Pizza mit lokalem Fior di Latte, Süßspeisen auf Ricotta-Basis und gereifter Käse. Die Agriturismos bieten vollständige Menüs zu günstigen Preisen." }
    }
  ]
};

const schemas = [touristAttractionSchema, faqSchema];

const fastFacts = [
  { dt: 'Lage', dd: 'Monti Lattari, NA' },
  { dt: 'Höhe', dd: '~600 m ü. M.' },
  { dt: 'Einwohner', dd: '~7.500' },
  { dt: 'Ortsteile', dd: 'Bomerano, San Lazzaro, Pianillo' },
  { dt: 'Ab Amalfi', dd: '40 Min. (SITA-Bus)' },
  { dt: 'Goetterweg', dd: 'Start in Bomerano' },
  { dt: 'Spezialitäten', dd: 'Fior di Latte, Käse' },
  { dt: 'Beste Reisezeit', dd: 'Apr–Okt (Wandern)' },
  { dt: 'Ideal für', dd: 'Wandern, Familien, Foodies' },
];

const tips = [
  'Starte früh auf dem Götterweg (vor 8:00 Uhr): Du hast den Weg fast für dich und das beste Licht für Fotos.',
  'Kaufe den Fior di Latte direkt in den Käsereien von San Lazzaro: Er kostet weniger und du isst ihn frisch, noch warm.',
  'Wenn dir der Götterweg zu belebt ist, probiere den Sentiero dei Tre Calli oder den Weg zur Grotta di Santa Barbara.',
  'Im Sommer ist Agerola 8–10 Grad kühler als die Küste: Pack auch im August ein leichtes Fleece ein.',
];
---

<BaseLayout
  title="Agerola 2026: Goetterweg, Fior di Latte & Wandern"
  description="Vollständiger Reiseführer für Agerola: Ausgangspunkt des Götterwegs (Sentiero degli Dei), Heimat des Fior di Latte, Wandern in den Monti Lattari und Panoramen auf die Amalfiküste aus 600 m Höhe."
  lang={lang}
  breadcrumbs={breadcrumbs}
  schema={schemas}
  pageKey="agerola"

  heroImage="/images/agerola-hero.webp"
>

  <!-- Hero -->
  <section class="relative h-[75vh] sm:h-[90vh] flex items-center bg-charcoal overflow-hidden">
    <img src="/images/agerola-hero.webp" alt="Agerola, der grüne Balkon der Amalfiküste" class="absolute inset-0 w-full h-full object-cover" loading="eager" fetchpriority="high" decoding="sync" referrerpolicy="no-referrer"/>
    <div class="absolute inset-0 bg-gradient-to-b from-black/10 via-black/40 to-black/80 z-10"></div>
    <div class="relative z-20 max-w-editorial mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <p class="text-med-gold text-xs sm:text-sm font-medium uppercase tracking-[0.3em] mb-3">Monti Lattari · 600 m ue. M.</p>
        <h1 class="font-serif text-display text-white mb-4">Agerola</h1>
        <p class="text-xl text-white/80 leading-relaxed max-w-2xl">
          Der grüne Balkon der Küste. Startpunkt des Götterwegs, Heimat des Fior di Latte und der schwindelerregendsten Panoramen der Region.
        </p>
        <div class="flex flex-wrap gap-3 mt-8">
          <a href="#fast-facts" class="px-5 py-2.5 bg-med-gold text-white text-xs sm:text-sm font-semibold rounded-full hover:scale-105 hover:shadow-[0_8px_25px_rgba(212,175,55,0.4)] transition-all duration-300">Schnellinfos</a>
          <a href="#goetterweg" class="px-5 py-2.5 bg-white/10 backdrop-blur text-white text-xs sm:text-sm font-medium rounded-full border border-white/20 hover:bg-white/20 transition-colors">Goetterweg</a>
          <a href="#faq" class="px-5 py-2.5 bg-white/10 backdrop-blur text-white text-xs sm:text-sm font-medium rounded-full border border-white/20 hover:bg-white/20 transition-colors">FAQ</a>
        </div>
      </div>
    </div>
    <Breadcrumbs breadcrumbs={breadcrumbs} />
  </section>

  <section class="max-w-editorial mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="grid lg:grid-cols-[1fr_320px] gap-12">

      <div class="space-y-16">

        <div class="prose-editorial">
          <p class="text-xl leading-relaxed text-charcoal">
            Agerola ist das bestgehütete Geheimnis der Amalfiküste. Auf 600 Metern Höhe, versteckt zwischen den Monti Lattari, bietet diese Gemeinschaft von Hirten und Bauern das, was die Küste nicht geben kann: frische Luft, Stille, spektakuläre Wanderwege und eine Käsetradition, die bis ins Mittelalter zurückreicht.
          </p>
          <p class="mt-4 text-slate-600 leading-relaxed">
            Von hier aus startet der berühmte <strong>Götterweg</strong> (Sentiero degli Dei), einer der schönsten Wanderwege Europas. Aber Agerola ist nicht nur der Ausgangspunkt eines Weges: Es ist eine eigene Welt, bestehend aus verstreuten Ortsteilen (Bomerano, San Lazzaro, Pianillo), handwerklichen Käsereien und Trattorien, die noch mit Produkten aus dem eigenen Garten kochen.
          </p>
        </div>

        <!-- Wusstest du? -->
        <div class="bg-slate-900 border border-white/10 rounded-[3rem] p-8">
          <p class="text-[10px] uppercase tracking-[0.3em] text-med-gold font-medium mb-4">Wusstest du?</p>
          <div class="grid sm:grid-cols-3 gap-6">
            <div class="text-center">
              <p class="font-serif text-5xl font-bold text-med-gold">7,8 km</p>
              <p class="text-white/60 text-xs italic mt-1">der Götterweg, von Bomerano nach Nocelle</p>
            </div>
            <div class="text-center">
              <p class="font-serif text-5xl font-bold text-med-gold">600 m</p>
              <p class="text-white/60 text-xs italic mt-1">Höhe, 8–10 °C kühler als die Küste</p>
            </div>
            <div class="text-center">
              <p class="font-serif text-5xl font-bold text-med-gold">XII Jh.</p>
              <p class="text-white/60 text-xs italic mt-1">dokumentierte Käsetradition</p>
            </div>
          </div>
        </div>

        <!-- Der Götterweg -->
        <div id="goetterweg">
          <h2 class="font-serif text-3xl font-semibold text-slate-900 mb-6">Der Goetterweg (Sentiero degli Dei)</h2>
          <p class="text-slate-600 text-lg leading-relaxed mb-6">
            Der berühmteste Wanderweg der Amalfiküste: ein Panoramaweg, in den Fels der Monti Lattari gehauen, mit Blick senkrecht auf das Meer.
          </p>
          <div class="bg-white p-6 rounded-2xl border border-slate-100 space-y-4">
            <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
              <div>
                <p class="text-xs text-slate-400 uppercase tracking-wider">Start</p>
                <p class="font-medium text-charcoal">Bomerano (Agerola)</p>
              </div>
              <div>
                <p class="text-xs text-slate-400 uppercase tracking-wider">Ziel</p>
                <p class="font-medium text-charcoal">Nocelle (Positano)</p>
              </div>
              <div>
                <p class="text-xs text-slate-400 uppercase tracking-wider">Distanz</p>
                <p class="font-medium text-charcoal">~7,8 km</p>
              </div>
              <div>
                <p class="text-xs text-slate-400 uppercase tracking-wider">Dauer</p>
                <p class="font-medium text-charcoal">3–4 Stunden</p>
              </div>
            </div>
            <p class="text-slate-600 text-sm leading-relaxed">
              <strong>Schwierigkeit:</strong> Mittel. Höhenunterschied bergab ca. 600 m. Wanderschuhe Pflicht, Stöcke empfohlen. Mindestens 1,5 Liter Wasser mitnehmen. <strong>Bei Regen oder Nebel nicht begehbar.</strong> Von Nocelle geht es nach Positano mit 1.500 Stufen oder dem Ortsbus.
            </p>
          </div>
        </div>

        <!-- Sehenswürdigkeiten -->
        <div>
          <h2 class="font-serif text-3xl font-semibold text-slate-900 mb-8">Sehenswuerdigkeiten in Agerola</h2>
          <div class="space-y-8">
            {[
              { n: 1, title: 'Bomerano und der Startpunkt des Weges', text: 'Der bekannteste Ortsteil mit dem kleinen Platz, von dem der Götterweg startet. Bars, Lebensmittelläden und der Informationspunkt des Parco dei Monti Lattari. Von hier aus ist der Ausblick auf Capri und die Küste bereits atemberaubend.' },
              { n: 2, title: 'Käsereien und Fior di Latte', text: 'Der Fior di Latte von Agerola ist ein frischer Käse aus Milch der in der Höhe gezüchteten Agerola-Rinder. Verschiedene Käsereien empfangen Besucher zur Verkostung. Auch geräucherte Provola und frische Ricotta sind empfehlenswert.' },
              { n: 3, title: 'Sentiero dei Tre Calli', text: 'Weniger frequentierte Alternative zum Götterweg. Verbindet Agerola mit Positano durch einen Weg, der Kastanienwälder und Zitronenterrassen durchquert. Länger (5–6 Stunden), aber genauso panoramisch.' },
              { n: 4, title: 'Regionalpark der Monti Lattari', text: 'Agerola liegt im Herzen des Parks: markierte Wanderwege, Steineichen- und Kastanienwälder, Karsthöhlen und einzigartige Artenvielfalt. Das Besucherzentrum in San Lazzaro gibt Karten und Informationen aus.' },
              { n: 5, title: 'Grotta di Santa Barbara', text: 'Eine Karsthöhle, die mit einer ca. 2-stündigen Wanderung ab San Lazzaro erreichbar ist. Im Inneren Stalaktiten und eine eindrucksvolle Atmosphäre. Freier Eintritt, aber ein lokaler Führer ist empfehlenswert.' },
            ].map(({ n, title, text }) => (
              <div class="grid sm:grid-cols-[auto_1fr] gap-4">
                <div class="w-14 h-14 rounded-[1rem] bg-med-gold/10 flex items-center justify-center flex-shrink-0 text-med-gold font-serif font-bold text-xl">{n}</div>
                <div>
                  <h3 class="font-semibold text-charcoal text-lg mb-1">{title}</h3>
                  <p class="text-slate-600 leading-relaxed">{text}</p>
                </div>
              </div>
            ))}
          </div>
        </div>

        <!-- Lokaler Tipp -->
        <div class="relative overflow-hidden rounded-[3rem] bg-med-blue p-10 md:p-14 text-white shadow-2xl">
          <div class="relative z-10 flex flex-col md:flex-row items-start md:items-center gap-8">
            <div class="w-20 h-20 rounded-2xl bg-white/10 flex items-center justify-center flex-shrink-0 border border-white/20"><svg class="w-10 h-10 text-med-gold" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 3v2.25m6.364.386-1.591 1.591M21 12h-2.25m-.386 6.364-1.591-1.591M12 18.75V21m-4.773-4.227-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0Z"/></svg></div>
            <div>
              <p class="text-med-gold text-xs font-bold uppercase tracking-[0.3em] mb-2">Lokaler Tipp</p>
              <h3 class="font-serif text-2xl font-bold text-white mb-3 tracking-tight">Fior di Latte direkt aus der Käserei</h3>
              <p class="text-white/70 leading-relaxed">Halte gegen 10:00 Uhr morgens in einer Käserei in San Lazzaro, wenn der Fior di Latte noch warm aus der Produktion kommt. Kaufe ihn, füge etwas lokales Brot und eine Tomate hinzu: das perfekte Mittagessen vor dem Wanderweg.</p>
            </div>
          </div>
          <div class="absolute bottom-0 left-0 translate-y-1/2 -translate-x-1/2 w-80 h-80 bg-med-gold/10 rounded-full blur-3xl pointer-events-none"></div>
        </div>

        <!-- FAQ -->
        <div id="faq">
          <h2 class="font-serif text-3xl font-semibold text-slate-900 mb-8">Haeufig gestellte Fragen zu Agerola</h2>
          <div class="space-y-4">
            {faqSchema.mainEntity.map((q) => (
              <details class="group border border-slate-200 rounded-2xl overflow-hidden">
                <summary class="flex items-center justify-between px-6 py-4 cursor-pointer select-none text-charcoal font-medium hover:bg-slate-50 transition-colors">
                  {q.name}
                  <svg class="w-4 h-4 text-slate-400 group-open:rotate-180 transition-transform flex-shrink-0 ml-3" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
                </summary>
                <div class="px-6 pb-5 text-slate-600 leading-relaxed text-xs sm:text-sm border-t border-slate-100 pt-4">
                  {q.acceptedAnswer.text}
                </div>
              </details>
            ))}
          </div>
        </div>

      </div>

      <aside class="space-y-6 lg:sticky lg:top-24 self-start">
        <div id="fast-facts" class="bg-slate-900 text-white rounded-[3rem] p-6">
          <p class="text-[10px] uppercase tracking-[0.3em] text-med-gold font-medium mb-4">Schnellinfos - Agerola</p>
          <dl class="space-y-3">
            {fastFacts.map(({ dt, dd }, i) => (
              <>
                <div class="flex justify-between items-start gap-3">
                  <dt class="text-white/40 text-xs sm:text-sm font-light flex-shrink-0">{dt}</dt>
                  <dd class="text-white font-medium text-xs sm:text-sm text-right">{dd}</dd>
                </div>
                {i < fastFacts.length - 1 && <div class="border-t border-white/5"></div>}
              </>
            ))}
          </dl>
        </div>

        <div class="bg-med-cream border border-med-gold/30 rounded-[2rem] p-6">
          <p class="text-[10px] uppercase tracking-[0.3em] text-med-gold font-medium mb-3">Insider-Tipps</p>
          <ul class="space-y-3">
            {tips.map(tip => (
              <li class="flex items-start gap-2 text-xs sm:text-sm text-charcoal">
                <span class="w-1.5 h-1.5 rounded-full bg-med-gold mt-1.5 flex-shrink-0"></span>
                <span>{tip}</span>
              </li>
            ))}
          </ul>
        </div>

        <div class="bg-white border border-slate-100 rounded-[2rem] p-6 shadow-sm">
          <p class="text-[10px] uppercase tracking-[0.3em] text-slate-400 font-medium mb-3">Erkunde die Amalfikueste</p>
          <nav class="space-y-1">
            {[
              { href: '/de-de/amalfikueste/furore/', label: 'Furore' },
              { href: '/de-de/amalfikueste/praiano/', label: 'Praiano' },
              { href: '/de-de/amalfikueste/positano/', label: 'Positano' },
              { href: '/de-de/amalfikueste/amalfi/', label: 'Amalfi' },
              { href: '/de-de/amalfikueste/tramonti/', label: 'Tramonti' },
            ].map(({ href, label }) => (
              <a href={href} class="flex items-center gap-2 px-3 py-2 rounded-xl text-xs sm:text-sm text-charcoal hover:bg-med-blue/5 hover:text-med-blue transition-colors">
                <span class="w-1.5 h-1.5 rounded-full bg-med-blue/30"></span> {label}
              </a>
            ))}
          </nav>
        </div>
      </aside>

    </div>
  </section>

  <CorrelationSlider
    heading="Entdecke mehr an der Amalfikueste"
    items={[
      { name: 'Furore',   href: '/de-de/amalfikueste/furore/',   tag: 'Das Dorf das nicht existiert', desc: 'Der spektakuläre Fjord und das bemalte Dorf ohne Zentrum.' },
      { name: 'Praiano',  href: '/de-de/amalfikueste/praiano/',  tag: 'Sonnenuntergang & Ruhe', desc: 'Der Sonnenuntergang von San Gennaro und die ruhige Marina di Praia.' },
      { name: 'Positano', href: '/de-de/amalfikueste/positano/', tag: 'Mode & Aussichten', desc: 'Bunte Häuser auf dem Meer und der Strand Fornillo.' },
      { name: 'Tramonti', href: '/de-de/amalfikueste/tramonti/', tag: 'Hinterland & Wein', desc: 'Die grüne Lunge der Küste, Land der Weine und Traditionen.' },
      { name: 'Amalfi',   href: '/de-de/amalfikueste/amalfi/',   tag: 'Seerepublik', desc: 'Die historische Hauptstadt mit dem Dom und dem Papiermuseum.' },
    ]}
    lang="de-de"
  />

</BaseLayout>
