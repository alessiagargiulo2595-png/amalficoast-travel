---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import CorrelationSlider from '../../../../components/CorrelationSlider.astro';
import Breadcrumbs from '../../../../components/Breadcrumbs.astro';

const lang = 'de-de';

const breadcrumbs = [
  { name: 'Startseite', url: '/de-de/' },
  { name: 'Amalfiküste', url: '/de-de/amalfikueste/' },
  { name: 'Conca dei Marini', url: '/de-de/amalfikueste/conca-dei-marini/' },
];

const touristAttractionSchema = {
  "@context": "https://schema.org",
  "@type": "TouristAttraction",
  "name": "Conca dei Marini",
  "description": "Conca dei Marini ist ein exklusives Dorf an der Amalfiküste, bekannt für die Smaragdgrotte, das Gebäck Sfogliatella Santa Rosa und private Villen hoch über dem Meer.",
  "url": "https://amalficoast-travel.com/de-de/amalfikueste/conca-dei-marini/",
  "touristType": ["Meer", "Kultur", "Gastronomie", "Exklusivität"],
  "address": { "@type": "PostalAddress", "addressLocality": "Conca dei Marini", "addressRegion": "Salerno", "addressCountry": "IT", "postalCode": "84010" },
  "geo": { "@type": "GeoCoordinates", "latitude": 40.6192, "longitude": 14.5739 }
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Wie besucht man die Smaragdgrotte?",
      "acceptedAnswer": { "@type": "Answer", "text": "Sie ist per Aufzug von der SS163 (Eintritt ca. 5 €) oder per Boot von Amalfi (ca. 10 € mit Ausflug) erreichbar. Im Inneren fährt man in kleinen Ruderbooten und bewundert das smaragdgrüne Wasser, das durch eine Unterwasseröffnung von natürlichem Licht beleuchtet wird. Das ganze Jahr über geöffnet, wetterabhängig." }
    },
    {
      "@type": "Question",
      "name": "Was ist die Sfogliatella Santa Rosa?",
      "acceptedAnswer": { "@type": "Answer", "text": "Es ist das Gebäck aus Conca dei Marini, das im 17. Jahrhundert von den Nonnen des Klosters Santa Rosa erfunden wurde. Im Gegensatz zur neapolitanischen Sfogliatella ist die Santa Rosa größer, mit Konditorcreme, Ricotta und saurer Kirsche gefüllt und hat eine knusprige Blätterteighülle. Sie ist die Vorläuferin der neapolitanischen Sfogliatella." }
    },
    {
      "@type": "Question",
      "name": "Wie kommt man nach Conca dei Marini?",
      "acceptedAnswer": { "@type": "Answer", "text": "Mit dem SITA-Bus auf der Linie Amalfi–Positano (Haltestelle: Conca dei Marini). Mit dem Auto auf der SS163, zwischen Amalfi und Furore. Per Boot von Amalfi (Privatservice oder Wassertaxi). Das Dorf ist klein und nach der Ankunft gut zu Fuß zu erkunden." }
    },
    {
      "@type": "Question",
      "name": "Gibt es Strände in Conca dei Marini?",
      "acceptedAnswer": { "@type": "Answer", "text": "Ja, der Strand Capo di Conca ist über eine lange Treppe erreichbar. Es ist eine Kiesbucht mit kristallklarem Wasser und sehr wenig Besuchern. Das Lido Capo di Conca bietet auch einen ausgestatteten Service (Liegestühle, Bar). Die Bucht ist geschützt und das Wasser gehört zu den klarsten an der Küste." }
    },
    {
      "@type": "Question",
      "name": "Lohnt sich ein Besuch in Conca dei Marini?",
      "acceptedAnswer": { "@type": "Answer", "text": "Ja, besonders wenn man Exklusivität und Ruhe sucht. Es ist eine der kleinsten Gemeinden an der Küste (ca. 700 Einwohner), mit eleganten Villen, der Smaragdgrotte und einer gehobenen Atmosphäre. Kombiniere es mit einem Besuch in Amalfi oder Furore für einen perfekten halben Tag." }
    }
  ]
};

const schemas = [touristAttractionSchema, faqSchema];

const fastFacts = [
  { dt: 'Lage', dd: 'Amalfiküste, SA' },
  { dt: 'Höhe', dd: '0–400 m' },
  { dt: 'Einwohner', dd: '~700' },
  { dt: 'Von Amalfi', dd: '10 Min. (Auto/Bus)' },
  { dt: 'Smaragdgrotte', dd: 'Ganzjährig geöffnet' },
  { dt: 'Strand', dd: 'Capo di Conca (Kiesel)' },
  { dt: 'Spezialität', dd: 'Sfogliatella Santa Rosa' },
  { dt: 'Beste Reisezeit', dd: 'Apr.–Okt.' },
  { dt: 'Ideal für', dd: 'Exklusivität, Kultur, Meer' },
];

const tips = [
  'Die Smaragdgrotte ist zur Mittagszeit am schönsten, wenn das Sonnenlicht ins Wasser fällt. Bewölkte Tage meiden.',
  'Die Sfogliatella Santa Rosa gibt es in der Pasticceria Pansa in Amalfi oder in Conca selbst – sie unterscheidet sich deutlich von der neapolitanischen Version.',
  'Das Lido Capo di Conca ist einer der wenigen zugänglichen Strandclubs in der Gegend: Im Sommer unbedingt im Voraus buchen.',
  'Conca dei Marini ist ein beliebter Rückzugsort für VIPs: private Villen mit Pools auf den Klippen, weit weg vom touristischen Trubel.',
];
---

<BaseLayout
  title="Conca dei Marini 2026: Smaragdgrotte & Sfogliatella Santa Rosa"
  description="Reiseführer Conca dei Marini: Smaragdgrotte, Sfogliatella Santa Rosa, versteckte Strände und exklusive Villen. Das diskreteste Dorf an der Amalfiküste."
  lang={lang}
  breadcrumbs={breadcrumbs}
  schema={schemas}
  pageKey="conca-dei-marini"

  heroImage="/images/conca-dei-marini-hero.webp"
>

  <!-- Hero -->
  <section class="relative h-[75vh] sm:h-[90vh] flex items-center bg-charcoal overflow-hidden">
    <img src="/images/conca-dei-marini-hero.webp" alt="Conca dei Marini und die Smaragdgrotte" class="absolute inset-0 w-full h-full object-cover" loading="eager" fetchpriority="high" decoding="sync" referrerpolicy="no-referrer"/>
    <div class="absolute inset-0 bg-gradient-to-b from-black/10 via-black/40 to-black/80 z-10"></div>
    <div class="relative z-20 max-w-editorial mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <p class="text-med-gold text-xs sm:text-sm font-medium uppercase tracking-[0.3em] mb-3">Das verborgene Juwel der Küste</p>
        <h1 class="font-serif text-display text-white mb-4">Conca dei Marini</h1>
        <p class="text-xl text-white/80 leading-relaxed max-w-2xl">
          Die Smaragdgrotte, die Sfogliatella Santa Rosa und exklusive Villen über dem Meer. Das diskreteste Dorf an der Küste.
        </p>
        <div class="flex flex-wrap gap-3 mt-8">
          <a href="#fast-facts" class="px-5 py-2.5 bg-med-gold text-white text-xs sm:text-sm font-semibold rounded-full hover:scale-105 hover:shadow-[0_8px_25px_rgba(212,175,55,0.4)] transition-all duration-300">Kurzinfos</a>
          <a href="#smaragdgrotte" class="px-5 py-2.5 bg-white/10 backdrop-blur text-white text-xs sm:text-sm font-medium rounded-full border border-white/20 hover:bg-white/20 transition-colors">Smaragdgrotte</a>
          <a href="#faq" class="px-5 py-2.5 bg-white/10 backdrop-blur text-white text-xs sm:text-sm font-medium rounded-full border border-white/20 hover:bg-white/20 transition-colors">FAQ</a>
        </div>
      </div>
    </div>
    <Breadcrumbs breadcrumbs={breadcrumbs} />
  </section>

  <section class="max-w-editorial mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="grid lg:grid-cols-[1fr_320px] gap-12">

      <div class="space-y-16">

        <div class="prose-editorial">
          <p class="text-xl leading-relaxed text-charcoal">
            Conca dei Marini ist das Dorf an der Amalfiküste, das Stille der Berühmtheit vorzieht. Mit kaum 700 Einwohnern, ohne Strandpromenade und ohne touristisches Chaos verbirgt diese kleine Gemeinde zwischen <a href="/de-de/amalfikueste/amalfi/" class="text-med-blue hover:underline">Amalfi</a> und <a href="/de-de/amalfikueste/furore/" class="text-med-blue hover:underline">Furore</a> zwei Schätze: die <strong>Smaragdgrotte</strong> und die <strong>Sfogliatella Santa Rosa</strong>.
          </p>
          <p class="mt-4 text-slate-600 leading-relaxed">
            Einst ein Zentrum des Seehandels, segelten die Seeleute von Conca dei Marini bis nach Afrika und in den Orient. Heute sind die alten Kapitänshäuser zu exklusiven Villen geworden, die von jenen gewählt werden, die die authentischste und privateste Ecke der Küste suchen.
          </p>
        </div>

        <!-- Wusstest du das? -->
        <div class="bg-slate-900 border border-white/10 rounded-[3rem] p-8">
          <p class="text-[10px] uppercase tracking-[0.3em] text-med-gold font-medium mb-4">Wusstest du das?</p>
          <div class="grid sm:grid-cols-3 gap-6">
            <div class="text-center">
              <p class="font-serif text-5xl font-bold text-med-gold">XVII Jh.</p>
              <p class="text-white/60 text-xs italic mt-1">Erfindung der Sfogliatella Santa Rosa</p>
            </div>
            <div class="text-center">
              <p class="font-serif text-5xl font-bold text-med-gold">24 m</p>
              <p class="text-white/60 text-xs italic mt-1">Tiefe der Smaragdgrotte</p>
            </div>
            <div class="text-center">
              <p class="font-serif text-5xl font-bold text-med-gold">~700</p>
              <p class="text-white/60 text-xs italic mt-1">Einwohner – eines der kleinsten Dörfer an der Küste</p>
            </div>
          </div>
          <p class="text-white/40 text-xs mt-6 italic">
            Die Sfogliatella Santa Rosa wurde im Kloster Santa Rosa von Dominikanerinnen erfunden, die übrig gebliebenen Teig mit Creme, Ricotta und saurer Kirsche füllten. Hier liegt auch der Ursprung der neapolitanischen Sfogliatella.
          </p>
        </div>

        <!-- Smaragdgrotte -->
        <div id="smaragdgrotte">
          <h2 class="font-serif text-3xl font-semibold text-slate-900 mb-6">Die Smaragdgrotte</h2>
          <p class="text-slate-600 text-lg leading-relaxed mb-6">
            1932 von einem einheimischen Fischer entdeckt, ist die <strong>Smaragdgrotte</strong> eine halb untergetauchte Karsthöhle, in der Sonnenlicht durch einen Unterwasserspalt fällt und das Wasser in ein intensives Smaragdgrün taucht.
          </p>
          <div class="bg-white p-6 rounded-2xl border border-slate-100 space-y-4">
            <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
              <div>
                <p class="text-xs text-slate-400 uppercase tracking-wider">Eintritt</p>
                <p class="font-medium text-charcoal">~5 €</p>
              </div>
              <div>
                <p class="text-xs text-slate-400 uppercase tracking-wider">Zugang</p>
                <p class="font-medium text-charcoal">Aufzug oder Boot</p>
              </div>
              <div>
                <p class="text-xs text-slate-400 uppercase tracking-wider">Besuchsdauer</p>
                <p class="font-medium text-charcoal">~15–20 Min.</p>
              </div>
              <div>
                <p class="text-xs text-slate-400 uppercase tracking-wider">Öffnungszeiten</p>
                <p class="font-medium text-charcoal">Ganzjährig</p>
              </div>
            </div>
            <p class="text-slate-600 text-sm leading-relaxed">
              Im Inneren navigiert man in kleinen Ruderbooten. Auf dem Boden befindet sich eine Unterwasser-Krippenszene aus Keramik, die in den 1960er Jahren aufgestellt wurde. Die Grotte ist von der SS163 per Aufzug oder per Boot von <a href="/de-de/amalfikueste/amalfi/" class="text-med-blue hover:underline">Amalfi</a> mit Bootsausflügen zugänglich (ca. 10 €).
            </p>
          </div>
        </div>

        <!-- Was gibt es zu sehen -->
        <div>
          <h2 class="font-serif text-3xl font-semibold text-slate-900 mb-8">Was gibt es in Conca dei Marini zu sehen</h2>
          <div class="space-y-8">
            {[
              { n: 1, title: 'Smaragdgrotte', text: 'Die Hauptattraktion: eine Meereshöhle mit smaragdgrünem Wasser, die per Ruderboot erkundet wird. Ganzjährig geöffnet (wetterabhängig). An sonnigen Tagen, wenn das Licht am intensivsten ist, ein Muss.' },
              { n: 2, title: 'Kloster Santa Rosa', text: 'Das Kloster aus dem 17. Jahrhundert, in dem die Nonnen die Sfogliatella Santa Rosa erfanden. Heute ist es ein Luxushotel (Hotel Monastero Santa Rosa), aber das Äußere und die Kirche sind von der Straße aus sichtbar.' },
              { n: 3, title: 'Strand Capo di Conca', text: 'Eine Kiesbucht, die über eine Treppe erreichbar ist. Kristallklares Wasser und sehr wenig Besucher. Das Lido Capo di Conca bietet einen ausgestatteten Service mit Liegestühlen, Sonnenschirmen und einer Bar.' },
              { n: 4, title: 'Kirche San Pancrazio', text: 'Die Dorfpfarrkirche mit einer majolika-gefliesten Kuppel, die von der Straße aus sichtbar ist. Barockes Inneres mit Gemälden aus dem 17.–18. Jahrhundert. Für Gottesdienste geöffnet.' },
              { n: 5, title: 'Turm von Capo di Conca', text: 'Ein Küstenwachturm aus dem 16. Jahrhundert in einer Panoramalage oberhalb des Strandes. Vom Ortszentrum in 10 Minuten zu Fuß erreichbar.' },
            ].map(({ n, title, text }) => (
              <div class="grid sm:grid-cols-[auto_1fr] gap-4">
                <div class="w-14 h-14 rounded-[1rem] bg-med-gold/10 flex items-center justify-center flex-shrink-0 text-med-gold font-serif font-bold text-xl">{n}</div>
                <div>
                  <h3 class="font-semibold text-charcoal text-lg mb-1">{title}</h3>
                  <p class="text-slate-600 leading-relaxed">{text}</p>
                </div>
              </div>
            ))}
          </div>
        </div>

        <!-- Lokaler Tipp -->
        <div class="relative overflow-hidden rounded-[3rem] bg-med-blue p-10 md:p-14 text-white shadow-2xl">
          <div class="relative z-10 flex flex-col md:flex-row items-start md:items-center gap-8">
            <div class="w-20 h-20 rounded-2xl bg-white/10 flex items-center justify-center flex-shrink-0 border border-white/20"><svg class="w-10 h-10 text-med-gold" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 3v2.25m6.364.386-1.591 1.591M21 12h-2.25m-.386 6.364-1.591-1.591M12 18.75V21m-4.773-4.227-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0Z"/></svg></div>
            <div>
              <p class="text-med-gold text-xs font-bold uppercase tracking-[0.3em] mb-2">Lokaler Tipp</p>
              <h3 class="font-serif text-2xl font-bold text-white mb-3 tracking-tight">Die echte Sfogliatella Santa Rosa</h3>
              <p class="text-white/70 leading-relaxed">Die Sfogliatella Santa Rosa unterscheidet sich stark von der neapolitanischen Version: größer, mit Konditorcreme, Ricotta und saurer Kirsche. Suche sie in Konditoreien an der Küste (nicht in Neapel). Sie ist das Gebäck, das die gesamte Sfogliatella-Tradition Kampaniens inspiriert hat.</p>
            </div>
          </div>
          <div class="absolute bottom-0 left-0 translate-y-1/2 -translate-x-1/2 w-80 h-80 bg-med-gold/10 rounded-full blur-3xl pointer-events-none"></div>
        </div>

        <!-- FAQ -->
        <div id="faq">
          <h2 class="font-serif text-3xl font-semibold text-slate-900 mb-8">Häufig gestellte Fragen zu Conca dei Marini</h2>
          <div class="space-y-4">
            {faqSchema.mainEntity.map((q) => (
              <details class="group border border-slate-200 rounded-2xl overflow-hidden">
                <summary class="flex items-center justify-between px-6 py-4 cursor-pointer select-none text-charcoal font-medium hover:bg-slate-50 transition-colors">
                  {q.name}
                  <svg class="w-4 h-4 text-slate-400 group-open:rotate-180 transition-transform flex-shrink-0 ml-3" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
                </summary>
                <div class="px-6 pb-5 text-slate-600 leading-relaxed text-xs sm:text-sm border-t border-slate-100 pt-4">
                  {q.acceptedAnswer.text}
                </div>
              </details>
            ))}
          </div>
        </div>

      </div>

      <aside class="space-y-6 lg:sticky lg:top-24 self-start">
        <div id="fast-facts" class="bg-slate-900 text-white rounded-[3rem] p-6">
          <p class="text-[10px] uppercase tracking-[0.3em] text-med-gold font-medium mb-4">Kurzinfos – Conca dei Marini</p>
          <dl class="space-y-3">
            {fastFacts.map(({ dt, dd }, i) => (
              <>
                <div class="flex justify-between items-start gap-3">
                  <dt class="text-white/40 text-xs sm:text-sm font-light flex-shrink-0">{dt}</dt>
                  <dd class="text-white font-medium text-xs sm:text-sm text-right">{dd}</dd>
                </div>
                {i < fastFacts.length - 1 && <div class="border-t border-white/5"></div>}
              </>
            ))}
          </dl>
        </div>

        <div class="bg-med-cream border border-med-gold/30 rounded-[2rem] p-6">
          <p class="text-[10px] uppercase tracking-[0.3em] text-med-gold font-medium mb-3">Insider-Tipps</p>
          <ul class="space-y-3">
            {tips.map(tip => (
              <li class="flex items-start gap-2 text-xs sm:text-sm text-charcoal">
                <span class="w-1.5 h-1.5 rounded-full bg-med-gold mt-1.5 flex-shrink-0"></span>
                <span>{tip}</span>
              </li>
            ))}
          </ul>
        </div>

        <div class="bg-white border border-slate-100 rounded-[2rem] p-6 shadow-sm">
          <p class="text-[10px] uppercase tracking-[0.3em] text-slate-400 font-medium mb-3">Entdecke die Küste</p>
          <nav class="space-y-1">
            {[
              { href: '/de-de/amalfikueste/furore/', label: 'Furore' },
              { href: '/de-de/amalfikueste/amalfi/', label: 'Amalfi' },
              { href: '/de-de/amalfikueste/praiano/', label: 'Praiano' },
              { href: '/de-de/amalfikueste/positano/', label: 'Positano' },
              { href: '/de-de/amalfikueste/ravello/', label: 'Ravello' },
            ].map(({ href, label }) => (
              <a href={href} class="flex items-center gap-2 px-3 py-2 rounded-xl text-xs sm:text-sm text-charcoal hover:bg-med-blue/5 hover:text-med-blue transition-colors">
                <span class="w-1.5 h-1.5 rounded-full bg-med-blue/30"></span> {label}
              </a>
            ))}
          </nav>
        </div>
      </aside>

    </div>
  </section>

  <CorrelationSlider
    heading="Mehr an der Amalfiküste entdecken"
    items={[
      { name: 'Furore',   href: '/de-de/amalfikueste/furore/',   tag: 'Das Dorf, das nicht existiert', desc: 'Der spektakuläre Fjord und die Wandmalereien des bemalten Dorfes.' },
      { name: 'Amalfi',   href: '/de-de/amalfikueste/amalfi/',   tag: 'Maritime Republik',              desc: 'Die historische Hauptstadt mit dem Dom und dem Papiermuseum.' },
      { name: 'Praiano',  href: '/de-de/amalfikueste/praiano/',  tag: 'Sonnenuntergang & Ruhe',         desc: 'Der Sonnenuntergang von San Gennaro und der Strand Gavitella.' },
      { name: 'Ravello',  href: '/de-de/amalfikueste/ravello/',  tag: 'Musik & Gärten',                 desc: 'Villa Rufolo, Villa Cimbrone und das Musikfestival.' },
      { name: 'Positano', href: '/de-de/amalfikueste/positano/', tag: 'Mode & Ausblicke',               desc: 'Bunte Häuser über dem Meer und der Strand Fornillo.' },
    ]}
    lang="de-de"
  />

</BaseLayout>
