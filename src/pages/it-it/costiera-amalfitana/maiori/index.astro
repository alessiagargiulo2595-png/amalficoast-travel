---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import CorrelationSlider from '../../../../components/CorrelationSlider.astro';
import Breadcrumbs from '../../../../components/Breadcrumbs.astro';

const lang = 'it-it';

const breadcrumbs = [
  { name: 'Home', url: '/it-it/' },
  { name: 'Costiera Amalfitana', url: '/it-it/costiera-amalfitana/' },
  { name: 'Maiori', url: '/it-it/costiera-amalfitana/maiori/' },
];

const touristAttractionSchema = {
  "@context": "https://schema.org",
  "@type": "TouristAttraction",
  "name": "Maiori",
  "description": "Maiori ha la spiaggia sabbiosa più lunga della Costiera Amalfitana (300 m). Meno elitaria dei vicini, è la scelta ideale per chi cerca il mare comodo e accessibile senza rinunciare al paesaggio UNESCO.",
  "url": "https://amalficoast-travel.com/it-it/costiera-amalfitana/maiori/",
  "image": "https://amalficoast-travel.com/images/maiori-hero.jpg",
  "touristType": ["Mare", "Spiaggia sabbiosa", "Famiglia", "Relax"],
  "address": {
    "@type": "PostalAddress",
    "addressLocality": "Maiori",
    "addressRegion": "Salerno",
    "addressCountry": "IT",
    "postalCode": "84010"
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": 40.6493,
    "longitude": 14.6450
  }
};

const placeSchema = {
  "@context": "https://schema.org",
  "@type": "Place",
  "name": "Maiori, Costiera Amalfitana",
  "description": "Comune costiero con la spiaggia sabbiosa più lunga della Costiera Amalfitana.",
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": 40.6493,
    "longitude": 14.6450
  },
  "containedInPlace": {
    "@type": "AdministrativeArea",
    "name": "Costiera Amalfitana"
  }
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "La spiaggia di Maiori è sabbiosa?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Sì, la spiaggia di Maiori è la più lunga della costiera (circa 300 m) ed è di sabbia e ghiaia fine, a differenza delle spiagge di ciottoli di <a href=\"/it-it/costiera-amalfitana/positano/\" class=\"text-med-blue hover:underline\">Positano</a> e <a href=\"/it-it/costiera-amalfitana/amalfi/\" class=\"text-med-blue hover:underline\">Amalfi</a>. Ha una zona libera gratuita e stabilimenti con lettini e ombrelloni."
      }
    },
    {
      "@type": "Question",
      "name": "Come si arriva a Maiori?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Maiori è raggiungibile in traghetto da <span class=\"text-med-blue\">Salerno</span> (Travelmar, circa 50 min, stagionale) e in bus SITA dalla SS163 (da <a href=\"/it-it/costiera-amalfitana/amalfi/\" class=\"text-med-blue hover:underline\">Amalfi</a> ~15 min, da <span class=\"text-med-blue\">Salerno</span> ~45 min). Ha anche un parcheggio più capiente rispetto agli altri borghi della costiera."
      }
    },
    {
      "@type": "Question",
      "name": "Maiori è adatta alle famiglie con bambini?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Maiori è probabilmente la destinazione più adatta alle famiglie di tutta la costiera: spiaggia sabbiosa, lungomare pianeggiante, prezzi più accessibili, parcheggi disponibili e meno scale rispetto a <a href=\"/it-it/costiera-amalfitana/positano/\" class=\"text-med-blue hover:underline\">Positano</a> o <a href=\"/it-it/costiera-amalfitana/ravello/\" class=\"text-med-blue hover:underline\">Ravello</a>."
      }
    },
    {
      "@type": "Question",
      "name": "Cosa vedere a Maiori oltre alla spiaggia?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Oltre alla spiaggia, vale la pena visitare la Collegiata di Santa Maria a Mare (chiesa medievale sulla collina), il Castello di San Nicola de Thoro-Plano (ruderi medievali con panorama), e fare l'escursione alla Valle del Torrente Reginna."
      }
    },
    {
      "@type": "Question",
      "name": "Maiori è più economica di Positano?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Sì, decisamente. Maiori è una delle destinazioni più economiche della costiera. Hotel, ristoranti e appartamenti costano in media il 40–50% in meno rispetto a <a href=\"/it-it/costiera-amalfitana/positano/\" class=\"text-med-blue hover:underline\">Positano</a> o <a href=\"/it-it/costiera-amalfitana/ravello/\" class=\"text-med-blue hover:underline\">Ravello</a>. È una buona base per esplorare l'intera costiera senza spendere una fortuna."
      }
    }
  ]
};
---

<BaseLayout
  title="Maiori 2026: Guida Completa | Spiaggia Sabbiosa Costiera Amalfitana"
  description="Tutto su Maiori: la spiaggia sabbiosa più lunga della costiera, come arrivare, cosa vedere, prezzi e consigli. La guida alla destinazione più accessibile della Costiera Amalfitana."
  lang={lang}
  pageKey="maiori"
  breadcrumbs={breadcrumbs}
  schema={[touristAttractionSchema, placeSchema, faqSchema]}
>

  <section class="relative h-[60vh] sm:h-[80vh] flex items-center bg-charcoal overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-b from-black/20 via-black/40 to-black/80 z-10"></div>
    <img src="/images/maiori-hero.jpg" alt="" class="absolute inset-0 w-full h-full object-cover" loading="eager"  referrerpolicy="no-referrer"/>
    <div class="relative z-20 max-w-editorial mx-auto px-4 sm:px-6 lg:px-8">
      <nav class="flex items-center gap-2 text-white/60 text-xs mb-6">
