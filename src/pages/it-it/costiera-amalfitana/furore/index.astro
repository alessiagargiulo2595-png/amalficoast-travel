---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import CorrelationSlider from '../../../../components/CorrelationSlider.astro';
import Breadcrumbs from '../../../../components/Breadcrumbs.astro';

const lang = 'it-it';

const breadcrumbs = [
  { name: 'Home', url: '/it-it/' },
  { name: 'Costiera Amalfitana', url: '/it-it/costiera-amalfitana/' },
  { name: 'Furore', url: '/it-it/costiera-amalfitana/furore/' },
];

const touristAttractionSchema = {
  "@context": "https://schema.org",
  "@type": "TouristAttraction",
  "name": "Furore",
  "description": "Furore e il borgo che non c'e della Costiera Amalfitana: senza un vero centro, le case si aggrappano alla montagna intorno al celebre Fiordo di Furore, uno spettacolare canyon che si tuffa nel mare.",
  "url": "https://amalficoast-travel.com/it-it/costiera-amalfitana/furore/",
  "touristType": ["Natura", "Fotografia", "Arte", "Mare"],
  "address": { "@type": "PostalAddress", "addressLocality": "Furore", "addressRegion": "Salerno", "addressCountry": "IT", "postalCode": "84010" },
  "geo": { "@type": "GeoCoordinates", "latitude": 40.6264, "longitude": 14.5525 }
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Cos'e il Fiordo di Furore?",
      "acceptedAnswer": { "@type": "Answer", "text": "E una profonda insenatura naturale (un fiordo carsico) dove il torrente Schiato si getta nel mare attraverso un canyon di 30 metri. Un piccolo ponte stradale lo sovrasta, creando una delle immagini piu iconiche della Costiera. La spiaggetta ai piedi del fiordo e raggiungibile tramite scalinata." }
    },
    {
      "@type": "Question",
      "name": "Come si arriva al Fiordo di Furore?",
      "acceptedAnswer": { "@type": "Answer", "text": "In bus SITA sulla linea Amalfi-Positano (fermata Furore Fiordo). In auto, il fiordo e sulla SS163 tra Praiano e Conca dei Marini: c'e un piccolo parcheggio prima del ponte. A piedi, una scalinata di circa 200 gradini scende alla spiaggia." }
    },
    {
      "@type": "Question",
      "name": "Perche Furore e chiamato il borgo che non c'e?",
      "acceptedAnswer": { "@type": "Answer", "text": "Perche Furore non ha un centro storico tradizionale: le case, le chiese e le botteghe sono disseminate lungo la strada e aggrappate alla montagna senza formare un nucleo compatto. E un comune sparso dove ogni angolo e un piccolo borgo a se." }
    },
    {
      "@type": "Question",
      "name": "Si puo fare il bagno al Fiordo di Furore?",
      "acceptedAnswer": { "@type": "Answer", "text": "Si, la piccola spiaggia di ciottoli ai piedi del fiordo e balneabile. L'acqua e limpida e fresca grazie al torrente. Arriva presto: lo spazio e molto limitato e in estate si riempie rapidamente. Non ci sono servizi (ne bar, ne noleggio ombrelloni)." }
    },
    {
      "@type": "Question",
      "name": "Cosa sono i murales di Furore?",
      "acceptedAnswer": { "@type": "Answer", "text": "Furore e un paese dipinto (Paese Dipinto). Dagli anni '80 artisti italiani e internazionali hanno realizzato murales sui muri delle case lungo la strada. Oggi se ne contano oltre 100, trasformando il borgo in una galleria d'arte a cielo aperto." }
    }
  ]
};

const schemas = [touristAttractionSchema, faqSchema];

const fastFacts = [
  { dt: 'Posizione', dd: 'Costiera Amalfitana, SA' },
  { dt: 'Altitudine', dd: '0-650 m slm' },
  { dt: 'Popolazione', dd: '~800 abitanti' },
  { dt: 'Da Amalfi', dd: '15 min (auto/bus)' },
  { dt: 'Da Positano', dd: '10 min (auto/bus)' },
  { dt: 'Spiaggia', dd: 'Ciottoli (Fiordo)' },
  { dt: 'Specialita', dd: 'Murales, Fiordo, vino' },
  { dt: 'Miglior periodo', dd: 'Apr-Ott' },
  { dt: 'Ideale per', dd: 'Foto, natura, arte' },
];

const tips = [
  'La foto piu bella del Fiordo si scatta dal ponte stradale: arriva la mattina presto quando il sole illumina il canyon.',
  'La spiaggia del Fiordo e minuscola: in estate arrivi entro le 9:00 o non trovi posto.',
  'Passeggia lungo la SS163 cercando i murales: sono oltre 100 e raccontano la storia del borgo.',
  'Ogni anno a luglio si tiene il Mediterranean Cup: tuffatori professionisti si lanciano dal ponte del Fiordo (14 m).',
];
---

<BaseLayout
  title="Furore 2026: Il Fiordo, i Murales e il Borgo che Non C'e"
  description="Guida a Furore: il celebre Fiordo, i murales del Paese Dipinto, la spiaggetta nascosta. Il borgo piu insolito della Costiera Amalfitana, senza centro ma con un'anima unica."
  lang={lang}
  breadcrumbs={breadcrumbs}
  schema={schemas}
  pageKey="furore"
>

  <!-- Hero -->
  <section class="relative h-[75vh] sm:h-[90vh] flex items-center bg-charcoal overflow-hidden">
    <img src="/images/fiordo-furore-hero.webp" alt="Il Fiordo di Furore, Costiera Amalfitana" class="absolute inset-0 w-full h-full object-cover" loading="eager" fetchpriority="high" decoding="sync" referrerpolicy="no-referrer"/>
    <div class="absolute inset-0 bg-gradient-to-b from-black/10 via-black/40 to-black/80 z-10"></div>
    <div class="relative z-20 max-w-editorial mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <p class="text-med-gold text-xs sm:text-sm font-medium uppercase tracking-[0.3em] mb-3">Il Paese Dipinto della Costiera</p>
        <h1 class="font-serif text-display text-white mb-4">Furore</h1>
        <p class="text-xl text-white/80 leading-relaxed max-w-2xl">
          Il borgo che non c'e. Un fiordo spettacolare, 100+ murales e case aggrappate alla montagna senza un centro.
        </p>
        <div class="flex flex-wrap gap-3 mt-8">
          <a href="#fast-facts" class="px-5 py-2.5 bg-med-gold text-white text-xs sm:text-sm font-semibold rounded-full hover:scale-105 hover:shadow-[0_8px_25px_rgba(212,175,55,0.4)] transition-all duration-300">Fast Facts</a>
          <a href="#fiordo" class="px-5 py-2.5 bg-white/10 backdrop-blur text-white text-xs sm:text-sm font-medium rounded-full border border-white/20 hover:bg-white/20 transition-colors">Il Fiordo</a>
          <a href="#faq" class="px-5 py-2.5 bg-white/10 backdrop-blur text-white text-xs sm:text-sm font-medium rounded-full border border-white/20 hover:bg-white/20 transition-colors">FAQ</a>
        </div>
      </div>
    </div>
    <Breadcrumbs breadcrumbs={breadcrumbs} />
  </section>

  <section class="max-w-editorial mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="grid lg:grid-cols-[1fr_320px] gap-12">

      <div class="space-y-16">

        <div class="prose-editorial">
          <p class="text-xl leading-relaxed text-charcoal">
            Furore e un paradosso: un comune della Costiera Amalfitana che non ha un centro, un borgo famoso per un fiordo che in realta e un canyon, un paese di 800 anime che attira fotografi da tutto il mondo. E il luogo piu insolito e sorprendente dell'intera costa.
          </p>
          <p class="mt-4 text-slate-600 leading-relaxed">
            Le case di Furore sono disseminate lungo la SS163 e aggrappate ai terrazzamenti che scendono verso il mare. Non c'e una piazza, non c'e un lungomare: c'e solo la roccia, i limoni, i murales e quel fiordo che sembra uscito da un film. Il nome stesso viene dal latino <em>furor</em>, il fragore del mare che si infrange nella gola.
          </p>
        </div>

        <!-- Lo Sapevi -->
        <div class="bg-slate-900 border border-white/10 rounded-[3rem] p-8">
          <p class="text-[10px] uppercase tracking-[0.3em] text-med-gold font-medium mb-4">Lo sapevi?</p>
          <div class="grid sm:grid-cols-3 gap-6">
            <div class="text-center">
              <p class="font-serif text-5xl font-bold text-med-gold">100+</p>
              <p class="text-white/60 text-xs italic mt-1">murales sulle case del borgo</p>
            </div>
            <div class="text-center">
              <p class="font-serif text-5xl font-bold text-med-gold">30 m</p>
              <p class="text-white/60 text-xs italic mt-1">profondita del canyon del Fiordo</p>
            </div>
            <div class="text-center">
              <p class="font-serif text-5xl font-bold text-med-gold">~800</p>
              <p class="text-white/60 text-xs italic mt-1">abitanti, tra i comuni piu piccoli d'Italia</p>
            </div>
          </div>
        </div>

        <!-- Il Fiordo -->
        <div id="fiordo">
          <h2 class="font-serif text-3xl font-semibold text-slate-900 mb-6">Il Fiordo di Furore</h2>
          <p class="text-slate-600 text-lg leading-relaxed mb-6">
            Il <strong>Fiordo di Furore</strong> e l'attrazione naturale piu fotografata della Costiera dopo Positano. Un canyon carsico dove il torrente Schiato incontra il mare, scavando una gola profonda 30 metri nella roccia calcarea.
          </p>
          <div class="space-y-6">
            <div class="bg-white p-6 rounded-2xl border border-slate-100">
              <h3 class="font-bold text-slate-900 mb-2">La spiaggia del Fiordo</h3>
              <p class="text-slate-600 text-sm">Una piccola lingua di ciottoli ai piedi del canyon, raggiungibile con una scalinata di circa 200 gradini dalla SS163. Acqua cristallina e fresca, nessun servizio. Spazio molto limitato: arrivo consigliato prima delle 9:00 in estate.</p>
            </div>
            <div class="bg-white p-6 rounded-2xl border border-slate-100">
              <h3 class="font-bold text-slate-900 mb-2">Il ponte e la vista</h3>
              <p class="text-slate-600 text-sm">Il ponte stradale che sovrasta il fiordo offre la vista dall'alto piu iconica. La mattina presto la luce entra nel canyon illuminando le barche in secca. Ogni anno a luglio, durante il Mediterranean Cup, tuffatori professionisti si lanciano dal ponte (14 m).</p>
            </div>
            <div class="bg-white p-6 rounded-2xl border border-slate-100">
              <h3 class="font-bold text-slate-900 mb-2">Le vecchie case dei pescatori</h3>
              <p class="text-slate-600 text-sm">Ai piedi del fiordo si vedono ancora le antiche case-grotta dove vivevano i pescatori di Furore, scavate nella roccia e collegate da scale ripide. Alcune sono state restaurate e oggi ospitano atelier e residenze artistiche.</p>
            </div>
          </div>
        </div>

        <!-- Cosa Vedere -->
        <div>
          <h2 class="font-serif text-3xl font-semibold text-slate-900 mb-8">Cosa vedere a Furore</h2>
          <div class="space-y-8">
            {[
              { n: 1, title: 'I Murales del Paese Dipinto', text: 'Dagli anni \'80, artisti italiani e internazionali hanno trasformato Furore in una galleria a cielo aperto. Oltre 100 murales decorano muri, facciate e scalinate lungo tutta la strada. Un percorso d\'arte spontaneo e gratuito.' },
              { n: 2, title: 'Chiesa di San Giacomo', text: 'La chiesa principale di Furore, arroccata in alto con una vista panoramica sul mare e sui vigneti. Semplice e suggestiva, rappresenta il cuore spirituale di un borgo senza centro.' },
              { n: 3, title: 'Sentiero della Volpe Pescatrice', text: 'Un sentiero che collega il livello del mare alla parte alta del paese attraverso gli antichi terrazzamenti. Panorami spettacolari sulla costa e sul Fiordo visto dall\'alto. Durata circa 1-2 ore.' },
              { n: 4, title: 'Vigneti di Furore', text: 'Il vino di Furore e tra i piu pregiati della DOC Costa d\'Amalfi. I vigneti estremi, appesi alla roccia a picco sul mare, producono il celebre Fiorduva di Marisa Cuomo, uno dei bianchi piu ricercati d\'Italia.' },
            ].map(({ n, title, text }) => (
              <div class="grid sm:grid-cols-[auto_1fr] gap-4">
                <div class="w-14 h-14 rounded-[1rem] bg-med-gold/10 flex items-center justify-center flex-shrink-0 text-med-gold font-serif font-bold text-xl">{n}</div>
                <div>
                  <h3 class="font-semibold text-charcoal text-lg mb-1">{title}</h3>
                  <p class="text-slate-600 leading-relaxed">{text}</p>
                </div>
              </div>
            ))}
          </div>
        </div>

        <!-- Consiglio Local -->
        <div class="relative overflow-hidden rounded-[3rem] bg-med-blue p-10 md:p-14 text-white shadow-2xl">
          <div class="relative z-10 flex flex-col md:flex-row items-start md:items-center gap-8">
            <div class="w-20 h-20 rounded-2xl bg-white/10 flex items-center justify-center flex-shrink-0 border border-white/20"><svg class="w-10 h-10 text-med-gold" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 3v2.25m6.364.386-1.591 1.591M21 12h-2.25m-.386 6.364-1.591-1.591M12 18.75V21m-4.773-4.227-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0Z"/></svg></div>
            <div>
              <p class="text-med-gold text-xs font-bold uppercase tracking-[0.3em] mb-2">Consiglio Local</p>
              <h3 class="font-serif text-2xl font-bold text-white mb-3 tracking-tight">Il Fiorduva di Marisa Cuomo</h3>
              <p class="text-white/70 leading-relaxed">Se ami il vino, cerca il Fiorduva: un bianco prodotto da uve raccolte a mano sui terrazzamenti a strapiombo sul Fiordo. E tra i vini piu premiati della Campania e si trova solo qui e in poche enoteche selezionate.</p>
            </div>
          </div>
          <div class="absolute bottom-0 left-0 translate-y-1/2 -translate-x-1/2 w-80 h-80 bg-med-gold/10 rounded-full blur-3xl pointer-events-none"></div>
        </div>

        <!-- FAQ -->
        <div id="faq">
          <h2 class="font-serif text-3xl font-semibold text-slate-900 mb-8">Domande frequenti su Furore</h2>
          <div class="space-y-4">
            {faqSchema.mainEntity.map((q) => (
              <details class="group border border-slate-200 rounded-2xl overflow-hidden">
                <summary class="flex items-center justify-between px-6 py-4 cursor-pointer select-none text-charcoal font-medium hover:bg-slate-50 transition-colors">
                  {q.name}
                  <svg class="w-4 h-4 text-slate-400 group-open:rotate-180 transition-transform flex-shrink-0 ml-3" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
                </summary>
                <div class="px-6 pb-5 text-slate-600 leading-relaxed text-xs sm:text-sm border-t border-slate-100 pt-4">
                  {q.acceptedAnswer.text}
                </div>
              </details>
            ))}
          </div>
        </div>

      </div>

      <aside class="space-y-6 lg:sticky lg:top-24 self-start">
        <div id="fast-facts" class="bg-slate-900 text-white rounded-[3rem] p-6">
          <p class="text-[10px] uppercase tracking-[0.3em] text-med-gold font-medium mb-4">Fast Facts - Furore</p>
          <dl class="space-y-3">
            {fastFacts.map(({ dt, dd }, i) => (
              <>
                <div class="flex justify-between items-start gap-3">
                  <dt class="text-white/40 text-xs sm:text-sm font-light flex-shrink-0">{dt}</dt>
                  <dd class="text-white font-medium text-xs sm:text-sm text-right">{dd}</dd>
                </div>
                {i < fastFacts.length - 1 && <div class="border-t border-white/5"></div>}
              </>
            ))}
          </dl>
        </div>

        <div class="bg-med-cream border border-med-gold/30 rounded-[2rem] p-6">
          <p class="text-[10px] uppercase tracking-[0.3em] text-med-gold font-medium mb-3">Consigli degli insider</p>
          <ul class="space-y-3">
            {tips.map(tip => (
              <li class="flex items-start gap-2 text-xs sm:text-sm text-charcoal">
                <span class="w-1.5 h-1.5 rounded-full bg-med-gold mt-1.5 flex-shrink-0"></span>
                <span>{tip}</span>
              </li>
            ))}
          </ul>
        </div>

        <div class="bg-white border border-slate-100 rounded-[2rem] p-6 shadow-sm">
          <p class="text-[10px] uppercase tracking-[0.3em] text-slate-400 font-medium mb-3">Esplora la Costiera</p>
          <nav class="space-y-1">
            {[
              { href: '/it-it/costiera-amalfitana/conca-dei-marini/', label: 'Conca dei Marini' },
              { href: '/it-it/costiera-amalfitana/praiano/', label: 'Praiano' },
              { href: '/it-it/costiera-amalfitana/agerola/', label: 'Agerola' },
              { href: '/it-it/costiera-amalfitana/amalfi/', label: 'Amalfi' },
              { href: '/it-it/costiera-amalfitana/positano/', label: 'Positano' },
            ].map(({ href, label }) => (
              <a href={href} class="flex items-center gap-2 px-3 py-2 rounded-xl text-xs sm:text-sm text-charcoal hover:bg-med-blue/5 hover:text-med-blue transition-colors">
                <span class="w-1.5 h-1.5 rounded-full bg-med-blue/30"></span> {label}
              </a>
            ))}
          </nav>
        </div>
      </aside>

    </div>
  </section>

  <CorrelationSlider
    heading="Esplora anche sulla Costiera"
    items={[
      { name: 'Conca dei Marini', href: '/it-it/costiera-amalfitana/conca-dei-marini/', tag: 'Grotta & Sfogliatella', desc: 'La Grotta dello Smeraldo e la patria della sfogliatella Santa Rosa.' },
      { name: 'Praiano',  href: '/it-it/costiera-amalfitana/praiano/',  tag: 'Tramonto & Quiete',     desc: 'Il tramonto da San Gennaro e la silenziosa Marina di Praia.' },
      { name: 'Agerola',  href: '/it-it/costiera-amalfitana/agerola/',  tag: 'Trekking & Natura',     desc: 'Sentiero degli Dei, Fior di Latte e panorami a 600 m.' },
      { name: 'Positano', href: '/it-it/costiera-amalfitana/positano/', tag: 'Fashion & Vista',        desc: 'Le case colorate a picco sul mare della Costiera.' },
      { name: 'Amalfi',   href: '/it-it/costiera-amalfitana/amalfi/',   tag: 'Repubblica Marinara',    desc: 'La capitale storica con il Duomo e il Museo della Carta.' },
    ]}
    lang="it-it"
  />

</BaseLayout>
