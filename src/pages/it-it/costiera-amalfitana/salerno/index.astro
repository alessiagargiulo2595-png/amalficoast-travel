---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import CorrelationSlider from '../../../../components/CorrelationSlider.astro';
import Breadcrumbs from '../../../../components/Breadcrumbs.astro';

const lang = 'it-it';

const breadcrumbs = [
  { name: 'Home', url: '/it-it/' },
  { name: 'Costiera Amalfitana', url: '/it-it/costiera-amalfitana/' },
  { name: 'Salerno', url: '/it-it/costiera-amalfitana/salerno/' },
];

const touristAttractionSchema = {
  "@context": "https://schema.org",
  "@type": "TouristAttraction",
  "name": "Salerno",
  "description": "Salerno e la porta d'ingresso alla Costiera Amalfitana, citta universitaria con il Duomo normanno, il Lungomare Trieste, il centro storico medievale e le celebri Luci d'Artista in inverno.",
  "url": "https://amalficoast-travel.com/it-it/costiera-amalfitana/salerno/",
  "touristType": ["Cultura", "Storia", "Gastronomia", "Base viaggi"],
  "address": { "@type": "PostalAddress", "addressLocality": "Salerno", "addressRegion": "Salerno", "addressCountry": "IT", "postalCode": "84121" },
  "geo": { "@type": "GeoCoordinates", "latitude": 40.6824, "longitude": 14.7681 }
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Come arrivare a Salerno da Napoli?",
      "acceptedAnswer": { "@type": "Answer", "text": "Treno Trenitalia Regionale da Napoli Centrale a Salerno in circa 35-40 minuti (~4-7 euro). Frecce e Italo in circa 25 minuti. In auto circa 60 km via A3 Napoli-Salerno (pedaggio circa 3 euro)." }
    },
    {
      "@type": "Question",
      "name": "Cosa vedere a Salerno in un giorno?",
      "acceptedAnswer": { "@type": "Answer", "text": "Duomo e Cripta di San Matteo, centro storico medievale con Via dei Mercanti, Giardino della Minerva, Lungomare Trieste, Castello Arechi per il panorama. In inverno (novembre-gennaio) le Luci d'Artista sono imperdibili." }
    },
    {
      "@type": "Question",
      "name": "Salerno e una buona base per la Costiera Amalfitana?",
      "acceptedAnswer": { "@type": "Answer", "text": "Si, e la base piu pratica e economica. Da Salerno partono traghetti Travelmar per Amalfi, Positano, Minori e Maiori (aprile-ottobre). I bus SITA collegano tutta la costa. Gli hotel costano il 40-50% in meno rispetto ad Amalfi o Positano." }
    },
    {
      "@type": "Question",
      "name": "Quando visitare Salerno?",
      "acceptedAnswer": { "@type": "Answer", "text": "Aprile-giugno e settembre-ottobre per il clima e la vicinanza alla costa. Novembre-gennaio per le Luci d'Artista, l'installazione luminosa che attira oltre 2 milioni di visitatori. Luglio e agosto sono caldi ma la citta non e sovraffollata come la Costiera." }
    },
    {
      "@type": "Question",
      "name": "Cosa mangiare a Salerno?",
      "acceptedAnswer": { "@type": "Answer", "text": "La milza imbottita (o' pere e o' musso), la scazzetta del cardinale (dolce con pan di spagna, crema e fragole), la pizza salernitana, il pesce fresco al Mercato di Via Roma. Via dei Mercanti e piena di trattorie autentiche." }
    }
  ]
};

const schemas = [touristAttractionSchema, faqSchema];

const fastFacts = [
  { dt: 'Posizione', dd: 'Golfo di Salerno, SA' },
  { dt: 'Altitudine', dd: '0-300 m slm' },
  { dt: 'Popolazione', dd: '~130.000 abitanti' },
  { dt: 'Da Napoli', dd: '35 min (treno regionale)' },
  { dt: 'Porto traghetti', dd: 'Piazza della Concordia' },
  { dt: 'Per Amalfi', dd: '75 min (traghetto)' },
  { dt: 'Miglior periodo', dd: 'Apr-Giu / Nov-Gen' },
  { dt: 'Specialita', dd: 'Milza, scazzetta, pesce' },
  { dt: 'Evento top', dd: 'Luci d\'Artista (Nov-Gen)' },
];

const tips = [
  'Il Giardino della Minerva e il primo orto botanico d\'Europa (XIII sec.) ed e poco visitato: una perla nascosta nel centro storico.',
  'Via dei Mercanti e la vera anima di Salerno: botteghe, trattorie e pasticcerie a prezzi locali, non turistici.',
  'Prendi il traghetto per Amalfi la mattina presto: il panorama della Costiera visto dal mare e imbattibile.',
  'Il Castello Arechi (raggiungibile in bus o a piedi in 30 min dal centro) offre la vista piu bella del Golfo e della citta.',
];
---

<BaseLayout
  title="Salerno 2026: Guida Completa | Porta della Costiera Amalfitana"
  description="Guida completa a Salerno: Duomo, Giardino della Minerva, Luci d'Artista, Lungomare Trieste. La porta d'ingresso alla Costiera Amalfitana con traghetti per Amalfi e Positano."
  lang={lang}
  breadcrumbs={breadcrumbs}
  schema={schemas}
  pageKey="salerno"
>

  <!-- Hero -->
  <section class="relative h-[75vh] sm:h-[90vh] flex items-center bg-charcoal overflow-hidden">
    <img src="/images/salerno-hero.webp" alt="Salerno, porta della Costiera Amalfitana" class="absolute inset-0 w-full h-full object-cover" loading="eager" fetchpriority="high" decoding="sync" referrerpolicy="no-referrer"/>
    <div class="absolute inset-0 bg-gradient-to-b from-black/10 via-black/40 to-black/80 z-10"></div>
    <div class="relative z-20 max-w-editorial mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <p class="text-med-gold text-xs sm:text-sm font-medium uppercase tracking-[0.3em] mb-3">Porta della Costiera Amalfitana</p>
        <h1 class="font-serif text-display text-white mb-4">Salerno</h1>
        <p class="text-xl text-white/80 leading-relaxed max-w-2xl">
          Citta universitaria millenaria, base ideale per la Costiera. Duomo normanno, Luci d'Artista e il Lungomare piu bello della Campania.
        </p>
        <div class="flex flex-wrap gap-3 mt-8">
          <a href="#fast-facts" class="px-5 py-2.5 bg-med-gold text-white text-xs sm:text-sm font-semibold rounded-full hover:scale-105 hover:shadow-[0_8px_25px_rgba(212,175,55,0.4)] transition-all duration-300">Fast Facts</a>
          <a href="#come-arrivare" class="px-5 py-2.5 bg-white/10 backdrop-blur text-white text-xs sm:text-sm font-medium rounded-full border border-white/20 hover:bg-white/20 transition-colors">Come arrivare</a>
          <a href="#faq" class="px-5 py-2.5 bg-white/10 backdrop-blur text-white text-xs sm:text-sm font-medium rounded-full border border-white/20 hover:bg-white/20 transition-colors">FAQ</a>
        </div>
      </div>
    </div>
    <Breadcrumbs breadcrumbs={breadcrumbs} />
  </section>

  <section class="max-w-editorial mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="grid lg:grid-cols-[1fr_320px] gap-12">

      <div class="space-y-16">

        <div class="prose-editorial">
          <p class="text-xl leading-relaxed text-charcoal">
            Salerno e la citta che tutti attraversano ma pochi si fermano a conoscere. Eppure, con il suo centro storico medievale, il Duomo normanno che custodisce le reliquie di San Matteo e uno dei lungomare piu belli d'Italia, meriterebbe almeno una giornata intera.
          </p>
          <p class="mt-4 text-slate-600 leading-relaxed">
            Fondata come colonia romana nel 197 a.C., Salerno raggiunse il suo apice con la <strong>Scuola Medica Salernitana</strong>, la prima e piu importante istituzione medica d'Europa nel Medioevo. Oggi e una citta vivace e a misura d'uomo, con un porto che collega direttamente <a href="/it-it/costiera-amalfitana/amalfi/" class="text-med-blue hover:underline">Amalfi</a>, <a href="/it-it/costiera-amalfitana/positano/" class="text-med-blue hover:underline">Positano</a> e <a href="/it-it/costiera-amalfitana/minori/" class="text-med-blue hover:underline">Minori</a> via traghetto.
          </p>
        </div>

        <!-- Lo Sapevi -->
        <div class="bg-slate-900 border border-white/10 rounded-[3rem] p-8">
          <p class="text-[10px] uppercase tracking-[0.3em] text-med-gold font-medium mb-4">Lo sapevi?</p>
          <div class="grid sm:grid-cols-3 gap-6">
            <div class="text-center">
              <p class="font-serif text-5xl font-bold text-med-gold">XI sec.</p>
              <p class="text-white/60 text-xs italic mt-1">Scuola Medica Salernitana, prima d'Europa</p>
            </div>
            <div class="text-center">
              <p class="font-serif text-5xl font-bold text-med-gold">2M+</p>
              <p class="text-white/60 text-xs italic mt-1">visitatori per le Luci d'Artista ogni anno</p>
            </div>
            <div class="text-center">
              <p class="font-serif text-5xl font-bold text-med-gold">1.5 km</p>
              <p class="text-white/60 text-xs italic mt-1">il Lungomare Trieste pedonale</p>
            </div>
          </div>
          <p class="text-white/40 text-xs mt-6 italic">
            Roberto il Guiscardo, condottiero normanno, fece di Salerno la capitale del Ducato nel 1077. Il Duomo che fece costruire e ancora il cuore della citta.
          </p>
        </div>

        <!-- Cosa Vedere -->
        <div>
          <h2 class="font-serif text-3xl font-semibold text-slate-900 mb-8">Cosa vedere a Salerno</h2>
          <div class="space-y-8">
            {[
              { n: 1, title: 'Duomo di San Matteo', text: 'Il simbolo di Salerno, fondato nel 1080 da Roberto il Guiscardo. La facciata romanica con portale bronzeo del XI secolo introduce un interno barocco con la Cripta che custodisce le reliquie dell\'apostolo Matteo. Il Quadriportico con colonne romane di spoglio e uno dei piu belli del Sud Italia. Ingresso gratuito.' },
              { n: 2, title: 'Giardino della Minerva', text: 'Il primo orto botanico d\'Europa, fondato nel XIII secolo dal medico Matteo Silvatico della Scuola Medica Salernitana. Terrazzato sulla collina del centro storico, con piante medicinali, fontane e una vista spettacolare sul Golfo. Ingresso circa 3 euro. Da non perdere.' },
              { n: 3, title: 'Lungomare Trieste', text: '1,5 km di passeggiata pedonale affacciata sul Golfo di Salerno, considerato uno dei lungomare piu belli d\'Italia. Palme, panchine, bar e vista su Capri nelle giornate limpide. Perfetto per l\'aperitivo al tramonto.' },
              { n: 4, title: 'Castello Arechi', text: 'La fortezza longobarda a 300 m di altitudine domina la citta e il golfo. Raggiungibile in bus (linea 19) o a piedi in 30 minuti dal centro. Ospita un museo con ceramiche medievali e offre la vista panoramica piu ampia della zona. Ingresso circa 5 euro.' },
              { n: 5, title: 'Via dei Mercanti e centro storico', text: 'L\'arteria medievale del commercio salernitano, un susseguirsi di botteghe, trattorie e chiese. Percorrila da Piazza Sedile del Campo fino all\'Arco di Arechi. Le traversine laterali nascondono pasticcerie storiche e cortili segreti.' },
            ].map(({ n, title, text }) => (
              <div class="grid sm:grid-cols-[auto_1fr] gap-4">
                <div class="w-14 h-14 rounded-[1rem] bg-med-gold/10 flex items-center justify-center flex-shrink-0 text-med-gold font-serif font-bold text-xl">{n}</div>
                <div>
                  <h3 class="font-semibold text-charcoal text-lg mb-1">{title}</h3>
                  <p class="text-slate-600 leading-relaxed">{text}</p>
                </div>
              </div>
            ))}
          </div>
        </div>

        <!-- Come arrivare -->
        <div id="come-arrivare">
          <h2 class="font-serif text-3xl font-semibold text-slate-900 mb-6">Come arrivare a Salerno</h2>
          <div class="space-y-6">
            <div class="bg-white rounded-[3rem] p-8 border border-slate-100 hover:shadow-xl transition-all duration-300">
              <h3 class="font-semibold text-charcoal mb-3">Treno (da Napoli)</h3>
              <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">Trenitalia Regionale da Napoli Centrale: ~35-40 min, circa 4-7 euro. Frecce e Italo: ~25 min. La stazione di Salerno e a 10 minuti a piedi dal centro storico e dal porto traghetti.</p>
            </div>
            <div class="bg-white rounded-[3rem] p-8 border border-slate-100 hover:shadow-xl transition-all duration-300">
              <h3 class="font-semibold text-charcoal mb-3">Traghetti per la Costiera</h3>
              <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">Dal porto di Piazza della Concordia (5 min dalla stazione), Travelmar collega Salerno a <a href="/it-it/costiera-amalfitana/cetara/" class="text-med-blue hover:underline">Cetara</a>, <a href="/it-it/costiera-amalfitana/maiori/" class="text-med-blue hover:underline">Maiori</a>, <a href="/it-it/costiera-amalfitana/minori/" class="text-med-blue hover:underline">Minori</a>, <a href="/it-it/costiera-amalfitana/amalfi/" class="text-med-blue hover:underline">Amalfi</a> e <a href="/it-it/costiera-amalfitana/positano/" class="text-med-blue hover:underline">Positano</a> (aprile-ottobre). Biglietto circa 8-10 euro.</p>
            </div>
            <div class="bg-white rounded-[3rem] p-8 border border-slate-100 hover:shadow-xl transition-all duration-300">
              <h3 class="font-semibold text-charcoal mb-3">Bus SITA</h3>
              <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">I bus SITA partono dalla stazione e percorrono tutta la SS163 fino ad <a href="/it-it/costiera-amalfitana/amalfi/" class="text-med-blue hover:underline">Amalfi</a> (circa 75 min, 2.50 euro). Servizio tutto l'anno, frequenza ogni 60-90 min.</p>
            </div>
          </div>
        </div>

        <!-- Hidden Gems -->
        <div>
          <h2 class="font-serif text-3xl font-semibold text-slate-900 mb-6">Salerno lontano dai turisti</h2>
          <div class="grid sm:grid-cols-2 gap-6">
            {[
              { title: 'Complesso di San Pietro a Corte', text: 'Un sito archeologico unico con resti romani, paleocristiani e longobardi sovrapposti. La Cappella Palatina del VIII secolo e un gioiello nascosto sotto il livello stradale. Ingresso gratuito o quasi.' },
              { title: 'Quartiere Fornelle', text: 'Il quartiere piu antico di Salerno, aggrappato alla collina sotto il Castello Arechi. Vicoli stretti, scalinate infinite e street art contemporanea. Quasi sconosciuto ai turisti, pieno di vita locale.' },
              { title: 'Mercato di Via Roma', text: 'Il mercato coperto di Salerno, dove i salernitani comprano pesce fresco, frutta e verdura ogni mattina. Colori, odori e prezzi locali. Aperto la mattina, chiuso la domenica.' },
              { title: 'Acquedotto Medievale', text: 'I resti dell\'acquedotto che alimentava i monasteri benedettini, visibili attraversando Via Arce nel centro storico. Una struttura ad archi impressionante e quasi sconosciuta.' },
            ].map(({ title, text }) => (
              <div class="bg-white rounded-[3rem] p-8 border border-slate-100 hover:shadow-xl transition-all duration-300">
                <h3 class="font-semibold text-charcoal mb-2">{title}</h3>
                <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">{text}</p>
              </div>
            ))}
          </div>
        </div>

        <!-- Consiglio Local -->
        <div class="relative overflow-hidden rounded-[3rem] bg-med-blue p-10 md:p-14 text-white shadow-2xl">
          <div class="relative z-10 flex flex-col md:flex-row items-start md:items-center gap-8">
            <div class="w-20 h-20 rounded-2xl bg-white/10 flex items-center justify-center flex-shrink-0 border border-white/20"><svg class="w-10 h-10 text-med-gold" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 3v2.25m6.364.386-1.591 1.591M21 12h-2.25m-.386 6.364-1.591-1.591M12 18.75V21m-4.773-4.227-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0Z"/></svg></div>
            <div>
              <p class="text-med-gold text-xs font-bold uppercase tracking-[0.3em] mb-2">Consiglio Local</p>
              <h3 class="font-serif text-2xl font-bold text-white mb-3 tracking-tight">Base perfetta per la Costiera</h3>
              <p class="text-white/70 leading-relaxed">Dormi a Salerno e prendi il traghetto mattutino per Amalfi: risparmi il 40-50% sugli hotel e godi del panorama costiero dal mare. La sera, il centro storico di Salerno offre ristoranti autentici a prezzi locali.</p>
            </div>
          </div>
          <div class="absolute bottom-0 left-0 translate-y-1/2 -translate-x-1/2 w-80 h-80 bg-med-gold/10 rounded-full blur-3xl pointer-events-none"></div>
        </div>

        <!-- FAQ -->
        <div id="faq">
          <h2 class="font-serif text-3xl font-semibold text-slate-900 mb-8">Domande frequenti su Salerno</h2>
          <div class="space-y-4">
            {faqSchema.mainEntity.map((q) => (
              <details class="group border border-slate-200 rounded-2xl overflow-hidden">
                <summary class="flex items-center justify-between px-6 py-4 cursor-pointer select-none text-charcoal font-medium hover:bg-slate-50 transition-colors">
                  {q.name}
                  <svg class="w-4 h-4 text-slate-400 group-open:rotate-180 transition-transform flex-shrink-0 ml-3" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
                </summary>
                <div class="px-6 pb-5 text-slate-600 leading-relaxed text-xs sm:text-sm border-t border-slate-100 pt-4">
                  {q.acceptedAnswer.text}
                </div>
              </details>
            ))}
          </div>
        </div>

      </div>

      <aside class="space-y-6 lg:sticky lg:top-24 self-start">
        <div id="fast-facts" class="bg-slate-900 text-white rounded-[3rem] p-6">
          <p class="text-[10px] uppercase tracking-[0.3em] text-med-gold font-medium mb-4">Fast Facts - Salerno</p>
          <dl class="space-y-3">
            {fastFacts.map(({ dt, dd }, i) => (
              <>
                <div class="flex justify-between items-start gap-3">
                  <dt class="text-white/40 text-xs sm:text-sm font-light flex-shrink-0">{dt}</dt>
                  <dd class="text-white font-medium text-xs sm:text-sm text-right">{dd}</dd>
                </div>
                {i < fastFacts.length - 1 && <div class="border-t border-white/5"></div>}
              </>
            ))}
          </dl>
        </div>

        <div class="bg-med-cream border border-med-gold/30 rounded-[2rem] p-6">
          <p class="text-[10px] uppercase tracking-[0.3em] text-med-gold font-medium mb-3">Consigli degli insider</p>
          <ul class="space-y-3">
            {tips.map(tip => (
              <li class="flex items-start gap-2 text-xs sm:text-sm text-charcoal">
                <span class="w-1.5 h-1.5 rounded-full bg-med-gold mt-1.5 flex-shrink-0"></span>
                <span set:html={tip}></span>
              </li>
            ))}
          </ul>
        </div>

        <div class="bg-white border border-slate-100 rounded-[2rem] p-6 shadow-sm">
          <p class="text-[10px] uppercase tracking-[0.3em] text-slate-400 font-medium mb-3">Esplora la Costiera</p>
          <nav class="space-y-1">
            {[
              { href: '/it-it/costiera-amalfitana/amalfi/', label: 'Amalfi' },
              { href: '/it-it/costiera-amalfitana/positano/', label: 'Positano' },
              { href: '/it-it/costiera-amalfitana/ravello/', label: 'Ravello' },
              { href: '/it-it/costiera-amalfitana/cetara/', label: 'Cetara' },
              { href: '/it-it/costiera-amalfitana/vietri-sul-mare/', label: 'Vietri sul Mare' },
            ].map(({ href, label }) => (
              <a href={href} class="flex items-center gap-2 px-3 py-2 rounded-xl text-xs sm:text-sm text-charcoal hover:bg-med-blue/5 hover:text-med-blue transition-colors">
                <span class="w-1.5 h-1.5 rounded-full bg-med-blue/30"></span> {label}
              </a>
            ))}
          </nav>
        </div>
      </aside>

    </div>
  </section>

  <CorrelationSlider
    heading="Esplora anche sulla Costiera"
    items={[
      { name: 'Amalfi',   href: '/it-it/costiera-amalfitana/amalfi/',   tag: 'Repubblica Marinara', desc: 'La capitale storica con il Duomo di Sant\'Andrea e il Museo della Carta.' },
      { name: 'Cetara',   href: '/it-it/costiera-amalfitana/cetara/',   tag: 'Borgo Marinaro',      desc: 'Il borgo dei pescatori e della colatura di alici DOP.' },
      { name: 'Vietri',   href: '/it-it/costiera-amalfitana/vietri-sul-mare/', tag: 'Ceramiche', desc: 'La porta della Costiera, famosa per le ceramiche artistiche.' },
      { name: 'Ravello',  href: '/it-it/costiera-amalfitana/ravello/',  tag: 'Musica & Giardini',   desc: 'Villa Rufolo, Villa Cimbrone e il Festival Musicale a 350 m.' },
      { name: 'Positano', href: '/it-it/costiera-amalfitana/positano/', tag: 'Fashion & Vista',      desc: 'Le case colorate a picco sul mare e la spiaggia Fornillo.' },
    ]}
    lang="it-it"
  />

</BaseLayout>
