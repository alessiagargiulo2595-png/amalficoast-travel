---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import CorrelationSlider from '../../../../components/CorrelationSlider.astro';
import Breadcrumbs from '../../../../components/Breadcrumbs.astro';

const lang = 'it-it';

const breadcrumbs = [
  { name: 'Home', url: '/it-it/' },
  { name: 'Costiera Amalfitana', url: '/it-it/costiera-amalfitana/' },
  { name: 'Conca dei Marini', url: '/it-it/costiera-amalfitana/conca-dei-marini/' },
];

const touristAttractionSchema = {
  "@context": "https://schema.org",
  "@type": "TouristAttraction",
  "name": "Conca dei Marini",
  "description": "Conca dei Marini e un borgo esclusivo della Costiera Amalfitana, celebre per la Grotta dello Smeraldo, la sfogliatella Santa Rosa e le ville private a picco sul mare.",
  "url": "https://amalficoast-travel.com/it-it/costiera-amalfitana/conca-dei-marini/",
  "touristType": ["Mare", "Cultura", "Gastronomia", "Esclusivita"],
  "address": { "@type": "PostalAddress", "addressLocality": "Conca dei Marini", "addressRegion": "Salerno", "addressCountry": "IT", "postalCode": "84010" },
  "geo": { "@type": "GeoCoordinates", "latitude": 40.6192, "longitude": 14.5739 }
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Come si visita la Grotta dello Smeraldo?",
      "acceptedAnswer": { "@type": "Answer", "text": "Si raggiunge in ascensore dalla SS163 (ingresso a pagamento circa 5 euro) o in barca da Amalfi (circa 10 euro con escursione). All'interno si naviga su piccole barche a remi ammirando l'acqua color smeraldo illuminata dalla luce naturale che filtra da una cavita sottomarina. Aperta tutto l'anno, meteo permettendo." }
    },
    {
      "@type": "Question",
      "name": "Cos'e la sfogliatella Santa Rosa?",
      "acceptedAnswer": { "@type": "Answer", "text": "E il dolce originario di Conca dei Marini, inventato dalle monache del Convento di Santa Rosa nel XVII secolo. A differenza della sfogliatella napoletana, la Santa Rosa e piu grande, ripiena di crema pasticcera, ricotta e amarena, con una pasta sfoglia croccante. E l'antenata della sfogliatella napoletana." }
    },
    {
      "@type": "Question",
      "name": "Come arrivare a Conca dei Marini?",
      "acceptedAnswer": { "@type": "Answer", "text": "In bus SITA sulla linea Amalfi-Positano (fermata Conca dei Marini). In auto sulla SS163, tra Amalfi e Furore. In barca da Amalfi (servizio privato o taxi boat). Il borgo e piccolo e si gira facilmente a piedi una volta arrivati." }
    },
    {
      "@type": "Question",
      "name": "Ci sono spiagge a Conca dei Marini?",
      "acceptedAnswer": { "@type": "Answer", "text": "Si, la spiaggia di Capo di Conca e raggiungibile tramite una lunga scalinata. E una caletta di ciottoli con acqua cristallina, poco frequentata. C'e anche il Lido Capo di Conca con servizio attrezzato (lettini, bar). La baia e riparata e l'acqua e tra le piu limpide della costa." }
    },
    {
      "@type": "Question",
      "name": "Conca dei Marini merita una visita?",
      "acceptedAnswer": { "@type": "Answer", "text": "Si, soprattutto se cerchi esclusivita e tranquillita. E uno dei comuni piu piccoli della Costiera (circa 700 abitanti), con ville eleganti, la Grotta dello Smeraldo e un'atmosfera raffinata. Combinala con la visita ad Amalfi o Furore per una mezza giornata perfetta." }
    }
  ]
};

const schemas = [touristAttractionSchema, faqSchema];

const fastFacts = [
  { dt: 'Posizione', dd: 'Costiera Amalfitana, SA' },
  { dt: 'Altitudine', dd: '0-400 m slm' },
  { dt: 'Popolazione', dd: '~700 abitanti' },
  { dt: 'Da Amalfi', dd: '10 min (auto/bus)' },
  { dt: 'Grotta Smeraldo', dd: 'Aperta tutto l\'anno' },
  { dt: 'Spiaggia', dd: 'Capo di Conca (ciottoli)' },
  { dt: 'Specialita', dd: 'Sfogliatella Santa Rosa' },
  { dt: 'Miglior periodo', dd: 'Apr-Ott' },
  { dt: 'Ideale per', dd: 'Esclusivita, cultura, mare' },
];

const tips = [
  'La Grotta dello Smeraldo e piu suggestiva nelle ore centrali quando la luce solare filtra nell\'acqua. Evita i giorni nuvolosi.',
  'Cerca la sfogliatella Santa Rosa nella Pasticceria Pansa ad Amalfi o direttamente a Conca: e diversa dalla sfogliatella napoletana.',
  'Il Lido Capo di Conca e uno dei pochi beach club accessibili della zona: prenota in estate.',
  'Conca dei Marini e il posto preferito dei VIP per le vacanze private: ville con piscina a strapiombo sul mare, lontano dai turisti.',
];
---

<BaseLayout
  title="Conca dei Marini 2026: Grotta dello Smeraldo e Sfogliatella Santa Rosa"
  description="Guida a Conca dei Marini: la Grotta dello Smeraldo, la sfogliatella Santa Rosa, le spiagge nascoste e le ville esclusive. Il borgo piu discreto della Costiera Amalfitana."
  lang={lang}
  breadcrumbs={breadcrumbs}
  schema={schemas}
  pageKey="conca-dei-marini"

  heroImage="/images/conca-dei-marini-hero.webp"
>

  <!-- Hero -->
  <section class="relative h-[75vh] sm:h-[90vh] flex items-center bg-charcoal overflow-hidden">
    <img src="/images/conca-dei-marini-hero.webp" alt="Conca dei Marini e la Grotta dello Smeraldo" class="absolute inset-0 w-full h-full object-cover" loading="eager" fetchpriority="high" decoding="sync" referrerpolicy="no-referrer"/>
    <div class="absolute inset-0 bg-gradient-to-b from-black/10 via-black/40 to-black/80 z-10"></div>
    <div class="relative z-20 max-w-editorial mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <p class="text-med-gold text-xs sm:text-sm font-medium uppercase tracking-[0.3em] mb-3">La Perla Nascosta della Costiera</p>
        <h1 class="font-serif text-display text-white mb-4">Conca dei Marini</h1>
        <p class="text-xl text-white/80 leading-relaxed max-w-2xl">
          La Grotta dello Smeraldo, la sfogliatella Santa Rosa e ville esclusive a picco sul mare. Il borgo piu discreto della Costiera.
        </p>
        <div class="flex flex-wrap gap-3 mt-8">
          <a href="#fast-facts" class="px-5 py-2.5 bg-med-gold text-white text-xs sm:text-sm font-semibold rounded-full hover:scale-105 hover:shadow-[0_8px_25px_rgba(212,175,55,0.4)] transition-all duration-300">Fast Facts</a>
          <a href="#grotta" class="px-5 py-2.5 bg-white/10 backdrop-blur text-white text-xs sm:text-sm font-medium rounded-full border border-white/20 hover:bg-white/20 transition-colors">Grotta dello Smeraldo</a>
          <a href="#faq" class="px-5 py-2.5 bg-white/10 backdrop-blur text-white text-xs sm:text-sm font-medium rounded-full border border-white/20 hover:bg-white/20 transition-colors">FAQ</a>
        </div>
      </div>
    </div>
    <Breadcrumbs breadcrumbs={breadcrumbs} />
  </section>

  <section class="max-w-editorial mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="grid lg:grid-cols-[1fr_320px] gap-12">

      <div class="space-y-16">

        <div class="prose-editorial">
          <p class="text-xl leading-relaxed text-charcoal">
            Conca dei Marini e il borgo della Costiera che preferisce il silenzio alla fama. Con appena 700 abitanti, nessun lungomare e nessun caos turistico, questo piccolo comune arroccato tra <a href="/it-it/costiera-amalfitana/amalfi/" class="text-med-blue hover:underline">Amalfi</a> e <a href="/it-it/costiera-amalfitana/furore/" class="text-med-blue hover:underline">Furore</a> nasconde due tesori: la <strong>Grotta dello Smeraldo</strong> e la <strong>sfogliatella Santa Rosa</strong>.
          </p>
          <p class="mt-4 text-slate-600 leading-relaxed">
            Un tempo era un centro di commercio marittimo: i marinai di Conca dei Marini navigavano fino in Africa e in Oriente. Oggi le antiche case dei capitani di mare sono diventate ville esclusive, scelte da chi cerca la Costiera piu autentica e riservata.
          </p>
        </div>

        <!-- Lo Sapevi -->
        <div class="bg-slate-900 border border-white/10 rounded-[3rem] p-8">
          <p class="text-[10px] uppercase tracking-[0.3em] text-med-gold font-medium mb-4">Lo sapevi?</p>
          <div class="grid sm:grid-cols-3 gap-6">
            <div class="text-center">
              <p class="font-serif text-5xl font-bold text-med-gold">XVII sec.</p>
              <p class="text-white/60 text-xs italic mt-1">invenzione della sfogliatella Santa Rosa</p>
            </div>
            <div class="text-center">
              <p class="font-serif text-5xl font-bold text-med-gold">24 m</p>
              <p class="text-white/60 text-xs italic mt-1">profondita della Grotta dello Smeraldo</p>
            </div>
            <div class="text-center">
              <p class="font-serif text-5xl font-bold text-med-gold">~700</p>
              <p class="text-white/60 text-xs italic mt-1">abitanti, tra i borghi piu piccoli</p>
            </div>
          </div>
          <p class="text-white/40 text-xs mt-6 italic">
            La sfogliatella Santa Rosa fu inventata nel Convento di Santa Rosa dalle monache domenicane che ripiegarono la pasta avanzata con crema, ricotta e amarena. Da qui nacque anche la sfogliatella napoletana.
          </p>
        </div>

        <!-- Grotta -->
        <div id="grotta">
          <h2 class="font-serif text-3xl font-semibold text-slate-900 mb-6">La Grotta dello Smeraldo</h2>
          <p class="text-slate-600 text-lg leading-relaxed mb-6">
            Scoperta nel 1932 da un pescatore locale, la <strong>Grotta dello Smeraldo</strong> e una cavita carsica semisommersa dove la luce solare filtra da una fessura sottomarina, colorando l'acqua di un verde smeraldo intenso.
          </p>
          <div class="bg-white p-6 rounded-2xl border border-slate-100 space-y-4">
            <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
              <div>
                <p class="text-xs text-slate-400 uppercase tracking-wider">Ingresso</p>
                <p class="font-medium text-charcoal">~5 euro</p>
              </div>
              <div>
                <p class="text-xs text-slate-400 uppercase tracking-wider">Accesso</p>
                <p class="font-medium text-charcoal">Ascensore o barca</p>
              </div>
              <div>
                <p class="text-xs text-slate-400 uppercase tracking-wider">Durata visita</p>
                <p class="font-medium text-charcoal">~15-20 min</p>
              </div>
              <div>
                <p class="text-xs text-slate-400 uppercase tracking-wider">Apertura</p>
                <p class="font-medium text-charcoal">Tutto l'anno</p>
              </div>
            </div>
            <p class="text-slate-600 text-sm leading-relaxed">
              All'interno si naviga su piccole barche a remi. Sul fondo, un presepe subacqueo in ceramica deposto negli anni '60. La grotta e accessibile dalla SS163 tramite ascensore, oppure via mare da <a href="/it-it/costiera-amalfitana/amalfi/" class="text-med-blue hover:underline">Amalfi</a> con escursioni in barca (~10 euro).
            </p>
          </div>
        </div>

        <!-- Cosa Vedere -->
        <div>
          <h2 class="font-serif text-3xl font-semibold text-slate-900 mb-8">Cosa vedere a Conca dei Marini</h2>
          <div class="space-y-8">
            {[
              { n: 1, title: 'Grotta dello Smeraldo', text: 'L\'attrazione principale: una grotta marina con acqua color smeraldo, visitabile in barca. Aperta tutto l\'anno (meteo permettendo). Da non perdere nelle giornate di sole quando la luce e piu intensa.' },
              { n: 2, title: 'Convento di Santa Rosa', text: 'Il monastero del XVII secolo dove le monache inventarono la sfogliatella Santa Rosa. Oggi e un hotel di lusso (Hotel Monastero Santa Rosa), ma l\'esterno e la chiesa sono visibili dalla strada.' },
              { n: 3, title: 'Spiaggia di Capo di Conca', text: 'Una caletta di ciottoli raggiungibile tramite scalinata. Acqua cristallina, pochi turisti. Il Lido Capo di Conca offre servizio attrezzato con lettini, ombrelloni e bar.' },
              { n: 4, title: 'Chiesa di San Pancrazio', text: 'La chiesa parrocchiale del borgo, con una cupola maiolicata visibile dalla strada. Interno barocco con dipinti del XVII-XVIII secolo. Aperta per le funzioni.' },
              { n: 5, title: 'Torre di Capo di Conca', text: 'Torre di avvistamento costiera del XVI secolo, in posizione panoramica sopra la spiaggia. Raggiungibile a piedi in 10 minuti dal centro.' },
            ].map(({ n, title, text }) => (
              <div class="grid sm:grid-cols-[auto_1fr] gap-4">
                <div class="w-14 h-14 rounded-[1rem] bg-med-gold/10 flex items-center justify-center flex-shrink-0 text-med-gold font-serif font-bold text-xl">{n}</div>
                <div>
                  <h3 class="font-semibold text-charcoal text-lg mb-1">{title}</h3>
                  <p class="text-slate-600 leading-relaxed">{text}</p>
                </div>
              </div>
            ))}
          </div>
        </div>

        <!-- Consiglio Local -->
        <div class="relative overflow-hidden rounded-[3rem] bg-med-blue p-10 md:p-14 text-white shadow-2xl">
          <div class="relative z-10 flex flex-col md:flex-row items-start md:items-center gap-8">
            <div class="w-20 h-20 rounded-2xl bg-white/10 flex items-center justify-center flex-shrink-0 border border-white/20"><svg class="w-10 h-10 text-med-gold" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 3v2.25m6.364.386-1.591 1.591M21 12h-2.25m-.386 6.364-1.591-1.591M12 18.75V21m-4.773-4.227-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0Z"/></svg></div>
            <div>
              <p class="text-med-gold text-xs font-bold uppercase tracking-[0.3em] mb-2">Consiglio Local</p>
              <h3 class="font-serif text-2xl font-bold text-white mb-3 tracking-tight">La vera sfogliatella Santa Rosa</h3>
              <p class="text-white/70 leading-relaxed">La sfogliatella Santa Rosa e diversa da quella napoletana: piu grande, con crema pasticcera, ricotta e amarena. Cercala nelle pasticcerie della Costiera (non a Napoli). E il dolce che ha ispirato tutta la tradizione delle sfogliatelle campane.</p>
            </div>
          </div>
          <div class="absolute bottom-0 left-0 translate-y-1/2 -translate-x-1/2 w-80 h-80 bg-med-gold/10 rounded-full blur-3xl pointer-events-none"></div>
        </div>

        <!-- FAQ -->
        <div id="faq">
          <h2 class="font-serif text-3xl font-semibold text-slate-900 mb-8">Domande frequenti su Conca dei Marini</h2>
          <div class="space-y-4">
            {faqSchema.mainEntity.map((q) => (
              <details class="group border border-slate-200 rounded-2xl overflow-hidden">
                <summary class="flex items-center justify-between px-6 py-4 cursor-pointer select-none text-charcoal font-medium hover:bg-slate-50 transition-colors">
                  {q.name}
                  <svg class="w-4 h-4 text-slate-400 group-open:rotate-180 transition-transform flex-shrink-0 ml-3" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
                </summary>
                <div class="px-6 pb-5 text-slate-600 leading-relaxed text-xs sm:text-sm border-t border-slate-100 pt-4">
                  {q.acceptedAnswer.text}
                </div>
              </details>
            ))}
          </div>
        </div>

      </div>

      <aside class="space-y-6 lg:sticky lg:top-24 self-start">
        <div id="fast-facts" class="bg-slate-900 text-white rounded-[3rem] p-6">
          <p class="text-[10px] uppercase tracking-[0.3em] text-med-gold font-medium mb-4">Fast Facts - Conca dei Marini</p>
          <dl class="space-y-3">
            {fastFacts.map(({ dt, dd }, i) => (
              <>
                <div class="flex justify-between items-start gap-3">
                  <dt class="text-white/40 text-xs sm:text-sm font-light flex-shrink-0">{dt}</dt>
                  <dd class="text-white font-medium text-xs sm:text-sm text-right">{dd}</dd>
                </div>
                {i < fastFacts.length - 1 && <div class="border-t border-white/5"></div>}
              </>
            ))}
          </dl>
        </div>

        <div class="bg-med-cream border border-med-gold/30 rounded-[2rem] p-6">
          <p class="text-[10px] uppercase tracking-[0.3em] text-med-gold font-medium mb-3">Consigli degli insider</p>
          <ul class="space-y-3">
            {tips.map(tip => (
              <li class="flex items-start gap-2 text-xs sm:text-sm text-charcoal">
                <span class="w-1.5 h-1.5 rounded-full bg-med-gold mt-1.5 flex-shrink-0"></span>
                <span>{tip}</span>
              </li>
            ))}
          </ul>
        </div>

        <div class="bg-white border border-slate-100 rounded-[2rem] p-6 shadow-sm">
          <p class="text-[10px] uppercase tracking-[0.3em] text-slate-400 font-medium mb-3">Esplora la Costiera</p>
          <nav class="space-y-1">
            {[
              { href: '/it-it/costiera-amalfitana/furore/', label: 'Furore' },
              { href: '/it-it/costiera-amalfitana/amalfi/', label: 'Amalfi' },
              { href: '/it-it/costiera-amalfitana/praiano/', label: 'Praiano' },
              { href: '/it-it/costiera-amalfitana/positano/', label: 'Positano' },
              { href: '/it-it/costiera-amalfitana/ravello/', label: 'Ravello' },
            ].map(({ href, label }) => (
              <a href={href} class="flex items-center gap-2 px-3 py-2 rounded-xl text-xs sm:text-sm text-charcoal hover:bg-med-blue/5 hover:text-med-blue transition-colors">
                <span class="w-1.5 h-1.5 rounded-full bg-med-blue/30"></span> {label}
              </a>
            ))}
          </nav>
        </div>
      </aside>

    </div>
  </section>

  <CorrelationSlider
    heading="Esplora anche sulla Costiera"
    items={[
      { name: 'Furore',   href: '/it-it/costiera-amalfitana/furore/',   tag: 'Il borgo che non c\'e', desc: 'Il Fiordo spettacolare e i murales del Paese Dipinto.' },
      { name: 'Amalfi',   href: '/it-it/costiera-amalfitana/amalfi/',   tag: 'Repubblica Marinara',    desc: 'La capitale storica con il Duomo e il Museo della Carta.' },
      { name: 'Praiano',  href: '/it-it/costiera-amalfitana/praiano/',  tag: 'Tramonto & Quiete',     desc: 'Il tramonto da San Gennaro e la spiaggia Gavitella.' },
      { name: 'Ravello',  href: '/it-it/costiera-amalfitana/ravello/',  tag: 'Musica & Giardini',     desc: 'Villa Rufolo, Villa Cimbrone e il Festival Musicale.' },
      { name: 'Positano', href: '/it-it/costiera-amalfitana/positano/', tag: 'Fashion & Vista',        desc: 'Le case colorate a picco sul mare e la spiaggia Fornillo.' },
    ]}
    lang="it-it"
  />

</BaseLayout>
