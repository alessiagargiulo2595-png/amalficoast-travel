---
import BaseLayout from '../../../layouts/BaseLayout.astro';

const lang = 'it-it';

const breadcrumbs = [
  { name: 'Home', url: '/it-it/' },
  { name: 'Costiera Amalfitana', url: '/it-it/costiera-amalfitana/' },
];

const borghi = [
  {
    name: 'Positano',
    href: '/it-it/costiera-amalfitana/positano/',
    desc: 'Il borgo più fotografato della costiera, con case colorate a strapiombo sul mare e la celebre Spiaggia Grande.',
    tag: 'Il più iconico',
  },
  {
    name: 'Amalfi',
    href: '/it-it/costiera-amalfitana/amalfi/',
    desc: 'Capitale storica della costiera, con il Duomo di Sant\'Andrea e il museo della carta.',
    tag: 'Capitale storica',
  },
  {
    name: 'Ravello',
    href: '/it-it/costiera-amalfitana/ravello/',
    desc: 'A 350 m sul mare, la "città della musica" con villa Rufolo e villa Cimbrone.',
    tag: 'Vista panoramica',
  },
  {
    name: 'Praiano',
    href: '/it-it/costiera-amalfitana/praiano/',
    desc: 'Il segreto meglio custodito: meno folla, tramonti spettacolari dalla Baia di Praia.',
    tag: 'La più autentica',
  },
  {
    name: 'Marina di Praia',
    href: '/it-it/spiagge/costiera-amalfitana/marina-di-praia/',
    desc: 'La spiaggia selvaggia di Praiano, nascosta dietro una scalinata nella roccia. Autenticità pura e tramonti spettacolari.',
    tag: 'Selvaggia e autentica',
  },
  {
    name: 'Maiori',
    href: '/it-it/costiera-amalfitana/maiori/',
    desc: 'La spiaggia sabbiosa più lunga della costiera: ideale per chi cerca il mare senza rinunciare al comfort.',
    tag: 'Spiaggia sabbiosa',
  },
  {
    name: 'Minori',
    href: '/it-it/costiera-amalfitana/minori/',
    desc: 'Borgo della limonara, con i resti di una villa romana del I sec. d.C. e ottime pasticcerie.',
    tag: 'Sapori autentici',
  },
  {
    name: 'Vietri sul Mare',
    href: '/it-it/costiera-amalfitana/vietri-sul-mare/',
    desc: 'La porta orientale della Costiera, celebre per le sue caratteristiche ceramiche dipinte a mano.',
    tag: 'La capitale della ceramica',
  },
  {
    name: 'Salerno',
    href: '/it-it/costiera-amalfitana/salerno/',
    desc: 'La città-porta della costiera: Duomo, Giardino della Minerva, Castello Arechi e le Luci d\'Artista in inverno.',
    tag: 'Porta della costiera',
  },
  {
    name: 'Furore',
    href: '/it-it/costiera-amalfitana/furore/',
    desc: 'Il "paese che non c\'è" con il celebre fiordo, i murales d\'artista e i vigneti terrazzati.',
    tag: 'Il Fiordo',
  },
  {
    name: 'Conca dei Marini',
    href: '/it-it/costiera-amalfitana/conca-dei-marini/',
    desc: 'Borgo silenzioso tra Amalfi e Positano, patria della Grotta dello Smeraldo e della sfogliatella Santa Rosa.',
    tag: 'Grotta dello Smeraldo',
  },
  {
    name: 'Agerola',
    href: '/it-it/costiera-amalfitana/agerola/',
    desc: 'Il balcone sulla costiera a 630 m: punto di partenza del Sentiero degli Dei e patria del fior di latte.',
    tag: 'Sentiero degli Dei',
  },
  {
    name: 'Tramonti',
    href: '/it-it/costiera-amalfitana/tramonti/',
    desc: 'La cantina nascosta della costiera: vini Tintore, 13 frazioni rurali e gastronomia autentica.',
    tag: 'Vini & Tradizione',
  },
  {
    name: 'Erchie',
    href: '/it-it/costiera-amalfitana/erchie/',
    desc: 'Caletta segreta con spiaggia di sabbia, torre saracena e acque cristalline. La meno turistica della costiera.',
    tag: 'Caletta segreta',
  },
];

const destinationSchema = {
  "@context": "https://schema.org",
  "@type": "TouristDestination",
  "name": "Costiera Amalfitana",
  "description": "La Costiera Amalfitana è un tratto costiero della Campania lungo 50 km, Patrimonio UNESCO dal 1997, con borghi colorati, scogliere e il blu del Mar Tirreno.",
  "url": "https://amalficoast-travel.com/it-it/costiera-amalfitana/",
  "touristType": ["Cultura", "Mare", "Natura", "Gastronomia", "Escursionismo"],
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": 40.6333,
    "longitude": 14.6027
  }
};
---

<BaseLayout
  title="Costiera Amalfitana 2026: Guida Completa ai Borghi"
  description="Guida alla Costiera Amalfitana: borghi da visitare, spiagge, come arrivare, quando andare. Da Positano ad Amalfi, tutto quello che devi sapere."
  lang={lang}
  breadcrumbs={breadcrumbs}
  schema={[destinationSchema]}
  pageKey="amalfi-coast"
>

  <!-- Hero -->
  <section class="relative h-[45vh] sm:h-[60vh] flex items-center bg-charcoal overflow-hidden">
    <img src="/images/costiera-hero.jpg" alt="Costiera Amalfitana" class="absolute inset-0 w-full h-full object-cover" loading="eager" fetchpriority="high" decoding="sync" referrerpolicy="no-referrer"/>
    <div class="absolute inset-0 bg-gradient-to-b from-black/25 via-black/40 to-black/75"></div>
    <div class="relative z-10 max-w-7xl mx-auto px-6 py-16">
      <nav class="flex items-center gap-2 text-white/60 text-xs mb-6">
        <a href="/it-it/" class="hover:text-white transition-colors">Home</a>
        <span>/</span>
        <span class="text-white">Costiera Amalfitana</span>
      </nav>
      <div class="max-w-3xl">
        <p class="text-med-gold text-xs sm:text-sm font-medium uppercase tracking-[0.3em] mb-3">Patrimonio UNESCO</p>
        <h1 class="font-serif text-display text-white mb-4">Costiera Amalfitana</h1>
        <p class="text-xl text-white/80 leading-relaxed">
          50 km di scogliere, borghi colorati e acque turchesi. La costiera più famosa d'Italia: Positano, Amalfi, Ravello e oltre.
        </p>
      </div>
    </div>
  </section>

  <div class="max-w-editorial mx-auto px-4 sm:px-6 lg:px-8 py-16 space-y-20">

    <!-- Intro -->
    <section class="text-justify">
      <p class="text-xl leading-relaxed text-charcoal">
        La Costiera Amalfitana è uno di quei luoghi che supera qualsiasi aspettativa. Non importa quante fotografie tu abbia visto: la realtà - il profumo di limoni, il riverbero del sole sul mare, le case aggrappate alla roccia - è sempre più intensa.
      </p>
      <p class="mt-4 text-slate-600 leading-relaxed">
        Riconosciuta Patrimonio dell'Umanità UNESCO nel 1997, si estende per 50 km dalla penisola sorrentina fino a Vietri sul Mare, nella provincia di Salerno. I paesi della Costiera Amalfitana sono collegati dalla SS163, una strada tortuosa scavata nella roccia che attraversa 13 comuni, ognuno con una storia, un paesaggio e un sapore diverso.
      </p>
    </section>

    <!-- Borghi Grid -->
    <section>
      <div class="flex items-end justify-between mb-8">
        <h2 class="font-serif text-3xl font-semibold">I borghi della Costiera</h2>
        <p class="text-xs sm:text-sm text-slate-400 hidden sm:block">Da ovest a est lungo la SS163</p>
      </div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {borghi.map((b, i) => {
          const stripeColors = ['#D4AF37', '#E2725B', '#005B96', '#40E0D0'];
          const stripeColor = stripeColors[i % stripeColors.length];
          return (
            <a href={b.href} class="group relative overflow-hidden bg-white border border-slate-100 rounded-[2rem] p-6 pl-7 shadow-sm hover:border-med-blue/30 hover:shadow-xl transition-all duration-300">
              <span class="absolute left-0 top-0 bottom-0 w-1.5" style={`background-color: ${stripeColor}`}></span>
              <div class="flex items-start justify-between mb-3">
                <h3 class="font-serif text-xl font-semibold text-slate-900 group-hover:text-med-blue transition-colors">{b.name}</h3>
                <span class="text-[10px] uppercase tracking-wide px-2 py-1 rounded-full font-semibold flex-shrink-0 ml-2 text-white" style={`background-color: ${stripeColor}`}>{b.tag}</span>
              </div>
              <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">{b.desc}</p>
              <p class="text-med-blue text-xs sm:text-sm font-medium mt-4 group-hover:translate-x-1 transition-transform inline-flex items-center gap-1">
                Scopri {b.name}
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 18l6-6-6-6"/></svg>
              </p>
            </a>
          );
        })}
      </div>
    </section>

    <!-- Did You Know -->
    <section class="bg-charcoal text-white rounded-[2rem] p-10">
      <p class="text-[10px] uppercase tracking-[0.3em] text-med-gold font-medium mb-8">La costiera in numeri</p>
      <div class="grid sm:grid-cols-4 gap-8 text-center">
        <div>
          <p class="font-serif text-5xl font-bold text-med-gold">50 km</p>
          <p class="text-white/60 text-xs sm:text-sm mt-2">di litorale UNESCO</p>
        </div>
        <div>
          <p class="font-serif text-5xl font-bold text-med-gold">13</p>
          <p class="text-white/60 text-xs sm:text-sm mt-2">comuni costieri</p>
        </div>
        <div>
          <p class="font-serif text-5xl font-bold text-med-gold">1997</p>
          <p class="text-white/60 text-xs sm:text-sm mt-2">anno UNESCO</p>
        </div>
        <div>
          <p class="font-serif text-5xl font-bold text-med-gold">2 mln+</p>
          <p class="text-white/60 text-xs sm:text-sm mt-2">turisti/anno</p>
        </div>
      </div>
    </section>

    <!-- Cosa vedere in Costiera Amalfitana -->
    <section>
      <h2 class="font-serif text-3xl font-semibold text-slate-900 mb-6">Cosa vedere in Costiera Amalfitana</h2>
      <p class="text-slate-600 leading-relaxed mb-6">La Costiera Amalfitana offre una concentrazione straordinaria di attrazioni: borghi medievali, chiese millenarie, giardini panoramici, sentieri escursionistici e spiagge nascoste. Ecco le esperienze imperdibili:</p>
      <div class="grid sm:grid-cols-2 gap-4">
        <div class="bg-white border border-slate-100 rounded-2xl p-5">
          <h3 class="font-semibold text-charcoal mb-2">Borghi e cultura</h3>
          <ul class="text-xs sm:text-sm text-slate-600 space-y-1.5">
            <li>Il <a href="/it-it/costiera-amalfitana/amalfi/" class="text-med-blue hover:underline">Duomo di Amalfi</a> e il Chiostro del Paradiso</li>
            <li><a href="/it-it/costiera-amalfitana/ravello/" class="text-med-blue hover:underline">Villa Rufolo e Villa Cimbrone</a> a Ravello</li>
            <li>Le <a href="/it-it/costiera-amalfitana/vietri-sul-mare/" class="text-med-blue hover:underline">ceramiche di Vietri sul Mare</a></li>
            <li>Le case colorate di <a href="/it-it/costiera-amalfitana/positano/" class="text-med-blue hover:underline">Positano</a></li>
          </ul>
        </div>
        <div class="bg-white border border-slate-100 rounded-2xl p-5">
          <h3 class="font-semibold text-charcoal mb-2">Natura e trekking</h3>
          <ul class="text-xs sm:text-sm text-slate-600 space-y-1.5">
            <li>Il <a href="/it-it/esperienze/trekking/" class="text-med-blue hover:underline">Sentiero degli Dei</a> (Agerola–Nocelle)</li>
            <li>La <a href="/it-it/blog/valle-delle-ferriere/" class="text-med-blue hover:underline">Valle delle Ferriere</a> con cascate e felci tropicali</li>
            <li>Il <a href="/it-it/costiera-amalfitana/furore/" class="text-med-blue hover:underline">Fiordo di Furore</a></li>
            <li>La <a href="/it-it/costiera-amalfitana/conca-dei-marini/" class="text-med-blue hover:underline">Grotta dello Smeraldo</a> a Conca dei Marini</li>
          </ul>
        </div>
        <div class="bg-white border border-slate-100 rounded-2xl p-5">
          <h3 class="font-semibold text-charcoal mb-2">Mare e spiagge</h3>
          <ul class="text-xs sm:text-sm text-slate-600 space-y-1.5">
            <li>Le <a href="/it-it/costiera-amalfitana/positano/" class="text-med-blue hover:underline">spiagge di Positano</a> (Grande e Fornillo)</li>
            <li>La spiaggia di <a href="/it-it/costiera-amalfitana/maiori/" class="text-med-blue hover:underline">Maiori</a>, la più lunga della costiera</li>
            <li><a href="/it-it/spiagge/costiera-amalfitana/marina-di-praia/" class="text-med-blue hover:underline">Marina di Praia</a> a Praiano</li>
            <li>La spiaggia di <a href="/it-it/costiera-amalfitana/erchie/" class="text-med-blue hover:underline">Erchie</a></li>
          </ul>
        </div>
        <div class="bg-white border border-slate-100 rounded-2xl p-5">
          <h3 class="font-semibold text-charcoal mb-2">Gastronomia</h3>
          <ul class="text-xs sm:text-sm text-slate-600 space-y-1.5">
            <li>Il limoncello artigianale e i dolci al limone sfusato</li>
            <li>La <a href="/it-it/costiera-amalfitana/cetara/" class="text-med-blue hover:underline">colatura di alici di Cetara</a> DOP</li>
            <li>I vini di <a href="/it-it/costiera-amalfitana/tramonti/" class="text-med-blue hover:underline">Tramonti</a> (Tintore e Costa d'Amalfi DOC)</li>
            <li>Gli scialatielli ai frutti di mare</li>
          </ul>
        </div>
      </div>
    </section>

    <!-- Quick Links -->
    <section>
      <h2 class="font-serif text-3xl font-semibold text-slate-900 mb-8">Guide pratiche</h2>
      <div class="grid sm:grid-cols-3 gap-4">
        <div class="flex items-center gap-4 bg-med-cream rounded-2xl p-5 hover:bg-med-blue/5 transition-colors group border border-slate-100">
          <div class="w-10 h-10 rounded-xl bg-blue-100 flex items-center justify-center flex-shrink-0 text-med-blue">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3 17l1.5-6H19.5L21 17M3 17h18"/></svg>
          </div>
          <div>
            <p class="font-medium text-charcoal group-hover:text-med-blue text-xs sm:text-sm transition-colors">Come arrivare</p>
            <p class="text-xs text-slate-500">Traghetti, bus, auto</p>
          </div>
        </div>
        <a href="/it-it/guida/quando-visitare/" class="flex items-center gap-4 bg-med-cream rounded-2xl p-5 hover:bg-med-blue/5 transition-colors group border border-slate-100">
          <div class="w-10 h-10 rounded-xl bg-blue-100 flex items-center justify-center flex-shrink-0 text-med-blue">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="18" rx="2"/><path stroke-linecap="round" d="M16 2v4M8 2v4M3 10h18"/></svg>
          </div>
          <div>
            <p class="font-medium text-charcoal group-hover:text-med-blue text-xs sm:text-sm transition-colors">Quando andare</p>
            <p class="text-xs text-slate-500">Mese per mese</p>
          </div>
        </a>
        <a href="/it-it/spiagge/" class="flex items-center gap-4 bg-med-cream rounded-2xl p-5 hover:bg-med-blue/5 transition-colors group border border-slate-100">
          <div class="w-10 h-10 rounded-xl bg-blue-100 flex items-center justify-center flex-shrink-0 text-med-blue">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3 17c3-3 6-3 9 0s6 3 9 0M3 12c3-3 6-3 9 0s6 3 9 0"/></svg>
          </div>
          <div>
            <p class="font-medium text-charcoal group-hover:text-med-blue text-xs sm:text-sm transition-colors">Le spiagge</p>
            <p class="text-xs text-slate-500">8 spiagge selezionate</p>
          </div>
        </a>
      </div>
    </section>

  </div>

</BaseLayout>
