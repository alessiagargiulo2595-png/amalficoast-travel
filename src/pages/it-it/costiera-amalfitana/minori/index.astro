---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import CorrelationSlider from '../../../../components/CorrelationSlider.astro';
import Breadcrumbs from '../../../../components/Breadcrumbs.astro';

const lang = 'it-it';

const breadcrumbs = [
  { name: 'Home', url: '/it-it/' },
  { name: 'Costiera Amalfitana', url: '/it-it/costiera-amalfitana/' },
  { name: 'Minori', url: '/it-it/costiera-amalfitana/minori/' },
];

const touristAttractionSchema = {
  "@context": "https://schema.org",
  "@type": "TouristAttraction",
  "name": "Minori",
  "description": "Minori è il borgo della limonara e dei dolci, con i resti di una villa romana del I sec. d.C. e le pasticcerie più celebri della Costiera Amalfitana. Autentica e meno frequentata.",
  "url": "https://amalficoast-travel.com/it-it/costiera-amalfitana/minori/",
  "image": "https://amalficoast-travel.com/images/minori-hero.jpg",
  "touristType": ["Gastronomia", "Archeologia", "Autenticità", "Mare"],
  "address": {
    "@type": "PostalAddress",
    "addressLocality": "Minori",
    "addressRegion": "Salerno",
    "addressCountry": "IT",
    "postalCode": "84010"
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": 40.6500,
    "longitude": 14.6275
  }
};

const placeSchema = {
  "@context": "https://schema.org",
  "@type": "Place",
  "name": "Minori, Costiera Amalfitana",
  "description": "Borgo della limonara e della pasticceria artigianale sulla Costiera Amalfitana.",
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": 40.6500,
    "longitude": 14.6275
  },
  "containedInPlace": {
    "@type": "AdministrativeArea",
    "name": "Costiera Amalfitana"
  }
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Cosa c'è da vedere a Minori?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Le attrazioni principali di Minori sono la Villa Romana del I sec. d.C. (unica nel suo genere sulla costiera), la Basilica di Santa Trofimena, le limonaie terrazzate e le pasticcerie artigianali - in particolare quelle specializzate in delizie al limone e scialatielli freschi."
      }
    },
    {
      "@type": "Question",
      "name": "Come si arriva a Minori?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Minori è raggiungibile in bus SITA da <a href=\"/it-it/costiera-amalfitana/amalfi/\" class=\"text-med-blue hover:underline\">Amalfi</a> (~10 min) e da <a href=\"/it-it/costiera-amalfitana/salerno/\" class=\"text-med-blue hover:underline\">Salerno</a> (~40 min), e in traghetto da <a href=\"/it-it/costiera-amalfitana/salerno/\" class=\"text-med-blue hover:underline\">Salerno</a> con Travelmar (stagionale, ~50 min). Si trova a pochi minuti da <a href=\"/it-it/costiera-amalfitana/maiori/\" class=\"text-med-blue hover:underline\">Maiori</a>, con cui condivide le fermate dei bus."
      }
    },
    {
      "@type": "Question",
      "name": "Minori è famosa per i dolci?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Sì, Minori è considerata la capitale della pasticceria della Costiera Amalfitana. Le specialità locali sono le delizie al limone, la torta ricotta e pera, i biscotti al limone e gli scialatielli - pasta artigianale inventata qui dallo chef Enrico Cosentino negli anni '70."
      }
    },
    {
      "@type": "Question",
      "name": "La spiaggia di Minori è sabbiosa?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "La spiaggia di Minori è mista: ghiaia fine e sabbia scura. Non è sabbiosa come quella di <a href=\"/it-it/costiera-amalfitana/maiori/\" class=\"text-med-blue hover:underline\">Maiori</a> (a soli 2 km), ma è ben attrezzata con stabilimenti balneari e zona libera. Le acque sono calme e limpide."
      }
    },
    {
      "@type": "Question",
      "name": "Quanto dura la visita alla Villa Romana di Minori?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "La Villa Romana del I sec. d.C. si visita in 30–45 minuti. L'ingresso è gratuito. Gli scavi hanno riportato alla luce un triclinio estivo, terme e un ninfeo. Il sito è aperto dal martedì alla domenica."
      }
    }
  ]
};
---

<BaseLayout
  title="Minori 2026: Guida Completa | Villa Romana e Dolci della Costiera"
  description="Tutto su Minori: villa romana, pasticcerie, spiaggia, come arrivare. La guida al borgo della limonara e dei sapori autentici della Costiera Amalfitana."
  lang={lang}
  pageKey="minori"
  breadcrumbs={breadcrumbs}
  schema={[touristAttractionSchema, placeSchema, faqSchema]}
>

  <section class="relative h-[60vh] sm:h-[80vh] flex items-center bg-charcoal overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-b from-black/20 via-black/40 to-black/80 z-10"></div>
    <img src="/images/minori-hero.jpg" alt="" class="absolute inset-0 w-full h-full object-cover" loading="eager"  referrerpolicy="no-referrer"/>
    <div class="relative z-20 max-w-editorial mx-auto px-4 sm:px-6 lg:px-8">
      <nav class="flex items-center gap-2 text-white/60 text-xs mb-6">
