---
import BaseLayout from '../../../../../layouts/BaseLayout.astro';
import CorrelationSlider from '../../../../../components/CorrelationSlider.astro';
import Breadcrumbs from '../../../../../components/Breadcrumbs.astro';

const lang = 'it-it';

const breadcrumbs = [
  { name: 'Home', url: '/it-it/' },
  { name: 'Pianificazione', url: '/it-it/pianificazione/' },
  { name: 'Trekking Sentiero degli Dei', url: '/it-it/itinerari/1-giorno/trekking-sentiero-degli-dei/' },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Come organizzare il Sentiero degli Dei in un giorno da Napoli?",
      "acceptedAnswer": { "@type": "Answer", "text": "Parti da Napoli con la Circumvesuviana fino a Sorrento (70 min), poi bus SITA per Amalfi (90 min), poi bus locale per Bomerano/Agerola (45 min). Il sentiero Bomerano→Nocelle è 8 km, 3-4h. Da Nocelle bus locale per Positano (15 min), poi bus SITA o traghetto per Sorrento e Circumvesuviana per Napoli." }
    },
    {
      "@type": "Question",
      "name": "Serve prenotare per il Sentiero degli Dei?",
      "acceptedAnswer": { "@type": "Answer", "text": "In alta stagione (luglio-agosto) il Sentiero degli Dei richiede prenotazione obbligatoria sul portale del Parco dei Monti Lattari. Il costo è simbolico (~€5). Fuori stagione non è richiesta. Verifica sempre le condizioni sul sito ufficiale prima di partire." }
    },
    {
      "@type": "Question",
      "name": "Cosa portare per il Sentiero degli Dei?",
      "acceptedAnswer": { "@type": "Answer", "text": "Obbligatorio: scarpe da trekking (non sandali o sneaker lisce), almeno 1.5L di acqua, protezione solare, cappello. Il sentiero non ha fontane né negozi. Portare uno spuntino. In primavera/autunno una giacca leggera è consigliata per il vento in quota." }
    },
    {
      "@type": "Question",
      "name": "Il Sentiero degli Dei è pericoloso?",
      "acceptedAnswer": { "@type": "Answer", "text": "Il Sentiero degli Dei non è pericoloso per chi ha scarpe adatte e un minimo di preparazione fisica. Il percorso è classificato E/EE: sentiero escursionistico senza tratti attrezzati. I punti esposti hanno protezioni. Sconsigliato con pioggia (fondo scivoloso) e con vertigini nei tratti panoramici a strapiombo. Non adatto a bambini sotto i 6 anni." }
    },
    {
      "@type": "Question",
      "name": "Quanto dura il Sentiero degli Dei?",
      "acceptedAnswer": { "@type": "Answer", "text": "Il percorso classico Bomerano→Nocelle è lungo 7,8 km e richiede 3-4 ore a passo moderato con soste fotografiche. La variante alta (Sentiero degli Dei Alto) aggiunge circa 2 km e 1 ora. Da Nocelle a Positano si aggiungono 45 minuti a piedi (1.700 gradini) oppure 15 minuti in bus." }
    },
    {
      "@type": "Question",
      "name": "Il Sentiero degli Dei si paga?",
      "acceptedAnswer": { "@type": "Answer", "text": "Da luglio ad agosto è richiesta una prenotazione obbligatoria (~€5) sul portale del Parco dei Monti Lattari. Negli altri mesi l'accesso è libero e gratuito. Il costo copre la manutenzione del sentiero e il servizio di soccorso." }
    }
  ]
};

const hikingTrailSchema = {
  "@context": "https://schema.org",
  "@type": "TouristAttraction",
  "name": "Sentiero degli Dei",
  "alternateName": "Path of the Gods",
  "description": "Sentiero panoramico di 7,8 km da Bomerano (Agerola) a Nocelle (Positano) sulla Costiera Amalfitana, con vista mozzafiato sul mare e sui Faraglioni di Capri.",
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": 40.6389,
    "longitude": 14.5472
  },
  "touristType": ["Hiking", "Nature", "Adventure"],
  "isAccessibleForFree": false,
  "address": {
    "@type": "PostalAddress",
    "addressLocality": "Agerola",
    "addressRegion": "Campania",
    "addressCountry": "IT"
  }
};

const schedule = [
  { time: '07:00', place: 'Napoli', action: 'Circumvesuviana per Sorrento (70 min, ~€3.90)', transport: 'train' },
  { time: '08:15', place: 'Sorrento', action: 'Bus SITA per Amalfi (90 min, ~€3.50) - corsa delle 8:30', transport: 'bus' },
  { time: '10:00', place: 'Amalfi', action: 'Bus locale per Bomerano, fraz. di Agerola (45 min, ~€1.50). Inizio sentiero.', transport: 'bus' },
  { time: '11:00', place: 'Bomerano, Agerola (618 m)', action: 'Partenza Sentiero degli Dei. 7,8 km, ~500 m discesa, difficoltà E/EE. Paesaggi mozzafiato.', transport: 'walk' },
  { time: '14:30', place: 'Nocelle', action: 'Arrivo Nocelle. Pausa e pranzo in uno dei rifugi/bar locali.', transport: 'visit' },
  { time: '15:15', place: 'Nocelle → Positano', action: 'Bus locale per Positano centro (15 min, ~€1.50) o a piedi (~1.000 gradini, 45 min)', transport: 'bus' },
  { time: '16:00', place: 'Positano', action: 'Passeggiata, gelato, spiaggia (1h libera)', transport: 'visit' },
  { time: '17:15', place: 'Positano → Napoli', action: 'Bus SITA per Sorrento (~50 min), poi Circumvesuviana per Napoli (70 min)', transport: 'bus' },
];

const tips = [
  'Stagione ideale: aprile-giugno e settembre-ottobre. Luglio-agosto è caldissimo e affollato.',
  'Il bus da Amalfi per Bomerano (Agerola) ha corse limitate: controlla gli orari su eavsrl.it la sera prima.',
  'Parti sempre in direzione Bomerano→Nocelle: quasi tutto in discesa, segnaletica pensata per questo senso.',
  'Il sentiero non ha punti acqua: porta almeno 1,5L. L\'ultimo bar è a Bomerano, in piazza, prima della partenza.',
  'Da Nocelle si scende a Positano a piedi (~1.000 gradini, 45 min) o in bus (15 min, ~€1.50).',
];

const transportBadge: Record<string, { label: string; cls: string }> = {
  train: { label: 'TRENO', cls: 'bg-orange-100 text-orange-700' },
  ferry: { label: 'NAVE', cls: 'bg-blue-100 text-blue-700' },
  bus:   { label: 'BUS', cls: 'bg-green-100 text-green-700' },
  walk:  { label: 'TREKKING', cls: 'bg-red-100 text-red-700' },
  visit: { label: '', cls: '' },
};

const destinationHighlights = [
  { name: 'Positano', desc: 'Destinazione finale del trekking, gioiello della Costiera', url: '/it-it/costiera-amalfitana/positano/' },
  { name: 'Amalfi', desc: 'Base per accesso al Sentiero degli Dei via Agerola', url: '/it-it/costiera-amalfitana/amalfi/' },
  { name: 'Ravello', desc: 'Terrazza dell\'Infinito, panorami mozzafiato', url: '/it-it/costiera-amalfitana/ravello/' },
];
---

<BaseLayout
  title="Sentiero degli Dei 2026: Mappa, Difficoltà, Percorso Bomerano-Nocelle"
  description="Guida completa al Sentiero degli Dei: mappa del percorso, difficoltà, è pericoloso?, prenotazione, come arrivare da Napoli. Trek 7,8 km Bomerano→Nocelle con vista Costiera Amalfitana."
  lang={lang}
  breadcrumbs={breadcrumbs}
  schema={[faqSchema, hikingTrailSchema]}
 pageKey="trekking-sentiero-degli-dei"
  heroImage="/images/costiera-hero.jpg"
>

  <!-- Hero Section -->
  <section class="relative bg-charcoal overflow-hidden min-h-[70vh] sm:min-h-[75vh] flex items-center justify-center">
    <img src="/images/costiera-hero.jpg" alt="Grand Tour Costiera Amalfitana" class="absolute inset-0 w-full h-full object-cover opacity-30" loading="eager" fetchpriority="high" decoding="sync" referrerpolicy="no-referrer"/>
    <div class="absolute inset-0 bg-gradient-to-b from-black/75 via-black/40 to-black/70"></div>
    <div class="relative max-w-editorial mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <div class="max-w-3xl mx-auto">
        <p class="text-med-gold text-xs sm:text-sm font-medium uppercase tracking-[0.3em] mb-3">Trekking · 1 giorno</p>
        <h1 class="font-serif text-display text-white mb-4">Sentiero degli Dei da Napoli</h1>
        <p class="text-xl text-white/80 leading-relaxed max-w-2xl mx-auto">
          8 km a piedi da Agerola a Nocelle, discesa spettacolare sulla Costiera. Vu ta da favola, prenotazione obbligatoria, scarpe da trekking.
        </p>
      </div>
    </div>
    <Breadcrumbs breadcrumbs={breadcrumbs} />
  </section>

  <div class="max-w-editorial mx-auto px-4 sm:px-6 lg:px-8 pt-6 pb-10 space-y-10">

    <!-- Intro & Stats Section - Featured -->
    <section class="text-center mb-2">
      <!-- Quick Stats Grid - Scrollable on Mobile -->
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-2 sm:gap-4 mb-2 overflow-x-auto snap-x snap-mandatory sm:overflow-visible pb-2 sm:pb-0">
        <div class="w-full bg-slate-900 rounded-2xl p-4 sm:p-6 hover:shadow-md transition-shadow flex flex-col items-center justify-center aspect-square snap-start">
          <svg class="w-8 h-8 text-med-gold mb-3" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
            <rect x="3" y="4" width="18" height="18" rx="2"/>
            <path d="M16 2v4M8 2v4M3 10h18"/>
          </svg>
          <p class="text-xs text-white font-semibold uppercase tracking-wide mb-2">Durata</p>
          <p class="font-serif text-lg font-semibold text-med-gold">1 giorno</p>
        </div>
        <div class="w-full bg-slate-900 rounded-2xl p-4 sm:p-6 hover:shadow-md transition-shadow flex flex-col items-center justify-center aspect-square snap-start">
          <svg class="w-8 h-8 text-med-gold mb-3" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
            <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/>
            <circle cx="12" cy="10" r="3"/>
          </svg>
          <p class="text-xs text-white font-semibold uppercase tracking-wide mb-2">Dislivello</p>
          <p class="font-serif text-lg font-semibold text-med-gold">~500 m<br/>discesa</p>
        </div>
        <div class="w-full bg-slate-900 rounded-2xl p-4 sm:p-6 hover:shadow-md transition-shadow flex flex-col items-center justify-center aspect-square snap-start">
          <svg class="w-8 h-8 text-med-gold mb-3" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
            <path d="M6 9l6-6 6 6M5 9v9a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V9M9 14h6"/>
          </svg>
          <p class="text-xs text-white font-semibold uppercase tracking-wide mb-2">Distanza</p>
          <p class="font-serif text-lg font-semibold text-med-gold">8 km<br/>3-4 ore</p>
        </div>
        <div class="w-full bg-slate-900 rounded-2xl p-4 sm:p-6 hover:shadow-md transition-shadow flex flex-col items-center justify-center aspect-square snap-start">
          <svg class="w-8 h-8 text-med-gold mb-3" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
            <circle cx="12" cy="12" r="1"/>
            <path d="M12 1v6M12 17v6M4.22 4.22l4.24 4.24M15.54 15.54l4.24 4.24M1 12h6M17 12h6M4.22 19.78l4.24-4.24M15.54 8.46l4.24-4.24"/>
          </svg>
          <p class="text-xs text-white font-semibold uppercase tracking-wide mb-2">Budget trasporti</p>
          <p class="font-serif text-lg font-semibold text-med-gold">€11–14<br/><span class="text-xs">p.p.</span></p>
        </div>
      </div>

      <!-- SEO Text Below -->
      <div>
        <p class="text-lg text-slate-700 leading-relaxed">
          Il <strong>Sentiero degli Dei</strong> è il trekking più celebre della <strong>Costiera Amalfitana</strong>: 7,8 km da <strong>Bomerano</strong> (Agerola) a <strong>Nocelle</strong> in discesa, con viste spettacolari su Capri e la costa. Difficoltà E/EE, adatto a escursionisti con un minimo di preparazione. Da Napoli servono circa 4 ore per raggiungere il punto di partenza (Circumvesuviana + bus SITA + bus locale). Il percorso dura 3-4 ore a passo moderato. <strong>Prenotazione obbligatoria in luglio-agosto</strong> (~€5). Budget trasporti: €11–14.
        </p>
      </div>
    </section>


    <!-- Day by Day Itinerary -->
    <section>
      <h2 class="font-serif text-2xl font-semibold text-slate-900 mb-8">Programma della giornata</h2>
      <div class="bg-white border border-slate-200 rounded-2xl overflow-hidden">
        <div class="px-6 py-8 space-y-6">
          {schedule.map((item, idx) => {
            const badge = transportBadge[item.transport];
            const isLastItem = idx === schedule.length - 1;
            return (
              <div class="flex gap-4">
                <div class="flex flex-col items-center flex-shrink-0">
                  <div class="w-16 bg-slate-900 text-med-gold rounded-full px-2 py-1 text-center text-sm font-semibold flex items-center justify-center">
                    {item.time}
                  </div>
                  {!isLastItem && <div class="w-0.5 h-12 bg-med-blue/30 mt-2"></div>}
                </div>
                <div class="pb-4 flex-1">
                  <p class="font-semibold text-slate-900 mb-1">{item.place}</p>
                  <p class="text-slate-700 text-sm mb-2">{item.action}</p>
                  {badge.label && (
                    <span class={`text-xs font-semibold px-2 py-1 rounded-full ${badge.cls}`}>
                      {badge.label}
                    </span>
                  )}
                </div>
              </div>
            );
          })}
        </div>
      </div>
    </section>

    <!-- Mappa del percorso -->
    <section id="mappa">
      <h2 class="font-serif text-2xl font-semibold text-slate-900 mb-4">Mappa del Sentiero degli Dei</h2>
      <p class="text-slate-600 mb-6 leading-relaxed">Il percorso parte da <strong>Piazza Paolo Capasso a Bomerano</strong> (fraz. di Agerola, 618 m s.l.m.) e segue il sentiero CAI n. 327 in direzione ovest lungo la cresta dei Monti Lattari, terminando a <strong>Nocelle</strong> (420 m s.l.m.), frazione alta di Positano. Il sentiero è segnalato con bandierine bianco-rosse.</p>
      <div class="rounded-2xl overflow-hidden border border-slate-200">
        <iframe
          src="https://www.openstreetmap.org/export/embed.html?bbox=14.475%2C40.618%2C14.565%2C40.655&layer=mapnik&marker=40.638%2C14.547"
          width="100%"
          height="450"
          style="border:0;"
          allowfullscreen=""
          loading="lazy"
          title="Mappa Sentiero degli Dei: percorso Bomerano - Nocelle">
        </iframe>
      </div>
      <div class="mt-4 grid grid-cols-1 sm:grid-cols-3 gap-3">
        <div class="bg-slate-50 rounded-xl p-4 text-center">
          <p class="text-xs text-slate-500 uppercase tracking-wide mb-1">Partenza</p>
          <p class="font-semibold text-slate-900">Bomerano (618 m)</p>
          <p class="text-xs text-slate-500">Piazza Paolo Capasso</p>
        </div>
        <div class="bg-slate-50 rounded-xl p-4 text-center">
          <p class="text-xs text-slate-500 uppercase tracking-wide mb-1">Arrivo</p>
          <p class="font-semibold text-slate-900">Nocelle (420 m)</p>
          <p class="text-xs text-slate-500">Piazzetta di Nocelle</p>
        </div>
        <div class="bg-slate-50 rounded-xl p-4 text-center">
          <p class="text-xs text-slate-500 uppercase tracking-wide mb-1">Dislivello</p>
          <p class="font-semibold text-slate-900">+200 m / −400 m</p>
          <p class="text-xs text-slate-500">Prevalentemente in discesa</p>
        </div>
      </div>
    </section>

    <!-- Difficoltà e sicurezza -->
    <section id="difficolta">
      <h2 class="font-serif text-2xl font-semibold text-slate-900 mb-4">Difficoltà e sicurezza</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div class="bg-white border border-slate-200 rounded-2xl p-6">
          <h3 class="font-semibold text-slate-900 mb-3 flex items-center gap-2">
            <span class="w-8 h-8 bg-green-100 text-green-700 rounded-full flex items-center justify-center text-sm font-bold">E</span>
            Classificazione: E / EE
          </h3>
          <p class="text-slate-600 text-sm leading-relaxed mb-3">
            Il Sentiero degli Dei è classificato <strong>E</strong> (Escursionistico) con alcuni tratti <strong>EE</strong> (Escursionisti Esperti). Non servono corde, ramponi o attrezzatura alpinistica. Il fondo è sterrato con tratti rocciosi e gradini scavati nella pietra.
          </p>
          <ul class="text-sm text-slate-600 space-y-1">
            <li class="flex items-start gap-2"><span class="text-green-600 mt-0.5">&#10003;</span> Nessun tratto attrezzato (no ferrate)</li>
            <li class="flex items-start gap-2"><span class="text-green-600 mt-0.5">&#10003;</span> Segnaletica CAI chiara (bianco-rosso)</li>
            <li class="flex items-start gap-2"><span class="text-green-600 mt-0.5">&#10003;</span> Punti esposti con protezioni/muretti</li>
          </ul>
        </div>
        <div class="bg-white border border-slate-200 rounded-2xl p-6">
          <h3 class="font-semibold text-slate-900 mb-3 flex items-center gap-2">
            <span class="w-8 h-8 bg-amber-100 text-amber-700 rounded-full flex items-center justify-center text-sm font-bold">!</span>
            Il sentiero è pericoloso?
          </h3>
          <p class="text-slate-600 text-sm leading-relaxed mb-3">
            <strong>No, se si rispettano le regole base.</strong> Il Sentiero degli Dei non è pericoloso per chi indossa scarpe da trekking e ha un minimo di allenamento. Tuttavia occorre prudenza:
          </p>
          <ul class="text-sm text-slate-600 space-y-1">
            <li class="flex items-start gap-2"><span class="text-amber-600 mt-0.5">&#9888;</span> Con pioggia il fondo diventa scivoloso: evitare</li>
            <li class="flex items-start gap-2"><span class="text-amber-600 mt-0.5">&#9888;</span> Tratti a strapiombo: sconsigliato a chi soffre di vertigini</li>
            <li class="flex items-start gap-2"><span class="text-amber-600 mt-0.5">&#9888;</span> Non adatto a bambini sotto i 6 anni</li>
            <li class="flex items-start gap-2"><span class="text-amber-600 mt-0.5">&#9888;</span> In estate portare almeno 1,5 L di acqua (nessuna fontana)</li>
          </ul>
        </div>
      </div>
    </section>

  </div>

  <CorrelationSlider
    heading="Le destinazioni dell'itinerario"
    lang="it-it"
    items={[
      { name: 'Positano', href: '/it-it/costiera-amalfitana/positano/', tag: 'Borgo & Spiagge', desc: 'Destinazione finale del trekking, gioiello colorato della Costiera Amalfitana.' },
      { name: 'Amalfi', href: '/it-it/costiera-amalfitana/amalfi/', tag: 'Arte & Storia', desc: 'Base per l\'accesso al Sentiero degli Dei via bus per Bomerano.' },
      { name: 'Ravello', href: '/it-it/costiera-amalfitana/ravello/', tag: 'Musica & Giardini', desc: 'Terrazza dell\'Infinito, Villa Rufolo e panorami mozzafiato a 350 m sul mare.' },
      { name: 'Praiano', href: '/it-it/costiera-amalfitana/praiano/', tag: 'Tramonto & Quiete', desc: 'Vicino a Nocelle, tramonti spettacolari e la spiaggia Gavitella.' },
    ]}
  />

  <div class="max-w-editorial mx-auto px-4 sm:px-6 lg:px-8 pb-10 space-y-10">

    <!-- Planning Tips -->
    <section class="bg-med-cream border border-med-gold/20 rounded-[2rem] p-6">
      <h2 class="font-serif text-xl font-semibold text-charcoal mb-6">Consigli pratici</h2>
      <ul class="space-y-4">
        {tips.map((text, idx) => {
          const nums = ['❶', '❷', '❸', '❹', '❺'];
          return (
            <li class="flex items-start gap-4 text-sm text-charcoal">
              <span class="text-2xl font-bold text-white flex-shrink-0 leading-none mt-0.5 bg-[#E2725B] w-9 h-9 flex items-center justify-center rounded-full">{nums[idx] || '•'}</span>
              <span class="leading-relaxed">{text}</span>
            </li>
          );
        })}
      </ul>
    </section>

    <!-- FAQ -->
    <section id="faq">
      <h2 class="font-serif text-2xl font-semibold text-slate-900 mb-6">Domande frequenti</h2>
      <div class="space-y-4">
        {faqSchema.mainEntity.map((q) => (
          <details class="group border border-slate-200 rounded-2xl overflow-hidden">
            <summary class="flex items-center justify-between px-6 py-4 cursor-pointer select-none text-charcoal font-medium hover:bg-slate-50 transition-colors">
              {q.name}
              <svg class="w-4 h-4 text-slate-400 group-open:rotate-180 transition-transform flex-shrink-0 ml-3" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
            </summary>
            <div class="px-6 pb-5 text-slate-600 leading-relaxed text-sm border-t border-slate-100 pt-4">
              {q.acceptedAnswer.text}
            </div>
          </details>
        ))}
      </div>
    </section>

    <!-- Banner: Configuratore Itinerario -->
    <section class="relative overflow-hidden rounded-[2.5rem] bg-gradient-to-br from-slate-900 via-slate-950 to-blue-950 px-6 sm:px-10 md:px-14 py-10 md:py-14 shadow-[0_20px_60px_rgba(0,0,0,0.35)]">
      <div class="absolute -top-20 -left-20 w-72 h-72 bg-blue-500/15 rounded-full blur-3xl pointer-events-none"></div>
      <div class="absolute -bottom-20 -right-20 w-72 h-72 bg-amber-500/10 rounded-full blur-3xl pointer-events-none"></div>
      <div class="relative z-10 grid md:grid-cols-[3fr_2fr] md:items-center gap-8">
        <div>
          <span class="inline-block px-4 py-1.5 rounded-full text-xs font-semibold tracking-wide uppercase bg-med-gold/15 text-med-gold border border-med-gold/25 mb-6">Novità: Viaggio su Misura</span>
          <h2 class="text-3xl md:text-4xl font-bold text-white leading-tight mb-2">Disegna il tuo</h2>
          <p class="font-serif text-3xl md:text-4xl italic text-med-blue mb-5">itinerario ideale</p>
          <p class="text-white/60 text-base md:text-lg leading-relaxed max-w-xl mb-8">Rispondi a poche semplici domande - punto di partenza, giorni e interessi - e ricevi un itinerario personalizzato con trasporti, costi e orari.</p>
          <div class="flex flex-wrap gap-6">
            <div class="flex items-center gap-2.5">
              <div class="w-9 h-9 rounded-xl bg-white/5 border border-white/10 flex items-center justify-center">
