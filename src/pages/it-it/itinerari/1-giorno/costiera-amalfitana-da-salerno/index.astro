---
import BaseLayout from '../../../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../../../components/Breadcrumbs.astro';

const lang = 'it-it';

const breadcrumbs = [
  { name: 'Home', url: '/it-it/' },
  { name: 'Pianificazione', url: '/it-it/pianificazione/' },
  { name: '1 Giorno da Salerno', url: '/it-it/itinerari/1-giorno/costiera-amalfitana-da-salerno/' },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Come si arriva alla Costiera Amalfitana da Salerno?",
      "acceptedAnswer": { "@type": "Answer", "text": "Da Salerno hai due opzioni: traghetto Travelmar per Amalfi (45 min, ~€8, stagionale apr-ott) oppure bus SITA dalla stazione di Salerno (direzione Amalfi via SS163, ~60 min, ~€2.80). Il traghetto è più panoramico e veloce; il bus è attivo tutto l'anno." }
    },
    {
      "@type": "Question",
      "name": "Vale la pena partire dalla porta est della Costiera (Vietri, Maiori)?",
      "acceptedAnswer": { "@type": "Answer", "text": "Sì, soprattutto in bassa stagione quando i borghi sono meno affollati. Vietri sul Mare è famosa per le ceramiche, Maiori ha il lungomare più lungo della Costiera e un'atmosfera rilassata. Minori vale una sosta per le rovine della Villa Romana." }
    }
  ]
};

const schedule = [
  { time: '08:30', place: 'Salerno', action: 'Traghetto Travelmar per Amalfi (apr-ott, 45 min, ~€8) o bus SITA (60 min, ~€2.80)', transport: 'ferry' },
  { time: '09:30', place: 'Amalfi', action: 'Duomo di Sant\'Andrea, Chiostro del Paradiso, Museo della Carta (2.5h)', transport: 'visit' },
  { time: '12:00', place: 'Amalfi', action: 'Pranzo in centro (trattorie sul corso o sul porto)', transport: 'visit' },
  { time: '13:30', place: 'Amalfi → Maiori', action: 'Bus SITA est per Maiori (20 min, ~€1.50). Lungomare e spiaggia.', transport: 'bus' },
  { time: '15:00', place: 'Maiori → Minori', action: 'A piedi lungo il lungomare (20 min) o bus. Villa Romana di Minori (gratuita).', transport: 'walk' },
  { time: '16:00', place: 'Minori → Vietri sul Mare', action: 'Bus SITA per Vietri (~30 min). Ceramiche, Museo della Ceramica, passeggiata.', transport: 'bus' },
  { time: '17:30', place: 'Vietri → Salerno', action: 'Bus per Salerno (15 min) o a piedi lungo la costa (45 min panoramici)', transport: 'bus' },
];

const tips = [
  'Salerno è collegata a Napoli e Roma in treno ad alta velocità: ottimo punto di partenza.',
  'Il traghetto Travelmar da Salerno è panoramico e arriva ad Amalfi senza percorrere la SS163.',
  'La parte est della Costiera (Maiori, Minori, Vietri) è molto meno affollata di Positano.',
  'Vietri sul Mare è la capitale italiana delle ceramiche: ottima per souvenir di qualità.',
  'In bassa stagione il bus SITA è l\'unica opzione (traghetto sospeso): parte da Piazza della Concordia.',
];

const transportBadge: Record<string, { label: string; cls: string }> = {
  train: { label: 'TRENO', cls: 'bg-orange-100 text-orange-700' },
  ferry: { label: 'NAVE', cls: 'bg-blue-100 text-blue-700' },
  bus:   { label: 'BUS', cls: 'bg-green-100 text-green-700' },
  walk:  { label: 'PIEDI', cls: 'bg-gray-100 text-slate-500' },
  visit: { label: '', cls: '' },
};

const destinationHighlights = [
  { name: 'Amalfi', desc: '', url: '/it-it/costiera-amalfitana/amalfi/' },
  { name: 'Maiori', desc: '', url: '/it-it/costiera-amalfitana/maiori/' },
  { name: 'Minori', desc: '', url: '/it-it/costiera-amalfitana/minori/' },
  { name: 'Vietri', desc: '', url: '/it-it/costiera-amalfitana/vietri-sul-mare/' },
];
---

<BaseLayout
  title="Costiera Amalfitana da Salerno in Un Giorno 2026 | Amalfi, Maiori, Vietri"
  description="Itinerario di un giorno da Salerno: Amalfi, Maiori, Minori, Vietri sul Mare. Traghetto, ceramiche, lungomare."
  lang={lang}
  breadcrumbs={breadcrumbs}
  schema={[faqSchema]}
>

  <!-- Hero Section -->
  <section class="relative bg-charcoal overflow-hidden min-h-[70vh] sm:min-h-[75vh] flex items-center justify-center">
    <img src="/images/costiera-hero.jpg" alt="Grand Tour Costiera Amalfitana" class="absolute inset-0 w-full h-full object-cover opacity-30" loading="eager" referrerpolicy="no-referrer"/>
    <div class="absolute inset-0 bg-gradient-to-b from-black/20 via-black/40 to-black/80"></div>
    <div class="relative max-w-editorial mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <div class="max-w-3xl mx-auto">
        <p class="text-med-gold text-xs sm:text-sm font-medium uppercase tracking-[0.3em] mb-3">Itinerario · 1 giorno</p>
        <h1 class="font-serif text-display text-white mb-4">Costiera Amalfitana da Salerno</h1>
        <p class="text-xl text-white/80 leading-relaxed max-w-2xl mx-auto">
          La parte est della Costiera: Amalfi, Maiori, Minori e Vietri sul Mare. Traghetto, ceramiche, lungomare tranquillo e meno affollato.
        </p>
      </div>
    </div>
    <Breadcrumbs breadcrumbs={breadcrumbs} />
  </section>

  <div class="max-w-editorial mx-auto px-4 sm:px-6 lg:px-8 pt-6 pb-10 space-y-10">

    <!-- Intro & Stats Section - Featured -->
    <section class="text-center mb-2">
      <!-- Quick Stats Grid - Scrollable on Mobile -->
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-2 sm:gap-4 mb-6 overflow-x-auto snap-x snap-mandatory sm:overflow-visible pb-2 sm:pb-0">
        <div class="w-full bg-slate-900 rounded-2xl p-4 sm:p-6 hover:shadow-md transition-shadow flex flex-col items-center justify-center aspect-square snap-start">
          <svg class="w-8 h-8 text-med-gold mb-3" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
            <rect x="3" y="4" width="18" height="18" rx="2"/>
            <path d="M16 2v4M8 2v4M3 10h18"/>
          </svg>
          <p class="text-xs text-white/60 font-semibold uppercase tracking-wide mb-2">Durata</p>
          <p class="font-serif text-lg font-semibold text-med-gold">1 giorno</p>
        </div>
        <div class="w-full bg-slate-900 rounded-2xl p-4 sm:p-6 hover:shadow-md transition-shadow flex flex-col items-center justify-center aspect-square snap-start">
          <svg class="w-8 h-8 text-med-gold mb-3" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
            <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/>
            <circle cx="12" cy="10" r="3"/>
          </svg>
          <p class="text-xs text-white/60 font-semibold uppercase tracking-wide mb-2">Base</p>
          <p class="font-serif text-lg font-semibold text-med-gold">Salerno</p>
        </div>
        <div class="w-full bg-slate-900 rounded-2xl p-4 sm:p-6 hover:shadow-md transition-shadow flex flex-col items-center justify-center aspect-square snap-start">
          <svg class="w-8 h-8 text-med-gold mb-3" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
            <path d="M6 9l6-6 6 6M5 9v9a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V9M9 14h6"/>
          </svg>
          <p class="text-xs text-white/60 font-semibold uppercase tracking-wide mb-2">Trasporti</p>
          <p class="font-serif text-lg font-semibold text-med-gold">Traghetto<br/>+ bus locale</p>
        </div>
        <div class="w-full bg-slate-900 rounded-2xl p-4 sm:p-6 hover:shadow-md transition-shadow flex flex-col items-center justify-center aspect-square snap-start">
          <svg class="w-8 h-8 text-med-gold mb-3" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
            <circle cx="12" cy="12" r="1"/>
            <path d="M12 1v6M12 17v6M4.22 4.22l4.24 4.24M15.54 15.54l4.24 4.24M1 12h6M17 12h6M4.22 19.78l4.24-4.24M15.54 8.46l4.24-4.24"/>
          </svg>
          <p class="text-xs text-white/60 font-semibold uppercase tracking-wide mb-2">Budget trasporti</p>
          <p class="font-serif text-lg font-semibold text-med-gold">€12–15<br/><span class="text-xs">p.p.</span></p>
        </div>
      </div>

      <!-- SEO Text Below -->
      <div>
        <p class="text-lg text-slate-700 leading-relaxed">
          Scopri la <strong>parte est della Costiera Amalfitana</strong> da Salerno in una giornata: <strong>Amalfi</strong> con il suo Duomo, poi <strong>Maiori</strong> e <strong>Minori</strong> sul lungomare tranquillo, infine <strong>Vietri sul Mare</strong> con le sue ceramiche artigianali. Meno affollata di Positano, più autentica. <strong>Budget trasporti: €12–15</strong>.
        </p>
      </div>
    </section>


    <!-- Day by Day Itinerary -->
    <section>
      <h2 class="font-serif text-2xl font-semibold text-slate-900 mb-8">Programma della giornata</h2>
      <div class="bg-white border border-slate-200 rounded-2xl overflow-hidden">
        <div class="px-6 py-8 space-y-6">
          {schedule.map((item, idx) => {
            const badge = transportBadge[item.transport];
            const isLastItem = idx === schedule.length - 1;
            return (
              <div class="flex gap-4">
                <div class="flex flex-col items-center flex-shrink-0">
                  <div class="w-16 bg-slate-900 text-med-gold rounded-full px-2 py-1 text-center text-sm font-semibold flex items-center justify-center">
                    {item.time}
                  </div>
                  {!isLastItem && <div class="w-0.5 h-12 bg-med-blue/30 mt-2"></div>}
                </div>
                <div class="pb-4 flex-1">
                  <p class="font-semibold text-slate-900 mb-1">{item.place}</p>
                  <p class="text-slate-700 text-sm mb-2">{item.action}</p>
                  {badge.label && (
                    <span class={`text-xs font-semibold px-2 py-1 rounded-full ${badge.cls}`}>
                      {badge.label}
                    </span>
                  )}
                </div>
              </div>
            );
          })}
        </div>
      </div>
    </section>

    <!-- Destinations Highlighted -->
    <section>
      <h2 class="font-serif text-2xl font-semibold text-slate-900 mb-8">Le destinazioni dell'itinerario</h2>
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4">
        {destinationHighlights.map((dest) => (
          <a href={dest.url} class="group block bg-white border border-slate-200 rounded-2xl p-5 hover:shadow-lg hover:border-med-blue/30 transition-all">
            <h3 class="font-semibold text-charcoal mb-2 group-hover:text-med-blue transition-colors">{dest.name}</h3>
            <p class="text-xs text-slate-500 leading-relaxed mb-3">{dest.desc}</p>
            <span class="text-xs font-semibold text-med-blue inline-flex items-center gap-1 group-hover:gap-2 transition-all">
              Scopri →
            </span>
          </a>
        ))}
      </div>
    </section>

    <!-- Planning Tips -->
    <section class="bg-med-cream border border-med-gold/20 rounded-[2rem] p-6">
      <h2 class="font-serif text-xl font-semibold text-charcoal mb-6">Consigli pratici</h2>
      <ul class="space-y-4">
        {tips.map((text, idx) => {
          const nums = ['❶', '❷', '❸', '❹', '❺'];
          return (
            <li class="flex items-start gap-4 text-sm text-charcoal">
              <span class="text-2xl font-bold text-white flex-shrink-0 leading-none mt-0.5 bg-[#E2725B] w-9 h-9 flex items-center justify-center rounded-full">{nums[idx] || '•'}</span>
              <span class="leading-relaxed">{text}</span>
            </li>
          );
        })}
      </ul>
    </section>

    <!-- FAQ -->
    <section id="faq">
      <h2 class="font-serif text-2xl font-semibold text-slate-900 mb-6">Domande frequenti</h2>
      <div class="space-y-4">
        {faqSchema.mainEntity.map((q) => (
          <details class="group border border-slate-200 rounded-2xl overflow-hidden">
            <summary class="flex items-center justify-between px-6 py-4 cursor-pointer select-none text-charcoal font-medium hover:bg-slate-50 transition-colors">
              {q.name}
              <svg class="w-4 h-4 text-slate-400 group-open:rotate-180 transition-transform flex-shrink-0 ml-3" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
            </summary>
            <div class="px-6 pb-5 text-slate-600 leading-relaxed text-sm border-t border-slate-100 pt-4">
              {q.acceptedAnswer.text}
            </div>
          </details>
        ))}
      </div>
    </section>

    <!-- CTA -->
    <section class="bg-gradient-to-r from-med-blue to-med-blue/80 rounded-2xl p-10 text-center text-white">
      <h2 class="font-serif text-3xl font-bold mb-3">Scopri la Costiera da Salerno</h2>
      <p class="text-white/90 mb-6 max-w-2xl mx-auto">
        Guida completa ai trasporti: traghetto Travelmar, bus SITA, orari e consigli per risparmiare.
      </p>
      <a href="/it-it/guida/traghetti/" class="inline-block bg-white text-med-blue font-semibold px-8 py-3 rounded-full hover:bg-slate-100 transition-colors">
        Guida ai traghetti →
      </a>
    </section>

  </div>

</BaseLayout>
