---
import BaseLayout from '../../../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../../../components/Breadcrumbs.astro';

const lang = 'it-it';

const breadcrumbs = [
  { name: 'Home', url: '/it-it/' },
  { name: 'Pianificazione', url: '/it-it/pianificazione/' },
  { name: 'Capri da Sorrento', url: '/it-it/itinerari/1-giorno/capri-da-sorrento/' },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Quanto tempo ci vuole da Sorrento a Capri in aliscafo?",
      "acceptedAnswer": { "@type": "Answer", "text": "L'aliscafo da Sorrento (Marina Piccola) a Capri (Marina Grande) impiega circa 20-25 minuti. Le compagnie principali sono NLG e Alilauro. In estate le corse partono ogni 30-60 min dalle 7:00 alle 20:00. Il biglietto A/R costa ~€18-22." }
    },
    {
      "@type": "Question",
      "name": "È possibile vedere la Grotta Azzurra in un giorno da Sorrento?",
      "acceptedAnswer": { "@type": "Answer", "text": "Sì, ma richiede un'organizzazione precisa. Prendi il primo aliscafo da Sorrento (7:30-8:00), arriva a Capri e vai subito alla Grotta Azzurra prima della folla (meglio prima delle 10:00). Poi esplori Capri e Anacapri nel pomeriggio. Rientro a Sorrento con l'ultimo aliscafo (intorno alle 18:30-19:00)." }
    },
    {
      "@type": "Question",
      "name": "Capri vs Anacapri: quale visitare in un giorno?",
      "acceptedAnswer": { "@type": "Answer", "text": "Entrambe meritano, ma con un solo giorno scegli in base agli interessi: Capri città è più chic, piena di negozi e con i Faraglioni. Anacapri è più tranquilla, con Villa San Michele e la seggiovia per Monte Solaro (589 m). Una buona giornata include mattina alla Grotta Azzurra, pranzo ad Anacapri, pomeriggio a Capri e Faraglioni." }
    }
  ]
};

const schedule = [
  { time: '07:30', place: 'Sorrento, Marina Piccola', action: 'Aliscafo NLG/Alilauro per Capri (20-25 min, ~€9-11)', transport: 'ferry' },
  { time: '08:00', place: 'Capri, Marina Grande', action: 'Bus per Grotta Azzurra (20 min, ~€2). Arriva prima delle 10 per evitare code.', transport: 'bus' },
  { time: '08:30', place: 'Grotta Azzurra', action: 'Barchetta a remi nella grotta (€15 + ingresso €14). Attesa variabile.', transport: 'ferry' },
  { time: '10:00', place: 'Anacapri', action: 'Bus da Capri per Anacapri (15 min). Villa San Michele (~€7). Seggiovia Monte Solaro (589 m, ~€13 A/R).', transport: 'bus' },
  { time: '12:30', place: 'Anacapri', action: 'Pranzo in trattoria locale (meno cara di Capri centro)', transport: 'visit' },
  { time: '14:00', place: 'Capri centro', action: 'Bus per Capri. Piazzetta, Via Camerelle, Giardini di Augusto, Faraglioni vista.', transport: 'bus' },
  { time: '16:00', place: 'Marina Grande', action: 'Giro in barchetta attorno ai Faraglioni (~€18-25 p.p., 1-2h)', transport: 'ferry' },
  { time: '18:00', place: 'Capri → Sorrento', action: 'Aliscafo di rientro per Sorrento (20-25 min)', transport: 'ferry' },
];

const tips = [
  'Grotta Azzurra: prima delle 10:00 è quasi senza coda. Dopo le 11 l\'attesa può essere 1-2 ore.',
  'In luglio-agosto prenota l\'aliscafo online il giorno prima: le prime corse si esauriscono.',
  'Capri è cara: pranzo ad Anacapri costa il 30-40% meno che in Piazzetta.',
  'La seggiovia per Monte Solaro da Anacapri è imperdibile: 589 m, vista 360° su Costiera e Napoli.',
  'L\'aliscafo non parte con mare mosso: controlla il meteo marino e tieni un piano B.',
];

const transportBadge: Record<string, { label: string; cls: string }> = {
  train: { label: 'TRENO', cls: 'bg-orange-100 text-orange-700' },
  ferry: { label: 'NAVE', cls: 'bg-blue-100 text-blue-700' },
  bus:   { label: 'BUS', cls: 'bg-green-100 text-green-700' },
  walk:  { label: 'PIEDI', cls: 'bg-gray-100 text-slate-500' },
  visit: { label: '', cls: '' },
};

const destinationHighlights = [
  { name: 'Capri', desc: 'Isola con Grotta Azzurra, Anacapri, Faraglioni, Monte Solaro', url: '/it-it/isole/capri/' },
  { name: 'Marina Piccola Capri', desc: 'Spiaggia esclusiva con vista dei Faraglioni', url: '/it-it/spiagge/isole/marina-piccola-capri/' },
];
---

<BaseLayout
  title="Capri da Sorrento in Un Giorno 2026 | Grotta Azzurra, Anacapri, Faraglioni"
  description="Itinerario di un giorno da Sorrento a Capri: Grotta Azzurra, Anacapri, Monte Solaro, Faraglioni. Aliscafo, orari, prezzi e consigli pratici."
  lang={lang}
  breadcrumbs={breadcrumbs}
  schema={[faqSchema]}
>

  <!-- Hero Section -->
  <section class="relative bg-charcoal overflow-hidden min-h-[70vh] sm:min-h-[75vh] flex items-center justify-center">
    <img src="/images/costiera-hero.jpg" alt="Grand Tour Costiera Amalfitana" class="absolute inset-0 w-full h-full object-cover opacity-30" loading="eager" referrerpolicy="no-referrer"/>
    <div class="absolute inset-0 bg-gradient-to-b from-black/20 via-black/40 to-black/80"></div>
    <div class="relative max-w-editorial mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <div class="max-w-3xl mx-auto">
        <p class="text-med-gold text-xs sm:text-sm font-medium uppercase tracking-[0.3em] mb-3">Itinerario · 1 giorno</p>
        <h1 class="font-serif text-display text-white mb-4">Capri da Sorrento</h1>
        <p class="text-xl text-white/80 leading-relaxed max-w-2xl mx-auto">
          Grotta Azzurra, Anacapri e Faraglioni in un giorno partendo da Sorrento. Aliscafo, Monte Solaro e la Piazzetta caprese.
        </p>
      </div>
    </div>
    <Breadcrumbs breadcrumbs={breadcrumbs} />
  </section>

  <div class="max-w-editorial mx-auto px-4 sm:px-6 lg:px-8 pt-6 pb-10 space-y-10">

    <!-- Intro & Stats Section - Featured -->
    <section class="text-center mb-2">
      <!-- Quick Stats Grid - Scrollable on Mobile -->
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-2 sm:gap-4 mb-6 overflow-x-auto snap-x snap-mandatory sm:overflow-visible pb-2 sm:pb-0">
        <div class="w-full bg-slate-900 rounded-2xl p-4 sm:p-6 hover:shadow-md transition-shadow flex flex-col items-center justify-center aspect-square snap-start">
          <svg class="w-8 h-8 text-med-gold mb-3" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
            <rect x="3" y="4" width="18" height="18" rx="2"/>
            <path d="M16 2v4M8 2v4M3 10h18"/>
          </svg>
          <p class="text-xs text-white/60 font-semibold uppercase tracking-wide mb-2">Durata</p>
          <p class="font-serif text-lg font-semibold text-med-gold">1 giorno</p>
        </div>
        <div class="w-full bg-slate-900 rounded-2xl p-4 sm:p-6 hover:shadow-md transition-shadow flex flex-col items-center justify-center aspect-square snap-start">
          <svg class="w-8 h-8 text-med-gold mb-3" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
            <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/>
            <circle cx="12" cy="10" r="3"/>
          </svg>
          <p class="text-xs text-white/60 font-semibold uppercase tracking-wide mb-2">Base</p>
          <p class="font-serif text-lg font-semibold text-med-gold">Sorrento</p>
        </div>
        <div class="w-full bg-slate-900 rounded-2xl p-4 sm:p-6 hover:shadow-md transition-shadow flex flex-col items-center justify-center aspect-square snap-start">
          <svg class="w-8 h-8 text-med-gold mb-3" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
            <path d="M6 9l6-6 6 6M5 9v9a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V9M9 14h6"/>
          </svg>
          <p class="text-xs text-white/60 font-semibold uppercase tracking-wide mb-2">Trasporti</p>
          <p class="font-serif text-lg font-semibold text-med-gold">Aliscafo<br/>+ bus locale</p>
        </div>
        <div class="w-full bg-slate-900 rounded-2xl p-4 sm:p-6 hover:shadow-md transition-shadow flex flex-col items-center justify-center aspect-square snap-start">
          <svg class="w-8 h-8 text-med-gold mb-3" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
            <circle cx="12" cy="12" r="1"/>
            <path d="M12 1v6M12 17v6M4.22 4.22l4.24 4.24M15.54 15.54l4.24 4.24M1 12h6M17 12h6M4.22 19.78l4.24-4.24M15.54 8.46l4.24-4.24"/>
          </svg>
          <p class="text-xs text-white/60 font-semibold uppercase tracking-wide mb-2">Budget trasporti</p>
          <p class="font-serif text-lg font-semibold text-med-gold">€40–50<br/><span class="text-xs">p.p.</span></p>
        </div>
      </div>

      <!-- SEO Text Below -->
      <div>
        <p class="text-lg text-slate-700 leading-relaxed">
          Una <strong>giornata perfetta a Capri</strong> da Sorrento: prendi il primo <strong>aliscafo</strong> (20-25 min) e arriva subito alla <strong>Grotta Azzurra</strong>, l'iconica caverna marina. Nel pomeriggio esplora <strong>Anacapri</strong> con Villa San Michele e Monte Solaro, poi ritorna a <strong>Capri centro</strong> per i <strong>Faraglioni</strong> e un giro in barca. Rientro entro sera. <strong>Budget trasporti: €40–50</strong>.
        </p>
      </div>
    </section>


    <!-- Day by Day Itinerary -->
    <section>
      <h2 class="font-serif text-2xl font-semibold text-slate-900 mb-8">Programma della giornata</h2>
      <div class="bg-white border border-slate-200 rounded-2xl overflow-hidden">
        <div class="px-6 py-8 space-y-6">
          {schedule.map((item, idx) => {
            const badge = transportBadge[item.transport];
            const isLastItem = idx === schedule.length - 1;
            return (
              <div class="flex gap-4">
                <div class="flex flex-col items-center flex-shrink-0">
                  <div class="w-16 bg-slate-900 text-med-gold rounded-full px-2 py-1 text-center text-sm font-semibold flex items-center justify-center">
                    {item.time}
                  </div>
                  {!isLastItem && <div class="w-0.5 h-12 bg-med-blue/30 mt-2"></div>}
                </div>
                <div class="pb-4 flex-1">
                  <p class="font-semibold text-slate-900 mb-1">{item.place}</p>
                  <p class="text-slate-700 text-sm mb-2">{item.action}</p>
                  {badge.label && (
                    <span class={`text-xs font-semibold px-2 py-1 rounded-full ${badge.cls}`}>
                      {badge.label}
                    </span>
                  )}
                </div>
              </div>
            );
          })}
        </div>
      </div>
    </section>

    <!-- Destinations Highlighted -->
    <section>
      <h2 class="font-serif text-2xl font-semibold text-slate-900 mb-8">Le destinazioni dell'itinerario</h2>
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4">
        {destinationHighlights.map((dest) => (
          <a href={dest.url} class="group block bg-white border border-slate-200 rounded-2xl p-5 hover:shadow-lg hover:border-med-blue/30 transition-all">
            <h3 class="font-semibold text-charcoal mb-2 group-hover:text-med-blue transition-colors">{dest.name}</h3>
            <p class="text-xs text-slate-500 leading-relaxed mb-3">{dest.desc}</p>
            <span class="text-xs font-semibold text-med-blue inline-flex items-center gap-1 group-hover:gap-2 transition-all">
              Scopri →
            </span>
          </a>
        ))}
      </div>
    </section>

    <!-- Planning Tips -->
    <section class="bg-med-cream border border-med-gold/20 rounded-[2rem] p-6">
      <h2 class="font-serif text-xl font-semibold text-charcoal mb-6">Consigli pratici</h2>
      <ul class="space-y-4">
        {tips.map((text, idx) => {
          const nums = ['❶', '❷', '❸', '❹', '❺'];
          return (
            <li class="flex items-start gap-4 text-sm text-charcoal">
              <span class="text-2xl font-bold text-white flex-shrink-0 leading-none mt-0.5 bg-[#E2725B] w-9 h-9 flex items-center justify-center rounded-full">{nums[idx] || '•'}</span>
              <span class="leading-relaxed">{text}</span>
            </li>
          );
        })}
      </ul>
    </section>

    <!-- FAQ -->
    <section id="faq">
      <h2 class="font-serif text-2xl font-semibold text-slate-900 mb-6">Domande frequenti</h2>
      <div class="space-y-4">
        {faqSchema.mainEntity.map((q) => (
          <details class="group border border-slate-200 rounded-2xl overflow-hidden">
            <summary class="flex items-center justify-between px-6 py-4 cursor-pointer select-none text-charcoal font-medium hover:bg-slate-50 transition-colors">
              {q.name}
              <svg class="w-4 h-4 text-slate-400 group-open:rotate-180 transition-transform flex-shrink-0 ml-3" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
            </summary>
            <div class="px-6 pb-5 text-slate-600 leading-relaxed text-sm border-t border-slate-100 pt-4">
              {q.acceptedAnswer.text}
            </div>
          </details>
        ))}
      </div>
    </section>

    <!-- CTA -->
    <section class="bg-gradient-to-r from-med-blue to-med-blue/80 rounded-2xl p-10 text-center text-white">
      <h2 class="font-serif text-3xl font-bold mb-3">Vedi tutte le opzioni di trasporto</h2>
      <p class="text-white/90 mb-6 max-w-2xl mx-auto">
        Leggi la guida completa su aliscafi, traghetti e orari: come arrivare da Sorrento a Capri, biglietti e prenotazioni.
      </p>
      <a href="/it-it/guida/traghetti/" class="inline-block bg-white text-med-blue font-semibold px-8 py-3 rounded-full hover:bg-slate-100 transition-colors">
        Guida ai traghetti →
      </a>
    </section>

  </div>

</BaseLayout>
