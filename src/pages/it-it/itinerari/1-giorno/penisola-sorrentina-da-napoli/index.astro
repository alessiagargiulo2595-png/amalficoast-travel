---
import BaseLayout from '../../../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../../../components/Breadcrumbs.astro';

const lang = 'it-it';

const breadcrumbs = [
  { name: 'Home', url: '/it-it/' },
  { name: 'Itinerari', url: '/it-it/itinerari/' },
  { name: 'Penisola Sorrentina da Napoli', url: '/it-it/itinerari/1-giorno/penisola-sorrentina-da-napoli/' },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Come arrivare a Sorrento da Napoli?",
      "acceptedAnswer": { "@type": "Answer", "text": "Il modo più semplice è la Circumvesuviana: treno da Napoli Porta Nolana o Piazza Garibaldi fino a Sorrento (70 min, ~€3.90). Corse ogni 30-40 min. In alternativa, aliscafo da Napoli Beverello (Alilauro/NLG, ~60 min, ~€15) ma il prezzo è più alto." }
    },
    {
      "@type": "Question",
      "name": "Cosa vedere nella Penisola Sorrentina in un giorno?",
      "acceptedAnswer": { "@type": "Answer", "text": "Da Sorrento: il centro storico e il Vallone dei Mulini (30 min), poi bus per Massa Lubrense (20 min) con vista su Capri e il Golfo. Sant'Agata sui Due Golfi offre uno dei panorami più belli della zona. Punta Campanella è raggiungibile a piedi (sentiero 6 km A/R, 2.5h)." }
    }
  ]
};

const schedule = [
  { time: '08:00', place: 'Napoli Porta Nolana', action: 'Circumvesuviana per Sorrento (70 min, ~€3.90)', transport: 'train' },
  { time: '09:15', place: 'Sorrento', action: 'Centro storico, Piazza Tasso, Vallone dei Mulini, negozi di limoncello (1.5h)', transport: 'visit' },
  { time: '11:00', place: 'Sorrento → Massa Lubrense', action: 'Bus SITA per Massa Lubrense (20 min, ~€1.50). Panorama su Capri.', transport: 'bus' },
  { time: '12:00', place: 'Massa Lubrense', action: 'Pranzo in trattoria locale. Vista doppio golfo da Punta Campanella.', transport: 'visit' },
  { time: '13:30', place: 'Sant\'Agata sui Due Golfi', action: 'Bus o taxi (15 min). Belvedere del Deserto (panorama Golfo di Napoli + Salerno).', transport: 'bus' },
  { time: '15:00', place: 'Sant\'Agata → Sorrento', action: 'Bus di rientro per Sorrento (30 min). Tempo libero sul porto.', transport: 'bus' },
  { time: '16:30', place: 'Sorrento', action: 'Marina Piccola, passeggiata, aperitivo con vista Vesuvio', transport: 'visit' },
  { time: '18:00', place: 'Sorrento → Napoli', action: 'Circumvesuviana per Napoli (70 min)', transport: 'train' },
];

const tips = [
  'La Circumvesuviana è economica ma lenta e spesso sovraffollata in estate: tieni d\'occhio il bagaglio.',
  'Sant\'Agata sui Due Golfi: dal belvedere si vedono sia il Golfo di Napoli che quello di Salerno.',
  'Massa Lubrense è ideale per un pranzo economico con pescato del giorno: meno turistica di Sorrento.',
  'Se vuoi fare il sentiero di Punta Campanella (6 km A/R), parti da Massa Lubrense entro le 10:00.',
  'Il limoncello di Sorrento si produce con i limoni IGP della zona: acquistalo nei negozi locali.',
];

const transportBadge: Record<string, { label: string; cls: string }> = {
  train: { label: 'TRENO', cls: 'bg-orange-100 text-orange-700' },
  ferry: { label: 'NAVE', cls: 'bg-blue-100 text-blue-700' },
  bus:   { label: 'BUS', cls: 'bg-green-100 text-green-700' },
  walk:  { label: 'PIEDI', cls: 'bg-gray-100 text-slate-500' },
  visit: { label: '', cls: '' },
};
---

<BaseLayout
  title="Penisola Sorrentina da Napoli in Un Giorno 2026 | Sorrento, Massa Lubrense, Sant'Agata"
  description="Itinerario di un giorno da Napoli alla Penisola Sorrentina: Sorrento, Massa Lubrense, Sant'Agata sui Due Golfi. Circumvesuviana, doppio golfo."
  lang={lang}
  breadcrumbs={breadcrumbs}
  schema={[faqSchema]}
>

  <!-- Hero Section -->
  <section class="relative bg-charcoal overflow-hidden min-h-[65vh] sm:min-h-[75vh] flex items-center justify-center">
    <img src="/images/costiera-hero.jpg" alt="Grand Tour Costiera Amalfitana" class="absolute inset-0 w-full h-full object-cover opacity-30" loading="eager" referrerpolicy="no-referrer"/>
    <div class="absolute inset-0 bg-gradient-to-b from-black/20 via-black/40 to-black/80"></div>
    <div class="relative max-w-editorial mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <div class="max-w-3xl mx-auto">
        <p class="text-med-gold text-xs sm:text-sm font-medium uppercase tracking-[0.3em] mb-3">Itinerario · 7 giorni</p>
        <h1 class="font-serif text-display text-white mb-4">Grand Tour Costiera & Penisola</h1>
        <p class="text-xl text-white/80 leading-relaxed max-w-2xl mx-auto">
          Una settimana tra Napoli, Costiera Amalfitana, Penisola Sorrentina, Capri e isole del Golfo. Il percorso classico del Sud Italia senza fretta.
        </p>
      </div>
    </div>
    <Breadcrumbs breadcrumbs={breadcrumbs} />
  </section>

  <div class="max-w-editorial mx-auto px-4 sm:px-6 lg:px-8 pt-6 pb-10 space-y-10">

    <!-- Intro & Stats Section - Featured -->
    <section class="text-center mb-2">
      <!-- Quick Stats Grid - Scrollable on Mobile -->
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 mb-6 overflow-x-auto snap-x snap-mandatory sm:overflow-visible pb-2 sm:pb-0">
        <div class="bg-slate-900 rounded-2xl p-6 hover:shadow-md transition-shadow flex flex-col items-center justify-center aspect-square snap-start">
          <svg class="w-8 h-8 text-med-gold mb-3" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
            <rect x="3" y="4" width="18" height="18" rx="2"/>
            <path d="M16 2v4M8 2v4M3 10h18"/>
          </svg>
          <p class="text-xs text-white/60 font-semibold uppercase tracking-wide mb-2">Durata</p>
          <p class="font-serif text-lg font-semibold text-med-gold">7 giorni<br/>6 notti</p>
        </div>
        <div class="bg-slate-900 rounded-2xl p-6 hover:shadow-md transition-shadow flex flex-col items-center justify-center aspect-square snap-start">
          <svg class="w-8 h-8 text-med-gold mb-3" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
            <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/>
            <circle cx="12" cy="10" r="3"/>
          </svg>
          <p class="text-xs text-white/60 font-semibold uppercase tracking-wide mb-2">Basi</p>
          <p class="font-serif text-lg font-semibold text-med-gold">Napoli +<br/>Amalfi/Sorrento</p>
        </div>
        <div class="bg-slate-900 rounded-2xl p-6 hover:shadow-md transition-shadow flex flex-col items-center justify-center aspect-square snap-start">
          <svg class="w-8 h-8 text-med-gold mb-3" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
            <path d="M6 9l6-6 6 6M5 9v9a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V9M9 14h6"/>
          </svg>
          <p class="text-xs text-white/60 font-semibold uppercase tracking-wide mb-2">Trasporti</p>
          <p class="font-serif text-lg font-semibold text-med-gold">Treno + bus<br/>+ aliscafi</p>
        </div>
        <div class="bg-slate-900 rounded-2xl p-6 hover:shadow-md transition-shadow flex flex-col items-center justify-center aspect-square snap-start">
          <svg class="w-8 h-8 text-med-gold mb-3" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
            <circle cx="12" cy="12" r="1"/>
            <path d="M12 1v6M12 17v6M4.22 4.22l4.24 4.24M15.54 15.54l4.24 4.24M1 12h6M17 12h6M4.22 19.78l4.24-4.24M15.54 8.46l4.24-4.24"/>
          </svg>
          <p class="text-xs text-white/60 font-semibold uppercase tracking-wide mb-2">Budget trasporti</p>
          <p class="font-serif text-lg font-semibold text-med-gold">€80–120<br/><span class="text-xs">p.p.</span></p>
        </div>
      </div>

      <!-- SEO Text Below -->
      <div>
        <p class="text-lg text-slate-700 leading-relaxed">
          Il <strong>Grand Tour di 7 giorni</strong> è il percorso classico del Sud Italia: combina due giorni a <strong>Napoli</strong>, la straordinaria <strong>Costiera Amalfitana</strong> con Positano, Amalfi e Ravello, la <strong>Penisola Sorrentina</strong>, <strong>Capri</strong> con la Grotta Azzurra, e le <strong>isole del Golfo</strong>. Tutto con trasporto pubblico. <strong>Budget trasporti: €80–120</strong>.
        </p>
      </div>
    </section>


    <!-- Day by Day Itinerary -->
    <section>
      <h2 class="font-serif text-2xl font-semibold text-slate-900 mb-8">Il programma giorno per giorno</h2>
      <div class="space-y-6">
        {days.map((d, idx) => (
          <div class="bg-white border border-slate-200 rounded-2xl overflow-hidden hover:shadow-md transition-shadow">
            <div class="bg-slate-900 px-6 py-6 flex items-start gap-4 sm:items-center sm:gap-3">
              <span class="text-[10px] uppercase tracking-wide bg-white/15 text-white px-3 py-1.5 rounded-full font-bold flex-shrink-0">{d.day}</span>
              <div class="flex-1 min-w-0">
                <h3 class="font-serif font-semibold text-white text-lg">{d.title}</h3>
                <p class="text-xs text-med-gold mt-1 font-medium">{d.highlight}</p>
              </div>
            </div>
            <ul class="px-6 py-5 space-y-3">
              {d.items.map((item, itemIdx) => {
                const isLocalTip = item.includes('Local tip:');
                const displayText = item.replace('Local tip: ', '');
                const isLastItem = itemIdx === d.items.length - 1;
                return (
                  <li key={itemIdx} class={`flex gap-3 text-sm relative ${isLocalTip ? 'bg-med-gold/10 p-3 rounded-lg border border-med-gold/20' : ''}`}>
                    <div class="flex flex-col items-center">
                      {isLocalTip ? (
                        <svg class="w-5 h-5 text-med-gold flex-shrink-0 self-center" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
                          <circle cx="12" cy="8" r="5"/>
                          <path d="M12 13v2"/>
                          <rect x="10" y="15" width="4" height="3" rx="0.5"/>
                        </svg>
                      ) : (
                        <span class="w-2 h-2 rounded-full bg-med-blue flex-shrink-0"></span>
                      )}
                      {!isLastItem && <div class="w-0.5 h-6 bg-med-blue/30 mt-1"></div>}
                    </div>
                    <span class={`leading-relaxed ${isLocalTip ? 'font-semibold text-slate-800' : 'text-slate-700'}`}>
                      {isLocalTip && <strong>Local tip: </strong>}
                      {displayText}
                    </span>
                  </li>
                );
              })}
            </ul>
          </div>
        ))}
      </div>
    </section>

    <!-- Destinations Highlighted -->
    <section>
      <h2 class="font-serif text-2xl font-semibold text-slate-900 mb-8">Le destinazioni dell'itinerario</h2>
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4">
        {destinationHighlights.map((dest) => (
          <a href={dest.url} class="group block bg-white border border-slate-200 rounded-2xl p-5 hover:shadow-lg hover:border-med-blue/30 transition-all">
            <h3 class="font-semibold text-charcoal mb-2 group-hover:text-med-blue transition-colors">{dest.name}</h3>
            <p class="text-xs text-slate-500 leading-relaxed mb-3">{dest.desc}</p>
            <span class="text-xs font-semibold text-med-blue inline-flex items-center gap-1 group-hover:gap-2 transition-all">
              Scopri →
            </span>
          </a>
        ))}
      </div>
    </section>

    <!-- Planning Tips -->
    <section class="bg-med-cream border border-med-gold/20 rounded-[2rem] p-6">
      <h2 class="font-serif text-xl font-semibold text-charcoal mb-6">Consigli pratici</h2>
      <ul class="space-y-4">
        {[
          { num: '❶', text: 'Campania Express: biglietto giornaliero Circumvesuviana ~€10 (valido Napoli-Sorrento-Pompei-Ercolano).' },
          { num: '❷', text: 'Prenota Capri e Grotta Azzurra con 1-2 giorni anticipo in luglio-agosto.' },
          { num: '❸', text: 'Base: 2 notti Napoli + 3 notti Amalfi/Sorrento + 1 notte isola.' },
          { num: '❹', text: 'Il giorno del tour in barca è flessibile: spostalo in base al meteo marino.' },
          { num: '❺', text: 'Scarpe comode per sampietrini napoletani e scalinate di Positano.' },
        ].map(({ num, text }) => (
          <li class="flex items-start gap-4 text-sm text-charcoal">
            <span class="text-2xl font-bold text-white flex-shrink-0 leading-none mt-0.5 bg-[#E2725B] w-9 h-9 flex items-center justify-center rounded-full">{num}</span>
            <span class="leading-relaxed">{text}</span>
          </li>
        ))}
      </ul>
    </section>

    <!-- FAQ -->
    <section id="faq">
      <h2 class="font-serif text-2xl font-semibold text-slate-900 mb-6">Domande frequenti</h2>
      <div class="space-y-4">
        {faqSchema.mainEntity.map((q) => (
          <details class="group border border-slate-200 rounded-2xl overflow-hidden">
            <summary class="flex items-center justify-between px-6 py-4 cursor-pointer select-none text-charcoal font-medium hover:bg-slate-50 transition-colors">
              {q.name}
              <svg class="w-4 h-4 text-slate-400 group-open:rotate-180 transition-transform flex-shrink-0 ml-3" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
            </summary>
            <div class="px-6 pb-5 text-slate-600 leading-relaxed text-sm border-t border-slate-100 pt-4">
              {q.acceptedAnswer.text}
            </div>
          </details>
        ))}
      </div>
    </section>

    <!-- CTA -->
    <section class="bg-gradient-to-r from-med-blue to-med-blue/80 rounded-2xl p-10 text-center text-white">
      <h2 class="font-serif text-3xl font-bold mb-3">Pronto a partire?</h2>
      <p class="text-white/90 mb-6 max-w-2xl mx-auto">
        Leggi la guida completa ai trasporti pubblici sulla Costiera: come arrivare, orari, biglietti e strategie per risparmiare.
      </p>
      <a href="/it-it/guida/come-arrivare/" class="inline-block bg-white text-med-blue font-semibold px-8 py-3 rounded-full hover:bg-slate-100 transition-colors">
        Guida ai trasporti →
      </a>
    </section>

  </div>

</BaseLayout>
