---
import BaseLayout from '../../../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../../../components/Breadcrumbs.astro';

const lang = 'it-it';

const breadcrumbs = [
  { name: 'Home', url: '/it-it/' },
  { name: 'Pianificazione', url: '/it-it/pianificazione/' },
  { name: '1 Giorno da Napoli', url: '/it-it/itinerari/1-giorno/costiera-amalfitana-da-napoli/' },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Come si arriva alla Costiera Amalfitana da Napoli in un giorno?",
      "acceptedAnswer": { "@type": "Answer", "text": "Il percorso più pratico è: treno Napoli→Salerno (40 min, Trenitalia/Italo), poi traghetto Travelmar Salerno→Amalfi (45 min, stagionale apr-ott) oppure bus SITA da Salerno. In alternativa, treno Napoli→Sorrento (Circumvesuviana, 70 min) e bus SITA Sorrento→Amalfi (90 min)." }
    },
    {
      "@type": "Question",
      "name": "Cosa vedere in un giorno sulla Costiera Amalfitana partendo da Napoli?",
      "acceptedAnswer": { "@type": "Answer", "text": "Con una giornata: arriva ad Amalfi (Duomo, centro storico, 2h), poi Ravello in bus (25 min, Villa Rufolo e panorami, 1.5h), poi torna ad Amalfi e prendi il bus per Positano (45 min, passeggiata e spiaggia, 1.5h). Tornate da Positano in bus o traghetto." }
    },
    {
      "@type": "Question",
      "name": "A che ora partire da Napoli per la Costiera Amalfitana?",
      "acceptedAnswer": { "@type": "Answer", "text": "Parti da Napoli entro le 7:30-8:00. Il treno delle 7:45 arriva a Salerno alle 8:25; il traghetto Travelmar parte intorno alle 9:00 e arriva ad Amalfi prima delle 10:00. Questo ti dà 8-9 ore di visita prima del rientro." }
    }
  ]
};

const destinations = [
  { name: 'Amalfi', url: '/it-it/costiera-amalfitana/amalfi/' },
  { name: 'Ravello', url: '/it-it/costiera-amalfitana/ravello/' },
  { name: 'Positano', url: '/it-it/costiera-amalfitana/positano/' },
  { name: 'Spiaggia Grande Positano', url: '/it-it/spiagge/costiera-amalfitana/spiaggia-grande-positano/' },
  { name: 'Praiano', url: '/it-it/costiera-amalfitana/praiano/' },
  { name: 'Sorrento', url: '/it-it/penisola-sorrentina/sorrento/' },
];

const destinationHighlights = destinations.map(d => ({ name: d.name, desc: '', url: d.url }));

const schedule = [
  { time: '07:45', place: 'Napoli Centrale', action: 'Treno per <span class="text-med-blue font-medium">Salerno</span> (Trenitalia/Italo, 40 min, ~€5-12)', transport: 'train' },
  { time: '09:00', place: 'Salerno', action: 'Traghetto Travelmar per <a href="/it-it/costiera-amalfitana/amalfi/" class="text-med-blue hover:underline font-medium">Amalfi</a> (45 min, ~€8, stagionale apr-ott)', transport: 'ferry' },
  { time: '09:45', place: 'Amalfi', action: 'Duomo di Sant\'Andrea, Chiostro del Paradiso, corso e centro storico (2h)', transport: 'visit' },
  { time: '12:00', place: 'Amalfi → Ravello', action: 'Bus SITA locale per <a href="/it-it/costiera-amalfitana/ravello/" class="text-med-blue hover:underline font-medium">Ravello</a> (25 min, ~€1.50). Pranzo in piazza.', transport: 'bus' },
  { time: '13:30', place: 'Ravello', action: 'Villa Rufolo, belvedere, Villa Cimbrone (1.5h)', transport: 'visit' },
  { time: '15:15', place: 'Ravello → Amalfi → Positano', action: 'Bus per <a href="/it-it/costiera-amalfitana/amalfi/" class="text-med-blue hover:underline font-medium">Amalfi</a> (25 min), poi bus SITA per <a href="/it-it/costiera-amalfitana/positano/" class="text-med-blue hover:underline font-medium">Positano</a> (45 min)', transport: 'bus' },
  { time: '16:30', place: 'Positano', action: 'Passeggiata via Cristoforo Colombo, Spiaggia Grande, aperitivo (1.5h)', transport: 'visit' },
  { time: '18:30', place: 'Positano → Napoli', action: 'Bus SITA per <a href="/it-it/penisola-sorrentina/sorrento/" class="text-med-blue hover:underline font-medium">Sorrento</a> (50 min), poi Circumvesuviana per Napoli (70 min)', transport: 'bus' },
];

const tips = [
  'Il traghetto Travelmar da <span class="text-med-gold font-medium">Salerno</span> è stagionale (apr-ott): in inverno usa il bus SITA da <span class="text-med-gold font-medium">Salerno</span>.',
  'Compra il biglietto del bus SITA in tabaccheria prima di salire - non si vende a bordo.',
  'In luglio-agosto il bus Amalfi→<a href="/it-it/costiera-amalfitana/positano/" class="text-med-gold hover:underline font-medium">Positano</a> può impiegare 1.5h invece di 45 min: calcola il margine.',
  '<a href="/it-it/costiera-amalfitana/ravello/" class="text-med-gold hover:underline font-medium">Ravello</a> vale il detour: Villa Rufolo (€7) è uno dei belvedere più belli della Costiera.',
  'Il rientro da <a href="/it-it/costiera-amalfitana/positano/" class="text-med-gold hover:underline font-medium">Positano</a> in bus SITA è più lento (curve + traffico) - calcola almeno 1h per <a href="/it-it/penisola-sorrentina/sorrento/" class="text-med-gold hover:underline font-medium">Sorrento</a>.',
];

const transportBadge: Record<string, { label: string; cls: string }> = {
  train: { label: 'TRENO', cls: 'bg-orange-100 text-orange-700' },
  ferry: { label: 'NAVE', cls: 'bg-blue-100 text-blue-700' },
  bus:   { label: 'BUS', cls: 'bg-green-100 text-green-700' },
  walk:  { label: 'PIEDI', cls: 'bg-gray-100 text-slate-500' },
  visit: { label: '', cls: '' },
};
const touristTripSchema = {
  "@context": "https://schema.org",
  "@type": "TouristTrip",
  "name": "1 Giorno da Napoli",
  "description": "Itinerario completo da Napoli alla Costiera Amalfitana: distanza Napoli Amalfi, itinerari 5 e 7 giorni. Amalfi, Ravello, Positano con traghetto e bus SITA.",
  "image": "https://amalficoast-travel.com/images/costiera-hero.jpg",
  "url": "https://amalficoast-travel.com/it-it/itinerari/1-giorno/costiera-amalfitana-da-napoli/",
  "itinerary": {
    "@type": "ItemList",
    "numberOfItems": schedule.length,
    "itemListElement": schedule.map((s, i) => ({
      "@type": "ListItem",
      "position": i + 1,
      "name": `${s.time} \u00b7 ${s.place}`,
      "description": s.action
    }))
  },
  "touristType": "Sightseeing"
};
---

<BaseLayout
  title="Costiera Amalfitana da Napoli in 1-5-7 Giorni 2026 | Guida Completa"
  description="Itinerario completo da Napoli alla Costiera Amalfitana: distanza Napoli Amalfi, itinerari 5 e 7 giorni. Amalfi, Ravello, Positano con traghetto e bus SITA."
  lang={lang}
  breadcrumbs={breadcrumbs}
  schema={[faqSchema, touristTripSchema]}
 pageKey="costiera-amalfitana-da-napoli"
  heroImage="/images/costiera-hero.jpg"
>

  <!-- Hero Section -->
  <section class="relative bg-charcoal overflow-hidden min-h-[70vh] sm:min-h-[75vh] flex items-center justify-center">
    <img src="/images/costiera-hero.jpg" alt="Grand Tour Costiera Amalfitana" class="absolute inset-0 w-full h-full object-cover opacity-30" loading="eager" fetchpriority="high" decoding="sync" referrerpolicy="no-referrer"/>
    <div class="absolute inset-0 bg-gradient-to-b from-black/75 via-black/40 to-black/70"></div>
    <div class="relative max-w-editorial mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <div class="max-w-3xl mx-auto">
        <p class="text-med-gold text-xs sm:text-sm font-medium uppercase tracking-[0.3em] mb-3">Itinerario · 1 giorno</p>
        <h1 class="font-serif text-display text-white mb-4">Costiera Amalfitana da Napoli</h1>
        <p class="text-xl text-white/80 leading-relaxed max-w-2xl mx-auto">
          Amalfi, Ravello e Positano in una giornata partendo da Napoli. Traghetto Travelmar da Salerno, bus SITA e una vista indimenticabile.
        </p>
      </div>
    </div>
    <Breadcrumbs breadcrumbs={breadcrumbs} />
  </section>

  <div class="max-w-editorial mx-auto px-4 sm:px-6 lg:px-8 pt-6 pb-10 space-y-10">

    <!-- Intro & Stats Section - Featured -->
    <section class="text-center mb-2">
      <!-- Quick Stats Grid - Scrollable on Mobile -->
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-2 sm:gap-4 mb-2 overflow-x-auto snap-x snap-mandatory sm:overflow-visible pb-2 sm:pb-0">
        <div class="w-full bg-slate-900 rounded-2xl p-4 sm:p-6 hover:shadow-md transition-shadow flex flex-col items-center justify-center aspect-square snap-start">
          <svg class="w-8 h-8 text-med-gold mb-3" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
            <rect x="3" y="4" width="18" height="18" rx="2"/>
            <path d="M16 2v4M8 2v4M3 10h18"/>
          </svg>
          <p class="text-xs text-white font-semibold uppercase tracking-wide mb-2">Durata</p>
          <p class="font-serif text-lg font-semibold text-med-gold">1 giorno</p>
        </div>
        <div class="w-full bg-slate-900 rounded-2xl p-4 sm:p-6 hover:shadow-md transition-shadow flex flex-col items-center justify-center aspect-square snap-start">
          <svg class="w-8 h-8 text-med-gold mb-3" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
            <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/>
            <circle cx="12" cy="10" r="3"/>
          </svg>
          <p class="text-xs text-white font-semibold uppercase tracking-wide mb-2">Base</p>
          <p class="font-serif text-lg font-semibold text-med-gold">Napoli</p>
        </div>
        <div class="w-full bg-slate-900 rounded-2xl p-4 sm:p-6 hover:shadow-md transition-shadow flex flex-col items-center justify-center aspect-square snap-start">
          <svg class="w-8 h-8 text-med-gold mb-3" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
            <path d="M6 9l6-6 6 6M5 9v9a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V9M9 14h6"/>
          </svg>
          <p class="text-xs text-white font-semibold uppercase tracking-wide mb-2">Trasporti</p>
          <p class="font-serif text-lg font-semibold text-med-gold">Treno + traghetto<br/>+ bus locale</p>
        </div>
        <div class="w-full bg-slate-900 rounded-2xl p-4 sm:p-6 hover:shadow-md transition-shadow flex flex-col items-center justify-center aspect-square snap-start">
          <svg class="w-8 h-8 text-med-gold mb-3" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
            <circle cx="12" cy="12" r="1"/>
            <path d="M12 1v6M12 17v6M4.22 4.22l4.24 4.24M15.54 15.54l4.24 4.24M1 12h6M17 12h6M4.22 19.78l4.24-4.24M15.54 8.46l4.24-4.24"/>
          </svg>
          <p class="text-xs text-white font-semibold uppercase tracking-wide mb-2">Budget trasporti</p>
          <p class="font-serif text-lg font-semibold text-med-gold">€20–30<br/><span class="text-xs">p.p.</span></p>
        </div>
      </div>

      <!-- SEO Text Below -->
      <div>
        <p class="text-lg text-slate-700 leading-relaxed">
          Un'incursione nella <strong>Costiera Amalfitana</strong> da Napoli in un solo giorno: prendi il treno per <strong>Salerno</strong>, poi il <strong>traghetto Travelmar</strong> per <strong>Amalfi</strong>. Visita il Duomo e il centro storico, sali a <strong>Ravello</strong> per le viste mozzafiato da Villa Rufolo, poi scendi a <strong>Positano</strong> per passeggiare e ammirare il mare. Rientro via Sorrento. <strong>Budget trasporti: €20–30</strong>.
        </p>
      </div>
    </section>


    <!-- Day by Day Itinerary -->
    <section>
      <h2 class="font-serif text-2xl font-semibold text-slate-900 mb-8">Programma della giornata</h2>
      <div class="bg-white border border-slate-200 rounded-2xl overflow-hidden">
        <div class="px-6 py-8 space-y-6">
          {schedule.map((item, idx) => {
            const badge = transportBadge[item.transport];
            const isLastItem = idx === schedule.length - 1;
            return (
              <div class="flex gap-4">
                <div class="flex flex-col items-center flex-shrink-0">
                  <div class="w-16 bg-slate-900 text-med-gold rounded-full px-2 py-1 text-center text-sm font-semibold flex items-center justify-center">
                    {item.time}
                  </div>
                  {!isLastItem && <div class="w-0.5 h-12 bg-med-blue/30 mt-2"></div>}
                </div>
                <div class="pb-4 flex-1">
                  <p class="font-semibold text-slate-900 mb-1">{item.place}</p>
                  <p class="text-slate-700 text-sm mb-2" set:html={item.action} />
                  {badge.label && (
                    <span class={`text-xs font-semibold px-2 py-1 rounded-full ${badge.cls}`}>
                      {badge.label}
                    </span>
                  )}
                </div>
              </div>
            );
          })}
        </div>
      </div>
    </section>

    <!-- Itinerary Map -->
    <section>
      <img src="/images/amalfi-coast-from-naples-map.webp" alt="Costiera Amalfitana da Napoli - mappa itinerario di 1 giorno" class="w-full rounded-2xl shadow-lg" loading="lazy" referrerpolicy="no-referrer"/>
    </section>

    <!-- Destinations Highlighted -->
    <section>
      <h2 class="font-serif text-2xl font-semibold text-slate-900 mb-8">Le destinazioni dell'itinerario</h2>
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4">
        {destinationHighlights.map((dest) => (
          <a href={dest.url} class="group block bg-white border border-slate-200 rounded-2xl p-5 hover:shadow-lg hover:border-med-blue/30 transition-all">
            <h3 class="font-semibold text-charcoal mb-2 group-hover:text-med-blue transition-colors">{dest.name}</h3>
            <p class="text-xs text-slate-500 leading-relaxed mb-3">{dest.desc}</p>
            <span class="text-xs font-semibold text-med-blue inline-flex items-center gap-1 group-hover:gap-2 transition-all">
              Scopri →
            </span>
          </a>
        ))}
      </div>
    </section>

    <!-- Planning Tips -->
    <section class="bg-med-cream border border-med-gold/20 rounded-[2rem] p-6">
      <h2 class="font-serif text-xl font-semibold text-charcoal mb-6">Consigli pratici</h2>
      <ul class="space-y-4">
        {tips.map((text, idx) => {
          const nums = ['❶', '❷', '❸', '❹', '❺'];
          return (
            <li class="flex items-start gap-4 text-sm text-charcoal">
              <span class="text-2xl font-bold text-white flex-shrink-0 leading-none mt-0.5 bg-[#E2725B] w-9 h-9 flex items-center justify-center rounded-full">{nums[idx] || '•'}</span>
              <span class="leading-relaxed" set:html={text} />
            </li>
          );
        })}
      </ul>
    </section>

    <!-- FAQ -->
    <section id="faq">
      <h2 class="font-serif text-2xl font-semibold text-slate-900 mb-6">Domande frequenti</h2>
      <div class="space-y-4">
        {faqSchema.mainEntity.map((q) => (
          <details class="group border border-slate-200 rounded-2xl overflow-hidden">
            <summary class="flex items-center justify-between px-6 py-4 cursor-pointer select-none text-charcoal font-medium hover:bg-slate-50 transition-colors">
              {q.name}
              <svg class="w-4 h-4 text-slate-400 group-open:rotate-180 transition-transform flex-shrink-0 ml-3" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
            </summary>
            <div class="px-6 pb-5 text-slate-600 leading-relaxed text-sm border-t border-slate-100 pt-4">
              {q.acceptedAnswer.text}
            </div>
          </details>
        ))}
      </div>
    </section>

    <!-- Banner: Configuratore Itinerario -->
    <section class="relative overflow-hidden rounded-[2.5rem] bg-gradient-to-br from-slate-900 via-slate-950 to-blue-950 px-6 sm:px-10 md:px-14 py-10 md:py-14 shadow-[0_20px_60px_rgba(0,0,0,0.35)]">
      <div class="absolute -top-20 -left-20 w-72 h-72 bg-blue-500/15 rounded-full blur-3xl pointer-events-none"></div>
      <div class="absolute -bottom-20 -right-20 w-72 h-72 bg-amber-500/10 rounded-full blur-3xl pointer-events-none"></div>
      <div class="relative z-10 grid md:grid-cols-[3fr_2fr] md:items-center gap-8">
        <div>
          <span class="inline-block px-4 py-1.5 rounded-full text-xs font-semibold tracking-wide uppercase bg-med-gold/15 text-med-gold border border-med-gold/25 mb-6">Novità: Viaggio su Misura</span>
          <h2 class="text-3xl md:text-4xl font-bold text-white leading-tight mb-2">Disegna il tuo</h2>
          <p class="font-serif text-3xl md:text-4xl italic text-med-blue mb-5">itinerario ideale</p>
          <p class="text-white/60 text-base md:text-lg leading-relaxed max-w-xl mb-8">Rispondi a poche semplici domande - punto di partenza, giorni e interessi - e ricevi un itinerario personalizzato con trasporti, costi e orari.</p>
          <div class="flex flex-wrap gap-6">
            <div class="flex items-center gap-2.5">
              <div class="w-9 h-9 rounded-xl bg-white/5 border border-white/10 flex items-center justify-center">
                <svg class="w-4.5 h-4.5 text-med-gold" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
              </div>
              <span class="text-white/50 text-sm">30 secondi per configurare</span>
            </div>
            <div class="flex items-center gap-2.5">
              <div class="w-9 h-9 rounded-xl bg-white/5 border border-white/10 flex items-center justify-center">
                <svg class="w-4.5 h-4.5 text-med-gold" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 6.75V15m6-6v8.25m.503 3.498l4.875-2.437c.381-.19.622-.58.622-1.006V4.82c0-.836-.88-1.38-1.628-1.006l-3.869 1.934c-.317.159-.69.159-1.006 0L9.503 3.252a1.125 1.125 0 00-1.006 0L3.622 5.689C3.24 5.88 3 6.27 3 6.695V19.18c0 .836.88 1.38 1.628 1.006l3.869-1.934c.317-.159.69-.159 1.006 0l4.994 2.497c.317.158.69.158 1.006 0z"/></svg>
              </div>
              <span class="text-white/50 text-sm">Consigli anti-folla inclusi</span>
            </div>
          </div>
        </div>
        <div class="mt-8 md:mt-0 md:flex md:justify-center">
          <a href="/it-it/configuratore-itinerario/" class="inline-flex items-center gap-2.5 px-7 py-3.5 bg-gradient-to-r from-med-gold to-yellow-600 text-slate-900 font-bold rounded-xl hover:shadow-[0_0_30px_rgba(212,175,55,0.4)] hover:scale-105 transition-all duration-300">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 2L2 12l4 0 0 6 4 0 0-4 4 0 0 4 4 0 0-6 4 0L12 2z"/></svg>
            Configura Ora
          </a>
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="bg-gradient-to-r from-med-blue to-med-blue/80 rounded-2xl p-10 text-center text-white">
      <h2 class="font-serif text-3xl font-bold mb-3">Scopri la Costiera Amalfitana</h2>
      <p class="text-white/90 mb-6 max-w-2xl mx-auto">
        Leggi la guida completa ai trasporti sulla Costiera: traghetti, bus SITA, orari e come risparmiare.
      </p>
      <a href="/it-it/guida/traghetti/" class="inline-block bg-white text-med-blue font-semibold px-8 py-3 rounded-full hover:bg-slate-100 transition-colors">
        Guida ai traghetti →
      </a>
    </section>

  </div>

</BaseLayout>
