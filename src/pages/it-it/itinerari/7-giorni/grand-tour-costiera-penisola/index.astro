---
import BaseLayout from '../../../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../../../components/Breadcrumbs.astro';

const lang = 'it-it';

const breadcrumbs = [
  { name: 'Home', url: '/it-it/' },
  { name: 'Itinerari', url: '/it-it/itinerari/' },
  { name: 'Grand Tour - 7 giorni', url: '/it-it/itinerari/7-giorni/grand-tour-costiera-penisola/' },
];

const destinationHighlights = [
  { name: 'Napoli', url: '/it-it/destinazioni/napoli/', desc: 'Centro UNESCO, Spaccanapoli, Museo Archeologico Nazionale, pizza verace' },
  { name: 'Pompei', url: '/it-it/destinazioni/pompei/', desc: 'Scavi romani meglio conservati d\'Europa' },
  { name: 'Sorrento', url: '/it-it/destinazioni/sorrento/', desc: 'Terrazza sul mare, base ideale per escursioni' },
  { name: 'Positano', url: '/it-it/destinazioni/positano/', desc: 'Gioiello della Costiera con spiaggia e negozi caratteristici' },
  { name: 'Amalfi', url: '/it-it/destinazioni/amalfi/', desc: 'Duomo, Chiostro del Paradiso, Museo della Carta' },
  { name: 'Ravello', url: '/it-it/destinazioni/ravello/', desc: 'Terrazza sull\'Infinito: Villa Rufolo e Villa Cimbrone' },
  { name: 'Capri', url: '/it-it/destinazioni/capri/', desc: 'Grotta Azzurra, Faraglioni, Anacapri con Monte Solaro' },
  { name: 'Ischia', url: '/it-it/destinazioni/ischia/', desc: 'Isola termale con spiagge e giardini botanici' },
];

const days = [
  {
    day: 'Giorno 1',
    title: 'Napoli',
    highlight: 'Centro storico UNESCO',
    items: ['Arrivo a Napoli. Explore Spaccanapoli, centro storico UNESCO.', 'Museo Archeologico Nazionale: reperti da Pompei, mosaici, bronzi.', 'Pizza verace nel quartiere storico: Da Michele, Sorbillo o Brandi.']
  },
  {
    day: 'Giorno 2',
    title: 'Pompei o Ercolano',
    highlight: 'Day trip sotterraneo',
    items: ['Day trip in Circumvesuviana: Ercolano Scavi (mattina, 2-3h) + Vesuvio (pomeriggio).', 'In alternativa: Pompei intera giornata (3-4h agli scavi).', 'Rientro a Napoli per la cena.']
  },
  {
    day: 'Giorno 3',
    title: 'Sorrento e arrivo Costiera',
    highlight: 'Primo sguardo al mare',
    items: ['Circumvesuviana Napoli→Sorrento (70 min). Check-in a Sorrento o Amalfi.', 'Pomeriggio: Sorrento centro, Vallone dei Mulini, Marina Grande.', 'Bus SITA per Positano (opzionale, 50 min): primo contatto con la Costiera.']
  },
  {
    day: 'Giorno 4',
    title: 'Capri',
    highlight: 'Isola della Grotta Azzurra',
    items: ['Aliscafo da Sorrento per Capri (20-25 min). Prima corsa 7:30.', 'Grotta Azzurra di mattina presto. Anacapri e Monte Solaro a seggiovia.', 'Faraglioni nel pomeriggio. Aperitivo in Piazzetta. Rientro sera.']
  },
  {
    day: 'Giorno 5',
    title: 'Amalfi e Ravello',
    highlight: 'Duomo e ville storiche',
    items: ['Bus SITA Sorrento→Amalfi (90 min) o traghetto Sorrento→Amalfi.', 'Duomo, Chiostro del Paradiso, Museo della Carta.', 'Bus per Ravello (25 min): Villa Rufolo, Villa Cimbrone. Cena ad Amalfi.']
  },
  {
    day: 'Giorno 6',
    title: 'Positano e Tour in Barca',
    highlight: 'Grotta Smeraldo dal mare',
    items: ['Bus SITA per Positano (45 min da Amalfi). Mattina libera in spiaggia.', 'Tour in barca da Positano (Grotta Smeraldo, cale, ~€50-80, 4h).', 'Rientro ad Amalfi o Positano. Cena sul porto.']
  },
  {
    day: 'Giorno 7',
    title: 'Ischia o Procida e Partenza',
    highlight: 'Isole coloratissime',
    items: ['Traghetto Amalfi/Napoli→Ischia o Procida (escursione mezza giornata).', 'Procida: Marina Corricella, Terra Murata, spiaggia del Pozzo Vecchio.', 'Rientro a Napoli per la partenza.']
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Quale è il modo migliore per organizzare 7 giorni tra Costiera e Penisola Sorrentina?",
      "acceptedAnswer": { "@type": "Answer", "text": "Il percorso classico è: 2 notti a Napoli (giorno 1-2), poi spostarsi a Sorrento o Amalfi come base per la Costiera (giorno 3-5), con escursione a Capri (giorno 4 o 5), poi isole nel finale (giorno 6-7). Usare bus SITA, Circumvesuviana e aliscafi evita l'auto completamente." }
    },
    {
      "@type": "Question",
      "name": "Quante notti a Napoli conviene fare prima della Costiera?",
      "acceptedAnswer": { "@type": "Answer", "text": "1-2 notti sono sufficienti per Napoli: Spaccanapoli, Museo Archeologico Nazionale, pizza verace, Certosa di San Martino. Con 2 notti puoi includere Ercolano o Pompei come day trip. Napoli è il punto di arrivo/partenza naturale per la zona." }
    },
    {
      "@type": "Question",
      "name": "È meglio base a Sorrento o Amalfi?",
      "acceptedAnswer": { "@type": "Answer", "text": "Sorrento è più affollata ma ha migliori collegamenti via aliscafo per Capri. Amalfi è più autentica e centrale per la Costiera. Ideale: 2 notti a Sorrento + 2 notti ad Amalfi o Positano." }
    },
    {
      "@type": "Question",
      "name": "Quando è il periodo migliore per fare questo itinerario?",
      "acceptedAnswer": { "@type": "Answer", "text": "Aprile-giugno e settembre-ottobre offrono clima ideale, meno folla e prezzi ragionevoli. Luglio-agosto è affollato ma con lunghe giornate. Novembre-marzo è bassa stagione: meno turisti ma alcuni aliscafi ridotti." }
    }
  ]
};
---

<BaseLayout
  title="Grand Tour Costiera Amalfitana 7 Giorni 2026 | Napoli, Capri, Positano, Amalfi"
  description="Itinerario di 7 giorni completo tra Napoli, Costiera Amalfitana, Capri e isole del Golfo. Pompei, Sorrento, Positano, Amalfi, Ravello: il Grand Tour del Sud Italia."
  lang={lang}
  breadcrumbs={breadcrumbs}
  schema={[faqSchema]}
>

  <!-- Hero Section -->
  <section class="relative bg-charcoal overflow-hidden">
    <img src="/images/costiera-hero.jpg" alt="Grand Tour Costiera Amalfitana" class="absolute inset-0 w-full h-full object-cover opacity-30" loading="eager" referrerpolicy="no-referrer"/>
    <div class="absolute inset-0 bg-gradient-to-b from-black/20 via-black/40 to-black/80"></div>
    <div class="relative max-w-editorial mx-auto px-4 sm:px-6 lg:px-8 py-20">
      <div class="max-w-3xl">
        <p class="text-med-gold text-xs sm:text-sm font-medium uppercase tracking-[0.3em] mb-3">Itinerario · 7 giorni</p>
        <h1 class="font-serif text-display text-white mb-4">Grand Tour Costiera & Penisola</h1>
        <p class="text-xl text-white/80 leading-relaxed max-w-2xl">
          Una settimana tra Napoli, Costiera Amalfitana, Penisola Sorrentina, Capri e isole del Golfo. Il percorso classico del Sud Italia senza fretta.
        </p>
      </div>
    </div>
    <Breadcrumbs breadcrumbs={breadcrumbs} />
  </section>

  <div class="max-w-editorial mx-auto px-4 sm:px-6 lg:px-8 py-12 space-y-12">

    <!-- Intro & Stats Section - Featured -->
    <section class="text-center mb-4">
      <div class="mb-8">
        <p class="text-lg text-slate-700 leading-relaxed">
          Il <strong>Grand Tour di 7 giorni</strong> combina Napoli, Costiera Amalfitana, Penisola Sorrentina, Capri e isole del Golfo usando solo trasporto pubblico. <strong>Budget trasporti: €80–120</strong>.
        </p>
      </div>

      <!-- Quick Stats Grid -->
      <div class="grid sm:grid-cols-4 gap-4">
        <div class="bg-slate-900 rounded-2xl p-6 hover:shadow-md transition-shadow flex flex-col items-center justify-center min-h-[180px]">
          <p class="text-xs text-white/60 font-semibold uppercase tracking-wide mb-3">Durata</p>
          <p class="font-serif text-lg font-semibold text-med-gold">7 giorni<br/>6 notti</p>
        </div>
        <div class="bg-slate-900 rounded-2xl p-6 hover:shadow-md transition-shadow flex flex-col items-center justify-center min-h-[180px]">
          <p class="text-xs text-white/60 font-semibold uppercase tracking-wide mb-3">Basi</p>
          <p class="font-serif text-lg font-semibold text-med-gold">Napoli +<br/>Amalfi/Sorrento</p>
        </div>
        <div class="bg-slate-900 rounded-2xl p-6 hover:shadow-md transition-shadow flex flex-col items-center justify-center min-h-[180px]">
          <p class="text-xs text-white/60 font-semibold uppercase tracking-wide mb-3">Trasporti</p>
          <p class="font-serif text-lg font-semibold text-med-gold">Treno + bus<br/>+ aliscafi</p>
        </div>
        <div class="bg-slate-900 rounded-2xl p-6 hover:shadow-md transition-shadow flex flex-col items-center justify-center min-h-[180px]">
          <p class="text-xs text-white/60 font-semibold uppercase tracking-wide mb-3">Budget trasporti</p>
          <p class="font-serif text-lg font-semibold text-med-gold">€80–120</p>
        </div>
      </div>
    </section>

    <!-- Best Time to Visit -->
    <section class="bg-med-water/5 border border-med-water/20 rounded-2xl p-6">
      <h2 class="font-serif text-2xl font-semibold text-slate-900 mb-5">Quando andare</h2>
      <div class="grid sm:grid-cols-3 gap-6 text-sm text-slate-700">
        <div>
          <p class="font-semibold text-med-gold mb-2">Aprile–Giugno</p>
          <p>Clima perfetto, meno folla, prezzi ragionevoli. Ideale per trekking e mare.</p>
        </div>
        <div>
          <p class="font-semibold text-med-blue mb-2">Luglio–Agosto</p>
          <p>Caldo, affollato, prezzi alti. Spiagge piene ma lunghe giornate.</p>
        </div>
        <div>
          <p class="font-semibold text-med-water mb-2">Settembre–Ottobre</p>
          <p>Clima ancora bellissimo, mare caldo, folla in calo. Uno dei periodi migliori.</p>
        </div>
      </div>
    </section>

    <!-- Day by Day Itinerary -->
    <section>
      <h2 class="font-serif text-2xl font-semibold text-slate-900 mb-8">Il programma giorno per giorno</h2>
      <div class="space-y-6">
        {days.map((d, idx) => (
          <div class="bg-white border border-slate-200 rounded-2xl overflow-hidden hover:shadow-md transition-shadow">
            <div class="bg-slate-900 px-6 py-6 flex items-start gap-4 sm:items-center sm:gap-3">
              <span class="text-[10px] uppercase tracking-wide bg-white/15 text-white px-3 py-1.5 rounded-full font-bold flex-shrink-0">{d.day}</span>
              <div class="flex-1 min-w-0">
                <h3 class="font-serif font-semibold text-white text-lg">{d.title}</h3>
                <p class="text-xs text-med-gold mt-1 font-medium">{d.highlight}</p>
              </div>
            </div>
            <ul class="px-6 py-5 space-y-3">
              {d.items.map((item, itemIdx) => (
                <li class="flex items-start gap-3 text-sm text-slate-700">
                  <span class="w-2 h-2 rounded-full bg-med-blue flex-shrink-0 mt-2"></span>
                  <span class="leading-relaxed">{item}</span>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </section>

    <!-- Destinations Highlighted -->
    <section>
      <h2 class="font-serif text-2xl font-semibold text-slate-900 mb-8">Le destinazioni dell'itinerario</h2>
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4">
        {destinationHighlights.map((dest) => (
          <a href={dest.url} class="group block bg-white border border-slate-200 rounded-2xl p-5 hover:shadow-lg hover:border-med-blue/30 transition-all">
            <h3 class="font-semibold text-charcoal mb-2 group-hover:text-med-blue transition-colors">{dest.name}</h3>
            <p class="text-xs text-slate-500 leading-relaxed mb-3">{dest.desc}</p>
            <span class="text-xs font-semibold text-med-blue inline-flex items-center gap-1 group-hover:gap-2 transition-all">
              Scopri →
            </span>
          </a>
        ))}
      </div>
    </section>

    <!-- Planning Tips -->
    <section class="bg-med-cream border border-med-gold/20 rounded-[2rem] p-6">
      <h2 class="font-serif text-xl font-semibold text-charcoal mb-6">Consigli pratici</h2>
      <ul class="space-y-4">
        {[
          { num: '❶', text: 'Campania Express: biglietto giornaliero Circumvesuviana ~€10 (valido Napoli-Sorrento-Pompei-Ercolano).' },
          { num: '❷', text: 'Prenota Capri e Grotta Azzurra con 1-2 giorni anticipo in luglio-agosto.' },
          { num: '❸', text: 'Base: 2 notti Napoli + 3 notti Amalfi/Sorrento + 1 notte isola.' },
          { num: '❹', text: 'Il giorno del tour in barca è flessibile: spostalo in base al meteo marino.' },
          { num: '❺', text: 'Scarpe comode per sampietrini napoletani e scalinate di Positano.' },
        ].map(({ num, text }) => (
          <li class="flex items-start gap-4 text-sm text-charcoal">
            <span class="text-2xl font-bold text-white flex-shrink-0 leading-none mt-0.5 bg-[#E2725B] w-9 h-9 flex items-center justify-center rounded-full">{num}</span>
            <span class="leading-relaxed">{text}</span>
          </li>
        ))}
      </ul>
    </section>

    <!-- FAQ -->
    <section id="faq">
      <h2 class="font-serif text-2xl font-semibold text-slate-900 mb-6">Domande frequenti</h2>
      <div class="space-y-4">
        {faqSchema.mainEntity.map((q) => (
          <details class="group border border-slate-200 rounded-2xl overflow-hidden">
            <summary class="flex items-center justify-between px-6 py-4 cursor-pointer select-none text-charcoal font-medium hover:bg-slate-50 transition-colors">
              {q.name}
              <svg class="w-4 h-4 text-slate-400 group-open:rotate-180 transition-transform flex-shrink-0 ml-3" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
            </summary>
            <div class="px-6 pb-5 text-slate-600 leading-relaxed text-sm border-t border-slate-100 pt-4">
              {q.acceptedAnswer.text}
            </div>
          </details>
        ))}
      </div>
    </section>

    <!-- CTA -->
    <section class="bg-gradient-to-r from-med-blue to-med-blue/80 rounded-2xl p-10 text-center text-white">
      <h2 class="font-serif text-3xl font-bold mb-3">Pronto a partire?</h2>
      <p class="text-white/90 mb-6 max-w-2xl mx-auto">
        Leggi la guida completa ai trasporti pubblici sulla Costiera: come arrivare, orari, biglietti e strategie per risparmiare.
      </p>
      <a href="/it-it/guida-pratica/trasporti/" class="inline-block bg-white text-med-blue font-semibold px-8 py-3 rounded-full hover:bg-slate-100 transition-colors">
        Guida ai trasporti →
      </a>
    </section>

  </div>

</BaseLayout>
