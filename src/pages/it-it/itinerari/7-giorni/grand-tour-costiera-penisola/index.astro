---
import BaseLayout from '../../../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../../../components/Breadcrumbs.astro';

const lang = 'it-it';

const breadcrumbs = [
  { name: 'Home', url: '/it-it/' },
  { name: 'Pianificazione', url: '/it-it/pianificazione/' },
  { name: 'Grand Tour - 7 giorni', url: '/it-it/itinerari/7-giorni/grand-tour-costiera-penisola/' },
];

const destinationHighlights = [
  { name: 'Sorrento', url: '/it-it/penisola-sorrentina/sorrento/', desc: 'Terrazza sul mare, base ideale per escursioni' },
  { name: 'Marina del Cantone', url: '/it-it/spiagge/penisola-sorrentina/marina-del-cantone/', desc: 'Cala incantevole della Penisola con acque cristalline' },
  { name: 'Positano', url: '/it-it/costiera-amalfitana/positano/', desc: 'Gioiello della Costiera con spiaggia e negozi caratteristici' },
  { name: 'Spiaggia Grande Positano', url: '/it-it/spiagge/costiera-amalfitana/spiaggia-grande-positano/', desc: 'Spiaggia principale di Positano con lettini e bar' },
  { name: 'Amalfi', url: '/it-it/costiera-amalfitana/amalfi/', desc: 'Duomo, Chiostro del Paradiso, Museo della Carta' },
  { name: 'Ravello', url: '/it-it/costiera-amalfitana/ravello/', desc: 'Terrazza sull\'Infinito: Villa Rufolo e Villa Cimbrone' },
  { name: 'Capri', url: '/it-it/isole/capri/', desc: 'Grotta Azzurra, Faraglioni, Anacapri con Monte Solaro' },
  { name: 'Marina Piccola Capri', url: '/it-it/spiagge/isole/marina-piccola-capri/', desc: 'Spiaggia esclusiva con miglior vista dei Faraglioni' },
  { name: 'Ischia', url: '/it-it/isole/ischia/', desc: 'Isola termale con spiagge e giardini botanici' },
  { name: 'Spiaggia dei Maronti', url: '/it-it/spiagge/isole/spiaggia-maronti/', desc: 'Spiaggia termale naturale di Ischia' },
  { name: 'Procida', url: '/it-it/isole/procida/', desc: 'Isola coloratissima con Marina Corricella e Terra Murata' },
  { name: 'Guida Pratica', url: '/it-it/guida/traghetti/', desc: 'Trasporti, parcheggi, orari e consigli per arrivarci' },
];

const days = [
  {
    day: 'Giorno 1',
    title: 'Napoli',
    highlight: 'Centro storico UNESCO',
    items: [
      'Arrivo a Napoli. Sistemati in hotel, dedica il pomeriggio a Spaccanapoli, il cuore antico della città.',
      'Esplora i Decumani (strade parallele romane), il Duomo di San Gennaro, il Palazzo Reale e piazza del Plebiscito.',
      'Museo Archeologico Nazionale (chiuso lunedì): una delle migliori collezioni pompeiane. Sezione mosaici e bronzi imperdibile. Prenota online per saltare coda.',
      'Cena con pizza verace: Da Michele o Sorbillo (Spaccanapoli) sono le più famose, ma L\'Antica Pizzeria ha code minori. Assaggia la "margherita" classica.',
      'Local tip: passeggia per le vicoli stretti al tramonto, scegli una enoteca locale per un vino campano (Greco di Tufo o Taurasi) prima di cena.'
    ]
  },
  {
    day: 'Giorno 2',
    title: 'Pompei o Ercolano',
    highlight: 'Day trip sotterraneo',
    items: [
      'Mattina: prendi la Circumvesuviana da Napoli verso Ercolano (20 min, €2.50) oppure Pompei (25 min, €2.50).',
      'Ercolano (scelta consigliata): scavi meglio conservati di Pompei, meno folla, più intimi. La Casa del Fauno e la Casa del Trittolemo sono straordinarie. 2-3 ore sufficienti.',
      'Alternativa Pompei: più vasto (3-4 ore), vedi il Foro, il Teatro, la Casa dei Misteri. Affitti audioguide (€8) per contesti storici migliori.',
      'Pomeriggio: tour del Vesuvio da Ercolano (30 min a piedi, accesso limitato a 2000 persone/giorno). Salita 20-25 min, viste sul Golfo e Napoli straordinarie.',
      'Rientro a Napoli per cena. Se stanco, opta per una trattoria napolitana (pasta al ragù lento, fritura mista) in Vomero.',
      'Local tip: compra il biglietto "Campania Artefatto" 3 giorni (€32) per accesso a Pompeii, Ercolano, Vesuvio, Oplonti senza coda.'
    ]
  },
  {
    day: 'Giorno 3',
    title: 'Sorrento e arrivo Costiera',
    highlight: 'Primo sguardo al mare',
    items: [
      'Mattina: Circumvesuviana Napoli→Sorrento (70 min, ~€3.50). Scenery aumenta strada dopo strada, preparati visivamente alla Costiera.',
      'Check-in hotel a Sorrento o Amalfi (consiglio: Sorrento è più vivace e turistico, Amalfi è più autentico).',
      'Pomeriggio: passeggia per Sorrento centro. Plaza Tasso (cuore della città), Cattedrale (XV sec), Museo Correale con vista sul Vesuvio.',
      'Scendi al Vallone dei Mulini (sentiero stretto): un canyon verde con cascata e ruscello, molto suggestivo. 30 min andata/ritorno.',
      'Marina Grande: la spiaggia locale di Sorrento. Affittati uno sdraio, tuffo nel Tirreno, tramonto spettacolare. Bar beach per un aperitivo.',
      'Cena in Sorrento: ristorante sul porto per pesce fresco. Prova "scialatielli ai frutti di mare" (tipico della costiera).',
      'Local tip: se sali verso Positano via bus SITA (50 min), fallo al tramonto per vedute fotografiche indimenticabili.'
    ]
  },
  {
    day: 'Giorno 4',
    title: 'Capri',
    highlight: 'Isola della Grotta Azzurra',
    items: [
      'Sveglia presto: aliscafo da Sorrento per Capri (20-25 min, €18-25, controlla orari online). Prima corsa alle 7:30, torna alle 17:30/18:30.',
      'Grotta Azzurra: prenota via Sorrento Tour o online giorno precedente (~€12-15 biglietto + €15-20 barche locali). Va vista a metà mattina quando sole è alto. Ingresso basso (devi stenderti in barca): magico.',
      'Anacapri (villaggio in altura): diverso da Capri centro, più tranquillo. Visita Chiesa di San Michele (ceramiche blu e gialle XVII sec), giardino botanico, vista a 360°.',
      'Monte Solaro: seggiovia da Anacapri (€8 A/R, 12 min). Picco più alto dell\'isola (589 m). Panorama del Golfo, Costiera, isole Tremiti.',
      'Capri centro (Porto): piazza con shopping di lusso, ristoranti cari, ma affascinante. Faraglioni (tre rocce dal mare) fotografabili dal porto.',
      'Aperitivo in Piazzetta (centro Capri) per "posare" come locali, anche se affollato e caro. Spritz locale.',
      'Rientro con aliscafo serale (ultimi a 18:30-19:00). Cena a Sorrento.',
      'Local tip: salta la Grotta se mare mosso, opta per Punta Carena o spiagge nascoste. Capri è cara, porta liquidi e snack da Sorrento.'
    ]
  },
  {
    day: 'Giorno 5',
    title: 'Amalfi e Ravello',
    highlight: 'Duomo e ville storiche',
    items: [
      'Opzione A (consigliata): Bus SITA da Sorrento→Amalfi (90 min, ~€3). Strada spettacolare con 1000 curve. Scendi lentamente per goderti il panorama.',
      'Opzione B: Traghetto Sorrento→Amalfi (35 min, ~€10-12). Meno coda, vedi costa dal mare.',
      'Amalfi centro: Piazza del Duomo con la Cattedrale Romanica (IX sec), Chiostro del Paradiso con colonnati arabi e limoni. Museo della Carta (tradizione locale di carte decorative). Piccolo ma affascinante.',
      'Scendi alle spiagge: Amalfi ha piccola spiaggia comunale. Paesaggio montagna-mare senza pari. Gelato Pansa (marchio storico) lungo la piazza.',
      'Ravello (25 min bus SITA da Amalfi, +500 m altura): due ville dominano il panorama. Villa Rufolo (XIV sec, giardini mozzafiato) e Villa Cimbrone (XIX sec, "Terrazza dell\'Infinito"). Entrambe visitabili.',
      'Piazza Duomo di Ravello: gradevole, pulita, con vista valle. Scegli ristorante qui (caro ma panorama compensa) oppure scendi ad Amalfi.',
      'Tramonto: miglior punto è dal terrazzo di Villa Cimbrone (ingresso €7, resta aperto fino al tramonto).',
      'Cena ad Amalfi: ristorante sul porto. Specialità: scialatielli frutti di mare, alici marinate, limoncello fatto da loro.',
      'Local tip: Ravello ospita festival musicale internazionale (luglio-agosto). Check se ci sono concerti. Via di Ravello è la "main street" con negozi di ceramiche artigianali.'
    ]
  },
  {
    day: 'Giorno 6',
    title: 'Positano e Tour in Barca',
    highlight: 'Grotta Smeraldo dal mare',
    items: [
      'Mattina: Bus SITA da Amalfi→Positano (45 min, ~€2.50). Strada parallela al mare, fermati a Praiano se hai tempo (piccolo villaggio autentico).',
      'Positano: il gioiello della Costiera. Case pastel verticali, spiaggia ciottoli/sabbia, negozi artigianali di moda e limoncello.',
      'Mattina libera: nuota nella Spiaggia Grande. Affittati ombrellone (~€15) e lettino. Mare trasparente. Bar spiaggia per limoncello freddo.',
      'Pranzo: ristorante spiaggia o alle terrazze alte per pani e limone (piatto leggero locale).',
      'Pomeriggio (14:00): tour in barca privato o condiviso (2.5-4 h, €50-80 per persona). Vedi Grotta Smeraldo (smeraldo fluorescente sott\'acqua, meraviglioso), piccole calette, falesie colorate, bagni nelle acque turchesi.',
      'Rientro al porto di Positano (17:30 circa). Tempo libero per shopping o aperitivo in piazza.',
      'Cena: scegli ristorante sul porto o nelle terrazze alte (vedi tramonto). Provare i ravioli di melanzane (piatto classico).',
      'Pernottamento: rimani a Positano o torna ad Amalfi con bus notturno.',
      'Local tip: Positano è molto fotografica, vai in giro per violi per scattare. Mercat street art nascosto negli allei. Tour barca: ScubaGo o Positano Boats affidabili.'
    ]
  },
  {
    day: 'Giorno 7',
    title: 'Ischia o Procida e Partenza',
    highlight: 'Isole coloratissime',
    items: [
      'Mattina: decidi isola (Ischia = più grande/termale; Procida = più piccola/artistica/colorata). Traghetto da Amalfi (90 min, €10-15) o Napoli (90 min) oppure aliscafo più veloce (40 min, €18-25).',
      'Procida (consigliata per tempo limitato): porto di Marina Grande coloratissimo (case gialle, blu, rosa). Marina Corricella (villaggio pescatori, più autentico). Terra Murata (parte vecchia fortezza, vedute sul Golfo).',
      'Spiaggia del Pozzo Vecchio: cala nascosta, acqua cristallina, 30 min a piedi da centro. Se tempo, sosta qui per ultimo bagno.',
      'Ischia (più grande): Forio (resort, spiagge), Sant\'Angelo (villaggio pescatori, vietate auto, autentico). Terme: Negombo (parco termale con bagni caldi naturali, €25-30, relax prima partenza). Castello aragonese (storico, vista 360°).',
      'Pranzo sull\'isola: pesce fresco, "Pani e panelle" (street food napoletano) o gelato di limone di Procida.',
      'Pomeriggio: traghetto ritorno da isola a Napoli (90 min) o ad Amalfi (dipende orari).',
      'Sera: in base orario volo, cena a Napoli centro o direttamente airport. Compra limoncello (Luxardo) e sfogliatelle (Scaturchio) da airport come souvenirs.',
      'Local tip: Procida è meno turistica, Ischia più rilassante se vuoi spa. In luglio-agosto, prenota traghetto giorno prima. Street food: attenta agli orari, molti posti chiudono 14-17.'
    ]
  },
];

const tripSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": "Grand Tour Costiera Amalfitana - 7 Giorni",
  "description": "Un itinerario completo di 7 giorni tra Napoli, Costiera Amalfitana, Penisola Sorrentina, Capri e isole del Golfo. Combinazione perfetta di arte, storia, natura e mare con trasporto pubblico.",
  "url": "https://amalficoast-travel.com/it-it/itinerari/7-giorni/grand-tour-costiera-penisola/",
  "image": "https://amalficoast-travel.com/images/costiera-hero.jpg",
  "author": {
    "@type": "Organization",
    "name": "Amalfi Coast Travel"
  },
  "publisher": {
    "@type": "Organization",
    "name": "Amalfi Coast Travel",
    "url": "https://amalficoast-travel.com"
  },
  "datePublished": "2026-01-01",
  "articleBody": "Un itinerario completo di 7 giorni tra Napoli, Costiera Amalfitana, Penisola Sorrentina, Capri e isole del Golfo. Combinazione perfetta di arte, storia, natura e mare con trasporto pubblico. Durata: 7 giorni e 6 notti."
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Quale è il modo migliore per organizzare 7 giorni tra Costiera e Penisola Sorrentina?",
      "acceptedAnswer": { "@type": "Answer", "text": "Il percorso classico è: 2 notti a Napoli (giorno 1-2), poi spostarsi a Sorrento o Amalfi come base per la Costiera (giorno 3-5), con escursione a Capri (giorno 4 o 5), poi isole nel finale (giorno 6-7). Usare bus SITA, Circumvesuviana e aliscafi evita l'auto completamente." }
    },
    {
      "@type": "Question",
      "name": "Quante notti a Napoli conviene fare prima della Costiera?",
      "acceptedAnswer": { "@type": "Answer", "text": "1-2 notti sono sufficienti per Napoli: Spaccanapoli, Museo Archeologico Nazionale, pizza verace, Certosa di San Martino. Con 2 notti puoi includere Ercolano o Pompei come day trip. Napoli è il punto di arrivo/partenza naturale per la zona." }
    },
    {
      "@type": "Question",
      "name": "È meglio base a Sorrento o Amalfi?",
      "acceptedAnswer": { "@type": "Answer", "text": "Sorrento è più affollata ma ha migliori collegamenti via aliscafo per Capri. Amalfi è più autentica e centrale per la Costiera. Ideale: 2 notti a Sorrento + 2 notti ad Amalfi o Positano." }
    },
    {
      "@type": "Question",
      "name": "Quando è il periodo migliore per fare questo itinerario?",
      "acceptedAnswer": { "@type": "Answer", "text": "Aprile-giugno e settembre-ottobre offrono clima ideale, meno folla e prezzi ragionevoli. Luglio-agosto è affollato ma con lunghe giornate. Novembre-marzo è bassa stagione: meno turisti ma alcuni aliscafi ridotti." }
    }
  ]
};
---

<BaseLayout
  title="Grand Tour Costiera Amalfitana 7 Giorni 2026 | Napoli, Capri, Positano, Amalfi"
  description="Itinerario di 7 giorni completo tra Napoli, Costiera Amalfitana, Capri e isole del Golfo. Pompei, Sorrento, Positano, Amalfi, Ravello: il Grand Tour del Sud Italia."
  lang={lang}
  breadcrumbs={breadcrumbs}
  schema={[tripSchema, faqSchema]}
 pageKey="grand-tour-costiera-penisola"
  heroImage="/images/costiera-hero.jpg"
>

  <!-- Hero Section -->
  <section class="relative bg-charcoal overflow-hidden min-h-[70vh] sm:min-h-[75vh] flex items-center justify-center">
    <img src="/images/costiera-hero.jpg" alt="Grand Tour Costiera Amalfitana" class="absolute inset-0 w-full h-full object-cover opacity-30" loading="eager" fetchpriority="high" decoding="sync" referrerpolicy="no-referrer"/>
    <div class="absolute inset-0 bg-gradient-to-b from-black/75 via-black/40 to-black/70"></div>
    <div class="relative max-w-editorial mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <div class="max-w-3xl mx-auto">
        <p class="text-med-gold text-xs sm:text-sm font-medium uppercase tracking-[0.3em] mb-3">Itinerario · 7 giorni</p>
        <h1 class="font-serif text-display text-white mb-4">Grand Tour Costiera & Penisola</h1>
        <p class="text-xl text-white/80 leading-relaxed max-w-2xl mx-auto">
          Una settimana tra Napoli, Costiera Amalfitana, Penisola Sorrentina, Capri e isole del Golfo. Il percorso classico del Sud Italia senza fretta.
        </p>
      </div>
    </div>
    <Breadcrumbs breadcrumbs={breadcrumbs} />
  </section>

  <div class="max-w-editorial mx-auto px-4 sm:px-6 lg:px-8 pt-6 pb-10 space-y-10">

    <!-- Intro & Stats Section - Featured -->
    <section class="text-center mb-2">
      <!-- Quick Stats Grid - Scrollable on Mobile -->
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-2 sm:gap-4 mb-6 overflow-x-auto snap-x snap-mandatory sm:overflow-visible pb-2 sm:pb-0">
        <div class="bg-slate-900 rounded-2xl p-6 hover:shadow-md transition-shadow flex flex-col items-center justify-center aspect-square snap-start">
          <svg class="w-8 h-8 text-med-gold mb-3" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
            <rect x="3" y="4" width="18" height="18" rx="2"/>
            <path d="M16 2v4M8 2v4M3 10h18"/>
          </svg>
          <p class="text-xs text-white/60 font-semibold uppercase tracking-wide mb-2">Durata</p>
          <p class="font-serif text-lg font-semibold text-med-gold">7 giorni<br/>6 notti</p>
        </div>
        <div class="bg-slate-900 rounded-2xl p-6 hover:shadow-md transition-shadow flex flex-col items-center justify-center aspect-square snap-start">
          <svg class="w-8 h-8 text-med-gold mb-3" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
            <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/>
            <circle cx="12" cy="10" r="3"/>
          </svg>
          <p class="text-xs text-white/60 font-semibold uppercase tracking-wide mb-2">Basi</p>
          <p class="font-serif text-lg font-semibold text-med-gold">Napoli +<br/>Amalfi/Sorrento</p>
        </div>
        <div class="bg-slate-900 rounded-2xl p-6 hover:shadow-md transition-shadow flex flex-col items-center justify-center aspect-square snap-start">
          <svg class="w-8 h-8 text-med-gold mb-3" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
            <path d="M6 9l6-6 6 6M5 9v9a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V9M9 14h6"/>
          </svg>
          <p class="text-xs text-white/60 font-semibold uppercase tracking-wide mb-2">Trasporti</p>
          <p class="font-serif text-lg font-semibold text-med-gold">Treno + bus<br/>+ aliscafi</p>
        </div>
        <div class="bg-slate-900 rounded-2xl p-6 hover:shadow-md transition-shadow flex flex-col items-center justify-center aspect-square snap-start">
          <svg class="w-8 h-8 text-med-gold mb-3" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
            <circle cx="12" cy="12" r="1"/>
            <path d="M12 1v6M12 17v6M4.22 4.22l4.24 4.24M15.54 15.54l4.24 4.24M1 12h6M17 12h6M4.22 19.78l4.24-4.24M15.54 8.46l4.24-4.24"/>
          </svg>
          <p class="text-xs text-white/60 font-semibold uppercase tracking-wide mb-2">Budget trasporti</p>
          <p class="font-serif text-lg font-semibold text-med-gold">€80–120<br/><span class="text-xs">p.p.</span></p>
        </div>
      </div>

      <!-- SEO Text Below -->
      <div>
        <p class="text-lg text-slate-700 leading-relaxed">
          Il <strong>Grand Tour di 7 giorni</strong> è il percorso classico del Sud Italia: combina due giorni a <strong>Napoli</strong>, la straordinaria <strong>Costiera Amalfitana</strong> con Positano, Amalfi e Ravello, la <strong>Penisola Sorrentina</strong>, <strong>Capri</strong> con la Grotta Azzurra, e le <strong>isole del Golfo</strong>. Tutto con trasporto pubblico. <strong>Budget trasporti: €80–120</strong>.
        </p>
      </div>
    </section>


    <!-- Day by Day Itinerary -->
    <section>
      <h2 class="font-serif text-2xl font-semibold text-slate-900 mb-8">Il programma giorno per giorno</h2>
      <div class="space-y-6">
        {days.map((d, idx) => (
          <div class="bg-white border border-slate-200 rounded-2xl overflow-hidden hover:shadow-md transition-shadow">
            <div class="bg-slate-900 px-6 py-6 flex items-start gap-4 sm:items-center sm:gap-3">
              <span class="text-[10px] uppercase tracking-wide bg-white/15 text-white px-3 py-1.5 rounded-full font-bold flex-shrink-0">{d.day}</span>
              <div class="flex-1 min-w-0">
                <h3 class="font-serif font-semibold text-white text-lg">{d.title}</h3>
                <p class="text-xs text-med-gold mt-1 font-medium">{d.highlight}</p>
              </div>
            </div>
            <ul class="px-6 py-5 space-y-3">
              {d.items.map((item, itemIdx) => {
                const isLocalTip = item.includes('Local tip:');
                const displayText = item.replace('Local tip: ', '');
                const isLastItem = itemIdx === d.items.length - 1;
                return (
                  <li key={itemIdx} class={`flex gap-3 text-sm relative ${isLocalTip ? 'bg-med-gold/10 p-3 rounded-lg border border-med-gold/20' : ''}`}>
                    <div class="flex flex-col items-center">
                      {isLocalTip ? (
                        <svg class="w-5 h-5 text-med-gold flex-shrink-0 self-center" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
                          <circle cx="12" cy="8" r="5"/>
                          <path d="M12 13v2"/>
                          <rect x="10" y="15" width="4" height="3" rx="0.5"/>
                        </svg>
                      ) : (
                        <span class="w-2 h-2 rounded-full bg-med-blue flex-shrink-0"></span>
                      )}
                      {!isLastItem && <div class="w-0.5 h-6 bg-med-blue/30 mt-1"></div>}
                    </div>
                    <span class={`leading-relaxed ${isLocalTip ? 'font-semibold text-slate-800' : 'text-slate-700'}`}>
                      {isLocalTip && <strong>Local tip: </strong>}
                      {displayText}
                    </span>
                  </li>
                );
              })}
            </ul>
          </div>
        ))}
      </div>
    </section>

    <!-- Destinations Highlighted -->
    <section>
      <h2 class="font-serif text-2xl font-semibold text-slate-900 mb-8">Le destinazioni dell'itinerario</h2>
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4">
        {destinationHighlights.map((dest) => (
          <a href={dest.url} class="group block bg-white border border-slate-200 rounded-2xl p-5 hover:shadow-lg hover:border-med-blue/30 transition-all">
            <h3 class="font-semibold text-charcoal mb-2 group-hover:text-med-blue transition-colors">{dest.name}</h3>
            <p class="text-xs text-slate-500 leading-relaxed mb-3">{dest.desc}</p>
            <span class="text-xs font-semibold text-med-blue inline-flex items-center gap-1 group-hover:gap-2 transition-all">
              Scopri →
            </span>
          </a>
        ))}
      </div>
    </section>

    <!-- Planning Tips -->
    <section class="bg-med-cream border border-med-gold/20 rounded-[2rem] p-6">
      <h2 class="font-serif text-xl font-semibold text-charcoal mb-6">Consigli pratici</h2>
      <ul class="space-y-4">
        {[
          { num: '❶', text: 'Campania Express: biglietto giornaliero Circumvesuviana ~€10 (valido Napoli-Sorrento-Pompei-Ercolano).' },
          { num: '❷', text: 'Prenota Capri e Grotta Azzurra con 1-2 giorni anticipo in luglio-agosto.' },
          { num: '❸', text: 'Base: 2 notti Napoli + 3 notti Amalfi/Sorrento + 1 notte isola.' },
          { num: '❹', text: 'Il giorno del tour in barca è flessibile: spostalo in base al meteo marino.' },
          { num: '❺', text: 'Scarpe comode per sampietrini napoletani e scalinate di Positano.' },
        ].map(({ num, text }) => (
          <li class="flex items-start gap-4 text-sm text-charcoal">
            <span class="text-2xl font-bold text-white flex-shrink-0 leading-none mt-0.5 bg-[#E2725B] w-9 h-9 flex items-center justify-center rounded-full">{num}</span>
            <span class="leading-relaxed">{text}</span>
          </li>
        ))}
      </ul>
    </section>

    <!-- FAQ -->
    <section id="faq">
      <h2 class="font-serif text-2xl font-semibold text-slate-900 mb-6">Domande frequenti</h2>
      <div class="space-y-4">
        {faqSchema.mainEntity.map((q) => (
          <details class="group border border-slate-200 rounded-2xl overflow-hidden">
            <summary class="flex items-center justify-between px-6 py-4 cursor-pointer select-none text-charcoal font-medium hover:bg-slate-50 transition-colors">
              {q.name}
              <svg class="w-4 h-4 text-slate-400 group-open:rotate-180 transition-transform flex-shrink-0 ml-3" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
            </summary>
            <div class="px-6 pb-5 text-slate-600 leading-relaxed text-sm border-t border-slate-100 pt-4">
              {q.acceptedAnswer.text}
            </div>
          </details>
        ))}
      </div>
    </section>

    <!-- Banner: Configuratore Itinerario -->
    <section class="relative overflow-hidden rounded-[2.5rem] bg-gradient-to-br from-slate-900 via-slate-950 to-blue-950 px-6 sm:px-10 md:px-14 py-10 md:py-14 shadow-[0_20px_60px_rgba(0,0,0,0.35)]">
      <div class="absolute -top-20 -left-20 w-72 h-72 bg-blue-500/15 rounded-full blur-3xl pointer-events-none"></div>
      <div class="absolute -bottom-20 -right-20 w-72 h-72 bg-amber-500/10 rounded-full blur-3xl pointer-events-none"></div>
      <div class="relative z-10 grid md:grid-cols-[3fr_2fr] md:items-center gap-8">
        <div>
          <span class="inline-block px-4 py-1.5 rounded-full text-xs font-semibold tracking-wide uppercase bg-med-gold/15 text-med-gold border border-med-gold/25 mb-6">Novità: Viaggio su Misura</span>
          <h2 class="text-3xl md:text-4xl font-bold text-white leading-tight mb-2">Disegna il tuo</h2>
          <p class="font-serif text-3xl md:text-4xl italic text-med-blue mb-5">itinerario ideale</p>
          <p class="text-white/60 text-base md:text-lg leading-relaxed max-w-xl mb-8">Rispondi a poche semplici domande - punto di partenza, giorni e interessi - e ricevi un itinerario personalizzato con trasporti, costi e orari.</p>
          <div class="flex flex-wrap gap-6">
            <div class="flex items-center gap-2.5">
              <div class="w-9 h-9 rounded-xl bg-white/5 border border-white/10 flex items-center justify-center">
                <svg class="w-4.5 h-4.5 text-med-gold" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
              </div>
              <span class="text-white/50 text-sm">30 secondi per configurare</span>
            </div>
            <div class="flex items-center gap-2.5">
              <div class="w-9 h-9 rounded-xl bg-white/5 border border-white/10 flex items-center justify-center">
                <svg class="w-4.5 h-4.5 text-med-gold" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 6.75V15m6-6v8.25m.503 3.498l4.875-2.437c.381-.19.622-.58.622-1.006V4.82c0-.836-.88-1.38-1.628-1.006l-3.869 1.934c-.317.159-.69.159-1.006 0L9.503 3.252a1.125 1.125 0 00-1.006 0L3.622 5.689C3.24 5.88 3 6.27 3 6.695V19.18c0 .836.88 1.38 1.628 1.006l3.869-1.934c.317-.159.69-.159 1.006 0l4.994 2.497c.317.158.69.158 1.006 0z"/></svg>
              </div>
              <span class="text-white/50 text-sm">Consigli anti-folla inclusi</span>
            </div>
          </div>
        </div>
        <div class="mt-8 md:mt-0 md:flex md:justify-center">
          <a href="/it-it/configuratore-itinerario/" class="inline-flex items-center gap-2.5 px-7 py-3.5 bg-gradient-to-r from-med-gold to-yellow-600 text-slate-900 font-bold rounded-xl hover:shadow-[0_0_30px_rgba(212,175,55,0.4)] hover:scale-105 transition-all duration-300">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 2L2 12l4 0 0 6 4 0 0-4 4 0 0 4 4 0 0-6 4 0L12 2z"/></svg>
            Configura Ora
          </a>
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="bg-gradient-to-r from-med-blue to-med-blue/80 rounded-2xl p-10 text-center text-white">
      <h2 class="font-serif text-3xl font-bold mb-3">Pronto a partire?</h2>
      <p class="text-white/90 mb-6 max-w-2xl mx-auto">
        Leggi la guida completa ai trasporti pubblici sulla Costiera: come arrivare, orari, biglietti e strategie per risparmiare.
      </p>
      <a href="/it-it/guida/come-arrivare/" class="inline-block bg-white text-med-blue font-semibold px-8 py-3 rounded-full hover:bg-slate-100 transition-colors">
        Guida ai trasporti →
      </a>
    </section>

  </div>

</BaseLayout>
