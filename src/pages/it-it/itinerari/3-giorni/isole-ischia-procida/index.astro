---
import BaseLayout from '../../../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../../../components/Breadcrumbs.astro';

const lang = 'it-it';

const breadcrumbs = [
  { name: 'Home', url: '/it-it/' },
  { name: 'Pianificazione', url: '/it-it/pianificazione/' },
  { name: 'Isole: Ischia e Procida', url: '/it-it/itinerari/3-giorni/isole-ischia-procida/' },
];

const destinationHighlights = [
  { name: 'Spiaggia dei Maronti', url: '/it-it/spiagge/isole/spiaggia-maronti/', desc: 'La più lunga di Ischia, sabbia nera vulcanica, vista sul Castello' },
  { name: 'Ischia', url: '/it-it/isole/ischia/', desc: 'L\'isola termale: Castello Aragonese, Forio, Sant\'Angelo, terme naturali' },
  { name: 'Procida', url: '/it-it/isole/procida/', desc: 'L\'isola colorata: Marina Corricella, Terra Murata, case pastel' },
  { name: 'Cala del Pozzo Vecchio', url: '/it-it/spiagge/isole/cala-del-pozzo-vecchio/', desc: 'La spiaggia del film "Il Postino", piccola cala selvaggia a Procida' },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Meglio Ischia o Procida per un weekend?",
      "acceptedAnswer": { "@type": "Answer", "text": "Ischia è grande (46 km²), con terme termali, spiagge variegate, castelli e vita notturna. Richiede almeno 2 giorni. Procida è piccola (4 km²), autentica, con colori pastello iconici, pescatori e poca folla. Con 3 giorni: 2 notti Ischia e 1 giorno escursione a Procida è il mix perfetto." }
    },
    {
      "@type": "Question",
      "name": "Come arrivare a Ischia e Procida da Napoli?",
      "acceptedAnswer": { "@type": "Answer", "text": "Da Napoli Beverello: aliscafo Ischia (~50 min, €20-24) o traghetto (~75 min, €12-14). Per Procida: aliscafo da Napoli (~35 min, €15-18) o traghetto (~60 min, €10-12). Da Ischia a Procida: aliscafo 20 min (~€9). Prenota online in estate." }
    },
    {
      "@type": "Question",
      "name": "Quali sono le spiagge più belle di Ischia?",
      "acceptedAnswer": { "@type": "Answer", "text": "Spiaggia dei Maronti (la più lunga, sabbia nera vulcanica), Spiaggia di Citara a Forio (sabbia fine, vicino alle terme), Sant'Angelo con piccole cale nascoste. Le spiagge termali (Poseidon, Negombo) sono parchi termali con ingresso (~€35-40)." }
    },
    {
      "@type": "Question",
      "name": "Quanto tempo serve per Procida?",
      "acceptedAnswer": { "@type": "Answer", "text": "Un giorno (6-8h) è sufficiente per Marina Corricella, Terra Murata, una spiaggia e il ritorno. Se vuoi più calma, dedica una notte. La spiaggia del Pozzo Vecchio (del film 'Il Postino') è obbligatoria." }
    }
  ]
};

const days = [
  {
    day: 'Giorno 1',
    title: 'Arrivo a Ischia',
    highlight: 'Castello Aragonese e primi bagni',
    items: [
      'Traghetto o aliscafo da Napoli Beverello per Ischia Porto (50-75 min, €12-24 a seconda del mezzo).',
      'Check-in hotel. Riposo dal viaggio.',
      'Pomeriggio: Ischia Ponte e il Castello Aragonese (ingresso €10, vista 360° sul Golfo). Affittati uno sdraio sulla piccola spiaggia di Ischia Ponte.',
      'Aperitivo a Forio (nord-ovest) o a Lacco Ameno (nord): bar sul porto, primo assaggio della costa.',
      'Cena a Ischia Porto: ristorante sul porto, specialità ischitana (coniglio all\'ischitana, pasta con gamberi).',
      'Local tip: il parcheggio è caotico in agosto. Usa i parcheggi pubblici a pagamento, non tentare le stradine.',
    ],
  },
  {
    day: 'Giorno 2',
    title: 'Terme e Spiagge',
    highlight: 'Parchi termali e tramonto a Sant\'Angelo',
    items: [
      'Mattina: Parco termale Poseidon o Negombo (~€35-40 ingresso). Piscine termali a diverse temperature, saune naturali, idromassaggi in mare aperto.',
      'Pranzo leggero al parco (caro ma panoramico) oppure scesa a Citara per spiaggetta libera con sorgenti calde sul fondo (cerca i "sfizi" = bolle termali).',
      'Pomeriggio: Spiaggia di Citara a Forio (una delle più belle, sabbia fine, mare trasparente). Ombrellone ~€15.',
      'Tramonto dal Belvedere di Sant\'Angelo (il borgo più pittoresco di Ischia: case bianche verticali sul mare, bar minuscolo sul porto, pescatori).',
      'Cena a Sant\'Angelo in una delle 3 trattorie al porto (caro, turistica, ma esperienza unica) oppure risalita a Forio.',
      'Local tip: le terme naturali libere (senza parco) sono a Citara e sotto alle rocce di Sant\'Angelo. Porta una tavola per galleggiare nella sorgente calda.',
    ],
  },
  {
    day: 'Giorno 3',
    title: 'Escursione a Procida',
    highlight: 'Marina Corricella e Il Postino',
    items: [
      'Sveglia presto. Aliscafo da Ischia Porto per Procida (20 min, ~€9). Prima corsa 8:00-8:30.',
      'Marina Corricella: il porto dei pescatori, case color pastello (gialle, blu, rosa), barche colorate, bar minuscolo sul molo con limoncello fresco. La vista più fotografica del Golfo.',
      'Terra Murata: il borgo medievale arroccato, vico strettissimi, vista a 360° sul Golfo e sulle altre isole. Chiesa di Santa Maria Assunta (piastrelle maiolica, vista interna bellissima).',
      'Spiaggia del Pozzo Vecchio (famosa dal film "Il Postino"): cala piccola ma bellissima, sabbia e ciottoli. Bagno di mezzogiorno con vista sulla costa.',
      'Pranzo al porto in una trattoria semplice: pasta con alici, insalata di mare, vino bianco locale.',
      'Rientro a Napoli in aliscafo da Procida (35 min, 16:00-17:00 ultime corse).',
      'Local tip: Procida è piccolissima. Non affittare auto. A piedi o monopattino elettrico. Marina Corricella è il cuore: passaci almeno 2-3 ore.',
    ],
  },
];
---

<BaseLayout
  title="Ischia e Procida 3 Giorni 2026 | Isole del Golfo di Napoli"
  description="Itinerario di 3 giorni alle isole del Golfo: Ischia con terme termali, Castello Aragonese, Forio e Sant'Angelo + escursione a Procida (Marina Corricella, Il Postino)."
  lang={lang}
  breadcrumbs={breadcrumbs}
  schema={[faqSchema]}
 pageKey="isole-ischia-procida">

  <!-- Hero Section -->
  <section class="relative bg-charcoal overflow-hidden min-h-[70vh] sm:min-h-[75vh] flex items-center justify-center">
    <img src="/images/costiera-hero.jpg" alt="Ischia e Procida" class="absolute inset-0 w-full h-full object-cover opacity-30" loading="eager" referrerpolicy="no-referrer"/>
    <div class="absolute inset-0 hidden sm:block bg-gradient-to-b from-black/20 via-black/40 to-black/80"></div>
    <div class="relative max-w-editorial mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <div class="max-w-3xl mx-auto">
        <p class="text-med-gold text-xs sm:text-sm font-medium uppercase tracking-[0.3em] mb-3">Itinerario · 3 giorni</p>
        <h1 class="font-serif text-display text-white mb-4">Ischia e Procida</h1>
        <p class="text-xl text-white/80 leading-relaxed max-w-2xl mx-auto">
          Tre giorni alle isole: Ischia con le sue terme termali, il Castello Aragonese, Forio e Sant'Angelo + una giornata a Procida, l'isola colorata dove è stato girato "Il Postino".
        </p>
      </div>
    </div>
    <Breadcrumbs breadcrumbs={breadcrumbs} />
  </section>

  <div class="max-w-editorial mx-auto px-4 sm:px-6 lg:px-8 pt-6 pb-10 space-y-10">

    <!-- Intro Section -->
    <section class="text-center mb-2">
      <div>
        <p class="text-lg text-slate-700 leading-relaxed">
          Un perfetto <strong>itinerario classico di 3 giorni</strong> sulla <strong>Costiera Amalfitana</strong>: esplora <strong>Positano</strong> con le sue case colorate, <strong>Amalfi</strong> con la sua cattedrale storica, <strong>Ravello</strong> con le sue ville e i panorami mozzafiato, e la spettacolare <strong>Grotta dello Smeraldo</strong>. Tutto raggiungibile con i trasporti pubblici.
        </p>
      </div>
    </section>


    <!-- Day by Day Itinerary -->
    <section>
      <h2 class="font-serif text-2xl font-semibold text-slate-900 mb-8">Il programma giorno per giorno</h2>
      <div class="space-y-6">
        {days.map((d, idx) => (
          <div class="bg-white border border-slate-200 rounded-2xl overflow-hidden hover:shadow-md transition-shadow">
            <div class="bg-slate-900 px-6 py-6 flex items-start gap-4 sm:items-center sm:gap-3">
              <span class="text-[10px] uppercase tracking-wide bg-white/15 text-white px-3 py-1.5 rounded-full font-bold flex-shrink-0">{d.day}</span>
              <div class="flex-1 min-w-0">
                <h3 class="font-serif font-semibold text-white text-lg">{d.title}</h3>
                <p class="text-xs text-med-gold mt-1 font-medium">{d.highlight}</p>
              </div>
            </div>
            <ul class="px-6 py-5 space-y-3">
              {d.items.map((item, itemIdx) => {
                const isLocalTip = item.includes('Local tip:');
                const displayText = item.replace('Local tip: ', '');
                const isLastItem = itemIdx === d.items.length - 1;
                return (
                  <li key={itemIdx} class={`flex gap-3 text-sm relative ${isLocalTip ? 'bg-med-gold/10 p-3 rounded-lg border border-med-gold/20' : ''}`}>
                    <div class="flex flex-col items-center">
                      {isLocalTip ? (
                        <svg class="w-5 h-5 text-med-gold flex-shrink-0 self-center" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
                          <circle cx="12" cy="8" r="5"/>
                          <path d="M12 13v2"/>
                          <rect x="10" y="15" width="4" height="3" rx="0.5"/>
                        </svg>
                      ) : (
                        <span class="w-2 h-2 rounded-full bg-med-blue flex-shrink-0"></span>
                      )}
                      {!isLastItem && <div class="w-0.5 h-6 bg-med-blue/30 mt-1"></div>}
                    </div>
                    <span class={`leading-relaxed ${isLocalTip ? 'font-semibold text-slate-800' : 'text-slate-700'}`}>
                      {isLocalTip && <strong>Local tip: </strong>}
                      {displayText}
                    </span>
                  </li>
                );
              })}
            </ul>
          </div>
        ))}
      </div>
    </section>

    <!-- Destinations Highlighted -->
    <section>
      <h2 class="font-serif text-2xl font-semibold text-slate-900 mb-8">Le destinazioni dell'itinerario</h2>
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4">
        {destinationHighlights.map((dest) => (
          <a href={dest.url} class="group block bg-white border border-slate-200 rounded-2xl p-5 hover:shadow-lg hover:border-med-blue/30 transition-all">
            <h3 class="font-semibold text-charcoal mb-2 group-hover:text-med-blue transition-colors">{dest.name}</h3>
            <p class="text-xs text-slate-500 leading-relaxed mb-3">{dest.desc}</p>
            <span class="text-xs font-semibold text-med-blue inline-flex items-center gap-1 group-hover:gap-2 transition-all">
              Scopri →
            </span>
          </a>
        ))}
      </div>
    </section>

    <!-- Practical Tips -->
    <section class="bg-med-cream border border-med-gold/20 rounded-[2rem] p-6">
      <h2 class="font-serif text-xl font-semibold text-charcoal mb-6">Consigli pratici</h2>
      <ul class="space-y-4">
        {[
          { num: '❶', text: 'Aliscafo vs Traghetto: aliscafo più veloce (~50 min, €20-24), traghetto più economico (~75 min, €12-14). In estate prenota online.' },
          { num: '❷', text: 'Parchi termali: Poseidon e Negombo (~€35-40) sono cari ma includono resort completo. Alternativamente, terme naturali libere a Citara.' },
          { num: '❸', text: 'Parcheggio: caos totale in agosto. Usa parcheggi pubblici a pagamento (~€10/giorno), non tentare le stradine.' },
          { num: '❹', text: 'Procida: isola piccolissima. A piedi o monopattino elettrico, non affittare auto. Marina Corricella è il cuore.' },
          { num: '❺', text: 'Migliore stagione: maggio-giugno e settembre. Luglio-agosto è affollatissimo e caro. Novembre-aprile molti aliscafi sono sospesi.' },
        ].map(({ num, text }) => (
          <li class="flex items-start gap-4 text-sm text-charcoal">
            <span class="text-2xl font-bold text-white flex-shrink-0 leading-none mt-0.5 bg-[#E2725B] w-9 h-9 flex items-center justify-center rounded-full">{num}</span>
            <span class="leading-relaxed">{text}</span>
          </li>
        ))}
      </ul>
    </section>

    <!-- FAQ -->
    <section id="faq">
      <h2 class="font-serif text-2xl font-semibold text-slate-900 mb-6">Domande frequenti</h2>
      <div class="space-y-4">
        {faqSchema.mainEntity.map((q) => (
          <details class="group border border-slate-200 rounded-2xl overflow-hidden">
            <summary class="flex items-center justify-between px-6 py-4 cursor-pointer select-none text-charcoal font-medium hover:bg-slate-50 transition-colors">
              {q.name}
              <svg class="w-4 h-4 text-slate-400 group-open:rotate-180 transition-transform flex-shrink-0 ml-3" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
            </summary>
            <div class="px-6 pb-5 text-slate-600 leading-relaxed text-sm border-t border-slate-100 pt-4">
              {q.acceptedAnswer.text}
            </div>
          </details>
        ))}
      </div>
    </section>

    <!-- CTA -->
    <section class="bg-gradient-to-r from-med-blue to-med-blue/80 rounded-2xl p-10 text-center text-white">
      <h2 class="font-serif text-3xl font-bold mb-3">Pronto a partire verso le isole?</h2>
      <p class="text-white/90 mb-6 max-w-2xl mx-auto">
        Leggi la guida completa ai traghetti e aliscafi: orari, prezzi, compagnie di trasporto e le migliori strategie per risparmiare da Napoli.
      </p>
      <a href="/it-it/guida/traghetti/" class="inline-block bg-white text-med-blue font-semibold px-8 py-3 rounded-full hover:bg-slate-100 transition-colors">
        Guida ai traghetti →
      </a>
    </section>

  </div>

</BaseLayout>
