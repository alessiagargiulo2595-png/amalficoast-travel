---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getLocalePath } from '../../i18n/translations';

const locale = 'it-it';
const t = {
  title: 'Pagina Non Trovata',
  heading: '404',
  message: 'Oops! La pagina che stai cercando sembra essere caduta giù dalle scogliere di Positano.',
  description: 'Torniamo a scoprire la Costiera Amalfitana.',
  backHome: 'Torna alla Home',
  otherLanguages: 'Visita in altre lingue:',
  browseGuides: 'Sfoglia le nostre guide:',
  locations: 'Destinazioni',
  beaches: 'Spiagge',
  itineraries: 'Itinerari',
  transport: 'Trasporti',
  discover: 'Scopri',
};

const langHomepages = [
  { code: 'it-it', name: 'Italiano', url: '/it-it/' },
  { code: 'en-us', name: 'English', url: '/en-us/' },
  { code: 'de-de', name: 'Deutsch', url: '/de-de/' },
  { code: 'fr-fr', name: 'Français', url: '/fr-fr/' },
  { code: 'es-es', name: 'Español', url: '/es-es/' },
];

const guides = [
  { label: t.locations, url: getLocalePath(locale, 'destinations') },
  { label: t.beaches, url: getLocalePath(locale, 'beaches') },
  { label: t.itineraries, url: getLocalePath(locale, 'itineraries') },
  { label: t.transport, url: getLocalePath(locale, 'getting-here') },
];

Astro.response.status = 404;
---

<BaseLayout
  title={t.title}
  description={t.description}
  lang={locale}
>
  <section class="relative min-h-screen flex items-center justify-center bg-med-cream overflow-hidden">
    <div class="absolute top-0 left-0 w-96 h-96 rounded-full bg-med-gold/8 blur-3xl -translate-x-1/2 -translate-y-1/2 pointer-events-none"></div>
    <div class="absolute bottom-0 right-0 w-80 h-80 rounded-full bg-med-blue/8 blur-3xl translate-x-1/4 translate-y-1/4 pointer-events-none"></div>

    <div class="relative z-10 text-center px-6 max-w-4xl mx-auto">
      <div class="mb-8">
        <span class="text-9xl md:text-[150px] font-serif font-bold text-charcoal tracking-tight" style="text-shadow: 2px 2px 4px rgba(51,51,51,0.1);">404</span>
      </div>

      <p class="text-xl md:text-2xl text-slate-700 mb-6 font-light max-w-2xl mx-auto leading-relaxed">
        {t.message}
      </p>

      <p class="text-lg text-slate-600 mb-12 font-light max-w-xl mx-auto">
        {t.description}
      </p>

      <a href={`/${locale}/`}
         class="inline-block bg-slate-900 text-med-gold font-semibold px-10 py-4 rounded-full hover:bg-slate-800 hover:scale-105 transition-all duration-300 text-lg mb-20 shadow-lg hover:shadow-xl">
        {t.backHome}
      </a>
    </div>
  </section>

  <section class="py-24 bg-white">
    <div class="max-w-7xl mx-auto px-6">
      <div class="mb-16">
        <h2 class="font-serif text-4xl md:text-5xl text-slate-900 tracking-tight mb-4">{t.browseGuides}</h2>
        <div class="w-20 h-1 bg-med-gold rounded-full"></div>
      </div>

      <div class="grid grid-cols-1 grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        {guides.map(guide => (
          <a href={guide.url} class="group bg-med-cream p-8 rounded-[2rem] border border-slate-200 hover:shadow-xl transition-all duration-300 hover:scale-[1.02]">
            <div class="w-12 h-12 bg-med-gold/10 rounded-2xl flex items-center justify-center mb-4">
              <svg class="w-6 h-6 text-med-gold" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z"/></svg>
            </div>
            <h3 class="font-serif text-xl text-charcoal font-bold mb-2">{guide.label}</h3>
            <span class="text-xs sm:text-sm font-medium text-slate-600 flex items-center gap-1 group-hover:text-med-blue transition-colors">
              {t.discover}
              <svg class="w-3.5 h-3.5 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
              </svg>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="py-24 bg-med-cream">
    <div class="max-w-7xl mx-auto px-6">
      <div class="mb-16">
        <h2 class="font-serif text-4xl md:text-5xl text-slate-900 tracking-tight mb-4">{t.otherLanguages}</h2>
        <div class="w-20 h-1 bg-med-gold rounded-full"></div>
      </div>

      <div class="grid grid-cols-1 grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-4">
        {langHomepages.map(lang_option => (
          <a href={lang_option.url} class={`group p-6 rounded-[2rem] text-center font-medium transition-all duration-300 hover:scale-[1.05] border-2 ${
            lang_option.code === locale
              ? 'bg-slate-900 text-white border-slate-900'
              : 'bg-white text-charcoal border-slate-200 hover:border-med-gold hover:bg-med-cream'
          }`}>
            {lang_option.name}
          </a>
        ))}
      </div>
    </div>
  </section>

</BaseLayout>
