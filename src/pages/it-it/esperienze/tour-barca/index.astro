---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../../components/Breadcrumbs.astro';
import CorrelationSlider from '../../../../components/CorrelationSlider.astro';

const lang = 'it-it';

const breadcrumbs = [
  { name: 'Home', url: '/it-it/' },
  { name: 'Esperienze', url: '/it-it/esperienze/' },
  { name: 'Tour in Barca', url: '/it-it/esperienze/tour-barca/' },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Quanto costa un tour in barca sulla Costiera Amalfitana?",
      "acceptedAnswer": { "@type": "Answer", "text": "Un tour in barca di gruppo sulla Costiera Amalfitana (4-6 ore) costa dai €50 agli €80 a persona. I tour privati (barca a nolo senza skipper) partono da €200/giorno per imbarcazioni piccole; con skipper da €400-800/giorno. Da Capri, i giri in barchetta per la Grotta Azzurra costano ~€15." }
    },
    {
      "@type": "Question",
      "name": "Da dove partono i tour in barca?",
      "acceptedAnswer": { "@type": "Answer", "text": "I tour in barca partono principalmente da: Positano (per la Costiera e Capri), Amalfi (per la Costiera e grotte), Sorrento (per Capri e Costiera), Marina Grande di Capri (per Faraglioni e Grotta Azzurra). In estate si consiglia di prenotare con 1-2 giorni di anticipo." }
    },
    {
      "@type": "Question",
      "name": "Il tour in barca si cancella con brutto tempo?",
      "acceptedAnswer": { "@type": "Answer", "text": "Si, tutti i tour in barca vengono cancellati con mare mosso (onde oltre 0.8-1m) o vento forte. Le cancellazioni sono frequenti in aprile, ottobre e in caso di tramontana. Verifica sempre le condizioni meteo marine il giorno prima su windguru.cz o windy.com." }
    }
  ]
};

const tours = [
  { name: 'Giro dei Faraglioni di Capri', from: 'Marina Grande, Capri', duration: '1-2 ore', price: '€18-25', highlights: 'Faraglioni, Grotta Verde, passaggio sotto l\'arco di Mezzo, snorkeling', type: 'Gruppo', img: '/images/faraglioni-capri.webp' },
  { name: 'Grotta Azzurra in barchetta', from: 'Marina Grande, Capri', duration: '30 min', price: '€15 + €14 ingresso', highlights: 'Luce blu unica, barche a remi, emozione garantita', type: 'Individuale', img: '/images/marina-piccola-capri.webp' },
  { name: 'Costiera da Positano', from: 'Positano, Spiaggia Grande', duration: '4-6 ore', price: '€50-80', highlights: 'Grotta dello Smeraldo, Praiano, Amalfi dal mare, snorkeling in cale nascoste', type: 'Gruppo', img: '/images/positano-hero.webp' },
  { name: 'Costiera da Amalfi', from: 'Amalfi, porto', duration: '3-5 ore', price: '€40-70', highlights: 'Grotta dello Smeraldo, Positano, cale inaccessibili, pranzo in mare', type: 'Gruppo', img: '/images/amalfi-hero.webp' },
  { name: 'Barca privata Sorrento → Capri', from: 'Sorrento, Marina Piccola', duration: 'Giornata intera', price: '€400-800', highlights: 'Itinerario su misura, niente folla, snorkeling, pranzo a bordo', type: 'Privato', img: '/images/sorrento-hero.webp' },
  { name: 'Crociera al Tramonto', from: 'Positano / Amalfi', duration: '2-3 ore', price: '€60-90', highlights: 'Ora d\'oro, prosecco a bordo, la Costiera illuminata dalla luce del tramonto', type: 'Gruppo', img: '/images/tramonto-costiera.webp' },
];

const tips = [
  'Per la Grotta Azzurra a Capri: arriva prima delle 10:00. La coda pomeridiana puo essere di 2 ore.',
  'I tour di gruppo da Positano sono ottimi per chi viaggia da solo: conosci gente, vedi la Costiera, spendi meno.',
  'In famiglia (bambini): scegli tour max 3-4h ed evita gommoni veloci (piu rollio).',
  'La Grotta dello Smeraldo da Amalfi e raggiungibile anche a piedi (ingresso €5): non serve il tour se hai un mezzo.',
  'Prenota online almeno 1-2 giorni prima a luglio-agosto: i posti si esauriscono velocemente.',
];
---

<BaseLayout
  title="Tour in Barca Costiera Amalfitana 2026 | Capri, Positano, Grotta Azzurra"
  description="Migliori tour in barca sulla Costiera Amalfitana: Faraglioni di Capri, Grotta Azzurra, tour da Positano e Amalfi. Prezzi, durate e consigli per scegliere."
  lang={lang}
  breadcrumbs={breadcrumbs}
  schema={[faqSchema]}
  pageKey="boat-tours"
  heroImage="/images/capri-hero.webp"
>

  <!-- HERO -->
  <section class="relative h-[90svh] sm:min-h-[90vh] md:h-screen flex flex-col items-center justify-center bg-charcoal overflow-hidden">
    <img src="/images/capri-hero.webp" alt="Tour in barca, Costiera Amalfitana" referrerpolicy="no-referrer" class="absolute inset-0 w-full h-full object-cover object-center" loading="eager" fetchpriority="high" decoding="sync" />
    <div class="absolute inset-0 bg-gradient-to-b from-black/60 sm:from-black/55 via-black/40 sm:via-black/30 to-black/70 sm:to-black/65"></div>

    <div class="relative text-center px-6 max-w-4xl mx-auto md:flex md:flex-col md:justify-center">
      <p class="text-med-gold text-xs font-medium uppercase tracking-[0.3em] mb-6 mt-6">Esperienze · Mare e Barche</p>
      <h1 class="font-serif text-white leading-tight mb-6" style="font-size: clamp(2.5rem, 6vw, 5rem); letter-spacing: -0.02em;">
        Tour in <em class="not-italic text-med-gold">Barca</em>
      </h1>
      <p class="text-blue-100 text-lg md:text-xl leading-relaxed max-w-2xl mx-auto mb-[4vh] md:mb-0 font-light">
        La Costiera Amalfitana vista dal mare e un'altra cosa: grotte inaccessibili da terra, calette nascoste, i <strong>Faraglioni di Capri</strong> che ti passano sopra la testa. Dai tour di gruppo economici ai noleggi privati.
      </p>
      <div class="flex flex-row gap-3 justify-center md:mt-6">
        <a href="https://gyg.me/XJThZqw1" target="_blank" rel="sponsored noopener"
           class="inline-block bg-med-gold text-slate-900 font-semibold px-8 py-3.5 rounded-full hover:scale-105 hover:shadow-[0_8px_30px_rgba(212,175,55,0.4)] transition-all duration-300 text-xs sm:text-sm">
          Prenota su GetYourGuide
        </a>
        <a href="#tours"
           class="inline-block border-2 border-white/50 text-white font-medium px-8 py-3.5 rounded-full hover:bg-white/10 hover:border-white transition-all duration-300 text-xs sm:text-sm">
          Esplora i tour
        </a>
      </div>
    </div>

    <div class="absolute bottom-[2vh] md:bottom-[4vh] left-1/2 -translate-x-1/2 flex flex-col items-center gap-2 text-white/40 z-20">
      <svg class="w-4 h-4 animate-bounce" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
      </svg>
    </div>

    <Breadcrumbs breadcrumbs={breadcrumbs} />
  </section>

  <!-- KEY FACTS -->
  <section class="bg-white py-16">
    <div class="max-w-7xl mx-auto px-6">
      <p class="text-med-gold text-xs uppercase tracking-[0.3em] font-medium text-center mb-3">In sintesi</p>
      <div class="w-20 h-1 bg-med-gold mx-auto rounded-full mb-12"></div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 md:gap-8">
        <div class="group bg-slate-900 p-8 rounded-[2rem] border border-slate-800 hover:border-med-gold/40 transition-all duration-300">
          <div class="w-14 h-14 rounded-2xl bg-med-gold/15 text-med-gold flex items-center justify-center mb-6 group-hover:scale-110 transition-transform">
            <svg class="w-7 h-7" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6l4 2"/><circle cx="12" cy="12" r="9" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </div>
          <div class="font-serif text-5xl font-bold text-white mb-3 tracking-tight">4-6 h</div>
          <p class="text-white/80 font-medium mb-2">durata media del tour</p>
          <p class="text-white/60 text-xs sm:text-sm leading-relaxed font-light">Tour completi Costiera e Capri; opzioni brevi (1-2h) solo per i Faraglioni.</p>
        </div>

        <div class="group bg-slate-900 p-8 rounded-[2rem] border border-slate-800 hover:border-med-gold/40 transition-all duration-300">
          <div class="w-14 h-14 rounded-2xl bg-med-gold/15 text-med-gold flex items-center justify-center mb-6 group-hover:scale-110 transition-transform">
            <svg class="w-7 h-7" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 1v22M5 8h14M5 16h14"/></svg>
          </div>
          <div class="font-serif text-5xl font-bold text-white mb-3 tracking-tight">€50-80</div>
          <p class="text-white/80 font-medium mb-2">tour di gruppo, a persona</p>
          <p class="text-white/60 text-xs sm:text-sm leading-relaxed font-light">Charter privati da €400/giorno. Grotta Azzurra in barca a remi ~€15 piu €14 ingresso.</p>
        </div>

        <div class="group bg-slate-900 p-8 rounded-[2rem] border border-slate-800 hover:border-med-gold/40 transition-all duration-300">
          <div class="w-14 h-14 rounded-2xl bg-med-gold/15 text-med-gold flex items-center justify-center mb-6 group-hover:scale-110 transition-transform">
            <svg class="w-7 h-7" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0Z"/><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0Z"/></svg>
          </div>
          <div class="font-serif text-5xl font-bold text-white mb-3 tracking-tight">4</div>
          <p class="text-white/80 font-medium mb-2">porti di partenza</p>
          <p class="text-white/60 text-xs sm:text-sm leading-relaxed font-light">Positano, Amalfi, Sorrento e Marina Grande di Capri. Scegli in base alla posizione.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- TOURS GRID -->
  <section id="tours" class="py-16 bg-med-cream">
    <div class="max-w-7xl mx-auto px-6">
      <div class="flex flex-col md:flex-row justify-between items-end mb-12 gap-6">
        <div class="max-w-2xl">
          <p class="text-med-gold text-xs font-bold uppercase tracking-[0.3em] mb-3">Scegli il tuo tour</p>
          <h2 class="font-serif text-4xl md:text-5xl font-bold text-slate-900 tracking-tight mb-4">I tour piu apprezzati</h2>
          <div class="w-20 h-1 bg-med-gold rounded-full mb-4"></div>
          <p class="text-slate-500 text-lg font-light">Sei tour per ogni gusto e budget, dai Faraglioni iconici a una crociera al tramonto con prosecco a bordo.</p>
        </div>
        <a href="https://gyg.me/XJThZqw1" target="_blank" rel="sponsored noopener" class="group flex items-center gap-2 text-med-blue font-semibold hover:text-med-gold transition-colors flex-shrink-0">
          Vedi tutto su GetYourGuide
          <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {tours.map((t) => (
          <a href="https://gyg.me/XJThZqw1" target="_blank" rel="sponsored noopener" class="group cursor-pointer bg-transparent">
            <div class="relative aspect-square md:aspect-[4/5] overflow-hidden rounded-[3rem] mb-6 sm:shadow-none md:shadow-[0_20px_50px_rgba(0,0,0,0.3)]">
              <img src={t.img} alt={t.name} referrerpolicy="no-referrer" class="w-full h-full object-cover transition-transform duration-1000 group-hover:scale-110" loading="lazy" decoding="async" />
              <div class="absolute inset-0 hidden xl:block bg-gradient-to-t from-black/90 via-black/20 to-transparent" />
              <div class="absolute top-6 right-6">
                <span class={`text-[10px] uppercase tracking-wider px-3 py-1 rounded-full font-bold backdrop-blur-sm ${t.type === 'Privato' ? 'bg-med-gold/90 text-slate-900' : t.type === 'Individuale' ? 'bg-white/90 text-med-blue' : 'bg-white/80 text-slate-700'}`}>
                  {t.type}
                </span>
              </div>
              <div class="absolute bottom-8 left-8 right-8">
                <span class="text-med-gold text-xs font-bold uppercase tracking-[0.3em] mb-2 block">{t.duration} · {t.price}</span>
                <h3 class="font-serif text-xl md:text-3xl font-bold text-white tracking-tight">{t.name}</h3>
              </div>
            </div>
            <p class="text-slate-500 text-xs sm:text-sm leading-relaxed font-light mb-4">{t.highlights}</p>
            <div class="flex items-center gap-2 text-[10px] uppercase tracking-wider font-bold text-med-blue">
              <svg class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0Z"/><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0Z"/></svg>
              {t.from}
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- BANNER: Configuratore Itinerari -->
  <section class="py-10 md:py-14 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6">
      <div class="relative overflow-hidden rounded-[2.5rem] bg-gradient-to-br from-slate-900 via-slate-950 to-blue-950 px-6 sm:px-10 md:px-14 py-10 md:py-14 shadow-[0_20px_60px_rgba(0,0,0,0.35)]">
        <div class="absolute -top-20 -left-20 w-72 h-72 bg-blue-500/15 rounded-full blur-3xl pointer-events-none"></div>
        <div class="absolute -bottom-20 -right-20 w-72 h-72 bg-amber-500/10 rounded-full blur-3xl pointer-events-none"></div>

        <div class="relative z-10 grid md:grid-cols-[3fr_2fr] md:items-center gap-8">
          <div>
            <span class="inline-block px-4 py-1.5 rounded-full text-xs font-semibold tracking-wide uppercase bg-med-gold/15 text-med-gold border border-med-gold/25 mb-6">Novita: Configuratore itinerari</span>

            <h2 class="text-3xl md:text-4xl font-bold text-white leading-tight mb-2">Progetta il tuo</h2>
            <p class="font-serif text-3xl md:text-4xl italic text-med-blue mb-5">itinerario perfetto</p>

            <p class="text-white/60 text-base md:text-lg leading-relaxed max-w-xl mb-8">
              Rispondi a poche semplici domande - punto di partenza, giorni e interessi - e ottieni un itinerario personalizzato con trasporti, costi e tempi.
            </p>

            <div class="flex flex-wrap gap-6">
              <div class="flex items-center gap-2.5">
                <div class="w-9 h-9 rounded-xl bg-white/5 border border-white/10 flex items-center justify-center">
                  <svg class="w-4.5 h-4.5 text-med-gold" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                </div>
                <span class="text-white/50 text-sm">30 secondi per configurarlo</span>
              </div>
              <div class="flex items-center gap-2.5">
                <div class="w-9 h-9 rounded-xl bg-white/5 border border-white/10 flex items-center justify-center">
                  <svg class="w-4.5 h-4.5 text-med-gold" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 6.75V15m6-6v8.25m.503 3.498l4.875-2.437c.381-.19.622-.58.622-1.006V4.82c0-.836-.88-1.38-1.628-1.006l-3.869 1.934c-.317.159-.69.159-1.006 0L9.503 3.252a1.125 1.125 0 00-1.006 0L3.622 5.689C3.24 5.88 3 6.27 3 6.695V19.18c0 .836.88 1.38 1.628 1.006l3.869-1.934c.317-.159.69-.159 1.006 0l4.994 2.497c.317.158.69.158 1.006 0z"/></svg>
                </div>
                <span class="text-white/50 text-sm">Consigli anti-folla inclusi</span>
              </div>
            </div>
          </div>

          <div class="mt-8 md:mt-0 md:flex md:justify-center">
            <a href="/it-it/configuratore-itinerario/" class="inline-flex items-center gap-2.5 px-7 py-3.5 bg-gradient-to-r from-med-gold to-yellow-600 text-slate-900 font-bold rounded-xl hover:shadow-[0_0_30px_rgba(212,175,55,0.4)] hover:scale-105 transition-all duration-300">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 2L2 12l4 0 0 6 4 0 0-4 4 0 0 4 4 0 0-6 4 0L12 2z"/></svg>
              Pianifica ora
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- TIPS -->
  <section class="py-16 bg-white">
    <div class="max-w-7xl mx-auto px-6">
      <div class="text-center mb-12">
        <p class="text-med-gold text-xs font-bold uppercase tracking-[0.3em] mb-3">Consigli dei locali</p>
        <h2 class="font-serif text-4xl md:text-5xl font-bold text-slate-900 mb-4">Come scegliere il tour giusto</h2>
        <div class="w-20 h-1 bg-med-gold mx-auto rounded-full"></div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 max-w-5xl mx-auto">
        {tips.map((tip, i) => (
          <div class="group bg-med-cream p-7 rounded-[2rem] border border-med-gold/20 hover:border-med-gold/50 transition-colors flex items-start gap-4">
            <div class="w-10 h-10 rounded-xl bg-med-gold/15 text-med-gold flex-shrink-0 flex items-center justify-center font-serif font-bold text-lg">
              {String(i + 1).padStart(2, '0')}
            </div>
            <p class="text-charcoal text-xs sm:text-sm leading-relaxed pt-1.5">{tip}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section id="faq" class="py-16 bg-med-cream">
    <div class="max-w-4xl mx-auto px-6">
      <div class="text-center mb-12">
        <p class="text-med-gold text-xs font-bold uppercase tracking-[0.3em] mb-3">Da sapere</p>
        <h2 class="font-serif text-4xl md:text-5xl font-bold text-slate-900 mb-4">Domande frequenti</h2>
        <div class="w-20 h-1 bg-med-gold mx-auto rounded-full"></div>
      </div>

      <div class="space-y-4">
        {faqSchema.mainEntity.map((q) => (
          <details class="group bg-white border border-slate-200 rounded-2xl overflow-hidden hover:border-med-gold/40 transition-colors">
            <summary class="flex items-center justify-between px-6 py-5 cursor-pointer select-none text-charcoal font-medium">
              <span class="text-sm sm:text-base">{q.name}</span>
              <svg class="w-4 h-4 text-med-gold group-open:rotate-180 transition-transform flex-shrink-0 ml-3" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
            </summary>
            <div class="px-6 pb-5 text-slate-600 leading-relaxed text-xs sm:text-sm border-t border-slate-100 pt-4">
              {q.acceptedAnswer.text}
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <CorrelationSlider
    heading="Esplora le destinazioni dei tour"
    items={[
      { name: 'Capri',    href: '/it-it/isole/capri/',                       tag: 'Faraglioni',      desc: 'Grotta Azzurra, tour dei Faraglioni e calette inaccessibili.' },
      { name: 'Positano', href: '/it-it/costiera-amalfitana/positano/',       tag: 'Tour Costiera',   desc: 'Punto di partenza per i tour della Costiera verso est.' },
      { name: 'Amalfi',   href: '/it-it/costiera-amalfitana/amalfi/',         tag: 'Grotta Smeraldo', desc: 'La Grotta dello Smeraldo e i tour verso Positano.' },
      { name: 'Procida',  href: '/it-it/isole/procida/',                      tag: 'Isola Autentica', desc: 'Giri in barca attorno alla piccola isola dei pescatori.' },
    ]}
  />

</BaseLayout>
