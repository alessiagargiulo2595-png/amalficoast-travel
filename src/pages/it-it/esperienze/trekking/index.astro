---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../../components/Breadcrumbs.astro';
import CorrelationSlider from '../../../../components/CorrelationSlider.astro';

const lang = 'it-it';

const breadcrumbs = [
  { name: 'Home', url: '/it-it/' },
  { name: 'Esperienze', url: '/it-it/esperienze/' },
  { name: 'Trekking e Sentiero degli Dei', url: '/it-it/esperienze/trekking/' },
];

const trails = [
  { name: 'Sentiero degli Dei', difficulty: 'EE', km: '8 km', time: '3–4h', start: 'Agerola (S. Lazzaro)', end: 'Nocelle (Positano)', highlights: 'Vista costiera mozzafiato, flora mediterranea, niente asfalto', cta: { href: '/it-it/itinerari/1-giorno/trekking-sentiero-degli-dei/' } },
  { name: 'Valle delle Ferriere', difficulty: 'E', km: '7 km A/R', time: '2.5–3h', start: 'Amalfi centro', end: 'Amalfi (ritorno)', highlights: 'Cascate, felci tropicali, papiri selvatici, ombra naturale', cta: { href: '/it-it/blog/valle-delle-ferriere/' } },
  { name: 'Via dell\'Infinito (Ravello)', difficulty: 'E', km: '5 km A/R', time: '2h', start: 'Ravello', end: 'Ravello', highlights: 'Vista panoramica sulla costiera, oliveti, silenzio totale' },
  { name: 'Punta Campanella', difficulty: 'E', km: '6 km A/R', time: '2.5h', start: 'Termini (Massa Lubrense)', end: 'Termini', highlights: 'Punta più a sud, rovine romane, vista su Capri, riserva marina', cta: { href: '/it-it/blog/punta-campanella/' } },
  { name: 'Fiordo di Furore', difficulty: 'E', km: '3 km A/R', time: '1.5–2h', start: 'Furore', end: 'Furore', highlights: 'Fiordo nascosto, cascata, piscina naturale, sorgente d\'acqua dolce', cta: { href: '/it-it/spiagge/costiera-amalfitana/fiordo-di-furore/' } },
  { name: 'Baia di Ieranto', difficulty: 'E', km: '4 km A/R', time: '1.5–2h', start: 'Termini (Massa Lubrense)', end: 'Termini', highlights: 'Spiaggia selvaggia isolata, cala cristallina, area protetta, vista mare', cta: { href: '/it-it/spiagge/penisola-sorrentina/ieranto/' } },
  { name: 'Monte Solaro (Capri)', difficulty: 'E', km: '4 km', time: '2h (salita)', start: 'Anacapri', end: 'Anacapri (seggiovia ritorno)', highlights: '589 m, panorama 360°, santuario, silenzio' },
  { name: 'Fiordo di Crapolla', difficulty: 'E', km: '6 km A/R', time: '2.5h', start: 'Via Casal di Torca (Massa Lubrense)', end: 'Via Casal di Torca', highlights: '700 scalini, scalinata in roccia, cappella medievale, rovine romane, riserva marina', cta: { href: '/it-it/blog/fiordo-di-crapolla/' } },
  { name: 'Reccumone', difficulty: 'E', km: '0.5 km A/R', time: '15–20 min', start: 'Marina del Cantone (Nerano)', end: 'Marina del Cantone', highlights: 'Spiaggia selvaggia e attrezzata, acque cristalline, accesso pedonale o via mare, ristorante', cta: { href: '/it-it/blog/baia-recommone/' } },
  { name: 'Sentiero dei Limoni', difficulty: 'E', km: '6 km', time: '2–2.5h', start: 'Maiori', end: 'Minori (o viceversa)', highlights: 'Limoneti terrazzati, pergolati, profumo di agrumi, vista mare, antico sentiero', cta: { href: '/it-it/costiera-amalfitana/maiori/' } },
  { name: 'Torre dello Ziro', difficulty: 'E', km: '4 km A/R', time: '1.5–2h', start: 'Amalfi / Pontone (Scala)', end: 'Amalfi / Pontone', highlights: 'Torre medievale, panorama 360° su Amalfi e Atrani, sentiero nella macchia mediterranea', cta: { href: '/it-it/costiera-amalfitana/amalfi/' } },
];
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    { "@type": "Question", "name": "Il trekking in Costiera Amalfitana è difficile?",
      "acceptedAnswer": { "@type": "Answer", "text": "Dipende dal sentiero. Quasi tutti i percorsi sono classificati E (escursionistico): qualche ora di cammino su mulattiere e gradini, senza richieste tecniche. Solo il Sentiero degli Dei porta la sigla EE, più impegnativa, per via di alcuni tratti esposti senza parapetto. La vera fatica qui non è il dislivello ma i gradini: quasi ogni percorso comincia o finisce con diverse centinaia di scalini." } },
    { "@type": "Question", "name": "Qual è il sentiero più bello della Costiera Amalfitana?",
      "acceptedAnswer": { "@type": "Answer", "text": "Il Sentiero degli Dei è il percorso simbolo: 8 km da Agerola a Nocelle, 3 o 4 ore camminando alti sul mare con Positano e Capri quasi sempre in vista. Se cerchi qualcosa di più dolce e ombreggiato, la Valle delle Ferriere sopra Amalfi è un anello di 7 km tra cascate e felci." } },
    { "@type": "Question", "name": "Qual è il periodo migliore per fare trekking in Costiera?",
      "acceptedAnswer": { "@type": "Answer", "text": "Da aprile a inizio giugno e da settembre a ottobre. Le temperature stanno tra 16 e 24°C, la luce è limpida e i sentieri sono asciutti. Luglio e agosto sono davvero punitivi: quasi nessun percorso ha ombra o punti acqua, e a mezzogiorno si arriva a 32°C. In inverno si cammina, ma i sentieri diventano fangosi e la pietra scivolosa." } },
    { "@type": "Question", "name": "In che direzione va percorso il Sentiero degli Dei?",
      "acceptedAnswer": { "@type": "Answer", "text": "Da Agerola verso Nocelle, in discesa. Al contrario significa salire circa 500 metri di dislivello in pieno sole, e ritrovarsi i 1.500 gradini per Positano ancora davanti anziché alle spalle. Prendi il bus SITA da Amalfi ad Agerola la mattina presto e cammina verso il mare." } },
    { "@type": "Question", "name": "Serve una guida per i sentieri della Costiera?",
      "acceptedAnswer": { "@type": "Answer", "text": "No. Il Sentiero degli Dei e gli altri percorsi principali sono segnati con i segnavia bianco-rossi del CAI e abbastanza frequentati da non restare mai soli. Una guida ha senso se vuoi capire storia e vegetazione, se cammini in bassa stagione quando i sentieri si svuotano, o per itinerari meno ovvi come il Fiordo di Crapolla." } },
    { "@type": "Question", "name": "Che scarpe servono per camminare in Costiera Amalfitana?",
      "acceptedAnswer": { "@type": "Answer", "text": "Scarpe da trekking o da trail con suola in gomma ben scolpita. Il calcare qui è levigato da secoli di passaggio e diventa insidioso al minimo velo di polvere o umidità. Sandali e sneaker a suola liscia causano ogni estate la maggior parte delle distorsioni sul Sentiero degli Dei." } },
    { "@type": "Question", "name": "Come si raggiunge la partenza del Sentiero degli Dei?",
      "acceptedAnswer": { "@type": "Answer", "text": "Da Amalfi con il bus SITA per Agerola, circa 45 minuti, scendendo a Bomerano (San Lazzaro). Le corse sono poche, quindi conviene partire da Amalfi verso le 8:30 per prendere quella delle 9:15. Da Positano bisogna prima raggiungere Amalfi, il che allunga molto la mattinata: chi cammina spesso dorme ad Agerola la sera prima." } },
    { "@type": "Question", "name": "Si può andare a piedi da un paese all’altro della Costiera?",
      "acceptedAnswer": { "@type": "Answer", "text": "Sì. La costa è attraversata da una rete antica di mulattiere e scalinate che collegava i borghi prima che esistesse la statale 163. Il Sentiero dei Limoni tra Maiori e Minori è l’esempio più semplice, circa 2 km. Anche Nocelle-Positano e Ravello-Atrani trasformano uno spostamento in una camminata." } },
  ]
};

---

<BaseLayout
  title="Trekking in Costiera Amalfitana 2026 | Sentiero degli Dei e 9 percorsi"
  description="Trekking in Costiera Amalfitana: 9 percorsi a confronto per difficoltà, lunghezza e durata, dal Sentiero degli Dei (Agerola-Nocelle) alla Valle delle Ferriere. Quando camminare, cosa portare e come raggiungere ogni partenza."
  lang={lang}
  breadcrumbs={breadcrumbs}
  pageKey="trekking"
  schema={[faqSchema]}

  heroImage="/images/trekking-hero.jpg"
>

  <section class="relative min-h-[75vh] flex items-end bg-charcoal overflow-hidden">
    <img src="/images/trekking-hero.jpg" alt="Sentiero degli Dei, Costiera Amalfitana" class="absolute inset-0 w-full h-full object-cover" loading="eager" fetchpriority="high" decoding="sync" referrerpolicy="no-referrer"/>
    
    <div class="absolute inset-0 bg-gradient-to-b from-black/75 via-black/40 to-black/70"></div>
    <div class="relative z-10 max-w-7xl mx-auto px-6 pb-16 pt-32">
      <div class="max-w-3xl">
        <p class="text-med-gold text-xs sm:text-sm font-medium uppercase tracking-[0.3em] mb-3">Esperienze</p>
        <h1 class="font-serif text-display text-white mb-4">Trekking in Costiera Amalfitana</h1>
        <p class="text-xl text-white/80 leading-relaxed max-w-2xl">
          La Costiera Amalfitana non è solo spiagge e traghetti: è anche uno dei paesaggi più spettacolari d'Europa da percorrere a piedi. Dal leggendario Sentiero degli Dei alle cascate della Valle delle Ferriere.
        </p>
      </div>
    </div>
    <Breadcrumbs breadcrumbs={breadcrumbs} />
  </section>

  <div class="max-w-editorial mx-auto px-4 sm:px-6 lg:px-8 py-16 space-y-12">

    <section>
      <h2 class="font-serif text-3xl font-bold text-slate-900 mb-3 text-center">I percorsi imprescindibili</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {trails.map((t, i) => {
          const isGold = i % 2 === 0;
          return (
          <div class={`border rounded-[2rem] p-7 hover:shadow-lg transition-all w-full sm:w-auto ${isGold ? 'bg-med-gold border-med-gold' : 'bg-med-blue border-med-blue'}`}>
            <div class="mb-5">
              <h3 class={`font-bold text-lg mb-3 ${isGold ? 'text-charcoal' : 'text-white'}`}>{t.name}</h3>
              <span class={`text-[10px] uppercase tracking-wide px-3 py-1.5 rounded-full font-medium flex-shrink-0 w-fit ${t.difficulty === 'EE' ? 'bg-red-50 text-red-600' : isGold ? 'bg-white/40 text-charcoal' : 'bg-white/20 text-white'}`}>
                {t.difficulty === 'EE' ? 'EE - Impegnativo' : 'E - Medio'}
              </span>
            </div>
            <div class="space-y-3 mb-5">
              <div><span class={`text-xs font-semibold ${isGold ? 'text-charcoal/70' : 'text-white/70'}`}>DISTANZA</span><br /><span class={`font-semibold ${isGold ? 'text-charcoal' : 'text-white'}`}>{t.km}</span></div>
              <div><span class={`text-xs font-semibold ${isGold ? 'text-charcoal/70' : 'text-white/70'}`}>TEMPO</span><br /><span class={`font-semibold ${isGold ? 'text-charcoal' : 'text-white'}`}>{t.time}</span></div>
              <div><span class={`text-xs font-semibold ${isGold ? 'text-charcoal/70' : 'text-white/70'}`}>PARTENZA</span><br /><span class={`font-semibold text-sm ${isGold ? 'text-charcoal' : 'text-white'}`}>{t.start}</span></div>
              <div><span class={`text-xs font-semibold ${isGold ? 'text-charcoal/70' : 'text-white/70'}`}>ARRIVO</span><br /><span class={`font-semibold text-sm ${isGold ? 'text-charcoal' : 'text-white'}`}>{t.end}</span></div>
            </div>
            <p class={`text-xs sm:text-sm leading-relaxed font-medium mb-4 ${isGold ? 'text-charcoal' : 'text-white'}`}>{t.highlights}</p>
            {t.cta && (
              <a href={t.cta.href} class={`inline-flex items-center gap-2 font-semibold text-xs px-4 py-2 rounded-lg transition-all ${isGold ? 'bg-med-blue text-white hover:bg-med-blue/90' : 'bg-med-gold text-white hover:bg-med-gold/90'}`}>
                Scopri di più →
              </a>
            )}
          </div>
        );
        })}
      </div>
    </section>

    <!-- Sentiero degli Dei - Approfondimento -->
    <section>
      <h2 class="font-serif text-3xl font-semibold text-slate-900 mb-6">Il Sentiero degli Dei: da Agerola a Nocelle</h2>
      <p class="text-slate-600 leading-relaxed mb-6">Il <strong>Sentiero degli Dei</strong> è il trekking più famoso della Costiera Amalfitana e uno dei percorsi escursionistici più spettacolari d'Europa. Si sviluppa per 8 km lungo il crinale tra Agerola e Nocelle (Positano), a un'altitudine media di 500 metri sul livello del mare, con panorami costanti su <a href="/it-it/isole/capri/" class="text-med-blue hover:underline">Capri</a>, i Faraglioni e l'intera costiera.</p>
      <p class="text-slate-600 leading-relaxed mb-6">Il sentiero parte dalla località Bomerano di <a href="/it-it/costiera-amalfitana/agerola/" class="text-med-blue hover:underline">Agerola</a> (raggiungibile in bus SITA da Amalfi) e termina a Nocelle, una frazione di <a href="/it-it/costiera-amalfitana/positano/" class="text-med-blue hover:underline">Positano</a> aggrappata alla montagna. Da Nocelle si scende a Positano con circa 1.700 gradini (45 min) o con il bus locale. Il percorso è classificato EE (Escursionisti Esperti) ma è tecnicamente accessibile a chi ha un minimo di allenamento e scarpe adeguate.</p>
      <div class="bg-slate-50 rounded-2xl p-6">
        <h3 class="font-semibold text-charcoal mb-3">Scheda tecnica</h3>
        <div class="grid sm:grid-cols-2 gap-4 text-xs sm:text-sm text-slate-600">
          <div><strong>Distanza:</strong> 8 km (solo andata)</div>
          <div><strong>Durata:</strong> 3–4 ore</div>
          <div><strong>Dislivello:</strong> +200m / -600m</div>
          <div><strong>Difficoltà:</strong> EE (Escursionisti Esperti)</div>
          <div><strong>Partenza:</strong> Bomerano, Agerola (600m slm)</div>
          <div><strong>Arrivo:</strong> Nocelle, Positano (420m slm)</div>
          <div><strong>Periodo:</strong> Aprile–ottobre (evitare luglio–agosto)</div>
          <div><strong>Acqua:</strong> Nessun punto acqua sul percorso</div>
        </div>
      </div>
    </section>

    <!-- Sentiero dei Limoni -->
    <section>
      <h2 class="font-serif text-3xl font-semibold text-slate-900 mb-6">Il Sentiero dei Limoni: Maiori–Minori</h2>
      <p class="text-slate-600 leading-relaxed mb-6">Il <strong>Sentiero dei Limoni</strong> è un antico percorso pedonale che collega <a href="/it-it/costiera-amalfitana/maiori/" class="text-med-blue hover:underline">Maiori</a> a <a href="/it-it/costiera-amalfitana/minori/" class="text-med-blue hover:underline">Minori</a> attraverso i terrazzamenti coltivati a limoni che hanno reso famosa la costiera amalfitana. Lungo circa 6 km, si percorre in 2–2,5 ore e non presenta difficoltà tecniche.</p>
      <p class="text-slate-600 leading-relaxed mb-6">Il sentiero attraversa pergolati di limoni sfusati IGP, giardini terrazzati con vista sul mare, cappelle rurali e antiche case coloniche. Il profumo di agrumi è costante, soprattutto in primavera quando le piante sono in fiore. È il percorso perfetto per chi cerca un trekking facile e panoramico, lontano dalla folla del Sentiero degli Dei.</p>
      <div class="bg-slate-50 rounded-2xl p-6">
        <h3 class="font-semibold text-charcoal mb-3">Scheda tecnica</h3>
        <div class="grid sm:grid-cols-2 gap-4 text-xs sm:text-sm text-slate-600">
          <div><strong>Distanza:</strong> 6 km (solo andata)</div>
          <div><strong>Durata:</strong> 2–2,5 ore</div>
          <div><strong>Dislivello:</strong> +300m / -300m</div>
          <div><strong>Difficoltà:</strong> E (Escursionistico)</div>
          <div><strong>Partenza:</strong> Maiori o Minori</div>
          <div><strong>Periodo:</strong> Tutto l'anno (ideale marzo–giugno)</div>
        </div>
      </div>
    </section>

    <!-- Torre dello Ziro -->
    <section>
      <h2 class="font-serif text-3xl font-semibold text-slate-900 mb-6">Torre dello Ziro: il panorama su Amalfi e Atrani</h2>
      <p class="text-slate-600 leading-relaxed mb-6">La <strong>Torre dello Ziro</strong> è una torre di avvistamento medievale situata sulla cresta tra <a href="/it-it/costiera-amalfitana/amalfi/" class="text-med-blue hover:underline">Amalfi</a> e Atrani, a circa 270 metri sul livello del mare. Offre uno dei panorami a 360° più spettacolari della costiera: da un lato Amalfi con il Duomo e la valle, dall'altro Atrani incastonata nella roccia, e all'orizzonte il mare aperto.</p>
      <p class="text-slate-600 leading-relaxed mb-6">Il sentiero parte dalla frazione di Pontone (Scala), raggiungibile in bus o a piedi da Amalfi (circa 30 minuti di salita). Dalla torre il panorama abbraccia anche <a href="/it-it/costiera-amalfitana/ravello/" class="text-med-blue hover:underline">Ravello</a>, i terrazzamenti coltivati e la Riserva della Valle delle Ferriere. Un'escursione breve (4 km A/R, 1,5–2 ore) ma appagante, quasi sconosciuta al turismo di massa.</p>
      <div class="bg-slate-50 rounded-2xl p-6">
        <h3 class="font-semibold text-charcoal mb-3">Scheda tecnica</h3>
        <div class="grid sm:grid-cols-2 gap-4 text-xs sm:text-sm text-slate-600">
          <div><strong>Distanza:</strong> 4 km A/R</div>
          <div><strong>Durata:</strong> 1,5–2 ore</div>
          <div><strong>Dislivello:</strong> +270m</div>
          <div><strong>Difficoltà:</strong> E (Escursionistico)</div>
          <div><strong>Partenza:</strong> Pontone (Scala) o Amalfi centro</div>
          <div><strong>Periodo:</strong> Tutto l'anno</div>
        </div>
      </div>
    </section>

    <section class="bg-charcoal text-white rounded-[2rem] p-8">
      <h2 class="font-serif text-2xl font-bold text-med-gold mb-8">Guida rapida ai sentieri della costiera</h2>
      <div class="grid sm:grid-cols-2 gap-6">
        <div>
          <p class="text-white/60 text-xs sm:text-sm mb-1">Come arrivare all'inizio</p>
          <p class="text-xs sm:text-sm leading-relaxed">Da Amalfi: bus SITA per Agerola (corse limitate, ~45 min). Consigliato partire da Amalfi alle 8:30 per prendere il bus delle 9:15 per Agerola.</p>
        </div>
        <div>
          <p class="text-white/60 text-xs sm:text-sm mb-1">Come tornare dalla fine</p>
          <p class="text-xs sm:text-sm leading-relaxed">Da Nocelle: bus locale per Positano centro (~15 min) o discesa a piedi (~1.000 gradini, 45 min). Da Positano: bus SITA o traghetto per Amalfi/Sorrento/Napoli.</p>
        </div>
        <div>
          <p class="text-white/60 text-xs sm:text-sm mb-1">Cosa portare</p>
          <p class="text-xs sm:text-sm leading-relaxed">Scarpe da trekking (non sandali), 1.5L acqua, cappello, crema solare, snack, giacca leggera. Il sentiero non ha punti acqua o negozi.</p>
        </div>
        <div>
          <p class="text-white/60 text-xs sm:text-sm mb-1">Stagione ideale</p>
          <p class="text-xs sm:text-sm leading-relaxed">Aprile–giugno e settembre–ottobre. In luglio e agosto il calore rende il percorso estenuante e affollato. In inverno possibile ma con fango e sentiero sdrucciolevole.</p>
        </div>
      </div>
    </section>


    <!-- Quale sentiero scegliere -->
    <section>
      <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">Quale sentiero scegliere</h2>
      <p class="text-slate-600 text-lg leading-relaxed mb-8">Nove opzioni sono troppe per un solo viaggio. Nella pratica la scelta dipende da quanto tempo hai e da cosa vuoi trovare alla fine.</p>
      <ul class="space-y-4 text-slate-600">
        <li class="flex items-start gap-3">
          <span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span>
          <span class="text-slate-700"><strong>Una sola camminata, e deve essere quella famosa.</strong> Il <a href="/it-it/itinerari/1-giorno/trekking-sentiero-degli-dei/" class="text-med-blue hover:underline">Sentiero degli Dei</a>. Nient’altro in costiera restituisce lo stesso rapporto tra fatica e panorama, e si finisce a <a href="/it-it/costiera-amalfitana/positano/" class="text-med-blue hover:underline">Positano</a> con un bagno ad aspettarti.</span>
        </li>
        <li class="flex items-start gap-3">
          <span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span>
          <span class="text-slate-700"><strong>Sei qui a luglio o agosto.</strong> La <a href="/it-it/blog/valle-delle-ferriere/" class="text-med-blue hover:underline">Valle delle Ferriere</a>, l’unico percorso importante con ombra vera e acqua corrente. Una gola umida sopra <a href="/it-it/costiera-amalfitana/amalfi/" class="text-med-blue hover:underline">Amalfi</a> piena di felci che crescono lì dall’ultima glaciazione.</span>
        </li>
        <li class="flex items-start gap-3">
          <span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span>
          <span class="text-slate-700"><strong>Cammini con bambini o dopo un pranzo importante.</strong> Il <a href="/it-it/blog/sentiero-dei-limoni/" class="text-med-blue hover:underline">Sentiero dei Limoni</a> tra Maiori e Minori, circa 2 km sotto le pergole, oppure l’anello della Via dell’Infinito a <a href="/it-it/costiera-amalfitana/ravello/" class="text-med-blue hover:underline">Ravello</a>.</span>
        </li>
        <li class="flex items-start gap-3">
          <span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span>
          <span class="text-slate-700"><strong>Vuoi che la camminata finisca in spiaggia.</strong> La <a href="/it-it/spiagge/penisola-sorrentina/ieranto/" class="text-med-blue hover:underline">Baia di Ieranto</a> o il <a href="/it-it/blog/fiordo-di-crapolla/" class="text-med-blue hover:underline">Fiordo di Crapolla</a>, entrambi sulla penisola sorrentina e raggiungibili solo a piedi o via mare, che è esattamente il motivo per cui restano tranquilli.</span>
        </li>
        <li class="flex items-start gap-3">
          <span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span>
          <span class="text-slate-700"><strong>Hai mezza giornata sulle isole.</strong> Il Monte Solaro a <a href="/it-it/isole/capri/" class="text-med-blue hover:underline">Capri</a>: si sale da Anacapri in due ore e si torna con la seggiovia, o viceversa se le ginocchia preferiscono così.</span>
        </li>
      </ul>
    </section>

    <!-- Difficolta -->
    <section>
      <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">Cosa significano i gradi di difficoltà</h2>
      <p class="text-slate-600 text-lg leading-relaxed mb-8">Le schede qui sopra usano la scala del Club Alpino Italiano, la stessa che trovi sui segnavia bianco-rossi lungo i sentieri. Due sigle coprono tutto quello che c’è in costiera.</p>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div class="bg-white p-6 rounded-[2rem] border border-slate-100 shadow-sm">
          <p class="text-med-gold text-xs font-medium uppercase tracking-[0.2em] mb-2">Grado E</p>
          <h3 class="font-bold text-slate-900 mb-2 text-lg">Escursionistico, nessuna esperienza richiesta</h3>
          <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Un sentiero segnato con fondo evidente. Servono una forma fisica ragionevole e scarpe decenti, nulla di più. Otto dei nove percorsi qui stanno a questo grado, Valle delle Ferriere e tutta la penisola sorrentina compresi.</p>
        </div>
        <div class="bg-white p-6 rounded-[2rem] border border-slate-100 shadow-sm">
          <p class="text-med-gold text-xs font-medium uppercase tracking-[0.2em] mb-2">Grado EE</p>
          <h3 class="font-bold text-slate-900 mb-2 text-lg">Per escursionisti esperti, serve passo sicuro</h3>
          <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Solo il Sentiero degli Dei. La sigla nasce da brevi tratti esposti dove il sentiero si stringe sopra un salto notevole senza parapetto. Non c’è arrampicata né attrezzatura, ma non è il posto dove scoprire di soffrire il vuoto.</p>
        </div>
      </div>
      <p class="text-slate-600 text-lg leading-relaxed mt-8">Nessuno dei due gradi però ti prepara alla vera firma di questa costa, cioè le scale. La discesa da Nocelle a Positano sono circa 1.500 gradini, Crapolla ne conta circa 700, e per quasi tutte le spiagge la distanza si misura in rampe più che in metri. È la discesa a lasciare le gambe doloranti il giorno dopo, quindi qui i bastoncini valgono più di quanto il dislivello lasci pensare.</p>
    </section>

    <!-- Stagione -->
    <section>
      <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">Quando camminare, e quando no</h2>
      <p class="text-slate-600 text-lg leading-relaxed mb-8">La stagione conta più che in altre destinazioni da trekking, perché questi sentieri sono calcare esposto a sud, quasi senza alberi e senza punti acqua lungo il percorso.</p>
      <div class="overflow-hidden rounded-[2rem] border border-slate-100 shadow-sm">
        <table class="w-full text-xs sm:text-sm">
          <thead class="bg-slate-900 text-white">
            <tr>
              <th class="text-left p-5 font-serif font-bold text-med-gold">Periodo</th>
              <th class="text-left p-5 font-serif font-bold text-med-gold">Condizioni</th>
              <th class="text-left p-5 font-serif font-bold text-med-gold">Giudizio</th>
            </tr>
          </thead>
          <tbody class="bg-white">
            <tr class="border-b border-slate-100">
              <td class="p-5 font-bold">Da aprile a inizio giugno</td>
              <td class="p-5 text-slate-600">13-24°C, versanti in fiore, sentieri asciutti</td>
              <td class="p-5 text-slate-600">La finestra migliore dell’anno</td>
            </tr>
            <tr class="border-b border-slate-100">
              <td class="p-5 font-bold">Fine giugno</td>
              <td class="p-5 text-slate-600">Caldo in aumento, giornate lunghe</td>
              <td class="p-5 text-slate-600">Va bene partendo all’alba</td>
            </tr>
            <tr class="border-b border-slate-100">
              <td class="p-5 font-bold">Luglio e agosto</td>
              <td class="p-5 text-slate-600">Fino a 32°C, zero ombra, indice UV 9-10</td>
              <td class="p-5 text-slate-600">Prima delle 8:00 o mai</td>
            </tr>
            <tr class="border-b border-slate-100">
              <td class="p-5 font-bold">Settembre e ottobre</td>
              <td class="p-5 text-slate-600">16-27°C, aria limpida, meno gente</td>
              <td class="p-5 text-slate-600">Come la primavera, con il mare più caldo</td>
            </tr>
            <tr class="border-b border-slate-100">
              <td class="p-5 font-bold">Da novembre a marzo</td>
              <td class="p-5 text-slate-600">Pioggia, fango, pietra levigata</td>
              <td class="p-5 text-slate-600">Possibile, e spesso deserto</td>
            </tr>
          </tbody>
        </table>
      </div>
      <p class="text-slate-600 text-lg leading-relaxed mt-8">Se le date cadono per forza in piena estate, la soluzione è l’orologio più che il calendario. Parti con la prima luce, scendi dal crinale entro le undici e passa il pomeriggio a livello del mare. Per il quadro completo di temperature e mare durante l’anno c’è la guida su <a href="/it-it/guida/quando-visitare/" class="text-med-blue hover:underline">quando visitare la costiera</a>.</p>
    </section>

    <!-- FAQ -->
    <section>
      <h2 class="font-serif text-3xl font-bold text-slate-900 mb-8">Domande frequenti</h2>
      <div class="space-y-4">
        {faqSchema.mainEntity.map((item) => (
          <details class="bg-white rounded-[2rem] border border-slate-100 shadow-sm p-6 group">
            <summary class="font-bold text-slate-900 cursor-pointer list-none flex items-start justify-between gap-4">
              <span>{item.name}</span>
              <span class="text-med-gold flex-shrink-0 transition-transform group-open:rotate-45">+</span>
            </summary>
            <p class="text-slate-600 text-xs sm:text-sm leading-relaxed mt-4">{item.acceptedAnswer.text}</p>
          </details>
        ))}
      </div>
    </section>

  </div>

