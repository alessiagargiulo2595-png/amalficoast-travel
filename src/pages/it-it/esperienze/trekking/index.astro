---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../../components/Breadcrumbs.astro';
import CorrelationSlider from '../../../../components/CorrelationSlider.astro';

const lang = 'it-it';

const breadcrumbs = [
  { name: 'Home', url: '/it-it/' },
  { name: 'Esperienze', url: '/it-it/esperienze/' },
  { name: 'Trekking & Sentiero degli Dei', url: '/it-it/esperienze/trekking/' },
];

const trails = [
  { name: 'Sentiero degli Dei', difficulty: 'EE', km: '8 km', time: '3–4h', start: 'Agerola (S. Lazzaro)', end: 'Nocelle (Positano)', highlights: 'Vista costiera mozzafiato, flora mediterranea, niente asfalto', cta: { href: '/it-it/itinerari/1-giorno/trekking-sentiero-degli-dei/' } },
  { name: 'Valle delle Ferriere', difficulty: 'E', km: '7 km A/R', time: '2.5–3h', start: 'Amalfi centro', end: 'Amalfi (ritorno)', highlights: 'Cascate, felci tropicali, papiri selvatici, ombra naturale', cta: { href: '/it-it/blog/valle-delle-ferriere/' } },
  { name: 'Via dell\'Infinito (Ravello)', difficulty: 'E', km: '5 km A/R', time: '2h', start: 'Ravello', end: 'Ravello', highlights: 'Vista panoramica sulla costiera, oliveti, silenzio totale' },
  { name: 'Punta Campanella', difficulty: 'E', km: '6 km A/R', time: '2.5h', start: 'Termini (Massa Lubrense)', end: 'Termini', highlights: 'Punta più a sud, rovine romane, vista su Capri, riserva marina', cta: { href: '/it-it/blog/punta-campanella/' } },
  { name: 'Fiordo di Furore', difficulty: 'E', km: '3 km A/R', time: '1.5–2h', start: 'Furore', end: 'Furore', highlights: 'Fiordo nascosto, cascata, piscina naturale, sorgente d\'acqua dolce', cta: { href: '/it-it/spiagge/costiera-amalfitana/fiordo-di-furore/' } },
  { name: 'Baia di Ieranto', difficulty: 'E', km: '4 km A/R', time: '1.5–2h', start: 'Termini (Massa Lubrense)', end: 'Termini', highlights: 'Spiaggia selvaggia isolata, cala cristallina, area protetta, vista mare', cta: { href: '/it-it/spiagge/penisola-sorrentina/ieranto/' } },
  { name: 'Monte Solaro (Capri)', difficulty: 'E', km: '4 km', time: '2h (salita)', start: 'Anacapri', end: 'Anacapri (seggiovia ritorno)', highlights: '589 m, panorama 360°, santuario, silenzio' },
  { name: 'Fiordo di Crapolla', difficulty: 'E', km: '6 km A/R', time: '2.5h', start: 'Via Casal di Torca (Massa Lubrense)', end: 'Via Casal di Torca', highlights: '700 scalini, scalinata in roccia, cappella medievale, rovine romane, riserva marina', cta: { href: '/it-it/blog/fiordo-di-crapolla/' } },
  { name: 'Reccumone', difficulty: 'E', km: '0.5 km A/R', time: '15–20 min', start: 'Marina del Cantone (Nerano)', end: 'Marina del Cantone', highlights: 'Spiaggia selvaggia e attrezzata, acque cristalline, accesso pedonale o via mare, ristorante', cta: { href: '/it-it/blog/baia-recommone/' } },
];
---

<BaseLayout
  title="Trekking Costiera Amalfitana 2026 | Sentiero degli Dei e Percorsi"
  description="I migliori percorsi di trekking sulla Costiera Amalfitana: Sentiero degli Dei (Agerola-Nocelle), Valle delle Ferriere, Punta Campanella. Difficoltà, orari e come arrivare."
  lang={lang}
  breadcrumbs={breadcrumbs}
  pageKey="trekking"
>

  <section class="relative min-h-[75vh] flex items-end bg-charcoal overflow-hidden">
    <img src="/images/trekking-hero.jpg" alt="Sentiero degli Dei, Costiera Amalfitana" class="absolute inset-0 w-full h-full object-cover" loading="eager" referrerpolicy="no-referrer"/>
    
    <div class="absolute inset-0 bg-gradient-to-b from-black/20 via-black/40 to-black/80"></div>
    <div class="relative z-10 max-w-7xl mx-auto px-6 pb-16 pt-32">
      <div class="max-w-3xl">
        <p class="text-med-gold text-xs sm:text-sm font-medium uppercase tracking-[0.3em] mb-3">Esperienze</p>
        <h1 class="font-serif text-display text-white mb-4">Trekking & Sentiero degli Dei</h1>
        <p class="text-xl text-white/80 leading-relaxed max-w-2xl">
          La Costiera Amalfitana non è solo spiagge e traghetti: è anche uno dei paesaggi più spettacolari d\'Europa da percorrere a piedi. Dal leggendario Sentiero degli Dei alle cascate della Valle delle Ferriere.
        </p>
      </div>
    </div>
    <Breadcrumbs breadcrumbs={breadcrumbs} />
  </section>

  <div class="max-w-editorial mx-auto px-4 sm:px-6 lg:px-8 py-16 space-y-12">

    <section>
      <h2 class="font-serif text-3xl font-bold text-slate-900 mb-3 text-center">I percorsi imprescindibili</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {trails.map((t, i) => {
          const isGold = i % 2 === 0;
          return (
          <div class={`border rounded-[2rem] p-7 hover:shadow-lg transition-all ${isGold ? 'bg-med-gold border-med-gold' : 'bg-med-blue border-med-blue'}`}>
            <div class="mb-5">
              <h3 class={`font-bold text-lg mb-3 ${isGold ? 'text-charcoal' : 'text-white'}`}>{t.name}</h3>
              <span class={`text-[10px] uppercase tracking-wide px-3 py-1.5 rounded-full font-medium flex-shrink-0 w-fit ${t.difficulty === 'EE' ? 'bg-red-50 text-red-600' : isGold ? 'bg-white/40 text-charcoal' : 'bg-white/20 text-white'}`}>
                {t.difficulty === 'EE' ? 'EE - Impegnativo' : 'E - Medio'}
              </span>
            </div>
            <div class="space-y-3 mb-5">
              <div><span class={`text-xs font-semibold ${isGold ? 'text-charcoal/70' : 'text-white/70'}`}>DISTANZA</span><br /><span class={`font-semibold ${isGold ? 'text-charcoal' : 'text-white'}`}>{t.km}</span></div>
              <div><span class={`text-xs font-semibold ${isGold ? 'text-charcoal/70' : 'text-white/70'}`}>TEMPO</span><br /><span class={`font-semibold ${isGold ? 'text-charcoal' : 'text-white'}`}>{t.time}</span></div>
              <div><span class={`text-xs font-semibold ${isGold ? 'text-charcoal/70' : 'text-white/70'}`}>PARTENZA</span><br /><span class={`font-semibold text-sm ${isGold ? 'text-charcoal' : 'text-white'}`}>{t.start}</span></div>
              <div><span class={`text-xs font-semibold ${isGold ? 'text-charcoal/70' : 'text-white/70'}`}>ARRIVO</span><br /><span class={`font-semibold text-sm ${isGold ? 'text-charcoal' : 'text-white'}`}>{t.end}</span></div>
            </div>
            <p class={`text-xs sm:text-sm leading-relaxed font-medium mb-4 ${isGold ? 'text-charcoal' : 'text-white'}`}>{t.highlights}</p>
            {t.cta && (
              <a href={t.cta.href} class={`inline-flex items-center gap-2 font-semibold text-xs px-4 py-2 rounded-lg transition-all ${isGold ? 'bg-med-blue text-white hover:bg-med-blue/90' : 'bg-med-gold text-white hover:bg-med-gold/90'}`}>
                Scopri di più →
              </a>
            )}
          </div>
        );
        })}
      </div>
    </section>

    <section class="bg-charcoal text-white rounded-[2rem] p-8">
      <h2 class="font-serif text-2xl font-bold text-med-gold mb-8">Guida rapida ai sentieri della costiera</h2>
      <div class="grid sm:grid-cols-2 gap-6">
        <div>
          <p class="text-white/60 text-xs sm:text-sm mb-1">Come arrivare all\'inizio</p>
          <p class="text-xs sm:text-sm leading-relaxed">Da Amalfi: bus SITA per Agerola (corse limitate, ~45 min). Consigliato partire da Amalfi alle 8:30 per prendere il bus delle 9:15 per Agerola.</p>
        </div>
        <div>
          <p class="text-white/60 text-xs sm:text-sm mb-1">Come tornare dalla fine</p>
          <p class="text-xs sm:text-sm leading-relaxed">Da Nocelle: bus locale per Positano centro (~15 min) o discesa a piedi (~1.000 gradini, 45 min). Da Positano: bus SITA o traghetto per Amalfi/Sorrento/Napoli.</p>
        </div>
        <div>
          <p class="text-white/60 text-xs sm:text-sm mb-1">Cosa portare</p>
          <p class="text-xs sm:text-sm leading-relaxed">Scarpe da trekking (non sandali), 1.5L acqua, cappello, crema solare, snack, giacca leggera. Il sentiero non ha punti acqua o negozi.</p>
        </div>
        <div>
          <p class="text-white/60 text-xs sm:text-sm mb-1">Stagione ideale</p>
          <p class="text-xs sm:text-sm leading-relaxed">Aprile–giugno e settembre–ottobre. In luglio e agosto il calore rende il percorso estenuante e affollato. In inverno possibile ma con fango e sentiero sdrucciolevole.</p>
        </div>
      </div>
    </section>

  </div>

  <CorrelationSlider
    heading="Esplora le destinazioni del trekking"
    items={[
      { name: 'Positano',      href: '/it-it/costiera-amalfitana/positano/', tag: 'Arrivo Sentiero', desc: 'Il borgo colorato dove termina il Sentiero degli Dei.' },
      { name: 'Amalfi',        href: '/it-it/costiera-amalfitana/amalfi/',   tag: 'Partenza Valle', desc: 'Punto di partenza per la Valle delle Ferriere.' },
      { name: 'Massa Lubrense',href: '/it-it/penisola-sorrentina/massa-lubrense/', tag: 'Punta Campanella', desc: 'La riserva marina con il sentiero per Punta Campanella.' },
      { name: 'Capri',         href: '/it-it/isole/capri/',                  tag: 'Monte Solaro',  desc: 'Seggiovia o trekking fino ai 589 m di Monte Solaro.' },
    ]}
  />

</BaseLayout>
