---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { getTranslations, getLocalePath } from '../../i18n/translations';
import { homeContent } from '../../i18n/content';

const lang = 'it-it';
const breadcrumbs = [
  { name: 'Home', url: '/it-it/' },
  { name: 'Destinazioni', url: '/it-it/destinazioni' },
];
const t = getTranslations(lang);
const content = homeContent[lang];
const metaDescription = 'Esplora ogni borgo della Costiera Amalfitana: Positano, Amalfi, Ravello, Praiano, Cetara, Vietri sul Mare. Scopri spiagge, storia, gastronomia e come spostarsi.';

const costieraDestinations = content.towns.filter(town => town.area === 'costiera-amalfitana');
const isoleDestinations = content.towns.filter(town => town.area === 'isole');
const penisolaDestinations = content.towns.filter(town => town.area === 'penisola-sorrentina');

const townImages: Record<string, string> = {
  positano: '/images/positano-hero.jpg',
  amalfi: '/images/amalfi-hero.jpg',
  ravello: '/images/ravello-hero.jpg',
  praiano: '/images/praiano-hero.jpg',
  maiori: '/images/maiori-hero.jpg',
  minori: '/images/minori-hero.jpg',
  cetara: '/images/cetara-hero.jpg',
  'vietri-sul-mare': '/images/vietri-hero.jpg',
  salerno: '/images/salerno-hero.webp',
  agerola: '/images/agerola-hero.webp',
  tramonti: '/images/tramonti-hero.webp',
  furore: '/images/fiordo-furore-hero.webp',
  erchie: '/images/erchie-hero.webp',
  'conca-dei-marini': '/images/conca-dei-marini-hero.webp',
  capri: '/images/capri-hero.jpg',
  anacapri: '/images/anacapri-hero.webp',
  ischia: '/images/ischia-hero.jpg',
  forio: '/images/forio-hero.webp',
  procida: '/images/procida-hero.jpg',
  sorrento: '/images/sorrento-hero.jpg',
  'vico-equense': '/images/vico-equense-hero.jpg',
  'massa-lubrense': '/images/massa-lubrense-hero.jpg',
  meta: '/images/meta-hero.webp',
};
---

<BaseLayout
  title={t.meta.destinations_title}
  description={metaDescription}
  lang={lang}
  pageKey="destinations"

  heroImage="/images/costiera-hero.jpg"
>
  <!-- Hero -->
  <section class="relative h-[52.5vh] sm:h-[70vh] flex items-end bg-charcoal overflow-hidden">
    <img src="/images/costiera-hero.jpg" alt="Destinazioni della Costiera Amalfitana" class="absolute inset-0 w-full h-full object-cover" loading="eager" fetchpriority="high" decoding="sync" referrerpolicy="no-referrer"/>
    <div class="absolute inset-0 hidden sm:block bg-gradient-to-b from-black/20 via-black/40 to-black/80"></div>
    <div class="relative z-10 max-w-7xl mx-auto px-6 pb-16 pt-32 w-full">
      <div class="max-w-3xl">
        <p class="text-med-gold text-xs sm:text-sm font-medium uppercase tracking-[0.3em] mb-3">Scopri il territorio</p>
        <h1 class="font-serif text-display text-white mb-4">Destinazioni</h1>
        <p class="text-xl text-white/80 leading-relaxed">
          Dalla Costiera Amalfitana alle isole incantate fino alla Penisola Sorrentina: scopri le destinazioni uniche del Golfo di Napoli.
        </p>
      </div>
    </div>
    <Breadcrumbs breadcrumbs={breadcrumbs} />
  </section>

  <!-- Costiera Amalfitana -->
  <section class="bg-med-cream py-20 px-6">
    <div class="max-w-7xl mx-auto">
      <div class="mb-12">
        <p class="text-med-gold text-xs font-bold uppercase tracking-[0.3em] mb-2">Costiera Amalfitana</p>
        <h2 class="font-serif text-3xl font-bold">Destinazioni sulla Costiera Amalfitana</h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {costieraDestinations.map((town) => (
          <a href={`/it-it/costiera-amalfitana/${town.slug}/`} class="group block hover:opacity-80 transition-opacity">
            <div class="relative aspect-[4/3] rounded-[2rem] overflow-hidden mb-4 shadow-xl">
              <img
                src={townImages[town.slug] ?? '/images/costiera-hero.jpg'}
                alt={town.name}
                class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700"
                loading="lazy"
                referrerpolicy="no-referrer"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent"></div>
              <div class="absolute inset-0 p-6 flex flex-col justify-end">
                <h3 class="font-serif text-xl font-bold text-white mb-1 leading-tight">{town.name}</h3>
                <p class="text-white/70 text-xs">{town.tagline}</p>
              </div>
            </div>
            <p class="text-slate-600 text-sm leading-relaxed">{town.description}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Isole -->
  <section class="bg-white py-20 px-6 border-t border-slate-100">
    <div class="max-w-7xl mx-auto">
      <div class="mb-12">
        <p class="text-med-gold text-xs font-bold uppercase tracking-[0.3em] mb-2">Isole del Golfo</p>
        <h2 class="font-serif text-3xl font-bold">Destinazioni sulle Isole</h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {isoleDestinations.map((town) => (
          <a href={`/it-it/isole/${town.slug}/`} class="group block hover:opacity-80 transition-opacity">
            <div class="relative aspect-[4/3] rounded-[2rem] overflow-hidden mb-4 shadow-xl">
              <img
                src={townImages[town.slug] ?? '/images/costiera-hero.jpg'}
                alt={town.name}
                class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700"
                loading="lazy"
                referrerpolicy="no-referrer"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent"></div>
              <div class="absolute inset-0 p-6 flex flex-col justify-end">
                <h3 class="font-serif text-xl font-bold text-white mb-1 leading-tight">{town.name}</h3>
                <p class="text-white/70 text-xs">{town.tagline}</p>
              </div>
            </div>
            <p class="text-slate-600 text-sm leading-relaxed">{town.description}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Penisola Sorrentina -->
  <section class="bg-med-cream py-20 px-6 border-t border-slate-100">
    <div class="max-w-7xl mx-auto">
      <div class="mb-12">
        <p class="text-med-gold text-xs font-bold uppercase tracking-[0.3em] mb-2">Penisola Sorrentina</p>
        <h2 class="font-serif text-3xl font-bold">Destinazioni sulla Penisola Sorrentina</h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {penisolaDestinations.map((town) => (
          <a href={`/it-it/penisola-sorrentina/${town.slug}/`} class="group block hover:opacity-80 transition-opacity">
            <div class="relative aspect-[4/3] rounded-[2rem] overflow-hidden mb-4 shadow-xl">
              <img
                src={townImages[town.slug] ?? '/images/costiera-hero.jpg'}
                alt={town.name}
                class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700"
                loading="lazy"
                referrerpolicy="no-referrer"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent"></div>
              <div class="absolute inset-0 p-6 flex flex-col justify-end">
                <h3 class="font-serif text-xl font-bold text-white mb-1 leading-tight">{town.name}</h3>
                <p class="text-white/70 text-xs">{town.tagline}</p>
              </div>
            </div>
            <p class="text-slate-600 text-sm leading-relaxed">{town.description}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Come spostarsi -->
  <section class="bg-slate-900 py-16">
    <div class="max-w-7xl mx-auto px-6">
      <h2 class="font-serif text-3xl font-bold text-white mb-12">Come spostarsi tra i borghi</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <a href="/it-it/guida/traghetti/" class="bg-white rounded-[2rem] p-8 shadow-sm hover:shadow-lg transition-shadow">
          <div class="w-14 h-14 rounded-2xl bg-med-gold/10 flex items-center justify-center mb-6">
            <!-- Ferry -->
            <svg class="w-7 h-7 text-med-gold" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
              <path d="M2 13h20M2 14v4a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-4"/>
              <path d="M12 3v10M8 7h8M6 7h12v2H6z"/>
              <circle cx="5" cy="19" r="1"/>
              <circle cx="19" cy="19" r="1"/>
            </svg>
          </div>
          <h3 class="font-bold text-slate-900 mb-3 text-lg">Traghetto</h3>
          <p class="text-slate-600 text-sm leading-relaxed">Il modo più bello (e spesso il più veloce) per spostarsi. I traghetti collegano Positano, Amalfi, Ravello e Salerno da aprile a ottobre.</p>
          <p class="text-med-gold text-xs font-semibold mt-4">Scopri di più →</p>
        </a>
        <a href="/it-it/guida/bus-sita/" class="bg-white rounded-[2rem] p-8 shadow-sm hover:shadow-lg transition-shadow">
          <div class="w-14 h-14 rounded-2xl bg-med-gold/10 flex items-center justify-center mb-6">
            <!-- Bus -->
            <svg class="w-7 h-7 text-med-gold" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
              <rect x="2" y="7" width="20" height="11" rx="2"/>
              <path d="M4 18h16M7 3v4M17 3v4M6 7h12"/>
              <circle cx="5" cy="20" r="1.5"/>
              <circle cx="19" cy="20" r="1.5"/>
            </svg>
          </div>
          <h3 class="font-bold text-slate-900 mb-3 text-lg">Bus SITA</h3>
          <p class="text-slate-600 text-sm leading-relaxed">Il bus pubblico percorre tutta la SS163 tutto l'anno. Economico ma lento in alta stagione per il traffico. Biglietti a bordo o nelle tabaccherie.</p>
          <p class="text-med-gold text-xs font-semibold mt-4">Scopri di più →</p>
        </a>
        <a href="/it-it/guida/parcheggi-ztl/" class="bg-white rounded-[2rem] p-8 shadow-sm hover:shadow-lg transition-shadow">
          <div class="w-14 h-14 rounded-2xl bg-med-gold/10 flex items-center justify-center mb-6">
            <!-- Car -->
            <svg class="w-7 h-7 text-med-gold" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
              <path d="M5 9h14M3 13h18v3a2 2 0 0 1-2 2h-14a2 2 0 0 1-2-2v-3z"/>
              <circle cx="6" cy="18" r="1.5"/>
              <circle cx="18" cy="18" r="1.5"/>
              <path d="M5 9V8a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v1"/>
            </svg>
          </div>
          <h3 class="font-bold text-slate-900 mb-3 text-lg">Auto privata</h3>
          <p class="text-slate-600 text-sm leading-relaxed">Sconsigliata in luglio e agosto per il traffico intenso. In primavera e autunno è comoda, ma i parcheggi sono limitati e costosi.</p>
          <p class="text-med-gold text-xs font-semibold mt-4">Scopri di più →</p>
        </a>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-16 text-center">
    <div class="max-w-2xl mx-auto px-4">
      <h2 class="text-2xl font-bold text-slate-900 mb-4">Pronto a pianificare il viaggio?</h2>
      <p class="text-slate-600 mb-8">Scopri i nostri itinerari consigliati per visitare al meglio la Costiera Amalfitana.</p>
      <a href={getLocalePath(lang, 'itineraries')}
        class="inline-block bg-med-blue text-white font-semibold px-8 py-3 rounded-full hover:bg-med-blue transition-colors">
        Vedi gli itinerari
      </a>
    </div>
  </section>
</BaseLayout>
