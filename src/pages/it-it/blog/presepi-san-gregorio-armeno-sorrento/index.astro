---
import BlogPostLayout from '../../../../layouts/BlogPostLayout.astro';

const lang = 'it-it';
const post = {
  title: 'Presepi a Napoli e Sorrento: Guida per Dicembre',
  subtitle: "Via San Gregorio Armeno, i presepi nelle chiese di Sorrento e i presepi viventi della Penisola Sorrentina, con le date dell'ultima edizione",
  category: 'GUIDE',
  date: '10 Novembre 2026',
  readTime: '11 min',
  image: '/images/presepe-natale-hero.webp',
  imageAlt: "Presepe con Maria, Giuseppe, il Bambino, il bue, l'asinello e le pecore",
  path: '/it-it/blog/presepi-san-gregorio-armeno-sorrento/',
};

const metaTitle = 'Presepi San Gregorio Armeno e Sorrento: Guida Dicembre';
const metaDescription = "Via San Gregorio Armeno a Napoli e i presepi viventi della Penisola Sorrentina: dove si tengono, date e orari dell'ultima edizione, come arrivare da Sorrento.";

const breadcrumbs = [
  { name: 'Home', url: '/it-it/' },
  { name: 'Blog', url: '/it-it/blog/' },
  { name: 'Presepi a Napoli e Sorrento', url: '/it-it/blog/presepi-san-gregorio-armeno-sorrento/' },
];

const quickInfo = [
  { label: 'Napoli', value: 'Via San Gregorio Armeno, aperta tutto l\'anno' },
  { label: 'Alta stagione', value: 'Da fine novembre a inizio gennaio' },
  { label: 'Da Sorrento', value: 'Circumvesuviana, circa 1h fino a Napoli' },
  { label: 'Sorrento (2025)', value: 'Presepe vivente nel centro storico, 28-30 dic' },
  { label: 'Vico Equense (2025/26)', value: 'Fornacelle, dal 26 dic al 6 gen' },
  { label: 'Massa Lubrense (2025/26)', value: 'Monticchio, dal 27 dic al 6 gen' },
  { label: 'Ingresso', value: 'Gratuito per i presepi viventi elencati' },
  { label: 'Programmi 2026', value: 'Pubblicati dai comuni a dicembre' },
];

const faq = [
  {
    q: 'Qual è il momento migliore per visitare via San Gregorio Armeno?',
    a: 'Le botteghe sono aperte tutto l\'anno, ma la strada è al massimo da fine novembre a inizio gennaio. Per guardare le statuine con calma conviene andare in un giorno feriale, di mattina. I fine settimana di dicembre e i giorni attorno all\'8 dicembre sono i più affollati, e nel 2025 il Comune ha istituito in quei giorni il senso unico pedonale.',
  },
  {
    q: 'Come si arriva da Sorrento a San Gregorio Armeno?',
    a: 'Con la Circumvesuviana da Sorrento a Napoli Garibaldi, circa un\'ora. Da lì si prende la Linea 1 della metropolitana per una fermata fino a Duomo e si sale a piedi per via Duomo, oppure si cammina per tutto il tragitto lungo corso Umberto I e via Duomo, in circa venticinque minuti. La strada collega via San Biagio dei Librai a via dei Tribunali.',
  },
  {
    q: 'Quanto costano le statuine?',
    a: 'Dipende da dimensioni, materiali e bottega. In un articolo del 2019 i negozianti della strada indicavano venti o trenta euro per una statuina di misura media. I pezzi rifiniti a mano e vestiti in seta delle botteghe storiche costano molto di più. Sono indicazioni: chiedete in negozio.',
  },
  {
    q: 'Dove sono i presepi viventi in Penisola Sorrentina?',
    a: 'Nella stagione 2025/26 erano tre: nei portoni del centro storico di Sorrento (dal 28 al 30 dicembre), a Fornacelle sopra Vico Equense (dal 26 dicembre al 6 gennaio) e nel monastero di Monticchio, frazione di Massa Lubrense (dal 27 dicembre al 6 gennaio). Piano di Sorrento e Sant\'Agnello avevano presepi artistici e animati, non viventi.',
  },
  {
    q: 'Le date del 2026 sono già note?',
    a: 'Non ancora, a metà ottobre 2026. Comuni e parrocchie pubblicano i programmi natalizi tra fine novembre e dicembre. Le date di questa guida sono quelle dell\'edizione 2025/26, che danno un\'idea affidabile dello schema: quasi tutto si svolge tra il 26 dicembre e il 6 gennaio.',
  },
  {
    q: 'Si paga per vedere i presepi viventi?',
    a: 'Il presepe di Fornacelle è gratuito, con offerte libere gradite, e l\'edizione 2025 di Sorrento era inserita tra gli eventi gratuiti della città. Il programma di Monticchio non indicava un biglietto. Portate comunque qualche contante per le offerte.',
  },
];

const sidebarLinks = [
  { label: 'Sorrento', href: '/it-it/penisola-sorrentina/sorrento/' },
  { label: 'Vico Equense', href: '/it-it/penisola-sorrentina/vico-equense/' },
  { label: 'Massa Lubrense', href: '/it-it/penisola-sorrentina/massa-lubrense/' },
  { label: 'Sant\'Agnello', href: '/it-it/penisola-sorrentina/sant-agnello/' },
  { label: 'Presepi viventi in Costiera', href: '/it-it/eventi/costiera-amalfitana/presepi-viventi-costiera/' },
  { label: "M'illumino d'Inverno", href: '/it-it/eventi/penisola-sorrentina/millumino-inverno-sorrento/' },
];

const authorRole = 'Guide locali · Costiera Amalfitana';

const relatedArticles = [
  {
    title: 'Luminarie di Natale a Sorrento e Salerno',
    category: 'GUIDE',
    date: '21 Ottobre 2026',
    image: '/images/luci-artista-salerno-hero.webp',
    imageAlt: 'Luminarie di Natale a Sorrento e Salerno',
    path: '/it-it/blog/luminarie-natalizie-sorrento-salerno/'
  },
  {
    title: 'La Costiera Amalfitana in treno',
    category: 'GUIDE',
    date: '10 Agosto 2026',
    image: '/images/treno-costiera-hero.webp',
    imageAlt: 'La Costiera Amalfitana in treno',
    path: '/it-it/blog/costiera-amalfitana-in-treno/'
  }
];


const keyTakeaways = [
  'Via San Gregorio Armeno a Napoli è la strada delle botteghe dei presepi: aperta tutto l\'anno, al massimo da fine novembre a inizio gennaio, a un\'ora da Sorrento con la Circumvesuviana.',
  'Nel 2025 Napoli ha istituito il senso unico pedonale nei fine settimana di dicembre e nel ponte dell\'Immacolata, dalle 9:00 alle 20:00. Il momento giusto sono le mattine dei giorni feriali.',
  'In Penisola Sorrentina i presepi viventi si concentrano tra il 26 dicembre e il 6 gennaio: centro storico di Sorrento, Fornacelle sopra Vico Equense e il monastero di Monticchio a Massa Lubrense.',
  'I programmi 2026 non sono ancora usciti. Tutte le date qui riportate vengono dall\'edizione 2025/26 e sono indicate come tali.',
  'I presepi viventi del versante amalfitano (Agerola, Albori, Pontone, Furore) sono raccontati in una guida a parte.',
];
---

<BlogPostLayout
  lang={lang}
  post={post}
  metaTitle={metaTitle}
  metaDescription={metaDescription}
  breadcrumbs={breadcrumbs}
  quickInfo={quickInfo}
  faq={faq}
  sidebarLinks={sidebarLinks}
  authorRole={authorRole}
  relatedArticles={relatedArticles}
  pageKey="nativity-scenes-naples-sorrento"
>

  <!-- Key Takeaways -->
  <div class="bg-slate-900 text-white p-8 rounded-[2rem]">
    <div class="flex items-center gap-3 mb-6">
      <svg class="w-5 h-5 text-med-gold flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
      <h2 class="font-serif text-lg font-bold text-med-gold uppercase tracking-[0.15em]">Punti Chiave</h2>
    </div>
    <ul class="space-y-4">
      {keyTakeaways.map((point) => (
        <li class="flex items-start gap-3">
          <span class="w-1.5 h-1.5 rounded-full bg-med-gold flex-shrink-0 mt-2"></span>
          <span class="text-white/80 text-xs sm:text-sm leading-relaxed">{point}</span>
        </li>
      ))}
    </ul>
  </div>

  <!-- Intro -->
  <div>
    <p class="text-slate-600 text-xl leading-relaxed mb-6 font-light">
      Dalle parti di Napoli il presepe è una cosa seria. Le famiglie lo costruiscono in casa ogni anno, le parrocchie fanno a gara con i loro, e nei giorni tra Natale e l'Epifania interi quartieri si travestono da Betlemme. Per un viaggio di dicembre con base a <a href="/it-it/penisola-sorrentina/sorrento/" class="text-med-blue hover:underline">Sorrento</a> questo significa due cose da mettere in agenda: una giornata a Napoli nella strada dove si fanno le statuine, e le sere in cui i paesi della penisola allestiscono i loro presepi viventi. I programmi 2026 non sono ancora pubblicati, quindi le date che seguono sono quelle dell'ultima edizione, 2025/26, e sono segnalate come tali.
    </p>
  </div>

  <!-- San Gregorio Armeno -->
  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">Via San Gregorio Armeno, Napoli</h2>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      San Gregorio Armeno è una stretta strada pedonale di circa 200 metri nel centro storico di Napoli, Patrimonio UNESCO dal 1995. Sale da via San Biagio dei Librai, il tratto di Spaccanapoli, fino a piazza San Gaetano e via dei Tribunali. Su entrambi i lati si susseguono le botteghe che fanno e vendono statuine da presepe, e a dicembre la merce si allarga sui muri e sugli stipiti.
    </p>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      Si trova tutto quello che serve a un presepe: i pastori, la Sacra Famiglia e i Magi, ma anche i venditori del mercato, la taverna, il pescivendolo, i cesti di pane e di frutta, l'acqua che scorre e le luci. Accanto ai pezzi tradizionali molte botteghe fanno statuine di calciatori, politici e personaggi dell'anno, ed è la parte che i visitatori fotografano di più. Diverse botteghe sono guidate dalle stesse famiglie da generazioni: i fratelli Capuano lavorano dal 1840, e nomi come Di Virgilio e Ferrigno sono noti per le statuine vestite in stoffa, anche in seta di San Leucio.
    </p>
    <p class="text-slate-600 text-lg leading-relaxed mb-8">
      A metà strada si trovano la chiesa e il monastero di San Gregorio Armeno, il complesso che dà il nome alla via, con un interno barocco e affreschi di Luca Giordano. Il chiostro è aperto la mattina con un piccolo biglietto.
    </p>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-8">
      <div class="bg-white p-6 rounded-[2rem] border border-slate-100 shadow-sm">
        <h4 class="font-bold text-slate-900 mb-2">Quando andare</h4>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Le botteghe sono aperte tutto l'anno. L'alta stagione va da fine novembre a inizio gennaio. Nei giorni feriali i negozi tengono in genere un orario di circa 9:30-19:30, più lungo nei fine settimana di dicembre. Le mattine dei feriali sono le più tranquille.</p>
      </div>
      <div class="bg-white p-6 rounded-[2rem] border border-slate-100 shadow-sm">
        <h4 class="font-bold text-slate-900 mb-2">Folla e senso unico</h4>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Nel 2025 il Comune ha istituito il senso unico pedonale dalle 9:00 alle 20:00 dal 28 al 30 novembre, dal 5 all'8 dicembre, dal 12 al 14 dicembre e dal 19 al 22 dicembre, e dalle 9:00 alle 14:00 il 23 dicembre. A metà mese il verso si invertiva. L'ordinanza viene emessa ogni anno.</p>
      </div>
      <div class="bg-white p-6 rounded-[2rem] border border-slate-100 shadow-sm">
        <h4 class="font-bold text-slate-900 mb-2">Prezzi</h4>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Non esiste un listino della strada. In un articolo del 2019 i negozianti indicavano venti o trenta euro per una statuina media. Gli accessori piccoli costano meno, i pezzi rifiniti a mano delle botteghe storiche parecchio di più. Chiedete prima di prendere in mano un pezzo.</p>
      </div>
      <div class="bg-white p-6 rounded-[2rem] border border-slate-100 shadow-sm">
        <h4 class="font-bold text-slate-900 mb-2">Portarle a casa</h4>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Le statuine in terracotta sono fragili. Fatele imballare bene e tenetele nel bagaglio a mano. Quasi tutte le botteghe vendono anche online con spedizione, utile per i pezzi più grandi.</p>
      </div>
    </div>

    <h3 class="font-serif text-2xl font-bold text-slate-900 mb-4">Come arrivare da Sorrento</h3>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      D'inverno il treno è la soluzione più semplice. La Circumvesuviana va da Sorrento a Napoli e ferma a Napoli Garibaldi, nello stesso complesso della stazione centrale.
    </p>
    <div class="overflow-x-auto rounded-[2rem] border border-slate-100 shadow-sm mb-6">
      <table class="w-full text-xs sm:text-sm">
        <thead class="bg-slate-900 text-white">
          <tr>
            <th class="text-left p-5 font-serif font-bold text-med-gold">Tratta</th>
            <th class="text-left p-5 font-serif font-bold text-med-gold">Come</th>
            <th class="text-left p-5 font-serif font-bold text-med-gold">Tempo</th>
          </tr>
        </thead>
        <tbody class="bg-white">
          <tr class="border-b border-slate-100">
            <td class="p-5 font-bold">Sorrento - Napoli Garibaldi</td>
            <td class="p-5 text-slate-600">Circumvesuviana, linea per Napoli</td>
            <td class="p-5 text-slate-600">Circa 1h</td>
          </tr>
          <tr class="border-b border-slate-100">
            <td class="p-5 font-bold">Garibaldi - Duomo</td>
            <td class="p-5 text-slate-600">Metropolitana Linea 1, una fermata</td>
            <td class="p-5 text-slate-600">Pochi minuti</td>
          </tr>
          <tr>
            <td class="p-5 font-bold">Duomo - San Gregorio Armeno</td>
            <td class="p-5 text-slate-600">A piedi su per via Duomo, poi a sinistra in via San Biagio dei Librai o via dei Tribunali</td>
            <td class="p-5 text-slate-600">Circa 10 min</td>
          </tr>
        </tbody>
      </table>
    </div>
    <p class="text-slate-600 text-lg leading-relaxed">
      Chi preferisce camminare direttamente da Garibaldi arriva in circa venticinque minuti per corso Umberto I e via Duomo. Convalidate i biglietti regionali prima di salire e tenete le borse davanti a voi sulla Circumvesuviana, che è una linea pendolare. La nostra guida alla <a href="/it-it/blog/costiera-amalfitana-in-treno/" class="text-med-blue hover:underline">Costiera Amalfitana in treno</a> racconta la linea più nel dettaglio.
    </p>
  </div>

  <!-- Sorrento churches -->
  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">Sorrento: i presepi del centro storico</h2>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      A Sorrento i presepi fanno parte di <a href="/it-it/eventi/penisola-sorrentina/millumino-inverno-sorrento/" class="text-med-blue hover:underline">M'illumino d'Inverno</a>, il cartellone invernale che va da fine novembre a metà gennaio. Chiese e musei del centro storico allestiscono presepi, e un concorso dedicato, Il Presepe Oggi, si tiene da più di quarant'anni. Questi gli appuntamenti sul presepe del programma 2025/26:
    </p>
    <ul class="space-y-3 mb-6">
      <li class="flex items-start gap-3"><span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span><span class="text-slate-700"><strong>Villa Fiorentino.</strong> La mostra "Giuseppe Ercolano e i maestri del presepe", dedicata alla tradizione presepiale napoletana, aperta fino al 18 gennaio 2026.</span></li>
      <li class="flex items-start gap-3"><span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span><span class="text-slate-700"><strong>Il Presepe Oggi.</strong> La 46ª edizione del concorso cittadino, con la premiazione il 18 gennaio nella chiesa della Santissima Annunziata.</span></li>
      <li class="flex items-start gap-3"><span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span><span class="text-slate-700"><strong>Processione del Bambino Gesù.</strong> Il 6 gennaio alle 19:30 dalla chiesa del Carmine, con pastori e zampognari.</span></li>
    </ul>
    <p class="text-slate-600 text-lg leading-relaxed">
      Il centro è piccolo e quasi tutto pedonale, quindi le chiese si visitano in un pomeriggio tra piazza Tasso, il Duomo e via San Cesareo. Gli orari di apertura delle chiese variano e non sempre sono esposti, quindi tenetevi un margine.
    </p>
  </div>

  <!-- Living nativities -->
  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">I presepi viventi della Penisola Sorrentina</h2>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      Un presepe vivente è una Natività interpretata da persone vere: la Sacra Famiglia nella grotta e attorno i mestieri di un borgo di una volta, con fornai, calzolai, filatrici e osti al lavoro. In penisola li organizzano parrocchie e associazioni locali, la sera, tra Natale e l'Epifania. La tabella riporta quelli confermati nell'ultima edizione.
    </p>

    <div class="overflow-x-auto rounded-[2rem] border border-slate-100 shadow-sm mb-8">
      <table class="w-full text-xs sm:text-sm">
        <thead class="bg-slate-900 text-white">
          <tr>
            <th class="text-left p-5 font-serif font-bold text-med-gold">Luogo</th>
            <th class="text-left p-5 font-serif font-bold text-med-gold">Dove</th>
            <th class="text-left p-5 font-serif font-bold text-med-gold">Date 2025/26</th>
            <th class="text-left p-5 font-serif font-bold text-med-gold">Orari</th>
          </tr>
        </thead>
        <tbody class="bg-white">
          <tr class="border-b border-slate-100">
            <td class="p-5 font-bold">Sorrento</td>
            <td class="p-5 text-slate-600">Portoni e cortili del centro storico, partenza da piazza Tasso</td>
            <td class="p-5 text-slate-600">28, 29, 30 dicembre</td>
            <td class="p-5 text-slate-600">17:30-20:30</td>
          </tr>
          <tr class="border-b border-slate-100">
            <td class="p-5 font-bold">Vico Equense</td>
            <td class="p-5 text-slate-600">Fornacelle, località Torricella</td>
            <td class="p-5 text-slate-600">26, 27, 28 dicembre; 1, 2, 3, 5, 6 gennaio</td>
            <td class="p-5 text-slate-600">18:00-21:00</td>
          </tr>
          <tr>
            <td class="p-5 font-bold">Massa Lubrense</td>
            <td class="p-5 text-slate-600">Monastero del Santissimo Rosario, Monticchio</td>
            <td class="p-5 text-slate-600">27, 28 dicembre; 1, 2, 4, 5, 6 gennaio</td>
            <td class="p-5 text-slate-600">18:00-20:30</td>
          </tr>
        </tbody>
      </table>
    </div>

    <h3 class="font-serif text-2xl font-bold text-slate-900 mb-4">Sorrento: il presepe nei portoni</h3>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      L'edizione 2025, "Araprite 'e purtune, ce sta 'o presepio", è stata organizzata da Officina Solidale nell'ambito del programma Surriento Gentile. Al posto di un unico allestimento, le scene erano distribuite in 18 portoni e androni di palazzi storici, ciascuno segnalato da una lanterna. Il percorso partiva da piazza Tasso, dove all'info point si trovava un QR code con la mappa. L'edizione precedente, 2024/25, si era svolta nei giardini accanto alla Cattedrale con più di 250 figuranti, quindi la formula può cambiare da un anno all'altro.
    </p>

    <h3 class="font-serif text-2xl font-bold text-slate-900 mb-4">Vico Equense: Fornacelle</h3>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      Fornacelle è una frazione collinare di <a href="/it-it/penisola-sorrentina/vico-equense/" class="text-med-blue hover:underline">Vico Equense</a>, e il suo presepe vivente, organizzato dalla parrocchia dei Santi Pietro e Paolo, è arrivato nel 2025 alla decima edizione con più di 250 figuranti del paese. Si svolge in località Torricella, a pochi passi dalla piazza. L'ingresso è gratuito e le offerte sono gradite. Nel 2025 gli organizzatori avevano predisposto tre parcheggi e percorsi accessibili alle persone con disabilità. Un elenco includeva anche il 4 gennaio tra le date, quindi verificate sul sito ufficiale, presepefornacelle.it, prima di andare.
    </p>

    <h3 class="font-serif text-2xl font-bold text-slate-900 mb-4">Massa Lubrense: il monastero di Monticchio</h3>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      A <a href="/it-it/penisola-sorrentina/massa-lubrense/" class="text-med-blue hover:underline">Massa Lubrense</a> l'associazione Carpe Diem allestisce il presepe dentro il settecentesco Monastero del Santissimo Rosario a Monticchio, con il sostegno del Comune. La visita passa dalle scene ambientate in Giudea al Settecento napoletano, con la taverna, i banchi del mercato e l'indovina. Un elenco indica già dal 27 dicembre 2026 al 6 gennaio 2027 per la prossima edizione, ma al momento in cui scriviamo il Comune non l'aveva confermato.
    </p>

    <h3 class="font-serif text-2xl font-bold text-slate-900 mb-4">Piano di Sorrento e Sant'Agnello</h3>
    <ul class="space-y-3 mb-6">
      <li class="flex items-start gap-3"><span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span><span class="text-slate-700"><strong>Piano di Sorrento.</strong> Non un presepe vivente ma un itinerario di presepi del progetto "Borghi e Casali", allestiti in chiese, spazi pubblici, negozi e case private e aperti fino all'11 gennaio 2026, in alcuni casi con visite guidate dagli stessi costruttori. Il programma è stato pubblicato sulla pagina Facebook Città di Piano di Sorrento.</span></li>
      <li class="flex items-start gap-3"><span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span><span class="text-slate-700"><strong><a href="/it-it/penisola-sorrentina/sant-agnello/" class="text-med-blue hover:underline">Sant'Agnello</a>.</strong> Un presepe animato lungo cinque metri, con figure in movimento e scene di vita quotidiana, in un locale di via Balsamo. Nel 2025/26 era aperto tutti i giorni dalle 16:00 alle 20:00, e anche dalle 10:30 alle 13:00 l'1, il 3 e il 6 gennaio.</span></li>
    </ul>
    <p class="text-slate-600 text-lg leading-relaxed">
      Non abbiamo trovato un presepe vivente confermato a Meta per l'ultima edizione, e quello di Casarlano, rione collinare di Sorrento, compare negli elenchi solo fino al 2018. Se torneranno, lo diranno i programmi di dicembre.
    </p>
  </div>

  <!-- Planning -->
  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">Come organizzarsi</h2>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      Napoli è una gita di giornata, i presepi viventi sono uscite serali, quindi si combinano bene. Passate una mattina feriale a San Gregorio Armeno, pranzate nel centro storico e rientrate a Sorrento nel pomeriggio. Nelle sere tra il 26 dicembre e il 6 gennaio scegliete uno dei presepi viventi: quello di Sorrento si raggiunge a piedi dal centro, mentre Fornacelle e Monticchio sono frazioni collinari dove conviene arrivare in auto o in taxi.
    </p>
    <p class="text-slate-600 text-lg leading-relaxed">
      Se passate anche dall'altra parte dei Monti Lattari, i paesi della Costiera allestiscono i loro: trovate tutto nella guida ai <a href="/it-it/eventi/costiera-amalfitana/presepi-viventi-costiera/" class="text-med-blue hover:underline">presepi viventi della Costiera Amalfitana</a>. E per le sere prima di Natale, le luci di Sorrento e Salerno sono raccontate in <a href="/it-it/blog/luminarie-natalizie-sorrento-salerno/" class="text-med-blue hover:underline">Luminarie di Natale a Sorrento e Salerno</a>.
    </p>
  </div>

