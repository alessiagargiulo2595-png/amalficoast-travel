---
import BlogPostLayout from '../../../../layouts/BlogPostLayout.astro';

const lang = 'it-it';
const post = {
  title: 'Grotta dello Smeraldo Amalfi (Grotta Smeralda)',
  subtitle: 'Guida Completa alla Perla di Conca dei Marini',
  category: 'SCOPERTE',
  date: '1 Aprile 2026',
  readTime: '6 min',
  image: '/images/grotta-smeraldo-hero.webp',
  imageAlt: 'Grotta dello Smeraldo Amalfi (Grotta Smeralda) - Conca dei Marini, Costiera Amalfitana',
  path: '/it-it/blog/grotta-dello-smeraldo/',
};

const metaTitle = 'Grotta dello Smeraldo 2026: Orari, Prezzi, Come Arrivare | Conca dei Marini';
const metaDescription = 'Guida completa alla Grotta dello Smeraldo di Conca dei Marini: orari e prezzi 2026, come arrivare in barca o ascensore, biglietti, dove parcheggiare e il presepe sommerso. Tutto per visitare le grotte della Costiera Amalfitana.';

const breadcrumbs = [
  { name: 'Home', url: '/it-it/' },
  { name: 'Scoperte', url: '/it-it/blog/' },
  { name: 'Grotta dello Smeraldo Amalfi (Grotta Smeralda)', url: '/it-it/blog/grotta-dello-smeraldo/' },
];

const quickInfo = [
  { label: 'Scoperta', value: '1932 - Luigi Buonocore' },
  { label: 'Comune', value: 'Conca dei Marini (SA)' },
  { label: 'Dimensioni', value: '60m larghezza · 24m altezza' },
  { label: 'Apertura subacquea', value: '~8 metri di profondita' },
  { label: 'Orari', value: '9:00 - 16:00 (ca.)' },
  { label: 'Biglietto', value: 'ca. €7 a persona' },
  { label: 'Durata visita', value: '20-30 minuti' },
  { label: 'Periodo migliore', value: 'Mattina (10-12)' },
];

const faq = [
  { q: 'Come si arriva alla Grotta dello Smeraldo?', a: 'Ci sono tre modi per raggiungere la Grotta dello Smeraldo: via mare con i taxi-boat da Amalfi (traghetto Amalfi Grotta Smeraldo, circa 10 minuti), via terra con l\'ascensore panoramico dalla SS163 a Conca dei Marini, oppure in bus SITA (fermata Grotta dello Smeraldo). Chi arriva in auto trova un piccolo parcheggio sulla statale, accanto all\'ingresso dell\'ascensore.' },
  { q: 'Dove si trova la Grotta dello Smeraldo?', a: 'La Grotta dello Smeraldo si trova a Conca dei Marini, sulla Costiera Amalfitana, circa 5 km a ovest di Amalfi e 15 km a est di Positano. E una delle grotte piu famose della Costiera Amalfitana, insieme alla Grotta Azzurra di Capri.' },
  { q: 'Quando e il periodo migliore per visitarla?', a: 'Le ore mattutine tra le 10 e le 12 sono le piu magiche: la luce del sole filtra piu direttamente attraverso l\'apertura subacquea, amplificando l\'effetto smeraldo. Evitate le giornate di mare mosso: in caso di onde la grotta puo essere inaccessibile.' },
  { q: 'Quali sono gli orari e i prezzi della Grotta dello Smeraldo?', a: 'La Grotta dello Smeraldo e aperta indicativamente dalle 9:00 alle 16:00. Il biglietto d\'ingresso costa circa 7 euro a persona (2026). Il costo del taxi-boat da Amalfi si aggiunge separatamente (circa 10-12 euro a/r). Se si arriva via terra, il costo dell\'ascensore e incluso nel biglietto. I biglietti si acquistano in loco, non e necessaria la prenotazione online.' },
  { q: 'Cos\'e il Presepe Sommerso?', a: 'E un presepe in ceramica posizionato sul fondale della grotta nel 1956 a circa 4 metri di profondita, opera dell\'artista Attilio Pentone. Le figure di terracotta smaltata raffigurano la Nativita e sono perfettamente visibili attraverso le acque limpide. Ogni anno il 24 dicembre i sub aggiungono nuove statuine al presepe.' },
  { q: 'Perche l\'acqua e di colore smeraldo?', a: 'La grotta ha un\'apertura subacquea a circa 8 metri di profondita. La luce solare penetra attraverso questa fessura, viene rifratta dall\'acqua e illumina la caverna dal basso verso l\'alto, creando un\'intensa luminescenza verde-smeraldo. L\'effetto e totalmente naturale e varia con l\'angolazione del sole.' },
  { q: 'Quanto dura la visita?', a: 'La visita in barca all\'interno della grotta dura mediamente 20-30 minuti. Tenendo conto dei trasferimenti via mare da Amalfi, e consigliabile prevedere circa 1,5-2 ore totali per l\'esperienza completa.' },
  { q: 'Si puo fare snorkeling o immersioni nella grotta?', a: 'Le immersioni subacquee guidate sono possibili con dive center autorizzati della zona (Amalfi e Praiano). L\'accesso in snorkeling autonomo non e consentito ai visitatori normali per motivi di sicurezza e tutela del sito. Le immersioni organizzate permettono di avvicinarsi al presepe sommerso.' },
];

const sidebarLinks = [
  { label: 'Marina di Conca (spiaggia)', href: '/it-it/spiagge/costiera-amalfitana/marina-di-conca/' },
  { label: 'Tour in Barca', href: '/it-it/esperienze/tour-barca/' },
  { label: 'Traghetti e Aliscafi', href: '/it-it/guida/traghetti/' },
  { label: 'Bus SITA', href: '/it-it/guida/bus-sita/' },
  { label: 'Fiordo di Furore', href: '/it-it/spiagge/costiera-amalfitana/fiordo-di-furore/' },
];

const relatedArticles = [
  {
    title: 'Valle delle Ferriere',
    category: 'SCOPERTE',
    date: '8 Aprile 2026',
    image: '/images/valle-ferriere-hero.jpg',
    imageAlt: 'Valle delle Ferriere - trekking nella Costiera Amalfitana',
    path: '/it-it/blog/valle-delle-ferriere/'
  },
  {
    title: 'Atrani',
    category: 'SCOPERTE',
    date: '16 Aprile 2026',
    image: '/images/atrani-hero.webp',
    imageAlt: "Atrani - il borgo più piccolo d'Italia sulla Costiera Amalfitana",
    path: '/it-it/blog/atrani/'
  }
];

const authorRole = 'Guide locali · Costiera Amalfitana';

const touristAttractionSchema = {
  "@context": "https://schema.org",
  "@type": "TouristAttraction",
  "name": "Grotta dello Smeraldo",
  "alternateName": ["Grotta Smeralda", "Emerald Grotto"],
  "description": "Grotta marina con un'apertura subacquea che crea un effetto luminoso verde smeraldo. Scoperta nel 1932 a Conca dei Marini, custodisce il celebre Presepe Sommerso del 1956.",
  "url": "https://amalficoast-travel.com/it-it/blog/grotta-dello-smeraldo/",
  "image": "https://amalficoast-travel.com/images/grotta-smeraldo-hero.webp",
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": "40.6086",
    "longitude": "14.5585"
  },
  "address": {
    "@type": "PostalAddress",
    "addressLocality": "Conca dei Marini",
    "addressRegion": "SA",
    "postalCode": "84010",
    "addressCountry": "IT"
  },
  "isAccessibleForFree": false,
  "publicAccess": true,
  "openingHoursSpecification": {
    "@type": "OpeningHoursSpecification",
    "dayOfWeek": ["Monday","Tuesday","Wednesday","Thursday","Friday","Saturday","Sunday"],
    "opens": "09:00",
    "closes": "16:00",
    "validFrom": "2026-04-01",
    "validThrough": "2026-10-31"
  }
};
---

<BlogPostLayout
  lang={lang}
  post={post}
  dateModifiedISO="2026-08-10"
  metaTitle={metaTitle}
  metaDescription={metaDescription}
  breadcrumbs={breadcrumbs}
  quickInfo={quickInfo}
  faq={faq}
  sidebarLinks={sidebarLinks}
  authorRole={authorRole}
  relatedArticles={relatedArticles}
  extraSchema={[touristAttractionSchema]}
>

  <!-- Intro -->
  <div>
    <p class="text-slate-600 text-xl leading-relaxed mb-6 font-light">
      C'e un momento preciso in cui la barca s'infila nell'oscurita della caverna e poi, all'improvviso, tutto si trasforma. L'acqua non e piu blu: diventa verde. Un verde intenso, irreale, come se qualcuno avesse sciolto un'enorme smeraldo nell'acqua del Tirreno. Benvenuti alla Grotta dello Smeraldo Amalfi (Grotta Smeralda), uno dei piu straordinari fenomeni naturali della Costiera Amalfitana.
    </p>
    <p class="text-slate-600 text-lg leading-relaxed">
      Situata a Conca dei Marini, un piccolo comune di meno di 800 abitanti incastonato tra <a href="/it-it/costiera-amalfitana/positano/" class="text-med-blue hover:underline">Positano</a> e <a href="/it-it/costiera-amalfitana/amalfi/" class="text-med-blue hover:underline">Amalfi</a>, la grotta e raggiungibile sia via mare (traghetto da Amalfi) che via terra con l'ascensore panoramico ed e una delle grotte piu affascinanti - e meno frenetiche - dell'intera Costiera Amalfitana. Chi si chiede dove parcheggiare trovera un piccolo parcheggio direttamente sulla statale, accanto all'ingresso dell'ascensore.
    </p>
  </div>

  <!-- Storia geologica -->
  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">La Scoperta e la Storia Geologica</h2>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      Era il 1932 quando il pescatore locale Luigi Buonocore, aggirandosi con la sua barca in cerca di approdi ripiegati lungo la costa, s'imbatte in una piccola apertura nella roccia calcarea. Infilandosi curioso all'interno, si trova davanti a uno spettacolo che non aveva mai visto: una caverna gigantesca illuminata da una luce verde soprannaturale. Cosi viene scoperta ufficialmente la Grotta dello Smeraldo Amalfi (Grotta Smeralda).
    </p>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      Ma la vera storia geologica della grotta e molto piu antica. Si tratta di una caverna carsica formatasi milioni di anni fa all'interno dei calcari mesozoici che costituiscono la dorsale dei Monti Lattari. Originariamente era una grotta terrestre, con le classiche formazioni di stalattiti e stalagmiti tipiche delle caverne calcaree.
    </p>
    <div class="bg-white p-8 rounded-[2rem] border border-slate-100 shadow-sm my-8">
      <h3 class="font-serif text-xl font-bold text-slate-900 mb-4">Il Bradisismo: Quando la Terra Sprofonda</h3>
      <p class="text-slate-600 leading-relaxed mb-4">
        Il fenomeno che ha trasformato questa grotta terrestre in una caverna marina si chiama <strong>bradisismo</strong>: un lento ma inesorabile abbassamento del suolo causato dall'attivita vulcanica sottostante. Nel corso dei secoli, tutta questa sezione di costa e "sprofonda ta" di diversi metri, portando il pavimento della grotta sotto il livello del mare.
      </p>
      <p class="text-slate-600 leading-relaxed">
        Il risultato e una caverna per meta terrestre (con le stalattiti che pendono dal soffitto) e per meta marina, con l'acqua del Tirreno che occupa la parte bassa. Le stalagmiti originarie sono ora sommerse a circa 4 metri di profondita, visibili dall'alto attraverso le acque cristalline.
      </p>
    </div>
    <p class="text-slate-600 text-lg leading-relaxed">
      La grotta si estende per circa 60 metri di larghezza e raggiunge un'altezza massima di 24 metri. Il soffitto e decorato da concrezioni calcaree millenarie, alcune delle quali formano suggestive colonne dove le stalattiti si sono quasi congiunte con le ex-stalagmiti ora sommerse.
    </p>
  </div>

  <!-- Il fenomeno smeraldo -->
  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">Il Segreto del Colore Smeraldo</h2>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      Il fenomeno che rende la Grotta Smeraldo unica al mondo e puramente ottico-fisico, ma non per questo meno meraviglioso. Sul fondo della grotta, a circa 8 metri di profondita, si apre una grande fessura nel calcare che comunica direttamente con il mare aperto.
    </p>
    <div class="space-y-4">
      <div class="bg-white p-6 rounded-[2rem] border border-slate-100 shadow-sm flex gap-5">
        <div class="w-10 h-10 rounded-full bg-med-gold/10 flex-shrink-0 flex items-center justify-center text-med-gold font-bold text-xs sm:text-sm">1</div>
        <div>
          <h4 class="font-bold text-slate-900 mb-1">La luce entra dal basso</h4>
          <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">La luce solare penetra dall'esterno attraverso questa apertura subacquea. Invece di illuminare la caverna dall'alto come accade normalmente, la illumina dal basso verso l'alto.</p>
        </div>
      </div>
      <div class="bg-white p-6 rounded-[2rem] border border-slate-100 shadow-sm flex gap-5">
        <div class="w-10 h-10 rounded-full bg-med-gold/10 flex-shrink-0 flex items-center justify-center text-med-gold font-bold text-xs sm:text-sm">2</div>
        <div>
          <h4 class="font-bold text-slate-900 mb-1">L'acqua filtra le lunghezze d'onda rosse</h4>
          <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">L'acqua marina assorbe le lunghezze d'onda piu lunghe dello spettro (i rossi e gli arancioni) mentre lascia passare le frequenze verdi e blu-verdi. Il risultato e una luce che arriva alla superficie della caverna gia fortemente virata verso il verde.</p>
        </div>
      </div>
      <div class="bg-white p-6 rounded-[2rem] border border-slate-100 shadow-sm flex gap-5">
        <div class="w-10 h-10 rounded-full bg-med-gold/10 flex-shrink-0 flex items-center justify-center text-med-gold font-bold text-xs sm:text-sm">3</div>
        <div>
          <h4 class="font-bold text-slate-900 mb-1">La rifrazione amplifica l'effetto</h4>
          <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Quando questa luce verde-filtrata emerge in superficie, illumina la caverna dal basso creando un bagliore che si riflette sulle pareti calcaree e sul soffitto. Il risultato e quell'atmosfera magica, quasi subacquea, che ti avvolge non appena entri.</p>
        </div>
      </div>
    </div>
  </div>

  <!-- Il Presepe Sommerso -->
  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">Il Presepe Sommerso: Una Tradizione dal 1956</h2>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      A circa 4 metri di profondita, sul fondo della grotta, riposano le figure di un presepe in ceramica smaltata. E il Presepe Sommerso, una delle tradizioni piu suggestive dell'intera Costiera Amalfitana.
    </p>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      La storia inizia nel 1956, quando il proprietario dell'imbarcadero Donato Carotenuto decide di collocare alcune figure in ceramica sul fondo della grotta. L'opera fu realizzata dall'artista sorrentino <strong>Attilio Pentone</strong>, specializzato nella ceramica tradizionale campana. Le figure rappresentano la classica Nativita: la Sacra Famiglia, i Re Magi, i pastori e gli animali del presepe napoletano.
    </p>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      Nel corso degli anni le figure sono aumentate: ogni 24 dicembre, un gruppo di sommozzatori locali scende sul fondo per aggiungere nuovi personaggi o restaurare quelli esistenti, mantenendo viva una tradizione che oggi conta oltre 30 statuine.
    </p>
    <p class="text-slate-600 text-lg leading-relaxed">
      Viste dall'alto delle barchette che girano nella grotta, le figure del presepe appaiono in modo nitidissimo attraverso le acque trasparenti, illuminate dalla luce smeraldo che le avvolge come fosse una scena incantata.
    </p>
  </div>

  <!-- Come arrivare -->
  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">Come Arrivare: Tutte le Opzioni</h2>
    <p class="text-slate-600 text-lg leading-relaxed mb-8">
      La Grotta dello Smeraldo Amalfi (Grotta Smeralda) si trova sulla Statale Amalfitana tra Amalfi (5 km) e Positano (15 km). Ci sono tre modi per raggiungerla.
    </p>
    <div class="overflow-hidden rounded-[2rem] border border-slate-100 shadow-sm">
      <table class="w-full text-xs sm:text-xs sm:text-sm">
        <thead class="bg-slate-900 text-white">
          <tr>
            <th class="text-left p-5 font-serif font-bold text-med-gold">Mezzo</th>
            <th class="text-left p-5 font-serif font-bold text-med-gold">Partenza</th>
            <th class="text-left p-5 font-serif font-bold text-med-gold">Durata</th>
            <th class="text-left p-5 font-serif font-bold text-med-gold">Note</th>
          </tr>
        </thead>
        <tbody class="bg-white">
          <tr class="border-b border-slate-100">
            <td class="p-5 font-bold">Via mare (consigliato)</td>
            <td class="p-5 text-slate-600">Porto di <a href="/it-it/costiera-amalfitana/amalfi/" class="text-med-blue hover:underline">Amalfi</a></td>
            <td class="p-5 text-slate-600">~10 min</td>
            <td class="p-5 text-slate-500">Taxi-boat con partenze frequenti (aprile-ottobre). Prezzo ca. €10-12 a/r. Si sale direttamente sulla barca che entra in grotta.</td>
          </tr>
          <tr class="border-b border-slate-100">
            <td class="p-5 font-bold">Via terra (ascensore)</td>
            <td class="p-5 text-slate-600">SS163 - Conca dei Marini</td>
            <td class="p-5 text-slate-600">2 min in ascensore</td>
            <td class="p-5 text-slate-500">Parcheggio sulla Statale, poi ascensore panoramico fino all'imbarcadero. Ideale se si viene in auto. Incluso nel biglietto.</td>
          </tr>
          <tr>
            <td class="p-5 font-bold">Bus SITA</td>
            <td class="p-5 text-slate-600">Amalfi / Positano</td>
            <td class="p-5 text-slate-600">15-25 min</td>
            <td class="p-5 text-slate-500">Scendere alla fermata "Grotta dello Smeraldo Amalfi (Grotta Smeralda)" sulla SS163. Poi ascensore. Soluzione piu economica ma dipendente dagli orari SITA.</td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>

  <!-- Orari e prezzi -->
  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">Grotta dello Smeraldo: Orari e Prezzi 2026</h2>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      Il prezzo del biglietto della Grotta dello Smeraldo è di circa €7 a persona e comprende il giro in barca a remi all'interno della cavità. Gli orari cambiano con la stagione e con le condizioni del mare: quelli qui sotto sono la fascia abituale, ma vanno sempre verificati il giorno stesso, perché con mare mosso la grotta chiude senza preavviso.
    </p>
    <div class="overflow-hidden rounded-[2rem] border border-slate-100 shadow-sm mb-6">
      <table class="w-full text-sm">
        <thead class="bg-slate-900 text-white">
          <tr>
            <th class="text-left p-4 font-bold text-med-gold">Voce</th>
            <th class="text-left p-4 font-bold text-med-gold">Dettaglio</th>
          </tr>
        </thead>
        <tbody class="bg-white">
          <tr class="border-b border-slate-100"><td class="p-4 font-semibold">Orario estivo (aprile-ottobre)</td><td class="p-4">9:00-16:00 circa, ultimo ingresso mezz'ora prima</td></tr>
          <tr class="border-b border-slate-100"><td class="p-4 font-semibold">Orario invernale (novembre-marzo)</td><td class="p-4">Ridotto, chiusura anticipata nel pomeriggio</td></tr>
          <tr class="border-b border-slate-100"><td class="p-4 font-semibold">Biglietto d'ingresso</td><td class="p-4">Circa €7 a persona, barca a remi inclusa</td></tr>
          <tr class="border-b border-slate-100"><td class="p-4 font-semibold">Ascensore da Conca dei Marini</td><td class="p-4">Incluso nel biglietto</td></tr>
          <tr class="border-b border-slate-100"><td class="p-4 font-semibold">Taxi-boat da Amalfi (andata e ritorno)</td><td class="p-4">€10-12 a persona, ingresso escluso</td></tr>
          <tr class="border-b border-slate-100"><td class="p-4 font-semibold">Durata della visita</td><td class="p-4">20-30 minuti dentro la grotta</td></tr>
          <tr class="border-b border-slate-100"><td class="p-4 font-semibold">Orario migliore</td><td class="p-4">10:00-12:00, quando la luce entra più diritta</td></tr>
          <tr><td class="p-4 font-semibold">Pagamento</td><td class="p-4">Meglio avere contanti alla biglietteria</td></tr>
        </tbody>
      </table>
    </div>
    <p class="text-slate-600 text-lg leading-relaxed">
      Non serve prenotare: si paga in biglietteria e si sale sulla barca a rotazione. Nelle ore centrali di luglio e agosto l'attesa può arrivare a 30-40 minuti, un'altra ragione per arrivare in mattinata.
    </p>
  </div>

  <!-- Itinerario combinato -->
  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">Cosa Vedere Vicino: l'Itinerario Perfetto</h2>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      La Grotta dello Smeraldo è solo una delle attrazioni di Conca dei Marini. A soli 2 km lungo la SS163 si trova <a href="/it-it/spiagge/costiera-amalfitana/marina-di-conca/" class="text-med-blue hover:underline"><strong>Marina di Conca</strong></a>, la piccola baia turchese del paese — incastonata tra falesie calcaree e ancora frequentata dai pescatori locali. È la base perfetta per il pranzo di pesce dopo la visita alla grotta.
    </p>
    <div class="bg-med-cream p-8 rounded-[2rem] border border-med-gold/20 my-6">
      <h3 class="font-serif text-xl font-bold text-slate-900 mb-4">Itinerario di Mezza Giornata Consigliato</h3>
      <ul class="space-y-3 text-slate-600">
        <li><strong>9:00 - 9:30</strong> · Arrivo via bus SITA o auto alla SS163, ascensore per la Grotta dello Smeraldo</li>
        <li><strong>10:00 - 10:30</strong> · Visita in barca della grotta con luce smeraldo al massimo splendore</li>
        <li><strong>11:00 - 12:30</strong> · Discesa a <a href="/it-it/spiagge/costiera-amalfitana/marina-di-conca/" class="text-med-blue hover:underline">Marina di Conca</a> per mezza giornata di spiaggia o snorkeling</li>
        <li><strong>13:00</strong> · Pranzo a La Tonnarella, ristorante storico sulla spiaggia</li>
        <li><strong>15:00</strong> · Bus SITA o auto per Amalfi (5 km) o Praiano (3 km)</li>
      </ul>
    </div>
    <p class="text-slate-600 text-lg leading-relaxed">
      In alternativa, puoi abbinare la grotta a un tour in barca più completo che include anche il <a href="/it-it/spiagge/costiera-amalfitana/fiordo-di-furore/" class="text-med-blue hover:underline">Fiordo di Furore</a> e la <a href="/it-it/spiagge/costiera-amalfitana/marina-di-praia/" class="text-med-blue hover:underline">Marina di Praia</a> — un'esperienza completa di circa 3-4 ore che parte sempre da Amalfi o Positano.
    </p>
  </div>

  <!-- Local Tips -->
  <div class="bg-white p-8 rounded-[2rem] shadow-xl border border-slate-100">
