---
import BlogPostLayout from '../../../../layouts/BlogPostLayout.astro';

const lang = 'it-it';
const post = {
  title: 'Da Parigi alla Costiera Amalfitana in Treno',
  subtitle: 'Il percorso di linea via Milano e Napoli, quanto dura davvero, e l\'Orient-Express di tre notti che oggi fa lo stesso viaggio come vacanza',
  category: 'GUIDE',
  date: '14 Settembre 2026',
  readTime: '11 min',
  image: '/images/frecciarossa-napoli-hero.webp',
  imageAlt: "Frecciarossa 1000 a Napoli Centrale, l'ultimo cambio sulla rotta da Parigi",
  path: '/it-it/blog/parigi-costiera-amalfitana-treno/',
};

const metaTitle = 'Da Parigi alla Costiera Amalfitana in Treno: Tratte 2026';
const metaDescription = 'Non esiste un treno diretto. Parigi-Milano in circa 7 ore, Milano-Napoli in 4h30, poi Sorrento o Salerno: fra le 13 e le 14 ore in totale. Più il Venice Simplon-Orient-Express da Parigi alla Costiera e quanto costa.';

const breadcrumbs = [
  { name: 'Home', url: '/it-it/' },
  { name: 'Blog', url: '/it-it/blog/' },
  { name: 'Da Parigi alla Costiera Amalfitana in Treno', url: '/it-it/blog/parigi-costiera-amalfitana-treno/' },
];

const quickInfo = [
  { label: 'Treno diretto', value: 'Non esiste, il viaggio è in tre tratte' },
  { label: 'Parigi-Milano', value: 'Circa 7h, 2 andata e ritorno al giorno' },
  { label: 'Milano-Napoli', value: 'Circa 4h30 in Frecciarossa' },
  { label: 'Napoli-Sorrento', value: 'Circa 1h in Circumvesuviana' },
  { label: 'Napoli-Salerno', value: '35 minuti in alta velocità' },
  { label: 'Durata totale', value: 'Fra le 13 e le 14 ore' },
  { label: 'Soluzione migliore', value: 'Due giorni con una notte di sosta' },
  { label: 'Opzione di lusso', value: 'Orient-Express, 3 notti, da circa 9.900 euro' },
];

const faq = [
  {
    q: 'Esiste un treno diretto da Parigi alla Costiera Amalfitana?',
    a: 'No. Nessuna ferrovia arriva a Positano, Amalfi o Ravello, e non esiste alcun servizio diretto fra Parigi e il Sud Italia. Il viaggio si compone di tre tratte: Parigi-Milano, Milano-Napoli e poi Napoli verso Sorrento o Salerno, le due porte ferroviarie della costa.',
  },
  {
    q: 'Quanto dura il viaggio con i treni di linea?',
    a: 'Fra le 13 e le 14 ore di viaggio effettivo, senza contare i margini per le coincidenze. Circa 7 ore da Parigi a Milano, circa 4 ore e 30 da Milano a Napoli, poi fra 35 minuti e un\'ora per l\'ultima tratta. Farlo in una sola giornata è tecnicamente possibile e davvero faticoso.',
  },
  {
    q: 'La linea Parigi-Milano funziona regolarmente?',
    a: 'Sì. Il percorso attraverso la valle della Maurienne era stato interrotto da una frana nell\'agosto 2023 ed ha riaperto il 31 marzo 2025, con il ritorno sia dei TGV Inoui di SNCF sia dei Frecciarossa di Trenitalia. I lavori nel tunnel del Moncenisio hanno poi sospeso i treni diretti dall\'11 settembre al 9 ottobre 2026, con il servizio diretto che riprende dal 10 ottobre 2026.',
  },
  {
    q: 'Meglio puntare su Sorrento o su Salerno?',
    a: 'Salerno se la destinazione è Amalfi, Positano, Ravello o Minori: ha il terminal dei traghetti e i bus SITA lungo la statale. Sorrento se si alloggia in penisola sorrentina o si vuole il traghetto per Capri. Salerno è anche più rapida da raggiungere, perché ci fermano i treni ad alta velocità.',
  },
  {
    q: 'Che cos\'è l\'Orient-Express da Parigi alla Costiera Amalfitana?',
    a: 'Un itinerario di tre notti sul Venice Simplon-Orient-Express gestito da Belmond: una notte a bordo attraversando la Francia e la Riviera italiana, una visita guidata privata a Pompei e due notti all\'hotel Caruso di Ravello. La partenza inaugurale ha lasciato Parigi il 4 maggio 2026 ed è andata esaurita; altre partenze sono previste nel 2027, con prezzi a partire da circa 9.900 euro a persona.',
  },
  {
    q: 'Si può viaggiare di notte invece di dormire in hotel?',
    a: 'Non su un treno diretto. Il vecchio notturno fra Parigi e l\'Italia non circola più, quindi l\'equivalente pratico è una notte in albergo a Milano, Torino, Roma o Napoli. Molti scelgono Roma, perché divide il viaggio quasi a metà e la tratta successiva fino a Napoli dura poco più di un\'ora.',
  },
];

const sidebarLinks = [
  { label: 'La Costiera in treno', href: '/it-it/blog/costiera-amalfitana-in-treno/' },
  { label: 'Dove atterrare', href: '/it-it/blog/dove-atterrare-costiera-amalfitana/' },
  { label: 'Traghetti', href: '/it-it/guida/traghetti/' },
  { label: 'Bus SITA', href: '/it-it/guida/bus-sita/' },
  { label: 'Costiera Amalfitana', href: '/it-it/costiera-amalfitana/' },
];

const authorRole = 'Guide locali · Costiera Amalfitana';

const relatedArticles = [
  {
    title: 'La Costiera Amalfitana in treno',
    category: 'GUIDE',
    date: '10 Agosto 2026',
    image: '/images/treno-costiera-hero.webp',
    imageAlt: 'La Costiera Amalfitana in treno',
    path: '/it-it/blog/costiera-amalfitana-in-treno/'
  },
  {
    title: 'Dove atterrare per la Costiera Amalfitana',
    category: 'GUIDE',
    date: '5 Agosto 2026',
    image: '/images/aeroporti-costiera-hero.webp',
    imageAlt: 'Aeroporti per la Costiera Amalfitana',
    path: '/it-it/blog/dove-atterrare-costiera-amalfitana/'
  }
];

const imageCredit = {
  author: 'philip.mallis / Wikimedia Commons',
  sourceUrl: 'https://commons.wikimedia.org/wiki/File:Trenitalia_Frecciarossa_ETR400_(Frecciarossa_1000)_trains_at_Napoli_Centrale_Railway_Station_in_Naples,_Italy.jpg',
  license: 'CC BY-SA 2.0',
  licenseUrl: 'https://creativecommons.org/licenses/by-sa/2.0/',
};

const keyTakeaways = [
  'Non esiste un treno diretto. Da Parigi alla Costiera sono tre tratte, fra le 13 e le 14 ore di viaggio, e funziona molto meglio divise su due giorni.',
  'Da Parigi Gare de Lyon a Milano Centrale ci vogliono circa 7 ore, con due andata e ritorno al giorno fra TGV Inoui di SNCF e Frecciarossa di Trenitalia.',
  'Milano-Napoli è la parte facile: circa 4 ore e 30 in Frecciarossa, con partenze lungo tutta la giornata.',
  'Le porte ferroviarie della costa sono Salerno e Sorrento. Né Positano né Amalfi hanno una stazione, e non l\'avranno mai.',
  'Il Venice Simplon-Orient-Express vende oggi un viaggio Parigi-Costiera Amalfitana, ma è una vacanza di tre notti che finisce in un hotel di Ravello, non un modo per arrivare.',
];
---

<BlogPostLayout
  lang={lang}
  post={post}
  metaTitle={metaTitle}
  metaDescription={metaDescription}
  breadcrumbs={breadcrumbs}
  quickInfo={quickInfo}
  faq={faq}
  sidebarLinks={sidebarLinks}
  authorRole={authorRole}
  relatedArticles={relatedArticles}
  imageCredit={imageCredit}
  pageKey="paris-to-amalfi-coast-train"
>

  <!-- Key Takeaways -->
  <div class="bg-slate-900 text-white p-8 rounded-[2rem]">
    <div class="flex items-center gap-3 mb-6">
      <svg class="w-5 h-5 text-med-gold flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
      <h2 class="font-serif text-lg font-bold text-med-gold uppercase tracking-[0.15em]">Punti Chiave</h2>
    </div>
    <ul class="space-y-4">
      {keyTakeaways.map((point) => (
        <li class="flex items-start gap-3">
          <span class="w-1.5 h-1.5 rounded-full bg-med-gold flex-shrink-0 mt-2"></span>
          <span class="text-white/80 text-xs sm:text-sm leading-relaxed">{point}</span>
        </li>
      ))}
    </ul>
  </div>

  <!-- Intro -->
  <div>
    <p class="text-slate-600 text-xl leading-relaxed mb-6 font-light">
      Dietro la formula "da Parigi alla Costiera Amalfitana in treno" ci sono oggi due viaggi molto diversi. Uno è una sequenza di treni ad alta velocità ordinari che porta da Gare de Lyon a un hotel sul mare per il prezzo di un volo, nel tempo che serve a leggere un romanzo lungo. L'altro è un vagone letto che costa quanto un'utilitaria e tratta il viaggio stesso come la vacanza. Vale la pena conoscerli entrambi, ma quello di cui quasi tutti hanno bisogno è il primo.
    </p>
  </div>

  <!-- Le tre tratte -->
  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">Il Percorso di Linea: Tre Tratte</h2>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      Poiché nessuna linea raggiunge i paesi della costa, ogni viaggio ferroviario dalla Francia finisce a <strong>Salerno</strong> o a <strong>Sorrento</strong>, e l'ultimo tratto si fa in traghetto, in autobus o in auto. Quella che segue è la combinazione affidabile più rapida.
    </p>

    <div class="overflow-x-auto rounded-[2rem] border border-slate-100 shadow-sm">
      <table class="w-full text-xs sm:text-sm">
        <thead class="bg-slate-900 text-white">
          <tr>
            <th class="text-left p-5 font-serif font-bold text-med-gold">Tratta</th>
            <th class="text-left p-5 font-serif font-bold text-med-gold">Servizio</th>
            <th class="text-left p-5 font-serif font-bold text-med-gold">Durata</th>
          </tr>
        </thead>
        <tbody class="bg-white">
          <tr class="border-b border-slate-100">
            <td class="p-5 font-bold">Parigi Gare de Lyon - Milano Centrale</td>
            <td class="p-5 text-slate-600">TGV Inoui o Frecciarossa, via Lione, Chambéry, Modane e Torino. Due andata e ritorno al giorno.</td>
            <td class="p-5 text-slate-600">Circa 7h</td>
          </tr>
          <tr class="border-b border-slate-100">
            <td class="p-5 font-bold">Milano Centrale - Napoli Centrale</td>
            <td class="p-5 text-slate-600">Frecciarossa o Italo, frequenti durante la giornata, via Bologna, Firenze e Roma.</td>
            <td class="p-5 text-slate-600">Circa 4h30</td>
          </tr>
          <tr class="border-b border-slate-100">
            <td class="p-5 font-bold">Napoli - Salerno</td>
            <td class="p-5 text-slate-600">L'alta velocità prosegue verso sud; i regionali sono più lenti ma costano meno.</td>
            <td class="p-5 text-slate-600">Da 35 min a 1h15</td>
          </tr>
          <tr>
            <td class="p-5 font-bold">Napoli - Sorrento</td>
            <td class="p-5 text-slate-600">Circumvesuviana o Campania Express da Napoli Porta Nolana o Garibaldi.</td>
            <td class="p-5 text-slate-600">Circa 1h</td>
          </tr>
        </tbody>
      </table>
    </div>

    <p class="text-slate-600 text-lg leading-relaxed mt-6">
      Aggiungendo i trasferimenti fra i binari a Milano e a Napoli si arriva fra le 13 e le 15 ore porta a porta. Quello che succede dopo Salerno o Sorrento è spiegato nel dettaglio nella nostra guida alla <a href="/it-it/blog/costiera-amalfitana-in-treno/" class="text-med-blue hover:underline">Costiera Amalfitana in treno</a>.
    </p>
  </div>

  <!-- Via Svizzera -->
  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">L'Alternativa Svizzera, e Quando Serve</h2>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      La traversata alpina fra Francia e Italia è il punto fragile di questo viaggio. Una frana nella valle della Maurienne ha tagliato la linea alla fine di agosto 2023 e l'ha tenuta chiusa per un anno e mezzo, fino alla riapertura del <strong>31 marzo 2025</strong>. I lavori nel tunnel del Moncenisio hanno poi sospeso di nuovo i diretti Parigi-Milano dall'<strong>11 settembre al 9 ottobre 2026</strong>, con il servizio diretto che riprende dal 10 ottobre 2026.
    </p>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      Ogni volta che succede, la deviazione passa dalla Svizzera: Parigi-Basilea con il TGV Lyria in circa tre ore, poi un EuroCity attraverso il Gottardo fino a Milano. È più lungo, di solito di un paio d'ore, ma è un bel viaggio e tiene tutto il percorso sui binari. Conviene verificarlo prima di prenotare anche in un anno normale, perché questo corridoio si interrompe più spesso di altri.
    </p>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div class="bg-white p-6 rounded-[2rem] border border-slate-100 shadow-sm">
        <h4 class="font-bold text-slate-900 mb-2">Prenotate presto la tratta francese</h4>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Con sole due andata e ritorno al giorno sul diretto Parigi-Milano, le tariffe economiche spariscono in fretta. I biglietti aprono di solito con quattro, sei mesi di anticipo e i prezzi migliori vanno via nelle prime settimane.</p>
      </div>
      <div class="bg-white p-6 rounded-[2rem] border border-slate-100 shadow-sm">
        <h4 class="font-bold text-slate-900 mb-2">Comprate le tratte italiane a parte</h4>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Non esiste un biglietto unico, quindi una coincidenza persa è un problema vostro, non della ferrovia. Lasciate un margine ampio a Milano e trattate Milano-Napoli come un acquisto separato.</p>
      </div>
    </div>
  </div>

  <!-- Dove spezzare -->
  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">Dove Spezzare il Viaggio</h2>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      Farlo in un giorno solo significa partire da Parigi all'alba e arrivare in costiera col buio, che e un pessimo modo di conoscere un posto il cui unico argomento è il panorama. Una notte di sosta cambia completamente il viaggio.
    </p>

    <div class="bg-white p-8 rounded-[2rem] border border-slate-100 shadow-sm">
      <h3 class="font-serif text-xl font-bold text-slate-900 mb-5">Tre soste sensate</h3>
      <div class="space-y-3">
        <div class="flex items-start gap-3">
          <div class="w-6 h-6 rounded-full bg-med-gold/15 flex-shrink-0 flex items-center justify-center text-med-gold font-bold text-xs">1</div>
          <p class="text-slate-600 text-xs sm:text-sm leading-relaxed"><strong>Milano.</strong> La scelta ovvia: si arriva in prima serata con gli hotel accanto a Centrale e si riparte la mattina dopo con ancora quattro ore e mezza davanti. Semplice, se non entusiasmante.</p>
        </div>
        <div class="flex items-start gap-3">
          <div class="w-6 h-6 rounded-full bg-med-gold/15 flex-shrink-0 flex items-center justify-center text-med-gold font-bold text-xs">2</div>
          <p class="text-slate-600 text-xs sm:text-sm leading-relaxed"><strong>Roma.</strong> Il compromesso migliore. Dista circa nove ore da Parigi e lascia poco più di un'ora fino a Napoli il giorno dopo, così si arriva in costiera per pranzo con ancora un pomeriggio davanti.</p>
        </div>
        <div class="flex items-start gap-3">
          <div class="w-6 h-6 rounded-full bg-med-gold/15 flex-shrink-0 flex items-center justify-center text-med-gold font-bold text-xs">3</div>
          <p class="text-slate-600 text-xs sm:text-sm leading-relaxed"><strong>Napoli.</strong> Tirare dritto e dormire vicino a Centrale, poi prendere la prima barca o il primo treno al mattino. Funziona, e regala una serata a Napoli, che non e una punizione.</p>
        </div>
      </div>
    </div>
  </div>

  <!-- Orient-Express -->
  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">La Versione Orient-Express</h2>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      Nel 2026 Belmond ha messo il <strong>Venice Simplon-Orient-Express</strong> su una nuova rotta da Parigi alla Costiera Amalfitana, ed è il motivo per cui la ricerca ha cominciato a impennarsi. Non e un trasporto. E un pacchetto di tre notti: una notte in cabina a bordo mentre il treno attraversa la Francia e costeggia le due Riviere, una visita guidata privata a Pompei e poi due notti al Caruso, l'hotel di Belmond in un palazzo dell'undicesimo secolo sopra <a href="/it-it/costiera-amalfitana/ravello/" class="text-med-blue hover:underline">Ravello</a>.
    </p>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      La partenza inaugurale ha lasciato Parigi alle 11:00 del 4 maggio 2026 ed è arrivata a Pompei il 7 maggio. È andata esaurita, e altre partenze sono state programmate per il 2027, fra cui una a fine aprile e una a giugno. I prezzi partono da circa <strong>9.900 euro a persona</strong> in cabina storica doppia, con pasti, bevande, escursioni e trasferimento finale a Napoli inclusi.
    </p>

    <blockquote class="border-l-4 border-med-gold pl-6 my-8">
      <p class="text-slate-700 text-xl font-serif italic leading-relaxed">
        "Uno dei due viaggi e un modo per arrivare in Costiera Amalfitana. L'altro e una ragione per partire."
      </p>
    </blockquote>

    <p class="text-slate-600 text-lg leading-relaxed">
      Vale la pena essere chiari su cosa si compra: l'Orient-Express finisce a Ravello e comprende due notti in hotel, quindi sostituisce la prima parte di una vacanza piuttosto che un biglietto aereo. Se l'obiettivo è semplicemente arrivare senza volare, il percorso di linea descritto sopra fa la stessa cosa a una frazione minima del costo.
    </p>
  </div>

  <!-- Consigli -->
  <div class="bg-white p-8 rounded-[2rem] shadow-xl border border-slate-100">
    <div class="flex items-center gap-4 mb-6">
      <svg class="w-6 h-6 text-med-gold flex-shrink-0" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M9 18h6"/><path d="M10 22h4"/><path d="M15.09 14c.18-.98.65-1.74 1.41-2.5A4.65 4.65 0 0 0 18 8 6 6 0 0 0 6 8c0 1 .23 2.23 1.5 3.5A4.61 4.61 0 0 1 8.91 14"/></svg>
      <h3 class="text-xl font-bold">Consigli dell'esperto</h3>
    </div>
    <div class="space-y-6">
      <div>
        <p class="font-bold text-slate-900 mb-1">Decidete Salerno o Sorrento prima di comprare qualsiasi cosa</p>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Cambia tutta l'ultima giornata. Salerno dà accesso ai <a href="/it-it/guida/traghetti/" class="text-med-blue hover:underline">traghetti</a> per Amalfi e Positano e al <a href="/it-it/guida/bus-sita/" class="text-med-blue hover:underline">bus SITA</a> sulla statale. Sorrento dà accesso alla penisola e a Capri. Sbagliare aggiunge due ore di percorso a ritroso.</p>
      </div>
      <div>
        <p class="font-bold text-slate-900 mb-1">Non programmate l'arrivo dopo il tramonto</p>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">I traghetti si fermano nel tardo pomeriggio, la statale è lenta al buio e quasi tutti gli indirizzi di Positano finiscono con una scalinata. Puntate a essere in costiera entro metà pomeriggio, il che da Parigi significa realisticamente dormire prima da qualche parte in Italia.</p>
      </div>
      <div>
        <p class="font-bold text-slate-900 mb-1">Viaggiate leggeri per l'ultima tratta</p>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">La Circumvesuviana per Sorrento è una linea pendolare senza portabagagli e spesso senza posti a sedere. Il Campania Express è la versione turistica dello stesso percorso, con posto garantito e meno fermate, e alla fine di una lunga giornata vale il supplemento.</p>
      </div>
      <div>
        <p class="font-bold text-slate-900 mb-1">Confrontatelo onestamente con l'aereo</p>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Parigi-Napoli in volo dura circa due ore. Il treno vince su comfort, comodità da centro a centro ed emissioni, e perde nettamente sul tempo. La nostra guida su <a href="/it-it/blog/dove-atterrare-costiera-amalfitana/" class="text-med-blue hover:underline">dove atterrare</a> illustra l'alternativa.</p>
      </div>
    </div>
  </div>

</BlogPostLayout>
