---
import BlogPostLayout from '../../../../layouts/BlogPostLayout.astro';

const lang = 'it-it';
const post = {
  title: 'Meteo Costiera Amalfitana Luglio e Agosto 2026',
  subtitle: 'Positano e Amalfi in estate: temperature, orografia, survival kit e i tre meteo hack per non impazzire',
  category: 'GUIDE',
  date: '6 Luglio 2026',
  readTime: '8 min',
  image: '/images/meteo-costiera-luglio-agosto-hero.webp',
  imageAlt: 'Vista panoramica di Positano sulla Costiera Amalfitana in estate',
  path: '/it-it/blog/meteo-luglio-agosto-2026/',
};

const metaTitle = 'Meteo Costiera Amalfitana Luglio Agosto 2026 | Positano e Amalfi';
const metaDescription = "Luglio 31°C, Agosto 32°C con umidita al 66%. Come funziona il microclima della Costiera, quali spiagge vanno in ombra alle 15:30, cosa mettere in valigia e 3 meteo hack per Positano e Amalfi.";

const breadcrumbs = [
  { name: 'Home', url: '/it-it/' },
  { name: 'Blog', url: '/it-it/blog/' },
  { name: 'Meteo Luglio e Agosto 2026', url: '/it-it/blog/meteo-luglio-agosto-2026/' },
];

const quickInfo = [
  { label: 'Massima media Luglio', value: '31°C (picchi 34°C)' },
  { label: 'Massima media Agosto', value: '32°C (afa al 66%)' },
  { label: 'Minima notturna', value: '22-23°C' },
  { label: 'Temperatura mare', value: '25°C Lug, 27°C Ago' },
  { label: 'Ore di sole', value: '10-11 al giorno' },
  { label: 'Indice UV', value: '9-10 (molto alto)' },
  { label: 'Rischio pioggia', value: 'Rari temporali di calore fine Agosto' },
  { label: 'Vento locale', value: '"Faugn" caldo serale' },
];

const faq = [
  {
    q: 'Fa piu caldo a Luglio o ad Agosto sulla Costiera Amalfitana?',
    a: "Ad Agosto. Luglio ha una media di 31°C ma con aria piu secca, mentre Agosto si stabilizza sui 32-33°C con umidita al 66-70% e la roccia calcarea che ha accumulato calore per settimane. La percezione del caldo, soprattutto nei vicoli stretti di Amalfi e Atrani, e sensibilmente piu alta ad Agosto.",
  },
  {
    q: 'A che ora la spiaggia di Amalfi va in ombra?',
    a: 'Le spiagge di Amalfi, Atrani e Minori sono esposte a sud-est: il sole scompare dietro la montagna intorno alle 15:30-16:00 in piena estate. Ottimo se cerchi refrigerio nel pomeriggio, meno se vuoi restare al sole fino al tramonto. In quel caso conviene spostarsi a Positano o Praiano (Gavitella), che restano illuminate fino alle 19:30-20:00.',
  },
  {
    q: 'Serve la protezione solare 50 in Costiera anche se sono abituato al sole?',
    a: "Si, sempre. L'indice UV tocca 9-10 tra Luglio e Agosto e le rocce calcaree bianche riflettono la luce come uno specchio. Il riverbero e piu aggressivo di una spiaggia italiana media: protezione 50, cappello a tesa larga e occhiali polarizzati sono i tre alleati per evitare scottature il primo giorno.",
  },
  {
    q: 'Quando e piu caldo il mare, a Luglio o ad Agosto?',
    a: 'Ad Agosto. A Luglio il mare oscilla sui 25°C, ideale per lunghi bagni. Ad Agosto tocca il picco stagionale a 27°C, praticamente una temperatura da piscina riscaldata, con visibilita subacquea eccezionale nelle giornate di bonaccia.',
  },
  {
    q: 'Piove ad Agosto sulla Costiera Amalfitana?',
    a: "Molto raramente. Ad Agosto si contano in media 3 giorni con precipitazioni, quasi sempre temporali di calore nel tardo pomeriggio: durano 20-30 minuti, rinfrescano l'aria e regalano cieli spettacolari dopo. Difficilmente rovinano una giornata intera, ma conviene tenere d'occhio il radar dalle 17:00 in poi.",
  },
  {
    q: 'Come mi vesto in Costiera in piena estate?',
    a: "Tessuti naturali e leggeri: lino, cotone, seta. Evita i sintetici che aumentano la sudorazione. Per camminare servono sandali con suola in gomma o scarpe in tela con buon grip: i gradini di pietra calcarea e i pavimenti di Positano diventano scivolosi con il mix di caldo e salsedine. I tacchi restano in hotel.",
  },
  {
    q: 'Meglio muoversi in bus o in traghetto tra Luglio e Agosto?',
    a: "Traghetto, senza dubbio. Il bus SITA tra le 11:00 e le 15:00 in piena estate significa attese sotto il sole cocente e traffico bloccato. I traghetti Travelmar costano di piu ma la brezza marina rende lo spostamento una gita panoramica ventilata. Il tratto Salerno-Amalfi-Positano si percorre in circa 60-70 minuti.",
  },
  {
    q: "Che cos'e il 'Faugn' della Costiera Amalfitana?",
    a: "E il nome locale di una brezza calda e secca che scende dalle montagne di notte, tipica delle sere estive. Puo capitare che alle 23:00 arrivi un colpo di vento tiepido: si sente soprattutto in barca al chiaro di luna o nelle terrazze piu alte. Porta sempre una camicia leggera a maniche lunghe per le escursioni serali via mare.",
  },
  {
    q: 'Ravello e davvero piu fresca della costa?',
    a: 'Si. Trovandosi a 365 metri di altitudine, Ravello registra costantemente 3-4°C in meno rispetto ad Amalfi o Positano, con una ventilazione secca che rigenera. E la meta perfetta per una pausa dal caldo delle spiagge, specialmente nei giorni con afa piu intensa di fine Agosto.',
  },
  {
    q: 'Qual e la spiaggia con piu sole della Costiera Amalfitana?',
    a: "La Gavitella a Praiano. Esposta a ovest, riceve luce diretta fino alle 19:30-20:00 e vede il sole tramontare dritto nel mare di fronte a Capri: e l'unica spiaggia della Costiera dove si puo fare aperitivo in costume mentre il sole scende sull'orizzonte marino.",
  },
];

const sidebarLinks = [
  { label: 'Positano', href: '/it-it/costiera-amalfitana/positano/' },
  { label: 'Amalfi', href: '/it-it/costiera-amalfitana/amalfi/' },
  { label: 'Praiano', href: '/it-it/costiera-amalfitana/praiano/' },
  { label: 'Ravello', href: '/it-it/costiera-amalfitana/ravello/' },
  { label: 'Spiagge della Costiera', href: '/it-it/spiagge/' },
];

const authorRole = 'Redazione locale · Costiera Amalfitana';

const relatedArticles = [
  {
    title: 'Tramonti in Spiaggia sulla Costiera Amalfitana',
    category: 'SCOPERTE',
    date: '2 Maggio 2026',
    image: '/images/tramonto-costiera.webp',
    imageAlt: 'Tramonto in spiaggia sulla Costiera Amalfitana',
    path: '/it-it/blog/tramonto-spiaggia-costiera/'
  },
  {
    title: 'Spiagge Comode e Attrezzate della Costiera',
    category: 'GUIDE',
    date: '18 Aprile 2026',
    image: '/images/spiagge-bambini.webp',
    imageAlt: 'Spiagge comode e attrezzate della Costiera Amalfitana',
    path: '/it-it/blog/spiagge-comode-attrezzate/'
  }
];

const keyTakeaways = [
  "Luglio segna 31°C medi con aria secca e mare a 25°C: mese perfetto per la tintarella. Agosto sale a 32-33°C con umidita al 66-70% e mare a 27°C.",
  "Le spiagge di Amalfi, Atrani e Minori vanno in ombra tra le 15:30 e le 16:00; Positano, Praiano e la Gavitella restano al sole fino a sera.",
  "Ravello, a 365 metri di altitudine, ha sempre 3-4°C in meno rispetto alla costa: e la fuga rigenerante dalle giornate afose.",
  "Fine Agosto porta rari temporali di calore nel tardo pomeriggio: 20-30 minuti, rinfrescano l'aria e regalano cieli spettacolari.",
  "In alta stagione i traghetti Travelmar battono i bus SITA su ogni fronte: piu veloci, ventilati e senza il rischio di attese sotto il sole.",
];
---

<BlogPostLayout
  lang={lang}
  post={post}
  metaTitle={metaTitle}
  metaDescription={metaDescription}
  breadcrumbs={breadcrumbs}
  quickInfo={quickInfo}
  faq={faq}
  sidebarLinks={sidebarLinks}
  authorRole={authorRole}
  relatedArticles={relatedArticles}
>

  <!-- Key Takeaways -->
  <div class="bg-slate-900 text-white p-8 rounded-[2rem]">
    <h2 class="font-serif text-lg font-bold text-med-gold uppercase tracking-[0.15em] mb-6">Key Takeaways</h2>
    <ul class="space-y-4">
      {keyTakeaways.map((point) => (
        <li class="flex items-start gap-3">
          <span class="w-1.5 h-1.5 rounded-full bg-med-gold flex-shrink-0 mt-2"></span>
          <span class="text-white/80 text-xs sm:text-sm leading-relaxed">{point}</span>
        </li>
      ))}
    </ul>
  </div>

  <!-- Intro -->
  <div>
    <p class="text-slate-600 text-xl leading-relaxed mb-6 font-light">
      In questo preciso momento l'estate 2026 e nel suo pieno e <a href="/it-it/costiera-amalfitana/positano/" class="text-med-blue hover:underline">Positano</a> e <a href="/it-it/costiera-amalfitana/amalfi/" class="text-med-blue hover:underline">Amalfi</a> sono letteralmente il centro del mondo. Luglio e Agosto significano mare cristallino, tramonti infiniti e le iconiche vibrazioni della Dolce Vita. Significano anche, pero, temperature calde, sole battente e una logistica complessa da gestire.
    </p>
    <p class="text-slate-600 text-lg leading-relaxed">
      La <a href="/it-it/costiera-amalfitana/" class="text-med-blue hover:underline">Costiera</a> ha un microclima unico al mondo: i Monti Lattari bloccano i venti da nord e creano una barriera termica, mentre il mare si trasforma in una piscina riscaldata. Ecco come leggere il meteo e organizzare le tue giornate per evitare i flussi termici peggiori e goderti la vacanza della vita.
    </p>
  </div>

  <!-- Il Bollettino Termico -->
  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">Il Bollettino Termico: Cosa Ti Aspetta Davvero sul Termometro</h2>
    <p class="text-slate-600 text-lg leading-relaxed mb-8">
      Inutile girarci intorno: in questi due mesi fa caldo. Ma c'e caldo e caldo, e i due mesi hanno una personalita molto diversa.
    </p>

    <div class="bg-white p-8 rounded-[2rem] border border-slate-100 shadow-sm mb-6">
      <p class="text-med-gold text-xs font-medium uppercase tracking-[0.25em] mb-3">Luglio</p>
      <h3 class="font-serif text-2xl font-bold text-slate-900 mb-4">Sole a Martello e Caldo Secco</h3>
      <p class="text-slate-600 text-lg leading-relaxed mb-5">
        E il mese perfetto per chi ama la tintarella. Le giornate offrono fino a 15 ore di luce e l'umidita resta contenuta.
      </p>
      <ul class="space-y-4">
        <li class="flex items-start gap-3">
          <span class="w-1.5 h-1.5 rounded-full bg-med-gold flex-shrink-0 mt-2"></span>
          <span class="text-slate-600 text-xs sm:text-sm leading-relaxed"><strong>Le temperature.</strong> Di giorno la media e 31°C, ma se arriva l'anticiclone africano si toccano facilmente i 34°C.</span>
        </li>
        <li class="flex items-start gap-3">
          <span class="w-1.5 h-1.5 rounded-full bg-med-gold flex-shrink-0 mt-2"></span>
          <span class="text-slate-600 text-xs sm:text-sm leading-relaxed"><strong>La sera.</strong> Si scende intorno ai 22°C. La brezza di mare rinfresca l'aria il giusto per permetterti di cenare fuori senza soffrire.</span>
        </li>
        <li class="flex items-start gap-3">
          <span class="w-1.5 h-1.5 rounded-full bg-med-gold flex-shrink-0 mt-2"></span>
          <span class="text-slate-600 text-xs sm:text-sm leading-relaxed"><strong>Il mare.</strong> Acqua spettacolare a 25°C. Ideale per stare a mollo ore senza sentire freddo all'uscita.</span>
        </li>
      </ul>
    </div>

    <div class="bg-white p-8 rounded-[2rem] border border-slate-100 shadow-sm">
      <p class="text-med-gold text-xs font-medium uppercase tracking-[0.25em] mb-3">Agosto</p>
      <h3 class="font-serif text-2xl font-bold text-slate-900 mb-4">Il Picco del Calore (e dell'Afa)</h3>
      <p class="text-slate-600 text-lg leading-relaxed mb-5">
        Ad Agosto il calore accumulato dalle rocce calcaree si fa sentire e l'umidita sale al 65-70%.
      </p>
      <ul class="space-y-4">
        <li class="flex items-start gap-3">
          <span class="w-1.5 h-1.5 rounded-full bg-med-gold flex-shrink-0 mt-2"></span>
          <span class="text-slate-600 text-xs sm:text-sm leading-relaxed"><strong>Le temperature.</strong> Il termometro si stabilizza sui 32-33°C, ma la percezione dell'afa e piu alta rispetto a Luglio, specialmente nei vicoli stretti.</span>
        </li>
        <li class="flex items-start gap-3">
          <span class="w-1.5 h-1.5 rounded-full bg-med-gold flex-shrink-0 mt-2"></span>
          <span class="text-slate-600 text-xs sm:text-sm leading-relaxed"><strong>I temporali estivi.</strong> Verso la fine di Agosto, l'aria bollente incontra il mare caldo. Il risultato? Brevi ma intensi temporali di calore nel tardo pomeriggio. Durano 20 minuti, rinfrescano l'aria e regalano cieli pazzeschi dopo.</span>
        </li>
        <li class="flex items-start gap-3">
          <span class="w-1.5 h-1.5 rounded-full bg-med-gold flex-shrink-0 mt-2"></span>
          <span class="text-slate-600 text-xs sm:text-sm leading-relaxed"><strong>Il mare.</strong> Tocca il suo picco a 27°C. Praticamente un bagno termale in cui si perde il senso del tempo.</span>
        </li>
      </ul>
    </div>
  </div>

  <!-- L'inganno dell'ombra -->
  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">L'Inganno dell'Ombra: Perche l'Orografia Cambia i Tuoi Piani</h2>
    <p class="text-slate-600 text-lg leading-relaxed mb-8">
      Questo e il classico errore da principiante che rovina le giornate in spiaggia. Le montagne della Costiera cadono a picco sul mare e bloccano la luce prima del tempo. Ogni tratto di costa ha il suo orario di ombra.
    </p>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
      <div class="bg-white p-6 rounded-[2rem] border border-slate-100 shadow-sm">
        <p class="text-med-gold text-xs font-medium uppercase tracking-[0.2em] mb-2">Amalfi · Atrani · Minori</p>
        <h4 class="font-bold text-slate-900 mb-2 text-lg">Sole al mattino, ombra dopo le 15:30</h4>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Queste spiagge sono esposte a sud-est. Avrai un sole pazzesco al mattino, ma intorno alle 15:30-16:00 il sole scompare dietro la montagna e la spiaggia va in ombra. Ottimo se odi il caldo torrido, pessimo se vuoi fare l'aperitivo sotto il sole.</p>
      </div>
      <div class="bg-white p-6 rounded-[2rem] border border-slate-100 shadow-sm">
        <p class="text-med-gold text-xs font-medium uppercase tracking-[0.2em] mb-2">Positano · Praiano</p>
        <h4 class="font-bold text-slate-900 mb-2 text-lg">Sole fino a sera, il paradiso della Gavitella</h4>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Qui siamo sul versante opposto. Il sole bacia la costa fino a tardi. A Praiano, in particolare alla spiaggia della Gavitella, c'e il sole piu lungo della Costiera: puoi stare in costume fino alle 20:00 e vedere il sole sparire dritto nel mare di fronte a Capri.</p>
      </div>
      <div class="bg-white p-6 rounded-[2rem] border border-slate-100 shadow-sm">
        <p class="text-med-gold text-xs font-medium uppercase tracking-[0.2em] mb-2">Ravello</p>
        <h4 class="font-bold text-slate-900 mb-2 text-lg">Se non respiri piu, sali</h4>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Trovandosi a 365 metri di altitudine, <a href="/it-it/costiera-amalfitana/ravello/" class="text-med-blue hover:underline">Ravello</a> ha sempre 3 o 4 gradi in meno rispetto alla spiaggia e una ventilazione secca che ti rigenera i polmoni. La fuga rigenerante dalle giornate afose.</p>
      </div>
    </div>
  </div>

  <!-- Valigia & Survival Kit -->
  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">Valigia e Survival Kit per la Costiera</h2>
    <p class="text-slate-600 text-lg leading-relaxed mb-8">
      Camminare in Costiera ad Agosto non e come passeggiare sul lungomare di Rimini. Qui e tutto un su e giu verticale, e ogni scelta di guardaroba conta.
    </p>

    <div class="bg-white p-8 rounded-[2rem] border border-slate-100 shadow-sm">
      <div class="space-y-6">
        <div>
          <p class="font-bold text-slate-900 mb-2 text-lg">Il dramma delle scarpe</p>
          <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Lascia i tacchi in hotel e dimentica le infradito di plastica per camminare. I gradini di pietra calcarea e i pavimenti di pietra lavica (specialmente a Positano) diventano scivolosi per via del mix di calore e salsedine. Usa sandali bassi con suola in gomma o scarpe in tela con un buon grip.</p>
        </div>
        <div class="border-t border-slate-100 pt-6">
          <p class="font-bold text-slate-900 mb-2 text-lg">Lino, lino e ancora lino</p>
          <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">I tessuti sintetici ti faranno sudare il doppio. Scegli camicie, abiti e pantaloni larghi in lino o cotone leggero. La seta e ottima per la sera. Evita jeans stretti e polo aderenti: la Costiera vive di eleganza rilassata, non di vestiti costrittivi.</p>
        </div>
        <div class="border-t border-slate-100 pt-6">
          <p class="font-bold text-slate-900 mb-2 text-lg">Il riverbero killer</p>
          <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Le rocce bianche della Costiera riflettono la luce come uno specchio. L'indice UV tocca quota 9 o 10. Occhiali da sole polarizzati, cappello a tesa larga e protezione solare 50 sono i tuoi migliori amici se non vuoi trasformarti in un pomodoro il primo giorno.</p>
        </div>
      </div>
    </div>
  </div>

  <!-- 3 Meteo Hack -->
  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">I 3 Meteo Hack dell'Esperto per Muoversi Senza Impazzire</h2>
    <p class="text-slate-600 text-lg leading-relaxed mb-8">
      Tre trucchi da locale che fanno la differenza tra una vacanza sopravvissuta e una vacanza vissuta.
    </p>

    <div class="space-y-4">
      <div class="bg-white p-6 rounded-[2rem] border border-slate-100 shadow-sm">
        <div class="flex items-start gap-4">
          <div class="w-8 h-8 rounded-full bg-med-gold/15 flex-shrink-0 flex items-center justify-center text-med-gold font-serif font-bold">1</div>
          <div>
            <h4 class="font-bold text-slate-900 mb-2 text-lg">Banna i bus nelle ore di punta</h4>
            <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Prendere il <a href="/it-it/come-arrivare/bus-sita/" class="text-med-blue hover:underline">bus SITA</a> tra le 11:00 e le 15:00 ad Agosto e un'esperienza estrema. Le attese alle fermate sono sotto il sole cocente e il traffico blocca le auto. Usa i <a href="/it-it/come-arrivare/traghetti/" class="text-med-blue hover:underline">traghetti Travelmar</a>. Costano di piu, ma la brezza marina mentre navighi trasforma lo spostamento in una gita panoramica ventilata.</p>
          </div>
        </div>
      </div>
      <div class="bg-white p-6 rounded-[2rem] border border-slate-100 shadow-sm">
        <div class="flex items-start gap-4">
          <div class="w-8 h-8 rounded-full bg-med-gold/15 flex-shrink-0 flex items-center justify-center text-med-gold font-serif font-bold">2</div>
          <div>
            <h4 class="font-bold text-slate-900 mb-2 text-lg">Il "Faugn" serale</h4>
            <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">E il nome locale della brezza calda che scende dalle montagne di notte. Puo capitare che alle 23:00 arrivi un colpo di vento caldo e secco. Tienilo a mente se fai un'escursione in barca al chiaro di luna: porta sempre una camicia leggera a maniche lunghe.</p>
          </div>
        </div>
      </div>
      <div class="bg-white p-6 rounded-[2rem] border border-slate-100 shadow-sm">
        <div class="flex items-start gap-4">
          <div class="w-8 h-8 rounded-full bg-med-gold/15 flex-shrink-0 flex items-center justify-center text-med-gold font-serif font-bold">3</div>
          <div>
            <h4 class="font-bold text-slate-900 mb-2 text-lg">Granita tattica</h4>
            <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Quando senti che l'afa ti sta battendo, cerca i chioschi lungo la strada che vendono granite fatte al momento con i limoni Sfusati Amalfitani IGP. Non e solo un cliche da Instagram: e l'unico modo reale per riattivare la pressione e combattere la disidratazione da scalinate.</p>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- I Numeri dell'Estate -->
  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">I Numeri dell'Estate</h2>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      Per chi ama i dati puliti, ecco la sintesi di Luglio e Agosto 2026 in Costiera Amalfitana.
    </p>

    <div class="overflow-hidden rounded-[2rem] border border-slate-100 shadow-sm">
      <table class="w-full text-xs sm:text-sm">
        <thead class="bg-slate-900 text-white">
          <tr>
            <th class="text-left p-5 font-serif font-bold text-med-gold">Dato</th>
            <th class="text-left p-5 font-serif font-bold text-med-gold">Luglio</th>
            <th class="text-left p-5 font-serif font-bold text-med-gold">Agosto</th>
          </tr>
        </thead>
        <tbody class="bg-white">
          <tr class="border-b border-slate-100">
            <td class="p-5 font-bold">Massima media diurna</td>
            <td class="p-5 text-slate-600">31°C</td>
            <td class="p-5 text-slate-600">32°C</td>
          </tr>
          <tr class="border-b border-slate-100">
            <td class="p-5 font-bold">Minima media notturna</td>
            <td class="p-5 text-slate-600">22°C</td>
            <td class="p-5 text-slate-600">23°C</td>
          </tr>
          <tr class="border-b border-slate-100">
            <td class="p-5 font-bold">Temperatura del mare</td>
            <td class="p-5 text-slate-600">25°C (fresca)</td>
            <td class="p-5 text-slate-600">27°C (calda)</td>
          </tr>
          <tr class="border-b border-slate-100">
            <td class="p-5 font-bold">Giorni di pioggia</td>
            <td class="p-5 text-slate-600">Quasi zero (1 giorno)</td>
            <td class="p-5 text-slate-600">Rari temporali (3 giorni)</td>
          </tr>
