---
import BlogPostLayout from '../../../../layouts/BlogPostLayout.astro';

const lang = 'it-it';
const post = {
  title: 'Ricetta del Limoncello',
  subtitle: 'La Ricetta Tradizionale con i Limoni della Costiera Amalfitana',
  category: 'FOOD',
  date: '27 Maggio 2026',
  readTime: '9 min',
  image: '/images/limoncello-ricetta-hero.jpg',
  imageAlt: 'Limoncello artigianale della Costiera Amalfitana - limoni di Amalfi e Sorrento',
  path: '/it-it/blog/ricetta-limoncello/',
};

const metaTitle = 'Ricetta Limoncello Originale di Amalfi: Dosi, Ingredienti e Come Si Fa | 2026';
const metaDescription = "Ricetta limoncello originale di Amalfi e Sorrento: dosi per 1 litro di alcool a 96 gradi, ricetta della nonna, variante napoletana e alla grappa. Come fare il limoncello fatto in casa perfetto.";

const breadcrumbs = [
  { name: 'Home', url: '/it-it/' },
  { name: 'Blog', url: '/it-it/blog/' },
  { name: 'Ricetta Limoncello', url: '/it-it/blog/ricetta-limoncello/' },
];

const quickInfo = [
  { label: 'Difficolta', value: 'Facile' },
  { label: 'Preparazione', value: '20 min + 7-15 giorni infusione' },
  { label: 'Ingrediente chiave', value: 'Limoni IGP (Sfusato Amalfitano)' },
  { label: 'Alcool', value: '96 gradi - puro per liquori' },
  { label: 'Dosi per 1 litro', value: '8-10 limoni, 500 ml alcool, 700 ml acqua, 500 g zucchero' },
  { label: 'Conservazione', value: 'Freezer - si serve ghiacciato' },
  { label: 'Variante', value: 'Con grappa o vodka (meno forte)' },
  { label: 'Origine', value: 'Costiera Amalfitana / Penisola Sorrentina' },
];

const faq = [
  {
    q: 'Quanti limoni per un litro di limoncello?',
    a: 'Per un litro di limoncello servono circa 8-10 limoni grandi (meglio se Sfusato Amalfitano IGP). Il numero varia in base alla dimensione: i limoni della Costiera sono molto grandi, quindi ne bastano meno rispetto ai limoni comuni.',
  },
  {
    q: 'Quali sono le dosi per il limoncello con 1 litro di alcool a 96 gradi?',
    a: 'Per 1 litro di alcool a 96 gradi: le bucce di 15-18 limoni, 1,2 litri di acqua e 800 g di zucchero. Questo produce circa 2 litri di limoncello con una gradazione intorno ai 30-32 gradi.',
  },
  {
    q: 'Quanto tempo deve stare in infusione il limoncello?',
    a: "Il minimo consigliato e 7 giorni, ma la ricetta della nonna prevede almeno 15 giorni. Alcuni artigiani della Costiera lasciano le bucce in infusione fino a 40 giorni per un profumo piu intenso. L'importante e conservare il barattolo al buio.",
  },
  {
    q: 'Si puo fare il limoncello con la grappa?',
    a: 'Si, la variante con grappa (o vodka) e molto diffusa. Il risultato e un liquore leggermente meno alcolico e con un profilo aromatico diverso. Usare una grappa bianca neutra per non coprire il profumo del limone.',
  },
  {
    q: 'Qual e la differenza tra limoncello e limoncino? E la ricetta limoncino?',
    a: 'Nessuna differenza sostanziale: "limoncello" e il nome usato in Campania (Costiera Amalfitana e Sorrento), mentre "limoncino" e il termine diffuso in Liguria e nel Centro Italia. La ricetta del limoncino e praticamente identica a quella del limoncello.',
  },
  {
    q: 'Come si conserva il limoncello fatto in casa?',
    a: 'Il limoncello fatto in casa si conserva in freezer: non congela grazie alla gradazione alcolica e si serve ghiacciato, in bicchierini freddi. Fuori dal freezer si conserva in bottiglia di vetro scuro, al riparo dalla luce. Un limoncello fatto in casa con la ricetta originale si mantiene per diversi mesi senza problemi.',
  },
  {
    q: 'Perche il mio limoncello e amaro?',
    a: "L'errore piu comune e pelare i limoni troppo in profondita, prendendo anche la parte bianca (albedo). Solo la parte gialla della scorza contiene gli oli essenziali profumati; la parte bianca rilascia un amaro sgradevole.",
  },
];

const sidebarLinks = [
  { label: 'Delizia al Limone', href: '/it-it/blog/delizia-al-limone/' },
  { label: 'Alici di Cetara', href: '/it-it/blog/alici-di-cetara/' },
  { label: 'Scialatielli', href: '/it-it/blog/scialatielli/' },
  { label: 'Cuoppo Fritto', href: '/it-it/blog/cuoppo-fritto/' },
  { label: 'Vini Costa d\'Amalfi', href: '/it-it/blog/vini-costa-amalfi/' },
];

const authorRole = 'Food & Travel Specialist · Costiera Amalfitana';

const relatedArticles = [
  {
    title: 'Delizia al Limone',
    category: 'FOOD',
    date: '22 Aprile 2026',
    image: '/images/delizia-limone-hero.jpg',
    imageAlt: 'Delizia al Limone - dolce simbolo della Costiera Amalfitana',
    path: '/it-it/blog/delizia-al-limone/'
  },
  {
    title: "Vini della Costa d'Amalfi",
    category: 'FOOD',
    date: '22 Aprile 2026',
    image: '/images/vini-costa-amalfi-hero.jpg',
    imageAlt: "Vigneti eroici della Costa d'Amalfi",
    path: '/it-it/blog/vini-costa-amalfi/'
  }
];

const keyTakeaways = [
  "Il limoncello autentico si fa solo con limoni IGP della Costiera: lo Sfusato Amalfitano o il Femminiello Sorrentino, mai trattati con cere o pesticidi.",
  "Solo la parte gialla della scorza (flavedo) va nell'alcool: la parte bianca (albedo) rende il limoncello amaro.",
  "Dosi classiche per 1 litro di alcool a 96 gradi: bucce di 15-18 limoni, 1,2 litri d'acqua, 800 g di zucchero.",
  "L'infusione minima e 7 giorni al buio, ma la ricetta della nonna prevede almeno 15 giorni per un profumo piu ricco.",
  "Si serve sempre ghiacciato, direttamente dal freezer, in bicchierini freddi — mai a temperatura ambiente.",
];
---

<BlogPostLayout
  lang={lang}
  post={post}
  metaTitle={metaTitle}
  metaDescription={metaDescription}
  breadcrumbs={breadcrumbs}
  quickInfo={quickInfo}
  faq={faq}
  sidebarLinks={sidebarLinks}
  authorRole={authorRole}
  relatedArticles={relatedArticles}
>

  <!-- Key Takeaways -->
  <div class="bg-slate-900 text-white p-8 rounded-[2rem]">
    <div class="flex items-center gap-3 mb-6">
      <svg class="w-5 h-5 text-med-gold flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
      <h2 class="font-serif text-lg font-bold text-med-gold uppercase tracking-[0.15em]">Key Takeaways</h2>
    </div>
    <ul class="space-y-4">
      {keyTakeaways.map((point) => (
        <li class="flex items-start gap-3">
          <span class="w-1.5 h-1.5 rounded-full bg-med-gold flex-shrink-0 mt-2"></span>
          <span class="text-white/80 text-xs sm:text-sm leading-relaxed">{point}</span>
        </li>
      ))}
    </ul>
  </div>

  <!-- Intro -->
  <div>
    <p class="text-slate-600 text-xl leading-relaxed mb-6 font-light">
      Il <strong>limoncello</strong> e il liquore piu iconico della <a href="/it-it/costiera-amalfitana/" class="text-med-blue hover:underline">Costiera Amalfitana</a> e della Penisola Sorrentina: un concentrato di sole, profumo e tradizione racchiuso in una bottiglia. Questa e la <strong>ricetta limoncello originale di Amalfi</strong>, quella che le famiglie della costa si tramandano da generazioni, con le <strong>dosi</strong> precise e i segreti per farlo perfetto anche a casa. Se vi state chiedendo <strong>come si fa il limoncello</strong> fatto in casa con la ricetta della nonna, siete nel posto giusto.
    </p>
  </div>

  <!-- Origine e storia -->
  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">Origine del Limoncello: da Amalfi o da Sorrento?</h2>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      L'<strong>origine del limoncello</strong> e contesa tra almeno tre localita: il <strong>limoncello di Amalfi</strong>, quello di Sorrento e quello di Capri. Una cosa e certa: il liquore nasce dove crescono i limoni migliori del Mediterraneo. Lo <strong>Sfusato Amalfitano IGP</strong> e il Femminiello Sorrentino sono le due varieta regine, coltivate su terrazzamenti a picco sul mare e mai trattate con cere o pesticidi.
    </p>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      La <strong>ricetta del limoncello originale</strong> e nata nelle cucine delle nonne campane, che usavano l'alcool puro per estrarre gli oli essenziali dalle scorze profumatissime dei limoni appena raccolti. Ogni famiglia aveva (e spesso ha ancora) la propria versione, con piccole variazioni nelle dosi e nei tempi di infusione.
    </p>
    <p class="text-slate-600 text-lg leading-relaxed mb-8">
      La tradizione napoletana e quella amalfitana differiscono nei dettagli: la <strong>ricetta limoncello napoletana</strong> tende a usare piu zucchero e meno infusione, mentre il <strong>limoncello di Sorrento</strong> punta tutto sul profumo intenso dello Sfusato con infusioni piu lunghe. In questa guida vi spieghiamo come <strong>fare limoncello</strong> seguendo la ricetta originale della Costiera.
    </p>
  </div>

  <!-- Ingredienti -->
  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">Ingredienti Limoncello: le Dosi Perfette</h2>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      Ecco gli <strong>ingredienti per il limoncello</strong> e le <strong>dosi limoncello</strong> nella versione classica con 500 ml di <strong>limoncello alcool</strong> a 96 gradi. Se vuoi la <strong>dose per limoncello</strong> con 1 litro di alcool, raddoppia tutto.
    </p>

    <div class="bg-white p-8 rounded-[2rem] border border-slate-100 shadow-sm">
      <h3 class="font-serif text-xl font-bold text-slate-900 mb-5">Ingredienti (per ~1 litro di limoncello)</h3>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div class="space-y-3">
          <div class="flex items-start gap-3">
            <span class="w-2 h-2 rounded-full bg-med-gold flex-shrink-0 mt-2"></span>
            <p class="text-slate-600 text-xs sm:text-sm leading-relaxed"><strong>8-10 limoni</strong> non trattati (meglio Sfusato Amalfitano IGP)</p>
          </div>
          <div class="flex items-start gap-3">
            <span class="w-2 h-2 rounded-full bg-med-gold flex-shrink-0 mt-2"></span>
            <p class="text-slate-600 text-xs sm:text-sm leading-relaxed"><strong>500 ml di alcool</strong> puro a 96 gradi (per liquori)</p>
          </div>
        </div>
        <div class="space-y-3">
          <div class="flex items-start gap-3">
            <span class="w-2 h-2 rounded-full bg-med-gold flex-shrink-0 mt-2"></span>
            <p class="text-slate-600 text-xs sm:text-sm leading-relaxed"><strong>700 ml di acqua</strong> minerale naturale</p>
          </div>
          <div class="flex items-start gap-3">
            <span class="w-2 h-2 rounded-full bg-med-gold flex-shrink-0 mt-2"></span>
            <p class="text-slate-600 text-xs sm:text-sm leading-relaxed"><strong>500 g di zucchero</strong> semolato</p>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Preparazione -->
  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">Preparazione del Limoncello: Passo dopo Passo</h2>

    <div class="bg-white p-8 rounded-[2rem] border border-slate-100 shadow-sm">
      <h3 class="font-serif text-xl font-bold text-slate-900 mb-5">La Ricetta Originale</h3>
      <div class="space-y-4">
        <div class="flex items-start gap-3">
          <div class="w-6 h-6 rounded-full bg-med-gold/15 flex-shrink-0 flex items-center justify-center text-med-gold font-bold text-xs">1</div>
          <p class="text-slate-600 text-xs sm:text-sm leading-relaxed"><strong>Lavare i limoni</strong> con acqua fredda e asciugarli bene. Non usare sapone: i limoni IGP non hanno cere superficiali.</p>
        </div>
        <div class="flex items-start gap-3">
          <div class="w-6 h-6 rounded-full bg-med-gold/15 flex-shrink-0 flex items-center justify-center text-med-gold font-bold text-xs">2</div>
          <p class="text-slate-600 text-xs sm:text-sm leading-relaxed"><strong>Pelare solo la parte gialla</strong> (flavedo) con un pelapatate affilato. Mai toccare la parte bianca (albedo): rende il limoncello amaro.</p>
        </div>
        <div class="flex items-start gap-3">
          <div class="w-6 h-6 rounded-full bg-med-gold/15 flex-shrink-0 flex items-center justify-center text-med-gold font-bold text-xs">3</div>
          <p class="text-slate-600 text-xs sm:text-sm leading-relaxed"><strong>Mettere le scorze nell'alcool</strong> in un barattolo di vetro a chiusura ermetica. Chiudere bene e conservare al buio e a temperatura ambiente.</p>
        </div>
        <div class="flex items-start gap-3">
          <div class="w-6 h-6 rounded-full bg-med-gold/15 flex-shrink-0 flex items-center justify-center text-med-gold font-bold text-xs">4</div>
          <p class="text-slate-600 text-xs sm:text-sm leading-relaxed"><strong>Infusione: minimo 7 giorni</strong>, ideale 15 giorni. La ricetta della nonna dice: "quando l'alcool diventa giallo oro e le scorze sono bianche, e pronto".</p>
        </div>
        <div class="flex items-start gap-3">
          <div class="w-6 h-6 rounded-full bg-med-gold/15 flex-shrink-0 flex items-center justify-center text-med-gold font-bold text-xs">5</div>
          <p class="text-slate-600 text-xs sm:text-sm leading-relaxed"><strong>Preparare lo sciroppo</strong>: scaldare l'acqua (senza far bollire) e sciogliere lo zucchero mescolando. Far raffreddare completamente.</p>
        </div>
        <div class="flex items-start gap-3">
          <div class="w-6 h-6 rounded-full bg-med-gold/15 flex-shrink-0 flex items-center justify-center text-med-gold font-bold text-xs">6</div>
          <p class="text-slate-600 text-xs sm:text-sm leading-relaxed"><strong>Filtrare l'alcool</strong> e unirlo allo sciroppo freddo. Mescolare delicatamente e imbottigliare. Far riposare almeno 24 ore in freezer prima di servire.</p>
        </div>
      </div>
    </div>

    <blockquote class="border-l-4 border-med-gold pl-6 my-8">
      <p class="text-slate-700 text-xl font-serif italic leading-relaxed">
        "Un buon limoncello si riconosce dal profumo: se chiudi gli occhi e senti il giardino di limoni, allora e venuto bene."
      </p>
    </blockquote>
  </div>

  <!-- Dosi per 1 litro di alcool -->
  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">Ricetta Limoncello: 1 Litro di Alcool a 96 Gradi</h2>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      Se vuoi preparare una quantita maggiore, ecco la <strong>ricetta limoncello 1 litro alcool</strong> con le <strong>dosi originali</strong>. Questa e anche la <strong>ricetta limoncello originale dosi</strong> che usano gli artigiani della Costiera:
    </p>

    <div class="overflow-hidden rounded-[2rem] border border-slate-100 shadow-sm">
      <table class="w-full text-xs sm:text-sm">
        <thead class="bg-slate-900 text-white">
          <tr>
            <th class="text-left p-5 font-serif font-bold text-med-gold">Ingrediente</th>
            <th class="text-left p-5 font-serif font-bold text-med-gold">Quantita</th>
          </tr>
        </thead>
        <tbody class="bg-white">
          <tr class="border-b border-slate-100">
            <td class="p-5 font-bold">Limoni non trattati</td>
            <td class="p-5 text-slate-600">15-18 (Sfusato Amalfitano)</td>
          </tr>
          <tr class="border-b border-slate-100">
            <td class="p-5 font-bold">Alcool puro 96°</td>
            <td class="p-5 text-slate-600">1 litro</td>
          </tr>
          <tr class="border-b border-slate-100">
            <td class="p-5 font-bold">Acqua minerale</td>
            <td class="p-5 text-slate-600">1,2 litri</td>
          </tr>
          <tr>
            <td class="p-5 font-bold">Zucchero semolato</td>
            <td class="p-5 text-slate-600">800 g</td>
          </tr>
        </tbody>
      </table>
    </div>
    <p class="text-slate-500 text-sm mt-4">
      Resa finale: circa 2 litri di limoncello a ~30-32 gradi. Per un limoncello meno dolce, ridurre lo zucchero a 600 g.
    </p>
  </div>

  <!-- Variante con grappa -->
  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">Limoncello alla Grappa: la Variante Morbida</h2>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      Il <strong>limoncello alla grappa</strong> (o con vodka) e una variante molto diffusa nel Centro-Nord Italia. Il procedimento e identico, ma al posto dell'alcool puro si usa una grappa bianca neutra. Il risultato e un <strong>liquore limoncello</strong> piu morbido, con una gradazione intorno ai 25-28 gradi. C'e anche chi prepara il <strong>limoncello con alcool a 96 gradi</strong> ma preferisce dimezzare le dosi per un risultato piu leggero.
    </p>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div class="bg-white p-6 rounded-[2rem] border border-slate-100 shadow-sm">
        <h4 class="font-bold text-slate-900 mb-2">Con grappa</h4>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Usare grappa bianca neutra (non barricata). Lo sciroppo sara meno dolce: 400 g di zucchero in 500 ml di acqua per 1 litro di grappa.</p>
      </div>
      <div class="bg-white p-6 rounded-[2rem] border border-slate-100 shadow-sm">
        <h4 class="font-bold text-slate-900 mb-2">Con vodka</h4>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">La vodka (40°) produce un limoncello piu leggero e facile da bere. Ridurre lo sciroppo a 300 g di zucchero in 400 ml di acqua per 1 litro di vodka.</p>
      </div>
    </div>
  </div>

  <!-- Crema di limoncello -->
  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">Crema di Limoncello: Ricetta Originale di Amalfi</h2>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      La <strong>crema di limoncello</strong> e la variante vellutata del classico, molto amata sulla Costiera. Si sostituisce lo <strong>sciroppo per limoncello</strong> con latte intero e panna: il risultato e un liquore cremoso e avvolgente, perfetto come fine pasto o per accompagnare i dolci.
    </p>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      La <strong>crema di limoncello ricetta originale Amalfi</strong> prevede 500 ml di latte intero, 250 ml di panna fresca e 400 g di zucchero per 500 ml di infuso alcolico. Si conserva in frigorifero (non freezer) e si consuma entro 2-3 settimane. Chi cerca la <strong>ricetta limoncello di Sorrento</strong> trovera una versione molto simile, con l'unica differenza nel tipo di limone usato.
    </p>
  </div>

  <!-- Dove assaggiarlo -->
  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">Dove Assaggiare il Limoncello Artigianale in Costiera</h2>
    <div class="overflow-hidden rounded-[2rem] border border-slate-100 shadow-sm">
      <table class="w-full text-xs sm:text-sm">
        <thead class="bg-slate-900 text-white">
          <tr>
            <th class="text-left p-5 font-serif font-bold text-med-gold">Localita</th>
            <th class="text-left p-5 font-serif font-bold text-med-gold">Esperienza</th>
          </tr>
        </thead>
        <tbody class="bg-white">
          <tr class="border-b border-slate-100">
            <td class="p-5 font-bold">Amalfi</td>
            <td class="p-5 text-slate-600">Botteghe lungo Via Lorenzo d'Amalfi con degustazione gratuita e limoneti visitabili.</td>
          </tr>
          <tr class="border-b border-slate-100">
            <td class="p-5 font-bold">Ravello</td>
            <td class="p-5 text-slate-600">Produttori artigianali con terrazze panoramiche dove degustare il limoncello con vista sulla costa.</td>
          </tr>
          <tr class="border-b border-slate-100">
            <td class="p-5 font-bold">Minori</td>
            <td class="p-5 text-slate-600">Sal De Riso abbina il suo limoncello ai dolci della tradizione (Delizia al Limone, Baci di Limone).</td>
          </tr>
          <tr>
            <td class="p-5 font-bold">Sorrento</td>
            <td class="p-5 text-slate-600">Limoncello tour nei giardini agrumeti della Penisola Sorrentina con raccolta limoni e preparazione guidata.</td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>

  <!-- Local Tips -->
  <div class="bg-white p-8 rounded-[2rem] shadow-xl border border-slate-100">
    <div class="flex items-center gap-4 mb-6">
      <svg class="w-6 h-6 text-med-gold flex-shrink-0" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M9 18h6"/><path d="M10 22h4"/><path d="M15.09 14c.18-.98.65-1.74 1.41-2.5A4.65 4.65 0 0 0 18 8 6 6 0 0 0 6 8c0 1 .23 2.23 1.5 3.5A4.61 4.61 0 0 1 8.91 14"/></svg>
      <h3 class="text-xl font-bold">I Consigli dell'Esperto</h3>
    </div>
    <div class="space-y-6">
      <div>
        <p class="font-bold text-slate-900 mb-1">Solo la parte gialla</p>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">L'errore piu comune e prendere anche la parte bianca della scorza. Usate un pelapatate affilato e fate strisce sottili: solo il flavedo giallo contiene gli oli essenziali che danno profumo al limoncello.</p>
      </div>
      <div>
        <p class="font-bold text-slate-900 mb-1">Limoni non trattati</p>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Questo e fondamentale: i limoni del supermercato sono spesso cerati. Se non trovate limoni IGP, cercate almeno limoni biologici non trattati in superficie. La differenza nel profumo finale e enorme.</p>
      </div>
      <div>
        <p class="font-bold text-slate-900 mb-1">Pazienza nell'infusione</p>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Non abbiate fretta: piu l'infusione e lunga, piu il limoncello sara profumato. La ricetta della nonna dice almeno 15 giorni, ma molti artigiani della Costiera arrivano a 30-40 giorni per un risultato straordinario.</p>
      </div>
    </div>
  </div>

</BlogPostLayout>
