---
import BlogPostLayout from '../../../../layouts/BlogPostLayout.astro';

const lang = 'it-it';
const post = {
  title: 'Luminarie di Natale a Sorrento e Salerno',
  subtitle: 'Luci d\'Artista e M\'illumino d\'Inverno, le due feste della luce del Golfo, con date, luoghi e come vederle entrambe in un solo viaggio',
  category: 'GUIDE',
  date: '21 Ottobre 2026',
  readTime: '10 min',
  image: '/images/luci-artista-salerno-hero.webp',
  imageAlt: "Installazione luminosa con i fenicotteri rosa alla Villa Comunale di Salerno durante Luci d'Artista",
  path: '/it-it/blog/luminarie-natalizie-sorrento-salerno/',
};

const metaTitle = 'Luminarie Sorrento e Salerno: Date 2026/2027';
const metaDescription = 'Luci d\'Artista a Salerno e M\'illumino d\'Inverno a Sorrento: date attese per la stagione 2026/2027, dove sono le installazioni, trasporti serali e come combinare le due città in un viaggio.';

const breadcrumbs = [
  { name: 'Home', url: '/it-it/' },
  { name: 'Blog', url: '/it-it/blog/' },
  { name: 'Luminarie a Sorrento e Salerno', url: '/it-it/blog/luminarie-natalizie-sorrento-salerno/' },
];

const quickInfo = [
  { label: 'Evento Salerno', value: 'Luci d\'Artista, ventunesima edizione' },
  { label: 'Date attese', value: '14 novembre 2026 - 1 febbraio 2027' },
  { label: 'Costo', value: 'Gratuito, la città è la mostra' },
  { label: 'Evento Sorrento', value: 'M\'illumino d\'Inverno, diciottesima edizione' },
  { label: 'Date attese', value: 'Da fine novembre a metà gennaio' },
  { label: 'Accensione', value: 'Piazza Tasso, inizio dicembre' },
  { label: 'Distanza', value: 'Circa 1h30 in treno via Napoli' },
  { label: 'Momento migliore', value: 'Sere infrasettimanali, dalle 17:00' },
];

const faq = [
  {
    q: 'Quando iniziano le Luci d\'Artista a Salerno nel 2026?',
    a: 'La ventesima edizione è andata dal 14 novembre 2025 al 1 febbraio 2026, e il calendario pubblicato per la ventunesima indica il 14 novembre 2026 come accensione e il 1 febbraio 2027 come chiusura. Il Comune conferma la data in autunno, quindi conviene verificarla sul sito comunale prima di prenotare il viaggio per una sera precisa.',
  },
  {
    q: 'Luci d\'Artista è gratuito?',
    a: 'Sì. Le installazioni stanno in strade, piazze e parchi pubblici, quindi percorrere l\'itinerario non costa nulla. Fanno eccezione le installazioni recintate, soprattutto quella della Villa Comunale, dove nelle sere di maggiore affluenza l\'accesso è regolato da una fila con ingressi contingentati.',
  },
  {
    q: 'Dove si trovano esattamente le installazioni a Salerno?',
    a: 'Il percorso principale passa per la Villa Comunale su Via Roma, la zona del Duomo, Piazza della Libertà, il Corso Vittorio Emanuele, la medievale Via dei Mercanti e il Lungomare Trieste. Altre opere vengono collocate nei quartieri più esterni come Pastena, ed è il motivo per cui metropolitana e autobus contano parecchio.',
  },
  {
    q: 'Quando sono accese le luminarie di Sorrento?',
    a: 'M\'illumino d\'Inverno copre di solito il periodo fra fine novembre e metà gennaio. La diciassettesima edizione è andata dal 30 novembre 2025 al 18 gennaio 2026, con l\'albero di Piazza Tasso e le luci accesi la sera del 6 dicembre, accompagnati dal complesso bandistico cittadino. La diciottesima edizione è attesa su un calendario simile.',
  },
  {
    q: 'Si possono vedere entrambe in un giorno solo?',
    a: 'Tecnicamente sì, visto che distano circa un\'ora e mezza di treno via Napoli, ma diventa una giornata lunghissima con due serate schiacciate in una. Meglio scegliere una delle due città come base e dedicare all\'altra una sera intera, rientrando in treno in tarda serata.',
  },
  {
    q: 'I traghetti costieri funzionano d\'inverno?',
    a: 'No. I collegamenti via mare lungo la Costiera Amalfitana e verso le isole si fermano per l\'inverno, quindi spostarsi fra Sorrento e Salerno a dicembre significa Circumvesuviana fino a Napoli e poi treno. I bus SITA circolano, ma con orari invernali ridotti.',
  },
];

const sidebarLinks = [
  { label: 'Salerno', href: '/it-it/costiera-amalfitana/salerno/' },
  { label: 'Sorrento', href: '/it-it/penisola-sorrentina/sorrento/' },
  { label: 'La Costiera in treno', href: '/it-it/blog/costiera-amalfitana-in-treno/' },
  { label: 'Bus SITA', href: '/it-it/guida/bus-sita/' },
  { label: 'Parcheggi e ZTL', href: '/it-it/guida/parcheggi-ztl/' },
];

const authorRole = 'Guide locali · Costiera Amalfitana';

const relatedArticles = [
  {
    title: 'La Costiera Amalfitana in treno',
    category: 'GUIDE',
    date: '10 Agosto 2026',
    image: '/images/treno-costiera-hero.webp',
    imageAlt: 'La Costiera Amalfitana in treno',
    path: '/it-it/blog/costiera-amalfitana-in-treno/'
  },
  {
    title: 'Sorrento o Positano: Dove Alloggiare in Costiera Amalfitana',
    category: 'GUIDE',
    date: '15 Giugno 2026',
    image: '/images/sorrento-vs-positano-hero.webp',
    imageAlt: 'Sorrento e Positano a confronto',
    path: '/it-it/blog/sorrento-vs-positano/'
  }
];

const imageCredit = {
  author: 'Marco Ebreo / Wikimedia Commons',
  sourceUrl: 'https://commons.wikimedia.org/wiki/File:Luci_D%27Artista_2.jpg',
  license: 'CC BY-SA 4.0',
  licenseUrl: 'https://creativecommons.org/licenses/by-sa/4.0/',
};

const keyTakeaways = [
  'Sono due feste distinte e con carattere diverso: Luci d\'Artista a Salerno è una mostra di light art diffusa, M\'illumino d\'Inverno a Sorrento è un cartellone di due mesi attorno a un paese decorato.',
  'La ventunesima edizione salernitana è attesa dal 14 novembre 2026 al 1 febbraio 2027, con le stesse date della ventesima, ed è gratuita.',
  'Sorrento accende di solito in Piazza Tasso nei primi giorni di dicembre e tiene aperto il programma fino a metà gennaio.',
  'I fine settimana di dicembre a Salerno sono davvero affollati, con fila all\'installazione della Villa Comunale e traffico sulle strade di accesso. Le sere infrasettimanali sono un\'altra esperienza.',
  'D\'inverno i traghetti non ci sono: da Sorrento a Salerno si va in Circumvesuviana fino a Napoli e poi in treno, circa un\'ora e mezza in tutto.',
];
---

<BlogPostLayout
  lang={lang}
  post={post}
  metaTitle={metaTitle}
  metaDescription={metaDescription}
  breadcrumbs={breadcrumbs}
  quickInfo={quickInfo}
  faq={faq}
  sidebarLinks={sidebarLinks}
  authorRole={authorRole}
  relatedArticles={relatedArticles}
  imageCredit={imageCredit}
  pageKey="christmas-lights-sorrento-salerno"
>

  <!-- Key Takeaways -->
  <div class="bg-slate-900 text-white p-8 rounded-[2rem]">
    <div class="flex items-center gap-3 mb-6">
      <svg class="w-5 h-5 text-med-gold flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
      <h2 class="font-serif text-lg font-bold text-med-gold uppercase tracking-[0.15em]">Punti Chiave</h2>
    </div>
    <ul class="space-y-4">
      {keyTakeaways.map((point) => (
        <li class="flex items-start gap-3">
          <span class="w-1.5 h-1.5 rounded-full bg-med-gold flex-shrink-0 mt-2"></span>
          <span class="text-white/80 text-xs sm:text-sm leading-relaxed">{point}</span>
        </li>
      ))}
    </ul>
  </div>

  <!-- Intro -->
  <div>
    <p class="text-slate-600 text-xl leading-relaxed mb-6 font-light">
      La Costiera Amalfitana si svuota a novembre, e poi due città ai due capi del golfo accendono le luci e tornano a riempirsi, con un pubblico quasi interamente italiano. <a href="/it-it/costiera-amalfitana/salerno/" class="text-med-blue hover:underline">Salerno</a> da vent'anni trasforma le sue strade in una mostra a cielo aperto di light art, e <a href="/it-it/penisola-sorrentina/sorrento/" class="text-med-blue hover:underline">Sorrento</a> porta avanti due mesi di concerti, presepi e mercatini sotto le proprie decorazioni. In linea d'aria distano quaranta chilometri e, d'inverno, un'ora e mezza nei fatti. Ecco come funzionano entrambe.
    </p>
  </div>

  <!-- Salerno -->
  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">Salerno: Luci d'Artista</h2>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      Luci d'Artista è nata nella stagione 2006 ed è diventata la manifestazione del genere più grande del Sud Italia, con centinaia di migliaia di visitatori ogni inverno. L'idea non sono festoni di lampadine su una via dello shopping: le installazioni sono opere costruite, spesso enormi, con un tema diverso ogni anno fra mito, natura, favola e cielo notturno, e la città è organizzata come un percorso da camminare, non come una piazza in cui fermarsi.
    </p>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      La ventesima edizione ha aperto il <strong>14 novembre 2025</strong> alla Villa Comunale di Via Roma ed è andata avanti fino al <strong>1 febbraio 2026</strong>. Il calendario pubblicato per la ventunesima indica <strong>dal 14 novembre 2026 al 1 febbraio 2027</strong>, cioè esattamente le stesse date. Prendetelo come ipotesi di lavoro e verificate sul sito del Comune prima di fissare una data, perché l'accensione in passato si è spostata di qualche giorno.
    </p>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-6">
      <div class="bg-white p-6 rounded-[2rem] border border-slate-100 shadow-sm">
        <h4 class="font-bold text-slate-900 mb-2">Il percorso</h4>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Villa Comunale, zona del Duomo, Piazza della Libertà, Corso Vittorio Emanuele, Via dei Mercanti e Lungomare Trieste, con altre opere nei quartieri esterni. Mettete in conto una serata intera e scarpe comode.</p>
      </div>
      <div class="bg-white p-6 rounded-[2rem] border border-slate-100 shadow-sm">
        <h4 class="font-bold text-slate-900 mb-2">Muoversi la sera</h4>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">La metropolitana cittadina prolunga il servizio per tutta la stagione, fino alle 23 circa nei giorni feriali e fin dopo la mezzanotte nei prefestivi: è questo che rende praticabile il parcheggio di scambio ai margini della città.</p>
      </div>
      <div class="bg-white p-6 rounded-[2rem] border border-slate-100 shadow-sm">
        <h4 class="font-bold text-slate-900 mb-2">La Villa Comunale</h4>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">L'installazione principale sta nei giardini pubblici ed è quella con la fila. Nei fine settimana di dicembre l'attesa può superare abbondantemente l'ora, quindi conviene andarci presto la sera oppure in un giorno feriale.</p>
      </div>
      <div class="bg-white p-6 rounded-[2rem] border border-slate-100 shadow-sm">
        <h4 class="font-bold text-slate-900 mb-2">Bus turistici e camper</h4>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Ogni anno Salerno pubblica un disciplinare specifico per accesso e sosta di bus turistici e camper durante l'evento. Se arrivate con uno dei due, leggetelo prima: i controlli ci sono e le sanzioni non sono simboliche.</p>
      </div>
    </div>
  </div>

  <!-- Sorrento -->
  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">Sorrento: M'illumino d'Inverno</h2>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      La versione sorrentina è più piccola, più intima e costruita attorno a un cartellone più che attorno a degli oggetti. M'illumino d'Inverno copre circa due mesi e concentra oltre cento appuntamenti: concerti di musica classica, jazz e napoletana, teatro di burattini, presepi nelle chiese del centro storico, mercatini artigianali, mostre e un giardino dedicato ai bambini.
    </p>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      La diciassettesima edizione è andata dal <strong>30 novembre 2025 al 18 gennaio 2026</strong>. L'albero e le luci delle strade si sono accesi la sera del <strong>6 dicembre</strong> in Piazza Tasso, con il complesso bandistico cittadino: è il momento che i sorrentini considerano l'inizio vero della stagione. La diciottesima edizione è attesa con la stessa impostazione, apertura a fine novembre, accensione nei primi giorni di dicembre e chiusura a metà gennaio.
    </p>
    <p class="text-slate-600 text-lg leading-relaxed mb-8">
      I luoghi si raggiungono tutti a piedi: Piazza Tasso, il Corso Italia, le chiese e le piazze del centro storico, la Villa Comunale con la vista sul golfo e il Teatro Tasso. Proprio perché la città è compatta e in gran parte pedonale, questa è la più facile delle due da fare con bambini piccoli o con chi non ha voglia di camminare chilometri al freddo.
    </p>

    <blockquote class="border-l-4 border-med-gold pl-6 my-8">
      <p class="text-slate-700 text-xl font-serif italic leading-relaxed">
        "Salerno è qualcosa che si va a guardare. Sorrento è un posto dove si passa la serata."
      </p>
    </blockquote>
  </div>

  <!-- Entrambe -->
  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">Vederle Entrambe nello Stesso Viaggio</h2>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      D'estate sarebbe una gita in barca. D'inverno i traghetti costieri sono fermi, quindi le due città sono collegate attraverso Napoli, e il percorso è più semplice di quanto suggerisca la cartina.
    </p>

    <div class="overflow-x-auto rounded-[2rem] border border-slate-100 shadow-sm">
      <table class="w-full text-xs sm:text-sm">
        <thead class="bg-slate-900 text-white">
          <tr>
            <th class="text-left p-5 font-serif font-bold text-med-gold">Tratta</th>
            <th class="text-left p-5 font-serif font-bold text-med-gold">Come</th>
            <th class="text-left p-5 font-serif font-bold text-med-gold">Durata</th>
          </tr>
        </thead>
        <tbody class="bg-white">
          <tr class="border-b border-slate-100">
            <td class="p-5 font-bold">Sorrento - Napoli</td>
            <td class="p-5 text-slate-600">Circumvesuviana, o Campania Express dove circola d'inverno</td>
            <td class="p-5 text-slate-600">Circa 1h</td>
          </tr>
          <tr class="border-b border-slate-100">
            <td class="p-5 font-bold">Napoli - Salerno</td>
            <td class="p-5 text-slate-600">Alta velocità da Napoli Centrale, oppure un regionale</td>
            <td class="p-5 text-slate-600">Da 35 min a 1h15</td>
          </tr>
          <tr>
            <td class="p-5 font-bold">Salerno - paesi della costa</td>
            <td class="p-5 text-slate-600">Bus SITA con orari invernali ridotti, nessun traghetto</td>
            <td class="p-5 text-slate-600">40 min per Amalfi</td>
          </tr>
        </tbody>
      </table>
    </div>

    <p class="text-slate-600 text-lg leading-relaxed mt-6">
      Il piano pratico è scegliere una delle due come base e trattare l'altra come una serata fuori. Salerno è la base migliore se le luminarie sono il motivo del viaggio, perché si percorre tutto l'itinerario a piedi da un hotel centrale e la stazione sta in mezzo alla città. Sorrento è la base migliore per tutto il resto, perché da lì il resto della penisola e la statale costiera restano raggiungibili anche d'inverno. La nostra guida alla <a href="/it-it/blog/costiera-amalfitana-in-treno/" class="text-med-blue hover:underline">Costiera Amalfitana in treno</a> entra nel dettaglio delle coincidenze.
    </p>
  </div>

  <!-- Consigli -->
  <div class="bg-white p-8 rounded-[2rem] shadow-xl border border-slate-100">
    <div class="flex items-center gap-4 mb-6">
      <svg class="w-6 h-6 text-med-gold flex-shrink-0" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M9 18h6"/><path d="M10 22h4"/><path d="M15.09 14c.18-.98.65-1.74 1.41-2.5A4.65 4.65 0 0 0 18 8 6 6 0 0 0 6 8c0 1 .23 2.23 1.5 3.5A4.61 4.61 0 0 1 8.91 14"/></svg>
      <h3 class="text-xl font-bold">Consigli dell'esperto</h3>
    </div>
    <div class="space-y-6">
      <div>
        <p class="font-bold text-slate-900 mb-1">Andate infrasettimanali, e presto la sera</p>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Le luci si accendono al tramonto, che a dicembre significa verso le 17:00. Un martedì alle sei e un sabato alle nove sono due città diverse. Se avete solo un fine settimana, iniziate il percorso dall'estremità opposta e tornate verso il centro andando contro la folla.</p>
      </div>
      <div>
        <p class="font-bold text-slate-900 mb-1">Parcheggiate fuori e prendete la metropolitana</p>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Entrare in auto nel centro di Salerno in una sera di dicembre è una pessima idea. Lasciate la macchina in uno dei parcheggi periferici serviti dalla linea metropolitana, che nella stagione prolunga il servizio. Lo stesso vale a Sorrento, dove il centro è in gran parte chiuso al traffico: controllate prima le regole su <a href="/it-it/guida/parcheggi-ztl/" class="text-med-blue hover:underline">parcheggi e ZTL</a>.</p>
      </div>
      <div>
        <p class="font-bold text-slate-900 mb-1">Confermate le date prima di prenotare i voli</p>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Entrambi gli eventi vengono annunciati dal rispettivo Comune poche settimane prima e la data di apertura può slittare. Le date riportate qui riflettono il calendario pubblicato e l'andamento delle ultime edizioni: affidabili per organizzare una settimana, non per scommettere su una sera precisa.</p>
      </div>
      <div>
        <p class="font-bold text-slate-900 mb-1">Mettete in programma anche i presepi</p>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Dicembre su questa costa è stagione di presepi, e le chiese del centro storico di Sorrento e dei paesi lungo la statale ne allestiscono di elaborati. Insieme a una <a href="/it-it/costiera-amalfitana/amalfi/" class="text-med-blue hover:underline">Amalfi</a> semivuota e alle tariffe invernali, è un buon argomento per venire fuori stagione.</p>
      </div>
    </div>
  </div>

</BlogPostLayout>
