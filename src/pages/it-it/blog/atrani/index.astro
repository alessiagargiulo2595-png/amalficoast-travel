---
import BlogPostLayout from '../../../../layouts/BlogPostLayout.astro';

const lang = 'it-it';
const post = {
  title: 'Atrani: 7 Curiosità che Nessuno Ti Racconta',
  subtitle: "Dogi, Masaniello e il Set di Ripley Netflix - Storie Segrete del Borgo Più Piccolo d'Italia",
  category: 'SCOPERTE',
  date: '22 Aprile 2026',
  readTime: '6 min',
  image: '/images/atrani-hero.jpg',
  imageAlt: "Atrani - vicoli medievali e archi sulla statale 163, set della serie Netflix Ripley",
  path: '/it-it/blog/atrani/',
};

const metaTitle = "Atrani: 7 Curiosità Segrete - Dogi, Masaniello e Ripley Netflix | Blog";
const metaDescription = "Scopri 7 curiosità su Atrani che nessuna guida racconta: l'investitura segreta dei Dogi, la grotta di Masaniello, perché Netflix ha scelto questo borgo per Ripley e il misterioso sarchiapone.";

const breadcrumbs = [
  { name: 'Home', url: '/it-it/' },
  { name: 'Blog', url: '/it-it/blog/' },
  { name: 'Atrani', url: '/it-it/blog/atrani/' },
];

const quickInfo = [
  { label: 'Record', value: "Comune più piccolo d'Italia (0,12 km²)" },
  { label: 'Distanza da Amalfi', value: '700 m · 10-15 min a piedi' },
  { label: 'Accesso', value: 'Piedi da Amalfi · Bus SITA' },
  { label: 'Parcheggio', value: 'Quasi assente - usare Amalfi' },
  { label: 'Evento cult', value: 'Festa S. Maria Maddalena (22 luglio)' },
  { label: 'Piatto tipico', value: 'Sarchiapone' },
  { label: 'Set cinematografico', value: 'Ripley (Netflix, 2024)' },
  { label: 'Atmosfera', value: 'Autentica, medievale, silenziosa' },
];

const faq = [
  {
    q: 'Perché Atrani era più importante di Amalfi per i Dogi?',
    a: "Atrani era il centro del potere aristocratico della Repubblica Marinara. Nella Chiesa di San Salvatore de' Birecto avveniva l'investitura solenne dei Dogi con l'imposizione del copricapo ducale (birecto). Le famiglie nobili risiedevano qui, non nella più commerciale Amalfi.",
  },
  {
    q: 'Masaniello si nascose davvero ad Atrani?',
    a: "Secondo la tradizione, la madre di Masaniello era originaria di Atrani. Durante la rivolta del 1647, il rivoluzionario napoletano si sarebbe rifugiato nella cosiddetta Grotta di Masaniello, tra i vicoli del borgo, per sfuggire alle guardie del viceré spagnolo.",
  },
  {
    q: 'Quali scene di Ripley Netflix sono state girate ad Atrani?',
    a: "La serie Netflix Ripley (2024) ha utilizzato Atrani per le scene ambientate in un'Italia anni '60 autentica. Gli archi della statale 163, i vicoli medievali e Piazza Umberto I sono rimasti quasi identici a decenni fa, una rarità che ha convinto la produzione.",
  },
  {
    q: "Cos'è il sarchiapone e quando si mangia?",
    a: 'Il sarchiapone è il piatto simbolo di Atrani: una zucca lunga farcita con carne, provola e uova, poi fritta e ripassata al forno. Si prepara tradizionalmente il 22 luglio per la festa di Santa Maria Maddalena, patrona del borgo.',
  },
  {
    q: 'Perché Atrani è il comune più piccolo d\'Italia?',
    a: "Con soli 0,12 km² di superficie, Atrani è il comune più piccolo d'Italia per estensione. La geografia lo spiega: il borgo è incastrato in una stretta gola tra due pareti rocciose, senza spazio per espandersi. Questa compressione naturale ha preservato intatto il tessuto medievale.",
  },
];

const sidebarLinks = [
  { label: 'Scopri Amalfi', href: '/it-it/costiera-amalfitana/amalfi/' },
  { label: 'Bus SITA', href: '/it-it/guida/bus-sita/' },
  { label: 'Grotta dello Smeraldo', href: '/it-it/blog/grotta-dello-smeraldo/' },
  { label: 'Guida ad Atrani', href: '/it-it/costiera-amalfitana/atrani/' },
  { label: 'Quando visitare', href: '/it-it/guida/quando-visitare/' },
];

const authorRole = 'Amalfi Coast Specialist · Costiera Amalfitana';

const relatedArticles = [
  {
    title: 'Grotta dello Smeraldo',
    category: 'SCOPERTE',
    date: '22 Aprile 2026',
    image: '/images/grotta-smeraldo-hero.webp',
    imageAlt: 'Grotta dello Smeraldo - Conca dei Marini, Costiera Amalfitana',
    path: '/it-it/blog/grotta-dello-smeraldo/'
  },
  {
    title: 'Valle delle Ferriere',
    category: 'SCOPERTE',
    date: '16 Aprile 2026',
    image: '/images/valle-ferriere-hero.jpg',
    imageAlt: 'Valle delle Ferriere - trekking nella Costiera Amalfitana',
    path: '/it-it/blog/valle-delle-ferriere/'
  }
];
---

<BlogPostLayout
  lang={lang}
  post={post}
  metaTitle={metaTitle}
  metaDescription={metaDescription}
  breadcrumbs={breadcrumbs}
  quickInfo={quickInfo}
  faq={faq}
  sidebarLinks={sidebarLinks}
  authorRole={authorRole}
  relatedArticles={relatedArticles}
>

  <!-- Intro -->
  <div>
    <p class="text-slate-600 text-xl leading-relaxed mb-6 font-light">
      Tutti conoscono Amalfi. Quasi nessuno conosce le storie segrete del borgo che si nasconde dietro lo sperone di roccia accanto. <a href="/it-it/costiera-amalfitana/atrani/" class="text-med-blue hover:underline">Atrani</a>, il comune più piccolo d'Italia (0,12 km²), custodisce segreti che le guide turistiche non raccontano: investiture ducali clandestine, la fuga di un rivoluzionario e un set cinematografico che ha ingannato Netflix. Ecco 7 curiosità che cambieranno il modo in cui guardate questo angolo della <a href="/it-it/costiera-amalfitana/" class="text-med-blue hover:underline">Costiera Amalfitana</a>.
    </p>
  </div>

  <!-- Architettura -->
  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">1. Gli Archi della Statale: Architettura da Cinema</h2>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      Appena si arriva ad Atrani, lo sguardo viene catturato dai celebri archi che sorreggono la Statale 163, trasformando il passaggio delle auto in un elemento scenografico che incornicia la spiaggia e il borgo. Atrani ha mantenuto intatta la sua struttura medievale: un groviglio di vicoli stretti, case bianche sovrapposte e piccoli cortili che si aprono all'improvviso, rendendolo uno dei <strong>Borghi più Belli d'Italia</strong>.
    </p>

    <div class="bg-white p-8 rounded-[2rem] border border-slate-100 shadow-sm">
      <h3 class="font-serif text-xl font-bold text-slate-900 mb-4">Il Set di Ripley</h3>
      <p class="text-slate-600 leading-relaxed">
        Non a caso, Atrani è stata scelta come set per la serie <strong>Netflix Ripley (2024)</strong>, grazie alla sua capacità di evocare un'atmosfera sospesa nel tempo, lontana dal turismo di massa. I vicoli, la piazza e gli archi sulla statale sono rimasti quasi identici a decenni fa - una rarità assoluta sulla Costiera. A pochi chilometri, la <a href="/it-it/blog/grotta-dello-smeraldo/" class="text-med-blue hover:underline">Grotta dello Smeraldo</a> completa l'esplorazione di questa zona meno battuta.
      </p>
    </div>
  </div>

  <!-- Storia -->
  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">2. Il Segreto dei Dogi e la Fuga di Masaniello</h2>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      Nonostante la vicinanza ad Amalfi, Atrani ha sempre avuto un'identità forte e aristocratica. In epoca ducale, era qui che risiedevano le famiglie più nobili e dove, nella <strong>Chiesa di San Salvatore de' Birecto</strong>, avveniva l'investitura solenne dei Dogi della Repubblica Marinara di Amalfi con l'imposizione del "birecto" (il copricapo ducale).
    </p>
    <p class="text-slate-600 text-lg leading-relaxed mb-8">
      Una delle leggende più affascinanti riguarda la <strong>Grotta di Masaniello</strong>: si dice che il celebre rivoluzionario napoletano, la cui madre era originaria di Atrani, si rifugiò proprio qui tra i vicoli del borgo per sfuggire alle guardie del viceré.
    </p>

    <blockquote class="border-l-4 border-med-gold pl-6 my-8">
      <p class="text-slate-700 text-xl font-serif italic leading-relaxed">
        "Atrani è un segreto sussurrato tra le rocce, un luogo dove il respiro del mare entra fin dentro le case."
      </p>
    </blockquote>
  </div>

  <!-- Cosa vedere -->
  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">3. I Luoghi Segreti: Oltre la Piazzetta</h2>
    <div class="space-y-4">
      <div class="bg-white p-6 rounded-[2rem] border border-slate-100 shadow-sm flex gap-5">
        <div class="w-10 h-10 rounded-full bg-med-gold/10 flex-shrink-0 flex items-center justify-center text-med-gold font-bold text-xs sm:text-sm">1</div>
        <div>
          <h4 class="font-bold text-slate-900 mb-1">Piazza Umberto I</h4>
          <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Il cuore pulsante del borgo. Una piazzetta intima, a pochi metri dalla sabbia, perfetta per un caffè o un aperitivo circondati dalla vita quotidiana dei residenti. Niente souvenir, niente code: solo Atrani vera.</p>
        </div>
      </div>
      <div class="bg-white p-6 rounded-[2rem] border border-slate-100 shadow-sm flex gap-5">
        <div class="w-10 h-10 rounded-full bg-med-gold/10 flex-shrink-0 flex items-center justify-center text-med-gold font-bold text-xs sm:text-sm">2</div>
        <div>
          <h4 class="font-bold text-slate-900 mb-1">Collegiata di Santa Maria Maddalena</h4>
          <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Con la sua cupola in maiolica che domina il profilo del borgo, è uno dei punti più fotografati della Costiera. La facciata barocca e la posizione a picco sul mare la rendono unica.</p>
        </div>
      </div>
      <div class="bg-white p-6 rounded-[2rem] border border-slate-100 shadow-sm flex gap-5">
        <div class="w-10 h-10 rounded-full bg-med-gold/10 flex-shrink-0 flex items-center justify-center text-med-gold font-bold text-xs sm:text-sm">3</div>
        <div>
          <h4 class="font-bold text-slate-900 mb-1">Le "Scalinatielle"</h4>
          <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Perdetevi tra le scalinate che salgono verso la parte alta del borgo. Ogni gradino offre uno scorcio nuovo, tra panni stesi al sole e profumo di cucina locale. Il vero Atrani vive qui, non sulla statale.</p>
        </div>
      </div>
    </div>
  </div>

  <!-- Local Tips -->
  <div class="bg-white p-8 rounded-[2rem] shadow-xl border border-slate-100">
    <div class="flex items-center gap-4 mb-6">
      <svg class="w-6 h-6 text-med-gold flex-shrink-0" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M9 18h6"/><path d="M10 22h4"/><path d="M15.09 14c.18-.98.65-1.74 1.41-2.5A4.65 4.65 0 0 0 18 8 6 6 0 0 0 6 8c0 1 .23 2.23 1.5 3.5A4.61 4.61 0 0 1 8.91 14"/></svg>
      <h3 class="text-xl font-bold">I Consigli dell'Esperto</h3>
    </div>
    <div class="space-y-6">
      <div>
        <p class="font-bold text-slate-900 mb-1">Arrivare a piedi da <a href="/it-it/costiera-amalfitana/amalfi/" class="text-med-blue hover:underline">Amalfi</a></p>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Invece di usare il bus o l'auto, percorrete il sentiero pedonale che parte dalla zona alta di <a href="/it-it/costiera-amalfitana/amalfi/" class="text-med-blue hover:underline">Amalfi</a>. In meno di 15 minuti di passeggiata panoramica vi ritroverete nel cuore di Atrani, evitando il traffico della statale.</p>
      </div>
      <div>
        <p class="font-bold text-slate-900 mb-1">La Spiaggia</p>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">La spiaggia di Atrani è molto raccolta e protetta, ideale per chi viaggia con bambini o per chi vuole godersi il sole in un contesto più intimo rispetto alla vicina Amalfi. Meno affollata, più silenziosa.</p>
      </div>
      <div>
        <p class="font-bold text-slate-900 mb-1">Il Piatto Tipico: il Sarchiapone</p>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Non ripartite senza aver assaggiato il Sarchiapone, specialità locale preparata tradizionalmente per Santa Maria Maddalena (22 luglio): una zucca lunga farcita con carne, formaggi e uova, poi fritta e ripassata al forno.</p>
      </div>
    </div>
  </div>

</BlogPostLayout>
