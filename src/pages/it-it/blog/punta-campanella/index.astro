---
import BlogPostLayout from '../../../../layouts/BlogPostLayout.astro';

const lang = 'it-it';
const post = {
  title: 'Punta Campanella',
  subtitle: 'Dove il Mito Incontra i Due Golfi',
  category: 'SCOPERTE',
  date: '10 Maggio 2026',
  readTime: '8 min',
  image: '/images/punta-campanella-hero.jpg',
  imageAlt: 'Punta Campanella - Massa Lubrense, Penisola Sorrentina',
  path: '/it-it/blog/punta-campanella/',
};

const metaTitle = 'Punta Campanella: Trekking, Archeologia e il Mito di Ulisse 2026';
const metaDescription = 'Guida completa a Punta Campanella: trekking dalla Penisola Sorrentina con viste su Capri, il Tempio di Athena, la torre medievale, riserva marina protetta e leggende di Ulisse.';

const breadcrumbs = [
  { name: 'Home', url: '/it-it/' },
  { name: 'Blog', url: '/it-it/blog/' },
  { name: 'Punta Campanella', url: '/it-it/blog/punta-campanella/' },
];

const quickInfo = [
  { label: 'Punto di partenza', value: 'Piazza di Termini (Massa Lubrense)' },
  { label: 'Difficolta', value: 'E - Escursionistico (Facile/Medio)' },
  { label: 'Durata', value: 'Circa 1 ora (solo andata)' },
  { label: 'Equipaggiamento', value: 'Scarpe da trekking, acqua, cappello' },
  { label: 'Accesso', value: 'Gratuito (Riserva Marina Protetta)' },
  { label: 'Viste', value: 'Capri, Golfo di Napoli, Costiera Amalfitana' },
  { label: 'Cosa vedere', value: 'Tempio di Athena, Torre campanaria, Faraglioni, Baia di Ieranto' },
  { label: 'Periodo migliore', value: 'Aprile - Ottobre (Tramonto spettacolare)' },
];

const faq = [
  {
    q: 'Si puo raggiungere Punta Campanella in auto?',
    a: 'No, la strada e una mulattiera pedonale. Potete parcheggiare l\'auto a Termini e proseguire a piedi.',
  },
  {
    q: 'Si puo fare il bagno a Punta Campanella?',
    a: 'Si, ma non ci sono spiagge di sabbia. L\'accesso al mare avviene tramite rocce e scogli. E consigliato solo a nuotatori esperti a causa delle correnti che caratterizzano il punto d\'incontro dei due golfi.',
  },
  {
    q: 'E adatto ai bambini?',
    a: 'Si, il sentiero principale e ampio e sicuro, ma evitate le ore piu calde della giornata poiche c\'e pochissima ombra.',
  },
  {
    q: 'Quando e il momento migliore per il tramonto?',
    a: 'Durante la bella stagione (maggio-settembre), il sole cala esattamente di fianco ai Faraglioni di Capri attorno alle 19-20. Portate una torcia frontale per il rientro a piedi.',
  },
  {
    q: 'Cosa e la leggenda di Ulisse?',
    a: 'Secondo la mitologia greca, proprio qui tra gli scogli di Punta Campanella Ulisse incontrò le Sirene. Per resistere al loro canto ammaliatore, si fece legare all\'albero maestro della sua nave mentre i compagni navigavano con le orecchie tappate dalla cera.',
  },
  {
    q: 'Esiste accesso alla Baia di Ieranto da Punta Campanella?',
    a: 'Si, dal bivio principale potete deviare verso la Baia di Ieranto (per camminatori esperti). E una caletta incontaminata di proprieta del FAI con mare di purezza primordiale, l\'unico luogo dove l\'accesso a motore e vietato.',
  },
];

const sidebarLinks = [
  { label: 'Trekking & Sentiero degli Dei', href: '/it-it/esperienze/trekking/' },
  { label: 'Scopri Massa Lubrense', href: '/it-it/penisola-sorrentina/massa-lubrense/' },
  { label: 'Baia di Ieranto', href: '/it-it/spiagge/penisola-sorrentina/ieranto/' },
  { label: 'Quando visitare', href: '/it-it/' },
  { label: 'Come arrivare', href: '/it-it/' },
];

const relatedArticles = [
  {
    title: 'Valle delle Ferriere',
    category: 'SCOPERTE',
    date: '22 Aprile 2026',
    image: '/images/valle-ferriere-hero.jpg',
    imageAlt: 'Cascata nella Valle delle Ferriere, Amalfi - Costiera Amalfitana',
    path: '/it-it/blog/valle-delle-ferriere/'
  },
  {
    title: 'Atrani',
    category: 'SCOPERTE',
    date: '22 Aprile 2026',
    image: '/images/atrani-hero.jpg',
    imageAlt: "Atrani - il borgo più piccolo d'Italia sulla Costiera Amalfitana",
    path: '/it-it/blog/atrani/'
  }
];

const authorRole = 'Adventure & History Guide · Penisola Sorrentina';

const keyTakeaways = [
  'Punta Campanella e il punto dove la terra si assottiglia fino a diventare una punta di roccia protesa verso Capri, il confine sacro tra il Golfo di Napoli e il Golfo di Salerno.',
  'Qui sorgeva il maestoso Tempio di Athena (poi dedicato a Minerva dai Romani), un faro di civiltà nell\'antichita; oggi i resti archeologici affiorano tra la vegetazione mediterranea.',
  'Il nome "Campanella" deriva dalla torre di avvistamento del XIV secolo con una campana che suonava l\'allarme in caso di incursioni saracene, il cui rintocco rimbalzava di torre in torre lungo tutta la costa.',
  'Il sentiero e classificato E (Escursionistico): circa 1 ora di cammino da Termini. Accesso gratuito alla Riserva Marina Protetta. Vista a 360 gradi: Vesuvio, Costiera Sorrentina, Costiera Amalfitana, Capri e Li Galli.',
  'Il tramonto a Punta Campanella e un\'esperienza mistica: il sole cade esattamente di fianco ai Faraglioni di Capri tingendo il mare d\'oro. Consigliato per chi ama momenti indimenticabili.',
];

const videoSchema = {
  "@context": "https://schema.org",
  "@type": "VideoObject",
  "name": "Punta Campanella: Dove il Mito Incontra i Due Golfi",
  "description": "Video della location di Punta Campanella in Penisola Sorrentina con viste a 360 gradi su due golfi, archeologia e leggende di Ulisse.",
  "thumbnailUrl": "/images/punta-campanella-hero.jpg",
  "uploadDate": "2026-05-10",
  "duration": "PT0M30S",
  "contentUrl": "/videos/punta-campanella-video.mp4",
  "videoDetails": {
    "width": "1280",
    "height": "720"
  }
};
---

<BlogPostLayout
  lang={lang}
  post={post}
  metaTitle={metaTitle}
  metaDescription={metaDescription}
  breadcrumbs={breadcrumbs}
  quickInfo={quickInfo}
  faq={faq}
  sidebarLinks={sidebarLinks}
  authorRole={authorRole}
  relatedArticles={relatedArticles}
  schema={[videoSchema]}
  pageKey="punta-campanella"
>

  <!-- Video Section -->
  <div class="rounded-[2rem] shadow-xl mb-8 flex justify-center bg-slate-900 py-4">
    <video muted="muted"
      controls
      controlsList="nofullscreen"
      poster="/images/punta-campanella-hero.jpg"
      class="max-w-full max-h-[500px]"
      width="1280"
      height="720"
      id="punta-video"
    >
      <source src="/videos/punta-campanella-video.mp4" type="video/mp4" />
      Il tuo browser non supporta il video HTML5.
    </video>
    <script>
  function cleanApostrophes(text) {
    return String(text).replace(/\'/g, "'");
  }
      let video = document.getElementById('punta-video');
      const forceMuted = () => {
        video.muted = true;
        video.volume = 0;
      };
      forceMuted();
      video.addEventListener('play', forceMuted);
      video.addEventListener('playing', forceMuted);
      video.addEventListener('volumechange', forceMuted);
      video.addEventListener('timeupdate', forceMuted);
      video.addEventListener('seeked', forceMuted);
    </script>
  </div>

  <!-- Key Takeaways -->
  <div class="bg-slate-900 text-white p-8 rounded-[2rem]">
    <div class="flex items-center gap-3 mb-6">
      <svg class="w-5 h-5 text-med-gold flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
      <h2 class="font-serif text-lg font-bold text-med-gold uppercase tracking-[0.15em]">Key Takeaways</h2>
    </div>
    <ul class="space-y-4">
      {keyTakeaways.map((point) => (
        <li class="flex items-start gap-3">
          <span class="w-1.5 h-1.5 rounded-full bg-med-gold flex-shrink-0 mt-2"></span>
          <span class="text-white/80 text-xs sm:text-sm leading-relaxed">{point}</span>
        </li>
      ))}
    </ul>
  </div>

  <!-- Intro -->
  <div>
    <p class="text-slate-600 text-xl leading-relaxed mb-6 font-light">
      Esiste un luogo, all'estremità della Penisola Sorrentina, dove la terra si assottiglia fino a diventare una punta di roccia protesa verso Capri. Quel luogo è Punta Campanella. Non è solo una riserva marina protetta; è il confine sacro tra il Golfo di Napoli e il Golfo di Salerno, un lembo di terra dove la storia millenaria, il mito di Ulisse e una natura selvaggia si fondono in un'esperienza sensoriale indimenticabile.
    </p>
  </div>

  <!-- Un Viaggio tra Mito e Archeologia -->
  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">Un Viaggio tra Mito e Archeologia</h2>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      Camminare verso Punta Campanella significa percorrere la stessa strada dei greci e dei romani. Qui sorgeva il maestoso Tempio di Athena (poi dedicato a Minerva dai Romani), un faro di civiltà che accoglieva i marinai nell'antichità. Oggi, i resti archeologici affiorano tra la vegetazione mediterranea, testimoni di un passato in cui questo promontorio era considerato sacro.
    </p>

    <div class="bg-white p-8 rounded-[2rem] border border-slate-100 shadow-sm my-6">
      <h3 class="font-serif text-xl font-bold text-slate-900 mb-4">La Torre Campanaria del XIV Secolo</h3>
      <p class="text-slate-600 leading-relaxed mb-4">
        Il nome "Campanella" deriva dalla torre di avvistamento del XIV secolo, parte del sistema difensivo contro le incursioni saracene. Sulla sommità della torre era posta una <strong>campana che suonava l'allarme</strong> in caso di pericolo, il cui rintocco rimbalzava di torre in torre lungo tutta la costa, creando una catena di comunicazione visiva e sonora che proteggeva gli insediamenti costieri.
      </p>
      <p class="text-slate-600 leading-relaxed">
        Ancora oggi, sebbene rovinata dal tempo, la torre domina il paesaggio e racconta storie di guardi notturni, di marinai in ansia e di una comunità che proteggeva il suo territorio con vigilanza costante.
      </p>
    </div>

    <blockquote class="border-l-4 border-med-gold pl-6 my-8">
      <p class="text-slate-700 text-xl font-serif italic leading-relaxed">
        "Punta Campanella è dove la geografia diventa storia, e la storia diventa leggenda."
      </p>
    </blockquote>
  </div>

  <!-- Il Sentiero: Trekking tra Cielo e Mare -->
  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">Il Sentiero: Trekking tra Cielo e Mare</h2>
    <p class="text-slate-600 text-lg leading-relaxed mb-8">
      L'itinerario per raggiungere la punta parte dal borgo di Termini (frazione di Massa Lubrense). È un percorso alla portata di tutti, ma capace di regalare scorci mozzafiato.
    </p>

    <div class="space-y-4 mb-8">
      <div class="bg-white p-6 rounded-[2rem] border border-slate-100 shadow-sm flex gap-5">
        <div class="w-10 h-10 rounded-full bg-med-gold/10 flex-shrink-0 flex items-center justify-center text-med-gold font-bold text-xs sm:text-sm">1</div>
        <div>
          <h4 class="font-bold text-slate-900 mb-1">Il Percorso</h4>
          <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Il sentiero si snoda tra uliveti secolari e arbusti di mirto e rosmarino. Man mano che si scende verso il faro, la sagoma di Capri si fa così vicina che sembra di poterla toccare. Ogni curva rivela nuove prospettive su uno scenario che cambia continuamente.</p>
        </div>
      </div>
      <div class="bg-white p-6 rounded-[2rem] border border-slate-100 shadow-sm flex gap-5">
        <div class="w-10 h-10 rounded-full bg-med-gold/10 flex-shrink-0 flex items-center justify-center text-med-gold font-bold text-xs sm:text-sm">2</div>
        <div>
          <h4 class="font-bold text-slate-900 mb-1">La Vista Panoramica</h4>
          <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Arrivati alla torre, lo sguardo spazia a 360 gradi: da un lato il Vesuvio e la costiera sorrentina, dall'altro la frastagliata Costiera Amalfitana con l'arcipelago de Li Galli. È il punto in cui tre prospettive mondane si incontrano in una sola visione.</p>
        </div>
      </div>
    </div>

    <div class="overflow-hidden rounded-[2rem] border border-slate-100 shadow-sm">
      <table class="w-full text-xs sm:text-xs sm:text-sm">
        <thead class="bg-slate-900 text-white">
          <tr>
            <th class="text-left p-5 font-serif font-bold text-med-gold">Caratteristica</th>
            <th class="text-left p-5 font-serif font-bold text-med-gold">Dettaglio</th>
          </tr>
        </thead>
        <tbody class="bg-white">
          <tr class="border-b border-slate-100">
            <td class="p-5 font-bold text-slate-900">Punto di Partenza</td>
            <td class="p-5 text-slate-600">Piazza di Termini (Massa Lubrense)</td>
          </tr>
          <tr class="border-b border-slate-100">
            <td class="p-5 font-bold text-slate-900">Difficolta</td>
            <td class="p-5 text-slate-600">E (Escursionistico) - Facile/Medio</td>
          </tr>
          <tr class="border-b border-slate-100">
            <td class="p-5 font-bold text-slate-900">Tempo di percorrenza</td>
            <td class="p-5 text-slate-600">Circa 1 ora (solo andata)</td>
          </tr>
          <tr class="border-b border-slate-100">
            <td class="p-5 font-bold text-slate-900">Equipaggiamento</td>
            <td class="p-5 text-slate-600">Scarpe da trekking, acqua, cappello</td>
          </tr>
          <tr>
            <td class="p-5 font-bold text-slate-900">Accesso</td>
            <td class="p-5 text-slate-600">Gratuito (Riserva Marina Protetta)</td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>

  <!-- Local Tips -->
  <div class="bg-white p-8 rounded-[2rem] shadow-xl border border-slate-100">
    <div class="flex items-center gap-4 mb-6">
      <svg class="w-6 h-6 text-med-gold flex-shrink-0" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M9 18h6"/><path d="M10 22h4"/><path d="M15.09 14c.18-.98.65-1.74 1.41-2.5A4.65 4.65 0 0 0 18 8 6 6 0 0 0 6 8c0 1 .23 2.23 1.5 3.5A4.61 4.61 0 0 1 8.91 14"/></svg>
      <h3 class="text-xl font-bold text-slate-900">I Consigli dell'Esperto</h3>
    </div>
    <div class="space-y-6">
      <div>
        <p class="font-bold text-slate-900 mb-1">Il Momento Magico: Il Tramonto</p>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Il tramonto a Punta Campanella è un'esperienza mistica. Il sole cala esattamente di fianco ai Faraglioni di Capri, tingendo il mare d'oro. Se decidete di restare per il tramonto, portate con voi una torcia frontale per il rientro a piedi verso Termini.</p>
      </div>
      <div>
        <p class="font-bold text-slate-900 mb-1">La Discesa alla Baia di Ieranto</p>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Se siete camminatori esperti, dal bivio principale potete deviare verso la <a href="/it-it/spiagge/penisola-sorrentina/ieranto/" class="text-med-blue hover:underline">Baia di Ieranto</a>, una caletta incontaminata di proprietà del FAI. È uno dei pochi luoghi dove l'accesso a motore è vietato, garantendo un mare di una purezza primordiale.</p>
      </div>
      <div>
        <p class="font-bold text-slate-900 mb-1">Rispetto per l'Ambiente</p>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Siete in una Riserva Naturale. Non abbandonate rifiuti e restate sui sentieri tracciati per preservare la rara flora endemica della zona e gli habitat marino-costieri unici.</p>
      </div>
    </div>
  </div>

  <!-- La Leggenda di Ulisse -->
  <div class="bg-slate-50 p-8 rounded-[2rem] border-l-4 border-med-gold my-8">
    <div class="flex items-start gap-4">
      <svg class="w-6 h-6 text-med-gold flex-shrink-0 mt-1" fill="currentColor" viewBox="0 0 24 24"><path d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
      <div>
        <h3 class="font-bold text-slate-900 mb-2 text-lg">Lo Sapevi?</h3>
        <p class="text-slate-700 leading-relaxed">
          La leggenda narra che proprio qui, tra gli scogli di Punta Campanella, Ulisse incontrò le Sirene. Per resistere al loro canto ammaliatore, si fece legare all'albero maestro della sua nave, mentre i suoi compagni navigavano con le orecchie tappate dalla cera. Ogni tramonto da queste scogliere, sembra di udire ancora quel canto lontano, carezzato dalle onde.
        </p>
      </div>
    </div>
  </div>

</BlogPostLayout>
