---
import BlogPostLayout from '../../../../layouts/BlogPostLayout.astro';

const lang = 'it-it';
const post = {
  title: 'Scuola Primaria a Sorrento: Guida per le Famiglie',
  subtitle: 'Come funziona la scuola primaria italiana, quali scuole ci sono davvero a Sorrento, quando si fanno le iscrizioni e cosa deve mettere in conto chi non parla italiano',
  category: 'GUIDE',
  date: '25 Settembre 2026',
  readTime: '10 min',
  image: '/images/piazza-tasso-sorrento-hero.webp',
  imageAlt: "Piazza Tasso, la piazza principale di Sorrento e il centro della vita quotidiana in città",
  path: '/it-it/blog/scuola-primaria-sorrento/',
};

const metaTitle = 'Scuola Primaria a Sorrento: Scuole e Iscrizioni | 2026';
const metaDescription = 'Sorrento ha quattro scuole primarie, due statali e due paritarie, raccolte in due istituti comprensivi. Regole di età, finestra di iscrizione a gennaio sulla piattaforma Unica, tempo pieno e alternativa in lingua inglese.';

const breadcrumbs = [
  { name: 'Home', url: '/it-it/' },
  { name: 'Blog', url: '/it-it/blog/' },
  { name: 'Scuola Primaria a Sorrento', url: '/it-it/blog/scuola-primaria-sorrento/' },
];

const quickInfo = [
  { label: 'Tipo di scuola', value: 'Scuola primaria, 5 anni' },
  { label: 'Età', value: 'Dai 6 agli 11 anni' },
  { label: 'Regola di ingresso', value: 'Sei anni entro il 31 dicembre' },
  { label: 'Anticipo', value: 'Possibile se sei anni entro il 30 aprile' },
  { label: 'Scuole a Sorrento', value: '4: due statali, due paritarie' },
  { label: 'Istituti comprensivi', value: '2: Sorrento Capoluogo e Tasso' },
  { label: 'Iscrizioni', value: 'Online a gennaio, serve SPID o CIE' },
  { label: 'Lingua di insegnamento', value: 'Italiano' },
];

const faq = [
  {
    q: 'A che età si inizia la scuola primaria in Italia?',
    a: 'Si entra in classe prima nel settembre dell\'anno in cui si compiono sei anni, purché il compleanno cada entro il 31 dicembre. È possibile chiedere l\'iscrizione anticipata per i bambini che compiono sei anni entro il 30 aprile dell\'anno successivo. La primaria dura poi cinque anni, fino agli undici circa.',
  },
  {
    q: 'Quante scuole primarie ci sono a Sorrento?',
    a: 'Quattro nel comune di Sorrento: due statali, Sorrento Capoluogo in Via Vittorio Veneto e Angelina Lauro in Via Capasso, e due paritarie, il Conservatorio Santa Maria della Pietà in Via Pietà e Santa Maria delle Grazie in Piazza Sant\'Antonino. Le statali fanno capo a due istituti comprensivi, che comprendono anche infanzia e scuola media.',
  },
  {
    q: 'Quando si aprono le iscrizioni?',
    a: 'A gennaio, per l\'anno scolastico che inizia il settembre successivo. Per il 2026/2027 la finestra è andata dal 13 gennaio al 14 febbraio 2026. Il Ministero pubblica la circolare con le date esatte a dicembre, quindi la finestra dell\'anno dopo si conosce di solito poche settimane prima.',
  },
  {
    q: 'Come si presenta la domanda?',
    a: 'Online, sulla piattaforma Unica del Ministero dell\'Istruzione. Un genitore accede con identità digitale, SPID, CIE o eIDAS, inserisce i dati del bambino e indica una scuola come prima scelta più al massimo altre due alternative. Serve il codice fiscale del bambino. Chi arriva ad anno iniziato si iscrive invece direttamente presso la scuola, fuori dalla piattaforma.',
  },
  {
    q: 'Esiste una scuola primaria in lingua inglese a Sorrento?',
    a: 'No. In penisola sorrentina non c\'è nessuna scuola primaria internazionale o in lingua inglese. L\'alternativa più vicina è l\'International School of Naples a Bagnoli, che segue un curriculum americano in inglese dalla scuola dell\'infanzia alla dodicesima classe. Da Sorrento dista circa un\'ora e mezza, il che la esclude come pendolarismo quotidiano per quasi tutte le famiglie.',
  },
  {
    q: 'Questa pagina parla della Sorrento Primary School in Australia?',
    a: 'No. Scuole con quel nome esistono a Sorrento, in Australia Occidentale, e a Sorrento, nel Victoria, e non hanno nulla a che vedere con questa. Qui si parla della scuola primaria a Sorrento in Campania, la città sul Golfo di Napoli.',
  },
];

const sidebarLinks = [
  { label: 'Sorrento', href: '/it-it/penisola-sorrentina/sorrento/' },
  { label: 'Study Abroad a Sorrento', href: '/it-it/blog/study-abroad-sorrento/' },
  { label: 'Sorrento o Positano', href: '/it-it/blog/sorrento-vs-positano/' },
  { label: 'Bus SITA', href: '/it-it/guida/bus-sita/' },
  { label: 'Traghetti', href: '/it-it/guida/traghetti/' },
];

const authorRole = 'Guide locali · Penisola Sorrentina';

const relatedArticles = [
  {
    title: 'Study Abroad a Sorrento: Studiare in Penisola Sorrentina',
    category: 'GUIDE',
    date: '4 Luglio 2026',
    image: '/images/study-abroad-sorrento-hero.webp',
    imageAlt: 'Studiare a Sorrento',
    path: '/it-it/blog/study-abroad-sorrento/'
  },
  {
    title: 'Film Fatti a Sorrento: Quando il Cinema Sceglie la Penisola',
    category: 'SCOPERTE',
    date: '30 Giugno 2026',
    image: '/images/film-fatti-a-sorrento-hero.webp',
    imageAlt: 'Film girati a Sorrento',
    path: '/it-it/blog/film-fatti-a-sorrento/'
  }
];

const imageCredit = {
  author: 'Berthold Werner / Wikimedia Commons',
  sourceUrl: 'https://commons.wikimedia.org/wiki/File:Piazza_Tasso_-_Sorrento_BW_2013-05-12.jpg',
  license: 'CC BY-SA 3.0',
  licenseUrl: 'https://creativecommons.org/licenses/by-sa/3.0/',
};

const keyTakeaways = [
  'La scuola primaria italiana dura cinque anni, parte dal settembre dell\'anno in cui il bambino compie sei anni ed è gratuita nelle scuole statali.',
  'Sorrento ha quattro scuole primarie, due statali e due paritarie, raccolte in due istituti comprensivi con sede in Via Vittorio Veneto e in Via Marziale.',
  'L\'iscrizione si fa online a gennaio sulla piattaforma Unica del Ministero, e serve un\'identità digitale italiana come SPID o CIE.',
  'La scelta che conta di più sul posto è fra tempo normale e tempo pieno, perché i posti a tempo pieno sono limitati e non attivi in tutti i plessi.',
  'Si insegna in italiano. In penisola non esiste una primaria in lingua inglese e la scuola internazionale più vicina è a Napoli, troppo lontana per il pendolarismo quotidiano.',
];
---

<BlogPostLayout
  lang={lang}
  post={post}
  metaTitle={metaTitle}
  metaDescription={metaDescription}
  breadcrumbs={breadcrumbs}
  quickInfo={quickInfo}
  faq={faq}
  sidebarLinks={sidebarLinks}
  authorRole={authorRole}
  relatedArticles={relatedArticles}
  imageCredit={imageCredit}
  pageKey="sorrento-primary-school"
>

  <!-- Key Takeaways -->
  <div class="bg-slate-900 text-white p-8 rounded-[2rem]">
    <div class="flex items-center gap-3 mb-6">
      <svg class="w-5 h-5 text-med-gold flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
      <h2 class="font-serif text-lg font-bold text-med-gold uppercase tracking-[0.15em]">Punti Chiave</h2>
    </div>
    <ul class="space-y-4">
      {keyTakeaways.map((point) => (
        <li class="flex items-start gap-3">
          <span class="w-1.5 h-1.5 rounded-full bg-med-gold flex-shrink-0 mt-2"></span>
          <span class="text-white/80 text-xs sm:text-sm leading-relaxed">{point}</span>
        </li>
      ))}
    </ul>
  </div>

  <!-- Intro -->
  <div>
    <p class="text-slate-600 text-xl leading-relaxed mb-6 font-light">
      Quasi tutti arrivano a <a href="/it-it/penisola-sorrentina/sorrento/" class="text-med-blue hover:underline">Sorrento</a> per una settimana. Una minoranza ci arriva per un anno o più, di solito per un lavoro nel turismo, per un impiego da remoto che si potrebbe fare ovunque o per il ritorno in una casa di famiglia, e scopre che la domanda su dove andrà a scuola un bambino di sei anni non è trattata in nessuna guida turistica. Questa pagina racconta che cosa offre davvero la città, come funziona il sistema italiano per un bambino che ci entra da fuori e quali sono le poche date che decidono tutto.
    </p>
  </div>

  <!-- Come funziona -->
  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">Come Funziona la Scuola Primaria Italiana</h2>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      La scuola primaria dura cinque anni, dalla <em>classe prima</em> alla <em>classe quinta</em>, e copre indicativamente la fascia fra i sei e gli undici anni. È obbligatoria e, nelle scuole statali, gratuita: le famiglie pagano materiali, gite e mensa, non l'insegnamento. Prima c'è la <em>scuola dell'infanzia</em>, facoltativa, dai tre anni; dopo arrivano i tre anni di <em>scuola secondaria di primo grado</em>, quella che tutti chiamano scuola media.
    </p>
    <p class="text-slate-600 text-lg leading-relaxed mb-8">
      In Campania l'anno scolastico va normalmente da metà settembre ai primi giorni di giugno, con le chiusure di Natale, Pasqua e le festività nazionali e locali. L'unica vera scelta strutturale che una famiglia compie al momento dell'iscrizione riguarda l'orario.
    </p>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div class="bg-white p-6 rounded-[2rem] border border-slate-100 shadow-sm">
        <h4 class="font-bold text-slate-900 mb-2">Tempo normale</h4>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Solo mattina, di solito fra le 27 e le 30 ore settimanali, con uscita nel primo pomeriggio e senza mensa. È l'impostazione prevalente al Sud e costa meno, ma presuppone che a pranzo qualcuno sia a casa.</p>
      </div>
      <div class="bg-white p-6 rounded-[2rem] border border-slate-100 shadow-sm">
        <h4 class="font-bold text-slate-900 mb-2">Tempo pieno</h4>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Circa 40 ore settimanali, mensa inclusa e lezioni anche il pomeriggio. I posti sono limitati, non sono attivi in tutti i plessi e vengono assegnati in base alla domanda: è la prima cosa da chiedere quando si telefona a una scuola.</p>
      </div>
    </div>
  </div>

  <!-- Le scuole -->
  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">Le Scuole Primarie di Sorrento</h2>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      Sorrento è una città piccola e l'elenco è breve. Nel comune operano quattro scuole primarie, due statali e due paritarie legate a istituti religiosi. Quelle statali stanno dentro gli <em>istituti comprensivi</em>, l'unità italiana che raccoglie infanzia, primaria e media sotto un'unica dirigenza.
    </p>

    <div class="overflow-x-auto rounded-[2rem] border border-slate-100 shadow-sm">
      <table class="w-full text-xs sm:text-sm">
        <thead class="bg-slate-900 text-white">
          <tr>
            <th class="text-left p-5 font-serif font-bold text-med-gold">Scuola</th>
            <th class="text-left p-5 font-serif font-bold text-med-gold">Tipo</th>
            <th class="text-left p-5 font-serif font-bold text-med-gold">Indirizzo</th>
          </tr>
        </thead>
        <tbody class="bg-white">
          <tr class="border-b border-slate-100">
            <td class="p-5 font-bold">Sorrento Capoluogo</td>
            <td class="p-5 text-slate-600">Statale, I.C. Sorrento</td>
            <td class="p-5 text-slate-600">Via Vittorio Veneto, Sorrento</td>
          </tr>
          <tr class="border-b border-slate-100">
            <td class="p-5 font-bold">Angelina Lauro</td>
            <td class="p-5 text-slate-600">Statale</td>
            <td class="p-5 text-slate-600">Via Capasso, Sorrento</td>
          </tr>
          <tr class="border-b border-slate-100">
            <td class="p-5 font-bold">Conservatorio Santa Maria della Pietà</td>
            <td class="p-5 text-slate-600">Paritaria, istituto religioso</td>
            <td class="p-5 text-slate-600">Via Pietà 24, Sorrento</td>
          </tr>
          <tr>
            <td class="p-5 font-bold">Santa Maria delle Grazie</td>
            <td class="p-5 text-slate-600">Paritaria</td>
            <td class="p-5 text-slate-600">Piazza Sant'Antonino 14, Sorrento</td>
          </tr>
        </tbody>
      </table>
    </div>

    <p class="text-slate-600 text-lg leading-relaxed mt-6">
      Dentro il sistema statale le classi di primaria sono distribuite su due edifici: la sede principale di Via Vittorio Veneto 16 e una seconda sede in Via Marziale 18, che è anche l'indirizzo dell'istituto comprensivo Tasso e dove sono state collocate le sezioni a tempo pieno. L'edificio che frequenterà vostro figlio dipende dalla sezione in cui viene inserito, non soltanto dalla scuola a cui avete fatto domanda: conviene chiederlo al momento dell'iscrizione invece di darlo per scontato.
    </p>
  </div>

  <!-- Iscrizione -->
  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">Come si Fa l'Iscrizione, Passo per Passo</h2>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      L'iscrizione in classe prima è una procedura online nazionale con una finestra fissa, e mancarla significa trattare direttamente con una scuola per quello che resta. La sequenza qui sotto vale per una famiglia già residente, o in procinto di esserlo, a Sorrento.
    </p>

    <div class="bg-white p-8 rounded-[2rem] border border-slate-100 shadow-sm">
      <h3 class="font-serif text-xl font-bold text-slate-900 mb-5">I cinque passaggi</h3>
      <div class="space-y-3">
        <div class="flex items-start gap-3">
          <div class="w-6 h-6 rounded-full bg-med-gold/15 flex-shrink-0 flex items-center justify-center text-med-gold font-bold text-xs">1</div>
          <p class="text-slate-600 text-xs sm:text-sm leading-relaxed"><strong>Mettere in ordine i documenti.</strong> Al bambino serve il <em>codice fiscale</em> italiano, e ad almeno un genitore serve un'identità digitale, SPID, CIE o un accesso europeo eIDAS equivalente. Entrambi richiedono tempo: meglio partire in autunno, non a gennaio.</p>
        </div>
        <div class="flex items-start gap-3">
          <div class="w-6 h-6 rounded-full bg-med-gold/15 flex-shrink-0 flex items-center justify-center text-med-gold font-bold text-xs">2</div>
          <p class="text-slate-600 text-xs sm:text-sm leading-relaxed"><strong>Aspettare la circolare ministeriale.</strong> Esce a dicembre e fissa la finestra. Per il 2026/2027 le domande sono andate dal 13 gennaio al 14 febbraio 2026, e negli ultimi anni l'apertura è sempre stata a gennaio.</p>
        </div>
        <div class="flex items-start gap-3">
          <div class="w-6 h-6 rounded-full bg-med-gold/15 flex-shrink-0 flex items-center justify-center text-med-gold font-bold text-xs">3</div>
          <p class="text-slate-600 text-xs sm:text-sm leading-relaxed"><strong>Andare agli open day.</strong> Le scuole li organizzano nelle settimane precedenti l'apertura. È lì che si vedono gli edifici, si incontrano le maestre e si scopre se il tempo pieno sarà attivato nell'anno che viene.</p>
        </div>
        <div class="flex items-start gap-3">
          <div class="w-6 h-6 rounded-full bg-med-gold/15 flex-shrink-0 flex items-center justify-center text-med-gold font-bold text-xs">4</div>
          <p class="text-slate-600 text-xs sm:text-sm leading-relaxed"><strong>Fare domanda su Unica.</strong> Una scuola come prima scelta, fino a due alternative. In caso di esubero il criterio principale è di solito la residenza nel bacino della scuola, seguito dalle altre condizioni familiari previste dai regolamenti dei singoli istituti.</p>
        </div>
        <div class="flex items-start gap-3">
          <div class="w-6 h-6 rounded-full bg-med-gold/15 flex-shrink-0 flex items-center justify-center text-med-gold font-bold text-xs">5</div>
          <p class="text-slate-600 text-xs sm:text-sm leading-relaxed"><strong>Sistemare i servizi con il comune.</strong> Mensa, pre e post scuola e trasporto scolastico sono servizi comunali con domande separate, non fanno parte dell'iscrizione alla scuola.</p>
        </div>
      </div>
    </div>
  </div>

  <!-- Chi non parla italiano -->
  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">Se in Famiglia Non si Parla Italiano</h2>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      La risposta onesta è che in una scuola primaria di Sorrento un bambino verrà istruito in italiano, da insegnanti che nella maggior parte dei casi lavorano solo in italiano, insieme a compagni che lo parlano tutti in casa. La scuola statale italiana accetta bambini in qualsiasi momento dell'anno scolastico, a prescindere dalla lingua e dalla situazione documentale, ed è un pregio reale del sistema; il supporto di italiano come seconda lingua esiste, ma quanto ne possa offrire una singola scuola varia moltissimo.
    </p>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      Per la maggior parte dei bambini di sei o sette anni la cosa si rivela sostenibile, e spesso sorprendentemente rapida. Dai nove o dieci anni in su, arrivare senza una parola di italiano dentro un programma già impegnativo in storia, geografia e grammatica è molto più duro, e va valutato con attenzione.
    </p>
    <p class="text-slate-600 text-lg leading-relaxed mb-8">
      In penisola non esiste una primaria in lingua inglese. L'alternativa più vicina è l'<strong>International School of Naples</strong> a Bagnoli, all'estremo ovest della città, che insegna un curriculum americano in inglese dalla scuola dell'infanzia alla dodicesima classe, ha circa 300 alunni di molte nazionalità e comunica il proprio tariffario solo tramite l'ufficio ammissioni. Da Sorrento parliamo di circa un'ora e mezza per tratta, attraversando tutta Napoli: nei fatti le famiglie che ne hanno bisogno si avvicinano alla città invece di fare i pendolari.
    </p>

    <blockquote class="border-l-4 border-med-gold pl-6 my-8">
      <p class="text-slate-700 text-xl font-serif italic leading-relaxed">
        "A Sorrento la domanda non è quale curriculum internazionale scegliere. È quanto in fretta un bambino impara l'italiano, e di solito la risposta è: prima dei suoi genitori."
      </p>
    </blockquote>
  </div>

  <!-- Consigli -->
  <div class="bg-white p-8 rounded-[2rem] shadow-xl border border-slate-100">
    <div class="flex items-center gap-4 mb-6">
      <svg class="w-6 h-6 text-med-gold flex-shrink-0" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M9 18h6"/><path d="M10 22h4"/><path d="M15.09 14c.18-.98.65-1.74 1.41-2.5A4.65 4.65 0 0 0 18 8 6 6 0 0 0 6 8c0 1 .23 2.23 1.5 3.5A4.61 4.61 0 0 1 8.91 14"/></svg>
      <h3 class="text-xl font-bold">Consigli dell'esperto</h3>
    </div>
    <div class="space-y-6">
      <div>
        <p class="font-bold text-slate-900 mb-1">Chiedete il plesso, non solo la scuola</p>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Le classi statali di primaria a Sorrento sono distribuite su più sedi, e la distanza fra Via Vittorio Veneto e Via Marziale pesa quando la si percorre due volte al giorno con un bambino di sei anni. Verificate quale plesso userà la sezione prima di accettare il posto.</p>
      </div>
      <div>
        <p class="font-bold text-slate-900 mb-1">Trattate la residenza come il fattore decisivo</p>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Se una scuola ha più domande che posti, di solito vince il bacino. Se state ancora scegliendo dove affittare in città, controllate a quale scuola appartiene l'indirizzo prima di firmare: è molto più facile scegliere la casa attorno alla scuola che il contrario.</p>
      </div>
      <div>
        <p class="font-bold text-slate-900 mb-1">Non date per scontato l'anticipo</p>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">La strada dell'anticipataria esiste per chi compie sei anni entro il 30 aprile dell'anno successivo, ma le scuole la valutano in base alla maturità del bambino e al numero di classi che riescono a formare. Fate domanda se vi interessa, e tenete pronto un piano con un altro anno di scuola dell'infanzia.</p>
      </div>
      <div>
        <p class="font-bold text-slate-900 mb-1">La penisola è più grande di Sorrento</p>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Sant'Agnello, Piano di Sorrento, Meta e Massa Lubrense hanno i loro istituti comprensivi, a pochi minuti con la Circumvesuviana o con il <a href="/it-it/guida/bus-sita/" class="text-med-blue hover:underline">bus SITA</a>. Se vi serve il tempo pieno e a Sorrento non c'è, spesso il comune accanto lo offre.</p>
      </div>
    </div>
  </div>

</BlogPostLayout>
