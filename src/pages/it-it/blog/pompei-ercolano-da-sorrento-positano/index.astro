---
import BlogPostLayout from '../../../../layouts/BlogPostLayout.astro';

const lang = 'it-it';
const post = {
  title: 'Pompei ed Ercolano da Sorrento e Positano',
  subtitle: "Treni, bus e autisti per le due città sepolte dal Vesuvio, con biglietti 2026, orari di apertura e una risposta chiara su quale scegliere",
  category: 'GUIDE',
  date: '18 Ottobre 2026',
  readTime: '11 min',
  image: '/images/pompei-basilica-hero.webp',
  imageAlt: "Le colonne in mattoni e il colonnato a due ordini della Basilica di Pompei",
  path: '/it-it/blog/pompei-ercolano-da-sorrento-positano/',
};

const metaTitle = 'Pompei ed Ercolano da Sorrento o Positano: guida 2026';
const metaDescription = "Come arrivare a Pompei ed Ercolano da Sorrento e Positano: Circumvesuviana, bus SITA, prezzi dei biglietti 2026, orari di apertura e una giornata tipo.";

const breadcrumbs = [
  { name: 'Home', url: '/it-it/' },
  { name: 'Blog', url: '/it-it/blog/' },
  { name: 'Pompei ed Ercolano da Sorrento e Positano', url: '/it-it/blog/pompei-ercolano-da-sorrento-positano/' },
];

const quickInfo = [
  { label: 'Sorrento-Pompei', value: 'Circumvesuviana, circa 35-45 min' },
  { label: 'Sorrento-Ercolano', value: 'Circumvesuviana, circa 1 ora' },
  { label: 'Positano-Pompei', value: 'Bus SITA + treno, 2 ore o più' },
  { label: 'Biglietto Pompei', value: 'Da €20 (Express), €25 (Pompeii+)' },
  { label: 'Biglietto Ercolano', value: '€16 intero' },
  { label: 'Orario invernale', value: 'Ultimo ingresso 15:30 in entrambi i siti' },
  { label: 'Ingresso gratuito', value: 'Prima domenica di ogni mese' },
  { label: 'Tempo necessario', value: 'Ercolano 2 ore, Pompei 3-4 ore' },
];

const faq = [
  {
    q: 'Come si arriva da Sorrento a Pompei?',
    a: "Con la Circumvesuviana linea Napoli-Sorrento dalla stazione di Sorrento, scendendo a Pompei Scavi-Villa dei Misteri. Il viaggio dura circa 35-45 minuti e l'ingresso di Porta Marina è a pochi minuti a piedi dal binario. Non scendete a Pompei Santuario, che è su un'altra linea e serve l'ingresso dell'Anfiteatro. L'orario EAV in vigore dal 17 ottobre 2026 prevede un treno ogni 30 minuti da e per Sorrento.",
  },
  {
    q: "C'è un bus diretto da Positano a Pompei?",
    a: "Non uno su cui contare. Non abbiamo trovato conferme di un bus pubblico diretto tra Positano e Pompei per l'autunno e l'inverno 2026. Il percorso pubblico affidabile è il bus SITA da Positano a Sorrento, circa 50 minuti con traffico normale, e poi la Circumvesuviana. In alternativa: auto a noleggio, autista privato o tour organizzato.",
  },
  {
    q: 'Il Campania Express è attivo?',
    a: "Al momento no. Il treno turistico era ripartito il 28 marzo 2026 con fermate a Ercolano, Pompei e Castellammare, ma EAV lo ha sospeso dal 1° ottobre 2026 fino a nuovo avviso. Chi ha biglietti per date successive può chiedere il rimborso tramite il modulo reclami di EAV. Controllate eavsrl.it prima della prossima primavera.",
  },
  {
    q: 'Quanto costa il biglietto per Pompei nel 2026?',
    a: "Dal 12 gennaio 2026 il biglietto Pompeii Express, solo città antica, costa €20 e Pompeii+ costa €25, con in più Villa dei Misteri, Villa di Diomede, Villa Regina a Boscoreale e la navetta. I cittadini UE tra 18 e 24 anni pagano €2. I biglietti sono nominativi, quindi portate un documento. Si comprano sul sito ufficiale Vivaticket o alle biglietterie del Parco.",
  },
  {
    q: 'Pompei o Ercolano, se ho tempo per uno solo?',
    a: "Ercolano se avete mezza giornata, cercate ombra e meno gente e vi interessano i dettagli: travi di legno, piani superiori e ambienti dipinti sono rimasti lì. Pompei se volete la scala di un'intera città romana, con foro, teatri, anfiteatro e lunghe strade lastricate, e avete almeno tre o quattro ore.",
  },
  {
    q: 'Si possono visitare entrambi in un giorno?',
    a: "Sì, sono a circa 20-25 minuti l'uno dall'altro sulla stessa linea. Da Sorrento funziona se si parte presto, con Ercolano la mattina e Pompei il pomeriggio in inverno. Da Positano diventa una giornata lunghissima: meglio due giorni separati o un autista.",
  },
];

const sidebarLinks = [
  { label: 'Sorrento', href: '/it-it/penisola-sorrentina/sorrento/' },
  { label: 'Positano', href: '/it-it/costiera-amalfitana/positano/' },
  { label: 'Sorrento, Pompei e storia in 3 giorni', href: '/it-it/itinerari/3-giorni/sorrento-pompei-storia/' },
  { label: 'Bus SITA', href: '/it-it/guida/bus-sita/' },
  { label: 'La Costiera in treno', href: '/it-it/blog/costiera-amalfitana-in-treno/' },
  { label: 'Come arrivare', href: '/it-it/guida/come-arrivare/' },
];

const authorRole = 'Guide locali · Costiera Amalfitana';

const relatedArticles = [
  {
    title: 'La Costiera Amalfitana in treno',
    category: 'GUIDE',
    date: '10 Agosto 2026',
    image: '/images/treno-costiera-hero.webp',
    imageAlt: 'La Costiera Amalfitana in treno',
    path: '/it-it/blog/costiera-amalfitana-in-treno/'
  },
  {
    title: 'Sorrento o Positano: Dove Alloggiare in Costiera Amalfitana',
    category: 'GUIDE',
    date: '15 Giugno 2026',
    image: '/images/sorrento-vs-positano-hero.webp',
    imageAlt: 'Sorrento e Positano a confronto',
    path: '/it-it/blog/sorrento-vs-positano/'
  }
];

const keyTakeaways = [
  "Da Sorrento i due siti sono sulla stessa linea della Circumvesuviana: circa 35-45 minuti fino a Pompei Scavi-Villa dei Misteri e circa un'ora fino a Ercolano Scavi, con un treno ogni 30 minuti secondo l'orario in vigore dal 17 ottobre 2026.",
  "Da Positano non esiste un trasporto pubblico diretto su cui contare. Si prende il bus SITA fino a Sorrento e poi il treno, oppure auto, autista privato o tour.",
  "Il treno turistico Campania Express è sospeso dal 1° ottobre 2026 fino a nuovo avviso: per ora resta il normale treno pendolare.",
  "Dal 12 gennaio 2026 il biglietto di Pompei costa €20 (Express) o €25 (Pompeii+), è nominativo e con un tetto di 20.000 ingressi al giorno. Ercolano costa €16.",
  "Dal 15 ottobre al 15 marzo l'ultimo ingresso è alle 15:30 in entrambi i siti. Tutti e due sono gratuiti la prima domenica di ogni mese, senza prenotazione online.",
];
---

<BlogPostLayout
  lang={lang}
  post={post}
  metaTitle={metaTitle}
  metaDescription={metaDescription}
  breadcrumbs={breadcrumbs}
  quickInfo={quickInfo}
  faq={faq}
  sidebarLinks={sidebarLinks}
  authorRole={authorRole}
  relatedArticles={relatedArticles}
  pageKey="pompeii-herculaneum-from-sorrento"
>

  <!-- Key Takeaways -->
  <div class="bg-slate-900 text-white p-8 rounded-[2rem]">
    <div class="flex items-center gap-3 mb-6">
      <svg class="w-5 h-5 text-med-gold flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
      <h2 class="font-serif text-lg font-bold text-med-gold uppercase tracking-[0.15em]">Punti Chiave</h2>
    </div>
    <ul class="space-y-4">
      {keyTakeaways.map((point) => (
        <li class="flex items-start gap-3">
          <span class="w-1.5 h-1.5 rounded-full bg-med-gold flex-shrink-0 mt-2"></span>
          <span class="text-white/80 text-xs sm:text-sm leading-relaxed">{point}</span>
        </li>
      ))}
    </ul>
  </div>

  <!-- Intro -->
  <div>
    <p class="text-slate-600 text-xl leading-relaxed mb-6 font-light">
      Pompei ed Ercolano stanno sulla stessa ferrovia tra Napoli e <a href="/it-it/penisola-sorrentina/sorrento/" class="text-med-blue hover:underline">Sorrento</a>, e per chi soggiorna in penisola sono la gita più ovvia. Da Sorrento basta un treno. Da <a href="/it-it/costiera-amalfitana/positano/" class="text-med-blue hover:underline">Positano</a> serve più organizzazione, perché la ferrovia finisce a Sorrento e la strada costiera è lenta. Questa guida copre entrambi i punti di partenza, le regole sui biglietti cambiate nel 2026, gli orari invernali ed estivi e come scegliere tra i due siti se avete tempo per uno solo.
    </p>
  </div>

  <!-- Which one -->
  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">Pompei o Ercolano?</h2>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      Entrambe furono distrutte dall'eruzione del Vesuvio del 79 d.C., ma furono sepolte in modo diverso e sul posto sono molto diverse. Pompei fu coperta da cenere e lapilli; era una grande città commerciale e la sua area scavata è circa dieci volte quella di Ercolano. Ercolano, città costiera più piccola e più ricca, finì sotto una ventina di metri di materiale vulcanico che la sigillò più a fondo: per questo travi di legno, scale, piani superiori e stanze dipinte si sono conservati come raramente accade a Pompei.
    </p>

    <div class="overflow-x-auto rounded-[2rem] border border-slate-100 shadow-sm mb-6">
      <table class="w-full text-xs sm:text-sm">
        <thead class="bg-slate-900 text-white">
          <tr>
            <th class="text-left p-5 font-serif font-bold text-med-gold"></th>
            <th class="text-left p-5 font-serif font-bold text-med-gold">Pompei</th>
            <th class="text-left p-5 font-serif font-bold text-med-gold">Ercolano</th>
          </tr>
        </thead>
        <tbody class="bg-white">
          <tr class="border-b border-slate-100">
            <td class="p-5 font-bold">Dimensioni</td>
            <td class="p-5 text-slate-600">Una città intera, lunghe camminate tra le zone</td>
            <td class="p-5 text-slate-600">Compatta, vista dall'alto e percorsa ad anello</td>
          </tr>
          <tr class="border-b border-slate-100">
            <td class="p-5 font-bold">Tempo necessario</td>
            <td class="p-5 text-slate-600">Almeno 3-4 ore, una giornata intera si riempie facilmente</td>
            <td class="p-5 text-slate-600">Circa 2 ore</td>
          </tr>
          <tr class="border-b border-slate-100">
            <td class="p-5 font-bold">Conservazione</td>
            <td class="p-5 text-slate-600">Impianto urbano, foro, teatri, anfiteatro, affreschi</td>
            <td class="p-5 text-slate-600">Piani superiori, legno, arredi, interni integri</td>
          </tr>
          <tr class="border-b border-slate-100">
            <td class="p-5 font-bold">Da Sorrento</td>
            <td class="p-5 text-slate-600">Circa 35-45 min fino a Pompei Scavi-Villa dei Misteri</td>
            <td class="p-5 text-slate-600">Circa 1 ora fino a Ercolano Scavi, poi 6 min a piedi</td>
          </tr>
          <tr class="border-b border-slate-100">
            <td class="p-5 font-bold">Intero 2026</td>
            <td class="p-5 text-slate-600">€20 Express, €25 Pompeii+</td>
            <td class="p-5 text-slate-600">€16</td>
          </tr>
          <tr class="border-b border-slate-100">
            <td class="p-5 font-bold">Affollamento</td>
            <td class="p-5 text-slate-600">Fino a 20.000 al giorno, grandi gruppi</td>
            <td class="p-5 text-slate-600">Molti meno, più tranquilla nel pomeriggio</td>
          </tr>
          <tr>
            <td class="p-5 font-bold">Ombra</td>
            <td class="p-5 text-slate-600">Pochissima, faticosa a luglio e agosto</td>
            <td class="p-5 text-slate-600">Più ambienti coperti, distanze brevi</td>
          </tr>
        </tbody>
      </table>
    </div>

    <p class="text-slate-600 text-lg leading-relaxed">
      La nostra opinione: per una prima visita con una giornata intera, Pompei, perché nient'altro restituisce il senso di un'intera città romana. Per mezza giornata, per famiglie con bambini piccoli, per chi soffre il caldo o le lunghe camminate, o per chi ha già visto Pompei, Ercolano è l'uso migliore del tempo. Tenete presente che la Villa dei Papiri e il Teatro antico di Ercolano sono al momento chiusi per lavori, senza una data di riapertura.
    </p>
  </div>

  <!-- From Sorrento -->
  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">Da Sorrento: la Circumvesuviana</h2>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      Sorrento è il capolinea della Circumvesuviana Napoli-Sorrento, gestita da EAV, ed entrambi i siti hanno la loro stazione su questa linea. È un treno per pendolari, non un servizio turistico: niente portabagagli, spesso in piedi nelle ore di punta e una fama di borseggi che si è guadagnata. Resta comunque il modo più rapido per arrivare.
    </p>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-6">
      <div class="bg-white p-6 rounded-[2rem] border border-slate-100 shadow-sm">
        <h4 class="font-bold text-slate-900 mb-2">Per Pompei</h4>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Si scende a Pompei Scavi-Villa dei Misteri, circa 35-45 minuti da Sorrento. Gli ingressi di Porta Marina e Piazza Esedra sono a pochi minuti a piedi. Pompei Santuario è sulla linea per Poggiomarino e serve l'ingresso di Piazza Anfiteatro: non è la fermata per chi arriva da Sorrento.</p>
      </div>
      <div class="bg-white p-6 rounded-[2rem] border border-slate-100 shadow-sm">
        <h4 class="font-bold text-slate-900 mb-2">Per Ercolano</h4>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Si scende a Ercolano Scavi, circa un'ora da Sorrento. Secondo il Parco l'ingresso di Corso Resina 187 è a 6 minuti a piedi in discesa dalla stazione, il che vuol dire 6 minuti in salita al ritorno.</p>
      </div>
      <div class="bg-white p-6 rounded-[2rem] border border-slate-100 shadow-sm">
        <h4 class="font-bold text-slate-900 mb-2">Frequenza</h4>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Il nuovo orario EAV delle linee vesuviane, in vigore dal 17 ottobre 2026, prevede un treno ogni 30 minuti da e per Sorrento. Controllate le partenze del giorno su orariotreni.eavsrl.it e verificate l'ultimo treno di rientro prima di partire.</p>
      </div>
      <div class="bg-white p-6 rounded-[2rem] border border-slate-100 shadow-sm">
        <h4 class="font-bold text-slate-900 mb-2">Biglietti</h4>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Una corsa semplice da Sorrento costa pochi euro (le guide recenti indicano circa €3,30 fino a Pompei Scavi). EAV precisa che i suoi titoli aziendali non sono toccati dall'adeguamento tariffario regionale del 1° ottobre 2026. Si comprano in stazione, oppure si avvicina una carta contactless ai tornelli Tap&amp;Go dove sono installati, usando la stessa carta in entrata e in uscita.</p>
      </div>
    </div>

    <h3 class="font-serif text-2xl font-bold text-slate-900 mb-4">E il Campania Express?</h3>
    <p class="text-slate-600 text-lg leading-relaxed">
      Il Campania Express è la versione turistica di EAV sulla stessa linea: posti riservati, aria condizionata, spazio per i bagagli e fermate solo a Ercolano, Pompei, Castellammare e nelle principali stazioni della penisola. Era ripartito il 28 marzo 2026 con otto corse al giorno, ma EAV lo ha sospeso dal <strong>1° ottobre 2026 fino a nuovo avviso</strong>. Chi ha comprato un biglietto per una data successiva può chiedere il rimborso tramite il modulo reclami di EAV, o al rivenditore se ha prenotato tramite terzi. Per un viaggio nella primavera 2027, verificate su eavsrl.it se è tornato prima di farci affidamento.
    </p>
  </div>

  <!-- From Positano -->
  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">Da Positano: bus, auto o autista</h2>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      Positano non ha ferrovia, e tra il paese e la piana vesuviana ci sono i Monti Lattari. Ogni opzione passa da ovest attorno alla penisola via Sorrento oppure scavalca le colline, e ognuna ha un prezzo da pagare.
    </p>
    <ul class="space-y-3 mb-6">
      <li class="flex items-start gap-3"><span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span><span class="text-slate-700"><strong>Bus SITA e treno.</strong> Il <a href="/it-it/guida/bus-sita/" class="text-med-blue hover:underline">bus SITA</a> da Positano a Sorrento impiega circa 50 minuti con traffico normale e ferma vicino alla stazione, poi si prende la Circumvesuviana come sopra. Calcolate due ore o più per tratta fino a Pompei, e di più per Ercolano. I biglietti del bus si comprano prima di salire, e SITA Sud ha adeguato le tariffe dal 1° ottobre 2026.</span></li>
      <li class="flex items-start gap-3"><span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span><span class="text-slate-700"><strong>Traghetto per Sorrento in stagione.</strong> Quando i traghetti costieri sono attivi, la barca da Positano a Sorrento evita la coda al bus d'estate. Sono stagionali e si fermano d'inverno: controllate la <a href="/it-it/guida/traghetti/" class="text-med-blue hover:underline">guida ai traghetti</a> per le vostre date.</span></li>
      <li class="flex items-start gap-3"><span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span><span class="text-slate-700"><strong>Bus diretto.</strong> Non abbiamo trovato conferme di un bus pubblico diretto da Positano a Pompei per l'autunno e l'inverno 2026. I pianificatori di viaggio mostrano un pullman di lunga percorrenza in alcuni giorni, ma senza un orario dell'operatore non ci costruiremmo una giornata.</span></li>
      <li class="flex items-start gap-3"><span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span><span class="text-slate-700"><strong>Auto.</strong> Pompei è sull'autostrada A3 Napoli-Salerno, uscita Pompei Scavi. Da Positano servono all'incirca da un'ora a un'ora e mezza a seconda del traffico, molto di più nei weekend estivi, più il parcheggio a pagamento vicino agli ingressi. Leggete le nostre note su <a href="/it-it/guida/parcheggi-ztl/" class="text-med-blue hover:underline">parcheggi e ZTL</a> prima di noleggiare.</span></li>
      <li class="flex items-start gap-3"><span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span><span class="text-slate-700"><strong>Autista privato o tour.</strong> La soluzione più cara e la meno faticosa. Un autista vi lascia a un sito, vi riprende all'altro e vi riporta a Positano per cena: è l'unico modo in cui entrambi i siti in un giorno da Positano diventano sostenibili. I tour di gruppo da Positano e Sorrento di solito includono la guida ed evitano il treno.</span></li>
    </ul>

    <div class="overflow-x-auto rounded-[2rem] border border-slate-100 shadow-sm">
      <table class="w-full text-xs sm:text-sm">
        <thead class="bg-slate-900 text-white">
          <tr>
            <th class="text-left p-5 font-serif font-bold text-med-gold">Tratta</th>
            <th class="text-left p-5 font-serif font-bold text-med-gold">Come</th>
            <th class="text-left p-5 font-serif font-bold text-med-gold">Tempo</th>
          </tr>
        </thead>
        <tbody class="bg-white">
          <tr class="border-b border-slate-100">
            <td class="p-5 font-bold">Sorrento-Pompei</td>
            <td class="p-5 text-slate-600">Circumvesuviana fino a Pompei Scavi-Villa dei Misteri</td>
            <td class="p-5 text-slate-600">35-45 min</td>
          </tr>
          <tr class="border-b border-slate-100">
            <td class="p-5 font-bold">Sorrento-Ercolano</td>
            <td class="p-5 text-slate-600">Circumvesuviana fino a Ercolano Scavi</td>
            <td class="p-5 text-slate-600">Circa 1 ora</td>
          </tr>
          <tr class="border-b border-slate-100">
            <td class="p-5 font-bold">Ercolano-Pompei</td>
            <td class="p-5 text-slate-600">Circumvesuviana, stessa linea</td>
            <td class="p-5 text-slate-600">20-25 min</td>
          </tr>
          <tr class="border-b border-slate-100">
            <td class="p-5 font-bold">Positano-Pompei</td>
            <td class="p-5 text-slate-600">Bus SITA fino a Sorrento, poi treno</td>
            <td class="p-5 text-slate-600">2 ore o più</td>
          </tr>
          <tr>
            <td class="p-5 font-bold">Positano-Pompei</td>
            <td class="p-5 text-slate-600">Auto o autista privato</td>
            <td class="p-5 text-slate-600">Circa 1 ora-1 ora e 30, traffico permettendo</td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>

  <!-- Tickets and hours -->
  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">Biglietti e orari 2026</h2>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      Prezzi e regole qui sotto sono quelli pubblicati dal Parco Archeologico di Pompei e dal Parco Archeologico di Ercolano al momento della stesura. Entrambi i parchi cambiano i dettagli con poco preavviso, quindi controllate le pagine ufficiali prima di andare.
    </p>

    <h3 class="font-serif text-2xl font-bold text-slate-900 mb-4">Pompei</h3>
    <ul class="space-y-3 mb-6">
      <li class="flex items-start gap-3"><span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span><span class="text-slate-700"><strong>Pompeii Express, €20.</strong> Solo la città antica. La Villa dei Misteri, fuori dalle mura, non è inclusa, ma si possono aggiungere le ville suburbane per €8 con carta a Porta Ercolano.</span></li>
      <li class="flex items-start gap-3"><span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span><span class="text-slate-700"><strong>Pompeii+, €25.</strong> Aggiunge Villa dei Misteri, Villa di Diomede, Villa Regina a Boscoreale e la navetta tra i siti.</span></li>
      <li class="flex items-start gap-3"><span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span><span class="text-slate-700"><strong>Pompeii Plus, €30.</strong> Valido tre giorni, un ingresso per sito, con in più Oplontis, Stabia e Boscoreale.</span></li>
      <li class="flex items-start gap-3"><span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span><span class="text-slate-700"><strong>Ridotto, €2.</strong> Cittadini UE tra 18 e 24 anni. I minori di 18 anni entrano gratis secondo le regole dei musei statali. Questi prezzi valgono dal 12 gennaio 2026.</span></li>
      <li class="flex items-start gap-3"><span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span><span class="text-slate-700"><strong>Biglietti nominativi.</strong> Ogni biglietto riporta il nome del visitatore, non è cedibile e non è rimborsabile salvo chiusure straordinarie. Il personale può chiedere un documento all'ingresso. C'è un limite di 20.000 ingressi al giorno e non si può uscire e rientrare.</span></li>
      <li class="flex items-start gap-3"><span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span><span class="text-slate-700"><strong>Fasce orarie in alta stagione.</strong> Dal 16 marzo al 14 ottobre l'accesso è diviso in una fascia 9:00-13:00 e una 13:00-17:30, ciascuna con la sua quota. Si prenota online sul sito ufficiale Vivaticket oppure si compra agli ingressi.</span></li>
    </ul>

    <h3 class="font-serif text-2xl font-bold text-slate-900 mb-4">Ercolano</h3>
    <ul class="space-y-3 mb-6">
      <li class="flex items-start gap-3"><span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span><span class="text-slate-700"><strong>Intero, €16.</strong> Ridotto €2 per chi ha tra 18 e 24 anni, gratuito per le categorie previste dalla legge. I minori di 12 anni devono essere accompagnati.</span></li>
      <li class="flex items-start gap-3"><span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span><span class="text-slate-700"><strong>Ercolano Card, €30.</strong> Valida 365 giorni dal primo utilizzo, conviene solo se pensate di tornare. È accettata anche la Campania Artecard, da attivare in biglietteria.</span></li>
      <li class="flex items-start gap-3"><span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span><span class="text-slate-700"><strong>Aperto tutti i giorni tranne il 25 dicembre.</strong> I biglietti si comprano online dalla pagina biglietti del Parco e in biglietteria.</span></li>
    </ul>

    <div class="overflow-x-auto rounded-[2rem] border border-slate-100 shadow-sm mb-6">
      <table class="w-full text-xs sm:text-sm">
        <thead class="bg-slate-900 text-white">
          <tr>
            <th class="text-left p-5 font-serif font-bold text-med-gold">Periodo</th>
            <th class="text-left p-5 font-serif font-bold text-med-gold">Pompei</th>
            <th class="text-left p-5 font-serif font-bold text-med-gold">Ercolano</th>
          </tr>
        </thead>
        <tbody class="bg-white">
          <tr class="border-b border-slate-100">
            <td class="p-5 font-bold">15 ottobre-15 marzo</td>
            <td class="p-5 text-slate-600">9:00-17:00, ultimo ingresso 15:30</td>
            <td class="p-5 text-slate-600">8:30-17:00, ultimo ingresso 15:30, uscita dall'area entro le 16:40</td>
          </tr>
          <tr class="border-b border-slate-100">
            <td class="p-5 font-bold">16 marzo-14 ottobre</td>
            <td class="p-5 text-slate-600">9:00-19:00, ultimo ingresso 17:30</td>
            <td class="p-5 text-slate-600">8:30-19:30, ultimo ingresso 18:00</td>
          </tr>
          <tr>
            <td class="p-5 font-bold">Chiusura</td>
            <td class="p-5 text-slate-600">25 dicembre e 1° gennaio</td>
            <td class="p-5 text-slate-600">25 dicembre</td>
          </tr>
        </tbody>
      </table>
    </div>

    <h3 class="font-serif text-2xl font-bold text-slate-900 mb-4">Le prime domeniche gratuite</h3>
    <p class="text-slate-600 text-lg leading-relaxed">
      Entrambi i parchi sono gratuiti la prima domenica di ogni mese con l'iniziativa Domenica al Museo del Ministero. A Pompei in quei giorni non si prenota online e non c'è biglietto nominativo: si entra direttamente dai tornelli, con il limite di 20.000 ingressi al giorno sempre in vigore. A Ercolano non si prenota nemmeno, e il biglietto gratuito si ritira in biglietteria il giorno stesso. Ercolano è gratuita anche il 25 aprile, il 2 giugno e il 4 novembre. Le prossime prime domeniche sono <strong>1° novembre 2026</strong> (anche festivo), <strong>6 dicembre 2026</strong> e <strong>3 gennaio 2027</strong>. Aspettatevi code lunghe e siti affollati: gratis non vuol dire comodo.
    </p>
  </div>

  <!-- One day or two -->
  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">Tutti e due in un giorno o in due giorni separati?</h2>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      Da Sorrento un giorno per entrambi è realistico. Le due stazioni distano 20-25 minuti, Ercolano richiede circa due ore e Pompei tre o quattro. Il problema è l'orario invernale: con l'ultimo ingresso alle 15:30 bisogna essere a Pompei entro il primo pomeriggio, quindi Ercolano va iniziata all'apertura. D'estate l'ordine si inverte: Pompei di prima mattina per le ore più fresche, Ercolano il pomeriggio perché l'ultimo ingresso è più tardi.
    </p>
    <p class="text-slate-600 text-lg leading-relaxed">
      Da Positano aggiungete all'incirca un'ora per tratta tra bus e attesa alla fermata, e un giorno per entrambi diventa un'uscita di dodici ore. Meglio dividerli su due giorni, oppure dormire una notte a Sorrento come nel nostro <a href="/it-it/itinerari/3-giorni/sorrento-pompei-storia/" class="text-med-blue hover:underline">itinerario di tre giorni Sorrento, Pompei e storia</a>, oppure prenotare un autista.
    </p>
  </div>

  <!-- Sample day -->
  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">Una giornata tipo da Sorrento (orario invernale)</h2>
    <div class="overflow-x-auto rounded-[2rem] border border-slate-100 shadow-sm">
      <table class="w-full text-xs sm:text-sm">
        <thead class="bg-slate-900 text-white">
          <tr>
            <th class="text-left p-5 font-serif font-bold text-med-gold">Orario</th>
            <th class="text-left p-5 font-serif font-bold text-med-gold">Programma</th>
          </tr>
        </thead>
        <tbody class="bg-white">
          <tr class="border-b border-slate-100">
            <td class="p-5 font-bold">Verso le 7:30</td>
            <td class="p-5 text-slate-600">Circumvesuviana da Sorrento in direzione Napoli, discesa a Ercolano Scavi</td>
          </tr>
          <tr class="border-b border-slate-100">
            <td class="p-5 font-bold">8:30-11:00</td>
            <td class="p-5 text-slate-600">Ercolano dall'apertura, quando il sito è ancora tranquillo</td>
          </tr>
          <tr class="border-b border-slate-100">
            <td class="p-5 font-bold">11:15-11:45</td>
            <td class="p-5 text-slate-600">Risalita a piedi alla stazione, treno per Pompei Scavi-Villa dei Misteri</td>
          </tr>
          <tr class="border-b border-slate-100">
            <td class="p-5 font-bold">11:45-12:30</td>
            <td class="p-5 text-slate-600">Pranzo veloce vicino alla stazione, prima di entrare</td>
          </tr>
          <tr class="border-b border-slate-100">
            <td class="p-5 font-bold">12:30-16:45</td>
            <td class="p-5 text-slate-600">Pompei da Porta Marina: foro, Via dell'Abbondanza, teatri, anfiteatro. Ultimo ingresso 15:30, chiusura alle 17:00</td>
          </tr>
          <tr>
            <td class="p-5 font-bold">Verso le 17:00</td>
            <td class="p-5 text-slate-600">Treno di rientro a Sorrento, circa 35-45 minuti</td>
          </tr>
        </tbody>
      </table>
    </div>
    <p class="text-slate-600 text-lg leading-relaxed mt-6">
      Gli orari sono indicativi, costruiti sugli orari di apertura pubblicati e sui tempi di percorrenza tipici: adattateli alle partenze EAV effettive del giorno. Da Positano lo stesso programma richiede un primo bus per Sorrento ben prima delle 7:00, ed è per questo che consigliamo di dividerlo.
    </p>
  </div>

  <!-- Local Tips -->
  <div class="bg-white p-8 rounded-[2rem] shadow-xl border border-slate-100">
    <div class="flex items-center gap-4 mb-6">
      <svg class="w-6 h-6 text-med-gold flex-shrink-0" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M9 18h6"/><path d="M10 22h4"/><path d="M15.09 14c.18-.98.65-1.74 1.41-2.5A4.65 4.61 0 0 0 18 8 6 6 0 0 0 6 8c0 1 .23 2.23 1.5 3.5A4.61 4.61 0 0 1 8.91 14"/></svg>
      <h3 class="text-xl font-bold">Consigli dell'esperto</h3>
    </div>
    <div class="space-y-6">
      <div>
        <p class="font-bold text-slate-900 mb-1">Rispettate il caldo</p>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Pompei non ha quasi ombra, e da giugno a settembre le strade di pietra restituiscono tutto il calore. Andate all'apertura, portate cappello e crema solare e lasciate le zone aperte alla mattina. Da ottobre ad aprile è la stagione comoda per entrambi i siti.</p>
      </div>
      <div>
        <p class="font-bold text-slate-900 mb-1">Scarpe giuste e acqua</p>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Il basolato romano è irregolare, con marciapiedi alti e solchi profondi. Scarpe da ginnastica con buona presa, non sandali. Portate una borraccia: a Ercolano non c'è ristorante all'interno, solo distributori vicino al ponte d'ingresso, e in entrambi i parchi si mangia solo nelle aree previste.</p>
      </div>
      <div>
        <p class="font-bold text-slate-900 mb-1">Viaggiate leggeri</p>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Pompei ammette borse fino a 30x30x15 cm ed Ercolano fino a 35x30x15 cm. Quelle più grandi vanno al deposito bagagli, gratuito a Ercolano. Se cambiate albergo lo stesso giorno, la Circumvesuviana con le valigie è una pessima idea: lasciatele prima.</p>
      </div>
      <div>
        <p class="font-bold text-slate-900 mb-1">Documento in tasca e prenotazione in stagione</p>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">I biglietti di Pompei riportano il vostro nome e il personale può verificarlo. Dalla primavera a metà ottobre prenotate la fascia del mattino online sul sito ufficiale Vivaticket, perché i rivenditori spesso fanno pagare di più lo stesso ingresso.</p>
      </div>
      <div>
        <p class="font-bold text-slate-900 mb-1">Controllate le fonti ufficiali il giorno prima</p>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Orari, tariffe e aperture cambiano. Le pagine da controllare sono <a href="https://pompeiisites.org/en/visiting-info/timetables-and-tickets/" class="text-med-blue hover:underline" rel="nofollow noopener" target="_blank">pompeiisites.org</a>, <a href="https://ercolano.cultura.gov.it/biglietti/" class="text-med-blue hover:underline" rel="nofollow noopener" target="_blank">ercolano.cultura.gov.it</a>, <a href="https://www.eavsrl.it/" class="text-med-blue hover:underline" rel="nofollow noopener" target="_blank">eavsrl.it</a> per il treno e <a href="https://sitasudtrasporti.it/" class="text-med-blue hover:underline" rel="nofollow noopener" target="_blank">sitasudtrasporti.it</a> per il bus. Per arrivare dall'aeroporto o da Napoli, leggete le nostre guide su <a href="/it-it/guida/come-arrivare/" class="text-med-blue hover:underline">come arrivare</a> e sulla <a href="/it-it/blog/costiera-amalfitana-in-treno/" class="text-med-blue hover:underline">Costiera Amalfitana in treno</a>.</p>
      </div>
    </div>
  </div>

