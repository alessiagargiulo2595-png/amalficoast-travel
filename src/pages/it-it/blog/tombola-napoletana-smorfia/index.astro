---
import BlogPostLayout from '../../../../layouts/BlogPostLayout.astro';

const lang = 'it-it';
const post = {
  title: 'Tombola napoletana e smorfia: cosa significano i numeri',
  subtitle: "Il gioco di Natale di ogni famiglia campana, come funziona, e perché il 47 è il morto, il 48 è il morto che parla e il 71 è uno che è meglio non incontrare",
  category: 'SCOPERTE',
  date: '19 Novembre 2026',
  readTime: '11 min',
  image: '/images/tombola-numeri-hero.webp',
  imageAlt: "Numeri in legno della tombola con il 31 e il 73 in rosso",
  path: '/it-it/blog/tombola-napoletana-smorfia/',
};

const metaTitle = 'Tombola napoletana e smorfia: cosa significano i numeri';
const metaDescription = "Come si gioca la tombola napoletana a Natale e cosa significano i numeri della smorfia: 33, 47, 48, 71, 77, 90 e altri, con la frase in napoletano e la traduzione.";

const breadcrumbs = [
  { name: 'Home', url: '/it-it/' },
  { name: 'Blog', url: '/it-it/blog/' },
  { name: 'Tombola napoletana e smorfia', url: '/it-it/blog/tombola-napoletana-smorfia/' },
];

const quickInfo = [
  { label: 'Che cos\'è', value: 'Un lotto in casa, simile al bingo' },
  { label: 'Quando', value: 'Le feste di Natale' },
  { label: 'Numeri', value: 'Da 1 a 90' },
  { label: 'Cartella', value: '15 numeri su 3 righe' },
  { label: 'Premi', value: 'Ambo, terno, quaterna, cinquina, tombola' },
  { label: 'Il cesto', value: 'Panariello' },
  { label: 'La smorfia', value: 'Un significato per ogni numero' },
  { label: 'I più citati', value: '47, 48, 71, 90' },
];

const faq = [
  {
    q: 'Che cos\'è la tombola napoletana?',
    a: "Un gioco d'azzardo familiare che si fa durante le feste di Natale. Si estraggono uno alla volta i numeri da 1 a 90 da un cesto e i giocatori li coprono sulle proprie cartelle. Si vince facendo per primi due, tre, quattro o cinque numeri sulla stessa riga, e il premio principale, la tombola, va a chi copre per primo l'intera cartella. A Napoli ogni numero viene chiamato con il suo significato nella smorfia.",
  },
  {
    q: 'Quando si gioca la tombola?',
    a: "Durante le feste di Natale: dopo il cenone della Vigilia, il giorno di Natale, la sera di Capodanno e nelle serate più tranquille in mezzo. La tradizione la lega alla sospensione natalizia del lotto, quando le famiglie cominciarono a giocarne una versione in casa.",
  },
  {
    q: 'Cosa significa il 71 nella smorfia?',
    a: "Il 71 è \"L'ommo 'e merda\", letteralmente l'uomo di merda: una persona che non vale niente, senza dignità né parola. È uno dei numeri volgari della smorfia e anche uno dei più citati, perché a tavola di solito lo si chiama guardando un parente preciso.",
  },
  {
    q: 'Che differenza c\'è tra il 47 e il 48?',
    a: "A Napoli il 47 è \"'O muorto\", il morto, e il 48 è \"'O muorto che parla\", il morto che parla, che in sogno vuol dire un messaggio da qualcuno che non c'è più. In molte altre città italiane il morto che parla è il 47, ed è per questo che il film di Totò del 1950 si intitola 47 morto che parla.",
  },
  {
    q: 'Perché la paura fa 90?',
    a: "Perché nella smorfia il 90 è \"'A paura\", la paura. Il modo di dire la paura fa novanta viene direttamente da lì e si usa in tutta Italia, anche da chi non ha mai giocato una tombola a Napoli.",
  },
  {
    q: 'Che cos\'è la tombola scostumata?',
    a: "La versione sboccata, detta anche tombola vajassa o tombola dei femminielli. Chi tiene il panariello estrae i numeri, ne annuncia i significati in napoletano e li cuce in una storia improvvisata e molto piccante. Tradizionalmente la conducevano i femminielli dei quartieri popolari, oggi si vede soprattutto come spettacolo natalizio nei teatri di Napoli.",
  },
];

const sidebarLinks = [
  { label: 'Presepi a Napoli e Sorrento', href: '/it-it/blog/presepi-san-gregorio-armeno-sorrento/' },
  { label: 'Dolci di Natale napoletani', href: '/it-it/blog/dolci-natale-struffoli-roccoco-mustaccioli/' },
  { label: 'Festa dei Morti e Halloween', href: '/it-it/blog/festa-dei-morti-halloween/' },
  { label: 'Sorrento', href: '/it-it/penisola-sorrentina/sorrento/' },
];

const authorRole = 'Guide locali · Penisola Sorrentina';

const relatedArticles = [
  {
    title: 'Presepi a Napoli e Sorrento: Guida per Dicembre',
    category: 'GUIDE',
    date: '10 Novembre 2026',
    image: '/images/presepe-natale-hero.webp',
    imageAlt: 'Presepe a Napoli',
    path: '/it-it/blog/presepi-san-gregorio-armeno-sorrento/'
  },
  {
    title: 'Dolci di Natale napoletani',
    category: 'FOOD',
    date: '14 Novembre 2026',
    image: '/images/struffoli-hero.webp',
    imageAlt: 'Struffoli, il dolce di Natale napoletano',
    path: '/it-it/blog/dolci-natale-struffoli-roccoco-mustaccioli/'
  }
];

const keyTakeaways = [
  "La tombola napoletana è un lotto in casa con i numeri da 1 a 90, giocato in famiglia durante le feste di Natale.",
  "La tradizione la fa nascere a Napoli nel 1734, quando il lotto fu sospeso per Natale e le famiglie cominciarono a estrarre i numeri in casa.",
  "Si vince con ambo, terno, quaterna e cinquina (da due a cinque numeri sulla stessa riga) e con la tombola, la cartella intera.",
  "Ogni numero si chiama con il suo significato nella smorfia, il libro dei sogni napoletano: 47 è il morto, 48 il morto che parla, 90 la paura.",
  "Alcuni significati sono volgari di proposito, il 71 su tutti, e la versione sboccata del gioco, la tombola scostumata, oggi è uno spettacolo di Natale.",
];

const numbers = [
  { n: 1, nap: "L'Italia", lit: "L'Italia", text: "Il primo numero spetta al Paese. Le smorfie più antiche gli davano altre immagini, ma oggi su ogni cartellone c'è l'Italia." },
  { n: 10, nap: "'E fasule", lit: "I fagioli", text: "Un numero umile per un cibo umile. E coerente, visto che i fagioli secchi sono proprio quello che molte famiglie usano per coprire i numeri sulle cartelle." },
  { n: 13, nap: "Sant'Antuono", lit: "Sant'Antonio", text: "Sant'Antuono è Sant'Antonio Abate, uno dei santi più amati in Campania. Qui il 13 non porta sfortuna: quel compito spetta al 17." },
  { n: 16, nap: "'O culo", lit: "Il sedere", text: "Letteralmente il sedere, e per estensione la fortuna, perché avere culo vuol dire essere fortunati. Chi vince troppo se lo sentirà ripetere." },
  { n: 17, nap: "'A disgrazzia", lit: "La disgrazia", text: "Il 17 è il numero sfortunato d'Italia. La spiegazione più diffusa è che il numero romano XVII anagrammato diventa VIXI, in latino ho vissuto, cioè sono morto." },
  { n: 22, nap: "'O pazzo", lit: "Il pazzo", text: "Si chiama guardando chi a tavola si comporta in modo più strano, cosa che una sera di Natale non è mai difficile da stabilire." },
  { n: 25, nap: "Natale", lit: "Natale", text: "La data parla da sola. Quando esce il 25 durante una tombola di Natale parte un piccolo applauso." },
  { n: 28, nap: "'E zizze", lit: "Il seno", text: "Uno dei numeri sfacciati. Le nonne lo dicono senza battere ciglio, i ragazzini ridacchiano." },
  { n: 33, nap: "L'anne 'e Cristo", lit: "Gli anni di Cristo", text: "Trentatré, l'età in cui morì Cristo. Si trova scritto anche ll'anne 'e Criste, più vicino alla pronuncia." },
  { n: 34, nap: "'A capa", lit: "La testa", text: "Semplice e anatomico: capa è la parola napoletana per testa. Sognare una testa, la propria o quella di un altro, porta qui." },
  { n: 37, nap: "'O monaco", lit: "Il monaco", text: "Una città con tanti conventi quanti Napoli non poteva non dare un numero al monaco. Sognare un frate o un monaco porta al 37." },
  { n: 43, nap: "'Onna Pereta fore 'o balcone", lit: "Donna Pereta fuori al balcone", text: "Una donna affacciata al balcone, figura eterna del vicolo napoletano che vede e commenta tutto. Pereta non è un nome che troverete all'anagrafe." },
  { n: 45, nap: "'O vino bbuono", lit: "Il vino buono", text: "Il vino buono, precisamente. Adatto a una tavola che mangia dal pomeriggio." },
  { n: 47, nap: "'O muorto", lit: "Il morto", text: "Il morto e basta. Sognare qualcuno che non c'è più porta tradizionalmente qui, a meno che il morto non parli." },
  { n: 48, nap: "'O muorto che parla", lit: "Il morto che parla", text: "Se nel sogno il morto parla, il numero è il 48, e quello che dice dovrebbe suggerire altri numeri. Fuori da Napoli molte città assegnano il morto che parla al 47, da cui il film di Totò del 1950 47 morto che parla." },
  { n: 55, nap: "'A musica", lit: "La musica", text: "La musica, in una città che esporta canzoni. Si trova scritto anche 'a museca, come si pronuncia." },
  { n: 69, nap: "Sotto e 'ncoppa", lit: "Sottosopra", text: "Letteralmente sotto e sopra. Basta guardare le due cifre e la logica non ha bisogno di altri commenti." },
  { n: 71, nap: "L'ommo 'e merda", lit: "L'uomo di merda", text: "Un uomo che non vale niente, senza dignità né parola. È il numero volgare più famoso e si chiama con gusto, spesso guardando uno zio in particolare. Si trova scritto anche l'omm 'e mmerd, come suona." },
  { n: 75, nap: "Pulecenella", lit: "Pulcinella", text: "La maschera della commedia napoletana, camicione bianco e mezza maschera nera, povero, affamato e sempre capace di cavarsela." },
  { n: 77, nap: "'E riavule", lit: "I diavoli", text: "A Napoli il 77 sono i diavoli. La lettura del 77 come gambe delle donne, che molti citano, appartiene ad altre tradizioni: un sonetto romanesco del 1883 gli dà già quel significato." },
  { n: 85, nap: "Ll'aneme d''o priatorio", lit: "Le anime del purgatorio", text: "Le anime dei defunti in attesa nel purgatorio, al centro della devozione popolare napoletana e della festa dei morti di novembre." },
  { n: 89, nap: "'A vecchia", lit: "La vecchia", text: "La vecchia, figura fissa delle fiabe e del vicolo. Di solito non la si annuncia guardando la nonna che tiene il panariello." },
  { n: 90, nap: "'A paura", lit: "La paura", text: "L'ultimo numero, e l'origine del modo di dire la paura fa novanta, che si usa quando lo spavento spinge qualcuno a fare cose che non farebbe mai." },
];
---

<BlogPostLayout
  lang={lang}
  post={post}
  metaTitle={metaTitle}
  metaDescription={metaDescription}
  breadcrumbs={breadcrumbs}
  quickInfo={quickInfo}
  faq={faq}
  sidebarLinks={sidebarLinks}
  authorRole={authorRole}
  relatedArticles={relatedArticles}
  pageKey="neapolitan-tombola-smorfia"
>

  <!-- Key Takeaways -->
  <div class="bg-slate-900 text-white p-8 rounded-[2rem]">
    <div class="flex items-center gap-3 mb-6">
      <svg class="w-5 h-5 text-med-gold flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
      <h2 class="font-serif text-lg font-bold text-med-gold uppercase tracking-[0.15em]">Punti Chiave</h2>
    </div>
    <ul class="space-y-4">
      {keyTakeaways.map((point) => (
        <li class="flex items-start gap-3">
          <span class="w-1.5 h-1.5 rounded-full bg-med-gold flex-shrink-0 mt-2"></span>
          <span class="text-white/80 text-xs sm:text-sm leading-relaxed">{point}</span>
        </li>
      ))}
    </ul>
  </div>

  <!-- Intro -->
  <div>
    <p class="text-slate-600 text-xl leading-relaxed mb-6 font-light">
      Il cenone è finito, la tavola è stata sparecchiata quanto basta per fare spazio, e qualcuno tira fuori un cestino di vimini pieno di numeretti di legno. Per le tre ore successive un'intera famiglia napoletana litigherà per dei fagioli secchi. Il gioco è la <em>tombola</em>, una versione casalinga del lotto, e a renderla napoletana è la voce di chi tiene il cesto: ogni numero esce con il suo significato nella <em>smorfia</em>, il libro dei sogni, e alcuni di quei significati non sono adatti al parroco.
    </p>
  </div>

  <!-- What it is -->
  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">Che cos'è la tombola e quando si gioca</h2>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      La tombola è un gioco di sorte con 90 numeri. Una persona li estrae uno alla volta da un cesto e li chiama ad alta voce; tutti gli altri li coprono sulle proprie cartelle. Vince chi per primo completa due, tre, quattro o cinque numeri sulla stessa riga, e il premio grosso va a chi copre l'intera cartella. Chi conosce il bingo ne conosce già quasi tutto.
    </p>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      Appartiene alle feste di Natale, che in Italia arrivano fino all'Epifania del 6 gennaio. Le serate classiche sono la Vigilia dopo il cenone di pesce, il giorno di Natale dopo pranzo e Capodanno in attesa della mezzanotte, ma in molte case il panariello esce in qualsiasi sera in cui la famiglia è riunita e nessuno ha voglia di uscire al freddo. Giocano nonni e bambini allo stesso tavolo, con poste di qualche moneta a cartella, e i soldi comunque restano in famiglia.
    </p>
    <p class="text-slate-600 text-lg leading-relaxed">
      È un'abitudine di tutta la Campania, da Napoli a <a href="/it-it/penisola-sorrentina/sorrento/" class="text-med-blue hover:underline">Sorrento</a> fino ai paesi della Costiera Amalfitana. Se passate il Natale qui e qualcuno vi chiede se volete una cartella, la risposta è sì.
    </p>
  </div>

  <!-- Origin -->
  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">Da dove viene: un re, un frate e il lotto</h2>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      Napoli giocava al lotto molto prima che esistesse la tombola. La struttura a 90 numeri risale a un gioco genovese del Cinquecento, e il lotto era arrivato a Napoli alla fine del Seicento, giocato in modo legale e illegale in parti uguali.
    </p>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      La tradizione colloca la nascita della tombola nel <strong>1734</strong>, sotto Carlo di Borbone, il futuro Carlo III di Spagna. Il re voleva il lotto sotto controllo pubblico, perché ne guadagnassero le casse dello Stato e non i banchi clandestini. Contro di lui c'era il frate domenicano <strong>Gregorio Maria Rocco</strong>, predicatore famosissimo, che definiva il gioco un diletto ingannevole e amorale che distoglieva il popolo dalla preghiera. Il compromesso, secondo il racconto, fu che il lotto si sarebbe fermato durante le feste di Natale. Non potendo giocare in pubblico, le famiglie napoletane misero i numeri in un cesto e li estrassero in casa.
    </p>
    <p class="text-slate-600 text-lg leading-relaxed">
      Prendete i dettagli come una tradizione consolidata più che come un decreto documentato: è la storia che ripetono tutte le fonti napoletane, e nessuno ne ha proposta una migliore. Il nome viene probabilmente dal tombolare dei numeri nel cesto prima di ogni estrazione.
    </p>
  </div>

  <!-- How to play -->
  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">Come si gioca</h2>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      Servono tre cose: le <strong>cartelle</strong>; il <strong>cartellone</strong>, il tabellone con tutti i 90 numeri; e il <strong>panariello</strong>, il cestino di vimini che contiene i 90 numeri di legno o di plastica. Ogni cartella ha tre righe da cinque numeri, quindici in tutto, distribuiti su nove colonne. Ognuno compra le cartelle che vuole, spesso a pochi centesimi l'una, e i soldi raccolti diventano il montepremi.
    </p>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      Chi tiene il cartellone estrae e chiama, mette ogni numero sul tabellone e gioca anche lui: il cartellone vale sei cartelle e può vincere i premi come tutti gli altri. I numeri si coprono con quello che c'è in cucina. I fagioli secchi sono il classico, i pezzetti di buccia di mandarino vengono subito dopo.
    </p>

    <div class="overflow-x-auto rounded-[2rem] border border-slate-100 shadow-sm mb-6">
      <table class="w-full text-xs sm:text-sm">
        <thead class="bg-slate-900 text-white">
          <tr>
            <th class="text-left p-5 font-serif font-bold text-med-gold">Premio</th>
            <th class="text-left p-5 font-serif font-bold text-med-gold">Che cosa serve</th>
          </tr>
        </thead>
        <tbody class="bg-white">
          <tr class="border-b border-slate-100">
            <td class="p-5 font-bold">Ambo</td>
            <td class="p-5 text-slate-600">Due numeri sulla stessa riga di una cartella.</td>
          </tr>
          <tr class="border-b border-slate-100">
            <td class="p-5 font-bold">Terno</td>
            <td class="p-5 text-slate-600">Tre numeri sulla stessa riga.</td>
          </tr>
          <tr class="border-b border-slate-100">
            <td class="p-5 font-bold">Quaterna</td>
            <td class="p-5 text-slate-600">Quattro numeri sulla stessa riga.</td>
          </tr>
          <tr class="border-b border-slate-100">
            <td class="p-5 font-bold">Cinquina</td>
            <td class="p-5 text-slate-600">Tutti e cinque i numeri di una riga.</td>
          </tr>
          <tr class="border-b border-slate-100">
            <td class="p-5 font-bold">Tombola</td>
            <td class="p-5 text-slate-600">Tutti e quindici i numeri di una cartella. Il premio principale, annunciato gridando il nome del gioco.</td>
          </tr>
          <tr>
            <td class="p-5 font-bold">Tombolino</td>
            <td class="p-5 text-slate-600">Un premio facoltativo per la seconda cartella completata, così la partita dura un po' di più.</td>
          </tr>
        </tbody>
      </table>
    </div>

    <ul class="space-y-3">
      <li class="flex items-start gap-3"><span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span><span class="text-slate-700"><strong>Dichiaratelo ad alta voce.</strong> Ogni premio va reclamato prima che esca il numero successivo, altrimenti passa a chi lo reclama dopo.</span></li>
      <li class="flex items-start gap-3"><span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span><span class="text-slate-700"><strong>I premi vanno in ordine.</strong> Prima l'ambo, poi il terno e così via fino alla tombola. Nessuno può vincere un terno prima che qualcuno abbia fatto ambo.</span></li>
      <li class="flex items-start gap-3"><span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span><span class="text-slate-700"><strong>Il cesto gira.</strong> In molte famiglie chi fa tombola prende il cartellone per il giro successivo.</span></li>
    </ul>
  </div>

  <!-- Smorfia -->
  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">La smorfia, spiegata</h2>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      La <em>smorfia</em> è il libro dei sogni napoletano: un dizionario popolare che traduce sogni e fatti quotidiani in numeri da 1 a 90, nato per sapere che cosa giocare al lotto. Sogni un gatto, giochi il 3. Un parente scomparso ti parla in sogno, giochi il 48. Il nome si collega di solito a Morfeo, il dio greco dei sogni; le origini sono incerte, con teorie che vanno dalla cabala ebraica alla numerologia pitagorica.
    </p>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      È stata tramandata a voce molto prima di essere stampata, e quando è stata messa per iscritto è stata organizzata per immagini, perché potesse usarla anche chi non sapeva leggere. Per questo il cartellone napoletano mostra ancora un disegnino in ogni casella. I significati possono cambiare da una città all'altra, e anche dentro Napoli si trovano varianti e grafie diverse della stessa frase.
    </p>
    <p class="text-slate-600 text-lg leading-relaxed">
      Alla tombola la smorfia diventa teatro. Chi chiama raramente dice solo il numero: dice il significato, a volte solo il significato, e la tavola deve indovinare il numero. Un bravo chiamatore cuce i numeri in commenti su chi è seduto a tavola. Alla fine degli anni Settanta Massimo Troisi, Lello Arena ed Enzo De Caro chiamarono il loro trio comico proprio La Smorfia.
    </p>
  </div>

  <!-- Numbers -->
  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">Cosa significano i numeri</h2>
    <p class="text-slate-600 text-lg leading-relaxed mb-8">
      Ecco i numeri più cercati e quelli che è più facile sentire a una tavola napoletana. Per ognuno: la frase in napoletano, nella grafia più diffusa, la traduzione letterale e una breve nota. Qualcuno è volgare; fa parte del gioco, e toglierlo sarebbe una bugia.
    </p>
    <div class="space-y-4">
      {numbers.map((item) => (
        <div class="bg-white p-6 rounded-[2rem] border border-slate-100 shadow-sm">
          <h3 class="font-serif text-xl font-bold text-slate-900 mb-2">Cosa significa il {item.n}?</h3>
          <p class="text-slate-900 font-semibold mb-2"><span class="text-med-gold">{item.n}</span> · <em>{item.nap}</em> · {item.lit}</p>
          <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">{item.text}</p>
        </div>
      ))}
    </div>
  </div>

  <!-- Scostumata -->
  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">La tombola scostumata</h2>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      C'è la tombola di famiglia, e poi c'è la <em>tombola scostumata</em>, detta anche <em>tombola vajassa</em> o <em>tombola dei femminielli</em>. Le regole sono le stesse. Cambia chi chiama, che annuncia ogni numero con il significato più salace possibile, rigorosamente in napoletano, e lega un'estrazione all'altra per costruire una storia improvvisata che diventa sempre più indecente man mano che il cartellone si riempie.
    </p>
    <p class="text-slate-600 text-lg leading-relaxed">
      Tradizionalmente la conducevano i <em>femminielli</em>, figura riconosciuta dei quartieri popolari di Napoli, in partite riservate a donne e bambini. Oggi sopravvive soprattutto come spettacolo di Natale: teatri e cabaret di Napoli mettono in scena tombolate scostumate ogni dicembre, spesso con la cena compresa. Non serve parlare bene il napoletano. I gesti fanno quasi tutto il lavoro.
    </p>
  </div>

  <!-- Where to buy -->
  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">Dove comprare una tombola</h2>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      A dicembre le tombole compaiono ovunque in Campania: cartolerie, negozi di giocattoli, tabaccherie e supermercati le impilano vicino alle casse. Quella da cercare è la versione napoletana, con il cartellone illustrato e l'immagine della smorfia in ogni casella; un tabellone con i soli numeri funziona, ma si perde metà del divertimento.
    </p>
    <p class="text-slate-600 text-lg leading-relaxed">
      Se siete a Napoli, le botteghe di Via San Gregorio Armeno vendono souvenir napoletani accanto ai pastori del presepe, ed è una buona strada per cercare oggetti a tema smorfia. L'assortimento cambia da negozio a negozio, quindi consideratelo un giro da curiosi più che un acquisto garantito. La nostra guida ai <a href="/it-it/blog/presepi-san-gregorio-armeno-sorrento/" class="text-med-blue hover:underline">presepi di Napoli e Sorrento</a> spiega come arrivarci dalla penisola.
    </p>
  </div>

