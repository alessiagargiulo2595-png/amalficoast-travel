---
import BlogPostLayout from '../../../../layouts/BlogPostLayout.astro';

const lang = 'it-it';
const post = {
  title: "Il Ciuccio di fuoco: San Silvestro a Sorrento e Sant'Agata",
  subtitle: "L'asino di cartapesta e fuochi che chiude l'anno vecchio nel pomeriggio del 31 dicembre, in piazza Tasso e nella piazza di Sant'Agata sui Due Golfi: cos'è, quando si accende e come inserirlo nel resto della serata",
  category: 'SCOPERTE',
  date: '28 Novembre 2026',
  readTime: '8 min',
  image: '/images/ciuccio-di-fuoco-hero.webp',
  imageAlt: "Una fiamma su sfondo nero",
  path: '/it-it/blog/ciuccio-di-fuoco-sorrento-santagata/',
};

const metaTitle = "Ciuccio di fuoco a Sorrento e Sant'Agata: il 31 dicembre";
const metaDescription = "L'asino di fuoco del 31 dicembre in piazza Tasso a Sorrento e a Sant'Agata sui Due Golfi: significato, orari recenti, come arrivare e il resto della serata.";

const breadcrumbs = [
  { name: 'Home', url: '/it-it/' },
  { name: 'Blog', url: '/it-it/blog/' },
  { name: 'Il Ciuccio di fuoco', url: '/it-it/blog/ciuccio-di-fuoco-sorrento-santagata/' },
];

const quickInfo = [
  { label: 'Data', value: '31 dicembre, tardo pomeriggio' },
  { label: 'Sorrento', value: 'Piazza Tasso, ore 18 nelle ultime edizioni' },
  { label: 'Prima', value: 'Sfilata folk dalle 17, corso Italia' },
  { label: "Sant'Agata", value: 'In piazza, dopo la canzone delle 16/16:30' },
  { label: "Organizza a Sant'Agata", value: 'Pro Loco Due Golfi' },
  { label: 'Costo', value: 'Gratis, piazze aperte' },
  { label: 'Durata', value: 'Pochi minuti di fuochi' },
  { label: 'Programma 2026', value: 'Di solito esce a fine dicembre' },
];

const faq = [
  {
    q: "Che cos'è il Ciuccio di fuoco?",
    a: "È la sagoma di un asino in cartapesta, imbottita di fuochi d'artificio, che si accende in piazza nel pomeriggio del 31 dicembre. I fuochi partono uno dopo l'altro per qualche minuto e la figura brucia. Rappresenta l'anno che finisce: si manda via il ciuccio perché l'anno nuovo cominci pulito.",
  },
  {
    q: 'A che ora si accende il Ciuccio di fuoco a Sorrento?',
    a: "Nelle ultime edizioni alle 18 in piazza Tasso, dopo una sfilata folkloristica che parte verso le 17 tra corso Italia e il centro storico. Il Comune di Sorrento pubblica il programma di San Silvestro negli ultimi giorni di dicembre: conviene verificare l'orario in quel momento.",
  },
  {
    q: "Anche a Sant'Agata sui Due Golfi c'è il Ciuccio di fuoco?",
    a: "Sì. Sant'Agata, la frazione collinare di Massa Lubrense, accende il suo in piazza al termine della Canzone de lo Capo d'Anno, il canto tradizionale di Capodanno portato per le strade nel pomeriggio. Nelle edizioni passate l'ha organizzato la Pro Loco Due Golfi, e nel 2024 l'accensione era in programma alle 16:30. Arriva prima di quello di Sorrento.",
  },
  {
    q: 'È adatto ai bambini?',
    a: "È pensato soprattutto per loro, e ogni anno le famiglie del posto portano anche i più piccoli. È rumoroso e fa scintille: meglio restare a qualche metro dalla figura, tenere i bambini ai margini della folla e valutare dei tappi o delle cuffie per i neonati.",
  },
  {
    q: 'Si possono vedere entrambi nello stesso pomeriggio?',
    a: "In teoria sì, perché Sant'Agata di solito viene prima e i due posti sono a circa 8 km. In pratica dipende dagli orari esatti di quell'anno e dal traffico, e la sera del 31 il centro di Sorrento è chiuso alle auto. Meglio sceglierne uno, a meno che entrambi gli orari non siano confermati e ci sia un margine chiaro tra i due.",
  },
  {
    q: 'Cosa succede a Sorrento dopo il Ciuccio?',
    a: "Piazza Tasso resta il centro della notte. Nel 2024 e nel 2025 c'erano musica dal vivo e dj set dalle 23 alle 3, il conto alla rovescia in piazza e i fuochi da Marina Piccola all'una. La giornata si apre in tarda mattinata con il concerto di fine anno al Teatro Tasso.",
  },
];

const sidebarLinks = [
  { label: 'Sorrento', href: '/it-it/penisola-sorrentina/sorrento/' },
  { label: 'Massa Lubrense', href: '/it-it/penisola-sorrentina/massa-lubrense/' },
  { label: 'Capodanno a Sorrento', href: '/it-it/eventi/penisola-sorrentina/capodanno-sorrento/' },
  { label: 'Bus SITA', href: '/it-it/guida/bus-sita/' },
  { label: 'Capodanno a Positano', href: '/it-it/blog/capodanno-positano-fuochi-artificio/' },
];

const authorRole = 'Guide locali · Costiera Amalfitana';

const relatedArticles = [
  {
    title: "Capodanno a Positano: i fuochi d'artificio",
    category: 'GUIDE',
    date: '24 Novembre 2026',
    image: '/images/spiaggia-grande-positano-hero.webp',
    imageAlt: 'La Spiaggia Grande di Positano',
    path: '/it-it/blog/capodanno-positano-fuochi-artificio/'
  },
  {
    title: 'Luminarie di Natale a Sorrento e Salerno',
    category: 'GUIDE',
    date: '21 Ottobre 2026',
    image: '/images/luci-artista-salerno-hero.webp',
    imageAlt: 'Luminarie di Natale a Salerno',
    path: '/it-it/blog/luminarie-natalizie-sorrento-salerno/'
  }
];


const keyTakeaways = [
  "Il Ciuccio di fuoco è un asino di cartapesta pieno di fuochi d'artificio, bruciato in piazza il 31 dicembre per salutare l'anno vecchio. A Sorrento fa parte di San Silvestro dagli anni Sessanta.",
  "Si accende nel tardo pomeriggio, non a mezzanotte. A Sorrento le ultime edizioni erano alle 18 in piazza Tasso, dopo una sfilata folkloristica dalle 17.",
  "Sant'Agata sui Due Golfi, sulle colline di Massa Lubrense, ha il suo, acceso in piazza al termine della Canzone de lo Capo d'Anno, prima di quello di Sorrento.",
  "Entrambi sono gratuiti e brevi: pochi minuti di fuochi. Arrivate presto per avere un buon punto di vista, e tenete i bambini lontani dalle scintille.",
  "I programmi 2026 non sono ancora usciti. Sorrento di solito pubblica il suo negli ultimi giorni di dicembre; Massa Lubrense pubblica il calendario natalizio a dicembre.",
];
---

<BlogPostLayout
  lang={lang}
  post={post}
  metaTitle={metaTitle}
  metaDescription={metaDescription}
  breadcrumbs={breadcrumbs}
  quickInfo={quickInfo}
  faq={faq}
  sidebarLinks={sidebarLinks}
  authorRole={authorRole}
  relatedArticles={relatedArticles}
  pageKey="ciuccio-di-fuoco"
>

  <!-- Key Takeaways -->
  <div class="bg-slate-900 text-white p-8 rounded-[2rem]">
    <div class="flex items-center gap-3 mb-6">
      <svg class="w-5 h-5 text-med-gold flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
      <h2 class="font-serif text-lg font-bold text-med-gold uppercase tracking-[0.15em]">Punti Chiave</h2>
    </div>
    <ul class="space-y-4">
      {keyTakeaways.map((point) => (
        <li class="flex items-start gap-3">
          <span class="w-1.5 h-1.5 rounded-full bg-med-gold flex-shrink-0 mt-2"></span>
          <span class="text-white/80 text-xs sm:text-sm leading-relaxed">{point}</span>
        </li>
      ))}
    </ul>
  </div>

  <!-- Intro -->
  <div>
    <p class="text-slate-600 text-xl leading-relaxed mb-6 font-light">
      In penisola sorrentina l'anno vecchio non aspetta la mezzanotte per andarsene. Nel tardo pomeriggio del 31 dicembre, quando è ancora l'ora del caffè e delle ultime compere, in piazza si dà fuoco a un asino di cartapesta carico di fuochi d'artificio, e per qualche minuto la piazza è tutta botti, scintille e fumo. Succede a <a href="/it-it/penisola-sorrentina/sorrento/" class="text-med-blue hover:underline">Sorrento</a>, in piazza Tasso, e poco prima in collina a Sant'Agata sui Due Golfi, nel comune di <a href="/it-it/penisola-sorrentina/massa-lubrense/" class="text-med-blue hover:underline">Massa Lubrense</a>. Si chiama <em>ciuccio di fuoco</em>, e per molte famiglie del posto è il vero inizio di San Silvestro.
    </p>
  </div>

  <!-- What it is -->
  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">Che cos'è il Ciuccio di fuoco</h2>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      <em>Ciuccio</em>, in napoletano, è l'asino. La sagoma è costruita in cartapesta, riempita e rivestita di fuochi e montata al centro della piazza. Accesa la miccia, le cariche partono in sequenza, con fontane di scintille, fischi e botti, e l'asino brucia fino in fondo. Il tutto dura pochi minuti. A Sorrento, nel 2024, la miccia l'ha accesa il sindaco, davanti a una piazza piena di cittadini e turisti.
    </p>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      Nessuno sa dire con precisione da dove venga l'usanza. I racconti locali la legano alla vita contadina della penisola, quando l'ultimo giorno dell'anno si bruciavano cumuli di paglia per tenere lontani la sfortuna, gli spiriti maligni e la fame. L'asino, l'animale che portava i carichi dei poderi e dei terrazzamenti, è diventato l'anno stesso: lo si brucia perché si porti via l'anno vecchio. A Sorrento il rito accompagna San Silvestro dagli anni Sessanta.
    </p>

    <blockquote class="border-l-4 border-med-gold pl-6 my-8">
      <p class="text-slate-700 text-xl font-serif italic leading-relaxed">
        "Qui il fuoco non serve a distruggere, ma a concludere."
      </p>
    </blockquote>

    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      Il ciuccio raramente arriva da solo. In entrambi i posti chiude un giro per le strade con la <strong>Canzone di Capodanno</strong> (a Sant'Agata, la <em>Canzone de lo Capo d'Anno</em>), l'antico canto di auguri che gruppi di musicisti portano per le strade tra il 30 dicembre e il primo dell'anno, augurando buon anno a chi incontrano. Si canta in dialetto, e nasce dalla stessa idea: salutare l'anno vecchio insieme, per strada.
    </p>
  </div>

  <!-- Sorrento -->
  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">Sorrento: piazza Tasso alle 18</h2>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      A Sorrento il ciuccio fa parte del programma ufficiale di San Silvestro, inserito nella rassegna invernale M'illumino d'Inverno promossa dal Comune. Lo schema del pomeriggio è lo stesso da anni:
    </p>
    <ul class="space-y-3 mb-6">
      <li class="flex items-start gap-3"><span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span><span class="text-slate-700"><strong>Dalle 17, la sfilata.</strong> Il gruppo folkloristico Piedigrotta Sorrentina percorre corso Italia e il centro storico suonando la Canzone di Capodanno.</span></li>
      <li class="flex items-start gap-3"><span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span><span class="text-slate-700"><strong>Ore 18, il ciuccio.</strong> L'asino si accende in piazza Tasso. Nei programmi del 2017 e del 2025 partecipava allo spettacolo l'attore Marco Palmieri.</span></li>
      <li class="flex items-start gap-3"><span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span><span class="text-slate-700"><strong>Gratis.</strong> Si svolge in piazza, senza biglietti né aree riservate.</span></li>
    </ul>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      Questi orari vengono dai programmi delle ultime edizioni. Il programma 2026 non è ancora stato pubblicato: Sorrento di solito lo diffonde negli ultimi giorni di dicembre, e i dettagli possono cambiare. La nostra pagina sul <a href="/it-it/eventi/penisola-sorrentina/capodanno-sorrento/" class="text-med-blue hover:underline">Capodanno a Sorrento</a> verrà aggiornata con l'annuncio ufficiale.
    </p>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      Piazza Tasso si riempie ben prima delle sei, perché la sfilata si porta dietro la sua folla. Con bambini piccoli, un posto ai margini della piazza è più comodo del centro: i fuochi si vedono lo stesso e ci si può allontanare quando il rumore si fa forte.
    </p>
  </div>

  <!-- Sant'Agata -->
  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">Sant'Agata sui Due Golfi: la versione di paese</h2>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      Sant'Agata è la frazione più grande di Massa Lubrense, sul crinale sopra Sorrento da cui si vedono da un lato il golfo di Napoli e dall'altro quello di Salerno. Il suo ciuccio è più una festa di paese rispetto a quello di Sorrento, in una piazza più piccola e con meno gente.
    </p>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      Qui l'ordine è prima il canto, poi il fuoco. Nel pomeriggio del 31 la <em>Canzone de lo Capo d'Anno</em> attraversa le strade del paese, negli ultimi anni con partenza da corso Sant'Agata all'incrocio con via Torricella, e alla fine l'asino si accende in piazza. Nelle edizioni passate l'accensione è stata curata dalla Pro Loco Due Golfi. I programmi recenti mettono il canto alle 16 o alle 16:30, e nel 2024 l'accensione era indicata alle 16:30 insieme a un brunch offerto dal Comune.
    </p>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-6">
      <div class="bg-white p-6 rounded-[2rem] border border-slate-100 shadow-sm">
        <h4 class="font-bold text-slate-900 mb-2">Prima di Sorrento</h4>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Con il canto che parte verso le quattro, il ciuccio di Sant'Agata arriva prima di quello di piazza Tasso. Se dormite in collina, è quello da vedere.</p>
      </div>
      <div class="bg-white p-6 rounded-[2rem] border border-slate-100 shadow-sm">
        <h4 class="font-bold text-slate-900 mb-2">Non sempre in calendario</h4>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Il calendario 2025/2026 di Massa Lubrense riportava il canto ma non nominava il ciuccio. In paese lo si aspetta comunque il 31, ma conviene controllare il programma di dicembre o chiedere alla Pro Loco.</p>
      </div>
    </div>
  </div>

  <!-- Getting there -->
  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">Come arrivare il 31 dicembre</h2>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      È inverno, e questo cambia le opzioni. Lungo la costa non ci sono traghetti, e gli autobus viaggiano con orari festivi che finiscono presto.
    </p>

    <div class="overflow-x-auto rounded-[2rem] border border-slate-100 shadow-sm">
      <table class="w-full text-xs sm:text-sm">
        <thead class="bg-slate-900 text-white">
          <tr>
            <th class="text-left p-5 font-serif font-bold text-med-gold">Verso</th>
            <th class="text-left p-5 font-serif font-bold text-med-gold">Come</th>
            <th class="text-left p-5 font-serif font-bold text-med-gold">Note</th>
          </tr>
        </thead>
        <tbody class="bg-white">
          <tr class="border-b border-slate-100">
            <td class="p-5 font-bold">Sorrento, da Napoli</td>
            <td class="p-5 text-slate-600">Circumvesuviana fino alla stazione di Sorrento</td>
            <td class="p-5 text-slate-600">Circa 1 ora; piazza Tasso è a cinque minuti a piedi dalla stazione</td>
          </tr>
          <tr class="border-b border-slate-100">
            <td class="p-5 font-bold">Sorrento, in auto</td>
            <td class="p-5 text-slate-600">Parcheggi fuori dal centro</td>
            <td class="p-5 text-slate-600">La sera del 31 il centro è chiuso al traffico</td>
          </tr>
          <tr class="border-b border-slate-100">
            <td class="p-5 font-bold">Sant'Agata, da Sorrento</td>
            <td class="p-5 text-slate-600">Autobus dalla zona della stazione, oppure auto</td>
            <td class="p-5 text-slate-600">Circa 8 km, una ventina di minuti di strada</td>
          </tr>
          <tr>
            <td class="p-5 font-bold">Entrambi, dalla Costiera</td>
            <td class="p-5 text-slate-600">Bus SITA lungo la statale</td>
            <td class="p-5 text-slate-600">Servizio invernale ridotto, pianificate prima il ritorno</td>
          </tr>
        </tbody>
      </table>
    </div>

    <p class="text-slate-600 text-lg leading-relaxed mt-6">
      I bus SITA collegano Sorrento con le frazioni di Massa Lubrense, Sant'Agata compresa, ed EAV gestisce le linee locali della penisola. Il 31 le corse si diradano e le ultime partono presto, quindi controllate il ritorno prima di uscire: la nostra <a href="/it-it/guida/bus-sita/" class="text-med-blue hover:underline">guida ai bus SITA</a> spiega dove trovare gli orari e comprare i biglietti. Da Positano o Amalfi, d'inverno, il bus è l'unica opzione pubblica e non c'è modo di rientrare a notte fonda.
    </p>
  </div>

  <!-- Combining -->
  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">Come costruirci intorno il resto della serata</h2>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      Siccome si accende quando non è ancora notte fonda, il ciuccio si inserisce bene in un programma di San Silvestro senza fargli concorrenza. A Sorrento, nelle ultime edizioni, la giornata è andata così:
    </p>
    <ul class="space-y-3 mb-6">
      <li class="flex items-start gap-3"><span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span><span class="text-slate-700"><strong>Ore 11:30, Teatro Tasso.</strong> Il concerto di fine anno della Società dei Concerti di Sorrento apre la giornata.</span></li>
      <li class="flex items-start gap-3"><span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span><span class="text-slate-700"><strong>Dalle 17 alle 18, sfilata e ciuccio.</strong> Il canto per le strade, poi l'asino in piazza Tasso.</span></li>
      <li class="flex items-start gap-3"><span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span><span class="text-slate-700"><strong>Cena.</strong> I ristoranti aperti il 31 lavorano di solito con un menu fisso di San Silvestro; prenotate prima di partire.</span></li>
      <li class="flex items-start gap-3"><span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span><span class="text-slate-700"><strong>Dalle 23 alle 3, piazza Tasso.</strong> Musica dal vivo e dj set, con il conto alla rovescia in piazza.</span></li>
      <li class="flex items-start gap-3"><span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span><span class="text-slate-700"><strong>All'una, i fuochi.</strong> Nel 2024 e nel 2025 sono partiti da una piattaforma al largo di Marina Piccola, un'ora dopo la mezzanotte.</span></li>
    </ul>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      Se alloggiate a Sant'Agata o altrove a Massa Lubrense, il programma più naturale è il ciuccio in paese nel pomeriggio e la cena in collina, poi decidere se scendere a Sorrento per la mezzanotte, il che vuol dire auto, taxi o una lunga camminata al ritorno. Se preferite i fuochi a mezzanotte su una spiaggia, il <a href="/it-it/blog/capodanno-positano-fuochi-artificio/" class="text-med-blue hover:underline">Capodanno a Positano</a> è l'altra opzione su questo tratto di costa, ma è un'altra serata: non c'è un modo pratico di fare Positano e Sorrento nella stessa notte.
    </p>
  </div>

  <!-- Local Tips -->
  <div class="bg-white p-8 rounded-[2rem] shadow-xl border border-slate-100">
    <div class="flex items-center gap-4 mb-6">
      <svg class="w-6 h-6 text-med-gold flex-shrink-0" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M9 18h6"/><path d="M10 22h4"/><path d="M15.09 14c.18-.98.65-1.74 1.41-2.5A4.65 4.61 0 0 0 18 8 6 6 0 0 0 6 8c0 1 .23 2.23 1.5 3.5A4.61 4.61 0 0 1 8.91 14"/></svg>
      <h3 class="text-xl font-bold">Consigli dell'esperto</h3>
    </div>
    <div class="space-y-6">
      <div>
        <p class="font-bold text-slate-900 mb-1">Arrivate mezz'ora prima</p>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Lo spettacolo è breve e la folla arriva con la sfilata. Essere in piazza Tasso entro le 17:30, o nella piazza di Sant'Agata prima che finisca il canto, fa la differenza tra vedere l'asino e vedere le teste degli altri.</p>
      </div>
      <div>
        <p class="font-bold text-slate-900 mb-1">Rispettate le distanze</p>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Sono fuochi d'artificio in mezzo a una piazza. Restate a qualche metro dalla figura, non lasciate correre i bambini verso l'asino e portate una protezione per le orecchie dei neonati.</p>
      </div>
      <div>
        <p class="font-bold text-slate-900 mb-1">Niente vetro in piazza</p>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Negli ultimi anni, a San Silvestro, Sorrento ha vietato le bevande in vetro nel centro, e i controlli sono rigorosi. Portate un bicchiere di plastica o brindate al bar.</p>
      </div>
      <div>
        <p class="font-bold text-slate-900 mb-1">Controllate il programma nell'ultima settimana di dicembre</p>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Gli orari qui vengono dalle ultime edizioni. Il Comune di Sorrento e l'ufficio turistico di Massa Lubrense pubblicano quelli definitivi solo a dicembre, e un pomeriggio di pioggia può spostare tutto.</p>
      </div>
    </div>
  </div>

</BlogPostLayout>
