---
import BlogPostLayout from '../../../../layouts/BlogPostLayout.astro';

const lang = 'it-it';
const post = {
  title: 'Spaghetti alla Nerano',
  subtitle: 'La pasta con le zucchine fritte nata in una baia minuscola nel 1952, e dove mangiare l\'originale oggi',
  category: 'FOOD',
  date: '17 Agosto 2026',
  readTime: '8 min',
  image: '/images/nerano-hero.webp',
  imageAlt: 'Spaghetti alla Nerano, la pasta con le zucchine fritte di Marina del Cantone',
  path: '/it-it/blog/spaghetti-alla-nerano/',
};

const metaTitle = 'Spaghetti alla Nerano: Dove Mangiare l\'Originale | Guida 2026';
const metaDescription = 'Il piatto nasce a Nerano nel 1952 al Ristorante Maria Grazia. Dove mangiarlo a Marina del Cantone, come arrivare in baia da Sorrento in bus SITA o in barca, e cosa lo distingue da una normale pasta con le zucchine.';

const breadcrumbs = [
  { name: 'Home', url: '/it-it/' },
  { name: 'Blog', url: '/it-it/blog/' },
  { name: 'Spaghetti alla Nerano', url: '/it-it/blog/spaghetti-alla-nerano/' },
];

const quickInfo = [
  { label: 'Piatto', value: 'Spaghetti con zucchine fritte e formaggio' },
  { label: 'Nato a', value: 'Nerano, Marina del Cantone (1952)' },
  { label: 'Creato da', value: 'Donna Rosa, Ristorante Maria Grazia' },
  { label: 'Dove', value: 'Massa Lubrense, Penisola Sorrentina' },
  { label: 'Formaggio', value: 'Provolone del Monaco DOP o caciotta locale' },
  { label: 'Da Sorrento', value: 'Circa 50 min in bus SITA' },
  { label: 'Prenotazione', value: 'Indispensabile a luglio e agosto' },
  { label: 'Stagione migliore', value: 'Da giugno a settembre, per le zucchine' },
];

const faq = [
  {
    q: 'Dove sono nati gli Spaghetti alla Nerano?',
    a: 'Al Ristorante Maria Grazia di Marina del Cantone, la piccola baia sotto il borgo di Nerano, nel comune di Massa Lubrense. Il piatto nasce nel 1952 per mano di Donna Rosa, e il ristorante, aperto nel 1901, è ancora gestito dai suoi discendenti.',
  },
  {
    q: 'Dove conviene mangiarli a Nerano?',
    a: 'Maria Grazia è il locale originario, il motivo per cui il piatto porta il nome del borgo. Lo Scoglio da Tommaso, affacciato sull\'acqua nella stessa baia, è l\'altro indirizzo storico, diventato celebre all\'estero dopo le riprese di Stanley Tucci. Distano pochi minuti a piedi.',
  },
  {
    q: 'Come si arriva a Nerano da Sorrento?',
    a: 'In bus SITA dalla stazione di Sorrento, circa 50 minuti, a volte con cambio a Sant\'Agata sui Due Golfi. In auto sono circa 30 minuti, ma il parcheggio a Marina del Cantone è limitato e a pagamento in estate. Molti arrivano via mare da Sorrento, Positano o Capri.',
  },
  {
    q: 'Che formaggio si usa negli Spaghetti alla Nerano?',
    a: 'La scelta tradizionale è il Provolone del Monaco DOP, il formaggio vaccino stagionato della Penisola Sorrentina, a volte unito o sostituito da una caciotta locale. È il formaggio a dare corpo al condimento: nella versione originale non c\'è panna.',
  },
  {
    q: 'Perché sono diversi da una normale pasta con le zucchine?',
    a: 'Per due motivi. Le zucchine si friggono a parte e si lasciano riposare, così si ammorbidiscono e concentrano invece di stufarsi. Poi la crema si costruisce mantecando fuori dal fuoco il formaggio grattugiato con l\'acqua di cottura, che rende il condimento avvolgente e non acquoso.',
  },
  {
    q: 'Serve prenotare?',
    a: 'Sì, in alta stagione. Marina del Cantone è una baia piccolissima con pochi ristoranti e riceve arrivi via terra e via mare insieme. Per luglio e agosto conviene prenotare con largo anticipo, soprattutto per il pranzo.',
  },
];

const sidebarLinks = [
  { label: 'Marina del Cantone', href: '/it-it/spiagge/penisola-sorrentina/marina-del-cantone/' },
  { label: 'Massa Lubrense', href: '/it-it/penisola-sorrentina/massa-lubrense/' },
  { label: 'Baia di Recommone', href: '/it-it/blog/baia-recommone/' },
  { label: 'Bus SITA', href: '/it-it/guida/bus-sita/' },
  { label: 'Punta Campanella', href: '/it-it/blog/punta-campanella/' },
];

const authorRole = 'Guide locali · Costiera Amalfitana';

const relatedArticles = [
  {
    title: 'Le Alici di Cetara: L\'Oro d\'Argento della Costiera Amalfitana',
    category: 'FOOD',
    date: '4 Aprile 2026',
    image: '/images/alici-cetara-hero.webp',
    imageAlt: 'Le alici di Cetara e la Colatura DOP - Costiera Amalfitana',
    path: '/it-it/blog/alici-di-cetara/'
  },
  {
    title: 'Gli Scialatielli: La Pasta Simbolo della Costiera Amalfitana',
    category: 'FOOD',
    date: '27 Maggio 2026',
    image: '/images/scialatielli-hero.webp',
    imageAlt: 'Gli scialatielli, la pasta fresca della Costiera Amalfitana',
    path: '/it-it/blog/scialatielli/'
  }
];

const keyTakeaways = [
  'Gli Spaghetti alla Nerano nascono nel 1952 da Donna Rosa al Ristorante Maria Grazia, nella baia di Marina del Cantone sotto il borgo di Nerano.',
  'Il borgo appartiene a Massa Lubrense, in Penisola Sorrentina, e non alla Costiera Amalfitana vera e propria: per questo tanti visitatori non ci arrivano mai.',
  'Il condimento si regge su zucchine fritte e formaggio grattugiato mantecato con l\'acqua di cottura. Nella ricetta originale la panna non esiste.',
  'Maria Grazia è il locale dove il piatto è nato; Lo Scoglio da Tommaso, nella stessa baia, è l\'indirizzo reso celebre all\'estero da Stanley Tucci.',
  'Da Sorrento servono circa 50 minuti di bus SITA, e a pranzo in luglio e agosto la prenotazione è indispensabile.',
];
---

<BlogPostLayout
  lang={lang}
  post={post}
  metaTitle={metaTitle}
  metaDescription={metaDescription}
  breadcrumbs={breadcrumbs}
  quickInfo={quickInfo}
  faq={faq}
  sidebarLinks={sidebarLinks}
  authorRole={authorRole}
  relatedArticles={relatedArticles}
  pageKey="spaghetti-alla-nerano"
>

  <!-- Key Takeaways -->
  <div class="bg-slate-900 text-white p-8 rounded-[2rem]">
    <div class="flex items-center gap-3 mb-6">
      <svg class="w-5 h-5 text-med-gold flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
      <h2 class="font-serif text-lg font-bold text-med-gold uppercase tracking-[0.15em]">Punti Chiave</h2>
    </div>
    <ul class="space-y-4">
      {keyTakeaways.map((point) => (
        <li class="flex items-start gap-3">
          <span class="w-1.5 h-1.5 rounded-full bg-med-gold flex-shrink-0 mt-2"></span>
          <span class="text-white/80 text-xs sm:text-sm leading-relaxed">{point}</span>
        </li>
      ))}
    </ul>
  </div>

  <!-- Intro -->
  <div>
    <p class="text-slate-600 text-xl leading-relaxed mb-6 font-light">
      Quasi tutti i piatti italiani famosi portano il nome di una città. Questo porta il nome di una frazione di poche centinaia di abitanti, nascosta sulla punta estrema della Penisola Sorrentina. Nerano sta sopra una baia che si chiama <a href="/it-it/spiagge/penisola-sorrentina/marina-del-cantone/" class="text-med-blue hover:underline">Marina del Cantone</a>, di fronte a Capri, e la pasta che ne porta il nome è stata inventata lì, in una sola cucina, una sera del 1952. Oggi la serve quasi ogni ristorante tra Napoli e Salerno. Un solo posto può rivendicare l'originale.
    </p>
  </div>

  <!-- Origin -->
  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">Nerano, 1952: come è nato il piatto</h2>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      La cucina era quella del <strong>Ristorante Maria Grazia</strong>, attività di famiglia aperta nel 1901 sulla spiaggia di Marina del Cantone. A cucinare era Donna Rosa, e il piatto che mise insieme nel 1952 usava quello che l'orto e il caseificio del posto potevano dare: zucchine, formaggio, basilico, olio. Niente che dovesse arrivare da fuori, il che su una strada così ripida contava parecchio.
    </p>
    <p class="text-slate-600 text-lg leading-relaxed mb-8">
      Il ristorante è ancora gestito dai suoi discendenti, e la famiglia ha sempre tenuto per sé la mantecatura finale. Quella reticenza è parte della leggenda, ma il motivo vero per cui il piatto ha viaggiato è più semplice: la baia è diventata un punto di ormeggio per le barche in arrivo da Capri e da <a href="/it-it/costiera-amalfitana/positano/" class="text-med-blue hover:underline">Positano</a>, e chi scendeva da quelle barche si portava il nome a casa.
    </p>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div class="bg-white p-6 rounded-[2rem] border border-slate-100 shadow-sm">
        <h4 class="font-bold text-slate-900 mb-2">Un borgo, non un paese</h4>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Nerano è una frazione di <a href="/it-it/penisola-sorrentina/massa-lubrense/" class="text-med-blue hover:underline">Massa Lubrense</a>, che di frazioni ne conta diciassette sparse sul promontorio. Non ha un centro nel senso comune del termine: c'è una piazza e una strada che scende al mare.</p>
      </div>
      <div class="bg-white p-6 rounded-[2rem] border border-slate-100 shadow-sm">
        <h4 class="font-bold text-slate-900 mb-2">Non è Costiera Amalfitana</h4>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">La baia guarda il Golfo di Salerno ma appartiene amministrativamente alla Penisola Sorrentina. Chi cerca solo lungo la strada amalfitana non ci arriva mai, ed è esattamente il motivo per cui è rimasta piccola.</p>
      </div>
    </div>
  </div>

  <!-- Where to eat -->
  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">Dove mangiare gli Spaghetti alla Nerano a Nerano</h2>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      I due indirizzi che contano stanno sullo stesso breve tratto di spiaggia, a pochi minuti a piedi l'uno dall'altro. Sono esperienze molto diverse, e la scelta dipende davvero da cosa cercate.
    </p>

    <div class="overflow-hidden rounded-[2rem] border border-slate-100 shadow-sm">
      <table class="w-full text-xs sm:text-xs sm:text-sm">
        <thead class="bg-slate-900 text-white">
          <tr>
            <th class="text-left p-5 font-serif font-bold text-med-gold">Ristorante</th>
            <th class="text-left p-5 font-serif font-bold text-med-gold">Cosa sapere</th>
          </tr>
        </thead>
        <tbody class="bg-white">
          <tr class="border-b border-slate-100">
            <td class="p-5 font-bold">Maria Grazia</td>
            <td class="p-5 text-slate-600">Il locale dove tutto è cominciato. Aperto dal 1901, ancora in famiglia, e il motivo per cui il piatto si chiama alla Nerano. Ci si va per la versione da cui discende la ricetta, più che per la vista.</td>
          </tr>
          <tr class="border-b border-slate-100">
            <td class="p-5 font-bold">Lo Scoglio da Tommaso</td>
            <td class="p-5 text-slate-600">Costruito sull'acqua con il suo pontile, con i prodotti dell'orto di famiglia. Ripreso da Stanley Tucci per "Searching for Italy", motivo per cui d'estate è pieno con mesi di anticipo.</td>
          </tr>
          <tr>
            <td class="p-5 font-bold">Tutto il resto</td>
            <td class="p-5 text-slate-600">Il piatto è sui menu di entrambe le coste. Consideratele interpretazioni. Se una cucina lo serve con la panna, non sta seguendo il metodo di Nerano.</td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>

  <!-- Getting there -->
  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">Come arrivare a Nerano e a Marina del Cantone</h2>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      La baia dista circa 30 minuti da Sorrento su strada, ma la strada è stretta e l'ultimo tratto scende ripido sul mare. Meglio scegliere il mezzo prima di partire che sul momento.
    </p>

    <div class="bg-white p-8 rounded-[2rem] border border-slate-100 shadow-sm">
      <h3 class="font-serif text-xl font-bold text-slate-900 mb-5">Tre modi per scendere in baia</h3>
      <div class="space-y-3">
        <div class="flex items-start gap-3">
          <div class="w-6 h-6 rounded-full bg-med-gold/15 flex-shrink-0 flex items-center justify-center text-med-gold font-bold text-xs">1</div>
          <p class="text-slate-600 text-xs sm:text-sm leading-relaxed"><strong>In <a href="/it-it/guida/bus-sita/" class="text-med-blue hover:underline">bus SITA</a></strong> dalla stazione di Sorrento, circa 50 minuti. Alcune corse richiedono il cambio a Sant'Agata sui Due Golfi, quindi controllate l'orario della corsa diretta per Nerano.</p>
        </div>
        <div class="flex items-start gap-3">
          <div class="w-6 h-6 rounded-full bg-med-gold/15 flex-shrink-0 flex items-center justify-center text-med-gold font-bold text-xs">2</div>
          <p class="text-slate-600 text-xs sm:text-sm leading-relaxed"><strong>In auto</strong>, circa 30 minuti da Sorrento passando per Massa Lubrense. Il parcheggio a Marina del Cantone è limitato e a pagamento, e ad agosto si riempie entro metà mattina.</p>
        </div>
        <div class="flex items-start gap-3">
          <div class="w-6 h-6 rounded-full bg-med-gold/15 flex-shrink-0 flex items-center justify-center text-med-gold font-bold text-xs">3</div>
          <p class="text-slate-600 text-xs sm:text-sm leading-relaxed"><strong>Via mare</strong> da Sorrento, Positano o Capri. È il modo in cui arriva la maggior parte delle persone d'estate, e diversi ristoranti hanno un ormeggio proprio.</p>
        </div>
      </div>
    </div>
  </div>

  <!-- The technique -->
  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">Cosa li distingue da una normale pasta con le zucchine</h2>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      La lista degli ingredienti è quasi imbarazzante per brevità, quindi tutto si gioca sul metodo. Due passaggi separano il piatto vero da una pasta con le zucchine qualunque.
    </p>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      Primo: le zucchine si <strong>friggono a parte e si lasciano riposare</strong>, spesso per ore. Cedono e si addolciscono invece di stufarsi in padella, e l'olio che rilasciano porta il loro sapore dentro al condimento. Secondo: la crema si chiude fuori dal fuoco, mantecando il formaggio grattugiato, tradizionalmente <strong>Provolone del Monaco DOP</strong> della penisola o una caciotta locale, con l'acqua di cottura ricca di amido, finché avvolge invece di depositarsi sul fondo.
    </p>

    <blockquote class="border-l-4 border-med-gold pl-6 my-8">
      <p class="text-slate-700 text-xl font-serif italic leading-relaxed">
        "Negli Spaghetti alla Nerano la panna non c'è. Quella che sembra panna è formaggio, acqua e pazienza."
      </p>
    </blockquote>
  </div>

  <!-- Local Tips -->
  <div class="bg-white p-8 rounded-[2rem] shadow-xl border border-slate-100">
    <div class="flex items-center gap-4 mb-6">
      <svg class="w-6 h-6 text-med-gold flex-shrink-0" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M9 18h6"/><path d="M10 22h4"/><path d="M15.09 14c.18-.98.65-1.74 1.41-2.5A4.65 4.65 0 0 0 18 8 6 6 0 0 0 6 8c0 1 .23 2.23 1.5 3.5A4.61 4.61 0 0 1 8.91 14"/></svg>
      <h3 class="text-xl font-bold">Consigli dell'esperto</h3>
    </div>
    <div class="space-y-6">
      <div>
        <p class="font-bold text-slate-900 mb-1">Prenotate prima di partire, non all'arrivo</p>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Marina del Cantone ha pochissimi ristoranti e riceve arrivi via terra e via mare nello stesso momento. A luglio e agosto i tavoli a pranzo nei due indirizzi storici si esauriscono con mesi di anticipo.</p>
      </div>
      <div>
        <p class="font-bold text-slate-900 mb-1">Andateci nella stagione delle zucchine</p>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Il piatto dipende interamente dalla qualità della verdura, quindi dà il meglio da giugno a settembre. Fuori stagione ve lo serviranno lo stesso, ma con prodotto che non è cresciuto sul promontorio.</p>
      </div>
      <div>
        <p class="font-bold text-slate-900 mb-1">Fate della baia una giornata intera</p>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Il pranzo si abbina naturalmente a un bagno. <a href="/it-it/blog/baia-recommone/" class="text-med-blue hover:underline">Baia di Recommone</a> è la cala successiva, e il sentiero per la Baia di Ieranto parte dalla piazza di Nerano e corre verso <a href="/it-it/blog/punta-campanella/" class="text-med-blue hover:underline">Punta Campanella</a> con Capri davanti per tutto il tragitto.</p>
      </div>
    </div>
  </div>

</BlogPostLayout>
