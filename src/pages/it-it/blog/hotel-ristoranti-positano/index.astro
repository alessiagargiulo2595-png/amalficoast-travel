---
import BlogPostLayout from '../../../../layouts/BlogPostLayout.astro';

const lang = 'it-it';
const post = {
  title: 'Hotel e Ristoranti di Positano: Otto Indirizzi da Conoscere',
  subtitle: 'Villa Rosa, Posa Posa, Villa Franca, Villa Santa Chiara, Buca di Bacco, Don Giovanni, Casa e Bottega e Lucibello, e a che altezza si trova ciascuno',
  category: 'GUIDE',
  date: '31 Agosto 2026',
  readTime: '11 min',
  image: '/images/positano-spiaggia-grande-colombo-hero.webp',
  imageAlt: "La Spiaggia Grande di Positano vista da Via Cristoforo Colombo, con le terrazze degli hotel sopra la spiaggia",
  path: '/it-it/blog/hotel-ristoranti-positano/',
};

const metaTitle = 'Hotel e Ristoranti Positano: 8 Indirizzi | Guida 2026';
const metaDescription = 'Villa Rosa, Posa Posa, Villa Franca, Villa Santa Chiara e Buca di Bacco, più Don Giovanni, Casa e Bottega e Lucibello. Vie esatte, a che altezza stanno e quanti gradini li separano dalla spiaggia.';

const breadcrumbs = [
  { name: 'Home', url: '/it-it/' },
  { name: 'Blog', url: '/it-it/blog/' },
  { name: 'Hotel e Ristoranti di Positano', url: '/it-it/blog/hotel-ristoranti-positano/' },
];

const quickInfo = [
  { label: 'Paese', value: 'Positano, Costiera Amalfitana' },
  { label: 'Conformazione', value: 'Verticale: tutto sta sopra o sotto di te' },
  { label: 'Vie principali', value: 'Viale Pasitea e Via Cristoforo Colombo' },
  { label: 'In basso', value: 'Spiaggia Grande, si raggiunge solo a piedi' },
  { label: 'Zona esterna', value: 'Laurito, a est del paese' },
  { label: 'Auto', value: 'Nessun accesso veicolare alla spiaggia' },
  { label: 'Stagione', value: 'Quasi tutti aperti da aprile a ottobre' },
  { label: 'Prenotazioni', value: 'Hotel con mesi di anticipo, cena con giorni' },
];

const faq = [
  {
    q: 'Dove si trova l\'Hotel Villa Rosa a Positano?',
    a: 'In Via Cristoforo Colombo 127, sulla strada di accesso orientale al paese. È una villa di circa 150 anni costruita nella roccia, con terrazze private sul mare e pavimenti in ceramica dipinta a mano, a pochi minuti a piedi dal centro.',
  },
  {
    q: 'Quale di questi hotel è più vicino alla spiaggia?',
    a: 'Buca di Bacco, in Via Rampa Teglia 4. Si trova direttamente sulla Spiaggia Grande, quindi si esce dall\'hotel sul lungomare senza affrontare nessuna scalinata. Tutti gli altri indirizzi di questa lista comportano gradini, in alcuni casi diverse centinaia.',
  },
  {
    q: 'Che cos\'è Casa e Bottega a Positano?',
    a: 'Un piccolo bistrot con negozio di design in Viale Pasitea 100, aperto dal 2012 e gestito dalla stessa famiglia. Serve solo colazione e pranzo, con succhi freschi, bowl, uova e insalate, e non accetta prenotazioni. Nello stesso spazio c\'è una sezione dedicata a ceramiche e oggetti per la casa.',
  },
  {
    q: 'Lucibello è un noleggio barche?',
    a: 'Sì. Lucibello opera dalla Spiaggia Grande, sotto il grande gazebo bianco davanti alla scalinata che scende dal centro del paese. È nato quando Salvatore Lucibello, pescatore positanese, comprò due barche a remi negli anni Quaranta, ed è ancora gestito dai figli e dai nipoti.',
  },
  {
    q: 'Qual è l\'hotel più in alto a Positano?',
    a: 'Fra questi, l\'Hotel Villa Franca in Viale Pasitea 318, vicino al punto in cui la strada costiera entra in paese. La sua piscina sul tetto è fra le più alte di Positano, ed è il motivo per cui lo si prenota, ma significa anche che la spiaggia è molto lontana verso il basso.',
  },
  {
    q: 'Serve l\'auto per raggiungere questi indirizzi?',
    a: 'No, e nella maggior parte dei casi l\'auto è un problema. Positano ha pochissimi parcheggi, le tariffe in stagione sono alte e la parte bassa del paese è chiusa al traffico. Arrivare in bus SITA o in traghetto è più semplice. Se proprio si guida, conviene leggere prima le regole su parcheggi e ZTL.',
  },
];

const sidebarLinks = [
  { label: 'Positano', href: '/it-it/costiera-amalfitana/positano/' },
  { label: 'Spiaggia Grande', href: '/it-it/spiagge/costiera-amalfitana/spiaggia-grande-positano/' },
  { label: 'Bus SITA', href: '/it-it/guida/bus-sita/' },
  { label: 'Traghetti', href: '/it-it/guida/traghetti/' },
  { label: 'Parcheggi e ZTL', href: '/it-it/guida/parcheggi-ztl/' },
];

const authorRole = 'Guide locali · Costiera Amalfitana';

const relatedArticles = [
  {
    title: 'Positano o Amalfi: Due Icone, Una Scelta',
    category: 'GUIDE',
    date: '11 Giugno 2026',
    image: '/images/positano-vs-amalfi-hero.webp',
    imageAlt: 'Positano e Amalfi a confronto',
    path: '/it-it/blog/positano-vs-amalfi/'
  },
  {
    title: 'Sorrento o Positano: Dove Alloggiare in Costiera Amalfitana',
    category: 'GUIDE',
    date: '15 Giugno 2026',
    image: '/images/sorrento-vs-positano-hero.webp',
    imageAlt: 'Sorrento e Positano a confronto',
    path: '/it-it/blog/sorrento-vs-positano/'
  }
];

const imageCredit = {
  author: 'Rudolfo Kithera / Wikimedia Commons',
  sourceUrl: 'https://commons.wikimedia.org/wiki/File:Blick_auf_die_Spiaggia_Grande_(Positano)_von_der_Via_Cristoforo_Colombo.jpg',
  license: 'CC0',
  licenseUrl: 'https://creativecommons.org/publicdomain/zero/1.0/',
};

const keyTakeaways = [
  'A Positano il nome della via conta più delle stelle, perché il paese è verticale e ogni indirizzo sta a un\'altezza diversa sopra la spiaggia.',
  'Buca di Bacco è l\'unico di questi indirizzi davvero sulla Spiaggia Grande, ed è la scelta giusta per chi non vuole avere a che fare con le scalinate.',
  'Viale Pasitea è la strada alta: Casa e Bottega al 100, Posa Posa al 165 e Villa Franca al 318 sono progressivamente più lontani dal mare.',
  'Via Cristoforo Colombo è l\'accesso da est: Villa Rosa al 127 e il Ristorante Don Giovanni al 141 sono quasi vicini di casa.',
  'Villa Santa Chiara sta a Laurito, fuori dal paese vero e proprio: in cambio della quiete si rinuncia alla passeggiata in centro.',
];
---

<BlogPostLayout
  lang={lang}
  post={post}
  metaTitle={metaTitle}
  metaDescription={metaDescription}
  breadcrumbs={breadcrumbs}
  quickInfo={quickInfo}
  faq={faq}
  sidebarLinks={sidebarLinks}
  authorRole={authorRole}
  relatedArticles={relatedArticles}
  imageCredit={imageCredit}
  pageKey="positano-hotels-restaurants"
>

  <!-- Key Takeaways -->
  <div class="bg-slate-900 text-white p-8 rounded-[2rem]">
    <div class="flex items-center gap-3 mb-6">
      <svg class="w-5 h-5 text-med-gold flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
      <h2 class="font-serif text-lg font-bold text-med-gold uppercase tracking-[0.15em]">Punti Chiave</h2>
    </div>
    <ul class="space-y-4">
      {keyTakeaways.map((point) => (
        <li class="flex items-start gap-3">
          <span class="w-1.5 h-1.5 rounded-full bg-med-gold flex-shrink-0 mt-2"></span>
          <span class="text-white/80 text-xs sm:text-sm leading-relaxed">{point}</span>
        </li>
      ))}
    </ul>
  </div>

  <!-- Intro -->
  <div>
    <p class="text-slate-600 text-xl leading-relaxed mb-6 font-light">
      Prenotare una camera a <a href="/it-it/costiera-amalfitana/positano/" class="text-med-blue hover:underline">Positano</a> non somiglia a prenotare una camera altrove, perché qui non esiste terreno pianeggiante. Il paese è una conca di case impilate su una parete di roccia, e l'informazione più utile su qualunque hotel, ristorante o bar non è la valutazione ma il numero civico. Quel numero dice a che altezza sul mare ci si trova, quanti gradini separano dalla cena e se un taxi può avvicinarsi ai bagagli. Questi otto indirizzi tornano di continuo nelle ricerche, e stanno su tutti i livelli della collina.
    </p>
  </div>

  <!-- Geografia -->
  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">Prima di Tutto: Com'è Fatta Positano</h2>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      Un indirizzo a Positano può stare solo in tre o quattro posti, e capire di quale si tratta risponde in anticipo a quasi tutte le domande pratiche.
    </p>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div class="bg-white p-6 rounded-[2rem] border border-slate-100 shadow-sm">
        <h4 class="font-bold text-slate-900 mb-2">Viale Pasitea</h4>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Il grande anello che porta la strada attraverso il paese. I numeri salgono andando verso ovest e verso l'alto: un numero basso è vicino al centro, uno alto è nella parte alta, dove arriva il bus SITA da Sorrento.</p>
      </div>
      <div class="bg-white p-6 rounded-[2rem] border border-slate-100 shadow-sm">
        <h4 class="font-bold text-slate-900 mb-2">Via Cristoforo Colombo</h4>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">L'accesso da est, dal lato di Amalfi. Corre lungo il pendio con vista aperta sul mare e sta a un'altezza gestibile sopra la spiaggia: per questo ci sono diversi piccoli hotel e ristoranti.</p>
      </div>
      <div class="bg-white p-6 rounded-[2rem] border border-slate-100 shadow-sm">
        <h4 class="font-bold text-slate-900 mb-2">Spiaggia Grande</h4>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Il fondo della conca, raggiungibile a piedi lungo i vicoli a gradoni o via mare. Niente auto. Da qui partono le barche, e qui si trovano gli unici indirizzi di Positano davvero senza scale.</p>
      </div>
      <div class="bg-white p-6 rounded-[2rem] border border-slate-100 shadow-sm">
        <h4 class="font-bold text-slate-900 mb-2">Laurito e le frazioni</h4>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">A est del paese, sulla strada verso Praiano. Più tranquillo, con la sua piccola spiaggia sotto, ma non ci si scende in centro per un caffè. Servono navetta, barca o autobus.</p>
      </div>
    </div>
  </div>

  <!-- Gli otto -->
  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">Gli Otto Indirizzi in Breve</h2>
    <div class="overflow-x-auto rounded-[2rem] border border-slate-100 shadow-sm">
      <table class="w-full text-xs sm:text-sm">
        <thead class="bg-slate-900 text-white">
          <tr>
            <th class="text-left p-5 font-serif font-bold text-med-gold">Nome</th>
            <th class="text-left p-5 font-serif font-bold text-med-gold">Che cos'è</th>
            <th class="text-left p-5 font-serif font-bold text-med-gold">Dove</th>
          </tr>
        </thead>
        <tbody class="bg-white">
          <tr class="border-b border-slate-100">
            <td class="p-5 font-bold">Buca di Bacco</td>
            <td class="p-5 text-slate-600">Hotel quattro stelle e ristorante, aperto dal 1916</td>
            <td class="p-5 text-slate-600">Via Rampa Teglia 4, sulla Spiaggia Grande</td>
          </tr>
          <tr class="border-b border-slate-100">
            <td class="p-5 font-bold">Lucibello</td>
            <td class="p-5 text-slate-600">Noleggio barche e tour privati, famiglia al lavoro dagli anni Quaranta</td>
            <td class="p-5 text-slate-600">Spiaggia Grande, sotto il gazebo bianco</td>
          </tr>
          <tr class="border-b border-slate-100">
            <td class="p-5 font-bold">Casa e Bottega</td>
            <td class="p-5 text-slate-600">Bistrot per colazione e pranzo con negozio di design e ceramiche</td>
            <td class="p-5 text-slate-600">Viale Pasitea 100</td>
          </tr>
          <tr class="border-b border-slate-100">
            <td class="p-5 font-bold">Villa Rosa</td>
            <td class="p-5 text-slate-600">Piccolo hotel in una villa ottocentesca sulla roccia, tutto terrazze</td>
            <td class="p-5 text-slate-600">Via Cristoforo Colombo 127</td>
          </tr>
          <tr class="border-b border-slate-100">
            <td class="p-5 font-bold">Don Giovanni</td>
            <td class="p-5 text-slate-600">Ristorante di pesce a gestione familiare con terrazza sul mare</td>
            <td class="p-5 text-slate-600">Via Cristoforo Colombo 141</td>
          </tr>
          <tr class="border-b border-slate-100">
            <td class="p-5 font-bold">Posa Posa</td>
            <td class="p-5 text-slate-600">Hotel quattro stelle degli anni Cinquanta, piscina sul tetto</td>
            <td class="p-5 text-slate-600">Viale Pasitea 165</td>
          </tr>
          <tr class="border-b border-slate-100">
            <td class="p-5 font-bold">Villa Franca</td>
            <td class="p-5 text-slate-600">Hotel cinque stelle nella parte alta, pool club panoramico sul tetto</td>
            <td class="p-5 text-slate-600">Viale Pasitea 318</td>
          </tr>
          <tr>
            <td class="p-5 font-bold">Villa Santa Chiara</td>
            <td class="p-5 text-slate-600">Suite quattro stelle con giardino e terrazza, fuori dal centro</td>
            <td class="p-5 text-slate-600">Via Laurito 68</td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>

  <!-- Dove dormire -->
  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">Dove Dormire, Salendo dalla Spiaggia</h2>

    <h3 class="font-serif text-xl font-bold text-slate-900 mb-3">Buca di Bacco, sulla sabbia</h3>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      La Buca di Bacco ha aperto nel 1916 ed è uno dei posti che hanno inventato il turismo su questa costa. La storia è di quelle belle: Salvatore Rispoli e Carolina Pollio erano emigrati a New York, dove avevano aperto una drogheria con una clientela di gente di cinema e di teatro, e tornando a casa trasformarono quel mondo in un albergo. Per decenni è stato il rifugio di scrittori e pittori stranieri convinti che Positano fosse il posto giusto in cui essere poveri con stile. La sala si affaccia su una veranda sopra la <a href="/it-it/spiagge/costiera-amalfitana/spiaggia-grande-positano/" class="text-med-blue hover:underline">Spiaggia Grande</a>, con l'intera piramide di case alle spalle.
    </p>

    <h3 class="font-serif text-xl font-bold text-slate-900 mb-3">Villa Rosa, sul versante est</h3>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      Villa Rosa è una villa di circa 150 anni costruita direttamente nella roccia su Via Cristoforo Colombo, trasformata in un piccolo hotel in cui quasi ogni camera ha la sua terrazza sul mare. L'architettura è quella locale più che quella da albergo: volte, archi, logge, ceramiche originali dipinte a mano nei bagni. In centro si scende in poco tempo, e si risale in parecchio di più.
    </p>

    <h3 class="font-serif text-xl font-bold text-slate-900 mb-3">Posa Posa, a mezza costa</h3>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      Costruito negli anni Cinquanta e ancora riconoscibile per le decorazioni originali, comprese le ceramiche dipinte a mano che ne denunciano l'epoca, il Posa Posa sta in Viale Pasitea 165: abbastanza in alto da restare fuori dal rumore della strada, abbastanza in basso perché scendere non sia una spedizione. La terrazza al settimo piano ha una piscina e un solarium, e il ristorante dell'hotel, il Mirage, apparecchia su una terrazza panoramica affacciata sulla baia.
    </p>

    <h3 class="font-serif text-xl font-bold text-slate-900 mb-3">Villa Franca, in cima</h3>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      In Viale Pasitea 318 si è vicini al punto in cui la strada costiera entra in paese, il che significa la vista più ampia che un hotel di Positano possa offrire. La piscina sul tetto, il Gold Sky Pool Club, è fra le più alte del paese. Il ristorante dell'hotel, Li Galli, è una sala gourmet di sette tavoli il cui soffitto e le cui pareti di vetro si aprono d'estate, davanti agli isolotti de Li Galli che gli danno il nome. Stare così in alto è tutto il senso della scelta, e vuol dire anche che per andare in spiaggia si prenderà il bus o l'auto più spesso di quanto si immagini.
    </p>

    <h3 class="font-serif text-xl font-bold text-slate-900 mb-3">Villa Santa Chiara, a Laurito</h3>
    <p class="text-slate-600 text-lg leading-relaxed mb-8">
      Via Laurito 68 non è più Positano nel senso da cartolina. La zona di Laurito sta a est del paese sopra la sua piccola cala, e le suite hanno giardino, terrazza e il tipo di silenzio che il centro ad agosto non può offrire. In cambio si rinuncia all'accesso immediato: per andare in paese servono il bus SITA, un taxi o il barchino che in stagione fa servizio dalla spiaggia.
    </p>

    <div class="bg-white p-8 rounded-[2rem] border border-slate-100 shadow-sm">
      <h3 class="font-serif text-xl font-bold text-slate-900 mb-5">Scegliere in base a quanto si vuole camminare</h3>
      <div class="space-y-3">
        <div class="flex items-start gap-3">
          <div class="w-6 h-6 rounded-full bg-med-gold/15 flex-shrink-0 flex items-center justify-center text-med-gold font-bold text-xs">1</div>
          <p class="text-slate-600 text-xs sm:text-sm leading-relaxed"><strong>Nessun gradino:</strong> Buca di Bacco. Si sta sul lungomare, accanto al pontile dei traghetti e agli operatori delle barche.</p>
        </div>
        <div class="flex items-start gap-3">
          <div class="w-6 h-6 rounded-full bg-med-gold/15 flex-shrink-0 flex items-center justify-center text-med-gold font-bold text-xs">2</div>
          <p class="text-slate-600 text-xs sm:text-sm leading-relaxed"><strong>Dieci, quindici minuti in discesa e venti in salita:</strong> Villa Rosa e Posa Posa. È l'esperienza normale di Positano, e per la maggior parte delle persone va benissimo.</p>
        </div>
        <div class="flex items-start gap-3">
          <div class="w-6 h-6 rounded-full bg-med-gold/15 flex-shrink-0 flex items-center justify-center text-med-gold font-bold text-xs">3</div>
          <p class="text-slate-600 text-xs sm:text-sm leading-relaxed"><strong>Si userà un mezzo:</strong> Villa Franca e Villa Santa Chiara. Valgono entrambi per altre ragioni, ma non contateci per una nuotata prima di colazione.</p>
        </div>
      </div>
    </div>
  </div>

  <!-- Dove mangiare -->
  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">Dove Mangiare, e Dove Iniziare la Giornata</h2>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      Due dei nomi più cercati a Positano non sono hotel, e stanno ai due estremi della giornata.
    </p>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      Il <strong>Ristorante Don Giovanni</strong>, in Via Cristoforo Colombo 141, è una cucina a gestione familiare con terrazza sul mare, aperta tutti i giorni da aprile a ottobre. La reputazione è costruita sul pesce, e i piatti che tornano più spesso nelle recensioni sono il polpo, servito come antipasto o con le linguine, insieme alla pasta ai frutti di mare e al pescato al forno. È una prenotazione da fare prima di partire, non il giorno stesso.
    </p>
    <p class="text-slate-600 text-lg leading-relaxed mb-8">
      <strong>Casa e Bottega</strong>, in Viale Pasitea 100, è l'altra metà dell'equazione. Aperto dal 2012 e gestito dalla stessa famiglia, è una piccola sala bianca e verde che funziona da bistrot al mattino e insieme da negozio di ceramiche e oggetti per la casa. Il menu va dagli estratti alle bowl, uova, avocado toast e insalate, con opzioni vegetariane, vegane e senza glutine, e serve solo colazione e pranzo. Non si prenota: o si arriva presto o si aspetta.
    </p>

    <blockquote class="border-l-4 border-med-gold pl-6 my-8">
      <p class="text-slate-700 text-xl font-serif italic leading-relaxed">
        "A Positano nessuno chiede quante stelle ha un hotel. Chiedono quanto sta in alto."
      </p>
    </blockquote>
  </div>

  <!-- Lucibello -->
  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">Lucibello: Lasciare la Spiaggia e Andare in Mare</h2>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      Fra gli otto nomi, Lucibello è l'unico che non sia un edificio. È un'attività di barche sulla Spiaggia Grande, e si trova sotto il grande gazebo bianco esattamente davanti alla scalinata che scende dal centro del paese.
    </p>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      Tutto comincia con Salvatore Lucibello, pescatore positanese che negli anni Quaranta comprò due barche a remi, nel momento in cui iniziavano ad arrivare i primi postali ed era ormai chiaro che il paese stava diventando altro. Costruì barche più grandi per rispondere alla domanda, i figli entrarono nell'attività e tre generazioni dopo è ancora la famiglia a mandarla avanti. Oggi significa noleggi con o senza skipper e gite private lungo la costa e fino a <a href="/it-it/isole/capri/" class="text-med-blue hover:underline">Capri</a>.
    </p>
    <p class="text-slate-600 text-lg leading-relaxed">
      L'argomento pratico a favore della barca a Positano è semplice: le spiagge migliori vicino al paese, da Arienzo a Laurito a Fornillo, si raggiungono tutte più facilmente dall'acqua che dalla strada. E se si alloggia in alto a Villa Franca o fuori a Laurito, una mattina in barca risolve anche il problema delle scale.
    </p>
  </div>

  <!-- Consigli -->
  <div class="bg-white p-8 rounded-[2rem] shadow-xl border border-slate-100">
    <div class="flex items-center gap-4 mb-6">
      <svg class="w-6 h-6 text-med-gold flex-shrink-0" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M9 18h6"/><path d="M10 22h4"/><path d="M15.09 14c.18-.98.65-1.74 1.41-2.5A4.65 4.65 0 0 0 18 8 6 6 0 0 0 6 8c0 1 .23 2.23 1.5 3.5A4.61 4.61 0 0 1 8.91 14"/></svg>
      <h3 class="text-xl font-bold">Consigli dell'esperto</h3>
    </div>
    <div class="space-y-6">
      <div>
        <p class="font-bold text-slate-900 mb-1">Chiedete dei bagagli prima di prenotare</p>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Quasi tutti gli hotel delle strade alte organizzano un facchino che porta le valigie nell'ultimo tratto, perché il taxi fisicamente non arriva. È un servizio normale e quasi sempre a pagamento. Verificate che esista per il vostro indirizzo, invece di scoprire la scalinata con due valigie in mano.</p>
      </div>
      <div>
        <p class="font-bold text-slate-900 mb-1">Arrivate via mare se gli orari lo permettono</p>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Il <a href="/it-it/guida/traghetti/" class="text-med-blue hover:underline">traghetto</a> sbarca alla Spiaggia Grande, in fondo al paese, l'unico punto di arrivo da cui tutto è semplicemente in salita e non un'incognita. Fuori stagione le barche si fermano e resta il <a href="/it-it/guida/bus-sita/" class="text-med-blue hover:underline">bus SITA</a>.</p>
      </div>
      <div>
        <p class="font-bold text-slate-900 mb-1">Lasciate l'auto a casa</p>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">A Positano il parcheggio è scarso, caro e lontano dalla spiaggia, e la parte bassa del paese è chiusa al traffico. Se proprio non se ne può fare a meno, leggete prima le regole su <a href="/it-it/guida/parcheggi-ztl/" class="text-med-blue hover:underline">parcheggi e ZTL</a> e chiedete all'hotel con quale garage lavora.</p>
      </div>
      <div>
        <p class="font-bold text-slate-900 mb-1">Colazione all'avventura, cena prenotata</p>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">I due pasti funzionano in modo diverso. Posti da colazione e pranzo come Casa e Bottega lavorano a chi arriva prima, mentre qualunque terrazza con vista, Don Giovanni compreso, in alta stagione vuole la prenotazione. Prenotate le cene di tutto il soggiorno la prima mattina.</p>
      </div>
    </div>
  </div>

