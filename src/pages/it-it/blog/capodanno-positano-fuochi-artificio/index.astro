---
import BlogPostLayout from '../../../../layouts/BlogPostLayout.astro';

const lang = 'it-it';
const post = {
  title: 'Capodanno a Positano: i fuochi d\'artificio',
  subtitle: 'Mezzanotte sulla Spiaggia Grande: a che ora partono i fuochi, dove mettersi e come arrivare a Positano e tornare indietro nell\'unica notte dell\'anno in cui sulla statale, dopo cena, non passano autobus',
  category: 'GUIDE',
  date: '24 Novembre 2026',
  readTime: '8 min',
  image: '/images/fuochi-capodanno-hero.webp',
  imageAlt: "Fuochi d'artificio verdi e dorati nel cielo la notte di Capodanno",
  path: '/it-it/blog/capodanno-positano-fuochi-artificio/',
};

const metaTitle = 'Capodanno a Positano 2026: fuochi d\'artificio, dove vederli';
const metaDescription = 'Capodanno a Positano: fuochi d\'artificio a mezzanotte sulla Spiaggia Grande, DJ set fino alle 3, dove vederli e come tornare senza traghetti né bus notturni.';

const breadcrumbs = [
  { name: 'Home', url: '/it-it/' },
  { name: 'Blog', url: '/it-it/blog/' },
  { name: 'Capodanno a Positano', url: '/it-it/blog/capodanno-positano-fuochi-artificio/' },
];

const quickInfo = [
  { label: 'Quando', value: '31 dicembre, fuochi a mezzanotte' },
  { label: 'Dove', value: 'Spiaggia Grande (Marina Grande)' },
  { label: 'Costo', value: 'Gratuito' },
  { label: 'Dopo mezzanotte', value: 'DJ set in spiaggia fino alle 3:00 circa' },
  { label: 'Organizzazione', value: 'Comune di Positano e Forum dei Giovani' },
  { label: 'Traghetti', value: 'Fermi d\'inverno' },
  { label: 'Bus notturni', value: 'Nessuno, organizzate prima il rientro' },
  { label: 'Programma 2026', value: 'Di solito pubblicato a dicembre' },
];

const faq = [
  {
    q: 'A Positano ci sono i fuochi d\'artificio a Capodanno?',
    a: 'Sì. Nelle ultime due edizioni il Comune ha organizzato lo spettacolo pirotecnico a mezzanotte dalla Spiaggia Grande, seguito da una festa gratuita in spiaggia con il Forum dei Giovani. Il programma 2026/2027 non era ancora uscito quando abbiamo scritto questo articolo: il Comune di solito lo annuncia a dicembre.',
  },
  {
    q: 'A che ora iniziano i fuochi?',
    a: 'A mezzanotte. Per l\'edizione 2024/2025 il Comune indicava l\'inizio alle 23:59 e la fine della serata alle 3:00, con un DJ set in spiaggia dopo i fuochi. Il calendario 2025/2026 riportava le 00:00 per i fuochi sulla Spiaggia Grande.',
  },
  {
    q: 'Serve un biglietto?',
    a: 'No. I fuochi e la festa in spiaggia sono gratuiti e aperti a tutti. Si paga solo se prenotate il cenone in un ristorante o in hotel, e lì i menu sono fissi con prezzo fisso.',
  },
  {
    q: 'Qual è il posto migliore per vederli?',
    a: 'Sulla Spiaggia Grande se volete la musica e la folla, sulle scale e nei vicoli intorno alla chiesa di Santa Maria Assunta, proprio sopra la spiaggia, oppure da Via Positanesi d\'America, il sentiero a strapiombo verso Fornillo, se volete vedere tutta la baia con un po\' più di spazio. Una terrazza sulla baia è l\'opzione più comoda, ma va prenotata insieme alla cena.',
  },
  {
    q: 'Si può arrivare a Positano in traghetto il 31 dicembre?',
    a: 'No. I traghetti in Costiera Amalfitana si fermano per l\'inverno, quindi a Capodanno si arriva solo con il bus SITA (orario invernale ridotto), in taxi o con un NCC, oppure con la propria auto.',
  },
  {
    q: 'Come si torna dopo mezzanotte?',
    a: 'Non con il bus: la SITA non ha corse a notte fonda. Se non dormite a Positano, prenotate un taxi o un NCC ben prima del 31 dicembre e concordate orario e punto di ritiro. Quella notte sono la prima cosa che va esaurita.',
  },
];

const sidebarLinks = [
  { label: 'Positano', href: '/it-it/costiera-amalfitana/positano/' },
  { label: 'Hotel e Ristoranti di Positano', href: '/it-it/blog/hotel-ristoranti-positano/' },
  { label: 'Capodanno a Sorrento', href: '/it-it/eventi/penisola-sorrentina/capodanno-sorrento/' },
  { label: 'Bus SITA', href: '/it-it/guida/bus-sita/' },
  { label: 'Parcheggi e ZTL', href: '/it-it/guida/parcheggi-ztl/' },
];

const authorRole = 'Guide locali · Costiera Amalfitana';

const relatedArticles = [
  {
    title: 'Luminarie di Natale a Sorrento e Salerno',
    category: 'GUIDE',
    date: '21 Ottobre 2026',
    image: '/images/luci-artista-salerno-hero.webp',
    imageAlt: 'Luminarie di Natale a Salerno',
    path: '/it-it/blog/luminarie-natalizie-sorrento-salerno/'
  },
  {
    title: 'Hotel e Ristoranti di Positano: Otto Indirizzi',
    category: 'GUIDE',
    date: '31 Agosto 2026',
    image: '/images/positano-spiaggia-grande-colombo-hero.webp',
    imageAlt: 'Hotel e ristoranti di Positano',
    path: '/it-it/blog/hotel-ristoranti-positano/'
  }
];

const keyTakeaways = [
  'I fuochi partono a mezzanotte dalla Spiaggia Grande, e la festa in spiaggia con il DJ set va avanti fino alle 3:00 circa. Entrambi gratuiti.',
  'Il programma 2026/2027 di solito viene confermato dal Comune a dicembre. Gli orari riportati qui vengono dalle ultime due edizioni.',
  'D\'inverno non ci sono traghetti e la SITA non ha corse a notte fonda. O dormite a Positano, o prenotate il rientro prima di arrivare.',
  'I ristoranti aperti durante le feste propongono il menu fisso del cenone. Prenotate a novembre, perché in Costiera molti locali chiudono per l\'inverno.',
  'Se il tempo peggiora, lo spettacolo può essere ridotto o spostato. Il 31 controllate il sito e i social del Comune.',
];
---

<BlogPostLayout
  lang={lang}
  post={post}
  metaTitle={metaTitle}
  metaDescription={metaDescription}
  breadcrumbs={breadcrumbs}
  quickInfo={quickInfo}
  faq={faq}
  sidebarLinks={sidebarLinks}
  authorRole={authorRole}
  relatedArticles={relatedArticles}
  pageKey="positano-new-years-eve-fireworks"
>

  <!-- Key Takeaways -->
  <div class="bg-slate-900 text-white p-8 rounded-[2rem]">
    <div class="flex items-center gap-3 mb-6">
      <svg class="w-5 h-5 text-med-gold flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
      <h2 class="font-serif text-lg font-bold text-med-gold uppercase tracking-[0.15em]">Punti Chiave</h2>
    </div>
    <ul class="space-y-4">
      {keyTakeaways.map((point) => (
        <li class="flex items-start gap-3">
          <span class="w-1.5 h-1.5 rounded-full bg-med-gold flex-shrink-0 mt-2"></span>
          <span class="text-white/80 text-xs sm:text-sm leading-relaxed">{point}</span>
        </li>
      ))}
    </ul>
  </div>

  <!-- Intro -->
  <div>
    <p class="text-slate-600 text-xl leading-relaxed mb-6 font-light">
      D'inverno <a href="/it-it/costiera-amalfitana/positano/" class="text-med-blue hover:underline">Positano</a> si svuota: tanti hotel chiudono, gli stabilimenti ritirano i lettini e nei vicoli si incontrano soprattutto i residenti. Il 31 dicembre il paese si riempie di nuovo, per una notte. A mezzanotte i fuochi salgono dalla Spiaggia Grande, dietro si accendono le case sulla collina e la spiaggia diventa una pista da ballo fino a tarda notte. Ecco cosa succede, dove mettersi e soprattutto come arrivare e come tornare.
    </p>
  </div>

  <!-- Il programma -->
  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">Cosa Succede quella Notte</h2>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      La festa la organizza il Comune di Positano insieme al Forum dei Giovani, e negli ultimi anni la formula è rimasta la stessa. Per l'edizione 2024/2025 il Comune indicava l'inizio alle <strong>23:59</strong> sulla Spiaggia Grande: prima i fuochi, poi un <strong>DJ set in spiaggia fino alle 3:00</strong>. Anche il calendario 2025/2026 metteva i fuochi a <strong>mezzanotte sulla Spiaggia Grande</strong>, seguiti dalla festa con il Forum dei Giovani.
    </p>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      L'ingresso è libero e per la spiaggia non c'è niente da prenotare. Il resto della serata lo decidete voi: quasi tutti cenano al ristorante o in hotel e scendono in spiaggia verso le undici e mezza. Il programma <strong>2026/2027</strong> non era ancora stato pubblicato quando abbiamo scritto questo articolo. Di solito il Comune lo mette sul suo sito a dicembre, a volte solo pochi giorni prima del 31.
    </p>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-6">
      <div class="bg-white p-6 rounded-[2rem] border border-slate-100 shadow-sm">
        <h4 class="font-bold text-slate-900 mb-2">Prima di mezzanotte</h4>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Cena in paese, di solito con il menu fisso del cenone. I ristoranti con vista sulla baia sono i primi a riempirsi. Calcolate il tempo per scendere: nei vicoli sopra la spiaggia vanno tutti nella stessa direzione.</p>
      </div>
      <div class="bg-white p-6 rounded-[2rem] border border-slate-100 shadow-sm">
        <h4 class="font-bold text-slate-900 mb-2">Mezzanotte</h4>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Fuochi dalla Spiaggia Grande. Lo spettacolo è breve, questione di minuti, quindi alle meno un quarto fatevi trovare già al vostro posto.</p>
      </div>
      <div class="bg-white p-6 rounded-[2rem] border border-slate-100 shadow-sm">
        <h4 class="font-bold text-slate-900 mb-2">Dopo mezzanotte</h4>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Il DJ set in spiaggia, gratuito, fino alle 3:00 circa. Restate quanto volete, ma tenete d'occhio l'orologio se qualcuno passa a prendervi.</p>
      </div>
      <div class="bg-white p-6 rounded-[2rem] border border-slate-100 shadow-sm">
        <h4 class="font-bold text-slate-900 mb-2">Se il tempo cambia</h4>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Una mareggiata di dicembre può ridurre o spostare un evento che si tiene in spiaggia. Il giorno stesso controllate il sito del Comune e i social del Forum dei Giovani.</p>
      </div>
    </div>
  </div>

  <!-- Dove vederli -->
  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">Dove Vedere i Fuochi</h2>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      Positano è costruita ad anfiteatro intorno alla sua spiaggia, quindi i fuochi si vedono da buona parte del paese. Cambia quanto siete vicini e quanta gente avete intorno.
    </p>
    <ul class="space-y-4 text-slate-600 mb-6">
      <li class="flex items-start gap-3">
        <span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span>
        <span class="text-slate-700"><strong>Spiaggia Grande.</strong> In mezzo alla festa, con la musica e il conto alla rovescia. Ed è qui che dovete stare se restate per il DJ set. Verso mezzanotte c'è ressa: tenete la borsa davanti e fissate un punto d'incontro con il vostro gruppo.</span>
      </li>
      <li class="flex items-start gap-3">
        <span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span>
        <span class="text-slate-700"><strong>Intorno a Santa Maria Assunta.</strong> Le scale e i vicoli intorno alla chiesa, proprio sopra la spiaggia, danno una vista un po' rialzata a due minuti a piedi dalla festa.</span>
      </li>
      <li class="flex items-start gap-3">
        <span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span>
        <span class="text-slate-700"><strong>Via Positanesi d'America.</strong> Il sentiero scavato nella roccia tra la Spiaggia Grande e <a href="/it-it/spiagge/costiera-amalfitana/fornillo-positano/" class="text-med-blue hover:underline">Fornillo</a> guarda indietro verso la baia, con il paese alle spalle dei fuochi. C'è più spazio che in spiaggia, ma il sentiero è stretto: non fermatevi dove la gente deve passare.</span>
      </li>
      <li class="flex items-start gap-3">
        <span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span>
        <span class="text-slate-700"><strong>Una terrazza sulla baia.</strong> Gli hotel e i ristoranti sul mare vendono il cenone con vista sui fuochi. È l'opzione più calda e la più cara, e va prenotata con largo anticipo.</span>
      </li>
    </ul>
    <p class="text-slate-600 text-lg leading-relaxed">
      La barca non è un'opzione realistica: d'inverno i traghetti non ci sono, e un noleggio privato in una notte di dicembre dipende tutto dal mare.
    </p>
  </div>

  <!-- Come arrivare -->
  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">Come Arrivare e Come Tornare</h2>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      È la prima cosa da organizzare. D'estate si arriva via mare e si riparte in bus. Il 31 dicembre i traghetti sono fermi e i bus smettono la sera, quindi tutto dipende da dove dormite.
    </p>

    <div class="overflow-x-auto rounded-[2rem] border border-slate-100 shadow-sm">
      <table class="w-full text-xs sm:text-sm">
        <thead class="bg-slate-900 text-white">
          <tr>
            <th class="text-left p-5 font-serif font-bold text-med-gold">Mezzo</th>
            <th class="text-left p-5 font-serif font-bold text-med-gold">Andata</th>
            <th class="text-left p-5 font-serif font-bold text-med-gold">Ritorno dopo mezzanotte</th>
          </tr>
        </thead>
        <tbody class="bg-white">
          <tr class="border-b border-slate-100">
            <td class="p-5 font-bold">Bus SITA</td>
            <td class="p-5 text-slate-600">Sì, con l'orario invernale. Da Sorrento circa 50 min</td>
            <td class="p-5 text-slate-600">No, non ci sono corse notturne</td>
          </tr>
          <tr class="border-b border-slate-100">
            <td class="p-5 font-bold">Traghetto</td>
            <td class="p-5 text-slate-600">No, sospeso d'inverno</td>
            <td class="p-5 text-slate-600">No</td>
          </tr>
          <tr class="border-b border-slate-100">
            <td class="p-5 font-bold">Taxi o NCC</td>
            <td class="p-5 text-slate-600">Sì</td>
            <td class="p-5 text-slate-600">Sì, ma solo se prenotato prima</td>
          </tr>
          <tr>
            <td class="p-5 font-bold">Auto propria</td>
            <td class="p-5 text-slate-600">Possibile, solo garage a pagamento</td>
            <td class="p-5 text-slate-600">Solo con un guidatore che non beve</td>
          </tr>
        </tbody>
      </table>
    </div>

    <p class="text-slate-600 text-lg leading-relaxed mt-6 mb-6">
      <strong>Dormire a Positano</strong> risolve il problema: dopo i fuochi tornate in camera a piedi. Prenotate presto, perché durante le feste restano aperti pochi hotel. La nostra selezione di <a href="/it-it/blog/hotel-ristoranti-positano/" class="text-med-blue hover:underline">hotel e ristoranti a Positano</a> è un buon punto di partenza.
    </p>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      <strong>In bus.</strong> Il <a href="/it-it/guida/bus-sita/" class="text-med-blue hover:underline">bus SITA</a> collega Sorrento e Amalfi anche d'inverno, con meno corse. Le fermate di Positano sono sulla statale sopra il paese: da Sponda alla spiaggia sono una decina di minuti a piedi in discesa. Va bene per arrivare nel pomeriggio, non per ripartire dopo mezzanotte. Il 1° gennaio vale l'orario festivo, con ancora meno corse.
    </p>
    <p class="text-slate-600 text-lg leading-relaxed">
      <strong>In auto.</strong> La ZTL di Positano è attiva solo d'estate, quindi a dicembre si può entrare, ma per parcheggiare ci sono solo i garage privati e il 31 le poche strade del paese sono intasate. Chiedete al vostro hotel con quale garage è convenzionato e leggete la nostra guida a <a href="/it-it/guida/parcheggi-ztl/" class="text-med-blue hover:underline">parcheggi e ZTL</a>. Se dormite a Praiano o a Sorrento, un taxi andata e ritorno costa più del garage, ma vi toglie sia il parcheggio sia il rientro in auto sulla statale alle due di notte.
    </p>
  </div>

  <!-- Consigli -->
  <div class="bg-white p-8 rounded-[2rem] shadow-xl border border-slate-100">
    <div class="flex items-center gap-4 mb-6">
      <svg class="w-6 h-6 text-med-gold flex-shrink-0" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M9 18h6"/><path d="M10 22h4"/><path d="M15.09 14c.18-.98.65-1.74 1.41-2.5A4.65 4.61 0 0 0 18 8 6 6 0 0 0 6 8c0 1 .23 2.23 1.5 3.5A4.61 4.61 0 0 1 8.91 14"/></svg>
      <h3 class="text-xl font-bold">Consigli dell'esperto</h3>
    </div>
    <div class="space-y-6">
      <div>
        <p class="font-bold text-slate-900 mb-1">Prenotate il rientro a novembre</p>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">A Capodanno taxi e NCC in Costiera sono prenotati con settimane di anticipo. Concordate per iscritto il punto di ritiro (la fermata di Sponda sulla statale è la più semplice) e tenetevi il tempo per risalire dalla spiaggia.</p>
      </div>
      <div>
        <p class="font-bold text-slate-900 mb-1">Scarpe da scale, non da festa</p>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Positano è tutta scale e vicoli in salita, e dopo mezzanotte sono affollati e in certi punti bui. Scarpe basse che non scivolano e una giacca pesante: di notte a dicembre, in spiaggia, il vento dal mare è freddo.</p>
      </div>
      <div>
        <p class="font-bold text-slate-900 mb-1">Controllate il programma il 31</p>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Le informazioni qui vengono dalle ultime due edizioni. Orari e organizzatori possono cambiare, e una mareggiata può stravolgere i piani il giorno stesso. La fonte ufficiale è il sito del Comune.</p>
      </div>
      <div>
        <p class="font-bold text-slate-900 mb-1">L'alternativa: Sorrento</p>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Se arrivare a Positano d'inverno è troppo complicato, il <a href="/it-it/eventi/penisola-sorrentina/capodanno-sorrento/" class="text-med-blue hover:underline">Capodanno a Sorrento</a> ha un concerto, il Ciuccio di Fuoco in Piazza Tasso e i fuochi da Marina Piccola, in una città con più hotel aperti e il treno per Napoli.</p>
      </div>
    </div>
  </div>

</BlogPostLayout>
