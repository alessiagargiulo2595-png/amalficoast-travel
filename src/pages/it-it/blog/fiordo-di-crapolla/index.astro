---
import BlogPostLayout from '../../../../layouts/BlogPostLayout.astro';

const lang = 'it-it';
const post = {
  title: 'Fiordo di Crapolla',
  subtitle: 'Il Tesoro Nascosto tra i 700 Scalini',
  category: 'SCOPERTE',
  date: '15 Maggio 2026',
  readTime: '12 min',
  image: '/images/fiordo-crapolla-hero.jpg',
  imageAlt: 'Fiordo di Crapolla - Massa Lubrense, Penisola Sorrentina',
  path: '/it-it/blog/fiordo-di-crapolla/',
};

const metaTitle = 'Fiordo di Crapolla: Il Tesoro Nascosto della Penisola Sorrentina 2026';
const metaDescription = 'Guida completa al Fiordo di Crapolla: 700 scalini, chiesa medievale, resti romani, storia archeologica e i consigli pratici per visitare questo luogo segreto di Massa Lubrense.';

const breadcrumbs = [
  { name: 'Home', url: '/it-it/' },
  { name: 'Blog', url: '/it-it/blog/' },
  { name: 'Fiordo di Crapolla', url: '/it-it/blog/fiordo-di-crapolla/' },
];

const quickInfo = [
  { label: 'Punto di partenza', value: 'Via Casal di Torca (Massa Lubrense)' },
  { label: 'Numero scalini', value: '~700 (in pietra viva)' },
  { label: 'Dislivello', value: 'Circa 160 metri' },
  { label: 'Difficoltà', value: 'Media/Alta (per lo sforzo fisico della risalita)' },
  { label: 'Acqua', value: 'Assente sul posto (portare almeno 2 litri)' },
  { label: 'Tempo andata', value: 'Circa 45-60 minuti' },
  { label: 'Cosa vedere', value: 'Cappella di San Pietro, resti romani, monazeni' },
  { label: 'Periodo migliore', value: 'Aprile-Giugno, Settembre-Ottobre' },
];

const faq = [
  {
    q: 'Qual è il numero esatto di scalini?',
    a: 'Non esiste un numero preciso: il conteggio varia tra 680 e 700 a seconda del punto di inizio del sentiero e di come si contano gli ultimi gradini. La maggior parte dei visitatori riferisce circa 700 scalini.',
  },
  {
    q: 'Quanto tempo serve per la risalita?',
    a: 'La risalita richiede generalmente 60-90 minuti. Dipende dal vostro livello di fitness e dall\'orario (nei mesi caldi, il calore della pietra rallenta considerevolmente il passo).',
  },
  {
    q: 'È obbligatorio portare acqua?',
    a: 'Assolutamente sì. Non ci sono fontane né punti di ristoro lungo il percorso. Portate almeno 2 litri per persona, più in estate.',
  },
  {
    q: 'Ci sono pericoli lungo il sentiero?',
    a: 'Il percorso non è tecnicamente difficile, ma la pietra calcarea può essere scivolosa, specialmente con scarpe inadatte. Usate sempre scarpe da trekking con buon grip.',
  },
  {
    q: 'Posso fare il bagno?',
    a: 'Sì, l\'acqua è cristallina e la spiaggia è meravigliosa. L\'area fa parte della Riserva Marina di Punta Campanella, quindi l\'ecosistema è preservato.',
  },
  {
    q: 'Devo prenotare o chiedere il permesso?',
    a: 'Non è necessaria prenotazione. È un\'area pubblica, ma ricordate di portare via i vostri rifiuti e di rispettare l\'ambiente.',
  },
];

const sidebarLinks = [
  { label: 'Massa Lubrense', href: '/it-it/penisola-sorrentina/massa-lubrense/' },
  { label: 'Punta Campanella', href: '/it-it/blog/punta-campanella/' },
  { label: 'Quando visitare', href: '/it-it/quando-visitare/' },
  { label: 'Come arrivare', href: '/it-it/come-arrivare/' },
];

const relatedArticles = [
  {
    title: 'Punta Campanella',
    category: 'SCOPERTE',
    date: '10 Maggio 2026',
    image: '/images/punta-campanella-hero.jpg',
    imageAlt: 'Punta Campanella - Massa Lubrense, Penisola Sorrentina',
    path: '/it-it/blog/punta-campanella/'
  },
  {
    title: 'Valle delle Ferriere',
    category: 'SCOPERTE',
    date: '22 Aprile 2026',
    image: '/images/valle-ferriere-hero.jpg',
    imageAlt: 'Cascata nella Valle delle Ferriere, Amalfi - Costiera Amalfitana',
    path: '/it-it/blog/valle-delle-ferriere/'
  }
];

const authorRole = 'Archeologia & Trekking Guide · Penisola Sorrentina';

const videoSchema = {
  "@context": "https://schema.org",
  "@type": "VideoObject",
  "name": "Fiordo di Crapolla: I 700 Scalini tra il Mito e la Natura Selvaggia",
  "description": "Video del Fiordo di Crapolla - uno dei luoghi più affascinanti della Penisola Sorrentina con i suoi 700 scalini in pietra, la Cappella di San Pietro e l'antica storia archeologica.",
  "thumbnailUrl": "/images/fiordo-crapolla-hero.jpg",
  "uploadDate": "2026-05-15",
  "duration": "PT1M30S",
  "contentUrl": "/videos/fiordo-crapolla-video.mp4",
  "videoDetails": {
    "width": "1280",
    "height": "720"
  }
};

const keyTakeaways = [
  'Fiordo di Crapolla non è solo una spiaggia segreta, ma un monumento naturale e archeologico con radici che risalgono all\'epoca classica dedicata al dio Apollo.',
  'I ~700 scalini in pietra calcarea sono stati costruiti con sapienza antica per superare un dislivello di circa 160 metri, e rimangono il tratto distintivo del luogo.',
  'La Cappella di San Pietro sorge sui resti di un tempio pagano dedicato ad Apollo; nel medioevo qui fiorì un\'importante abbazia benedettina.',
  'I monazeni (cavità scavate nella roccia dai Romani) testimoniano come il luogo sia stato utilizzato per secoli come rifugio naturale e rimessaggio di barche.',
  'L\'orario ideale per la visita è tra le 6:00 e le 12:00 in estate, evitando il calore torrido della pietra calcarea nelle ore centrali del giorno.',
];
---

<BlogPostLayout
  lang={lang}
  post={post}
  metaTitle={metaTitle}
  metaDescription={metaDescription}
  breadcrumbs={breadcrumbs}
  quickInfo={quickInfo}
  faq={faq}
  sidebarLinks={sidebarLinks}
  authorRole={authorRole}
  relatedArticles={relatedArticles}
  schema={[videoSchema]}
  pageKey="fiordo-di-crapolla"
>

  <!-- Key Takeaways -->
  <div class="bg-slate-900 text-white p-8 rounded-[2rem]">
    <div class="flex items-center gap-3 mb-6">
      <svg class="w-5 h-5 text-med-gold flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
      <h2 class="font-serif text-lg font-bold text-med-gold uppercase tracking-[0.15em]">Punti Salienti</h2>
    </div>
    <ul class="space-y-4">
      {keyTakeaways.map((point) => (
        <li class="flex items-start gap-3">
          <span class="w-1.5 h-1.5 rounded-full bg-med-gold flex-shrink-0 mt-2"></span>
          <span class="text-white/80 text-xs sm:text-sm leading-relaxed">{point}</span>
        </li>
      ))}
    </ul>
  </div>

  <!-- Intro -->
  <div>
    <p class="text-slate-600 text-xl leading-relaxed mb-6 font-light">
      Mentre la maggior parte dei turisti si affolla lungo le strade di Positano o sui moli di Sorrento, esiste un'insenatura scavata nella roccia che conserva intatto il fascino di un'Italia perduta. Il Fiordo di Crapolla, nel comune di Massa Lubrense, non è solo una spiaggia: è un monumento naturale e archeologico a cielo aperto, protetto da pareti altissime e accessibile solo a chi è disposto a "meritarselo" con una lunga camminata.
    </p>
  </div>

  <!-- Video Section -->
  <div class="rounded-[2rem] shadow-xl mb-8 flex justify-center bg-slate-900 py-4">
    <video muted="muted"
      controls controlsList="nofullscreen" id="disable-audio"
      poster="/images/fiordo-crapolla-hero.jpg"
      class="max-w-full max-h-[500px]"
      width="1280"
      height="720"
    >
      <source src="/videos/fiordo-crapolla-video.mp4" type="video/mp4" />
      Il tuo browser non supporta il tag video. Scarica il video per visualizzarlo.
    </video>
    <script>
  function cleanApostrophes(text) {
    return String(text).replace(/\'/g, "'");
  }
      const video = document.getElementById("disable-audio");
      if (!video) video = document.querySelector('video');
      if (video) {
        const forceMuted = () => {
          video.muted = true;
          video.volume = 0;
        };
        forceMuted();
        video.addEventListener('play', forceMuted);
        video.addEventListener('playing', forceMuted);
        video.addEventListener('volumechange', forceMuted);
        video.addEventListener('timeupdate', forceMuted);
        video.addEventListener('seeked', forceMuted);
      }
    </script>
  </div>

  <!-- Il Sentiero -->
  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">Il Sentiero: Tra Macchia Mediterranea e Miti</h2>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      Il viaggio inizia nel piccolo borgo di Torca. Da qui si imbocca un sentiero che si snoda tra antichi muri a secco, orti e la tipica vegetazione costiera dove domina il profumo del mirto, del lentisco e della ginestra. Il percorso offre una vista privilegiata sull'arcipelago de Li Galli (le leggendarie isole delle Sirene) e sull'isola d'Isca, lo scoglio amato e acquistato da Eduardo De Filippo.
    </p>

    <div class="bg-white p-8 rounded-[2rem] border border-slate-100 shadow-sm my-6">
      <h3 class="font-serif text-xl font-bold text-slate-900 mb-4">La Sfida dei 700 Scalini</h3>
      <p class="text-slate-600 leading-relaxed mb-4">
        Il tratto distintivo di Crapolla è la sua incredibile scalinata. Per raggiungere il mare bisogna scendere circa 700 gradini in pietra calcarea (il conteggio preciso varia spesso tra i 680 e i 700 a seconda dei punti di inizio). Ogni gradino è stato posato con sapienza antica per superare il dislivello vertiginoso della scogliera.
      </p>
      <p class="text-slate-600 leading-relaxed">
        Lungo la discesa troverete delle piccole maioliche che indicano il numero di scalini percorsi, un dettaglio che diventa fondamentale (e psicologicamente impegnativo) durante la risalita.
      </p>
    </div>
  </div>

  <!-- La Chiesa sotto: San Pietro -->
  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">La Chiesa sotto: San Pietro e il Tempio di Apollo</h2>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      Quasi al termine della scalinata, prima di toccare la sabbia, ci si imbatte in un luogo di pace assoluta: la Cappella di San Pietro. Questa piccola chiesa bianca sorge in una posizione panoramica straordinaria, ma la sua importanza è storica prima ancora che religiosa.
    </p>

    <div class="space-y-6 mb-8">
      <div class="bg-white p-6 rounded-[2rem] border border-slate-100 shadow-sm">
        <h4 class="font-bold text-slate-900 mb-2">Le radici classiche</h4>
        <p class="text-slate-600 text-sm leading-relaxed">Il nome "Crapolla" deriva probabilmente da Acra-Apollo, ovvero il promontorio dedicato al dio Apollo. La chiesa sorge infatti proprio sui resti di un antico tempio pagano dedicato al dio del sole.</p>
      </div>
      <div class="bg-white p-6 rounded-[2rem] border border-slate-100 shadow-sm">
        <h4 class="font-bold text-slate-900 mb-2">L'Abbazia di San Pietro</h4>
        <p class="text-slate-600 text-sm leading-relaxed">Nel medioevo, qui fiorì un'importante abbazia benedettina. Oggi della struttura originale restano visibili colonne di marmo e basi architettoniche di epoca romana, reimpiegate nella costruzione della cappella.</p>
      </div>
      <div class="bg-white p-6 rounded-[2rem] border border-slate-100 shadow-sm">
        <h4 class="font-bold text-slate-900 mb-2">La leggenda</h4>
        <p class="text-slate-600 text-sm leading-relaxed">Si narra che l'Apostolo Pietro, nel suo viaggio verso Roma per evangelizzare l'Occidente, fece scalo proprio in questa insenatura, trovandovi il primo approdo sicuro.</p>
      </div>
    </div>

    <blockquote class="border-l-4 border-med-gold pl-6 my-8">
      <p class="text-slate-700 text-xl font-serif italic leading-relaxed">
        "Crapolla è dove la storia classica, quella cristiana medievale e la natura selvaggia si incontrano in uno spazio incredibilmente piccolo e intatto."
      </p>
    </blockquote>
  </div>

  <!-- Il Borgo Marinaro -->
  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">Il Borgo Marinaro e la Spiaggia</h2>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      Arrivati in fondo, sarete accolti dai resti di un antico borgo di pescatori. Qui si trovano i monazeni: cavità scavate nella roccia dai Romani e utilizzate per secoli per il rimessaggio delle barche. La spiaggia è un piccolo fazzoletto di ciottoli bianchi dove l'acqua è di una purezza cristallina, tipica dell'area marina protetta di Punta Campanella.
    </p>

    <div class="overflow-hidden rounded-[2rem] border border-slate-100 shadow-sm">
      <table class="w-full text-xs sm:text-sm">
        <thead class="bg-slate-900 text-white">
          <tr>
            <th class="text-left p-5 font-serif font-bold text-med-gold">Caratteristica</th>
            <th class="text-left p-5 font-serif font-bold text-med-gold">Dettaglio</th>
          </tr>
        </thead>
        <tbody class="bg-white">
          <tr class="border-b border-slate-100">
            <td class="p-5 font-bold text-slate-900">Punto di Partenza</td>
            <td class="p-5 text-slate-600">Via Casal di Torca (Massa Lubrense)</td>
          </tr>
          <tr class="border-b border-slate-100">
            <td class="p-5 font-bold text-slate-900">Numero Scalini</td>
            <td class="p-5 text-slate-600">~700 (in pietra viva)</td>
          </tr>
          <tr class="border-b border-slate-100">
            <td class="p-5 font-bold text-slate-900">Dislivello</td>
            <td class="p-5 text-slate-600">Circa 160 metri</td>
          </tr>
          <tr class="border-b border-slate-100">
            <td class="p-5 font-bold text-slate-900">Difficoltà</td>
            <td class="p-5 text-slate-600">Media/Alta (per lo sforzo fisico della risalita)</td>
          </tr>
          <tr>
            <td class="p-5 font-bold text-slate-900">Acqua</td>
            <td class="p-5 text-slate-600">Assente sul posto (portare almeno 2 litri)</td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>

  <!-- Local Tips -->
  <div class="bg-white p-8 rounded-[2rem] shadow-xl border border-slate-100">
    <div class="flex items-center gap-4 mb-6">
      <svg class="w-6 h-6 text-med-gold flex-shrink-0" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M9 18h6"/><path d="M10 22h4"/><path d="M15.09 14c.18-.98.65-1.74 1.41-2.5A4.65 4.65 0 0 0 18 8 6 6 0 0 0 6 8c0 1 .23 2.23 1.5 3.5A4.61 4.61 0 0 1 8.91 14"/></svg>
      <h3 class="text-xl font-bold text-slate-900">I Consigli dell'Esperto</h3>
    </div>
    <div class="space-y-6">
      <div>
        <p class="font-bold text-slate-900 mb-1">L'Orario</p>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Evitate la risalita tra le 12:00 e le 16:00 nei mesi estivi. La scalinata è interamente esposta a sud e il calore trattenuto dalla pietra calcarea può essere estenuante.</p>
      </div>
      <div>
        <p class="font-bold text-slate-900 mb-1">Scarpe</p>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Non fate l'errore di scendere in infradito. La pietra è scivolosa e i gradini sono irregolari. Usate scarpe da trail o da ginnastica con un buon grip.</p>
      </div>
      <div>
        <p class="font-bold text-slate-900 mb-1">Rispetto</p>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Crapolla è un sito archeologico e naturale. Portate via i vostri rifiuti: qui non passano servizi di pulizia e la bellezza del luogo dipende dal rispetto di chi lo visita.</p>
      </div>
    </div>
  </div>

</BlogPostLayout>
