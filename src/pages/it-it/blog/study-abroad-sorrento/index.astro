---
import BlogPostLayout from '../../../../layouts/BlogPostLayout.astro';

const lang = 'it-it';
const post = {
  title: 'Study Abroad a Sorrento: Studiare in Penisola Sorrentina',
  subtitle: 'Scuole, Programmi Universitari e Vita da Studente sulla Costiera',
  category: 'GUIDE',
  date: '4 Luglio 2026',
  readTime: '11 min',
  image: '/images/study-abroad-sorrento-hero.webp',
  imageAlt: 'Studenti internazionali a Sorrento: scuole di italiano, programmi study abroad e vita universitaria in Penisola Sorrentina',
  path: '/it-it/blog/study-abroad-sorrento/',
};

const metaTitle = 'Study Abroad Sorrento 2026: Scuole, Universita e Vita da Studente';
const metaDescription = 'Guida completa allo study abroad a Sorrento: corsi di italiano, programmi universitari americani (Sant\'Anna Institute, Sorrento Lingue), costi, alloggio, vita da studente in Penisola Sorrentina.';

const breadcrumbs = [
  { name: 'Home', url: '/it-it/' },
  { name: 'Blog', url: '/it-it/blog/' },
  { name: 'Study Abroad Sorrento', url: '/it-it/blog/study-abroad-sorrento/' },
];

const quickInfo = [
  { label: 'Citta', value: 'Sorrento (Penisola Sorrentina)' },
  { label: 'Programmi piu noti', value: 'Sant\'Anna Institute, Sorrento Lingue' },
  { label: 'Durata tipica', value: '4-15 settimane / 1-2 semestri' },
  { label: 'Lingue', value: 'Corsi in italiano e inglese' },
  { label: 'Crediti', value: 'Riconosciuti da universita US/EU' },
  { label: 'Costo medio semestre', value: '8.000-14.000 EUR (vitto + tasse)' },
  { label: 'Alloggio', value: 'Famiglia ospitante o residence' },
  { label: 'Periodo ideale', value: 'Settembre-Dicembre / Gennaio-Maggio' },
];

const faq = [
  { q: 'Quali sono le scuole piu conosciute per study abroad a Sorrento?', a: 'Le due istituzioni di riferimento sono Sant\'Anna Institute (Sorrento Lingue), partner di numerose universita americane (Loyola University Chicago, fra le altre), e Centro Linguistico Internazionale di Sorrento. Entrambe offrono corsi di italiano per stranieri, programmi accademici e gite culturali sulla Costiera. I crediti sono riconosciuti dalle universita di origine.' },
  { q: 'Quanto costa un semestre di study abroad a Sorrento?', a: 'Il costo varia tra 8.000 e 14.000 euro a semestre. La cifra include solitamente le tasse accademiche, l\'alloggio (famiglia ospitante o residence studentesco), alcuni pasti, escursioni culturali e supporto amministrativo. Il volo, le spese personali e i pasti fuori orario sono extra. Le borse di studio sono disponibili tramite l\'universita di origine.' },
  { q: 'Quali corsi vengono offerti?', a: 'I corsi piu comuni sono: lingua italiana (livelli A1-C2), storia dell\'arte italiana, archeologia (con visite a Pompei ed Ercolano), enogastronomia, cinema italiano, business mediterraneo, fotografia, scrittura creativa. Molti programmi includono visite settimanali a siti culturali della Campania e Italia meridionale.' },
  { q: 'Si puo vivere a Sorrento senza sapere l\'italiano?', a: 'Si, Sorrento e una delle citta italiane piu cosmopolite e abituata al turismo internazionale. L\'inglese e parlato in larga parte. Pero la vera esperienza dello study abroad nasce proprio dall\'immersione linguistica: l\'80% degli studenti che frequentano corsi di italiano raggiunge un livello B1 in 12-15 settimane.' },
  { q: 'Dove vivono gli studenti?', a: 'Le due opzioni principali sono: (1) famiglia ospitante, che offre immersione linguistica e culturale piu profonda, due pasti al giorno e supporto personale; (2) residence/appartamenti condivisi, che danno piu autonomia e vita sociale tra studenti. Entrambe le soluzioni sono organizzate dalla scuola e si trovano a 10-20 minuti a piedi dal campus.' },
  { q: 'Come si arriva e ci si muove a Sorrento?', a: 'Sorrento e collegata a Napoli dalla Circumvesuviana (treno locale, 70 minuti) e dagli aliscafi (35 minuti dal porto di Napoli). L\'aeroporto di Capodichino e il piu vicino. In citta tutto e raggiungibile a piedi. Per esplorare la Costiera Amalfitana e Capri, gli studenti usano i bus SITA e i traghetti dal porto.' },
];

const sidebarLinks = [
  { label: 'Sorrento', href: '/it-it/penisola-sorrentina/sorrento/' },
  { label: 'Trasporti: Circumvesuviana', href: '/it-it/guida/bus-sita/' },
  { label: 'Traghetti e aliscafi', href: '/it-it/guida/traghetti/' },
  { label: 'Esperienze a Sorrento', href: '/it-it/esperienze/' },
  { label: 'Tour della Penisola Sorrentina', href: '/it-it/penisola-sorrentina/' },
];

const relatedArticles = [
  {
    title: 'Sorrento vs Praiano',
    category: 'GUIDE',
    date: '4 Maggio 2026',
    image: '/images/sorrento-vs-praiano-hero.webp',
    imageAlt: 'Sorrento e Praiano: confronto fra basi di soggiorno in Costiera',
    path: '/it-it/blog/sorrento-vs-praiano/'
  },
  {
    title: 'Sorrento vs Amalfi',
    category: 'GUIDE',
    date: '8 Giugno 2026',
    image: '/images/sorrento-vs-amalfi-hero.webp',
    imageAlt: 'Sorrento e Amalfi: dove alloggiare in Costiera Amalfitana',
    path: '/it-it/blog/sorrento-vs-amalfi/'
  }
];

const authorRole = 'Education Editor · Penisola Sorrentina';
---

<BlogPostLayout
  lang={lang}
  post={post}
  metaTitle={metaTitle}
  metaDescription={metaDescription}
  breadcrumbs={breadcrumbs}
  quickInfo={quickInfo}
  faq={faq}
  sidebarLinks={sidebarLinks}
  authorRole={authorRole}
  relatedArticles={relatedArticles}
  pageKey="study-abroad-sorrento"
>

  <!-- Intro -->
  <div>
    <p class="text-slate-600 text-xl leading-relaxed mb-6 font-light">
      Sorrento e una delle destinazioni piu amate dagli studenti internazionali in Italia. Una citta delle dimensioni giuste (16.000 abitanti, tutto a piedi), una balaustra a picco sul Golfo di Napoli con il Vesuvio sullo sfondo, e a 30 minuti da Pompei, Capri e la Costiera Amalfitana. Una posizione che trasforma ogni weekend in una lezione di storia, arte o geografia mediterranea.
    </p>
    <p class="text-slate-600 text-lg leading-relaxed">
      Dal 1960 in poi, Sorrento e diventata la base ideale di programmi study abroad universitari americani, europei e asiatici. Questa guida copre le scuole piu importanti, i costi reali del 2026, come scegliere fra famiglia ospitante e residence, e i consigli di chi ha gia vissuto un semestre in Penisola Sorrentina.
    </p>
  </div>

  <!-- Perche Sorrento -->
  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">Perche Sorrento per lo Study Abroad</h2>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      Tre fattori rendono Sorrento una delle destinazioni piu scelte per i semestri all'estero in Italia. Non e un caso che decine di universita americane abbiano qui programmi consolidati da anni.
    </p>
    <div class="space-y-4">
      <div class="bg-white p-6 rounded-[2rem] border border-slate-100 shadow-sm flex gap-5">
        <div class="w-10 h-10 rounded-full bg-med-gold/10 flex-shrink-0 flex items-center justify-center text-med-gold font-bold text-xs sm:text-sm">1</div>
        <div>
          <h4 class="font-bold text-slate-900 mb-1">Dimensioni umane</h4>
          <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Con 16.000 abitanti, Sorrento e abbastanza grande da offrire una vita culturale e sociale ricca, ma abbastanza piccola da non disperdere lo studente. Tutto si raggiunge a piedi in 15 minuti, dai caffe del centro al porto, dai musei alle scuole.</p>
        </div>
      </div>
      <div class="bg-white p-6 rounded-[2rem] border border-slate-100 shadow-sm flex gap-5">
        <div class="w-10 h-10 rounded-full bg-med-gold/10 flex-shrink-0 flex items-center justify-center text-med-gold font-bold text-xs sm:text-sm">2</div>
        <div>
          <h4 class="font-bold text-slate-900 mb-1">Posizione strategica</h4>
          <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Da Sorrento si raggiungono in giornata: Pompei (30 min), Ercolano (40 min), Napoli (70 min), Capri (35 min via aliscafo), Positano e Amalfi (60-90 min via bus o aliscafo). Una posizione che diventa parte integrante del programma accademico, con gite settimanali ai siti UNESCO della Campania.</p>
        </div>
      </div>
      <div class="bg-white p-6 rounded-[2rem] border border-slate-100 shadow-sm flex gap-5">
        <div class="w-10 h-10 rounded-full bg-med-gold/10 flex-shrink-0 flex items-center justify-center text-med-gold font-bold text-xs sm:text-sm">3</div>
        <div>
          <h4 class="font-bold text-slate-900 mb-1">Sicurezza e accoglienza</h4>
          <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Sorrento e fra le citta italiane piu sicure (tasso di criminalita molto basso) e culturalmente abituata al turismo e agli studenti internazionali. I residenti sono accoglienti, l'italiano parlato chiaro, e il sistema sanitario locale funziona con tessera europea o assicurazione studentesca.</p>
        </div>
      </div>
    </div>
  </div>

  <!-- Le scuole -->
  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">Le Scuole Principali</h2>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      A Sorrento sono attive da decenni due istituzioni di riferimento per lo study abroad. Entrambe offrono crediti riconosciuti dalle universita straniere e un'ampia gamma di programmi.
    </p>
    <div class="overflow-hidden rounded-[2rem] border border-slate-100 shadow-sm">
      <table class="w-full text-xs sm:text-sm">
        <thead class="bg-slate-900 text-white">
          <tr>
            <th class="text-left p-5 font-serif font-bold text-med-gold">Scuola</th>
            <th class="text-left p-5 font-serif font-bold text-med-gold">Caratteristiche</th>
          </tr>
        </thead>
        <tbody class="bg-white">
          <tr class="border-b border-slate-100">
            <td class="p-5 font-bold">Sant'Anna Institute (Sorrento Lingue)</td>
            <td class="p-5 text-slate-600">Partner di Loyola University Chicago e di altre 30 universita americane. Sede in un palazzo storico nel centro di Sorrento. Corsi in inglese e italiano. Programmi semestrali e summer.</td>
          </tr>
          <tr class="border-b border-slate-100">
            <td class="p-5 font-bold">Centro Linguistico Internazionale di Sorrento</td>
            <td class="p-5 text-slate-600">Storica scuola di italiano per stranieri, attiva dagli anni '70. Corsi accreditati CILS e CELI. Programmi brevi (1-4 settimane) ed estensivi. Forte componente culturale.</td>
          </tr>
          <tr class="border-b border-slate-100">
            <td class="p-5 font-bold">Sorrento School of Art</td>
            <td class="p-5 text-slate-600">Programmi specifici per studenti d'arte: pittura en plein air, fotografia, storia dell'arte italiana. Workshops settimanali e residenze artistiche.</td>
          </tr>
          <tr>
            <td class="p-5 font-bold">Programmi universitari diretti</td>
            <td class="p-5 text-slate-600">Alcune universita americane gestiscono direttamente la presenza a Sorrento con i propri docenti e studenti. Verificate con il vostro ufficio study abroad le partnership attive.</td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>

  <!-- Costi -->
  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">Costi Reali del Semestre 2026</h2>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      Le cifre sotto sono indicative per un semestre standard (4 mesi). Includere o escludere alcune voci dipende dal pacchetto della scuola.
    </p>
    <div class="grid sm:grid-cols-2 gap-6">
      <div class="bg-white rounded-[2rem] p-8 border border-slate-100 shadow-sm">
        <p class="text-med-gold font-bold text-xs uppercase tracking-wider mb-2">Tasse accademiche</p>
        <h3 class="font-semibold text-charcoal mb-2">5.000-9.000 EUR</h3>
        <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">Corsi, materiali didattici, accesso al campus, supporto amministrativo. La cifra varia in base al numero di crediti e alla scuola.</p>
      </div>
      <div class="bg-white rounded-[2rem] p-8 border border-slate-100 shadow-sm">
        <p class="text-med-gold font-bold text-xs uppercase tracking-wider mb-2">Alloggio + pasti</p>
        <h3 class="font-semibold text-charcoal mb-2">2.500-4.500 EUR</h3>
        <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">Famiglia ospitante (con colazione e cena) o residence con cucina condivisa. Le famiglie sono mediamente piu economiche e immersive.</p>
      </div>
      <div class="bg-white rounded-[2rem] p-8 border border-slate-100 shadow-sm">
        <p class="text-med-gold font-bold text-xs uppercase tracking-wider mb-2">Gite ed escursioni</p>
        <h3 class="font-semibold text-charcoal mb-2">500-1.200 EUR</h3>
        <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">Pompei, Ercolano, Capri, Costiera Amalfitana, Roma. Alcuni programmi le includono nel pacchetto, altri le organizzano come opzionali.</p>
      </div>
      <div class="bg-white rounded-[2rem] p-8 border border-slate-100 shadow-sm">
        <p class="text-med-gold font-bold text-xs uppercase tracking-wider mb-2">Spese personali</p>
        <h3 class="font-semibold text-charcoal mb-2">200-500 EUR/mese</h3>
        <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">Cene fuori, caffe, telefono, swap nei mercati. Sorrento e mediamente piu economica delle grandi citta italiane fuori stagione.</p>
      </div>
    </div>
  </div>

  <!-- Vita da studente -->
  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">Vita da Studente a Sorrento</h2>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      Il quotidiano dello studente study abroad a Sorrento si organizza fra mattina (lezioni), pomeriggio (studio, mare, sport) e sera (vita sociale nel centro storico). La citta cambia volto fra alta e bassa stagione.
    </p>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      <strong>Settembre-Novembre</strong>: stagione perfetta. Tempo ancora mite, mare fino a inizio ottobre, meno turisti, prezzi piu bassi. La citta torna nelle mani dei sorrentini e gli studenti vivono un'esperienza piu autentica.
    </p>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      <strong>Gennaio-Maggio</strong>: clima fresco fra gennaio e marzo (10-15 gradi), poi primavera mediterranea con fioriture e prime giornate di mare. Aprile e maggio sono i mesi piu belli per le gite sulla Costiera Amalfitana.
    </p>
    <p class="text-slate-600 text-lg leading-relaxed">
      <strong>Estate</strong>: corsi estivi brevi (2-6 settimane), citta piena di turisti, mare e cultura ad alta intensita. Bellissimo ma piu caotico e costoso.
    </p>
  </div>

  <!-- Local Tips -->
  <div class="bg-white p-8 rounded-[2rem] shadow-xl border border-slate-100">
    <div class="flex items-center gap-4 mb-6">
      <svg class="w-6 h-6 text-med-gold flex-shrink-0" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M9 18h6"/><path d="M10 22h4"/><path d="M15.09 14c.18-.98.65-1.74 1.41-2.5A4.65 4.65 0 0 0 18 8 6 6 0 0 0 6 8c0 1 .23 2.23 1.5 3.5A4.61 4.61 0 0 1 8.91 14"/></svg>
      <h3 class="text-xl font-bold">5 Consigli per il Tuo Semestre</h3>
    </div>
    <div class="space-y-6">
      <div>
        <p class="font-bold text-slate-900 mb-1">1. Scegli la famiglia ospitante</p>
        <p class="text-slate-600 leading-relaxed text-xs sm:text-sm">Il modo piu veloce per imparare l'italiano e capire la cultura. La cena con la famiglia ospitante e la lezione di lingua piu efficace dell'intero semestre.</p>
      </div>
      <div>
        <p class="font-bold text-slate-900 mb-1">2. Sfrutta il treno Circumvesuviana</p>
        <p class="text-slate-600 leading-relaxed text-xs sm:text-sm">Con la Campania ArteCard si girano i musei e Pompei a meta prezzo. Un weekend di archeologia costa meno di 50 euro tutto compreso.</p>
      </div>
      <div>
        <p class="font-bold text-slate-900 mb-1">3. Iscriviti a un'attivita locale</p>
        <p class="text-slate-600 leading-relaxed text-xs sm:text-sm">Corsi di cucina, ceramica, fotografia o pesca artigianale alla Marina Grande. E il modo migliore per conoscere sorrentini fuori dal circuito accademico.</p>
      </div>
      <div>
        <p class="font-bold text-slate-900 mb-1">4. Pianifica weekend in Costiera</p>
        <p class="text-slate-600 leading-relaxed text-xs sm:text-sm">In bassa stagione gli hotel a <a href="/it-it/costiera-amalfitana/amalfi/" class="text-med-blue hover:underline">Amalfi</a> o <a href="/it-it/costiera-amalfitana/praiano/" class="text-med-blue hover:underline">Praiano</a> costano la meta. Un weekend lontano da Sorrento aiuta a vedere la regione in profondita.</p>
      </div>
      <div>
        <p class="font-bold text-slate-900 mb-1">5. Compra al mercato comunale</p>
        <p class="text-slate-600 leading-relaxed text-xs sm:text-sm">Il mercato di Sorrento (martedi mattina) e il modo piu economico per fare la spesa. Frutta, verdura, formaggi e pesce a prezzi locali. Una scuola di italiano applicato che vale piu di un libro di testo.</p>
      </div>
    </div>
  </div>

</BlogPostLayout>
