---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import CorrelationSlider from '../../../../components/CorrelationSlider.astro';
import Breadcrumbs from '../../../../components/Breadcrumbs.astro';

const lang = 'it-it';

const breadcrumbs = [
  { name: 'Home', url: '/it-it/' },
  { name: 'Penisola Sorrentina', url: '/it-it/penisola-sorrentina/' },
  { name: 'Meta', url: '/it-it/penisola-sorrentina/meta/' },
];

const touristAttractionSchema = {
  "@context": "https://schema.org",
  "@type": "TouristAttraction",
  "name": "Meta di Sorrento",
  "description": "Meta di Sorrento e un borgo autentico della Penisola Sorrentina, famoso per la spiaggia di Alimuri, la Basilica della Madonna del Lauro, i cantieri navali storici e un'atmosfera locale lontana dal turismo di massa.",
  "url": "https://amalficoast-travel.com/it-it/penisola-sorrentina/meta/",
  "touristType": ["Mare", "Cultura", "Autenticita", "Famiglie"],
  "address": { "@type": "PostalAddress", "addressLocality": "Meta", "addressRegion": "Napoli", "addressCountry": "IT", "postalCode": "80062" },
  "geo": { "@type": "GeoCoordinates", "latitude": 40.6412, "longitude": 14.4097 }
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Come arrivare a Meta di Sorrento?",
      "acceptedAnswer": { "@type": "Answer", "text": "In treno: la Circumvesuviana ferma a Meta (fermata Meta, una prima di Sorrento). Da Napoli circa 65 minuti. In auto: SS145 Sorrentina. Meta e a soli 3 km da Sorrento ed e raggiungibile anche a piedi in 30 minuti lungo il Corso Italia." }
    },
    {
      "@type": "Question",
      "name": "Meta ha spiagge?",
      "acceptedAnswer": { "@type": "Answer", "text": "Si, la spiaggia di Alimuri e la piu grande e famosa: una lingua di sabbia scura raggiungibile tramite ascensore o scalinata dalla scogliera. C'e anche la spiaggia dei Marinai, piu piccola e tranquilla. Entrambe hanno stabilimenti attrezzati." }
    },
    {
      "@type": "Question",
      "name": "Meta e meglio di Sorrento per dormire?",
      "acceptedAnswer": { "@type": "Answer", "text": "Per chi cerca prezzi piu bassi e un'atmosfera meno turistica, si. Gli hotel e i B&B a Meta costano il 20-30% in meno rispetto a Sorrento, e la Circumvesuviana ti porta ovunque. E anche piu tranquilla la sera." }
    },
    {
      "@type": "Question",
      "name": "Cosa vedere a Meta di Sorrento?",
      "acceptedAnswer": { "@type": "Answer", "text": "La Basilica della Madonna del Lauro (con la statua miracolosa e gli affreschi), il centro storico con i palazzi nobiliari, la spiaggia di Alimuri, il Museo Navale (cantieri navali storici). Da Meta parte anche il sentiero per Positano attraverso i Colli di San Pietro." }
    },
    {
      "@type": "Question",
      "name": "Perche Meta e famosa per la marineria?",
      "acceptedAnswer": { "@type": "Answer", "text": "Meta era il principale centro di costruzione navale della Penisola Sorrentina. I cantieri di Meta costruivano velieri e brigantini che navigavano nel Mediterraneo e nell'Atlantico. La tradizione marittima e ancora visibile nei palazzi dei capitani di mare e nel Museo Navale." }
    }
  ]
};

const schemas = [touristAttractionSchema, faqSchema];

const fastFacts = [
  { dt: 'Posizione', dd: 'Penisola Sorrentina, NA' },
  { dt: 'Altitudine', dd: '~100 m slm' },
  { dt: 'Popolazione', dd: '~8.000 abitanti' },
  { dt: 'Da Sorrento', dd: '3 km / 5 min' },
  { dt: 'Da Napoli', dd: '65 min (Circumvesuviana)' },
  { dt: 'Spiaggia', dd: 'Alimuri (sabbia scura)' },
  { dt: 'Specialita', dd: 'Limoncello, pesce, pasta' },
  { dt: 'Miglior periodo', dd: 'Apr-Ott' },
  { dt: 'Ideale per', dd: 'Base economica, famiglie' },
];

const tips = [
  'Meta e una base perfetta e piu economica di Sorrento: stessa fermata Circumvesuviana, prezzi hotel 20-30% in meno.',
  'La spiaggia di Alimuri e raggiungibile con l\'ascensore dalla scogliera: evita la scalinata se viaggi con bambini o passeggini.',
  'Il gelato artigianale di Meta e celebre nella zona: cerca le gelaterie nel centro storico lungo via Municipio.',
  'Da Meta parte il sentiero dei Colli di San Pietro verso Positano: un trekking panoramico alternativo alla SS163.',
];
---

<BaseLayout
  title="Meta di Sorrento 2026: Spiaggia di Alimuri, Basilica del Lauro e Cantieri Navali"
  description="Guida a Meta di Sorrento: la spiaggia di Alimuri, la Basilica della Madonna del Lauro, la tradizione marinara. Base economica e autentica per esplorare la Penisola Sorrentina."
  lang={lang}
  breadcrumbs={breadcrumbs}
  schema={schemas}
  pageKey="meta"

  heroImage="/images/meta-hero.webp"
>

  <!-- Hero -->
  <section class="relative h-[75vh] sm:h-[90vh] flex items-center bg-charcoal overflow-hidden">
    <img src="/images/meta-hero.webp" alt="Meta di Sorrento, Penisola Sorrentina" class="absolute inset-0 w-full h-full object-cover" loading="eager" fetchpriority="high" decoding="sync" referrerpolicy="no-referrer"/>
    <div class="absolute inset-0 bg-gradient-to-b from-black/10 via-black/40 to-black/80 z-10"></div>
    <div class="relative z-20 max-w-editorial mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <p class="text-med-gold text-xs sm:text-sm font-medium uppercase tracking-[0.3em] mb-3">Penisola Sorrentina - Terra di Marinai</p>
        <h1 class="font-serif text-display text-white mb-4">Meta di Sorrento</h1>
        <p class="text-xl text-white/80 leading-relaxed max-w-2xl">
          Borgo di capitani di mare e cantieri navali. La spiaggia di Alimuri, la Basilica del Lauro e un'atmosfera autentica a 3 km da Sorrento.
        </p>
        <div class="flex flex-wrap gap-3 mt-8">
          <a href="#fast-facts" class="px-5 py-2.5 bg-med-gold text-white text-xs sm:text-sm font-semibold rounded-full hover:scale-105 hover:shadow-[0_8px_25px_rgba(212,175,55,0.4)] transition-all duration-300">Fast Facts</a>
          <a href="#come-arrivare" class="px-5 py-2.5 bg-white/10 backdrop-blur text-white text-xs sm:text-sm font-medium rounded-full border border-white/20 hover:bg-white/20 transition-colors">Come arrivare</a>
          <a href="#faq" class="px-5 py-2.5 bg-white/10 backdrop-blur text-white text-xs sm:text-sm font-medium rounded-full border border-white/20 hover:bg-white/20 transition-colors">FAQ</a>
        </div>
      </div>
    </div>
    <Breadcrumbs breadcrumbs={breadcrumbs} />
  </section>

  <section class="max-w-editorial mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="grid lg:grid-cols-[1fr_320px] gap-12">

      <div class="space-y-16">

        <div class="prose-editorial">
          <p class="text-xl leading-relaxed text-charcoal">
            Meta di Sorrento e il borgo che i turisti attraversano in Circumvesuviana senza scendere, una fermata prima di <a href="/it-it/penisola-sorrentina/sorrento/" class="text-med-blue hover:underline">Sorrento</a>. Eppure Meta ha tutto cio che serve per una vacanza perfetta: una spiaggia di sabbia, una basilica spettacolare, un centro storico silenzioso e prezzi piu accessibili della vicina Sorrento.
          </p>
          <p class="mt-4 text-slate-600 leading-relaxed">
            La storia di Meta e scritta nel mare: per secoli e stata il principale centro di costruzione navale della Penisola Sorrentina. I cantieri di Meta costruivano velieri che navigavano nel Mediterraneo e nell'Atlantico. Ancora oggi, i palazzi dei capitani di mare nel centro storico testimoniano la ricchezza portata dal commercio marittimo.
          </p>
        </div>

        <!-- Lo Sapevi -->
        <div class="bg-slate-900 border border-white/10 rounded-[3rem] p-8">
          <p class="text-[10px] uppercase tracking-[0.3em] text-med-gold font-medium mb-4">Lo sapevi?</p>
          <div class="grid sm:grid-cols-3 gap-6">
            <div class="text-center">
              <p class="font-serif text-5xl font-bold text-med-gold">3 km</p>
              <p class="text-white/60 text-xs italic mt-1">da Sorrento, raggiungibile a piedi</p>
            </div>
            <div class="text-center">
              <p class="font-serif text-5xl font-bold text-med-gold">XVIII sec.</p>
              <p class="text-white/60 text-xs italic mt-1">apice dei cantieri navali metesi</p>
            </div>
            <div class="text-center">
              <p class="font-serif text-5xl font-bold text-med-gold">-30%</p>
              <p class="text-white/60 text-xs italic mt-1">costo hotel rispetto a Sorrento</p>
            </div>
          </div>
        </div>

        <!-- Cosa Vedere -->
        <div>
          <h2 class="font-serif text-3xl font-semibold text-slate-900 mb-8">Cosa vedere a Meta</h2>
          <div class="space-y-8">
            {[
              { n: 1, title: 'Basilica della Madonna del Lauro', text: 'La chiesa piu importante di Meta, dedicata alla Madonna del Lauro venerata in tutta la Penisola. Interno barocco con affreschi, marmi policromi e la statua miracolosa della Vergine. La facciata domina la piazza principale del borgo.' },
              { n: 2, title: 'Spiaggia di Alimuri', text: 'La spiaggia principale di Meta: una striscia di sabbia scura vulcanica sotto la scogliera, raggiungibile con ascensore o scalinata. Stabilimenti attrezzati e tratto libero. Acque limpide e vista sulla costa. Meno affollata delle spiagge di Sorrento.' },
              { n: 3, title: 'Centro storico e palazzi dei capitani', text: 'Via Municipio e le stradine circostanti conservano i palazzi nobiliari dei capitani di mare del XVIII-XIX secolo. Portali in piperno, cortili interni e balconate in ferro battuto raccontano la ricchezza della marineria metese.' },
              { n: 4, title: 'Museo Navale', text: 'Il piccolo museo che racconta la tradizione cantieristica di Meta: modelli di velieri, strumenti di navigazione, carte nautiche e fotografie d\'epoca dei cantieri. Ingresso gratuito o a offerta libera.' },
              { n: 5, title: 'Sentiero dei Colli di San Pietro', text: 'Un trekking panoramico che parte da Meta e attraversa i colli fino a Positano. Circa 4 ore di cammino tra limoneti, uliveti e viste sul Golfo. Alternativa spettacolare alla SS163.' },
            ].map(({ n, title, text }) => (
              <div class="grid sm:grid-cols-[auto_1fr] gap-4">
                <div class="w-14 h-14 rounded-[1rem] bg-med-gold/10 flex items-center justify-center flex-shrink-0 text-med-gold font-serif font-bold text-xl">{n}</div>
                <div>
                  <h3 class="font-semibold text-charcoal text-lg mb-1">{title}</h3>
                  <p class="text-slate-600 leading-relaxed">{text}</p>
                </div>
              </div>
            ))}
          </div>
        </div>

        <!-- Come arrivare -->
        <div id="come-arrivare">
          <h2 class="font-serif text-3xl font-semibold text-slate-900 mb-6">Come arrivare a Meta</h2>
          <div class="space-y-6">
            <div class="bg-white rounded-[3rem] p-8 border border-slate-100 hover:shadow-xl transition-all duration-300">
              <h3 class="font-semibold text-charcoal mb-3">Circumvesuviana</h3>
              <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">Fermata "Meta" sulla linea Napoli-Sorrento. Da Napoli Centrale circa 65 minuti (~3.90 euro). Una fermata prima di Sorrento. Frequenza: ogni 30-40 min.</p>
            </div>
            <div class="bg-white rounded-[3rem] p-8 border border-slate-100 hover:shadow-xl transition-all duration-300">
              <h3 class="font-semibold text-charcoal mb-3">Da Sorrento</h3>
              <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">A piedi lungo il Corso Italia in circa 30 minuti. In Circumvesuviana 3 minuti. In auto 5 minuti sulla SS145. Meta e praticamente contigua a Sorrento.</p>
            </div>
          </div>
        </div>

        <!-- Consiglio Local -->
        <div class="relative overflow-hidden rounded-[3rem] bg-med-blue p-10 md:p-14 text-white shadow-2xl">
          <div class="relative z-10 flex flex-col md:flex-row items-start md:items-center gap-8">
            <div class="w-20 h-20 rounded-2xl bg-white/10 flex items-center justify-center flex-shrink-0 border border-white/20"><svg class="w-10 h-10 text-med-gold" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 3v2.25m6.364.386-1.591 1.591M21 12h-2.25m-.386 6.364-1.591-1.591M12 18.75V21m-4.773-4.227-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0Z"/></svg></div>
            <div>
              <p class="text-med-gold text-xs font-bold uppercase tracking-[0.3em] mb-2">Consiglio Local</p>
              <h3 class="font-serif text-2xl font-bold text-white mb-3 tracking-tight">La base segreta per la Penisola</h3>
              <p class="text-white/70 leading-relaxed">Dormi a Meta invece che a Sorrento: stessa Circumvesuviana, stessi collegamenti per Capri, Costiera e Napoli, ma hotel e ristoranti costano il 20-30% in meno. La sera, il centro di Meta e tranquillo e autentico.</p>
            </div>
          </div>
          <div class="absolute bottom-0 left-0 translate-y-1/2 -translate-x-1/2 w-80 h-80 bg-med-gold/10 rounded-full blur-3xl pointer-events-none"></div>
        </div>

        <!-- FAQ -->
        <div id="faq">
          <h2 class="font-serif text-3xl font-semibold text-slate-900 mb-8">Domande frequenti su Meta</h2>
          <div class="space-y-4">
            {faqSchema.mainEntity.map((q) => (
              <details class="group border border-slate-200 rounded-2xl overflow-hidden">
                <summary class="flex items-center justify-between px-6 py-4 cursor-pointer select-none text-charcoal font-medium hover:bg-slate-50 transition-colors">
                  {q.name}
                  <svg class="w-4 h-4 text-slate-400 group-open:rotate-180 transition-transform flex-shrink-0 ml-3" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
                </summary>
                <div class="px-6 pb-5 text-slate-600 leading-relaxed text-xs sm:text-sm border-t border-slate-100 pt-4">
                  {q.acceptedAnswer.text}
                </div>
              </details>
            ))}
          </div>
        </div>

      </div>

      <aside class="space-y-6 lg:sticky lg:top-24 self-start">
        <div id="fast-facts" class="bg-slate-900 text-white rounded-[3rem] p-6">
          <p class="text-[10px] uppercase tracking-[0.3em] text-med-gold font-medium mb-4">Fast Facts - Meta</p>
          <dl class="space-y-3">
            {fastFacts.map(({ dt, dd }, i) => (
              <>
                <div class="flex justify-between items-start gap-3">
                  <dt class="text-white/40 text-xs sm:text-sm font-light flex-shrink-0">{dt}</dt>
                  <dd class="text-white font-medium text-xs sm:text-sm text-right">{dd}</dd>
                </div>
                {i < fastFacts.length - 1 && <div class="border-t border-white/5"></div>}
              </>
            ))}
          </dl>
        </div>

        <div class="bg-med-cream border border-med-gold/30 rounded-[2rem] p-6">
          <p class="text-[10px] uppercase tracking-[0.3em] text-med-gold font-medium mb-3">Consigli degli insider</p>
          <ul class="space-y-3">
            {tips.map(tip => (
              <li class="flex items-start gap-2 text-xs sm:text-sm text-charcoal">
                <span class="w-1.5 h-1.5 rounded-full bg-med-gold mt-1.5 flex-shrink-0"></span>
                <span>{tip}</span>
              </li>
            ))}
          </ul>
        </div>

        <div class="bg-white border border-slate-100 rounded-[2rem] p-6 shadow-sm">
          <p class="text-[10px] uppercase tracking-[0.3em] text-slate-400 font-medium mb-3">Penisola Sorrentina</p>
          <nav class="space-y-1">
            {[
              { href: '/it-it/penisola-sorrentina/sorrento/', label: 'Sorrento' },
              { href: '/it-it/penisola-sorrentina/vico-equense/', label: 'Vico Equense' },
              { href: '/it-it/penisola-sorrentina/massa-lubrense/', label: 'Massa Lubrense' },
              { href: '/it-it/penisola-sorrentina/sant-agnello/', label: 'Sant\'Agnello' },
            ].map(({ href, label }) => (
              <a href={href} class="flex items-center gap-2 px-3 py-2 rounded-xl text-xs sm:text-sm text-charcoal hover:bg-med-blue/5 hover:text-med-blue transition-colors">
                <span class="w-1.5 h-1.5 rounded-full bg-med-blue/30"></span> {label}
              </a>
            ))}
          </nav>
        </div>
      </aside>

    </div>
  </section>

  <CorrelationSlider
    heading="Esplora anche"
    items={[
      { name: 'Sorrento',       href: '/it-it/penisola-sorrentina/sorrento/',       tag: 'Hub & Limoncello', desc: 'Piazza Tasso, il Chiostro e il punto di partenza per Capri.' },
      { name: 'Vico Equense',   href: '/it-it/penisola-sorrentina/vico-equense/',   tag: 'Pizza al Metro',   desc: 'La pizza al metro di Da Gigino e il Castello Giusso.' },
      { name: 'Massa Lubrense', href: '/it-it/penisola-sorrentina/massa-lubrense/', tag: 'Natura & Cucina',  desc: 'Punta Campanella e gli spaghetti alla Nerano.' },
      { name: 'Positano',       href: '/it-it/costiera-amalfitana/positano/',       tag: 'Fashion & Vista',  desc: 'Le case colorate a picco sul mare della Costiera.' },
      { name: 'Capri',          href: '/it-it/isole/capri/',                        tag: 'La piu iconica',   desc: 'Grotta Azzurra, Faraglioni e la Piazzetta.' },
    ]}
    lang="it-it"
  />

</BaseLayout>
