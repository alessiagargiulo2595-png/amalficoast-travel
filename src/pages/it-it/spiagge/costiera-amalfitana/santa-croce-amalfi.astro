---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../../components/Breadcrumbs.astro';
import CorrelationSlider from '../../../../components/CorrelationSlider.astro';

const lang = 'it-it';

const breadcrumbs = [
  { name: 'Home', url: '/it-it/' },
  { name: 'Spiagge', url: '/it-it/spiagge/' },
  { name: 'Santa Croce', url: '/it-it/spiagge/costiera-amalfitana/santa-croce-amalfi/' },
];

const facts = [
  { label: 'Composizione', value: 'Ciottoli bianchi (calcare dei Lattari)' },
  { label: 'Accesso', value: 'Solo via mare (Taxi Boat)' },
  { label: 'Ombra', value: 'Dalle 16:00' },
  { label: 'Servizi', value: '2 Ristoranti con lido' },
  { label: 'Ideale per', value: 'Fuga romantica, pesce fresco' },
  { label: 'Distanza da Amalfi', value: 'Circa 5 minuti in barca' },
  { label: 'Costo taxi boat', value: '€5–€8 a/r a persona' },
  { label: 'Navetta ristorante', value: 'Gratuita per i clienti' },
  { label: 'Snorkeling', value: 'Eccellente lungo le pareti' },
  { label: 'Origini', value: 'X secolo (chiesa medievale)' },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Come si arriva alla spiaggia di Santa Croce ad Amalfi?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Santa Croce è raggiungibile esclusivamente via mare. Dal molo principale di Amalfi partono taxi boat che impiegano circa 5 minuti per arrivare. Il costo è di circa €5–€8 a persona per andata e ritorno. In alternativa, i ristoranti Da Teresa e Il Pirata offrono una navetta gratuita per i propri clienti: basta prenotare il pranzo con anticipo e la barca è inclusa."
      }
    },
    {
      "@type": "Question",
      "name": "Quanto costa il taxi boat per Santa Croce?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Il taxi boat dal molo di Amalfi a Santa Croce costa circa €5–€8 a persona per l'andata e il ritorno. I prezzi possono variare leggermente in alta stagione. Per risparmiare, prenota il pranzo al ristorante: la navetta per i clienti è completamente gratuita ed è anche il modo più scenografico per arrivare."
      }
    },
    {
      "@type": "Question",
      "name": "Quali ristoranti ci sono a Santa Croce?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Sulla spiaggia di Santa Croce ci sono due ristoranti storici: Da Teresa (già nota come Da Gemma), attiva dagli anni '50 con ricette di pesce tradizionali tra cui i celebri scialatielli ai frutti di mare, e Il Pirata, ricavato direttamente nella roccia della scogliera. Entrambi hanno lidi privati con lettini e ombrelloni e offrono navetta gratuita dal molo di Amalfi per i propri clienti."
      }
    },
    {
      "@type": "Question",
      "name": "È adatta ai bambini la spiaggia di Santa Croce?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Santa Croce è adatta ai bambini più grandi e agli adulti, ma richiede un po' di attenzione. La spiaggia è di ciottoli bianchi (non sabbia), quindi consigliamo le ciabatte da scoglio. L'acqua è limpida e relativamente calma, ma l'accesso in barca può risultare un po' movimentato con bambini piccoli. Per i bambini in età prescolare, meglio valutare alternative con ingresso più facile."
      }
    },
    {
      "@type": "Question",
      "name": "Come è lo snorkeling a Santa Croce Amalfi?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Lo snorkeling a Santa Croce è eccellente. Il fondale roccioso lungo le pareti della scogliera ospita prati di posidonia, saraghi, polpi e anemoni di mare. La visibilità è molto buona grazie alle acque calme e protette. In anni recenti sono stati segnalati anche avvistamenti della foca monaca (Monachus monachus) nell'area — uno spettacolo rarissimo nel Mediterraneo. Portate la vostra attrezzatura perché non ci sono noleggi in loco."
      }
    }
  ]
};

const beachSchema = {
  "@context": "https://schema.org",
  "@type": "Beach",
  "name": "Spiaggia di Santa Croce",
  "description": "Spiaggia esclusiva raggiungibile solo via mare da Amalfi, famosa per le acque trasparenti e i ristoranti storici.",
  "isAccessibleForFree": "false",
  "address": {
    "@type": "PostalAddress",
    "addressLocality": "Amalfi",
    "addressRegion": "SA",
    "addressCountry": "IT"
  }
};

const nearbyBeaches = [
  { name: 'Fiordo di Furore', href: '/it-it/spiagge/costiera-amalfitana/fiordo-di-furore/', tag: 'Furore', desc: "Il fiordo più iconico d'Italia." },
  { name: 'Marina di Praia', href: '/it-it/spiagge/costiera-amalfitana/marina-di-praia/', tag: 'Praiano', desc: 'Spiaggia selvaggia con tramonto perfetto.' },
  { name: 'Spiaggia Grande', href: '/it-it/spiagge/costiera-amalfitana/spiaggia-grande-positano/', tag: 'Positano', desc: 'Il cuore mondano della Costiera.' },
  { name: 'Regina Giovanna', href: '/it-it/spiagge/penisola-sorrentina/regina-giovanna/', tag: 'Sorrento', desc: 'Piscina naturale con villa romana.' },
];
---

<BaseLayout
  title="Spiaggia di Santa Croce Amalfi: Come arrivare via Mare"
  description="Santa Croce è la fuga perfetta da Amalfi. Raggiungibile solo in barca, con acque cristalline e ristoranti storici con navetta gratuita."
  lang={lang}
  breadcrumbs={breadcrumbs}
  schema={[beachSchema, faqSchema]}
 pageKey="santa-croce-amalfi">

  <!-- Hero -->
  <section class="relative h-[52.5vh] sm:h-[70vh] overflow-hidden flex items-center justify-center">
    <img
      src="/images/santa-croce-hero.jpg"
      alt="Spiaggia di Santa Croce, Amalfi"
      class="absolute inset-0 w-full h-full object-cover"
      loading="eager"
      referrerpolicy="no-referrer"
    />
    <div class="absolute inset-0 hidden sm:block bg-gradient-to-b from-black/20 via-black/35 to-black/70"></div>
    <div class="relative z-10 text-center px-6 max-w-4xl text-white">
      <p class="text-med-gold text-xs sm:text-sm font-medium uppercase tracking-[0.3em] mb-3">Amalfi · Solo via Mare</p>
      <h1 class="font-serif text-display text-white mb-6">Santa Croce</h1>
      <p class="text-lg md:text-xl font-light text-white/80">La fuga segreta a pochi minuti dal caos di Amalfi.</p>
    </div>
    <Breadcrumbs breadcrumbs={breadcrumbs} />
  </section>

  <!-- Contenuto + Sidebar -->
  <section class="bg-med-cream py-24 px-6">
    <div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-3 gap-16">

      <!-- Testo principale -->
      <div class="lg:col-span-2 space-y-12">
        <div>
          <h2 class="font-serif text-4xl font-bold text-slate-900 mb-6">La Fuga Perfetta da Amalfi</h2>
          <p class="text-slate-600 text-lg leading-relaxed mb-6">
            Santa Croce è la risposta al caos di luglio e agosto ad <a href="/it-it/costiera-amalfitana/amalfi/" class="text-med-blue hover:underline">Amalfi</a>. Raggiungibile solo con pochi minuti di barca dal molo principale, offre acque di una trasparenza incredibile su fondali rocciosi. La spiaggia di ciottoli bianchi è raccolta tra alte scogliere che la proteggono dal vento.
          </p>
          <p class="text-slate-600 text-lg leading-relaxed">
            I due ristoranti storici - Da Teresa e Il Pirata - hanno lidi privati sulla spiaggia e offrono navette gratuite dal molo di Amalfi per i propri clienti. È l'ideale per chi vuole una giornata di mare "selvaggia" ma con il comfort di un ottimo pranzo a base di pesce freschissimo.
          </p>
        </div>

        <!-- Consiglio locale -->
        <div class="bg-white p-8 rounded-[2rem] shadow-xl border border-slate-100">
          <div class="flex items-center gap-4 mb-4">
            <svg class="w-6 h-6 text-med-gold flex-shrink-0" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M9 18h6"/><path d="M10 22h4"/><path d="M15.09 14c.18-.98.65-1.74 1.41-2.5A4.65 4.65 0 0 0 18 8 6 6 0 0 0 6 8c0 1 .23 2.23 1.5 3.5A4.61 4.61 0 0 1 8.91 14"/></svg>
            <h3 class="text-xl font-bold">Consiglio Local</h3>
          </div>
          <p class="text-slate-600 leading-relaxed">
            Prenota il pranzo al ristorante con anticipo: ti offrono la navetta dal molo <strong>gratuitamente</strong> per i clienti. È il modo più economico (e più scenografico) per arrivare a Santa Croce.
          </p>
        </div>

        <!-- Storia -->
        <div>
          <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">Storia: La Cala Segreta della Repubblica</h2>
          <p class="text-slate-600 text-lg leading-relaxed mb-6">
            La piccola insenatura prende il nome dall'antica <strong>chiesa di Santa Croce</strong>, costruita dai monaci amalfitani intorno al X secolo sulle rocce che dominano la cala. Nelle pareti della scogliera sono ancora visibili resti di strutture medievali: archi murati, fondamenta di pietra calcarea e nicchie scolpite nella roccia.
          </p>
          <p class="text-slate-600 text-lg leading-relaxed mb-6">
            In epoca medievale, la cala fu strategicamente importante per la <strong>Repubblica di Amalfi</strong> (839–1137), una delle quattro Repubbliche Marinare italiane e cuore pulsante dell'intera <a href="/it-it/costiera-amalfitana/" class="text-med-blue hover:underline">Costiera Amalfitana</a>. Protetta dalle tempeste e nascosta agli occhi dei pirati, serviva come porto secondario e cantiere navale per le imbarcazioni mercantili. La posizione riparata, con l'apertura stretta verso il mare aperto, la rendeva ideale per operazioni discrete e per il ricovero delle navi durante i mesi invernali.
          </p>
          <p class="text-slate-600 text-lg leading-relaxed">
            I ciottoli bianchi che ricoprono la spiaggia non sono sabbia ma <strong>frammenti di calcare</strong> distaccatisi dalle Monti Lattari nel corso dei secoli — la stessa roccia che forma le pareti verticali del fiordo — levigati da secoli di moto ondoso fino ad assumere la consistenza quasi sferica che li caratterizza oggi.
          </p>
        </div>

        <!-- Stats -->
        <div class="bg-slate-900 text-white p-8 rounded-[2rem] grid grid-cols-2 sm:grid-cols-4 gap-6 text-center">
          <div>
            <p class="text-med-gold text-3xl font-bold">X</p>
            <p class="text-white/60 text-sm mt-1">sec. – chiesa originale</p>
          </div>
          <div>
            <p class="text-med-gold text-3xl font-bold">5'</p>
            <p class="text-white/60 text-sm mt-1">in barca da Amalfi</p>
          </div>
          <div>
            <p class="text-med-gold text-3xl font-bold">839</p>
            <p class="text-white/60 text-sm mt-1">fondazione Repubblica</p>
          </div>
          <div>
            <p class="text-med-gold text-3xl font-bold">2</p>
            <p class="text-white/60 text-sm mt-1">ristoranti storici</p>
          </div>
        </div>

        <!-- Vita marina -->
        <div>
          <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">Snorkeling e Vita Sottomarina</h2>
          <p class="text-slate-600 text-lg leading-relaxed mb-6">
            Il fondale di Santa Croce è tra i più ricchi della Costiera. Le pareti rocciose sommerse ospitano fitti prati di <strong>posidonia oceanica</strong> — la pianta marina più importante del Mediterraneo — che fungono da nursery per decine di specie. Lungo le pareti si muovono banchi di saraghi (orate selvatiche), polpi mimetizzati tra le anfrattuosità e vivaci anemoni di mare.
          </p>
          <p class="text-slate-600 text-lg leading-relaxed mb-6">
            Lo snorkeling è eccellente lungo le pareti della scogliera, dove la visibilità raggiunge i 15–20 metri nelle giornate di bonaccia. In anni recenti, alcune segnalazioni certificano la presenza occasionale della <strong>foca monaca</strong> (<em>Monachus monachus</em>) nell'area — uno degli animali più rari del Mediterraneo, con meno di 600 esemplari stimati. La presenza indica la qualità eccezionale di queste acque, paragonabile solo alle calette selvagge nei dintorni di <a href="/it-it/costiera-amalfitana/positano/" class="text-med-blue hover:underline">Positano</a>.
          </p>
          <p class="text-slate-600 text-lg leading-relaxed">
            Portate la vostra attrezzatura da snorkeling: sulla spiaggia non ci sono noleggi. Le pinne sono consigliate per esplorare le zone più lontane dalla riva.
          </p>
        </div>

        <!-- I ristoranti -->
        <div>
          <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">I Ristoranti Storici</h2>
          <p class="text-slate-600 text-lg leading-relaxed mb-6">
            <strong>Da Teresa</strong> (in origine conosciuta come Da Gemma) è attiva sulla spiaggia sin dagli anni '50. La famiglia ha tramandato di generazione in generazione una cucina di mare autentica, basata sul pescato del giorno. Il piatto simbolo sono gli <em>scialatielli ai frutti di mare</em> — pasta fresca all'uovo con cozze, vongole e gamberi — una ricetta che secondo i locali è nata proprio qui, nelle cucine affacciate sull'acqua.
          </p>
          <p class="text-slate-600 text-lg leading-relaxed">
            <strong>Il Pirata</strong> è invece letteralmente incastonato nella roccia: le sue sale ricavate nella scogliera offrono un'atmosfera unica, quasi grotta, con l'odore del mare che entra attraverso le finestre aperte sull'acqua. Entrambi i ristoranti prenotano il trasporto in barca per i propri clienti — un servizio che rende la visita ancora più speciale.
          </p>
        </div>

        <!-- Consigli dei Locali -->
        <div class="bg-med-cream p-8 rounded-[2rem] border border-med-gold/20">
          <h3 class="font-serif text-2xl font-bold text-slate-900 mb-6">Consigli dei Locali</h3>
          <ul class="space-y-4">
            <li class="flex items-start gap-3">
              <span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span>
              <span class="text-slate-600">Prenota il ristorante con almeno 2–3 giorni di anticipo in estate: la navetta gratuita vale molto più del taxi boat.</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span>
              <span class="text-slate-600">Porta ciabatte da scoglio: i ciottoli bianchi sono belli da guardare ma scomodi a piedi nudi.</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span>
              <span class="text-slate-600">Per lo snorkeling, esplora le pareti della scogliera a destra della spiaggia: è la zona con la maggiore concentrazione di fauna marina.</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span>
              <span class="text-slate-600">Arriva entro le 10 se vuoi un posto in spiaggia: la cala è piccola e i lettini dei ristoranti si esauriscono presto.</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span>
              <span class="text-slate-600">Il rientro ad Amalfi al tramonto, con la luce dorata sulle scogliere, è uno dei momenti più suggestivi dell'intera Costiera.</span>
            </li>
          </ul>
        </div>

        <!-- Come arrivare -->
        <div>
          <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">Come Arrivare</h2>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div class="bg-white p-6 rounded-[2rem] border border-slate-100 shadow-sm">
              <p class="text-med-gold text-xs font-bold uppercase tracking-wider mb-2">Taxi Boat ⭐ Unico accesso</p>
              <p class="text-slate-700 font-medium mb-1">Dal Molo di Amalfi</p>
              <p class="text-slate-500 text-xs sm:text-sm">Circa 5 minuti di traversata. Costo: €5–€8 a persona (andata e ritorno).</p>
            </div>
            <div class="bg-white p-6 rounded-[2rem] border border-slate-100 shadow-sm">
              <p class="text-med-gold text-xs font-bold uppercase tracking-wider mb-2">Navetta Ristorante</p>
              <p class="text-slate-700 font-medium mb-1">Gratuita per clienti</p>
              <p class="text-slate-500 text-xs sm:text-sm">Prenota il pranzo e la barca è inclusa nel servizio.</p>
            </div>
            <div class="bg-white p-6 rounded-[2rem] border border-slate-100 shadow-sm">
              <p class="text-med-gold text-xs font-bold uppercase tracking-wider mb-2">Tour in Kayak</p>
              <p class="text-slate-700 font-medium mb-1">Da Amalfi o Atrani</p>
              <p class="text-slate-500 text-xs sm:text-sm">Alcune guide locali offrono tour in kayak con sosta a Santa Croce.</p>
            </div>
            <div class="bg-white p-6 rounded-[2rem] border border-slate-100 shadow-sm">
              <p class="text-med-gold text-xs font-bold uppercase tracking-wider mb-2">Gommone / Barca privata</p>
              <p class="text-slate-700 font-medium mb-1">Noleggio a Amalfi</p>
              <p class="text-slate-500 text-xs sm:text-sm">Con patente nautica, il noleggio di un gommone permette di combinare più calette.</p>
            </div>
          </div>
        </div>
        <!-- FAQ -->
        <div>
          <h2 class="font-serif text-3xl font-bold text-slate-900 mb-8">Domande Frequenti</h2>
          <div class="space-y-4">
            {faqSchema.mainEntity.map((q) => (
              <details class="group border border-slate-200 rounded-2xl overflow-hidden bg-white">
                <summary class="flex items-center justify-between px-6 py-4 cursor-pointer select-none text-charcoal font-medium hover:bg-slate-50 transition-colors">
                  {q.name}
                  <svg class="w-4 h-4 text-slate-400 group-open:rotate-180 transition-transform flex-shrink-0 ml-3" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
                </summary>
                <div class="px-6 pb-5 text-slate-600 leading-relaxed text-xs sm:text-sm border-t border-slate-100 pt-4">
                  {q.acceptedAnswer.text}
                </div>
              </details>
            ))}
          </div>
        </div>
      </div>

      <!-- Sidebar Fast-Facts -->
      <aside class="lg:col-span-1">
        <div class="bg-slate-900 text-white p-10 rounded-[3rem] sticky top-32">
          <h3 class="font-serif text-2xl font-bold mb-8 flex items-center gap-3">
            <svg class="w-6 h-6 text-med-gold" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M2 12c.6.5 1.2 1 2.5 1 2.5 0 2.5-2 5-2 2.6 0 2.4 2 5 2 2.5 0 2.5-2 5-2 1.3 0 1.9.5 2.5 1"/><path d="M2 18c.6.5 1.2 1 2.5 1 2.5 0 2.5-2 5-2 2.6 0 2.4 2 5 2 2.5 0 2.5-2 5-2 1.3 0 1.9.5 2.5 1"/></svg> Fast-Facts
          </h3>
          <div class="space-y-6">
            {facts.map((item) => (
              <div class="border-b border-white/5 pb-4 last:border-0">
                <span class="text-white/40 text-xs sm:text-sm font-light block mb-1">{item.label}</span>
                <span class="text-white font-medium text-xs sm:text-sm">{item.value}</span>
              </div>
            ))}
          </div>
          <div class="mt-10 pt-8 border-t border-white/10">
            <a
              href="/it-it/spiagge/"
              class="inline-flex items-center gap-2 text-med-gold text-xs sm:text-sm font-medium hover:text-white transition-colors"
            >
              ← Tutte le spiagge
            </a>
          </div>
        </div>
      </aside>

    </div>
  </section>

  <!-- Spiagge Vicine -->
  <CorrelationSlider
    title="Spiagge Vicine ad Amalfi"
    items={nearbyBeaches}
    lang="it-it"
  />

  <!-- CTA -->
  <section class="bg-med-blue py-16 text-center">
    <div class="max-w-2xl mx-auto px-6">
      <h2 class="font-serif text-2xl font-bold text-white mb-4">Scopri altre spiagge della Costiera</h2>
      <a
        href="/it-it/spiagge/"
        class="inline-block bg-white text-med-blue font-semibold px-8 py-3 rounded-full hover:bg-med-cream transition-colors"
      >
        Guida completa alle spiagge
      </a>
    </div>
  </section>

</BaseLayout>
