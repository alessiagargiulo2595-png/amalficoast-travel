---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../../components/Breadcrumbs.astro';
import CorrelationSlider from '../../../../components/CorrelationSlider.astro';

const lang = 'it-it';

const breadcrumbs = [
  { name: 'Home', url: '/it-it/' },
  { name: 'Spiagge', url: '/it-it/spiagge/' },
  { name: 'Fiordo di Furore', url: '/it-it/spiagge/costiera-amalfitana/fiordo-di-furore/' },
];

const facts = [
  { label: 'Composizione', value: 'Ciottoli' },
  { label: 'Accesso', value: 'Scale (circa 200 scalini)' },
  { label: 'Ombra', value: 'Dalle 14:30 ⚠️' },
  { label: 'Servizi', value: 'Spiaggia libera' },
  { label: 'Ideale per', value: 'Fotografia, Coppie' },
  { label: 'Altezza ponte', value: '30 metri' },
  { label: 'Evento annuale', value: 'MarMeeting (tuffi dal ponte)' },
  { label: 'Arte', value: 'Paese dipinto – murales internazionali' },
  { label: 'Ruscello', value: 'Torrente Schiato' },
  { label: 'Ingresso', value: 'Gratuito' },
];

const logistica = [
  { mezzo: 'Bus SITA', fermata: 'Furore Fiordo', note: 'Linea Amalfi–Positano' },
  { mezzo: 'Scooter / Auto', fermata: 'Ponte Furore', note: 'Pochi posti bordo strada – arriva presto' },
  { mezzo: 'Traghetto + taxi boat', fermata: 'Da Praiano o Amalfi', note: 'Approdo diretto al fiordo via mare' },
  { mezzo: 'Tour organizzato', fermata: 'Vari punti di partenza', note: 'Include trasporto e guida' },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Come si arriva al Fiordo di Furore?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Il modo più comodo è il Bus SITA sulla linea Amalfi–Positano: scendi alla fermata 'Furore Fiordo', sul ponte stesso. In auto o scooter ci sono pochi posti di sosta lungo la SS163, quindi conviene arrivare presto al mattino. In alternativa, alcuni taxi boat da Praiano e Amalfi offrono l'approdo diretto al fiordo via mare."
      }
    },
    {
      "@type": "Question",
      "name": "Quando è il momento migliore per fotografare il Fiordo di Furore?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Il sole illumina il fondo del fiordo solo tra le 11:00 e le 14:30. La luce migliore per le foto dell'acqua turchese è intorno alle 11:30. Prima e dopo questa finestra il fiordo è in ombra profonda. In estate arriva entro le 10 per trovare parcheggio e goderti la luce piena."
      }
    },
    {
      "@type": "Question",
      "name": "Si può nuotare al Fiordo di Furore?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Sì, si può nuotare nel fiordo. L'acqua è generalmente più fresca rispetto alla costa aperta perché il sole arriva solo per poche ore al giorno. La spiaggia è piccola e di ciottoli. Il tuffo dal ponte (30 m) è consentito solo ai partecipanti al MarMeeting e vietato ai turisti per ragioni di sicurezza."
      }
    },
    {
      "@type": "Question",
      "name": "Cos'è il MarMeeting di Furore?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Il MarMeeting è una gara internazionale di tuffi acrobatici dal ponte del Fiordo di Furore, alto 30 metri. Si svolge ogni estate (di solito a luglio o agosto) e richiama tuffatori professionisti da tutto il mondo. I turisti non possono partecipare ma possono assistere gratuitamente sia dalla spiaggia che dal ponte."
      }
    },
    {
      "@type": "Question",
      "name": "L'ingresso al Fiordo di Furore è a pagamento?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No, il Fiordo di Furore è una spiaggia libera e l'accesso è gratuito. Per scendere alla spiaggia si percorrono circa 200 scalini dalla strada (SS163). Non ci sono servizi (bar, noleggio lettini, docce), quindi portate acqua, cibo e tutto il necessario."
      }
    }
  ]
};

const beachSchema = {
  "@context": "https://schema.org",
  "@type": "Beach",
  "name": "Fiordo di Furore",
  "description": "Un'iconica spiaggia incastonata in un fiordo naturale con acque cristalline e un ponte monumentale alto 30 metri.",
  "image": "https://amalficoast-travel.com/images/fiordo-furore.jpg",
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": "40.6122",
    "longitude": "14.5534"
  },
  "address": {
    "@type": "PostalAddress",
    "addressLocality": "Furore",
    "addressRegion": "SA",
    "addressCountry": "IT"
  },
  "publicAccess": "true",
  "amenityFeature": {
    "@type": "LocationFeatureSpecification",
    "name": "Orario Ombra",
    "value": "Dalle 14:30"
  }
};

const nearbyBeaches = [
  { name: 'Santa Croce', href: '/it-it/spiagge/costiera-amalfitana/santa-croce-amalfi/', tag: 'Solo via mare', desc: 'La fuga segreta da Amalfi con ristoranti storici.' },
  { name: 'Marina di Praia', href: '/it-it/spiagge/costiera-amalfitana/marina-di-praia/', tag: 'Praiano', desc: 'Spiaggia selvaggia con il tramonto più bello della Costiera.' },
  { name: 'Spiaggia Grande', href: '/it-it/spiagge/costiera-amalfitana/spiaggia-grande-positano/', tag: 'Positano', desc: 'Il cuore mondano della Costiera Amalfitana.' },
  { name: 'Ieranto', href: '/it-it/spiagge/penisola-sorrentina/ieranto/', tag: 'Area Marina Protetta', desc: 'La baia incontaminata ai piedi dei Lattari.' },
];
---

<BaseLayout
  title="Fiordo di Furore 2026: Guida, Accesso e Orari Ombra"
  description="Come visitare il Fiordo di Furore nel 2026. Orari della luce, come arrivare in bus e consigli per lo scatto perfetto."
  lang={lang}
  breadcrumbs={breadcrumbs}
  schema={[beachSchema, faqSchema]}
 pageKey="fiordo-di-furore">

  <!-- Hero -->
  <section class="relative h-[52.5vh] sm:h-[70vh] overflow-hidden flex items-center justify-center">
    <img
      src="/images/fiordo-furore-hero.jpg"
      alt="Fiordo di Furore, Costiera Amalfitana"
      class="absolute inset-0 w-full h-full object-cover"
      loading="eager" fetchpriority="high" decoding="sync" referrerpolicy="no-referrer"
    />
    <div class="absolute inset-0 hidden sm:block bg-gradient-to-b from-black/20 via-black/35 to-black/70"></div>
    <div class="relative z-10 text-center px-6 max-w-4xl text-white">
      <p class="text-med-gold text-sm font-medium uppercase tracking-[0.3em] mb-3">Costiera Amalfitana</p>
      <h1 class="font-serif text-display text-white mb-6">Fiordo di Furore</h1>
      <p class="text-lg md:text-xl font-light text-white/80">Un capolavoro della natura incastonato nella roccia.</p>
    </div>
    <Breadcrumbs breadcrumbs={breadcrumbs} />
  </section>

  <!-- Contenuto + Sidebar -->
  <section class="bg-med-cream py-24 px-6">
    <div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-3 gap-16">

      <!-- Testo principale -->
      <div class="lg:col-span-2 space-y-12">
        <div>
          <h2 class="font-serif text-4xl font-bold text-slate-900 mb-6">Un'icona della Costiera</h2>
          <p class="text-slate-600 text-lg leading-relaxed mb-6">
            Il Fiordo di Furore è una delle immagini più iconiche d'Italia. Non è una spiaggia tradizionale, ma una profonda spaccatura naturale dove il mare s'insinua sotto un ponte monumentale alto 30 metri. Incastonato lungo la <a href="/it-it/costiera-amalfitana/" class="text-med-blue hover:underline">Costiera Amalfitana</a> tra <a href="/it-it/costiera-amalfitana/positano/" class="text-med-blue hover:underline">Positano</a> e <a href="/it-it/costiera-amalfitana/amalfi/" class="text-med-blue hover:underline">Amalfi</a>, nel 2026 l'accesso è regolamentato per preservare il sito: la spiaggia è piccola e l'acqua è solitamente più fresca rispetto alla costa aperta.
          </p>
          <p class="text-slate-600 text-lg leading-relaxed">
            È il paradiso dei fotografi, ma attenzione alla luce: il sole illumina il fondo del fiordo solo nelle ore centrali della giornata. Arriva tra le 11 e le 13 per gli scatti migliori. Il tuffo dal ponte è una tradizione locale, ma è vietato ai turisti: goditi il panorama dall'alto prima di scendere i 200 scalini verso la spiaggia.
          </p>
        </div>

        <!-- Nota Importante -->
        <div class="bg-white p-8 rounded-[2rem] shadow-xl border border-slate-100">
          <div class="flex items-center gap-4 mb-4">
            <svg class="w-6 h-6 text-med-gold flex-shrink-0" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
            <h3 class="text-xl font-bold">Shade Alert</h3>
          </div>
          <p class="text-slate-600 leading-relaxed">
            Il sole arriva solo tra le <strong>11:00 e le 14:30</strong>. Prima e dopo questa finestra la spiaggia è in ombra totale. Se vuoi sole per nuotare, organizza la visita di conseguenza. Se vuoi foto perfette dell'acqua turchese illuminata, punta alle 11:30.
          </p>
        </div>

        <!-- Storia e origini -->
        <div>
          <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">Storia: Il Fiordo e il Paese che Non C'è</h2>
          <p class="text-slate-600 text-lg leading-relaxed mb-6">
            Il fiordo è stato scavato nel corso dei millenni dal torrente Schiato, che ancora oggi scorre tra le pareti di roccia calcarea fino al mare. Nel Medioevo, lungo il corso d'acqua operavano numerose cartiere - Amalfi fu la prima città europea a produrre carta secondo la tecnica araba, e Furore era parte di questo sistema produttivo che rese celebre la Repubblica.
          </p>
          <p class="text-slate-600 text-lg leading-relaxed">
            Il borgo di Furore è noto come il <em>"paese che non c'è"</em>: un comune senza centro, senza piazza, senza un cuore riconoscibile. Le case sono sparse sulle pareti della valle, collegate da sentieri scoscesi. Questa particolarità ha alimentato per decenni la sua fama di luogo sospeso tra realtà e leggenda.
          </p>
        </div>

        <!-- MarMeeting -->
        <div>
          <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">MarMeeting: Tuffi dal Ponte</h2>
          <p class="text-slate-600 text-lg leading-relaxed mb-6">
            Ogni estate - di solito a luglio o agosto - il ponte del fiordo si trasforma in un trampolino per il <strong>MarMeeting</strong>, gara internazionale di tuffi acrobatici nata negli anni '70. I tuffatori professionisti si lanciano da 30 metri di altezza davanti a una folla di spettatori assiepati sul ponte e sulle rocce circostanti.
          </p>
          <p class="text-slate-600 text-lg leading-relaxed">
            Il pubblico può assistere gratuitamente sia dalla spiaggia che dall'alto. Il tuffo libero è rigorosamente vietato ai turisti per motivi di sicurezza: le correnti all'ingresso del fiordo possono essere imprevedibili.
          </p>
        </div>

        <!-- Stats -->
        <div class="bg-slate-900 text-white p-8 rounded-[2rem] grid grid-cols-2 sm:grid-cols-4 gap-6 text-center">
          <div>
            <p class="text-med-gold text-3xl font-bold">30</p>
            <p class="text-white/60 text-sm mt-1">metri (ponte)</p>
          </div>
          <div>
            <p class="text-med-gold text-3xl font-bold">200</p>
            <p class="text-white/60 text-sm mt-1">scalini per scendere</p>
          </div>
          <div>
            <p class="text-med-gold text-3xl font-bold">1970</p>
            <p class="text-white/60 text-sm mt-1">primo MarMeeting</p>
          </div>
          <div>
            <p class="text-med-gold text-3xl font-bold">3½</p>
            <p class="text-white/60 text-sm mt-1">ore di sole al giorno</p>
          </div>
        </div>

        <!-- Paese Dipinto -->
        <div>
          <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">Furore: Il Paese Dipinto</h2>
          <p class="text-slate-600 text-lg leading-relaxed mb-6">
            Dal basso del fiordo, guardando in alto, si scorgono le prime tracce di quello che rende Furore unico anche lontano dalla spiaggia: è un <strong>paese dipinto</strong>. Dagli anni '80, artisti internazionali hanno trasformato i muri delle case abbarbicate sulla rupe in tele a cielo aperto, creando una galleria d'arte en plein air che oggi conta decine di murales.
          </p>
          <p class="text-slate-600 text-lg leading-relaxed">
            Ogni estate un nuovo artista viene invitato ad aggiungere la propria opera. Vale la pena risalire dal fiordo e camminare tra i vicoli del borgo per scoprire la collezione completa - è un'esperienza completamente diversa dalla spiaggia, ma altrettanto memorabile.
          </p>
        </div>

        <!-- Vita marina -->
        <div>
          <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">Vita Marina e Snorkeling</h2>
          <p class="text-slate-600 text-lg leading-relaxed mb-6">
            La conformazione stretta del fiordo canalizza acque ricche di nutrienti provenienti dal largo, favorendo un ecosistema marino particolarmente vivace. Tra le rocce sommerse vivono folti banchi di <strong>sarago</strong> (white seabream), polpi che si mimetizzano nelle fessure e ricci di mare aggrappati alle pareti. La visibilità è generalmente buona nelle ore centrali, quando la luce penetra fino al fondo.
          </p>
          <p class="text-slate-600 text-lg leading-relaxed">
            Un fenomeno acustico rende la visita ancora più suggestiva: le pareti di roccia amplificano ogni suono, trasformando il rumore delle onde in un eco profondo e avvolgente - un effetto che i locali chiamano semplicemente "la voce del fiordo".
          </p>
        </div>

        <!-- Consigli dei Locali -->
        <div class="bg-med-cream p-8 rounded-[2rem] border border-med-gold/20">
          <h3 class="font-serif text-2xl font-bold text-slate-900 mb-6">Consigli dei Locali</h3>
          <ul class="space-y-4">
            <li class="flex items-start gap-3">
              <span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span>
              <span class="text-slate-600">Arriva entro le 9:30 in estate per trovare posto lungo la strada o nel piccolo slargo vicino al ponte.</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span>
              <span class="text-slate-600">La finestra di luce solare è breve: programma la discesa alla spiaggia per le 11:00–11:30 per sfruttarla al massimo.</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span>
              <span class="text-slate-600">Non ci sono bar né docce: porta acqua, snack e ciabatte da scoglio. Le scarpe si tolgono sulla spiaggia, ma i ciottoli fanno male.</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span>
              <span class="text-slate-600">Dopo il bagno, risali al borgo e cerca i murales: dedica almeno un'ora alla passeggiata tra le case dipinte di Furore.</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span>
              <span class="text-slate-600">Per lo snorkeling porta maschera e pinne: il fondale roccioso vicino alle pareti del fiordo è pieno di vita marina.</span>
            </li>
          </ul>
        </div>

        <!-- Come arrivare espanso -->
        <div>
          <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">Come Arrivare</h2>
          <div class="overflow-hidden rounded-[2rem] border border-slate-100 shadow-sm">
            <table class="w-full text-sm">
              <thead>
                <tr class="bg-charcoal text-white">
                  <th class="text-left p-4 font-medium">Mezzo</th>
                  <th class="text-left p-4 font-medium">Fermata</th>
                  <th class="text-left p-4 font-medium">Note</th>
                </tr>
              </thead>
              <tbody>
                {logistica.map((row, i) => (
                  <tr class={i % 2 === 0 ? 'bg-white' : 'bg-slate-50'}>
                    <td class="p-4 font-medium">{row.mezzo}</td>
                    <td class="p-4 text-slate-600">{row.fermata}</td>
                    <td class="p-4 text-slate-500">{row.note}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
        <!-- FAQ -->
        <div>
          <h2 class="font-serif text-3xl font-bold text-slate-900 mb-8">Domande Frequenti</h2>
          <div class="space-y-4">
            {faqSchema.mainEntity.map((q) => (
              <details class="group border border-slate-200 rounded-2xl overflow-hidden bg-white">
                <summary class="flex items-center justify-between px-6 py-4 cursor-pointer select-none text-charcoal font-medium hover:bg-slate-50 transition-colors">
                  {q.name}
                  <svg class="w-4 h-4 text-slate-400 group-open:rotate-180 transition-transform flex-shrink-0 ml-3" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
                </summary>
                <div class="px-6 pb-5 text-slate-600 leading-relaxed text-xs sm:text-sm border-t border-slate-100 pt-4">
                  {q.acceptedAnswer.text}
                </div>
              </details>
            ))}
          </div>
        </div>
      </div>

      <!-- Sidebar Fast-Facts -->
      <aside class="lg:col-span-1">
        <div class="bg-slate-900 text-white p-10 rounded-[3rem] sticky top-32">
          <h3 class="font-serif text-2xl font-bold mb-8 flex items-center gap-3">
            <svg class="w-6 h-6 text-med-gold" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M2 12c.6.5 1.2 1 2.5 1 2.5 0 2.5-2 5-2 2.6 0 2.4 2 5 2 2.5 0 2.5-2 5-2 1.3 0 1.9.5 2.5 1"/><path d="M2 18c.6.5 1.2 1 2.5 1 2.5 0 2.5-2 5-2 2.6 0 2.4 2 5 2 2.5 0 2.5-2 5-2 1.3 0 1.9.5 2.5 1"/></svg> Fast-Facts
          </h3>
          <div class="space-y-6">
            {facts.map((item) => (
              <div class="border-b border-white/5 pb-4 last:border-0">
                <span class="text-white/40 text-sm font-light block mb-1">{item.label}</span>
                <span class="text-white font-medium text-sm">{item.value}</span>
              </div>
            ))}
          </div>
          <div class="mt-10 pt-8 border-t border-white/10">
            <a
              href="/it-it/spiagge/"
              class="inline-flex items-center gap-2 text-med-gold text-sm font-medium hover:text-white transition-colors"
            >
              ← Tutte le spiagge
            </a>
          </div>
        </div>
      </aside>

    </div>
  </section>

  <!-- Spiagge Vicine -->
  <CorrelationSlider
    title="Spiagge Vicine al Fiordo"
    items={nearbyBeaches}
    lang="it-it"
  />

  <!-- CTA -->
  <section class="bg-med-blue py-16 text-center">
    <div class="max-w-2xl mx-auto px-6">
      <h2 class="font-serif text-2xl font-bold text-white mb-4">Scopri altre spiagge della Costiera</h2>
      <a
        href="/it-it/spiagge/"
        class="inline-block bg-white text-med-blue font-semibold px-8 py-3 rounded-full hover:bg-med-cream transition-colors"
      >
        Guida completa alle spiagge
      </a>
    </div>
  </section>

</BaseLayout>
