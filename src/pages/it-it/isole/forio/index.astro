---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import CorrelationSlider from '../../../../components/CorrelationSlider.astro';
import Breadcrumbs from '../../../../components/Breadcrumbs.astro';

const lang = 'it-it';

const breadcrumbs = [
  { name: 'Home', url: '/it-it/' },
  { name: 'Isole del Golfo', url: '/it-it/isole/' },
  { name: 'Forio', url: '/it-it/isole/forio/' },
];

const touristAttractionSchema = {
  "@context": "https://schema.org",
  "@type": "TouristAttraction",
  "name": "Forio d'Ischia",
  "description": "Forio e il comune piu grande dell'isola d'Ischia: i Giardini Poseidon, la Chiesa del Soccorso, la Baia di Citara, i tramonti sul mare e le terme naturali lo rendono una destinazione imperdibile.",
  "url": "https://amalficoast-travel.com/it-it/isole/forio/",
  "touristType": ["Terme", "Mare", "Cultura", "Tramonti"],
  "address": { "@type": "PostalAddress", "addressLocality": "Forio", "addressRegion": "Napoli", "addressCountry": "IT", "postalCode": "80075" },
  "geo": { "@type": "GeoCoordinates", "latitude": 40.7365, "longitude": 13.8570 }
};

const placeSchema = {
  "@context": "https://schema.org",
  "@type": "Place",
  "name": "Forio, Isola d'Ischia",
  "geo": { "@type": "GeoCoordinates", "latitude": 40.7365, "longitude": 13.8570 },
  "containedInPlace": { "@type": "AdministrativeArea", "name": "Isola d'Ischia" }
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Come si arriva a Forio da Napoli?",
      "acceptedAnswer": { "@type": "Answer", "text": "Da Napoli si prende il traghetto o aliscafo per Ischia Porto (circa 50-75 minuti). Da li si raggiunge Forio in bus (linea CD o CS, circa 25-30 minuti) oppure in taxi. In alternativa, alcuni traghetti Medmar da Pozzuoli arrivano a Casamicciola, da cui Forio e ancora piu vicina." }
    },
    {
      "@type": "Question",
      "name": "Quanto costano i Giardini Poseidon?",
      "acceptedAnswer": { "@type": "Answer", "text": "L'ingresso ai Giardini Poseidon Terme costa circa 35-38 euro per la giornata intera (mezza giornata dalle 13:00 circa 30 euro). Il parco include 22 piscine termali a diverse temperature, spiaggia privata, sauna e giardini. E il parco termale piu grande e famoso d'Ischia." }
    },
    {
      "@type": "Question",
      "name": "Qual e la spiaggia piu bella di Forio?",
      "acceptedAnswer": { "@type": "Answer", "text": "La Baia di Citara e la spiaggia piu famosa, con sabbia fine e acque limpide. La Spiaggia di San Francesco e piu piccola e tranquilla. La Baia di Sorgeto offre piscine naturali di acqua termale calda che si mescola al mare (gratuita, accessibile tramite scalinata)." }
    },
    {
      "@type": "Question",
      "name": "Cosa vedere a Forio in un giorno?",
      "acceptedAnswer": { "@type": "Answer", "text": "In un giorno si possono visitare la Chiesa del Soccorso al tramonto, i Giardini La Mortella la mattina, il centro storico con le torri saracene, e la Baia di Citara o i Giardini Poseidon nel pomeriggio. Se avanza tempo, la Baia di Sorgeto per un bagno termale al tramonto." }
    },
    {
      "@type": "Question",
      "name": "Quando e meglio visitare Forio?",
      "acceptedAnswer": { "@type": "Answer", "text": "Maggio, giugno e settembre sono i mesi ideali: clima perfetto, mare caldo, meno folla rispetto a luglio e agosto. I Giardini La Mortella sono aperti da aprile a novembre. I Giardini Poseidon sono aperti da aprile a ottobre. L'inverno e molto tranquillo con alcuni servizi ridotti." }
    }
  ]
};

const schemas = [touristAttractionSchema, placeSchema, faqSchema];

const fastFacts = [
  { dt: 'Posizione', dd: 'Costa ovest di Ischia, NA' },
  { dt: 'Popolazione', dd: '~18.000 abitanti' },
  { dt: 'Comune piu grande', dd: 'Dell\'isola d\'Ischia' },
  { dt: 'Da Ischia Porto', dd: '25-30 min (bus CD/CS)' },
  { dt: 'Da Napoli', dd: '50-75 min + bus' },
  { dt: 'Terme', dd: 'Giardini Poseidon, Sorgeto' },
  { dt: 'Spiaggia top', dd: 'Baia di Citara' },
  { dt: 'Miglior periodo', dd: 'Mag-Giu / Set' },
  { dt: 'Valuta', dd: 'Euro (EUR)' },
];

const tips = [
  'La Chiesa del Soccorso al tramonto e uno degli spettacoli piu belli di tutto il Golfo di Napoli: arriva 30 minuti prima per prendere posto.',
  'I Giardini La Mortella sono aperti solo alcuni giorni: controlla il calendario su lamortella.org prima di pianificare.',
  'La Baia di Sorgeto e gratuita ma si raggiunge scendendo circa 200 gradini: vai al tramonto per il bagno termale piu suggestivo.',
  'Il bus circolare CD (senso orario) e CS (senso antiorario) collegano tutti i comuni di Ischia: biglietto 90 min ~2 euro.',
];
---

<BaseLayout
  title="Forio d'Ischia 2026: Guida Completa | Giardini Poseidon, Chiesa del Soccorso e Terme"
  description="Forio d'Ischia guida completa: Giardini Poseidon, Chiesa del Soccorso, Baia di Citara, Giardini La Mortella, Sorgeto. Come arrivare, cosa vedere, terme e tramonti."
  lang={lang}
  breadcrumbs={breadcrumbs}
  schema={schemas}
  pageKey="forio"
>

  <section class="relative h-[75vh] sm:h-[90vh] flex items-center bg-charcoal overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-b from-black/75 via-black/40 to-black/70 z-10"></div>
    <img src="/images/forio-hero.jpg" alt="" class="absolute inset-0 w-full h-full object-cover" loading="eager" fetchpriority="high" decoding="sync" referrerpolicy="no-referrer"/>
    <div class="relative z-20 max-w-editorial mx-auto px-4 sm:px-6 lg:px-8">
      </nav>
      <div class="max-w-3xl">
        <p class="text-med-gold text-xs sm:text-sm font-medium uppercase tracking-[0.3em] mb-3">Isola d'Ischia · Costa ovest</p>
        <h1 class="font-serif text-display text-white mb-4">Forio</h1>
        <p class="text-xl text-white/80 leading-relaxed max-w-2xl">
          Terme a cielo aperto, tramonti leggendari sulla Chiesa del Soccorso e i Giardini Poseidon: Forio e il cuore pulsante della costa occidentale d'Ischia.
        </p>
        <div class="flex flex-wrap gap-3 mt-8">
          <a href="#fast-facts" class="px-5 py-2.5 bg-med-gold text-white text-xs sm:text-sm font-semibold rounded-full hover:scale-105 hover:shadow-[0_8px_25px_rgba(212,175,55,0.4)] transition-all duration-300">Fast Facts</a>
          <a href="#come-arrivare" class="px-5 py-2.5 bg-white/10 backdrop-blur text-white text-xs sm:text-sm font-medium rounded-full border border-white/20 hover:bg-white/20 transition-colors">Come arrivare</a>
          <a href="#faq" class="px-5 py-2.5 bg-white/10 backdrop-blur text-white text-xs sm:text-sm font-medium rounded-full border border-white/20 hover:bg-white/20 transition-colors">FAQ</a>
        </div>
      </div>
    </div>

    <Breadcrumbs breadcrumbs={breadcrumbs} />
  </section>

  <section class="max-w-editorial mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="grid lg:grid-cols-[1fr_320px] gap-12">

      <div class="space-y-16">

        <div class="prose-editorial">
          <p class="text-xl leading-relaxed text-charcoal">
            Forio e il comune piu grande dell'isola d'Ischia e ne occupa l'intera costa occidentale. E il punto dell'isola dove il sole tramonta sul mare aperto - e questo semplice fatto geografico ha plasmato la sua identita: un luogo di luce dorata, terme vulcaniche e giardini rigogliosi.
          </p>
          <p class="mt-4 text-slate-600 leading-relaxed">
            Storicamente borgo di pescatori e contadini, Forio e stata scoperta negli anni '50 da artisti e intellettuali europei - Truman Capote, W.H. Auden, Hans Werner Henze composero qui alcune delle loro opere piu importanti. Oggi e la meta ideale per chi cerca il lato piu autentico e naturale di Ischia, lontano dalla mondanita di Ischia Porto.
          </p>
        </div>

        <div class="bg-slate-900 border border-white/10 rounded-[3rem] p-8">
          <p class="text-[10px] uppercase tracking-[0.3em] text-med-gold font-medium mb-4">Lo sapevi?</p>
          <div class="grid sm:grid-cols-3 gap-6">
            <div class="text-center">
              <p class="font-serif text-5xl font-bold text-med-gold">22</p>
              <p class="text-white/60 text-xs italic mt-1">piscine termali ai Giardini Poseidon</p>
            </div>
            <div class="text-center">
              <p class="font-serif text-5xl font-bold text-med-gold">12</p>
              <p class="text-white/60 text-xs italic mt-1">torri saracene nel territorio</p>
            </div>
            <div class="text-center">
              <p class="font-serif text-5xl font-bold text-med-gold">1958</p>
              <p class="text-white/60 text-xs italic mt-1">anno di fondazione dei Giardini La Mortella</p>
            </div>
          </div>
          <p class="text-white/40 text-xs mt-6 italic">
            Lady Susana Walton, moglie del compositore inglese William Walton, creo i Giardini La Mortella a Forio con l'aiuto del paesaggista Russell Page. Oggi ospitano concerti di musica da camera ogni fine settimana.
          </p>
        </div>

        <div>
          <h2 class="font-serif text-3xl font-semibold text-slate-900 mb-8">Cosa vedere a Forio</h2>
          <div class="space-y-8">
            {[
              {
                n: 1,
                title: 'Chiesa del Soccorso',
                text: 'La chiesa bianca sul promontorio e il simbolo di Forio e di tutta Ischia. Costruita nel XIV secolo, affaccia direttamente sul mare aperto con un sagrato pavimentato in maiolica. Al tramonto diventa il palcoscenico naturale piu spettacolare dell\'isola. Ingresso gratuito.',
              },
              {
                n: 2,
                title: 'Giardini Poseidon Terme',
                text: 'Il parco termale piu grande e famoso d\'Ischia: 22 piscine a temperature diverse (da 20 a 40 gradi), sauna naturale in grotta, spiaggia privata sulla Baia di Citara. Una giornata intera di relax. Ingresso circa 35-38 euro giornata intera. Aperto aprile-ottobre.',
              },
              {
                n: 3,
                title: 'Giardini La Mortella',
                text: 'Uno dei giardini botanici piu belli del Mediterraneo, creato da Lady Walton nel 1958. Due ettari di piante tropicali e mediterranee, fontane, ninfee, un museo e una sala concerti dove si tengono recital ogni fine settimana. Ingresso circa 12 euro. Aperto alcuni giorni a settimana (verificare il calendario).',
              },
              {
                n: 4,
                title: 'Baia di Sorgeto',
                text: 'Piscine naturali dove l\'acqua termale calda sgorga dalle rocce e si mescola al mare freddo. Si raggiunge scendendo circa 200 gradini dalla frazione di Panza. Gratuita e aperta tutto l\'anno, anche di notte. Il bagno al tramonto o sotto le stelle e un\'esperienza unica.',
              },
              {
                n: 5,
                title: 'Centro storico e torri saracene',
                text: 'Il centro di Forio conserva 12 torri di avvistamento del XV-XVI secolo, costruite per difendersi dalle incursioni saracene. La Torre Torrione e la piu grande e ospita un museo civico. Il borgo e un intreccio di vicoli, chiese barocche, botteghe artigiane e ristoranti tipici.',
              },
            ].map(({ n, title, text }) => (
              <div class="grid sm:grid-cols-[auto_1fr] gap-4">
                <div class="w-14 h-14 rounded-[1rem] bg-med-gold/10 flex items-center justify-center flex-shrink-0 text-med-gold font-serif font-bold text-xl">{n}</div>
                <div>
                  <h3 class="font-semibold text-charcoal text-lg mb-1">{title}</h3>
                  <p class="text-slate-600 leading-relaxed">{text}</p>
                </div>
              </div>
            ))}
          </div>
        </div>

        <div id="come-arrivare">
          <h2 class="font-serif text-3xl font-semibold text-slate-900 mb-6">Come arrivare a Forio</h2>
          <p class="text-slate-600 mb-8 leading-relaxed">Forio si raggiunge in traghetto/aliscafo da Napoli o Pozzuoli fino a Ischia Porto o Casamicciola, poi in bus circolare. Non esistono collegamenti marittimi diretti per Forio.</p>

          <div class="overflow-x-auto rounded-2xl border border-slate-200">
            <table class="w-full text-xs sm:text-xs sm:text-sm">
              <caption class="text-left text-xs text-slate-500 px-4 py-2 bg-slate-50 rounded-t-2xl border-b border-slate-200 font-medium">
                Come raggiungere Forio
              </caption>
              <thead>
                <tr class="bg-slate-900 text-white">
                  <th class="text-left px-4 py-3 font-semibold">Tratta</th>
                  <th class="text-left px-4 py-3 font-semibold">Mezzo</th>
                  <th class="text-left px-4 py-3 font-semibold">Durata</th>
                  <th class="text-left px-4 py-3 font-semibold">Costo</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-slate-100">
                {[
                  ['Napoli → Ischia Porto', 'Aliscafo (NLG/Alilauro)', '~50 min', '~20 EUR'],
                  ['Napoli → Ischia Porto', 'Traghetto (Caremar)', '~75 min', '~13 EUR'],
                  ['Pozzuoli → Casamicciola', 'Traghetto (Medmar)', '~35 min', '~10 EUR'],
                  ['Ischia Porto → Forio', 'Bus CD/CS', '~25-30 min', '~2 EUR'],
                  ['Casamicciola → Forio', 'Bus CD/CS', '~15 min', '~2 EUR'],
                ].map(([tratta, mezzo, durata, costo]) => (
                  <tr class="hover:bg-slate-50 transition-colors">
                    <td class="px-4 py-3 font-medium text-charcoal">{tratta}</td>
                    <td class="px-4 py-3 text-slate-500">{mezzo}</td>
                    <td class="px-4 py-3 font-mono">{durata}</td>
                    <td class="px-4 py-3 text-slate-500">{costo}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          <p class="text-xs text-slate-400 mt-2">* Prezzi e tempi indicativi estate 2026. Verifica su caremar.it, medmar.it, alilauro.it.</p>
        </div>

        <div>
          <h2 class="font-serif text-3xl font-semibold text-slate-900 mb-6">Spiagge di Forio</h2>
          <div class="grid sm:grid-cols-2 gap-6">
            {[
              { title: 'Baia di Citara', text: 'La spiaggia piu grande e attrezzata di Forio, con sabbia fine dorata e acque turchesi. Ospita i Giardini Poseidon. Lidi attrezzati e tratto di spiaggia libera. Esposta a ovest: perfetta per i tramonti.' },
              { title: 'Spiaggia di San Francesco', text: 'Piccola spiaggia sotto la Chiesa del Soccorso, piu raccolta e tranquilla della Citara. Sabbia e ciottoli, acqua cristallina. Raggiungibile a piedi dal centro di Forio in 5 minuti.' },
              { title: 'Spiaggia di Cava dell\'Isola', text: 'Insenatura selvaggia sulla costa nord di Forio, frequentata da surfisti e amanti della natura. Meno attrezzata, piu autentica. Raggiungibile in auto o bus + breve camminata.' },
              { title: 'Baia di Sorgeto (terme)', text: 'Non una spiaggia tradizionale ma piscine naturali termali tra le rocce. L\'acqua calda vulcanica si mescola al mare freddo. Gratuita, aperta tutto l\'anno. Si scendono circa 200 gradini dalla frazione di Panza.' },
            ].map(({ title, text }) => (
              <div class="bg-white rounded-[3rem] p-8 border border-slate-100 hover:shadow-xl transition-all duration-300">
                <h3 class="font-semibold text-charcoal mb-2">{title}</h3>
                <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">{text}</p>
              </div>
            ))}
          </div>
        </div>

        <div id="faq">
          <h2 class="font-serif text-3xl font-semibold text-slate-900 mb-8">Domande frequenti su Forio</h2>
          <div class="space-y-4">
            {faqSchema.mainEntity.map((q) => (
              <details class="group border border-slate-200 rounded-2xl overflow-hidden">
                <summary class="flex items-center justify-between px-6 py-4 cursor-pointer select-none text-charcoal font-medium hover:bg-slate-50 transition-colors">
                  {q.name}
                  <svg class="w-4 h-4 text-slate-400 group-open:rotate-180 transition-transform flex-shrink-0 ml-3" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
                </summary>
                <div class="px-6 pb-5 text-slate-600 leading-relaxed text-xs sm:text-sm border-t border-slate-100 pt-4">
                  {q.acceptedAnswer.text}
                </div>
              </details>
            ))}
          </div>
        </div>

      </div>

      <aside class="space-y-6 lg:sticky lg:top-24 self-start">
        <div id="fast-facts" class="bg-slate-900 text-white rounded-[3rem] p-6">
          <p class="text-[10px] uppercase tracking-[0.3em] text-med-gold font-medium mb-4">Fast Facts - Forio</p>
          <dl class="space-y-3">
            {fastFacts.map(({ dt, dd }, i) => (
              <>
                <div class="flex justify-between items-start gap-3">
                  <dt class="text-white/40 text-xs sm:text-sm font-light flex-shrink-0">{dt}</dt>
                  <dd class="text-white font-medium text-xs sm:text-sm text-right">{dd}</dd>
                </div>
                {i < fastFacts.length - 1 && <div class="border-t border-white/5"></div>}
              </>
            ))}
          </dl>
        </div>

        <div class="bg-med-cream border border-med-gold/30 rounded-[2rem] p-6">
          <p class="text-[10px] uppercase tracking-[0.3em] text-med-gold font-medium mb-3">Consigli degli insider</p>
          <ul class="space-y-3">
            {tips.map(tip => (
              <li class="flex items-start gap-2 text-xs sm:text-sm text-charcoal">
                <span class="w-1.5 h-1.5 rounded-full bg-med-gold mt-1.5 flex-shrink-0"></span>
                <span set:html={tip}></span>
              </li>
            ))}
          </ul>
        </div>

        <div class="bg-white border border-slate-100 rounded-[2rem] p-6 shadow-sm">
          <p class="text-[10px] uppercase tracking-[0.3em] text-slate-400 font-medium mb-3">Altre isole del Golfo</p>
          <nav class="space-y-1">
            {[
              { href: '/it-it/isole/capri/', label: 'Capri' },
              { href: '/it-it/isole/anacapri/', label: 'Anacapri' },
              { href: '/it-it/isole/ischia/', label: 'Ischia' },
              { href: '/it-it/isole/procida/', label: 'Procida' },
            ].map(({ href, label }) => (
              <a href={href} class="flex items-center gap-2 px-3 py-2 rounded-xl text-xs sm:text-sm text-charcoal hover:bg-med-blue/5 hover:text-med-blue transition-colors">
                <span class="w-1.5 h-1.5 rounded-full bg-med-blue/30"></span> {label}
              </a>
            ))}
          </nav>
        </div>
      </aside>

    </div>
  </section>

  <CorrelationSlider
    heading="Esplora le altre isole e la Costiera"
    items={[
      { name: 'Ischia',    href: '/it-it/isole/ischia/',                tag: 'Terme & Natura',   desc: 'Terme naturali, Castello Aragonese, Monte Epomeo e spiagge vulcaniche.' },
      { name: 'Capri',     href: '/it-it/isole/capri/',                 tag: 'La piu iconica',   desc: 'Grotta Azzurra, Faraglioni, la Piazzetta: l\'isola piu famosa del Golfo.' },
      { name: 'Anacapri',  href: '/it-it/isole/anacapri/',              tag: 'Natura & Panorami', desc: 'Villa San Michele, Monte Solaro, Scala Fenicia: il borgo alto di Capri.' },
      { name: 'Procida',   href: '/it-it/isole/procida/',               tag: 'La piu autentica', desc: 'Case colorate a Marina Corricella, Capitale italiana della Cultura 2022.' },
      { name: 'Positano',  href: '/it-it/costiera-amalfitana/positano/', tag: 'Fashion & Vista',  desc: 'Le case colorate a picco sul mare, boutique di lusso e la spiaggia Fornillo.' },
    ]}
  />

</BaseLayout>
