---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import CorrelationSlider from '../../../../components/CorrelationSlider.astro';
import Breadcrumbs from '../../../../components/Breadcrumbs.astro';

const lang = 'it-it';

const breadcrumbs = [
  { name: 'Home', url: '/it-it/' },
  { name: 'Isole del Golfo', url: '/it-it/isole/' },
  { name: 'Anacapri', url: '/it-it/isole/anacapri/' },
];

const touristAttractionSchema = {
  "@context": "https://schema.org",
  "@type": "TouristAttraction",
  "name": "Anacapri",
  "description": "Anacapri è il comune più alto dell'isola di Capri: Villa San Michele, seggiovia per Monte Solaro (589 m), Chiesa di San Michele e panorami mozzafiato sul Golfo di Napoli.",
  "url": "https://amalficoast-travel.com/it-it/isole/anacapri/",
  "touristType": ["Cultura", "Natura", "Escursionismo", "Panorami"],
  "address": { "@type": "PostalAddress", "addressLocality": "Anacapri", "addressRegion": "Napoli", "addressCountry": "IT", "postalCode": "80071" },
  "geo": { "@type": "GeoCoordinates", "latitude": 40.5520, "longitude": 14.2150 }
};

const placeSchema = {
  "@context": "https://schema.org",
  "@type": "Place",
  "name": "Anacapri, Isola di Capri",
  "geo": { "@type": "GeoCoordinates", "latitude": 40.5520, "longitude": 14.2150 },
  "containedInPlace": { "@type": "AdministrativeArea", "name": "Isola di Capri" }
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Come si arriva ad Anacapri dalla Marina Grande?",
      "acceptedAnswer": { "@type": "Answer", "text": "Dalla Marina Grande si prende il bus ATC diretto ad Anacapri (circa 15 minuti, biglietto ~2 euro). In alternativa si puo prendere la funicolare fino a Capri centro e poi il bus per Anacapri. I taxi open-air costano circa 20-25 euro." }
    },
    {
      "@type": "Question",
      "name": "Quanto costa la seggiovia per Monte Solaro?",
      "acceptedAnswer": { "@type": "Answer", "text": "La seggiovia monoposto da Piazza Vittoria ad Anacapri costa circa 12 euro andata e ritorno (8 euro solo andata). La salita dura circa 12 minuti con panorami spettacolari. In cima si trova un bar e il punto panoramico piu alto dell'isola a 589 metri." }
    },
    {
      "@type": "Question",
      "name": "Villa San Michele vale la visita?",
      "acceptedAnswer": { "@type": "Answer", "text": "Assolutamente si. Villa San Michele, costruita dal medico svedese Axel Munthe sui resti di una cappella e di una villa romana di Tiberio, e uno dei luoghi piu suggestivi di Capri. Il giardino con la sfinge e la terrazza panoramica sul Golfo di Napoli sono indimenticabili. Ingresso circa 8 euro." }
    },
    {
      "@type": "Question",
      "name": "Anacapri o Capri: qual e la differenza?",
      "acceptedAnswer": { "@type": "Answer", "text": "Anacapri e il comune alto dell'isola (circa 275 m s.l.m.), piu tranquillo, verde e autentico. Capri centro e piu mondano, con la Piazzetta, i negozi di lusso e la vita notturna. Anacapri e ideale per chi cerca natura, panorami e un ritmo piu rilassato." }
    },
    {
      "@type": "Question",
      "name": "Si puo raggiungere la Grotta Azzurra da Anacapri?",
      "acceptedAnswer": { "@type": "Answer", "text": "Si. Da Anacapri si puo raggiungere l'ingresso della Grotta Azzurra a piedi (circa 30 minuti in discesa) o con il bus per Grotta Azzurra. L'ingresso in barchetta costa circa 14 euro. In alternativa si raggiunge in barca dalla Marina Grande." }
    }
  ]
};

const schemas = [touristAttractionSchema, placeSchema, faqSchema];

const fastFacts = [
  { dt: 'Posizione', dd: 'Isola di Capri, NA' },
  { dt: 'Altitudine', dd: '275 m s.l.m.' },
  { dt: 'Popolazione', dd: '~7.000 abitanti' },
  { dt: 'Vetta', dd: 'Monte Solaro 589 m' },
  { dt: 'Da Marina Grande', dd: '15 min (bus ATC)' },
  { dt: 'Da Capri centro', dd: '10 min (bus)' },
  { dt: 'Attrazione top', dd: 'Villa San Michele' },
  { dt: 'Miglior periodo', dd: 'Apr-Giu / Set-Ott' },
  { dt: 'Valuta', dd: 'Euro (EUR)' },
];

const tips = [
  'Prendi il primo bus da Marina Grande per Anacapri (7:30): arrivi prima della folla e fai la seggiovia senza coda.',
  'La Chiesa di San Michele ha un pavimento maiolicato del 1761 visibile dalla balconata: ingresso solo 2 euro.',
  'Scendi da Monte Solaro a piedi invece che in seggiovia: il sentiero attraversa boschi di leccio e offre viste incredibili (45 min).',
  'Via Orlandi e la via dello shopping locale: meno cara della Piazzetta di Capri, con botteghe artigiane autentiche.',
];
---

<BaseLayout
  title="Anacapri 2026: Villa San Michele, Monte Solaro & Grotta Azzurra"
  description="Anacapri guida completa: Villa San Michele, seggiovia Monte Solaro, Chiesa di San Michele, Grotta Azzurra. Come arrivare, cosa vedere, consigli pratici per visitare il borgo alto di Capri."
  lang={lang}
  breadcrumbs={breadcrumbs}
  schema={schemas}
  pageKey="anacapri"

  heroImage="/images/anacapri-hero.jpg"
>

  <section class="relative h-[75vh] sm:h-[90vh] flex items-center bg-charcoal overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-b from-black/75 via-black/40 to-black/70 z-10"></div>
    <img src="/images/anacapri-hero.jpg" alt="Anacapri: il borgo alto di Capri con vista sul Monte Solaro" class="absolute inset-0 w-full h-full object-cover" loading="eager" fetchpriority="high" decoding="sync" referrerpolicy="no-referrer"/>
    <div class="relative z-20 max-w-editorial mx-auto px-4 sm:px-6 lg:px-8">
      </nav>
      <div class="max-w-3xl">
        <p class="text-med-gold text-xs sm:text-sm font-medium uppercase tracking-[0.3em] mb-3">Isola di Capri · Il borgo alto</p>
        <h1 class="font-serif text-display text-white mb-4">Anacapri</h1>
        <p class="text-xl text-white/80 leading-relaxed max-w-2xl">
          Il cuore verde e silenzioso dell'isola di Capri: Villa San Michele, la seggiovia per Monte Solaro e i panorami piu spettacolari del Golfo.
        </p>
        <div class="flex flex-wrap gap-3 mt-8">
          <a href="#fast-facts" class="px-5 py-2.5 bg-med-gold text-white text-xs sm:text-sm font-semibold rounded-full hover:scale-105 hover:shadow-[0_8px_25px_rgba(212,175,55,0.4)] transition-all duration-300">Fast Facts</a>
          <a href="#come-arrivare" class="px-5 py-2.5 bg-white/10 backdrop-blur text-white text-xs sm:text-sm font-medium rounded-full border border-white/20 hover:bg-white/20 transition-colors">Come arrivare</a>
          <a href="#faq" class="px-5 py-2.5 bg-white/10 backdrop-blur text-white text-xs sm:text-sm font-medium rounded-full border border-white/20 hover:bg-white/20 transition-colors">FAQ</a>
        </div>
      </div>
    </div>

    <Breadcrumbs breadcrumbs={breadcrumbs} />
  </section>

  <section class="max-w-editorial mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="grid lg:grid-cols-[1fr_320px] gap-12">

      <div class="space-y-16">

        <div class="prose-editorial">
          <p class="text-xl leading-relaxed text-charcoal">
            Anacapri e il secondo comune dell'isola di Capri, arroccato a circa 275 metri sul livello del mare. Se Capri centro e mondanita, boutique e Piazzetta, Anacapri e il suo opposto: giardini silenziosi, sentieri panoramici, borghi autentici e la vetta piu alta dell'isola.
          </p>
          <p class="mt-4 text-slate-600 leading-relaxed">
            Il nome deriva dal greco "ana" (sopra) e Capri: letteralmente "sopra Capri". Fino al 1877 i due comuni erano collegati solo dalla Scala Fenicia, 921 gradini scavati nella roccia. Oggi si sale comodamente in bus, ma quella scala esiste ancora ed e uno dei trekking piu suggestivi dell'isola.
          </p>
        </div>

        <div class="bg-slate-900 border border-white/10 rounded-[3rem] p-8">
          <p class="text-[10px] uppercase tracking-[0.3em] text-med-gold font-medium mb-4">Lo sapevi?</p>
          <div class="grid sm:grid-cols-3 gap-6">
            <div class="text-center">
              <p class="font-serif text-5xl font-bold text-med-gold">589 m</p>
              <p class="text-white/60 text-xs italic mt-1">Monte Solaro, vetta piu alta</p>
            </div>
            <div class="text-center">
              <p class="font-serif text-5xl font-bold text-med-gold">921</p>
              <p class="text-white/60 text-xs italic mt-1">gradini della Scala Fenicia</p>
            </div>
            <div class="text-center">
              <p class="font-serif text-5xl font-bold text-med-gold">1877</p>
              <p class="text-white/60 text-xs italic mt-1">anno della prima strada carrabile</p>
            </div>
          </div>
          <p class="text-white/40 text-xs mt-6 italic">
            Axel Munthe, il medico svedese che costrui Villa San Michele, scrisse "La storia di San Michele" (1929), uno dei libri piu venduti del XX secolo, ambientato interamente ad Anacapri.
          </p>
        </div>

        <div>
          <h2 class="font-serif text-3xl font-semibold text-slate-900 mb-8">Cosa vedere ad Anacapri</h2>
          <div class="space-y-8">
            {[
              {
                n: 1,
                title: 'Villa San Michele',
                text: 'La residenza-museo del medico svedese Axel Munthe, costruita sui resti di una cappella medievale e di una villa di Tiberio. Il giardino con la sfinge egiziana e la terrazza panoramica sul Golfo sono tra le immagini piu iconiche di Capri. Ingresso ~8 euro. Aperta tutto l\'anno.',
              },
              {
                n: 2,
                title: 'Monte Solaro (seggiovia)',
                text: 'La seggiovia monoposto da Piazza Vittoria porta in cima al Monte Solaro (589 m) in 12 minuti. Panorama a 360 gradi: si vedono Capri, Ischia, Procida, il Vesuvio, la Costiera Amalfitana e nelle giornate limpide la Calabria. In cima: bar, punto panoramico e il Santuario della Madonna del Soccorso.',
              },
              {
                n: 3,
                title: 'Chiesa di San Michele Arcangelo',
                text: 'La chiesa barocca del XVIII secolo conserva uno straordinario pavimento maiolicato (1761) che raffigura la cacciata di Adamo ed Eva dal Paradiso terrestre. Si ammira dalla balconata per non calpestarlo. Ingresso ~2 euro. In Piazza San Nicola.',
              },
              {
                n: 4,
                title: 'Scala Fenicia',
                text: 'L\'antica scalinata di 921 gradini che collegava Marina Grande ad Anacapri prima della costruzione della strada (1877). Si percorre in discesa in circa 25 minuti. Partenza da Via Capodimonte ad Anacapri, arrivo nei pressi del porto. Vista spettacolare durante la discesa.',
              },
              {
                n: 5,
                title: 'Grotta Azzurra',
                text: 'Raggiungibile da Anacapri con il bus per Grotta Azzurra o a piedi (30 min in discesa). La celebre grotta marina si visita in barchetta: la luce filtra da una cavita sommersa e illumina l\'acqua di un blu elettrico. Ingresso ~14 euro. Evitare in caso di mare mosso.',
              },
            ].map(({ n, title, text }) => (
              <div class="grid sm:grid-cols-[auto_1fr] gap-4">
                <div class="w-14 h-14 rounded-[1rem] bg-med-gold/10 flex items-center justify-center flex-shrink-0 text-med-gold font-serif font-bold text-xl">{n}</div>
                <div>
                  <h3 class="font-semibold text-charcoal text-lg mb-1">{title}</h3>
                  <p class="text-slate-600 leading-relaxed">{text}</p>
                </div>
              </div>
            ))}
          </div>
        </div>

        <div id="come-arrivare">
          <h2 class="font-serif text-3xl font-semibold text-slate-900 mb-6">Come arrivare ad Anacapri</h2>
          <p class="text-slate-600 mb-8 leading-relaxed">Anacapri si raggiunge dalla Marina Grande di Capri con il bus ATC diretto (circa 15 minuti). In alternativa si puo prendere la funicolare fino a Capri centro e poi il bus. I taxi open-air dalla Marina costano circa 20-25 euro.</p>

          <div class="overflow-x-auto rounded-2xl border border-slate-200">
            <table class="w-full text-xs sm:text-xs sm:text-sm">
              <caption class="text-left text-xs text-slate-500 px-4 py-2 bg-slate-50 rounded-t-2xl border-b border-slate-200 font-medium">
                Come spostarsi da/per Anacapri
              </caption>
              <thead>
                <tr class="bg-slate-900 text-white">
                  <th class="text-left px-4 py-3 font-semibold">Tratta</th>
                  <th class="text-left px-4 py-3 font-semibold">Mezzo</th>
                  <th class="text-left px-4 py-3 font-semibold">Durata</th>
                  <th class="text-left px-4 py-3 font-semibold">Costo</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-slate-100">
                {[
                  ['Marina Grande → Anacapri', 'Bus ATC diretto', '~15 min', '~2 EUR'],
                  ['Capri centro → Anacapri', 'Bus ATC', '~10 min', '~2 EUR'],
                  ['Marina Grande → Anacapri', 'Taxi open-air', '~12 min', '~20-25 EUR'],
                  ['Anacapri → Grotta Azzurra', 'Bus ATC', '~10 min', '~2 EUR'],
                  ['Anacapri → Monte Solaro', 'Seggiovia', '~12 min', '~12 EUR A/R'],
                ].map(([tratta, mezzo, durata, costo]) => (
                  <tr class="hover:bg-slate-50 transition-colors">
                    <td class="px-4 py-3 font-medium text-charcoal">{tratta}</td>
                    <td class="px-4 py-3 text-slate-500">{mezzo}</td>
                    <td class="px-4 py-3 font-mono">{durata}</td>
                    <td class="px-4 py-3 text-slate-500">{costo}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          <p class="text-xs text-slate-400 mt-2">* Prezzi e tempi indicativi estate 2026.</p>
        </div>

        <div>
          <h2 class="font-serif text-3xl font-semibold text-slate-900 mb-6">Sentieri e trekking da Anacapri</h2>
          <div class="grid sm:grid-cols-2 gap-6">
            {[
              { title: 'Scala Fenicia (discesa)', text: '921 gradini dalla strada panoramica fino a Marina Grande. Circa 25 minuti in discesa (45 in salita). Panorami incredibili sulla costa nord dell\'isola. Partenza da Via Capodimonte.' },
              { title: 'Sentiero dei Fortini', text: 'Percorso costiero di circa 5 km che collega la Grotta Azzurra al Faro di Punta Carena passando per tre fortini borbonici. Vista aperta sul mare, ideale al tramonto. Durata circa 2 ore.' },
              { title: 'Monte Solaro a piedi', text: 'Da Piazza Vittoria si sale a piedi fino alla vetta (589 m) in circa 1 ora attraverso boschi di leccio e macchia mediterranea. Alternativa gratuita alla seggiovia.' },
              { title: 'Migliera - Belvedere della Migliara', text: 'Passeggiata pianeggiante di circa 30 minuti da Anacapri centro fino al belvedere sulla costa sud e i Faraglioni. Percorso facile, adatto a tutti. Arriva al Tuono, un ristorante panoramico.' },
            ].map(({ title, text }) => (
              <div class="bg-white rounded-[3rem] p-8 border border-slate-100 hover:shadow-xl transition-all duration-300">
                <h3 class="font-semibold text-charcoal mb-2">{title}</h3>
                <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">{text}</p>
              </div>
            ))}
          </div>
        </div>

        <div id="faq">
          <h2 class="font-serif text-3xl font-semibold text-slate-900 mb-8">Domande frequenti su Anacapri</h2>
          <div class="space-y-4">
            {faqSchema.mainEntity.map((q) => (
              <details class="group border border-slate-200 rounded-2xl overflow-hidden">
                <summary class="flex items-center justify-between px-6 py-4 cursor-pointer select-none text-charcoal font-medium hover:bg-slate-50 transition-colors">
                  {q.name}
                  <svg class="w-4 h-4 text-slate-400 group-open:rotate-180 transition-transform flex-shrink-0 ml-3" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
                </summary>
                <div class="px-6 pb-5 text-slate-600 leading-relaxed text-xs sm:text-sm border-t border-slate-100 pt-4">
                  {q.acceptedAnswer.text}
                </div>
              </details>
            ))}
          </div>
        </div>

      </div>

      <aside class="space-y-6 lg:sticky lg:top-24 self-start">
        <div id="fast-facts" class="bg-slate-900 text-white rounded-[3rem] p-6">
          <p class="text-[10px] uppercase tracking-[0.3em] text-med-gold font-medium mb-4">Fast Facts - Anacapri</p>
          <dl class="space-y-3">
            {fastFacts.map(({ dt, dd }, i) => (
              <>
                <div class="flex justify-between items-start gap-3">
                  <dt class="text-white/40 text-xs sm:text-sm font-light flex-shrink-0">{dt}</dt>
                  <dd class="text-white font-medium text-xs sm:text-sm text-right">{dd}</dd>
                </div>
                {i < fastFacts.length - 1 && <div class="border-t border-white/5"></div>}
              </>
            ))}
          </dl>
        </div>

        <div class="bg-med-cream border border-med-gold/30 rounded-[2rem] p-6">
          <p class="text-[10px] uppercase tracking-[0.3em] text-med-gold font-medium mb-3">Consigli degli insider</p>
          <ul class="space-y-3">
            {tips.map(tip => (
              <li class="flex items-start gap-2 text-xs sm:text-sm text-charcoal">
                <span class="w-1.5 h-1.5 rounded-full bg-med-gold mt-1.5 flex-shrink-0"></span>
                <span set:html={tip}></span>
              </li>
            ))}
          </ul>
        </div>

        <div class="bg-white border border-slate-100 rounded-[2rem] p-6 shadow-sm">
          <p class="text-[10px] uppercase tracking-[0.3em] text-slate-400 font-medium mb-3">Altre isole del Golfo</p>
          <nav class="space-y-1">
            {[
              { href: '/it-it/isole/capri/', label: 'Capri' },
              { href: '/it-it/isole/ischia/', label: 'Ischia' },
              { href: '/it-it/isole/forio/', label: 'Forio' },
              { href: '/it-it/isole/procida/', label: 'Procida' },
            ].map(({ href, label }) => (
              <a href={href} class="flex items-center gap-2 px-3 py-2 rounded-xl text-xs sm:text-sm text-charcoal hover:bg-med-blue/5 hover:text-med-blue transition-colors">
                <span class="w-1.5 h-1.5 rounded-full bg-med-blue/30"></span> {label}
              </a>
            ))}
          </nav>
        </div>
      </aside>

    </div>
  </section>

  <CorrelationSlider
    heading="Esplora le altre isole e la Costiera"
    items={[
      { name: 'Capri',     href: '/it-it/isole/capri/',                 tag: 'La piu iconica',   desc: 'Grotta Azzurra, Faraglioni, la Piazzetta: l\'isola piu famosa del Golfo.' },
      { name: 'Ischia',    href: '/it-it/isole/ischia/',                tag: 'Terme & Natura',   desc: 'Terme naturali, Castello Aragonese, Monte Epomeo e spiagge vulcaniche.' },
      { name: 'Forio',     href: '/it-it/isole/forio/',                 tag: 'Tramonti & Terme', desc: 'I Giardini Poseidon, la Chiesa del Soccorso e i tramonti piu belli di Ischia.' },
      { name: 'Procida',   href: '/it-it/isole/procida/',               tag: 'La piu autentica', desc: 'Case colorate a Marina Corricella, Capitale italiana della Cultura 2022.' },
      { name: 'Positano',  href: '/it-it/costiera-amalfitana/positano/', tag: 'Fashion & Vista',  desc: 'Le case colorate a picco sul mare, boutique di lusso e la spiaggia Fornillo.' },
    ]}
  />

</BaseLayout>
