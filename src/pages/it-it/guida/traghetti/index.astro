---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../../components/Breadcrumbs.astro';

const lang = 'it-it';

const breadcrumbs = [
  { name: 'Home', url: '/it-it/' },
  { name: 'Pianificazione', url: '/it-it/pianificazione/' },
  { name: 'Traghetti', url: '/it-it/guida/traghetti/' },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Qual e la differenza tra traghetto e aliscafo sulla Costiera?",
      "acceptedAnswer": { "@type": "Answer", "text": "Il traghetto e lento (50-90 min Napoli-Capri) ma piu economico e stabile. L\'aliscafo e veloce (40-50 min) ma piu caro e non circola con mare mosso. In estate preferire l\'aliscafo per risparmiare tempo; in inverno o con maltempo il traghetto e piu affidabile." }
    },
    {
      "@type": "Question",
      "name": "Si prenotano online i traghetti per la Costiera?",
      "acceptedAnswer": { "@type": "Answer", "text": "Si, quasi tutte le compagnie permettono la prenotazione online: nlg.it, alilauro.it, snav.it, travelmar.it, caremar.it. In estate (luglio-agosto) si consiglia di prenotare almeno 1-2 giorni prima per i traghetti da Napoli per Capri e Ischia." }
    },
    {
      "@type": "Question",
      "name": "Quanto costa il traghetto da Napoli a Capri?",
      "acceptedAnswer": { "@type": "Answer", "text": "Traghetto Napoli-Capri (Caremar/SNAV): ~€13-15 andata. Aliscafo (NLG/Alilauro): ~€20-23 andata. Da Sorrento: ~€18-22 A/R in aliscafo. I prezzi variano leggermente tra compagnie e stagione." }
    },
    {
      "@type": "Question",
      "name": "I traghetti circolano in inverno?",
      "acceptedAnswer": { "@type": "Answer", "text": "Si, ma con frequenze ridotte. Napoli-Capri: almeno 4-5 corse al giorno tutto l\'anno. Napoli-Ischia: servizio annuale frequente. I collegamenti stagionali (Positano, Amalfi, Salerno) sono attivi da aprile a ottobre." }
    }
  ]
};

const routes = [
  {
    from: 'Napoli Beverello',
    to: 'Capri',
    time: '40–50 min (aliscafo) / 75 min (traghetto)',
    price: '€20–23 / €13–15',
    companies: 'NLG, Alilauro, SNAV, Caremar',
    seasonal: false,
  },
  {
    from: 'Napoli Beverello',
    to: 'Ischia (Casamicciola/Porto)',
    time: '50 min (aliscafo) / 75 min (traghetto)',
    price: '€20–24 / €12–14',
    companies: 'Alilauro, SNAV, Caremar, Medmar',
    seasonal: false,
  },
  {
    from: 'Napoli Beverello',
    to: 'Procida',
    time: '35 min (aliscafo)',
    price: '€15–18',
    companies: 'Alilauro, SNAV',
    seasonal: false,
  },
  {
    from: 'Sorrento',
    to: 'Capri',
    time: '20–25 min (aliscafo)',
    price: '€18–22',
    companies: 'NLG, Alilauro',
    seasonal: false,
  },
  {
    from: 'Pozzuoli',
    to: 'Ischia / Procida',
    time: '35 min / 15 min (traghetto)',
    price: '€10–13 / €7–9',
    companies: 'Medmar, Caremar',
    seasonal: false,
  },
  {
    from: 'Salerno',
    to: 'Amalfi / Positano / Capri',
    time: '45 min / 65 min / 100 min',
    price: '€8–12 / €12–16 / €18–22',
    companies: 'Travelmar, NLG',
    seasonal: true,
  },
  {
    from: 'Napoli Beverello',
    to: 'Positano / Amalfi',
    time: '75 min / 90 min',
    price: '€15–20 / €18–22',
    companies: 'NLG, Alilauro',
    seasonal: true,
  },
];
---

<BaseLayout
  title="Traghetti Napoli Amalfi Positano 2026 | Aliscafo Amalfi Capri"
  description="Guida traghetti Napoli costiera amalfitana: Napoli-Amalfi-Positano, Amalfi Capri aliscafo, Napoli-Ischia, Sorrento-Capri. Compagnie, orari e prezzi aggiornati."
  lang={lang}
  breadcrumbs={breadcrumbs}
  schema={[faqSchema]}
 pageKey="traghetti">

  <section class="relative h-[75vh] sm:h-[90vh] flex items-center bg-charcoal overflow-hidden">
    <img src="/images/traghetti-hero.jpg" alt="Traghetto sulla Costiera Amalfitana" class="absolute inset-0 w-full h-full object-cover" loading="eager" referrerpolicy="no-referrer"/>
    
    <div class="absolute inset-0 bg-gradient-to-b from-black/25 via-black/40 to-black/75"></div>
    <div class="relative z-10 max-w-7xl mx-auto px-6 py-20">
      <div class="max-w-3xl">
        <p class="text-med-gold text-xs sm:text-sm font-medium uppercase tracking-[0.3em] mb-3">Guida Pratica</p>
        <h1 class="font-serif text-display text-white mb-4">Traghetti & Aliscafi</h1>
        <p class="text-xl text-white/80 leading-relaxed">
          Tutte le rotte marittime della <strong>Costiera Amalfitana</strong>: <strong>traghetti Napoli Amalfi Positano</strong>, <strong>Amalfi Capri aliscafo</strong>, Napoli, Sorrento, Salerno, Ischia e Procida. Compagnie, orari indicativi e prezzi aggiornati per la stagione 2026.
        </p>
      </div>
    </div>
    <Breadcrumbs breadcrumbs={breadcrumbs} />
  </section>

  <div class="max-w-editorial mx-auto px-4 sm:px-6 lg:px-8 pt-0 pb-16 space-y-16">

    <section>
      <h2 class="font-serif text-2xl font-semibold text-slate-900 mb-0">Tutte le rotte principali</h2>
      <div class="overflow-x-auto rounded-2xl" style="margin-top: -8px;">
        <table class="w-full text-xs sm:text-sm">
          <thead>
            <tr class="bg-slate-900 text-white">
              <th class="text-left px-2 py-2 sm:px-4 sm:py-3 font-semibold text-xs sm:text-sm">Da</th>
              <th class="text-left px-2 py-2 sm:px-4 sm:py-3 font-semibold text-xs sm:text-sm">A</th>
              <th class="text-left px-2 py-2 sm:px-4 sm:py-3 font-semibold text-xs sm:text-sm">Durata</th>
              <th class="text-left px-2 py-2 sm:px-4 sm:py-3 font-semibold text-xs sm:text-sm">Prezzo (A/R)</th>
              <th class="hidden sm:table-cell px-4 py-3 font-semibold text-sm">Compagnie</th>
              <th class="hidden sm:table-cell px-4 py-3 font-semibold text-sm">Stagionale</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100">
            {routes.map(r => (
              <tr class="hover:bg-slate-50 transition-colors">
                <td class="px-2 py-2 sm:px-4 sm:py-3 font-medium text-charcoal text-xs sm:text-sm">{r.from}</td>
                <td class="px-2 py-2 sm:px-4 sm:py-3 text-xs sm:text-sm">{r.to}</td>
                <td class="px-2 py-2 sm:px-4 sm:py-3 text-slate-600 text-xs sm:text-sm">{r.time}</td>
                <td class="px-2 py-2 sm:px-4 sm:py-3 font-mono text-xs">{r.price}</td>
                <td class="hidden sm:table-cell px-4 py-3 text-slate-500 text-sm">{r.companies}</td>
                <td class="hidden sm:table-cell px-4 py-3">
                  {r.seasonal
                    ? <span class="text-[10px] bg-med-cream text-med-gold px-2 py-0.5 rounded-full font-medium">Apr–Ott</span>
                    : <span class="text-[10px] bg-med-blue/5 text-med-blue px-2 py-0.5 rounded-full font-medium">Tutto l\'anno</span>
                  }
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="text-xs text-slate-400 mt-2">* Prezzi e durate indicativi. Verifica sempre sulle compagnie: nlg.it, alilauro.it, snav.it, caremar.it, medmar.it, travelmar.it</p>
    </section>

    <section>
      <h2 class="font-serif text-2xl font-semibold text-slate-900 mb-6">Le compagnie e i loro punti di forza</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3 sm:gap-4">
        {[
          { name: 'NLG', desc: 'Napoli→Capri, Sorrento→Capri. Aliscafi veloci e frequenti. Prenota su nlg.it.' },
          { name: 'Alilauro', desc: 'Napoli→Capri/Ischia/Procida/Sorrento. La più grande flotta di aliscafi. alilauro.it.' },
          { name: 'SNAV', desc: 'Napoli→Capri/Ischia/Procida. Anche traghetti veloci. snav.it.' },
          { name: 'Caremar', desc: 'Traghetti lenti Napoli→Capri/Ischia/Procida. I più economici ma i più lenti. caremar.it.' },
          { name: 'Medmar', desc: 'Traghetti Pozzuoli→Ischia/Procida. Economici, frequenti. medmar.it.' },
          { name: 'Travelmar', desc: 'Salerno→Amalfi→Positano stagionale. La rotta da Salerno. travelmar.it.' },
        ].map(c => (
          <div class="bg-med-cream rounded-xl p-3 sm:p-4 border border-slate-100">
            <p class="font-semibold text-charcoal text-sm mb-1">{c.name}</p>
            <p class="text-xs text-slate-600 leading-snug">{c.desc}</p>
          </div>
        ))}
      </div>
    </section>

    <section class="bg-med-cream border border-med-gold/20 rounded-[2rem] p-6 sm:p-8">
      <p class="font-semibold text-charcoal text-base sm:text-lg mb-3">Consigli pratici</p>
      <ul class="space-y-2">
        {[
          'In luglio e agosto prenota i biglietti il giorno prima: le prime partenze del mattino (7:00–8:30) si esauriscono.',
          'L\'aliscafo non parte con mare mosso (Beaufort 4–5): controlla sempre le previsioni meteo marine prima.',
          'Il porto di imbarco a Napoli per quasi tutto è il Molo Beverello (piazza Municipio). Medmar parte da Pozzuoli.',
          'Con bambini piccoli il traghetto è più stabile dell\'aliscafo: meno rollio, ponte esterno accessibile.',
          'Il biglietto di ritorno si può acquistare anche nell\'isola: non è necessario comprarlo all\'andata.',
        ].map(tip => (
          <li class="flex items-start gap-2 text-xs sm:text-sm text-charcoal">
            <span class="w-1.5 h-1.5 rounded-full bg-med-gold mt-1.5 flex-shrink-0"></span>
            <span>{tip}</span>
          </li>
        ))}
      </ul>
    </section>

    <section id="faq">
      <h2 class="font-serif text-2xl font-semibold text-slate-900 mb-6">Domande frequenti</h2>
      <div class="space-y-4">
        {faqSchema.mainEntity.map((q) => (
          <details class="group border border-slate-200 rounded-2xl overflow-hidden">
            <summary class="flex items-center justify-between px-6 py-4 cursor-pointer select-none text-charcoal font-medium hover:bg-slate-50 transition-colors">
              {q.name}
              <svg class="w-4 h-4 text-slate-400 group-open:rotate-180 transition-transform flex-shrink-0 ml-3" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
            </summary>
            <div class="px-6 pb-5 text-slate-600 leading-relaxed text-xs sm:text-sm border-t border-slate-100 pt-4">
              {q.acceptedAnswer.text}
            </div>
          </details>
        ))}
      </div>
    </section>

    <!-- EVERYTHING YOU NEED -->
    <section class="py-16 bg-white">
      <div class="max-w-editorial mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-12">
          <h2 class="font-serif text-2xl font-semibold text-slate-900 mb-6">Tutto quello che ti serve</h2>
          <div class="w-20 h-1 bg-med-gold mx-auto rounded-full"></div>
        </div>

        <!-- MOBILE: Swiper slider -->
        <div class="swiper swiper-guides md:hidden">
          <div class="swiper-wrapper pb-12">
            <div class="swiper-slide">
              <a href="/it-it/guida/traghetti/" class="block bg-slate-900 rounded-[2rem] p-6 border-0 hover:shadow-lg transition-all duration-300 h-full">
                <h3 class="font-serif text-xl font-bold text-med-gold mb-2">Traghetti</h3>
                <p class="text-white text-sm mb-3">Come raggiungere la costa via mare</p>
                <p class="text-white/70 text-xs leading-relaxed mb-4">Orari, tariffe e rotte principali da Napoli e Salerno</p>
                <span class="text-med-gold font-semibold text-sm">Leggi guida →</span>
              </a>
            </div>
            <div class="swiper-slide">
              <a href="/it-it/guida/bus-sita/" class="block bg-slate-900 rounded-[2rem] p-6 border-0 hover:shadow-lg transition-all duration-300 h-full">
                <h3 class="font-serif text-xl font-bold text-med-gold mb-2">Bus SITA</h3>
                <p class="text-white text-sm mb-3">Orari, tariffe e rotte principali</p>
                <p class="text-white/70 text-xs leading-relaxed mb-4">Come spostarsi sulla costa in bus: tutte le linee e fermate</p>
                <span class="text-med-gold font-semibold text-sm">Leggi →</span>
              </a>
            </div>
            <div class="swiper-slide">
              <a href="/it-it/guida/quando-visitare/" class="block bg-slate-900 rounded-[2rem] p-6 border-0 hover:shadow-lg transition-all duration-300 h-full">
                <h3 class="font-serif text-xl font-bold text-med-gold mb-2">Quando Visitare</h3>
                <p class="text-white text-sm mb-3">Mese per mese: meteo e folle</p>
                <p class="text-white/70 text-xs leading-relaxed mb-4">Scegli il momento migliore per visitare</p>
                <span class="text-med-gold font-semibold text-sm">Leggi →</span>
              </a>
            </div>
          </div>
          <div class="swiper-pagination"></div>
        </div>

        <!-- DESKTOP: Grid 3 colonne -->
        <div class="hidden md:grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          <a href="/it-it/guida/traghetti/" class="block bg-slate-900 rounded-[2rem] p-6 border-0 hover:shadow-lg transition-all duration-300">
            <h3 class="font-serif text-xl font-bold text-med-gold mb-2">Traghetti</h3>
            <p class="text-white text-sm mb-3">Come raggiungere la costa via mare</p>
            <p class="text-white/70 text-xs leading-relaxed mb-4">Orari, tariffe e rotte principali da Napoli e Salerno</p>
            <span class="text-med-gold font-semibold text-sm">Leggi guida →</span>
          </a>

          <a href="/it-it/guida/bus-sita/" class="block bg-slate-900 rounded-[2rem] p-6 border-0 hover:shadow-lg transition-all duration-300">
            <h3 class="font-serif text-xl font-bold text-med-gold mb-2">Bus SITA</h3>
            <p class="text-white text-sm mb-3">Orari, tariffe e rotte principali</p>
            <p class="text-white/70 text-xs leading-relaxed mb-4">Come spostarsi sulla costa in bus: tutte le linee e fermate</p>
            <span class="text-med-gold font-semibold text-sm">Leggi →</span>
          </a>

          <a href="/it-it/guida/quando-visitare/" class="block bg-slate-900 rounded-[2rem] p-6 border-0 hover:shadow-lg transition-all duration-300">
            <h3 class="font-serif text-xl font-bold text-med-gold mb-2">Quando Visitare</h3>
            <p class="text-white text-sm mb-3">Mese per mese: meteo e folle</p>
            <p class="text-white/70 text-xs leading-relaxed mb-4">Scegli il momento migliore per visitare</p>
            <span class="text-med-gold font-semibold text-sm">Leggi →</span>
          </a>
        </div>
      </div>
    </section>

    <!-- AUTHENTIC EXPERIENCES -->
    <section class="py-16 bg-white overflow-hidden">
      <div class="max-w-editorial mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex flex-col md:flex-row justify-between items-end mb-12 gap-6">
          <div class="max-w-2xl">
            <span class="text-med-gold font-bold uppercase tracking-[0.3em] text-xs mb-4 block">Scopri il Territorio</span>
            <h2 class="font-serif text-2xl font-semibold text-slate-900 mb-6">Esperienze Autentiche</h2>
            <p class="text-slate-600 text-lg">Dalla cucina tradizionale alle visite ai limoneti, scopri l'anima vera della Costa.</p>
          </div>
          <a href="/it-it/esperienze/" class="group flex items-center gap-2 text-med-blue font-semibold hover:text-med-gold transition-colors">
            Tutte le Esperienze
            <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
          </a>
        </div>

        <!-- MOBILE: Swiper slider -->
        <div class="swiper swiper-experiences md:hidden">
          <div class="swiper-wrapper pb-12">
            <div class="swiper-slide">
              <a href="/it-it/esperienze/cooking-class-costiera-amalfitana/" class="group block">
                <div class="relative aspect-[16/10] rounded-[2.5rem] overflow-hidden mb-6 shadow-lg">
                  <img
                    src="/images/cooking-class-hero.webp"
                    alt="Cooking Class"
                    class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
                    loading="lazy"
                    decoding="async"
                  />
                  <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent" />
                  <div class="absolute bottom-6 left-6">
                    <h3 class="text-2xl font-serif font-bold text-white">Cooking Class</h3>
                  </div>
                </div>
              </a>
            </div>
            <div class="swiper-slide">
              <a href="/it-it/esperienze/limoncello-tour/" class="group block">
                <div class="relative aspect-[16/10] rounded-[2.5rem] overflow-hidden mb-6 shadow-lg">
                  <img
                    src="/images/limoncello-mercato-hero.webp"
                    alt="Limoncello Tour"
                    class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
                    loading="lazy"
                    decoding="async"
                  />
                  <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent" />
                  <div class="absolute bottom-6 left-6">
                    <h3 class="text-2xl font-serif font-bold text-white">Tour Limoncello</h3>
                  </div>
                </div>
              </a>
            </div>
            <div class="swiper-slide">
              <a href="/it-it/esperienze/mozzarella-experience/" class="group block">
                <div class="relative aspect-[16/10] rounded-[2.5rem] overflow-hidden mb-6 shadow-lg">
                  <img
                    src="/images/mozzarella-provolone-hero.webp"
                    alt="Mozzarella Experience"
                    class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
                    loading="lazy"
                    decoding="async"
                  />
                  <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent" />
                  <div class="absolute bottom-6 left-6">
                    <h3 class="text-2xl font-serif font-bold text-white">Mozzarella</h3>
                  </div>
                </div>
              </a>
            </div>
            <div class="swiper-slide">
              <a href="/it-it/esperienze/ristoranti-stellati-costiera-amalfitana/" class="group block">
                <div class="relative aspect-[16/10] rounded-[2.5rem] overflow-hidden mb-6 shadow-lg">
                  <img
                    src="/images/ravello-hero.webp"
                    alt="Michelin Starred"
                    class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
                    loading="lazy"
                    decoding="async"
                  />
                  <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent" />
                  <div class="absolute bottom-6 left-6">
                    <h3 class="text-2xl font-serif font-bold text-white">Michelin Starred</h3>
                  </div>
                </div>
              </a>
            </div>
          </div>
          <div class="swiper-pagination"></div>
        </div>

        <!-- DESKTOP: Grid -->
        <div class="hidden md:grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
          <a href="/it-it/esperienze/cooking-class-costiera-amalfitana/" class="group block">
            <div class="relative aspect-[16/10] rounded-[2.5rem] overflow-hidden mb-6 shadow-lg">
              <img
                src="/images/cooking-class-hero.webp"
                alt="Cooking Class"
                class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
                loading="lazy"
                decoding="async"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent" />
              <div class="absolute bottom-6 left-6">
                <h3 class="text-2xl font-serif font-bold text-white">Cooking Class</h3>
              </div>
            </div>
          </a>

          <a href="/it-it/esperienze/limoncello-tour/" class="group block">
            <div class="relative aspect-[16/10] rounded-[2.5rem] overflow-hidden mb-6 shadow-lg">
              <img
                src="/images/limoncello-mercato-hero.webp"
                alt="Limoncello Tour"
                class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
                loading="lazy"
                decoding="async"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent" />
              <div class="absolute bottom-6 left-6">
                <h3 class="text-2xl font-serif font-bold text-white">Tour Limoncello</h3>
              </div>
            </div>
          </a>

          <a href="/it-it/esperienze/mozzarella-experience/" class="group block">
            <div class="relative aspect-[16/10] rounded-[2.5rem] overflow-hidden mb-6 shadow-lg">
              <img
                src="/images/mozzarella-provolone-hero.webp"
                alt="Mozzarella Experience"
                class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
                loading="lazy"
                decoding="async"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent" />
              <div class="absolute bottom-6 left-6">
                <h3 class="text-2xl font-serif font-bold text-white">Mozzarella</h3>
              </div>
            </div>
          </a>

          <a href="/it-it/esperienze/ristoranti-stellati-costiera-amalfitana/" class="group block">
            <div class="relative aspect-[16/10] rounded-[2.5rem] overflow-hidden mb-6 shadow-lg">
              <img
                src="/images/ravello-hero.webp"
                alt="Michelin Starred"
                class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
                loading="lazy"
                decoding="async"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent" />
              <div class="absolute bottom-6 left-6">
                <h3 class="text-2xl font-serif font-bold text-white">Michelin Starred</h3>
              </div>
            </div>
          </a>
        </div>
      </div>
    </section>

  </div>

<script>
  function cleanApostrophes(text) {
    return String(text).replace(/\'/g, "'");
  }
  import Swiper from 'swiper';
  import { Pagination } from 'swiper/modules';

  // Guides slider
  new Swiper('.swiper-guides', {
    modules: [Pagination],
