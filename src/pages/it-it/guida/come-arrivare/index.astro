---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../../components/Breadcrumbs.astro';
import { getTranslations, getLocalePath } from '../../../../i18n/translations';

const lang = 'it-it';
const t = getTranslations(lang);

const breadcrumbs = [
  { name: 'Home', url: '/it-it/' },
  { name: 'Pianificazione', url: '/it-it/pianificazione/' },
  { name: 'Come arrivare', url: '/it-it/guida/come-arrivare/' },
];
---

<BaseLayout
  title={t.meta.getting_here_title}
  description={t.meta.getting_here_description}
  lang={lang}
  breadcrumbs={breadcrumbs}
 pageKey="come-arrivare">
  <!-- Hero -->
  <section class="relative h-[75vh] sm:h-[90vh] flex items-center bg-charcoal overflow-hidden">
    <img src="/images/come-arrivare-hero.jpg" alt="Porto di Sorrento, Costiera Amalfitana" class="absolute inset-0 w-full h-full object-cover" loading="eager" fetchpriority="high" decoding="sync" referrerpolicy="no-referrer"/>
    <div class="absolute inset-0 bg-gradient-to-b from-black/25 via-black/40 to-black/75"></div>
    <div class="relative z-10 max-w-7xl mx-auto px-6 text-center">
      <p class="text-med-gold text-xs sm:text-sm uppercase tracking-[0.3em] mb-3 font-medium">Guida pratica</p>
      <h1 class="font-serif text-4xl md:text-5xl font-bold text-white mb-4 tracking-tight">Come arrivare alla Costiera Amalfitana</h1>
      <p class="text-white/80 text-lg max-w-2xl mx-auto font-light">Treno, aereo, traghetto o auto: tutte le opzioni per raggiungere la costiera dall'Italia e dall'estero.</p>
    </div>
    <Breadcrumbs breadcrumbs={breadcrumbs} />
  </section>

  <section class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <p class="text-base sm:text-lg text-slate-600 leading-relaxed">
      La Costiera Amalfitana non ha un aeroporto proprio né una stazione ferroviaria sul tratto principale. Il modo più comodo per arrivarci è passare per Napoli (aeroporto internazionale e stazione ad alta velocità) o per Salerno (raggiungibile in treno da tutta Italia). Da lì ci sono traghetti, bus e transfer privati.
    </p>
  </section>

  <!-- Consiglio rapido -->
  <section class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 pb-12">
    <div class="bg-slate-900 rounded-[2rem] p-6 sm:p-8">
      <div class="flex items-start gap-4">
        <div class="w-10 h-10 rounded-xl bg-med-gold/15 flex items-center justify-center flex-shrink-0 mt-1">
          <svg class="w-5 h-5 text-med-gold" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 18v-5.25m0 0a6.01 6.01 0 0 0 1.5-.189m-1.5.189a6.01 6.01 0 0 1-1.5-.189m3.75 7.478a12.06 12.06 0 0 1-4.5 0m3.75 2.383a14.406 14.406 0 0 1-3 0M14.25 18v-.192c0-.983.658-1.823 1.508-2.316a7.5 7.5 0 1 0-7.517 0c.85.493 1.509 1.333 1.509 2.316V18"/></svg>
        </div>
        <div>
          <p class="text-med-gold text-xs font-bold uppercase tracking-wider mb-2">Il nostro consiglio</p>
          <p class="text-white/80 text-sm sm:text-base leading-relaxed"><strong class="text-white">In alta stagione (mag-ott):</strong> vola su Napoli, prendi il traghetto diretto per Positano o Amalfi. Zero traffico, viste mozzafiato.</p>
          <p class="text-white/80 text-sm sm:text-base leading-relaxed mt-2"><strong class="text-white">In bassa stagione (nov-apr):</strong> treno ad alta velocità fino a Salerno + bus SITA. Più economico e i traghetti non operano.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Confronto metodi -->
  <section class="bg-slate-900 py-16">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-[10px] uppercase tracking-[0.3em] text-med-gold font-medium mb-3">Confronto rapido</p>
      <h2 class="text-2xl font-bold font-serif text-white mb-10">Quale mezzo scegliere?</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-4">

        <div class="bg-white/5 border border-med-gold/30 rounded-2xl p-5 relative">
          <span class="absolute -top-3 left-4 bg-med-gold text-white text-[10px] font-bold uppercase tracking-wider px-3 py-1 rounded-full">Consigliato</span>
          <div class="mt-2">
            <p class="text-white font-bold text-lg mb-1">Traghetto</p>
            <p class="text-white/40 text-xs mb-4">Apr - Ott</p>
            <div class="space-y-2 text-xs text-white/60">
              <p><span class="text-white/80 font-medium">Costo:</span> €15 - €25</p>
              <p><span class="text-white/80 font-medium">Tempo:</span> 1h - 1h30</p>
              <p><span class="text-white/80 font-medium">Comfort:</span> <span class="text-med-gold">Alto</span></p>
              <p><span class="text-white/80 font-medium">Traffico:</span> Zero</p>
            </div>
          </div>
        </div>

        <div class="bg-white/5 border border-white/10 rounded-2xl p-5">
          <p class="text-white font-bold text-lg mb-1">Treno + Bus</p>
          <p class="text-white/40 text-xs mb-4">Tutto l'anno</p>
          <div class="space-y-2 text-xs text-white/60">
            <p><span class="text-white/80 font-medium">Costo:</span> €6 - €10</p>
            <p><span class="text-white/80 font-medium">Tempo:</span> 2h30 - 3h</p>
            <p><span class="text-white/80 font-medium">Comfort:</span> Medio</p>
            <p><span class="text-white/80 font-medium">Traffico:</span> Possibile su bus</p>
          </div>
        </div>

        <div class="bg-white/5 border border-white/10 rounded-2xl p-5">
          <p class="text-white font-bold text-lg mb-1">Transfer privato</p>
          <p class="text-white/40 text-xs mb-4">Tutto l'anno</p>
          <div class="space-y-2 text-xs text-white/60">
            <p><span class="text-white/80 font-medium">Costo:</span> €90 - €150</p>
            <p><span class="text-white/80 font-medium">Tempo:</span> 1h - 1h30</p>
            <p><span class="text-white/80 font-medium">Comfort:</span> <span class="text-med-gold">Alto</span></p>
            <p><span class="text-white/80 font-medium">Traffico:</span> Possibile</p>
          </div>
        </div>

        <div class="bg-white/5 border border-white/10 rounded-2xl p-5">
          <p class="text-white font-bold text-lg mb-1">Auto propria</p>
          <p class="text-white/40 text-xs mb-4">Solo bassa stagione</p>
          <div class="space-y-2 text-xs text-white/60">
            <p><span class="text-white/80 font-medium">Costo:</span> Carburante + parcheggio</p>
            <p><span class="text-white/80 font-medium">Tempo:</span> Variabile</p>
            <p><span class="text-white/80 font-medium">Comfort:</span> Medio</p>
            <p><span class="text-white/80 font-medium">Traffico:</span> <span class="text-red-400">Intenso in estate</span></p>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- Metodi -->
  <section class="py-16">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">

      <!-- Da Napoli -->
      <div class="bg-white rounded-[2rem] shadow-sm border border-slate-100 p-6 sm:p-8">
        <div class="flex items-center gap-4 mb-6">
          <div class="w-12 h-12 bg-med-gold rounded-2xl flex items-center justify-center">
            <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"/></svg>
          </div>
          <div>
            <h2 class="text-2xl font-bold font-serif">Da Napoli</h2>
            <p class="text-med-gold text-xs sm:text-sm">Aeroporto di Capodichino · Stazione Centrale</p>
          </div>
        </div>
        <p class="text-slate-600 leading-relaxed mb-6">
          Napoli è il punto di accesso principale alla Costiera Amalfitana. L'aeroporto internazionale di Capodichino (NAP) ha voli diretti da tutte le principali città europee, inclusi molti low cost da Roma, Milano, Londra, Parigi, Francoforte e Madrid. Da Napoli ci sono tre opzioni per raggiungere la costiera:
        </p>
        <div class="space-y-4">
          <div class="bg-med-gold/5 rounded-2xl p-4 sm:p-5">
            <h3 class="font-semibold text-slate-900 mb-2">Traghetto diretto (estate)</h3>
            <p class="text-slate-600 text-xs sm:text-sm">Da aprile a ottobre, traghetti veloci da Napoli Molo Beverello raggiungono direttamente Positano e Amalfi in circa 1h30. Comodo, scenografico e senza traffico. Prenota in anticipo in alta stagione.</p>
          </div>
          <div class="bg-med-gold/5 rounded-2xl p-4 sm:p-5">
            <h3 class="font-semibold text-slate-900 mb-2">Bus SITA via Sorrento</h3>
            <p class="text-slate-600 text-xs sm:text-sm">Circumvesuviana da Napoli a Sorrento (circa 1h), poi bus SITA per la costiera. Economico ma lungo (2h30–3h totali). Ottima opzione se vuoi evitare l'auto.</p>
          </div>
          <div class="bg-med-gold/5 rounded-2xl p-4 sm:p-5">
            <h3 class="font-semibold text-slate-900 mb-2">Transfer privato</h3>
            <p class="text-slate-600 text-xs sm:text-sm">Taxi o NCC dall'aeroporto di Napoli: circa 90–120 euro fino a Positano/Amalfi (1h–1h30 senza traffico). Comodo per famiglie o con bagagli voluminosi.</p>
          </div>
        </div>
      </div>

      <!-- Da Salerno -->
      <div class="bg-white rounded-[2rem] shadow-sm border border-slate-100 p-6 sm:p-8">
        <div class="flex items-center gap-4 mb-6">
          <div class="w-12 h-12 bg-med-gold rounded-2xl flex items-center justify-center">
            <svg class="w-6 h-6 text-white" fill="currentColor" viewBox="0 0 24 24"><rect x="2" y="7" width="20" height="10" rx="1"/><rect x="4" y="17" width="3" height="2"/><rect x="17" y="17" width="3" height="2"/><path d="M2 7L4 2h16l2 5"/></svg>
          </div>
          <div>
            <h2 class="text-2xl font-bold font-serif">Da Salerno</h2>
            <p class="text-med-gold text-xs sm:text-sm">Porta est della Costiera Amalfitana</p>
          </div>
        </div>
        <p class="text-slate-600 leading-relaxed mb-6">
          Salerno è una porta d'ingresso spesso sottovalutata ma comodissima. La stazione di Salerno è servita dall'alta velocità (1h40 da Roma, 2h30 da Milano) e da molti treni regionali. L'aeroporto Salerno-Costa d'Amalfi (QSR) è il più vicino alla costiera, con voli nazionali e alcune rotte europee. Da Salerno, il bus SITA verso la costiera è frequente e impiega 45 minuti fino ad Amalfi. In estate ci sono anche traghetti.
        </p>
        <div class="space-y-4">
          <div class="bg-med-gold/5 rounded-2xl p-4 sm:p-5">
            <h3 class="font-semibold text-slate-900 mb-2">Aeroporto Salerno-Costa d'Amalfi (QSR)</h3>
            <p class="text-slate-600 text-xs sm:text-sm">L'aeroporto più vicino alla Costiera Amalfitana, a soli 20 km da Vietri sul Mare. Voli da Milano, Roma e alcune città europee. Dall'aeroporto, bus o transfer privato verso la costiera in circa 30 minuti.</p>
          </div>
          <div class="bg-med-gold/5 rounded-2xl p-4 sm:p-5">
            <h3 class="font-semibold text-slate-900 mb-2">Traghetto da Salerno (estate)</h3>
            <p class="text-slate-600 text-xs sm:text-sm">Traghetti da Salerno per Amalfi e Positano da aprile a ottobre. Circa 45 minuti fino ad Amalfi, con bellissime viste della costa. Più economico dei traghetti da Napoli.</p>
          </div>
        </div>
      </div>

      <!-- Da Sorrento -->
      <div class="bg-white rounded-[2rem] shadow-sm border border-slate-100 p-6 sm:p-8">
        <div class="flex items-center gap-4 mb-6">
          <div class="w-12 h-12 bg-med-gold rounded-2xl flex items-center justify-center">
            <svg class="w-6 h-6 text-white" fill="currentColor" viewBox="0 0 24 24"><path d="M3 13h18v2H3zm0-4h18v2H3zm0 8h18v2H3zm9-12L6 8h12l-6-3zm0 14l-6 3h12l-6-3z"/></svg>
          </div>
          <div>
            <h2 class="text-2xl font-bold font-serif">Da Sorrento</h2>
            <p class="text-med-gold text-xs sm:text-sm">Via traghetto o strada panoramica</p>
          </div>
        </div>
        <p class="text-slate-600 leading-relaxed">
          Sorrento è molto frequentata come base per visitare sia la Penisola Sorrentina che la Costiera Amalfitana. I traghetti da Sorrento raggiungono Positano in 25 minuti: è il modo più pittoresco e rapido di entrare nella costiera. In alternativa, il bus SITA percorre la SP145 e la SS163 in circa 1h30 fino ad Amalfi.
        </p>
      </div>

      <!-- In auto -->
      <div class="bg-white rounded-[2rem] shadow-sm border border-slate-100 p-6 sm:p-8">
        <div class="flex items-center gap-4 mb-6">
          <div class="w-12 h-12 bg-med-gold rounded-2xl flex items-center justify-center">
            <svg class="w-6 h-6 text-white" fill="currentColor" viewBox="0 0 24 24"><path d="M18.92 6.01C18.72 5.42 18.16 5 17.5 5h-11c-.66 0-1.22.42-1.42 1.01L3 12v8c0 .55.45 1 1 1h1c.55 0 1-.45 1-1v-1h12v1c0 .55.45 1 1 1h1c.55 0 1-.45 1-1v-8l-2.08-5.99zM6.5 16c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2zm11 0c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2z"/></svg>
          </div>
          <div>
            <h2 class="text-2xl font-bold font-serif">In auto</h2>
            <p class="text-med-gold text-xs sm:text-sm font-medium">⚠️ Sconsigliata in luglio e agosto</p>
          </div>
        </div>
        <p class="text-slate-600 leading-relaxed mb-6">
          La SS163, la strada statale che attraversa la costiera, è una delle strade più spettacolari d'Europa ma anche una delle più strette. In alta stagione il traffico può essere paralizzante, con code di ore. Se usi l'auto, considera questi consigli:
        </p>
        <ul class="space-y-3">
          <li class="flex gap-3 text-xs sm:text-sm text-slate-600">
            <svg class="w-5 h-5 text-med-gold flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
            Partenza prima delle 8 di mattina o dopo le 19 di sera per evitare il traffico
          </li>
          <li class="flex gap-3 text-xs sm:text-sm text-slate-600">
            <svg class="w-5 h-5 text-med-gold flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
            Parcheggia a Sorrento o Salerno e usa i mezzi pubblici o i traghetti per la costiera
          </li>
          <li class="flex gap-3 text-xs sm:text-sm text-slate-600">
            <svg class="w-5 h-5 text-med-gold flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
            I parcheggi ad Amalfi e Positano costano 3–5 euro/ora, spesso sold out in alta stagione
          </li>
          <li class="flex gap-3 text-xs sm:text-sm text-slate-600">
            <svg class="w-5 h-5 text-med-gold flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
            In primavera (aprile–maggio) e autunno (settembre–ottobre) l'auto è piacevole e comoda
          </li>
        </ul>
      </div>

    </div>
  </section>

  <!-- Da Roma / Milano / Estero -->
  <section class="pb-16">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl font-bold font-serif text-slate-900 mb-8">Da dove parti?</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4 sm:gap-6">

        <div class="bg-white rounded-[2rem] shadow-sm border border-slate-100 p-6">
          <p class="text-med-gold text-xs font-bold uppercase tracking-wider mb-3">Da Roma</p>
          <ul class="space-y-2 text-slate-600 text-xs sm:text-sm">
            <li class="flex gap-2"><span class="text-med-gold font-bold">1.</span> Treno AV Roma - Salerno (1h40, da €19)</li>
            <li class="flex gap-2"><span class="text-med-gold font-bold">2.</span> Bus SITA Salerno - Amalfi (45 min, €2.40)</li>
            <li class="flex gap-2"><span class="text-slate-400 text-xs">Totale: circa 2h30 - la via più rapida</span></li>
          </ul>
        </div>

        <div class="bg-white rounded-[2rem] shadow-sm border border-slate-100 p-6">
          <p class="text-med-blue text-xs font-bold uppercase tracking-wider mb-3">Da Milano</p>
          <ul class="space-y-2 text-slate-600 text-xs sm:text-sm">
            <li class="flex gap-2"><span class="text-med-blue font-bold">A.</span> Volo Milano - Napoli (1h15, da €30) + traghetto</li>
            <li class="flex gap-2"><span class="text-med-blue font-bold">B.</span> Volo Milano - Salerno (1h20) - aeroporto più vicino alla costiera</li>
            <li class="flex gap-2"><span class="text-med-blue font-bold">C.</span> Treno AV Milano - Salerno (4h30, da €39) + bus</li>
            <li class="flex gap-2"><span class="text-slate-400 text-xs">Salerno è il più vicino, Napoli ha più voli</span></li>
          </ul>
        </div>

        <div class="bg-white rounded-[2rem] shadow-sm border border-slate-100 p-6">
          <p class="text-slate-500 text-xs font-bold uppercase tracking-wider mb-3">Dall'estero</p>
          <ul class="space-y-2 text-slate-600 text-xs sm:text-sm">
            <li class="flex gap-2"><span class="text-slate-400 font-bold">✈</span> Vola su Napoli (NAP) - voli diretti da Londra, Parigi, Berlino, Madrid, Amsterdam</li>
            <li class="flex gap-2"><span class="text-slate-400 font-bold">✈</span> Salerno (QSR) - aeroporto Costa d'Amalfi, il più vicino alla costiera</li>
            <li class="flex gap-2"><span class="text-slate-400 font-bold">✈</span> In alternativa: Roma Fiumicino + treno AV a Salerno</li>
            <li class="flex gap-2"><span class="text-slate-400 text-xs">Salerno è il più vicino, Napoli ha più voli low cost, Roma più intercontinentali</span></li>
          </ul>
        </div>

      </div>
    </div>
  </section>

  <!-- Distanze e tempi di viaggio - Tab per destinazione -->
  <section class="bg-slate-100 py-16">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl font-bold font-serif text-slate-900 mb-8 text-center">Distanze e tempi di viaggio</h2>

      <!-- Tab buttons -->
      <div class="flex flex-wrap justify-center gap-2 mb-8" role="tablist">
        <button role="tab" aria-selected="true" data-tab="costiera" class="tab-btn px-4 py-2 rounded-full text-xs sm:text-sm font-medium bg-slate-900 text-white transition-colors">Costiera Amalfitana</button>
        <button role="tab" aria-selected="false" data-tab="penisola" class="tab-btn px-4 py-2 rounded-full text-xs sm:text-sm font-medium bg-white text-slate-600 hover:bg-slate-200 transition-colors">Penisola Sorrentina</button>
        <button role="tab" aria-selected="false" data-tab="isole" class="tab-btn px-4 py-2 rounded-full text-xs sm:text-sm font-medium bg-white text-slate-600 hover:bg-slate-200 transition-colors">Isole</button>
      </div>

      <!-- Tab: Costiera Amalfitana -->
      <div data-panel="costiera" class="tab-panel">
        <div class="overflow-x-auto">
          <table class="w-full bg-white rounded-2xl shadow-sm overflow-hidden">
            <thead class="bg-slate-900 text-white">
              <tr>
                <th class="px-3 py-2 sm:px-6 sm:py-4 text-left text-xs sm:text-sm font-semibold">Da</th>
                <th class="px-3 py-2 sm:px-6 sm:py-4 text-left text-xs sm:text-sm font-semibold">A</th>
                <th class="px-3 py-2 sm:px-6 sm:py-4 text-left text-xs sm:text-sm font-semibold">Mezzo</th>
                <th class="px-3 py-2 sm:px-6 sm:py-4 text-left text-xs sm:text-sm font-semibold">Tempo</th>
                <th class="px-3 py-2 sm:px-6 sm:py-4 text-left text-xs sm:text-sm font-semibold">Prezzo</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
            <!-- Positano -->
            <tr class="hover:bg-slate-50">
              <td class="px-3 py-2 sm:px-6 sm:py-4 text-xs sm:text-sm">Napoli (Beverello)</td>
              <td class="px-3 py-2 sm:px-6 sm:py-4 text-xs sm:text-sm font-medium">Positano</td>
              <td class="px-3 py-2 sm:px-6 sm:py-4 text-xs sm:text-sm">Traghetto (estate)</td>
              <td class="px-3 py-2 sm:px-6 sm:py-4 text-xs sm:text-sm text-med-gold font-medium">1h 30min</td>
              <td class="px-3 py-2 sm:px-6 sm:py-4 text-xs sm:text-sm">€18 - €22</td>
            </tr>
            <tr class="hover:bg-slate-50">
