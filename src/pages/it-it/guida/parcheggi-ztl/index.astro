---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../../components/Breadcrumbs.astro';

const lang = 'it-it';

const breadcrumbs = [
  { name: 'Home', url: '/it-it/' },
  { name: 'Pianificazione', url: '/it-it/pianificazione/' },
  { name: 'Parcheggi e ZTL', url: '/it-it/guida/parcheggi-ztl/' },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Ci sono parcheggi gratuiti in Costiera Amalfitana?",
      "acceptedAnswer": { "@type": "Answer", "text": "Pochissimi. Le strisce bianche si trovano soprattutto lontano dai centri: Montepertuso e Nocelle sopra Positano, alcuni tratti a bordo strada sulla SS163 e sulla strada per Agerola prima di Amalfi, Via Chiunzi a Maiori, Via Rota e Via Parsano a Sorrento. A luglio e agosto di solito sono occupate entro le 9:00. Leggi sempre il cartello accanto alle strisce: molti posti bianchi sono riservati ai residenti o hanno un limite di tempo con il disco orario." }
    },
    {
      "@type": "Question",
      "name": "Quanto costa parcheggiare a Positano?",
      "acceptedAnswer": { "@type": "Answer", "text": "I garage privati del centro, come Mandara e De Gennaro, costano circa €8-12 all'ora e €50-90 al giorno in estate. Le strisce blu comunali costano circa €3 all'ora ma sono quasi sempre piene. Posti gratuiti esistono solo in alto, a Montepertuso e Nocelle, collegati al centro dal bus locale." }
    },
    {
      "@type": "Question",
      "name": "Quanto costa il parcheggio ad Amalfi?",
      "acceptedAnswer": { "@type": "Answer", "text": "I parcheggi Luna Rossa e Berma costano circa €5 all'ora di giorno e €4 all'ora di notte; quelli del porto (Darsena, Flavio Gioia) circa €6 all'ora di giorno. Nel 2026 era previsto un supplemento sulle prime due ore diurne. A luglio e agosto si riempiono entro metà mattina: arriva prima delle 9:00 oppure vieni in bus o in traghetto." }
    },
    {
      "@type": "Question",
      "name": "Dove parcheggiare per visitare la Costiera Amalfitana?",
      "acceptedAnswer": { "@type": "Answer", "text": "Le opzioni più pratiche: 1) Vietri sul Mare o Salerno, che hanno i parcheggi più grandi della costa, poi bus SITA o traghetto Travelmar. 2) Sorrento (garage Achille Lauro, circa €2-3/h) o una stazione della Circumvesuviana come Vico Equense o Sant'Agnello, poi bus o aliscafo. 3) Praiano, con strisce blu comunali e biglietti da 6 e 14 ore, a metà strada tra Positano e Amalfi." }
    },
    {
      "@type": "Question",
      "name": "Si può andare in auto a Positano?",
      "acceptedAnswer": { "@type": "Answer", "text": "Sì, la SS163 attraversa la parte alta di Positano, ma in molti giorni tra Pasqua e ottobre vale la regola delle targhe alterne dalle 10:00 alle 18:00. La strada interna a senso unico (Via Pasitea, Piazza dei Mulini, Via Cristoforo Colombo) è una ZTL con varchi elettronici, aperta solo ai veicoli autorizzati. Se prenoti un garage in centro o un hotel con parcheggio, chiedi di registrare la tua targa prima dell'arrivo." }
    },
    {
      "@type": "Question",
      "name": "Dove parcheggiare a Sorrento?",
      "acceptedAnswer": { "@type": "Answer", "text": "Le opzioni principali sono il garage Achille Lauro in Via Correale (circa €2-3/h, €24-30 al giorno, gratis sotto i 30 minuti), Fuorimura Parking e Sorrento Parking (da circa €27 al giorno) e il garage Marina Piccola al porto (circa €26 per 6 ore, €32 per 24 ore), comodo per una gita a Capri. Le strisce blu costano €1 per 30 minuti o €2 all'ora. Il centro è ZTL la sera e la domenica." }
    },
    {
      "@type": "Question",
      "name": "Cosa significano le strisce blu, bianche e gialle?",
      "acceptedAnswer": { "@type": "Answer", "text": "Le strisce blu indicano la sosta a pagamento: paghi al parcometro o con un'app ed esponi il tagliando. Le strisce bianche sono gratuite, salvo limiti indicati dal cartello (disco orario, residenti, pulizia strade). Le strisce gialle sono riservate: residenti con permesso, titolari di contrassegno disabili, carico e scarico, taxi o bus. Sostare sulle gialle o superare il tempo pagato sulle blu comporta multe da circa €42, e nelle zone con rimozione forzata l'auto può essere portata via." }
    }
  ]
};

const amalfiCoast = [
  { town: "Positano", where: "Garage privati sulla strada interna (Mandara, De Gennaro); strisce blu comunali; posti gratuiti in alto a Montepertuso e Nocelle", cost: "Garage circa €8-12/h, €50-90 al giorno in estate. Strisce blu circa €3/h", notes: "I garage del centro si riempiono entro metà mattina a luglio e agosto: prenota. La strada interna è una ZTL con telecamere, quindi chiedi al garage o all'hotel di registrare la targa." },
  { town: "Praiano", where: "Strisce blu comunali lungo la SS163 e le strade del paese; parcheggio privato a Marina di Praia", cost: "€3/h, €15 per 6 ore, €30 per 14 ore (2026)", notes: "A pagamento 08:00-22:00 da aprile a ottobre, 08:00-20:00 da novembre a marzo, festivi compresi. Poche strisce bianche, molte riservate ai residenti." },
  { town: "Amalfi", where: "Luna Rossa (scavato nella roccia tra Amalfi e Atrani, circa 170 posti, galleria pedonale per il centro); Berma; parcheggi del porto Darsena e Flavio Gioia", cost: "Luna Rossa e Berma circa €5/h di giorno, €4/h di notte. Porto circa €6/h di giorno. 2026: supplemento sulle prime due ore diurne", notes: "Luna Rossa: vietato alle auto a GPL e metano, altezza massima 2 m; tieni contanti per la cassa all'uscita. In estate di solito pieno entro le 10:00. Il centro storico è ZTL." },
  { town: "Atrani", where: "Pochi posti a strisce blu vicino alla spiaggia; Luna Rossa, la cui galleria porta anche ad Atrani", cost: "Strisce blu circa €2,50-3/h", notes: "Una guida del 2026 segnala un limite di 4 ore per i non residenti e il divieto di sosta notturna (20:00-08:00) in estate. Meglio il Luna Rossa." },
  { town: "Ravello", where: "Garage sotto Piazza Duomo (circa 140 posti); parcheggio dell'Auditorium Oscar Niemeyer; strisce blu in Via Boccaccio e Via della Repubblica", cost: "Piazza Duomo: circa €5/h di giorno secondo le guide 2026 (listini precedenti: €2,50/h, €15 al giorno). Auditorium: circa €4/h di giorno, €2,50/h di notte, €40 per 24 ore", notes: "Il centro è ZTL. I posti su strada vicino al centro possono arrivare a €5/h. Il garage di Piazza Duomo può chiudere per eventi e matrimoni." },
  { town: "Minori", where: "Strisce blu sul lungomare; piccolo parcheggio a pagamento in fondo a Via Roma (circa 20 posti)", cost: "Circa €3/h", notes: "Le nuove tariffe 2026 sono state approvate a febbraio 2026: fai fede al parcometro. Pochissimi posti in estate." },
  { town: "Maiori", where: "Strisce blu lungo il lungomare; parcheggio del porto", cost: "Strisce blu circa €3/h in estate, feriali e festivi. Porto circa €5/h", notes: "Strisce bianche gratuite in Via Chiunzi (strada per Tramonti), lontano dalla spiaggia. Il lungomare lungo rende Maiori uno dei paesi più semplici." },
  { town: "Cetara", where: "Parcheggio al porto (strisce blu); parcheggio Pastena nella parte alta del paese (Via Cannillo)", cost: "Porto circa €3/h da marzo a ottobre, €1,50/h da novembre a febbraio (una fonte indica €4/h). Pastena circa €3/h", notes: "Parcheggio del porto aperto circa 07:00-02:00. Quando è pieno la strada di discesa può essere chiusa e si viene mandati su al Pastena." },
  { town: "Vietri sul Mare", where: "Piazza Matteotti; parcheggio della stazione (circa 150 posti); Piazza Mercato; strisce blu alla Marina di Vietri", cost: "Piazza Matteotti €3 la prima ora, poi €1,50 ogni 30 min. Stazione e Piazza Mercato circa €2/h o €20 al giorno. Marina giugno-agosto €2,50/h feriali, €3/h nel fine settimana", notes: "La maggiore offerta di parcheggi della costa. Vicino alla stazione c'è un ascensore pubblico gratuito. Piazza Matteotti è gratuita nelle ore notturne (verifica la fascia esatta al parcometro)." },
  { town: "Furore", where: "Parcheggio a Marina di Praia; strisce blu nella parte alta del paese", cost: "Circa €2,50/h a Marina di Praia", notes: "Nessun parcheggio al Fiordo: sono circa 2 km a piedi lungo la SS163. Non fermarti sul ponte." },
  { town: "Conca dei Marini", where: "Pochi posti comunali a strisce blu", cost: "Una guida del 2026 indica €20 al giorno; nessuna tariffa oraria affidabile trovata", notes: "Pochissimi posti. Il bus SITA è il modo più semplice per arrivare." },
];

const sorrentoPeninsula = [
  { town: "Sorrento", where: "Achille Lauro (Via Correale, sotto Piazza Lauro); Fuorimura Parking; Sorrento Parking (Via San Renato); Parcheggio Stinga (Via degli Aranci); garage Marina Piccola al porto", cost: "Achille Lauro circa €2-3/h, €24-30 al giorno, gratis sotto i 30 min. Fuorimura circa €2,50/h, da €27 al giorno. Sorrento Parking €3/h, da €27 al giorno. Marina Piccola circa €26 per 6 ore, €32 per 24 ore. Strisce blu €1 per 30 min, €2/h", notes: "Strisce bianche gratuite in Via Rota e Via Parsano, raramente libere. Marina Piccola è comodo per una gita a Capri. Il centro è ZTL la sera e la domenica." },
  { town: "Sant'Agnello", where: "Strisce blu in Via Cocumella e Viale dei Pini; parcheggio della stazione Circumvesuviana (Piazzale Don Minzoni)", cost: "Tariffe per zona; non abbiamo trovato cifre attuali affidabili", notes: "A una fermata di treno o 15-20 minuti a piedi dal centro di Sorrento: una base più tranquilla del centro." },
  { town: "Piano di Sorrento", where: "Strisce blu gestite da SIS; Piazza della Repubblica; parcheggio della stazione Circumvesuviana (Via Stazione)", cost: "Corso Italia e Piazza Cota €1,50/h. Gran parte delle strade €1/h, strade periferiche €0,50/h. Piazza della Repubblica: primi 30 min gratis, poi €1", notes: "A pagamento dal lunedì al sabato 08:30-13:30 e 15:30-21:30 (giugno-settembre), 08:30-13:30 e 15:00-20:00 (ottobre-maggio). La pausa di mezzogiorno è gratuita." },
  { town: "Meta", where: "Parcheggio della spiaggia Marina di Meta con ascensore; strisce blu in paese (zone A, B, C)", cost: "Marina di Meta giugno-settembre €3/h o €15 al giorno (08:00-24:00); marzo-maggio e ottobre €1,50/h o €6 al giorno; novembre-febbraio €1/h. Strisce blu in paese circa €1/h", notes: "L'ascensore per la spiaggia costa €1. Meta applica in centro una propria regola delle targhe alterne, invertita: vedi la nostra guida." },
  { town: "Vico Equense", where: "Parcheggi stagionali a Marina d'Aequa e Marina di Vico; strisce blu in centro", cost: "Marine: €8 per le prime 6 ore, poi €2/h (€10 per auto con più di 5 posti); fascia serale €5 dalle 19:00 (tariffe 2025)", notes: "L'alta stagione va dal 1° giugno al 10 settembre. Vico ha una stazione della Circumvesuviana, buon punto di interscambio prima di Sorrento." },
  { town: "Massa Lubrense (Marina del Cantone, Nerano)", where: "Strisce blu comunali; due piccoli parcheggi a Marina del Cantone; parcheggi privati, tra cui Il Venione con navetta", cost: "Strisce blu €2/h da metà aprile a metà ottobre (delibera 2023), circa €3/h secondo fonti più recenti. Parcheggi di Marina del Cantone €3/h. Privati circa €10-25 al giorno, posti riservati a Nerano fino a €50 al giorno", notes: "Ad agosto e nei fine settimana i parcheggi si riempiono entro le 9:00. Nel 2025 il Comune ha aperto aree di sosta temporanee (Ord. 79/2025) per la carenza di posti." },
  { town: "Sant'Agata sui Due Golfi", where: "Nessun parcheggio pubblico con nome trovato", cost: "Nessuna tariffa pubblicata affidabile", notes: "Chiedi alla tua struttura dove parcheggiare. Ci sono bus locali da Sorrento." },
];

const ztlData = [
  { location: "Positano", period: "Tutto l'anno, varchi con telecamere", note: "Strada interna a senso unico (Via Pasitea, Piazza dei Mulini, Via Cristoforo Colombo) solo per veicoli autorizzati. I clienti di hotel e garage devono far registrare la targa." },
  { location: "Amalfi", period: "Tutto l'anno (centro storico)", note: "Parcheggia al Luna Rossa, alla Berma o al porto ed entra a piedi. Gli hotel possono registrare gli ospiti per lo scarico bagagli." },
  { location: "Ravello", period: "Centro storico", note: "Usa il garage di Piazza Duomo o il parcheggio dell'Auditorium, appena fuori dalle strade a traffico limitato." },
  { location: "Sorrento", period: "La sera dalle 19:30 e la domenica (centro)", note: "I garage indicati sopra restano raggiungibili. Controlla i cartelli ai varchi." },
  { location: "SS163 Amalfitana", period: "Da Pasqua a ottobre, 10:00-18:00", note: "Targhe alterne nei giorni stabiliti (targhe dispari nei giorni dispari). Moto e scooter esenti." },
  { location: "Meta e SS145", period: "Dalla primavera a ottobre, giorni stabiliti", note: "Targhe alterne con ordinanze comunali, invertite a Meta. Controlla il calendario prima di partire." },
];
---

<BaseLayout
  title="Parcheggi Costiera Amalfitana 2026: Prezzi, Strisce Bianche"
  description="Parcheggi in Costiera Amalfitana e Penisola Sorrentina paese per paese: garage, tariffe orarie e giornaliere, strisce blu, dove trovare le strisce bianche gratuite, ZTL e multe."
  lang={lang}
  breadcrumbs={breadcrumbs}
  schema={[faqSchema]}
 pageKey="parcheggi-ztl"
  heroImage="/images/parcheggi-hero.webp"
>

  <section class="relative h-[75vh] sm:h-[90vh] flex items-center bg-charcoal overflow-hidden">
    <img src="/images/parcheggi-hero.webp" alt="Sorrento, Penisola Sorrentina" class="absolute inset-0 w-full h-full object-cover" loading="eager" fetchpriority="high" decoding="sync" referrerpolicy="no-referrer"/>

    <div class="absolute inset-0 bg-gradient-to-b from-black/25 via-black/40 to-black/75"></div>
    <div class="relative z-10 max-w-7xl mx-auto px-6 py-20">
      <div class="max-w-3xl">
        <p class="text-med-gold text-xs sm:text-sm font-medium uppercase tracking-[0.3em] mb-3">Guida Pratica</p>
        <h1 class="font-serif text-display text-white mb-4">Parcheggi in Costiera Amalfitana: prezzi paese per paese e strisce bianche</h1>
        <p class="text-xl text-white/80 leading-relaxed">
          I parcheggi sono pochi e quasi ovunque a pagamento. Qui trovi i parcheggi paese per paese, quanto costano, dove esistono ancora le strisce bianche gratuite e come funzionano le ZTL.
        </p>
      </div>
    </div>
    <Breadcrumbs breadcrumbs={breadcrumbs} />
  </section>

  <div class="max-w-editorial mx-auto px-4 sm:px-6 lg:px-8 pt-0 pb-4 space-y-12">

    <section class="max-w-editorial">
      <div style="background-color: #E2725B; border-color: #E2725B; padding: 6px 12px 6px 12px;" class="border rounded-[2rem] mb-6 mt-8">
        <p class="font-semibold mb-0 mt-0 text-white text-sm leading-tight" style="margin-top: -2px;">⚠️ Attenzione alle ZTL</p>
        <p class="text-xs text-white/95 leading-tight">Le ZTL (Zone a Traffico Limitato) della Costiera Amalfitana sono controllate da telecamere. Entrare senza autorizzazione costa da €87 (importi 2026), e la multa arriva all'autonoleggio o a casa mesi dopo, spesso con una spesa amministrativa in più.</p>
      </div>
      <p class="text-xl leading-relaxed text-charcoal text-justify">
        Per capire <strong>Amalfi dove parcheggiare</strong> e come muoversi in Costiera con l'auto, la strategia migliore è il "parcheggio strategico": lasci l'auto dove i posti si trovano più facilmente (Vietri, Salerno, Sorrento, una stazione della Circumvesuviana o Praiano) e prosegui in bus, traghetto o aliscafo. Se invece entri nei paesi in auto, le tabelle qui sotto ti dicono dove andare e quanto aspettarti di pagare.
      </p>
      <p class="text-sm text-slate-500 leading-relaxed mt-4">
        Prezzi indicativi, raccolti a ottobre 2026 da gestori, Comuni e stampa locale con dati 2023-2026. Le tariffe cambiano ogni stagione: fa fede il cartello al parcheggio o al parcometro.
      </p>
    </section>

    <section id="strisce">
      <h2 class="font-serif text-2xl font-semibold text-slate-900 mb-6">Strisce blu, bianche e gialle: cosa significano</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4 sm:gap-6">
        <div class="bg-med-cream rounded-[2rem] p-5 sm:p-6 border border-slate-100">
          <div class="w-12 h-1.5 rounded-full mb-3" style="background-color: #2563eb;"></div>
          <h3 class="font-semibold text-charcoal text-sm mb-2">Strisce blu: a pagamento</h3>
          <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">Paghi al parcometro (monete, spesso carta) o con un'app come EasyPark ed esponi il tagliando. Orari e tariffe sono sul cartello; fuori da quegli orari di solito la sosta è libera.</p>
        </div>
        <div class="bg-med-cream rounded-[2rem] p-5 sm:p-6 border border-slate-100">
          <div class="w-12 h-1.5 rounded-full mb-3 bg-white border border-slate-300"></div>
          <h3 class="font-semibold text-charcoal text-sm mb-2">Strisce bianche: gratuite</h3>
          <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">Gratuite, salvo limiti indicati dal cartello: disco orario, solo residenti, pulizia strade o orari di rimozione. Leggi il cartello prima di allontanarti.</p>
        </div>
        <div class="bg-med-cream rounded-[2rem] p-5 sm:p-6 border border-slate-100">
          <div class="w-12 h-1.5 rounded-full mb-3" style="background-color: #eab308;"></div>
          <h3 class="font-semibold text-charcoal text-sm mb-2">Strisce gialle: riservate</h3>
          <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">Residenti con permesso, titolari di contrassegno disabili, carico e scarico, taxi e bus. Mai sostare qui senza il permesso giusto, nemmeno per cinque minuti.</p>
        </div>
      </div>
    </section>

    <section id="strisce-bianche">
      <h2 class="font-serif text-2xl font-semibold text-slate-900 mb-6">Strisce bianche (parcheggio gratuito): come stanno le cose</h2>
      <p class="text-lg leading-relaxed text-charcoal mb-6">
        In Costiera Amalfitana parcheggiare gratis è raro. Nei centri quasi ogni posto è blu o giallo, e le poche strisce bianche spesso sono riservate ai residenti da un piccolo cartello. I posti gratuiti che esistono sono ai margini, in alto o lungo la statale, e a luglio e agosto di solito spariscono entro le 9:00. A maggio, inizio giugno e ottobre, in un giorno feriale di mattina, le possibilità sono concrete.
      </p>
      <h3 class="font-semibold text-charcoal mb-3">Dove si trovano le strisce bianche</h3>
      <ul class="space-y-3 mb-6">
        <li class="flex items-start gap-3"><span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span><span class="text-slate-700"><strong>Positano.</strong> Montepertuso e Nocelle, sulle colline sopra il paese. Da lì scendi con il bus locale Flavio Gioia o a piedi (circa 35 minuti).</span></li>
        <li class="flex items-start gap-3"><span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span><span class="text-slate-700"><strong>Amalfi.</strong> Tratti a bordo strada sulla SS163 circa 1,5 km prima del centro arrivando da Positano, e sulla strada per Agerola (SS366) circa 1 km sopra il paese. Il ritorno a piedi segue la strada, con marciapiede scarso o assente.</span></li>
        <li class="flex items-start gap-3"><span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span><span class="text-slate-700"><strong>Maiori.</strong> Via Chiunzi, la strada verso Tramonti, lontano dal lungomare.</span></li>
        <li class="flex items-start gap-3"><span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span><span class="text-slate-700"><strong>Praiano.</strong> Posti sparsi lungo la strada. Molti sono per i residenti: il cartello indica dove inizia il tratto riservato.</span></li>
        <li class="flex items-start gap-3"><span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span><span class="text-slate-700"><strong>Sorrento.</strong> Via Rota (lontana dal centro) e Via Parsano (vicino a Corso Italia). In stagione raramente libere.</span></li>
      </ul>
      <h3 class="font-semibold text-charcoal mb-3">Regole, multe e rimozione</h3>
      <ul class="space-y-3">
        <li class="flex items-start gap-3"><span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span><span class="text-slate-700"><strong>Disco orario.</strong> Dove il cartello mostra il disco e un limite di tempo, imposta il disco orario sull'ora di arrivo, arrotondata alla mezz'ora successiva, e lascialo sul cruscotto. Le auto a noleggio non sempre lo hanno: costa pochi euro in edicola o dal benzinaio.</span></li>
        <li class="flex items-start gap-3"><span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span><span class="text-slate-700"><strong>Multe.</strong> Sosta sulle strisce gialle, tempo scaduto sulle blu o disco non esposto partono da circa €42. Posti disabili e ingressi in ZTL costano molto di più.</span></li>
        <li class="flex items-start gap-3"><span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span><span class="text-slate-700"><strong>Rimozione.</strong> Dove il cartello indica "zona rimozione" l'auto può essere portata via, e paghi multa, carro attrezzi e deposito. In estate la polizia locale è molto presente, soprattutto sulla SS163, dove un'auto in sosta irregolare blocca i bus.</span></li>
        <li class="flex items-start gap-3"><span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span><span class="text-slate-700"><strong>Mai a bordo carreggiata.</strong> Un'auto lasciata a metà sulla SS163 fuori dagli stalli viene multata in fretta e può essere rimossa. Se non ci sono strisce, non c'è un posto.</span></li>
      </ul>
    </section>

    <section id="costiera-amalfitana">
      <h2 class="font-serif text-2xl font-semibold text-slate-900 mb-6">Costiera Amalfitana: parcheggi e prezzi paese per paese</h2>
      <div class="overflow-x-auto rounded-2xl border border-slate-200">
        <table class="w-full min-w-[760px] text-xs sm:text-sm">
          <thead>
            <tr class="bg-slate-900 text-white">
              <th class="text-left px-3 py-3 font-semibold">Paese</th>
