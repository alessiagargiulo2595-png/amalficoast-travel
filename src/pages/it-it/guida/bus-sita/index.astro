---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../../components/Breadcrumbs.astro';

const lang = 'it-it';

const breadcrumbs = [
  { name: 'Home', url: '/it-it/' },
  { name: 'Pianificazione', url: '/it-it/pianificazione/' },
  { name: 'Home', url: '/it-it/guida/bus-sita/' },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Come funziona il bus SITA sulla Costiera Amalfitana?",
      "acceptedAnswer": { "@type": "Answer", "text": "Il bus SITA (oggi SITA Sud, gestito da EAV) percorre la SS163 tra Sorrento e Salerno, passando per Positano, Praiano, Amalfi, Maiori e Minori. I biglietti si acquistano in tabaccheria o edicola prima di salire: non si comprano sul bus. Costo: circa €2,50-4 a tratta; le tariffe sono state adeguate dal 1° ottobre 2026, verifica il prezzo aggiornato al momento dell'acquisto." }
    },
    {
      "@type": "Question",
      "name": "Quanto tempo impiega il bus da Sorrento ad Amalfi?",
      "acceptedAnswer": { "@type": "Answer", "text": "L'orario ufficiale in vigore dal 14 settembre 2026 prevede da 75 a 100 minuti, a seconda del percorso. In estate (luglio-agosto) il traffico sulla SS163 può portarlo a 2-2,5 ore. Da Amalfi a Positano servono 40 minuti fino alla fermata Sponda e 50 fino a Chiesa Nuova; Amalfi-Ravello ~25 min (bus diverso, SITA per Ravello)." }
    },
    {
      "@type": "Question",
      "name": "Posso portare bagagli grandi sul bus SITA?",
      "acceptedAnswer": { "@type": "Answer", "text": "I bus SITA sulla SS163 sono piccoli (devono fare le curve della Costiera). In estate sono stracolmi. Valigie grandi sono difficili da gestire: usa un trolley compatto o uno zaino. I trolley vanno nel vano anteriore se disponibile." }
    },
    {
      "@type": "Question",
      "name": "Quali sono le fermate del bus SITA sulla Costiera Amalfitana?",
      "acceptedAnswer": { "@type": "Answer", "text": "Le fermate principali della linea SITA sulla SS163 sono: Sorrento (Circumvesuviana), Meta, Positano (Chiesa Nuova e Sponda), Praiano, Furore, Amalfi, Atrani, Minori, Maiori, Cetara e Vietri sul Mare. Il bus per Ravello parte separatamente da Amalfi (linea 5020)." }
    },
    {
      "@type": "Question",
      "name": "Dove comprare i biglietti del bus SITA per la Costiera Amalfitana?",
      "acceptedAnswer": { "@type": "Answer", "text": "I biglietti si acquistano in tabaccheria, edicola o bar che espone il simbolo SITA/EAV. Non si comprano a bordo. A Sorrento si trovano presso la stazione Circumvesuviana. Il biglietto giornaliero Costiera (~€7,50) conviene se fai più tratte." }
    },
    {
      "@type": "Question",
      "name": "A che ora partono il primo e l'ultimo bus SITA tra Sorrento e Amalfi?",
      "acceptedAnswer": { "@type": "Answer", "text": "Con l'orario in vigore dal 14 settembre 2026 il primo bus da Sorrento per Amalfi parte alle 06:30 dal lunedì al sabato (alle 08:30 la domenica e nei festivi) e l'ultimo alle 19:50 (alle 19:15 la domenica e nei festivi). Da Amalfi per Sorrento il primo parte alle 06:20 tutti i giorni e l'ultimo alle 21:30 (alle 21:00 la domenica e nei festivi). Prima di partire verifica su sitasudtrasporti.it, soprattutto nei giorni festivi." }
    }
  ]
};

