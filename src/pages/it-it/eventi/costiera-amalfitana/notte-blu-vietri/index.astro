---
import BaseLayout from '../../../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../../../components/Breadcrumbs.astro';
import LocalitySlider from '../../../../../components/LocalitySlider.astro';

const lang = 'it-it';

const breadcrumbs = [
  { name: 'Home', url: '/it-it/' },
  { name: 'Costiera Amalfitana', url: '/it-it/costiera-amalfitana/' },
  { name: 'Notte Blu Vietri sul Mare', url: '/it-it/eventi/costiera-amalfitana/notte-blu-vietri/' },
];

const eventSchema = {
  "@context": "https://schema.org",
  "@type": "EventSeries",
  "name": "Notte Blu Vietri sul Mare",
  "description": "La Notte Blu a Vietri sul Mare nel luglio 2026. Botteghe di ceramica aperte fino a tarda notte tra concerti e installazioni artistiche.",
  "image": "https://amalficoast-travel.com/images/costiera-hero.jpg",
  "url": "https://amalficoast-travel.com/it-it/eventi/costiera-amalfitana/notte-blu-vietri/",
  "location": {
      "@type": "Place",
      "name": "Centro storico, Vietri sul Mare",
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Vietri sul Mare",
        "addressRegion": "SA",
        "addressCountry": "IT"
      }
    },
  "eventStatus": "https://schema.org/EventScheduled",
  "eventAttendanceMode": "https://schema.org/OfflineEventAttendanceMode",
  "startDate": "2026-07-01",
  "endDate": "2026-07-01",
  "subEvent": [
    {
      "@type": "Event",
      "name": "Notte Blu Vietri sul Mare 2026",
      "startDate": "2026-07-01",
      "eventStatus": "https://schema.org/EventScheduled",
      "eventAttendanceMode": "https://schema.org/OfflineEventAttendanceMode",
      "location": {
          "@type": "Place",
          "name": "Centro storico, Vietri sul Mare",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Vietri sul Mare",
            "addressRegion": "SA",
            "addressCountry": "IT"
          }
        },
      "url": "https://amalficoast-travel.com/it-it/eventi/costiera-amalfitana/notte-blu-vietri/",
      "image": "https://amalficoast-travel.com/images/costiera-hero.jpg",
      "description": "La Notte Blu a Vietri sul Mare nel luglio 2026. Botteghe di ceramica aperte fino a tarda notte tra concerti e installazioni artistiche."
    }
  ]
};

const facts = [
  { dt: 'Periodo', dd: 'Luglio 2026' },
  { dt: 'Location', dd: 'Centro storico Vietri sul Mare' },
  { dt: 'Tipologia', dd: 'Arte e Musica' },
  { dt: 'Accesso', dd: 'Libero e gratuito' },
  { dt: 'Specialita', dd: 'Ceramica Vietresi' },
];
---

<BaseLayout
  title="Notte Blu Vietri sul Mare 2026: Ceramica e Musica"
  description="La Notte Blu a Vietri sul Mare nel luglio 2026. Botteghe di ceramica aperte fino a tarda notte tra concerti e installazioni artistiche."
  lang={lang}
  breadcrumbs={breadcrumbs}
  schema={[eventSchema]}
 pageKey="notte-blu-vietri"
  heroImage="/images/costiera-hero.jpg"
>

  <!-- Hero -->
  <section class="relative h-[65vh] sm:h-[70vh] overflow-hidden flex items-center justify-center">
    <img
      src="/images/costiera-hero.jpg"
      alt="Notte Blu, Vietri sul Mare"
      class="absolute inset-0 w-full h-full object-cover"
      loading="eager" fetchpriority="high" decoding="sync" referrerpolicy="no-referrer"
    />
    <div class="absolute inset-0 bg-gradient-to-b from-black/20 via-black/50 to-black/70"></div>
    <div class="relative z-10 text-center px-6 max-w-5xl text-white">
      <div class="flex flex-wrap justify-center items-center gap-4 mb-6">
        <span class="bg-med-gold text-white px-4 py-1 rounded-full text-[10px] font-bold uppercase tracking-widest">Evento 2026</span>
        <span class="text-white/70 text-xs sm:text-sm">Luglio 2026</span>
        <span class="text-white/70 text-xs sm:text-sm">Vietri sul Mare, SA</span>
      </div>
      <h1 class="font-serif text-5xl md:text-7xl font-bold text-white leading-tight mb-6">Notte Blu</h1>
      <p class="text-white/85 text-lg md:text-xl font-light max-w-2xl mx-auto leading-relaxed">
        Arte, ceramica e musica fino a tarda notte nel cuore di Vietri.
      </p>
    </div>
    <Breadcrumbs breadcrumbs={breadcrumbs} isEvent={true} />
  </section>

  <!-- Content 70/30 -->
  <section class="py-12 sm:py-24 px-6 max-w-7xl mx-auto">
    <div class="grid grid-cols-1 lg:grid-cols-10 gap-16">

      <!-- Main Content (70%) -->
      <div class="lg:col-span-7 space-y-12">
        <div>
          <h2 class="font-serif text-4xl font-bold text-slate-900 mb-8">Informazioni sull'Evento</h2>
          <div class="space-y-4 text-slate-600 text-lg leading-relaxed">
            <p>Serata dedicata alla ceramica e alla musica. Le botteghe restano aperte fino a tarda notte tra concerti e installazioni artistiche. Vietri sul Mare, celebre per la sua tradizione ceramica secolare, apre i propri atelier al pubblico per una serata unica.</p>
            <p>La Notte Blu e l'occasione per scoprire il processo di lavorazione della ceramica vietrese direttamente dai maestri artigiani, in un'atmosfera festosa che si estende per tutto il centro storico.</p>
          </div>
        </div>

        <!-- Percorso -->
        <div>
          <h3 class="font-serif text-2xl font-bold text-slate-900 mb-6">Il Percorso della Notte</h3>
          <div class="grid sm:grid-cols-2 gap-6">
            <div class="bg-white p-8 rounded-[2rem] border border-slate-100 shadow-sm">
              <span class="text-med-gold text-[10px] font-bold uppercase tracking-widest mb-2 block">Atelier aperti</span>
              <h4 class="text-xl font-serif font-bold text-slate-900 mb-3">La ceramica vietrese in notturna</h4>
              <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Decine di botteghe aprono le porte e mostrano dal vivo la lavorazione al tornio e la pittura delle ceramiche con i motivi tradizionali a foglie di limone e pesci.</p>
            </div>
            <div class="bg-white p-8 rounded-[2rem] border border-slate-100 shadow-sm">
              <span class="text-med-gold text-[10px] font-bold uppercase tracking-widest mb-2 block">Musica e installazioni</span>
              <h4 class="text-xl font-serif font-bold text-slate-900 mb-3">L'arte contemporanea incontra la tradizione</h4>
              <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Installazioni luminose e concerti dal vivo animano i vicoli e le piazze del centro storico, creando un dialogo tra artigianato tradizionale e arte contemporanea.</p>
            </div>
          </div>
        </div>

        <!-- Logistica -->
        <div>
          <h3 class="font-serif text-2xl font-bold text-slate-900 mb-6">Come arrivare</h3>
          <div class="bg-white rounded-[2rem] border border-slate-100 overflow-hidden shadow-sm">
            <table class="w-full text-xs sm:text-xs sm:text-sm">
              <thead>
                <tr class="bg-slate-900 text-white">
                  <th class="text-left px-6 py-4 font-semibold">Mezzo</th>
                  <th class="text-left px-6 py-4 font-semibold">Servizio</th>
                  <th class="text-left px-6 py-4 font-semibold">Note</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-slate-100">
                <tr class="hover:bg-slate-50 transition-colors">
                  <td class="px-6 py-4 font-medium">Treno</td>
                  <td class="px-6 py-4 text-slate-600">Trenitalia da Salerno</td>
                  <td class="px-6 py-4 text-slate-500 text-xs">5 minuti da Salerno Centrale</td>
                </tr>
                <tr class="hover:bg-slate-50 transition-colors">
                  <td class="px-6 py-4 font-medium">Bus SITA</td>
                  <td class="px-6 py-4 text-slate-600">Da Amalfi</td>
                  <td class="px-6 py-4 text-slate-500 text-xs">Verificare orari notturni</td>
                </tr>
                <tr class="hover:bg-slate-50 transition-colors">
                  <td class="px-6 py-4 font-medium">Auto</td>
                  <td class="px-6 py-4 text-slate-600">Uscita A3 Vietri</td>
                  <td class="px-6 py-4 text-slate-500 text-xs">Parcheggi gratuiti in periferia</td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>
      </div>

      <!-- Sidebar (30%) -->
      <aside class="lg:col-span-3">
        <div class="bg-slate-900 text-white p-10 rounded-[3rem] sticky top-32 shadow-2xl">
          <p class="text-[10px] uppercase tracking-[0.3em] text-med-gold font-medium mb-6">Dettagli Evento</p>
          <dl class="space-y-4">
            {facts.map(({ dt, dd }, i) => (
              <>
                <div>
                  <dt class="text-white/40 text-[10px] uppercase tracking-widest font-bold mb-1">{dt}</dt>
                  <dd class="text-white font-medium">{dd}</dd>
                </div>
                {i < facts.length - 1 && <div class="border-t border-white/5"></div>}
              </>
            ))}
          </dl>
          <div class="mt-10 pt-8 border-t border-white/5">
            <p class="text-white/50 text-xs leading-relaxed">Si consiglia di arrivare con largo anticipo. Verificare il programma aggiornato sui canali ufficiali.</p>
          </div>
        </div>
      </aside>

    </div>
  </section>

  <LocalitySlider
    heading="Località Vicine a Vietri"
    lang={lang}
    items={[
      { name: "Vietri sul Mare", href: '/it-it/costiera-amalfitana/vietri-sul-mare/', image: '/images/vietri-hero.jpg', tag: "Sede evento" },
      { name: "Cetara", href: '/it-it/costiera-amalfitana/cetara/', image: '/images/cetara-hero.jpg', tag: "Gastronomia" },
      { name: "Maiori", href: '/it-it/costiera-amalfitana/maiori/', image: '/images/maiori-hero.jpg', tag: "Costiera" },
      { name: "Salerno", href: '/it-it/costiera-amalfitana/salerno/', image: '/images/salerno-hero.webp', tag: "Storica" },
    ]}
  />

    <!-- BANNER: Itinerary Planner -->
  <section class="py-10 md:py-14 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6">
      <div class="relative overflow-hidden rounded-[2.5rem] bg-gradient-to-br from-slate-900 via-slate-950 to-blue-950 px-6 sm:px-10 md:px-14 py-10 md:py-14 shadow-[0_20px_60px_rgba(0,0,0,0.35)]">
        <div class="absolute -top-20 -left-20 w-72 h-72 bg-blue-500/15 rounded-full blur-3xl pointer-events-none"></div>
        <div class="absolute -bottom-20 -right-20 w-72 h-72 bg-amber-500/10 rounded-full blur-3xl pointer-events-none"></div>
        <div class="relative z-10 grid md:grid-cols-[3fr_2fr] md:items-center gap-8">
          <div>
            <span class="inline-block px-4 py-1.5 rounded-full text-xs font-semibold tracking-wide uppercase bg-med-gold/15 text-med-gold border border-med-gold/25 mb-6">Novità: Viaggio su Misura</span>
            <h2 class="text-3xl md:text-4xl font-bold text-white leading-tight mb-2">Disegna il tuo</h2>
            <p class="font-serif text-3xl md:text-4xl italic text-med-blue mb-5">itinerario ideale</p>
            <p class="text-white/60 text-base md:text-lg leading-relaxed max-w-xl mb-8">
              Rispondi a poche semplici domande - punto di partenza, giorni e interessi - e ricevi un itinerario personalizzato con trasporti, costi e orari.
            </p>
            <div class="flex flex-wrap gap-6">
              <div class="flex items-center gap-2.5">
                <div class="w-9 h-9 rounded-xl bg-white/5 border border-white/10 flex items-center justify-center">
                  <svg class="w-4 h-4 text-med-gold" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                </div>
                <span class="text-white/50 text-sm">30 secondi per configurare</span>
              </div>
              <div class="flex items-center gap-2.5">
                <div class="w-9 h-9 rounded-xl bg-white/5 border border-white/10 flex items-center justify-center">
                  <svg class="w-4 h-4 text-med-gold" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 6.75V15m6-6v8.25m.503 3.498l4.875-2.437c.381-.19.622-.58.622-1.006V4.82c0-.836-.88-1.38-1.628-1.006l-3.869 1.934c-.317.159-.69.159-1.006 0L9.503 3.252a1.125 1.125 0 00-1.006 0L3.622 5.689C3.24 5.88 3 6.27 3 6.695V19.18c0 .836.88 1.38 1.628 1.006l3.869-1.934c.317-.159.69-.159 1.006 0l4.994 2.497c.317.158.69.158 1.006 0z"/></svg>
                </div>
                <span class="text-white/50 text-sm">Consigli anti-folla inclusi</span>
              </div>
            </div>
          </div>
          <div class="mt-8 md:mt-0 md:flex md:justify-center">
            <a href="/it-it/configuratore-itinerario/" class="inline-flex items-center gap-2.5 px-7 py-3.5 bg-gradient-to-r from-med-gold to-yellow-600 text-slate-900 font-bold rounded-xl hover:shadow-[0_0_30px_rgba(212,175,55,0.4)] hover:scale-105 transition-all duration-300">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 2L2 12l4 0 0 6 4 0 0-4 4 0 0 4 4 0 0-6 4 0L12 2z"/></svg>
              Configura Ora
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Eventi Correlati -->
  <section class="py-4 sm:py-12 px-6 max-w-7xl mx-auto">
    <h2 class="font-serif text-3xl sm:text-4xl font-bold text-slate-900 mb-12">Eventi Correlati</h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
      <a href="/it-it/eventi/costiera-amalfitana/festa-sant-andrea-amalfi/" class="block bg-white rounded-[2rem] border border-slate-100 overflow-hidden shadow-sm hover:shadow-md transition-shadow">
        <img src="/images/amalfi-hero.jpg" alt="Festa di Sant'Andrea" class="h-40 w-full object-cover" />
        <div class="p-6">
          <span class="text-med-gold text-[10px] font-bold uppercase tracking-widest mb-2 block">Giugno 2026</span>
          <h3 class="font-serif text-lg font-bold text-slate-900 mb-2">Festa di Sant'Andrea</h3>
          <p class="text-slate-600 text-sm mb-4">Gara di portatori e fuochi d'artificio al porto.</p>
          <p class="text-slate-500 text-xs font-medium">📍 Amalfi, SA</p>
        </div>
      </a>
      <a href="/it-it/eventi/costiera-amalfitana/sagra-del-pesce-positano/" class="block bg-white rounded-[2rem] border border-slate-100 overflow-hidden shadow-sm hover:shadow-md transition-shadow">
        <img src="/images/positano-hero.jpg" alt="Sagra del Pesce" class="h-40 w-full object-cover" />
        <div class="p-6">
          <span class="text-med-gold text-[10px] font-bold uppercase tracking-widest mb-2 block">Ottobre 2026</span>
          <h3 class="font-serif text-lg font-bold text-slate-900 mb-2">Sagra del Pesce</h3>
          <p class="text-slate-600 text-sm mb-4">Celebrazione dei frutti di mare con cucina tradizionale.</p>
          <p class="text-slate-500 text-xs font-medium">📍 Positano, SA</p>
        </div>
      </a>
      <a href="/it-it/eventi/costiera-amalfitana/ravello-festival/" class="block bg-white rounded-[2rem] border border-slate-100 overflow-hidden shadow-sm hover:shadow-md transition-shadow">
        <img src="/images/ravello-hero.jpg" alt="Festival Ravello" class="h-40 w-full object-cover" />
        <div class="p-6">
          <span class="text-med-gold text-[10px] font-bold uppercase tracking-widest mb-2 block">Luglio - Settembre 2026</span>
          <h3 class="font-serif text-lg font-bold text-slate-900 mb-2">Festival Ravello</h3>
          <p class="text-slate-600 text-sm mb-4">Musica classica e contemporanea a Villa Rufolo.</p>
          <p class="text-slate-500 text-xs font-medium">📍 Ravello, SA</p>
        </div>
      </a>
    </div>
  </section>

  <!-- Destinazione CTA -->
  <section class="bg-med-blue text-white py-12 sm:py-16 px-6">
    <div class="max-w-7xl mx-auto">
      <div class="flex flex-col sm:flex-row items-center justify-between gap-8">
        <div>
          <h3 class="font-serif text-2xl sm:text-3xl font-bold mb-3">Scopri Vietri sul Mare</h3>
          <p class="text-white/70 text-sm sm:text-base max-w-md">Famosa per le ceramiche colorate e il fascino costiero.</p>
        </div>
        <a href="/it-it/costiera-amalfitana/vietri-sul-mare/" class="bg-med-gold text-white px-8 py-3 rounded-full font-medium hover:bg-yellow-500 transition-colors whitespace-nowrap">
          View Destination →
        </a>
      </div>
    </div>
  </section>


