---
import BaseLayout from '../../../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../../../components/Breadcrumbs.astro';
import LocalitySlider from '../../../../../components/LocalitySlider.astro';

const lang = 'it-it';

const breadcrumbs = [
  { name: 'Home', url: '/it-it/' },
  { name: 'Isole', url: '/it-it/isole/' },
  { name: 'Sagra del Mare Procida', url: '/it-it/eventi/isole/sagra-del-mare-graziella-procida/' },
];

const eventSchema = {
  "@context": "https://schema.org",
  "@type": "EventSeries",
  "name": "Sagra del Mare Procida",
  "description": "La Sagra del Mare a Procida nel luglio 2026. La rievocazione della Graziella unisce storia letteraria e tradizioni marinare dell",
  "image": "https://amalficoast-travel.com/images/procida-hero.jpg",
  "url": "https://amalficoast-travel.com/it-it/eventi/isole/sagra-del-mare-graziella-procida/",
  "location": {
      "@type": "Place",
      "name": "Procida",
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Procida",
        "addressRegion": "NA",
        "addressCountry": "IT"
      }
    },
  "eventStatus": "https://schema.org/EventScheduled",
  "eventAttendanceMode": "https://schema.org/OfflineEventAttendanceMode",
  "subEvent": [
    {
      "@type": "Event",
      "name": "Sagra del Mare Procida 2026",
      "startDate": "2026-07-01",
      "eventStatus": "https://schema.org/EventScheduled",
      "eventAttendanceMode": "https://schema.org/OfflineEventAttendanceMode",
      "location": {
          "@type": "Place",
          "name": "Procida",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Procida",
            "addressRegion": "NA",
            "addressCountry": "IT"
          }
        },
      "url": "https://amalficoast-travel.com/it-it/eventi/isole/sagra-del-mare-graziella-procida/",
      "image": "https://amalficoast-travel.com/images/procida-hero.jpg",
      "description": "La Sagra del Mare a Procida nel luglio 2026. La rievocazione della Graziella unisce storia letteraria e tradizioni marinare dell"
    }
  ]
};

const facts = [
  { dt: 'Periodo', dd: 'Luglio 2026' },
  { dt: 'Focus', dd: 'Costume tradizionale e identita marinara' },
  { dt: 'Tipologia', dd: 'Sagra e rievocazione storica' },
  { dt: 'Da Napoli', dd: 'Traghetto 35 min' },
  { dt: 'Accesso', dd: 'Libero' },
];
---

<BaseLayout
  title="Sagra del Mare Procida 2026: La Tradizione della Graziella"
  description="La Sagra del Mare a Procida nel luglio 2026. La rievocazione della Graziella unisce storia letteraria e tradizioni marinare dell'isola."
  lang={lang}
  breadcrumbs={breadcrumbs}
  schema={[eventSchema]}
 pageKey="sagra-del-mare-graziella-procida"
  heroImage="/images/procida-hero.jpg"
>

  <!-- Hero -->
  <section class="relative h-[65vh] sm:h-[70vh] overflow-hidden flex items-center justify-center">
    <img
      src="/images/procida-hero.jpg"
      alt="Sagra del Mare, Procida"
      class="absolute inset-0 w-full h-full object-cover"
      loading="eager" fetchpriority="high" decoding="sync" referrerpolicy="no-referrer"
    />
    <div class="absolute inset-0 bg-gradient-to-b from-black/20 via-black/50 to-black/70"></div>
    <div class="relative z-10 text-center px-6 max-w-5xl text-white">
      <div class="flex flex-wrap justify-center items-center gap-4 mb-6">
        <span class="bg-med-gold text-white px-4 py-1 rounded-full text-[10px] font-bold uppercase tracking-widest">Evento 2026</span>
        <span class="text-white/70 text-xs sm:text-sm">Luglio 2026</span>
        <span class="text-white/70 text-xs sm:text-sm">Procida, NA</span>
      </div>
      <h1 class="font-serif text-5xl md:text-7xl font-bold text-white leading-tight mb-6">Sagra del Mare</h1>
      <p class="text-white/85 text-lg md:text-xl font-light max-w-2xl mx-auto leading-relaxed">
        La Graziella, l'identita marinara e l'anima autentica di Procida.
      </p>
    </div>
    <Breadcrumbs breadcrumbs={breadcrumbs} isEvent={true} />
  </section>

  <!-- Content 70/30 -->
  <section class="py-12 sm:py-24 px-6 max-w-7xl mx-auto">
    <div class="grid grid-cols-1 lg:grid-cols-10 gap-16">

      <!-- Main Content (70%) -->
      <div class="lg:col-span-7 space-y-12">
        <div>
          <h2 class="font-serif text-4xl font-bold text-slate-900 mb-8">Informazioni sull'Evento</h2>
          <div class="space-y-4 text-slate-600 text-lg leading-relaxed">
            <p>La Sagra del Mare e l'evento identitario di Procida. La rievocazione della figura della Graziella unisce storia letteraria e tradizioni marinare dell'isola. Un appuntamento imperdibile per chi vuole conoscere la Procida autentica, lontana dai riflettori della Capitale della Cultura.</p>
            <p>La Graziella, resa immortale dal romanzo ottocentesco di Alphonse de Lamartine, e diventata il simbolo dell'isola: una pescatrice procidana che incarna la bellezza, la semplicita e l'autenticita della comunita marinara. La sagra celebra questa figura con rievocazioni storiche, costumi tradizionali e il pescato del giorno.</p>
          </div>
        </div>

        <!-- La Rievocazione -->
        <div>
          <h3 class="font-serif text-2xl font-bold text-slate-900 mb-6">La Rievocazione della Graziella</h3>
          <div class="grid sm:grid-cols-2 gap-6">
            <div class="bg-white p-8 rounded-[2rem] border border-slate-100 shadow-sm">
              <span class="text-med-gold text-[10px] font-bold uppercase tracking-widest mb-2 block">La figura letteraria</span>
              <h4 class="text-xl font-serif font-bold text-slate-900 mb-3">Lamartine e Procida</h4>
              <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Nel 1820 Alphonse de Lamartine soggiorno a Procida e si innamoro di una giovane pescatrice locale. La storia d'amore, immortalata nel romanzo Graziella del 1852, ha trasformato l'isola in un luogo romantico per eccellenza.</p>
            </div>
            <div class="bg-white p-8 rounded-[2rem] border border-slate-100 shadow-sm">
              <span class="text-med-gold text-[10px] font-bold uppercase tracking-widest mb-2 block">Tradizioni marinare</span>
              <h4 class="text-xl font-serif font-bold text-slate-900 mb-3">Il mare come identita</h4>
              <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">La sagra celebra le tradizioni dei pescatori di Procida con dimostrazioni di tecniche di pesca tradizionale, degustazioni del pescato fresco e la mostra dei costumi storici delle pescatrici dell'isola.</p>
            </div>
          </div>
        </div>

        <!-- Logistica -->
        <div>
          <h3 class="font-serif text-2xl font-bold text-slate-900 mb-6">Come arrivare a Procida</h3>
          <div class="bg-white rounded-[2rem] border border-slate-100 overflow-hidden shadow-sm">
            <table class="w-full text-xs sm:text-xs sm:text-sm">
              <thead>
                <tr class="bg-slate-900 text-white">
                  <th class="text-left px-6 py-4 font-semibold">Mezzo</th>
                  <th class="text-left px-6 py-4 font-semibold">Servizio</th>
                  <th class="text-left px-6 py-4 font-semibold">Note</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-slate-100">
                <tr class="hover:bg-slate-50 transition-colors">
                  <td class="px-6 py-4 font-medium">Traghetto</td>
                  <td class="px-6 py-4 text-slate-600">Da Napoli Molo Beverello</td>
                  <td class="px-6 py-4 text-slate-500 text-xs">35 minuti, piu economico</td>
                </tr>
                <tr class="hover:bg-slate-50 transition-colors">
                  <td class="px-6 py-4 font-medium">Aliscafo</td>
                  <td class="px-6 py-4 text-slate-600">Da Napoli o Pozzuoli</td>
                  <td class="px-6 py-4 text-slate-500 text-xs">Piu rapido, verificare orari estivi</td>
                </tr>
                <tr class="hover:bg-slate-50 transition-colors">
                  <td class="px-6 py-4 font-medium">Da Pozzuoli</td>
                  <td class="px-6 py-4 text-slate-600">Traghetto Caremar</td>
                  <td class="px-6 py-4 text-slate-500 text-xs">25 minuti, alternativa comoda da Napoli ovest</td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>
      </div>

      <!-- Sidebar (30%) -->
      <aside class="lg:col-span-3">
        <div class="bg-slate-900 text-white p-10 rounded-[3rem] sticky top-32 shadow-2xl">
          <p class="text-[10px] uppercase tracking-[0.3em] text-med-gold font-medium mb-6">Dettagli Evento</p>
          <dl class="space-y-4">
            {facts.map(({ dt, dd }, i) => (
              <>
                <div>
                  <dt class="text-white/40 text-[10px] uppercase tracking-widest font-bold mb-1">{dt}</dt>
                  <dd class="text-white font-medium">{dd}</dd>
                </div>
                {i < facts.length - 1 && <div class="border-t border-white/5"></div>}
              </>
            ))}
          </dl>
          <div class="mt-10 pt-8 border-t border-white/5">
            <p class="text-white/50 text-xs leading-relaxed">Si consiglia di arrivare con largo anticipo. Verificare il programma aggiornato sui canali ufficiali.</p>
          </div>
        </div>
      </aside>

    </div>
  </section>

  <LocalitySlider
    heading="Scopri Procida e le Isole"
    lang={lang}
    items={[
      { name: "Procida", href: '/it-it/isole/procida/', image: '/images/procida-hero.jpg', tag: "Sede evento" },
      { name: "Ischia", href: '/it-it/isole/ischia/', image: '/images/ischia-hero.jpg', tag: "Vicina" },
      { name: "Capri", href: '/it-it/isole/capri/', image: '/images/capri-hero.jpg', tag: "Iconica" },
      { name: "Anacapri", href: '/it-it/isole/anacapri/', image: '/images/anacapri-hero.jpg', tag: "Borgo" },
    ]}
  />

  <!-- Eventi Correlati -->
  <section class="py-4 sm:py-12 px-6 max-w-7xl mx-auto">
    <h2 class="font-serif text-3xl sm:text-4xl font-bold text-slate-900 mb-12">Eventi Correlati</h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
      <a href="/it-it/eventi/isole/anacapri-settembre-borgo/" class="block bg-white rounded-[2rem] border border-slate-100 overflow-hidden shadow-sm hover:shadow-md transition-shadow">
        <img src="/images/anacapri-hero.jpg" alt="Anacapri Settembre Borgo" class="h-40 w-full object-cover" />
        <div class="p-6">
          <span class="text-med-gold text-[10px] font-bold uppercase tracking-widest mb-2 block">Settembre 2026</span>
          <h3 class="font-serif text-lg font-bold text-slate-900 mb-2">Anacapri Settembre Borgo</h3>
          <p class="text-slate-600 text-sm mb-4">Paese in festa con artigianato, musica e gastronomia locale.</p>
          <p class="text-slate-500 text-xs font-medium">📍 Capri, NA</p>
        </div>
      </a>
      <a href="/it-it/eventi/isole/ischia-global-film-festival/" class="block bg-white rounded-[2rem] border border-slate-100 overflow-hidden shadow-sm hover:shadow-md transition-shadow">
        <img src="/images/ischia-hero.jpg" alt="Ischia Global Film Festival" class="h-40 w-full object-cover" />
        <div class="p-6">
          <span class="text-med-gold text-[10px] font-bold uppercase tracking-widest mb-2 block">Giugno 2026</span>
          <h3 class="font-serif text-lg font-bold text-slate-900 mb-2">Ischia Global Film Festival</h3>
          <p class="text-slate-600 text-sm mb-4">Festival internazionale del cinema nella natura selvaggia di Ischia.</p>
          <p class="text-slate-500 text-xs font-medium">📍 Ischia, NA</p>
        </div>
      </a>
      <a href="/it-it/eventi/costiera-amalfitana/ravello-festival/" class="block bg-white rounded-[2rem] border border-slate-100 overflow-hidden shadow-sm hover:shadow-md transition-shadow">
        <img src="/images/ravello-hero.jpg" alt="Festival Ravello" class="h-40 w-full object-cover" />
        <div class="p-6">
          <span class="text-med-gold text-[10px] font-bold uppercase tracking-widest mb-2 block">Luglio - Settembre 2026</span>
          <h3 class="font-serif text-lg font-bold text-slate-900 mb-2">Festival Ravello</h3>
          <p class="text-slate-600 text-sm mb-4">Musica classica e contemporanea a Villa Rufolo.</p>
          <p class="text-slate-500 text-xs font-medium">📍 Ravello, SA</p>
        </div>
      </a>
    </div>
  </section>

  <!-- Destinazione CTA -->
  <section class="bg-med-blue text-white py-12 sm:py-16 px-6">
    <div class="max-w-7xl mx-auto">
      <div class="flex flex-col sm:flex-row items-center justify-between gap-8">
        <div>
          <h3 class="font-serif text-2xl sm:text-3xl font-bold mb-3">Scopri Procida</h3>
          <p class="text-white/70 text-sm sm:text-base max-w-md">Isola affascinante con case colorate e spiagge tranquille.</p>
        </div>
        <a href="/it-it/isole/procida/" class="bg-med-gold text-white px-8 py-3 rounded-full font-medium hover:bg-yellow-500 transition-colors whitespace-nowrap">
          View Destination →
        </a>
      </div>
    </div>
  </section>


