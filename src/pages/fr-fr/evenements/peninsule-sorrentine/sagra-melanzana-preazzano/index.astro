---
import BaseLayout from '../../../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../../../components/Breadcrumbs.astro';
import LocalitySlider from '../../../../../components/LocalitySlider.astro';

const lang = 'fr-fr';

const breadcrumbs = [
  { name: 'Accueil', url: '/fr-fr/' },
  { name: 'Événements', url: '/fr-fr/evenements/' },
  { name: "Fête de l'Aubergine – Preazzano", url: '/fr-fr/evenements/peninsule-sorrentine/sagra-melanzana-preazzano/' },
];

const eventSchema = {
  "@context": "https://schema.org",
  "@type": "EventSeries",
  "name": "Fête de l'Aubergine Preazzano",
  "description": "La Fête de l",
  "image": "https://amalficoast-travel.com/images/vico-equense-hero.jpg",
  "url": "https://amalficoast-travel.com/fr-fr/evenements/peninsule-sorrentine/sagra-melanzana-preazzano/",
  "location": {
      "@type": "Place",
      "name": "Preazzano, Vico Equense",
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Vico Equense",
        "addressRegion": "NA",
        "addressCountry": "IT"
      }
    },
  "eventStatus": "https://schema.org/EventScheduled",
  "eventAttendanceMode": "https://schema.org/OfflineEventAttendanceMode",
  "startDate": "2026-08-09",
  "endDate": "2026-08-10",
  "subEvent": [
    {
      "@type": "Event",
      "name": "Fête de l'Aubergine Preazzano 2026",
      "startDate": "2026-08-09",
      "endDate": "2026-08-10",
      "eventStatus": "https://schema.org/EventScheduled",
      "eventAttendanceMode": "https://schema.org/OfflineEventAttendanceMode",
      "location": {
          "@type": "Place",
          "name": "Preazzano, Vico Equense",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Vico Equense",
            "addressRegion": "NA",
            "addressCountry": "IT"
          }
        },
      "url": "https://amalficoast-travel.com/fr-fr/evenements/peninsule-sorrentine/sagra-melanzana-preazzano/",
      "image": "https://amalficoast-travel.com/images/vico-equense-hero.jpg",
      "description": "La Fête de l"
    }
  ]
};

const facts = [
  { dt: 'Dates', dd: '9–10 août 2026' },
  { dt: 'Spécialité', dd: 'Aubergine au chocolat' },
  { dt: 'Navette', dd: 'Depuis la gare de Vico Equense' },
  { dt: 'Entrée', dd: 'Gratuite' },
  { dt: 'Ambiance', dd: 'Village médiéval' },
];
---

<BaseLayout
  title="Fête de l'Aubergine Preazzano 2026 – La Variation au Chocolat"
  description="La Fête de l'Aubergine à Preazzano les 9 et 10 août 2026. L'une des fêtes les plus anciennes de la région : l'aubergine locale en dizaines de variations, dont la célèbre version au chocolat."
  lang={lang}
  breadcrumbs={breadcrumbs}
  schema={[eventSchema]}
 pageKey="sagra-melanzana-preazzano"
  heroImage="/images/vico-equense-hero.jpg"
>

  <!-- Hero -->
  <section class="relative h-[65vh] sm:h-[70vh] overflow-hidden flex items-center justify-center">
    <img
      src="/images/vico-equense-hero.jpg"
      alt="Fête de l'Aubergine, Preazzano, Vico Equense"
      class="absolute inset-0 w-full h-full object-cover"
      loading="eager" fetchpriority="high" decoding="sync" referrerpolicy="no-referrer"
    />
    <div class="absolute inset-0 bg-gradient-to-b from-black/20 via-black/50 to-black/70"></div>
    <div class="relative z-10 text-center px-6 max-w-5xl text-white">
      <div class="flex flex-wrap justify-center items-center gap-4 mb-6">
        <span class="bg-med-gold text-white px-4 py-1 rounded-full text-[10px] font-bold uppercase tracking-widest">Événement 2026</span>
        <span class="text-white/70 text-xs sm:text-sm">9–10 août 2026</span>
        <span class="text-white/70 text-xs sm:text-sm">Preazzano, NA</span>
      </div>
      <h1 class="font-serif text-5xl md:text-7xl font-bold text-white leading-tight mb-6">Fête de l'Aubergine</h1>
      <p class="text-white/85 text-lg md:text-xl font-light max-w-2xl mx-auto leading-relaxed">
        Le hameau médiéval et l'incontournable spécialité d'aubergine au chocolat.
      </p>
    </div>
    <Breadcrumbs breadcrumbs={breadcrumbs} isEvent={true} />
  </section>

  <!-- Content 70/30 -->
  <section class="py-12 sm:py-24 px-6 max-w-7xl mx-auto">
    <div class="grid grid-cols-1 lg:grid-cols-10 gap-16">

      <!-- Main Content (70%) -->
      <div class="lg:col-span-7 space-y-12">
        <div>
          <h2 class="font-serif text-4xl font-bold text-slate-900 mb-8">À propos de l'Événement</h2>
          <div class="space-y-4 text-slate-600 text-lg leading-relaxed">
            <p>L'une des fêtes les plus anciennes de la région. Le village médiéval de Preazzano accueille des étals gastronomiques où l'aubergine occupe le centre de la scène, y compris la douce variation au chocolat. Une navette part de la gare de Vico Equense.</p>
            <p>Preazzano, un petit village médiéval au cœur de la Péninsule Sorrentine, se transforme pendant deux jours en un laboratoire gastronomique à ciel ouvert. L'aubergine locale est servie en dizaines de variations : frite, farcie, alla parmigiana et la surprenante version sucrée au chocolat.</p>
          </div>
        </div>

        <!-- Les spécialités -->
        <div>
          <h3 class="font-serif text-2xl font-bold text-slate-900 mb-6">Les Spécialités de la Fête</h3>
          <div class="grid sm:grid-cols-2 gap-6">
            <div class="bg-white p-8 rounded-[2rem] border border-slate-100 shadow-sm">
              <span class="text-med-gold text-[10px] font-bold uppercase tracking-widest mb-2 block">Variations salées</span>
              <h4 class="text-xl font-serif font-bold text-slate-900 mb-3">L'aubergine traditionnelle</h4>
              <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Frite, farcie, alla parmigiana, en pâtes et en ragù campanien : l'aubergine est la protagoniste d'une dizaine de recettes traditionnelles de la cuisine sorrentine.</p>
            </div>
            <div class="bg-white p-8 rounded-[2rem] border border-slate-100 shadow-sm">
              <span class="text-med-gold text-[10px] font-bold uppercase tracking-widest mb-2 block">Version sucrée au chocolat</span>
              <h4 class="text-xl font-serif font-bold text-slate-900 mb-3">La surprise inattendue</h4>
              <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">L'aubergine au chocolat est la spécialité surprenante qui attire des visiteurs de toute la Campanie : tranches d'aubergine frite enrobées de chocolat noir - une combinaison inattendue qui fonctionne parfaitement.</p>
            </div>
          </div>
        </div>

        <!-- Comment y aller -->
        <div>
          <h3 class="font-serif text-2xl font-bold text-slate-900 mb-6">Comment y aller</h3>
          <div class="bg-white rounded-[2rem] border border-slate-100 overflow-hidden shadow-sm">
            <table class="w-full text-xs sm:text-xs sm:text-sm">
              <thead>
                <tr class="bg-slate-900 text-white">
                  <th class="text-left px-6 py-4 font-semibold">Transport</th>
                  <th class="text-left px-6 py-4 font-semibold">Service</th>
                  <th class="text-left px-6 py-4 font-semibold">Notes</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-slate-100">
                <tr class="hover:bg-slate-50 transition-colors">
                  <td class="px-6 py-4 font-medium">Navette du festival</td>
                  <td class="px-6 py-4 text-slate-600">Depuis la gare de Vico Equense</td>
                  <td class="px-6 py-4 text-slate-500 text-xs">Disponible pendant les jours de la fête</td>
                </tr>
                <tr class="hover:bg-slate-50 transition-colors">
                  <td class="px-6 py-4 font-medium">Circumvesuviana</td>
                  <td class="px-6 py-4 text-slate-600">Depuis Naples ou Sorrento</td>
                  <td class="px-6 py-4 text-slate-500 text-xs">Descendre à Vico Equense, puis navette</td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>
      </div>

      <!-- Sidebar (30%) -->
      <aside class="lg:col-span-3">
        <div class="bg-slate-900 text-white p-10 rounded-[3rem] sticky top-32 shadow-2xl">
          <p class="text-[10px] uppercase tracking-[0.3em] text-med-gold font-medium mb-6">Détails de l'Événement</p>
          <dl class="space-y-4">
            {facts.map(({ dt, dd }, i) => (
              <>
                <div>
                  <dt class="text-white/40 text-[10px] uppercase tracking-widest font-bold mb-1">{dt}</dt>
                  <dd class="text-white font-medium">{dd}</dd>
                </div>
                {i < facts.length - 1 && <div class="border-t border-white/5"></div>}
              </>
            ))}
          </dl>
          <div class="mt-10 pt-8 border-t border-white/5">
            <p class="text-white/50 text-xs leading-relaxed">Nous recommandons d'arriver à l'avance. Consultez le programme mis à jour sur les canaux officiels.</p>
          </div>
        </div>
      </aside>

    </div>
  </section>

  <LocalitySlider
    heading="Découvrez la Péninsule Sorrentine"
    lang={lang}
    items={[
      { name: "Vico Equense", href: '/fr-fr/peninsule-sorrentine/vico-equense/', image: '/images/vico-equense-hero.jpg', tag: "Lieu de l'événement" },
      { name: "Sorrente", href: '/fr-fr/peninsule-sorrentine/sorrente/', image: '/images/sorrento-hero.jpg', tag: "Iconique" },
      { name: "Meta", href: '/fr-fr/peninsule-sorrentine/meta/', image: '/images/meta-hero.webp', tag: "Proche" },
      { name: "Massa Lubrense", href: '/fr-fr/peninsule-sorrentine/massa-lubrense/', image: '/images/massa-lubrense-hero.jpg', tag: "Nature" },
    ]}
  />

    <!-- BANNER: Itinerary Planner -->
  <section class="py-10 md:py-14 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6">
      <div class="relative overflow-hidden rounded-[2.5rem] bg-gradient-to-br from-slate-900 via-slate-950 to-blue-950 px-6 sm:px-10 md:px-14 py-10 md:py-14 shadow-[0_20px_60px_rgba(0,0,0,0.35)]">
        <div class="absolute -top-20 -left-20 w-72 h-72 bg-blue-500/15 rounded-full blur-3xl pointer-events-none"></div>
        <div class="absolute -bottom-20 -right-20 w-72 h-72 bg-amber-500/10 rounded-full blur-3xl pointer-events-none"></div>
        <div class="relative z-10 grid md:grid-cols-[3fr_2fr] md:items-center gap-8">
          <div>
            <span class="inline-block px-4 py-1.5 rounded-full text-xs font-semibold tracking-wide uppercase bg-med-gold/15 text-med-gold border border-med-gold/25 mb-6">Nouveau : Voyage sur Mesure</span>
            <h2 class="text-3xl md:text-4xl font-bold text-white leading-tight mb-2">Concevez votre</h2>
            <p class="font-serif text-3xl md:text-4xl italic text-med-blue mb-5">itinéraire idéal</p>
            <p class="text-white/60 text-base md:text-lg leading-relaxed max-w-xl mb-8">
              Répondez à quelques questions simples - point de départ, jours et intérêts - et recevez un itinéraire personnalisé avec transports, coûts et horaires.
            </p>
            <div class="flex flex-wrap gap-6">
              <div class="flex items-center gap-2.5">
                <div class="w-9 h-9 rounded-xl bg-white/5 border border-white/10 flex items-center justify-center">
                  <svg class="w-4 h-4 text-med-gold" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                </div>
                <span class="text-white/50 text-sm">30 secondes pour configurer</span>
              </div>
              <div class="flex items-center gap-2.5">
                <div class="w-9 h-9 rounded-xl bg-white/5 border border-white/10 flex items-center justify-center">
                  <svg class="w-4 h-4 text-med-gold" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 6.75V15m6-6v8.25m.503 3.498l4.875-2.437c.381-.19.622-.58.622-1.006V4.82c0-.836-.88-1.38-1.628-1.006l-3.869 1.934c-.317.159-.69.159-1.006 0L9.503 3.252a1.125 1.125 0 00-1.006 0L3.622 5.689C3.24 5.88 3 6.27 3 6.695V19.18c0 .836.88 1.38 1.628 1.006l3.869-1.934c.317-.159.69-.159 1.006 0l4.994 2.497c.317.158.69.158 1.006 0z"/></svg>
                </div>
                <span class="text-white/50 text-sm">Conseils anti-foule inclus</span>
              </div>
            </div>
          </div>
          <div class="mt-8 md:mt-0 md:flex md:justify-center">
            <a href="/fr-fr/planificateur-itineraire/" class="inline-flex items-center gap-2.5 px-7 py-3.5 bg-gradient-to-r from-med-gold to-yellow-600 text-slate-900 font-bold rounded-xl hover:shadow-[0_0_30px_rgba(212,175,55,0.4)] hover:scale-105 transition-all duration-300">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 2L2 12l4 0 0 6 4 0 0-4 4 0 0 4 4 0 0-6 4 0L12 2z"/></svg>
              Configurer maintenant
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Événements Connexes -->
  <section class="py-4 sm:py-12 px-6 max-w-7xl mx-auto">
    <h2 class="font-serif text-3xl sm:text-4xl font-bold text-slate-900 mb-12">Événements Connexes</h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
      <a href="/fr-fr/evenements/peninsule-sorrentine/festa-sant-antonino/" class="block bg-white rounded-[2rem] border border-slate-100 overflow-hidden shadow-sm hover:shadow-md transition-shadow">
        <img src="/images/sorrento-hero.jpg" alt="Festa Sant'Antonino" class="h-40 w-full object-cover" />
        <div class="p-6">
          <span class="text-med-gold text-[10px] font-bold uppercase tracking-widest mb-2 block">Février 2026</span>
          <h3 class="font-serif text-lg font-bold text-slate-900 mb-2">Festa Sant'Antonino</h3>
          <p class="text-slate-600 text-sm mb-4">Célébration du saint patron avec processions.</p>
          <p class="text-slate-500 text-xs font-medium">📍 Sorrente, NA</p>
        </div>
      </a>
      <a href="/fr-fr/evenements/peninsule-sorrentine/gustamincanto-vico-equense/" class="block bg-white rounded-[2rem] border border-slate-100 overflow-hidden shadow-sm hover:shadow-md transition-shadow">
        <img src="/images/vico-equense-hero.jpg" alt="Gustamincanto" class="h-40 w-full object-cover" />
        <div class="p-6">
          <span class="text-med-gold text-[10px] font-bold uppercase tracking-widest mb-2 block">Septembre 2026</span>
          <h3 class="font-serif text-lg font-bold text-slate-900 mb-2">Gustamincanto</h3>
          <p class="text-slate-600 text-sm mb-4">Fête de la gastronomie locale et des traditions culinaires.</p>
          <p class="text-slate-500 text-xs font-medium">📍 Vico Equense, NA</p>
        </div>
      </a>
      <a href="/fr-fr/evenements/cote-amalfitaine/ravello-festival/" class="block bg-white rounded-[2rem] border border-slate-100 overflow-hidden shadow-sm hover:shadow-md transition-shadow">
        <img src="/images/ravello-hero.jpg" alt="Festival Ravello" class="h-40 w-full object-cover" />
        <div class="p-6">
          <span class="text-med-gold text-[10px] font-bold uppercase tracking-widest mb-2 block">Juillet - Septembre 2026</span>
          <h3 class="font-serif text-lg font-bold text-slate-900 mb-2">Festival Ravello</h3>
          <p class="text-slate-600 text-sm mb-4">Musique classique et contemporaine à Villa Rufolo.</p>
          <p class="text-slate-500 text-xs font-medium">📍 Ravello, SA</p>
        </div>
      </a>
    </div>
  </section>

  <!-- Destinazione CTA -->
  <section class="bg-med-blue text-white py-12 sm:py-16 px-6">
    <div class="max-w-7xl mx-auto">
      <div class="flex flex-col sm:flex-row items-center justify-between gap-8">
        <div>
          <h3 class="font-serif text-2xl sm:text-3xl font-bold mb-3">Explorez Péninsule Sorrentine</h3>
          <p class="text-white/70 text-sm sm:text-base max-w-md">Ville perchée sur les falaises avec vues, jardins et vins doux.</p>
        </div>
        <a href="/fr-fr/peninsule-sorrentine/sorrente/" class="bg-med-gold text-white px-8 py-3 rounded-full font-medium hover:bg-yellow-500 transition-colors whitespace-nowrap">
          Découvrir la Destination →
        </a>
      </div>
    </div>
  </section>


