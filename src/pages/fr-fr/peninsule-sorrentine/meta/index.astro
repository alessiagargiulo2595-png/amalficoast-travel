---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import CorrelationSlider from '../../../../components/CorrelationSlider.astro';
import Breadcrumbs from '../../../../components/Breadcrumbs.astro';

const lang = 'fr-fr';

const breadcrumbs = [
  { name: 'Accueil', url: '/fr-fr/' },
  { name: 'Peninsule Sorrentine', url: '/fr-fr/peninsule-sorrentine/' },
  { name: 'Meta', url: '/fr-fr/peninsule-sorrentine/meta/' },
];

const touristAttractionSchema = {
  "@context": "https://schema.org",
  "@type": "TouristAttraction",
  "name": "Meta di Sorrento",
  "description": "Meta di Sorrento est un village authentique de la Peninsule Sorrentine, celebre pour la plage d'Alimuri, la Basilique de la Madonna del Lauro, les chantiers navals historiques et une atmosphere locale loin du tourisme de masse.",
  "url": "https://amalficoast-travel.com/fr-fr/peninsule-sorrentine/meta/",
  "touristType": ["Mer", "Culture", "Authenticite", "Familles"],
  "address": { "@type": "PostalAddress", "addressLocality": "Meta", "addressRegion": "Napoli", "addressCountry": "IT", "postalCode": "80062" },
  "geo": { "@type": "GeoCoordinates", "latitude": 40.6412, "longitude": 14.4097 }
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Comment se rendre à Meta di Sorrento ?",
      "acceptedAnswer": { "@type": "Answer", "text": "En train : la Circumvesuviana s'arrête à Meta (arrêt Meta, un avant Sorrento). Depuis Naples environ 65 minutes. En voiture : SS145 Sorrentina. Meta est à seulement 3 km de Sorrento et peut même se rejoindre à pied en 30 minutes le long du Corso Italia." }
    },
    {
      "@type": "Question",
      "name": "Meta a-t-elle des plages ?",
      "acceptedAnswer": { "@type": "Answer", "text": "Oui, la plage d'Alimuri est la plus grande et la plus connue : une bande de sable sombre accessible par ascenseur ou escalier depuis la falaise. Il y a aussi la plage dei Marinai, plus petite et tranquille. Les deux disposent d'équipements de plage." }
    },
    {
      "@type": "Question",
      "name": "Meta est-elle préférable à Sorrento pour dormir ?",
      "acceptedAnswer": { "@type": "Answer", "text": "Pour ceux qui cherchent des prix plus bas et une atmosphère moins touristique, oui. Les hôtels et B&B à Meta coûtent 20 à 30 % moins cher qu'à Sorrento, et la Circumvesuviana vous emmène partout. C'est aussi plus calme le soir." }
    },
    {
      "@type": "Question",
      "name": "Que voir à Meta di Sorrento ?",
      "acceptedAnswer": { "@type": "Answer", "text": "La Basilique de la Madonna del Lauro (avec la statue miraculeuse et les fresques), le centre historique avec ses palais nobles, la plage d'Alimuri, le Musée Naval (chantiers navals historiques). De Meta part aussi le sentier vers Positano à travers les Colli di San Pietro." }
    },
    {
      "@type": "Question",
      "name": "Pourquoi Meta est-elle célèbre pour sa tradition maritime ?",
      "acceptedAnswer": { "@type": "Answer", "text": "Meta était le principal centre de construction navale de la Peninsule Sorrentine. Les chantiers de Meta construisaient des voiliers et des brigantins qui naviguaient en Méditerranée et dans l'Atlantique. La tradition maritime est encore visible dans les palais des capitaines de marine et au Musée Naval." }
    }
  ]
};

const schemas = [touristAttractionSchema, faqSchema];

const fastFacts = [
  { dt: 'Situation', dd: 'Peninsule Sorrentine, NA' },
  { dt: 'Altitude', dd: '~100 m s.n.m.' },
  { dt: 'Population', dd: '~8 000 habitants' },
  { dt: 'Depuis Sorrento', dd: '3 km / 5 min' },
  { dt: 'Depuis Naples', dd: '65 min (Circumvesuviana)' },
  { dt: 'Plage', dd: 'Alimuri (sable sombre)' },
  { dt: 'Spécialités', dd: 'Limoncello, poisson, pâtes' },
  { dt: 'Meilleure période', dd: 'Avr-Oct' },
  { dt: 'Idéal pour', dd: 'Base économique, familles' },
];

const tips = [
  'Meta est une base parfaite et moins chère que Sorrento : même arrêt Circumvesuviana, hôtels 20 à 30 % moins chers.',
  'La plage d\'Alimuri est accessible par ascenseur depuis la falaise : évitez l\'escalier si vous voyagez avec des enfants ou des poussettes.',
  'La glace artisanale de Meta est réputée dans la région : cherchez les gelaterie dans le centre historique le long de la via Municipio.',
  'De Meta part le sentier des Colli di San Pietro vers Positano : une randonnée panoramique alternative à la SS163.',
];
---

<BaseLayout
  title="Meta di Sorrento 2026 : Plage d'Alimuri, Basilique del Lauro et Chantiers Navals"
  description="Guide de Meta di Sorrento : la plage d'Alimuri, la Basilique de la Madonna del Lauro, la tradition maritime. Base économique et authentique pour explorer la Peninsule Sorrentine."
  lang={lang}
  breadcrumbs={breadcrumbs}
  schema={schemas}
  pageKey="meta"
>

  <!-- Hero -->
  <section class="relative h-[75vh] sm:h-[90vh] flex items-center bg-charcoal overflow-hidden">
    <img src="/images/meta-hero.webp" alt="Meta di Sorrento, Peninsule Sorrentine" class="absolute inset-0 w-full h-full object-cover" loading="eager" fetchpriority="high" decoding="sync" referrerpolicy="no-referrer"/>
    <div class="absolute inset-0 bg-gradient-to-b from-black/10 via-black/40 to-black/80 z-10"></div>
    <div class="relative z-20 max-w-editorial mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <p class="text-med-gold text-xs sm:text-sm font-medium uppercase tracking-[0.3em] mb-3">Peninsule Sorrentine - Terre de Marins</p>
        <h1 class="font-serif text-display text-white mb-4">Meta di Sorrento</h1>
        <p class="text-xl text-white/80 leading-relaxed max-w-2xl">
          Village de capitaines de marine et de chantiers navals. La plage d&apos;Alimuri, la Basilique del Lauro et une atmosphère authentique à 3 km de Sorrento.
        </p>
        <div class="flex flex-wrap gap-3 mt-8">
          <a href="#fast-facts" class="px-5 py-2.5 bg-med-gold text-white text-xs sm:text-sm font-semibold rounded-full hover:scale-105 hover:shadow-[0_8px_25px_rgba(212,175,55,0.4)] transition-all duration-300">Fast Facts</a>
          <a href="#come-arrivare" class="px-5 py-2.5 bg-white/10 backdrop-blur text-white text-xs sm:text-sm font-medium rounded-full border border-white/20 hover:bg-white/20 transition-colors">Comment y aller</a>
          <a href="#faq" class="px-5 py-2.5 bg-white/10 backdrop-blur text-white text-xs sm:text-sm font-medium rounded-full border border-white/20 hover:bg-white/20 transition-colors">FAQ</a>
        </div>
      </div>
    </div>
    <Breadcrumbs breadcrumbs={breadcrumbs} />
  </section>

  <section class="max-w-editorial mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="grid lg:grid-cols-[1fr_320px] gap-12">

      <div class="space-y-16">

        <div class="prose-editorial">
          <p class="text-xl leading-relaxed text-charcoal">
            Meta di Sorrento est le village que les touristes traversent en Circumvesuviana sans descendre, un arrêt avant <a href="/fr-fr/peninsule-sorrentine/sorrente/" class="text-med-blue hover:underline">Sorrento</a>. Pourtant Meta a tout ce qu&apos;il faut pour des vacances parfaites : une plage de sable, une basilique spectaculaire, un centre historique calme et des prix plus accessibles que la voisine Sorrento.
          </p>
          <p class="mt-4 text-slate-600 leading-relaxed">
            L&apos;histoire de Meta est écrite sur la mer : pendant des siècles, elle a été le principal centre de construction navale de la Peninsule Sorrentine. Les chantiers de Meta construisaient des voiliers qui naviguaient en Méditerranée et dans l&apos;Atlantique. Aujourd&apos;hui encore, les palais des capitaines de marine dans le centre historique témoignent de la richesse apportée par le commerce maritime.
          </p>
        </div>

        <!-- Le saviez-vous -->
        <div class="bg-slate-900 border border-white/10 rounded-[3rem] p-8">
          <p class="text-[10px] uppercase tracking-[0.3em] text-med-gold font-medium mb-4">Le saviez-vous ?</p>
          <div class="grid sm:grid-cols-3 gap-6">
            <div class="text-center">
              <p class="font-serif text-5xl font-bold text-med-gold">3 km</p>
              <p class="text-white/60 text-xs italic mt-1">de Sorrento, accessible à pied</p>
            </div>
            <div class="text-center">
              <p class="font-serif text-5xl font-bold text-med-gold">XVIII s.</p>
              <p class="text-white/60 text-xs italic mt-1">apogée des chantiers navals de Meta</p>
            </div>
            <div class="text-center">
              <p class="font-serif text-5xl font-bold text-med-gold">-30%</p>
              <p class="text-white/60 text-xs italic mt-1">coût des hôtels par rapport à Sorrento</p>
            </div>
          </div>
        </div>

        <!-- Que voir -->
        <div>
          <h2 class="font-serif text-3xl font-semibold text-slate-900 mb-8">Que voir à Meta</h2>
          <div class="space-y-8">
            {[
              { n: 1, title: 'Basilique de la Madonna del Lauro', text: 'L\'église la plus importante de Meta, dédiée à la Madonna del Lauro vénérée dans toute la Peninsule. Intérieur baroque avec fresques, marbres polychromes et la statue miraculeuse de la Vierge. La façade domine la place principale du village.' },
              { n: 2, title: 'Plage d\'Alimuri', text: 'La plage principale de Meta : une bande de sable sombre volcanique au pied de la falaise, accessible par ascenseur ou escalier. Équipements de plage et zone libre. Eaux claires et vue sur la côte. Moins fréquentée que les plages de Sorrento.' },
              { n: 3, title: 'Centre historique et palais des capitaines', text: 'La via Municipio et les ruelles alentour conservent les palais nobles des capitaines de marine des XVIII-XIX siècles. Portails en piperno, cours intérieures et balcons en fer forgé racontent la richesse de la marine de Meta.' },
              { n: 4, title: 'Musée Naval', text: 'Le petit musée qui raconte la tradition des chantiers navals de Meta : maquettes de voiliers, instruments de navigation, cartes nautiques et photographies d\'époque des chantiers. Entrée gratuite ou sur donation.' },
              { n: 5, title: 'Sentier des Colli di San Pietro', text: 'Une randonnée panoramique qui part de Meta et traverse les collines jusqu\'à Positano. Environ 4 heures de marche entre citronniers, oliveraies et vues sur le Golfe. Alternative spectaculaire à la SS163.' },
            ].map(({ n, title, text }) => (
              <div class="grid sm:grid-cols-[auto_1fr] gap-4">
                <div class="w-14 h-14 rounded-[1rem] bg-med-gold/10 flex items-center justify-center flex-shrink-0 text-med-gold font-serif font-bold text-xl">{n}</div>
                <div>
                  <h3 class="font-semibold text-charcoal text-lg mb-1">{title}</h3>
                  <p class="text-slate-600 leading-relaxed">{text}</p>
                </div>
              </div>
            ))}
          </div>
        </div>

        <!-- Comment y aller -->
        <div id="come-arrivare">
          <h2 class="font-serif text-3xl font-semibold text-slate-900 mb-6">Comment se rendre à Meta</h2>
          <div class="space-y-6">
            <div class="bg-white rounded-[3rem] p-8 border border-slate-100 hover:shadow-xl transition-all duration-300">
              <h3 class="font-semibold text-charcoal mb-3">Circumvesuviana</h3>
              <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">Arrêt "Meta" sur la ligne Naples-Sorrento. Depuis Naples Centrale environ 65 minutes (~3,90 €). Un arrêt avant Sorrento. Fréquence : toutes les 30-40 min.</p>
            </div>
            <div class="bg-white rounded-[3rem] p-8 border border-slate-100 hover:shadow-xl transition-all duration-300">
              <h3 class="font-semibold text-charcoal mb-3">Depuis Sorrento</h3>
              <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">À pied le long du Corso Italia en environ 30 minutes. En Circumvesuviana 3 minutes. En voiture 5 minutes sur la SS145. Meta est pratiquement contiguë à Sorrento.</p>
            </div>
          </div>
        </div>

        <!-- Conseil local -->
        <div class="relative overflow-hidden rounded-[3rem] bg-med-blue p-10 md:p-14 text-white shadow-2xl">
          <div class="relative z-10 flex flex-col md:flex-row items-start md:items-center gap-8">
            <div class="w-20 h-20 rounded-2xl bg-white/10 flex items-center justify-center flex-shrink-0 border border-white/20"><svg class="w-10 h-10 text-med-gold" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 3v2.25m6.364.386-1.591 1.591M21 12h-2.25m-.386 6.364-1.591-1.591M12 18.75V21m-4.773-4.227-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0Z"/></svg></div>
            <div>
              <p class="text-med-gold text-xs font-bold uppercase tracking-[0.3em] mb-2">Conseil local</p>
              <h3 class="font-serif text-2xl font-bold text-white mb-3 tracking-tight">La base secrète pour la Peninsule</h3>
              <p class="text-white/70 leading-relaxed">Dormez à Meta plutôt qu&apos;à Sorrento : même Circumvesuviana, mêmes liaisons pour Capri, la Côte Amalfitaine et Naples, mais hôtels et restaurants coûtent 20 à 30 % moins cher. Le soir, le centre de Meta est calme et authentique.</p>
            </div>
          </div>
          <div class="absolute bottom-0 left-0 translate-y-1/2 -translate-x-1/2 w-80 h-80 bg-med-gold/10 rounded-full blur-3xl pointer-events-none"></div>
        </div>

        <!-- FAQ -->
        <div id="faq">
          <h2 class="font-serif text-3xl font-semibold text-slate-900 mb-8">Questions fréquentes sur Meta</h2>
          <div class="space-y-4">
            {faqSchema.mainEntity.map((q) => (
              <details class="group border border-slate-200 rounded-2xl overflow-hidden">
                <summary class="flex items-center justify-between px-6 py-4 cursor-pointer select-none text-charcoal font-medium hover:bg-slate-50 transition-colors">
                  {q.name}
                  <svg class="w-4 h-4 text-slate-400 group-open:rotate-180 transition-transform flex-shrink-0 ml-3" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
                </summary>
                <div class="px-6 pb-5 text-slate-600 leading-relaxed text-xs sm:text-sm border-t border-slate-100 pt-4">
                  {q.acceptedAnswer.text}
                </div>
              </details>
            ))}
          </div>
        </div>

      </div>

      <aside class="space-y-6 lg:sticky lg:top-24 self-start">
        <div id="fast-facts" class="bg-slate-900 text-white rounded-[3rem] p-6">
          <p class="text-[10px] uppercase tracking-[0.3em] text-med-gold font-medium mb-4">Fast Facts - Meta</p>
          <dl class="space-y-3">
            {fastFacts.map(({ dt, dd }, i) => (
              <>
                <div class="flex justify-between items-start gap-3">
                  <dt class="text-white/40 text-xs sm:text-sm font-light flex-shrink-0">{dt}</dt>
                  <dd class="text-white font-medium text-xs sm:text-sm text-right">{dd}</dd>
                </div>
                {i < fastFacts.length - 1 && <div class="border-t border-white/5"></div>}
              </>
            ))}
          </dl>
        </div>

        <div class="bg-med-cream border border-med-gold/30 rounded-[2rem] p-6">
          <p class="text-[10px] uppercase tracking-[0.3em] text-med-gold font-medium mb-3">Conseils d&apos;experts</p>
          <ul class="space-y-3">
            {tips.map(tip => (
              <li class="flex items-start gap-2 text-xs sm:text-sm text-charcoal">
                <span class="w-1.5 h-1.5 rounded-full bg-med-gold mt-1.5 flex-shrink-0"></span>
                <span>{tip}</span>
              </li>
            ))}
          </ul>
        </div>

        <div class="bg-white border border-slate-100 rounded-[2rem] p-6 shadow-sm">
          <p class="text-[10px] uppercase tracking-[0.3em] text-slate-400 font-medium mb-3">Peninsule Sorrentine</p>
          <nav class="space-y-1">
            {[
              { href: '/fr-fr/peninsule-sorrentine/sorrente/', label: 'Sorrento' },
              { href: '/fr-fr/peninsule-sorrentine/vico-equense/', label: 'Vico Equense' },
              { href: '/fr-fr/peninsule-sorrentine/massa-lubrense/', label: 'Massa Lubrense' },
              { href: '/fr-fr/peninsule-sorrentine/sant-agnello/', label: 'Sant\'Agnello' },
            ].map(({ href, label }) => (
              <a href={href} class="flex items-center gap-2 px-3 py-2 rounded-xl text-xs sm:text-sm text-charcoal hover:bg-med-blue/5 hover:text-med-blue transition-colors">
                <span class="w-1.5 h-1.5 rounded-full bg-med-blue/30"></span> {label}
              </a>
            ))}
          </nav>
        </div>
      </aside>

    </div>
  </section>

  <CorrelationSlider
    heading="Explorez aussi"
    items={[
      { name: 'Sorrento',       href: '/fr-fr/peninsule-sorrentine/sorrente/',       tag: 'Hub & Limoncello', desc: 'La Piazza Tasso, le Cloître et le point de départ pour Capri.' },
      { name: 'Vico Equense',   href: '/fr-fr/peninsule-sorrentine/vico-equense/',   tag: 'Pizza au Mètre',   desc: 'La pizza au mètre de Da Gigino et le Castello Giusso.' },
      { name: 'Massa Lubrense', href: '/fr-fr/peninsule-sorrentine/massa-lubrense/', tag: 'Nature & Cuisine',  desc: 'Punta Campanella et les spaghetti alla Nerano.' },
      { name: 'Positano',       href: '/fr-fr/cote-amalfitaine/positano/',           tag: 'Mode & Vue',       desc: 'Les maisons colorées à pic sur la mer de la Côte Amalfitaine.' },
      { name: 'Capri',          href: '/fr-fr/iles/capri/',                          tag: 'La plus iconique',  desc: 'Grotte Bleue, Faraglioni et la Piazzetta.' },
    ]}
    lang="fr-fr"
  />

</BaseLayout>
