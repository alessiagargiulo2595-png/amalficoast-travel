---
import BlogPostLayout from '../../../../layouts/BlogPostLayout.astro';

const lang = 'fr-fr';
const post = {
  title: 'Fête des morts, Halloween et les confréries encapuchonnées',
  subtitle: "Ce qui se passe vraiment les 1er et 2 novembre en Campanie, pourquoi la douceur de la saison a la forme d'un cercueil, et qui sont les incappucciati de Sorrente",
  category: 'DÉCOUVERTES',
  date: '7 octobre 2026',
  readTime: '10 min',
  image: '/images/misteri-venerdi-santo-hero.webp',
  imageAlt: "Un Mystère de la Passion porté par des confrères encapuchonnés lors d'une procession du vendredi saint",
  path: '/fr-fr/blog/fete-des-morts-halloween/',
};

const metaTitle = 'Fête des morts en Campanie : torrone et processions';
const metaDescription = "Les 1er et 2 novembre, la Campanie garde sa propre fête des morts, avec le torrone dei morti dans toutes les pâtisseries. Où se place Halloween, et qui sont les confréries encapuchonnées de Sorrente.";

const breadcrumbs = [
  { name: 'Accueil', url: '/fr-fr/' },
  { name: 'Blog', url: '/fr-fr/blog/' },
  { name: 'Fête des morts et Halloween', url: '/fr-fr/blog/fete-des-morts-halloween/' },
];

const quickInfo = [
  { label: 'Toussaint', value: '1er novembre, jour férié en Italie' },
  { label: 'Jour des morts', value: '2 novembre, jour ouvré' },
  { label: 'La douceur', value: 'Torrone dei morti, moelleux, au chocolat' },
  { label: 'Nom local', value: "'O muollo, le moelleux" },
  { label: 'En vente', value: 'En pâtisserie dès la mi-octobre' },
  { label: 'Halloween', value: 'Présent, surtout pour les enfants' },
  { label: 'Confréries', value: 'Santa Monica et della Morte, Sorrente' },
  { label: 'Processions', value: 'Vendredi saint, pas en novembre' },
];

const faq = [
  {
    q: "Qu'est-ce que le torrone dei morti ?",
    a: "Une douceur napolitaine moelleuse que l'on mange autour du 2 novembre. À la différence du nougat dur de Noël, il est bâti sur le chocolat : une coque de chocolat noir autour d'une garniture moelleuse de chocolat blanc ou au lait et de noisettes, taillée en bloc. À Naples on l'appelle 'o muollo, le moelleux, ou 'o murticiell.",
  },
  {
    q: 'Pourquoi le mange-t-on le 2 novembre ?',
    a: "À cause d'une vieille croyance selon laquelle les morts reviennent dans la nuit du 1er au 2 novembre goûter ce que leurs familles ont préparé. On laissait des douceurs sur les tombes pour adoucir le passage vers l'autre monde, et le torrone est la forme survivante de cette offrande. L'association est bien plus ancienne que la recette moderne.",
  },
  {
    q: 'Le 1er novembre est-il férié en Italie ?',
    a: "Oui. Ognissanti, la Toussaint, est un jour férié national : banques, bureaux et beaucoup de commerces ferment et les transports suivent l'horaire des jours fériés. Le lendemain, la Commemorazione dei defunti du 2 novembre, n'est pas férié, même si les cimetières sont pleins dès le petit matin.",
  },
  {
    q: 'Fête-t-on Halloween sur la côte amalfitaine ?',
    a: "De plus en plus, oui, surtout comme fête pour enfants avec déguisements et vitrines décorées, et davantage dans les villes que dans les villages. Cela n'a pas remplacé le rite plus ancien. Pour la plupart des familles ici, le 31 octobre est une soirée dehors et le 2 novembre est le jour qui compte.",
  },
  {
    q: 'Qui sont les incappucciati de Sorrente ?',
    a: "Les membres encapuchonnés de deux confréries laïques : la Venerabile Arciconfraternita di Santa Monica, vêtue de blanc, et la Venerabile Arciconfraternita della Morte, vêtue de noir. Cette dernière a été fondée en 1586 et poursuit une confrérie de San Catello plus ancienne, attestée dès 1380. La cagoule cache l'identité de celui qui la porte, pour que le geste reste anonyme.",
  },
  {
    q: 'Quand ont lieu les processions encapuchonnées ?',
    a: "Le vendredi saint, pas en novembre. La Procession blanche de l'Addolorata quitte l'église de la Santissima Annunziata à trois heures du matin et rentre aux premières lueurs. La Procession noire du Christ mort part à vingt heures trente. Les deux dates changent chaque année avec Pâques.",
  },
];

const sidebarLinks = [
  { label: 'Sorrente', href: '/fr-fr/peninsule-sorrentine/sorrente/' },
  { label: 'Procida', href: '/fr-fr/iles/procida/' },
  { label: 'Délice au citron', href: '/fr-fr/blog/delice-citron/' },
  { label: 'Amalfi', href: '/fr-fr/cote-amalfitaine/amalfi/' },
  { label: 'Cuoppo frit', href: '/fr-fr/blog/cuoppo-frit/' },
];

const authorRole = 'Spécialiste Péninsule Sorrentine';

const relatedArticles = [
  {
    title: 'Films tournes a Sorrente : quand le cinema choisit la peninsule',
    category: 'DÉCOUVERTES',
    date: '30 juin 2026',
    image: '/images/film-fatti-a-sorrento-hero.webp',
    imageAlt: 'Films tournés à Sorrente',
    path: '/fr-fr/blog/films-tournes-a-sorrente/'
  },
  {
    title: 'Illuminations de Noël à Sorrente et Salerne',
    category: 'GUIDE',
    date: '21 octobre 2026',
    image: '/images/luci-artista-salerno-hero.webp',
    imageAlt: 'Illuminations à Sorrente et Salerne',
    path: '/fr-fr/blog/illuminations-noel-sorrente-salerne/'
  }
];

const imageCredit = {
  author: 'Rossella Sorvillo / Wikimedia Commons',
  sourceUrl: 'https://commons.wikimedia.org/wiki/File:L%27antico_rito_dei_Misteri_del_Venerd%C3%AC_Santo.jpg',
  license: 'CC BY-SA 4.0',
  licenseUrl: 'https://creativecommons.org/licenses/by-sa/4.0/',
};

const keyTakeaways = [
  "En Campanie, les premiers jours de novembre sont la fête des morts, construite autour de la visite au cimetière du 2 novembre plutôt que des déguisements du 31 octobre.",
  "La douceur de la saison est le torrone dei morti, moelleux et au chocolat, descendant des offrandes que l'on laissait autrefois sur les tombes pour adoucir le passage.",
  "Halloween est arrivé et plaît aux enfants, mais il s'est installé à côté du rite plus ancien au lieu de le remplacer.",
  "Les confréries encapuchonnées de Sorrente existent précisément à cause du culte des morts : elles ont été fondées pour enterrer les pauvres et prier pour les âmes.",
  "Leur grande sortie publique est le vendredi saint, avec la Procession blanche à trois heures du matin et la noire le soir, une tradition que l'on fait remonter au XIVe siècle.",
];
---

<BlogPostLayout
  lang={lang}
  post={post}
  metaTitle={metaTitle}
  metaDescription={metaDescription}
  breadcrumbs={breadcrumbs}
  quickInfo={quickInfo}
  faq={faq}
  sidebarLinks={sidebarLinks}
  authorRole={authorRole}
  relatedArticles={relatedArticles}
  imageCredit={imageCredit}
  pageKey="feast-of-the-dead-halloween"
>

  <!-- Points Clés -->
  <div class="bg-slate-900 text-white p-8 rounded-[2rem]">
    <div class="flex items-center gap-3 mb-6">
      <svg class="w-5 h-5 text-med-gold flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
      <h2 class="font-serif text-lg font-bold text-med-gold uppercase tracking-[0.15em]">Points Clés</h2>
    </div>
    <ul class="space-y-4">
      {keyTakeaways.map((point) => (
        <li class="flex items-start gap-3">
          <span class="w-1.5 h-1.5 rounded-full bg-med-gold flex-shrink-0 mt-2"></span>
          <span class="text-white/80 text-xs sm:text-sm leading-relaxed">{point}</span>
        </li>
      ))}
    </ul>
  </div>

  <!-- Intro -->
  <div>
    <p class="text-slate-600 text-xl leading-relaxed mb-6 font-light">
      Entrez dans une pâtisserie de <a href="/fr-fr/peninsule-sorrentine/sorrente/" class="text-med-blue hover:underline">Sorrente</a> dans la seconde moitié d'octobre et la vitrine se remplit de blocs de chocolat noir de la taille d'une brique. Personne ne les appelle produit saisonnier. C'est le <em>torrone dei morti</em>, et il appartient à un ensemble de croyances sur les premiers jours de novembre qui reste, discrètement, la chose la plus solide du calendrier local. Halloween existe ici aussi désormais. Il s'est simplement posé sur quelque chose de bien plus ancien, et les deux ont trouvé une sorte de paix.
    </p>
  </div>

  <!-- 1er et 2 novembre -->
  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">Ce qui se passe vraiment les 1er et 2 novembre</h2>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      Les deux jours sont différents et il vaut la peine de les séparer. Le <strong>1er novembre, Ognissanti</strong>, la Toussaint, est un jour férié national : bureaux et banques fermés, beaucoup de commerces aussi, transports à l'horaire du dimanche. C'est une journée de famille, et sur la côte c'est souvent la dernière journée raisonnablement douce pour laquelle quelqu'un se donne la peine de sortir.
    </p>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      Le <strong>2 novembre, la Commemorazione dei defunti</strong>, n'est pas férié, et c'est pourtant lui qui porte le poids. Dès le petit matin les cimetières se remplissent : les familles nettoient les tombes, apportent des chrysanthèmes, allument des bougies, et la visite se fait en personne, pas en pensée. Dans une région où presque tout le monde a des proches enterrés à quelques kilomètres de chez lui, ce n'est pas une observance abstraite.
    </p>
    <p class="text-slate-600 text-lg leading-relaxed mb-8">
      En dessous court une idée plus ancienne, que l'Église a absorbée plutôt qu'inventée : que dans la nuit du premier au deux, les morts reviennent dans les maisons où ils ont vécu et goûtent ce qu'on a laissé pour eux. Naples a poussé cette croyance plus loin que partout ailleurs en Italie, jusqu'à l'ossuaire des Fontanelle et à l'usage d'adopter un crâne anonyme et de prier pour lui. Sur la péninsule, la version qui survit est plus douce et presque entièrement comestible.
    </p>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div class="bg-white p-6 rounded-[2rem] border border-slate-100 shadow-sm">
        <h4 class="font-bold text-slate-900 mb-2">Ce qui est ouvert</h4>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Le 1er novembre, attendez-vous aux horaires de jour férié : banques et bureaux fermés, bus et trains réduits, restaurants soit pleins soit fermés. Le 2 novembre tout est normal, sauf la circulation dense autour des cimetières le matin.</p>
      </div>
      <div class="bg-white p-6 rounded-[2rem] border border-slate-100 shadow-sm">
        <h4 class="font-bold text-slate-900 mb-2">Ce que remarquent les visiteurs</h4>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Des fleurs partout, surtout des chrysanthèmes, qui en Italie sont des fleurs de deuil et ne s'offrent jamais. Apporter un bouquet à un dîner début novembre est l'erreur classique des étrangers.</p>
      </div>
    </div>
  </div>

  <!-- Torrone -->
  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">Torrone dei morti : la douceur au nom que personne n'adoucit</h2>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      Ce n'est pas le nougat blanc et dur de Noël. Le torrone dei morti est moelleux, raison pour laquelle Naples l'appelle <em>'o muollo</em>, et il est bâti sur le chocolat plutôt que sur le miel et le blanc d'oeuf. La version standard est une coque de chocolat noir autour d'une garniture moelleuse de chocolat blanc ou au lait, travaillée avec une crème qui la garde souple et parsemée de noisettes, taillée en blocs rectangulaires.
    </p>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      La forme est la partie que tout le monde mentionne puis dépasse vite : on dit qu'elle rappelle un petit cercueil, et l'autre nom local, <em>'o murticiell</em>, le petit mort, ne fait rien pour dissimuler le lien. L'origine se trouve dans les offrandes que l'on laissait jadis sur les tombes, des tranches de torrone parmi les assiettes, posées là pour adoucir le passage des morts et les nourrir la nuit de leur retour.
    </p>

    <div class="overflow-x-auto rounded-[2rem] border border-slate-100 shadow-sm mb-6">
      <table class="w-full text-xs sm:text-sm">
        <thead class="bg-slate-900 text-white">
          <tr>
            <th class="text-left p-5 font-serif font-bold text-med-gold">Version</th>
            <th class="text-left p-5 font-serif font-bold text-med-gold">Ce qu'il y a dedans</th>
          </tr>
        </thead>
        <tbody class="bg-white">
          <tr class="border-b border-slate-100">
            <td class="p-5 font-bold">Classico</td>
            <td class="p-5 text-slate-600">Chocolat noir dehors, chocolat moelleux et noisette dedans. Le premier à goûter, et l'étalon sur lequel on juge chaque pâtisserie.</td>
          </tr>
          <tr class="border-b border-slate-100">
            <td class="p-5 font-bold">Caffè</td>
            <td class="p-5 text-slate-600">Base de chocolat blanc travaillée au café. Répandu dans toute la Campanie et, à Naples, sans doute plus demandé que l'original.</td>
          </tr>
          <tr class="border-b border-slate-100">
            <td class="p-5 font-bold">Pistacchio et mandorla</td>
            <td class="p-5 text-slate-600">Pistache ou amande à la place de la noisette. Plus moelleux et plus sucrés, ce sont les versions qui convainquent ceux qui croient ne pas aimer le torrone.</td>
          </tr>
          <tr>
            <td class="p-5 font-bold">Torroncini</td>
            <td class="p-5 text-slate-600">La même chose taillée en bouchées, vendue en vrac au poids. Le moyen pratique de goûter quatre variantes sans acheter quatre briques.</td>
          </tr>
        </tbody>
      </table>
    </div>

    <p class="text-slate-600 text-lg leading-relaxed">
      Il apparaît en vitrine dès la mi-octobre et disparaît quelques jours après le 2 novembre. À la différence du <a href="/fr-fr/blog/delice-citron/" class="text-med-blue hover:underline">délice au citron</a>, que l'on commande toute l'année, celui-ci tient vraiment à une quinzaine de jours, et chaque village de la péninsule a la pâtisserie dont les habitants se disputent la version.
    </p>
  </div>

  <!-- Halloween -->
  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">Et puis Halloween est arrivé</h2>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      Halloween a vraiment atteint l'Italie dans les années 1990 et s'y est installé comme fête d'enfants : déguisements, vitrines décorées, soirée en discothèque pour les adolescents, citrouilles dans les bars qui n'ont rien à voir avec ce qui pousse ici. À Sorrente et dans les villes plus grandes, vous le trouverez le 31 octobre sans chercher. Dans les villages le long de la route côtière, vous risquez de ne pas le trouver du tout.
    </p>
    <p class="text-slate-600 text-lg leading-relaxed mb-8">
      Ce qui est intéressant, c'est le peu de friction. Une culture qui croyait déjà que les morts reviennent une nuit par an, et qui les commémorait avec une douceur en forme de cercueil, n'allait jamais se scandaliser d'une fête déguisée. Les deux coexistent simplement, à trois jours d'écart, et la plupart des familles d'ici font les deux sans y penser.
    </p>

    <blockquote class="border-l-4 border-med-gold pl-6 my-8">
      <p class="text-slate-700 text-xl font-serif italic leading-relaxed">
        "Halloween demande aux enfants de faire les morts le temps d'une soirée. Ici, les morts étaient de toute façon attendus à la maison, et quelqu'un leur avait déjà laissé de quoi manger."
      </p>
    </blockquote>
  </div>

  <!-- Confréries -->
  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">Les confréries encapuchonnées de Sorrente</h2>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      Entrez dans n'importe quelle église de cette côte et vous trouverez une chapelle latérale appartenant à une <em>confraternita</em> : une confrérie laïque, pas un ordre religieux, composée d'habitants ordinaires. Beaucoup ont été fondées dans un but explicitement funéraire, enterrer ceux qui ne pouvaient pas payer leur sépulture, accompagner les mourants et prier pour les âmes. Le culte des morts décrit plus haut n'est pas un folklore accroché à ces institutions. C'est la raison de leur existence.
    </p>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      Sorrente en a deux que tout le monde connaît, et une fois par an la ville entière sort pour elles. La <strong>Venerabile Arciconfraternita di Santa Monica</strong> est vêtue de blanc. La <strong>Venerabile Arciconfraternita della Morte</strong> est vêtue de noir ; elle a été fondée en 1586 et a repris l'héritage d'une confrérie de San Catello bien plus ancienne, attestée dès 1380. Les confrères défilent encapuchonnés, et c'est le propos : la cagoule retire l'homme et ne laisse que le geste.
    </p>

    <div class="bg-white p-8 rounded-[2rem] border border-slate-100 shadow-sm mb-6">
      <h3 class="font-serif text-xl font-bold text-slate-900 mb-5">Les deux processions du vendredi saint</h3>
      <div class="space-y-3">
        <div class="flex items-start gap-3">
          <div class="w-6 h-6 rounded-full bg-med-gold/15 flex-shrink-0 flex items-center justify-center text-med-gold font-bold text-xs">1</div>
          <p class="text-slate-600 text-xs sm:text-sm leading-relaxed"><strong>La Procession blanche</strong>, celle de l'Addolorata, quitte l'église de la Santissima Annunziata à trois heures du matin et parcourt les rues du centre historique jusqu'aux premières lueurs. Elle met en scène la Vierge cherchant son fils à travers la ville, et c'est pour elle que l'on met un réveil.</p>
        </div>
        <div class="flex items-start gap-3">
          <div class="w-6 h-6 rounded-full bg-med-gold/15 flex-shrink-0 flex items-center justify-center text-med-gold font-bold text-xs">2</div>
          <p class="text-slate-600 text-xs sm:text-sm leading-relaxed"><strong>La Procession noire</strong>, celle du Christ mort, s'ébranle à vingt heures trente le même jour, avec les cagoules noires, la marche funèbre et le corps porté à travers le centre. La tradition des deux est rattachée au XIVe siècle.</p>
        </div>
      </div>
    </div>

    <p class="text-slate-600 text-lg leading-relaxed">
      Il faut le dire clairement : ce sont des rites de la Semaine sainte et non de novembre, donc qui vient pour la fête des morts ne les verra pas. L'autre grande procession encapuchonnée du golfe, les Misteri de <a href="/fr-fr/iles/procida/" class="text-med-blue hover:underline">Procida</a>, a lieu elle aussi le matin du vendredi saint. Si c'est le versant rituel de cette côte qui vous intéresse, le voyage à prévoir est à Pâques, pas à Halloween.
    </p>
  </div>

  <!-- Conseils -->
  <div class="bg-white p-8 rounded-[2rem] shadow-xl border border-slate-100">
    <div class="flex items-center gap-4 mb-6">
      <svg class="w-6 h-6 text-med-gold flex-shrink-0" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M9 18h6"/><path d="M10 22h4"/><path d="M15.09 14c.18-.98.65-1.74 1.41-2.5A4.65 4.65 0 0 0 18 8 6 6 0 0 0 6 8c0 1 .23 2.23 1.5 3.5A4.61 4.61 0 0 1 8.91 14"/></svg>
      <h3 class="text-xl font-bold">Les Conseils de l'Expert</h3>
    </div>
    <div class="space-y-6">
      <div>
        <p class="font-bold text-slate-900 mb-1">Achetez le torrone la dernière semaine d'octobre</p>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Il apparaît à partir de la mi-octobre et, dans les bonnes pâtisseries, les meilleurs parfums partent les derniers jours. Demandez des torroncini si vous voulez en goûter plusieurs, et demandez le <em>muollo</em> si on vous laisse le choix : la version dure est une autre douceur, pour une autre saison.</p>
      </div>
      <div>
        <p class="font-bold text-slate-900 mb-1">Organisez-vous autour du 1er novembre, pas du 2</p>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Le férié est le premier, et c'est ce jour-là qu'un musée fermé ou un horaire de bus allégé vous prendra de court. Si vous vous déplacez entre villages, vérifiez d'abord l'horaire férié du <a href="/fr-fr/guide/bus-sita/" class="text-med-blue hover:underline">bus SITA</a>.</p>
      </div>
      <div>
        <p class="font-bold text-slate-900 mb-1">Traitez les cimetières comme des lieux privés</p>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Les cimetières à flanc de colline de la péninsule sont des lieux extraordinaires, et le 2 novembre ils sont pleins de familles qui accomplissent quelque chose d'intime. Les visiter est très bien ; photographier les gens pendant qu'ils le font, non.</p>
      </div>
      <div>
        <p class="font-bold text-slate-900 mb-1">Si vous voulez les processions, venez à Pâques</p>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Le vendredi saint à Sorrente, cela veut dire être dans la rue à trois heures du matin puis de nouveau à vingt heures trente. Réservez tôt, car c'est une des rares dates hors saison où la ville se remplit vraiment, et gardez flashs et lampes de téléphone éteints au passage des confrères.</p>
      </div>
    </div>
  </div>

</BlogPostLayout>
