---
import BlogPostLayout from '../../../../layouts/BlogPostLayout.astro';

const lang = 'fr-fr';
const post = {
  title: "Feux d'artifice du Nouvel An à Positano",
  subtitle: "Minuit sur la Spiaggia Grande : l'heure des feux, où se placer et comment aller à Positano et en revenir le seul soir de l'année où la route côtière n'a plus de bus après la tombée de la nuit",
  category: 'GUIDE',
  date: '24 novembre 2026',
  readTime: '8 min',
  image: '/images/fuochi-capodanno-hero.webp',
  imageAlt: "Feu d'artifice vert et doré dans le ciel la nuit du Nouvel An",
  path: '/fr-fr/blog/nouvel-an-positano-feux-artifice/',
};

const metaTitle = "Nouvel An Positano, feu d'artifice 2026 : où le regarder";
const metaDescription = "Nouvel An à Positano : feu d'artifice à minuit sur la Spiaggia Grande, DJ set gratuit jusqu'à 3h, où le voir et comment venir et repartir sans ferry ni bus de nuit.";

const breadcrumbs = [
  { name: 'Accueil', url: '/fr-fr/' },
  { name: 'Blog', url: '/fr-fr/blog/' },
  { name: "Feux d'artifice du Nouvel An à Positano", url: '/fr-fr/blog/nouvel-an-positano-feux-artifice/' },
];

const quickInfo = [
  { label: 'Quand', value: "31 décembre, feux d'artifice à minuit" },
  { label: 'Où', value: 'Spiaggia Grande (Marina Grande)' },
  { label: 'Tarif', value: 'Gratuit' },
  { label: 'Après minuit', value: "DJ set sur la plage jusque vers 3h00" },
  { label: 'Organisation', value: 'Comune di Positano et Forum dei Giovani' },
  { label: 'Ferries', value: "Pas de liaisons l'hiver" },
  { label: 'Bus de nuit', value: "Aucun, prévoyez votre retour à l'avance" },
  { label: 'Programme 2026', value: 'Publié en général en décembre' },
];

const faq = [
  {
    q: "Y a-t-il un feu d'artifice à Positano le soir du Nouvel An ?",
    a: "Oui. Lors des deux dernières éditions, la commune a organisé un feu d'artifice à minuit depuis la Spiaggia Grande, suivi d'une fête gratuite sur la plage avec le Forum dei Giovani. Le programme 2026/2027 n'était pas encore publié au moment où nous écrivons ces lignes : la commune l'annonce normalement en décembre.",
  },
  {
    q: "À quelle heure commence le feu d'artifice ?",
    a: "À minuit. Pour l'édition 2024/2025, la commune indiquait un début à 23h59 et une fin de soirée à 3h00, avec un DJ set sur la plage après les feux. Le calendrier 2025/2026 annonçait 00h00 pour le feu d'artifice sur la Spiaggia Grande.",
  },
  {
    q: 'Faut-il un billet ?',
    a: "Non. Le feu d'artifice et la fête sur la plage sont gratuits et ouverts à tous. Vous ne payez que si vous réservez un dîner de réveillon dans un restaurant ou un hôtel, et ces dîners proposent des menus fixes à prix fixe.",
  },
  {
    q: "Quel est le meilleur endroit pour le regarder ?",
    a: "Sur la Spiaggia Grande même si vous voulez la musique et la foule, sur les marches et dans les ruelles autour de l'église Santa Maria Assunta juste au-dessus de la plage, ou depuis la Via Positanesi d'America, le sentier à flanc de falaise vers Fornillo, si vous voulez voir toute la baie avec un peu plus d'espace. Une terrasse face à la baie est l'option la plus confortable, mais elle se réserve avec le dîner.",
  },
  {
    q: 'Peut-on aller à Positano en ferry le 31 décembre ?',
    a: "Non. Les ferries de la côte amalfitaine s'arrêtent pour l'hiver : le soir du Nouvel An, on ne peut venir qu'avec le bus SITA et ses horaires d'hiver réduits, en taxi ou avec un chauffeur privé, ou avec sa propre voiture.",
  },
  {
    q: 'Comment rentrer après minuit ?',
    a: "Pas en bus : SITA n'assure aucune course au milieu de la nuit. Si vous ne dormez pas à Positano, réservez un taxi ou un chauffeur privé bien avant le 31 décembre et convenez de l'heure et du lieu de prise en charge. Ce soir-là, ce sont les premiers à être complets.",
  },
];

const sidebarLinks = [
  { label: 'Positano', href: '/fr-fr/cote-amalfitaine/positano/' },
  { label: 'Hôtels et restaurants de Positano', href: '/fr-fr/blog/hotels-restaurants-positano/' },
  { label: 'Nouvel An à Sorrente', href: '/fr-fr/evenements/peninsule-sorrentine/capodanno-sorrento/' },
  { label: 'Bus SITA', href: '/fr-fr/guide/bus-sita/' },
  { label: 'Stationnement et ZTL', href: '/fr-fr/guide/parking-ztl/' },
];

const authorRole = 'Spécialiste Côte Amalfitaine';

const relatedArticles = [
  {
    title: 'Illuminations de Noël à Sorrente et Salerne',
    category: 'GUIDE',
    date: '21 octobre 2026',
    image: '/images/luci-artista-salerno-hero.webp',
    imageAlt: 'Illuminations de Noël à Salerne',
    path: '/fr-fr/blog/illuminations-noel-sorrente-salerne/'
  },
  {
    title: 'Hôtels et restaurants de Positano : huit adresses à connaître',
    category: 'GUIDE',
    date: '31 août 2026',
    image: '/images/positano-spiaggia-grande-colombo-hero.webp',
    imageAlt: 'Hôtels et restaurants de Positano',
    path: '/fr-fr/blog/hotels-restaurants-positano/'
  }
];

const keyTakeaways = [
  "Le feu d'artifice est tiré à minuit depuis la Spiaggia Grande, et la fête sur la plage avec DJ set se prolonge jusque vers 3h00. Les deux sont gratuits.",
  "Le programme 2026/2027 est en général confirmé par la commune en décembre. Les horaires indiqués ici viennent des deux dernières éditions.",
  "Pas de ferries l'hiver, pas de bus SITA au milieu de la nuit. Dormez à Positano ou réservez votre retour avant d'arriver.",
  "Les restaurants ouverts pendant les fêtes servent des menus de réveillon fixes. Réservez dès novembre, car beaucoup d'établissements de la côte ferment pour l'hiver.",
  "Si la météo se gâte, le spectacle peut être réduit ou déplacé. Consultez la page de la commune et ses réseaux sociaux le 31.",
];
---

<BlogPostLayout
  lang={lang}
  post={post}
  metaTitle={metaTitle}
  metaDescription={metaDescription}
  breadcrumbs={breadcrumbs}
  quickInfo={quickInfo}
  faq={faq}
  sidebarLinks={sidebarLinks}
  authorRole={authorRole}
  relatedArticles={relatedArticles}
  pageKey="positano-new-years-eve-fireworks"
>

  <!-- Points Clés -->
  <div class="bg-slate-900 text-white p-8 rounded-[2rem]">
    <div class="flex items-center gap-3 mb-6">
      <svg class="w-5 h-5 text-med-gold flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
      <h2 class="font-serif text-lg font-bold text-med-gold uppercase tracking-[0.15em]">Points Clés</h2>
    </div>
    <ul class="space-y-4">
      {keyTakeaways.map((point) => (
        <li class="flex items-start gap-3">
          <span class="w-1.5 h-1.5 rounded-full bg-med-gold flex-shrink-0 mt-2"></span>
          <span class="text-white/80 text-xs sm:text-sm leading-relaxed">{point}</span>
        </li>
      ))}
    </ul>
  </div>

  <!-- Intro -->
  <div>
    <p class="text-slate-600 text-xl leading-relaxed mb-6 font-light">
      L'hiver, <a href="/fr-fr/cote-amalfitaine/positano/" class="text-med-blue hover:underline">Positano</a> devient silencieuse : beaucoup d'hôtels ferment, les clubs de plage rangent leurs transats et les ruelles appartiennent surtout aux habitants. Le 31 décembre, la ville se remplit de nouveau le temps d'une nuit. À minuit, les feux d'artifice partent de la Spiaggia Grande, les maisons accrochées à la colline s'illuminent derrière eux et la plage se transforme en piste de danse jusqu'au petit matin. Voici comment se déroule la soirée, où vous placer et, surtout, comment venir et repartir.
    </p>
  </div>

  <!-- Le programme -->
  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">Le déroulement de la soirée</h2>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      La fête est organisée par la Comune di Positano avec le Forum dei Giovani, le conseil des jeunes de la ville, et la formule n'a pas changé ces dernières années. Pour l'édition 2024/2025, la commune annonçait un début à <strong>23h59</strong> sur la Spiaggia Grande : d'abord le feu d'artifice, puis un <strong>DJ set sur la plage jusqu'à 3h00</strong>. Le calendrier 2025/2026 plaçait de nouveau les feux à <strong>minuit sur la Spiaggia Grande</strong>, suivis de la fête avec le Forum dei Giovani.
    </p>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      L'entrée est libre et il n'y a rien à réserver pour la plage. La soirée avant minuit, c'est à vous de l'organiser : la plupart des gens dînent au restaurant ou à leur hôtel puis descendent vers la plage vers onze heures et demie. Le programme <strong>2026/2027</strong> n'était pas encore publié au moment de la rédaction de cet article. La commune le met normalement en ligne sur son site en décembre, parfois quelques jours seulement avant le 31.
    </p>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-6">
      <div class="bg-white p-6 rounded-[2rem] border border-slate-100 shadow-sm">
        <h4 class="font-bold text-slate-900 mb-2">Avant minuit</h4>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Dîner en ville, en général un menu de réveillon fixe. Les restaurants avec vue sur la baie sont les premiers complets. Prévoyez le temps de la descente : dans les ruelles au-dessus de la plage, tout le monde va dans la même direction.</p>
      </div>
      <div class="bg-white p-6 rounded-[2rem] border border-slate-100 shadow-sm">
        <h4 class="font-bold text-slate-900 mb-2">Minuit</h4>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Feu d'artifice depuis la Spiaggia Grande. Le spectacle est court, quelques minutes à peine : soyez en place dès minuit moins le quart.</p>
      </div>
      <div class="bg-white p-6 rounded-[2rem] border border-slate-100 shadow-sm">
        <h4 class="font-bold text-slate-900 mb-2">Après minuit</h4>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Le DJ set sur la plage, gratuit, jusque vers 3h00. Restez autant que vous voulez, mais surveillez l'heure si quelqu'un vient vous chercher.</p>
      </div>
      <div class="bg-white p-6 rounded-[2rem] border border-slate-100 shadow-sm">
        <h4 class="font-bold text-slate-900 mb-2">Si la météo se gâte</h4>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Une tempête de décembre peut réduire ou déplacer un événement organisé sur une plage. Le jour même, consultez le site de la commune et les réseaux sociaux du Forum dei Giovani.</p>
      </div>
    </div>
  </div>

  <!-- Où regarder -->
  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">Où regarder le feu d'artifice</h2>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      Positano est construite en amphithéâtre autour de sa plage : on voit donc les feux depuis une grande partie de la ville. Ce qui change, c'est la distance et le monde autour de vous.
    </p>
    <ul class="space-y-4 text-slate-600 mb-6">
      <li class="flex items-start gap-3">
        <span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span>
        <span class="text-slate-700"><strong>La Spiaggia Grande.</strong> Au coeur de la fête, avec la musique et le compte à rebours. C'est aussi là qu'il faut être si vous restez pour le DJ set. La foule est dense autour de minuit : gardez votre sac devant vous et fixez un point de rendez-vous avec votre groupe.</span>
      </li>
      <li class="flex items-start gap-3">
        <span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span>
        <span class="text-slate-700"><strong>Autour de Santa Maria Assunta.</strong> Les marches et les ruelles autour de l'église, juste au-dessus de la plage, offrent une vue un peu surélevée à deux minutes à pied de la fête.</span>
      </li>
      <li class="flex items-start gap-3">
        <span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span>
        <span class="text-slate-700"><strong>Via Positanesi d'America.</strong> Le sentier taillé dans la falaise entre la Spiaggia Grande et <a href="/fr-fr/plages/cote-amalfitaine/fornillo-positano/" class="text-med-blue hover:underline">Fornillo</a> regarde vers la baie, avec la ville en toile de fond derrière les feux. Il y a plus d'espace que sur la plage, mais le sentier est étroit : ne vous arrêtez pas là où les gens doivent passer.</span>
      </li>
      <li class="flex items-start gap-3">
        <span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span>
        <span class="text-slate-700"><strong>Une terrasse sur la baie.</strong> Les hôtels et restaurants face à la mer proposent un dîner de réveillon avec vue sur le feu d'artifice. C'est l'option la plus au chaud et la plus chère, et elle se réserve longtemps à l'avance.</span>
      </li>
    </ul>
    <p class="text-slate-600 text-lg leading-relaxed">
      Le bateau n'est pas une option réaliste : les ferries ne circulent pas l'hiver, et une location privée par une nuit de décembre dépend entièrement de l'état de la mer.
    </p>
  </div>

  <!-- Venir et repartir -->
  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">Venir et repartir</h2>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      C'est le point à régler avant tout le reste. L'été, vous arriveriez par la mer et repartiriez en bus. Le 31 décembre, les ferries ne circulent pas et les bus s'arrêtent dans la soirée : l'endroit où vous dormez décide de tout.
    </p>

    <div class="overflow-x-auto rounded-[2rem] border border-slate-100 shadow-sm">
      <table class="w-full text-xs sm:text-sm">
        <thead class="bg-slate-900 text-white">
          <tr>
            <th class="text-left p-5 font-serif font-bold text-med-gold">Moyen</th>
            <th class="text-left p-5 font-serif font-bold text-med-gold">Pour venir</th>
            <th class="text-left p-5 font-serif font-bold text-med-gold">Pour rentrer après minuit</th>
          </tr>
        </thead>
        <tbody class="bg-white">
          <tr class="border-b border-slate-100">
            <td class="p-5 font-bold">Bus SITA</td>
            <td class="p-5 text-slate-600">Oui, aux horaires d'hiver. Environ 50 min depuis Sorrente</td>
            <td class="p-5 text-slate-600">Non, aucune course de nuit</td>
          </tr>
          <tr class="border-b border-slate-100">
            <td class="p-5 font-bold">Ferry</td>
            <td class="p-5 text-slate-600">Non, suspendu l'hiver</td>
            <td class="p-5 text-slate-600">Non</td>
          </tr>
          <tr class="border-b border-slate-100">
            <td class="p-5 font-bold">Taxi ou chauffeur privé</td>
            <td class="p-5 text-slate-600">Oui</td>
            <td class="p-5 text-slate-600">Oui, mais seulement sur réservation préalable</td>
          </tr>
          <tr>
            <td class="p-5 font-bold">Voiture personnelle</td>
            <td class="p-5 text-slate-600">Possible, uniquement avec des garages payants</td>
            <td class="p-5 text-slate-600">Seulement avec un conducteur qui ne boit pas</td>
          </tr>
        </tbody>
      </table>
    </div>

    <p class="text-slate-600 text-lg leading-relaxed mt-6 mb-6">
      <strong>Dormir à Positano</strong> règle le problème : après le feu d'artifice, vous rentrez à pied à votre chambre. Réservez tôt, car peu d'hôtels restent ouverts pendant les fêtes. Notre sélection d'<a href="/fr-fr/blog/hotels-restaurants-positano/" class="text-med-blue hover:underline">hôtels et restaurants à Positano</a> est un bon point de départ.
    </p>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      <strong>En bus.</strong> Le <a href="/fr-fr/guide/bus-sita/" class="text-med-blue hover:underline">bus SITA</a> relie Sorrente et Amalfi même l'hiver, avec moins de courses. Les arrêts de Positano se trouvent sur la route principale au-dessus de la ville : depuis Sponda, comptez une dizaine de minutes à pied pour descendre à la plage. C'est une solution pour arriver dans l'après-midi, pas pour repartir après minuit. Le 1er janvier, ce sont les horaires des jours fériés qui s'appliquent, avec encore moins de courses.
    </p>
    <p class="text-slate-600 text-lg leading-relaxed">
      <strong>En voiture.</strong> La ZTL de Positano ne s'applique qu'en été : en décembre, vous pouvez donc entrer en voiture, mais le stationnement se limite aux garages privés et les rares rues de la ville sont saturées le 31. Demandez à votre hôtel avec quel garage il travaille et consultez notre <a href="/fr-fr/guide/parking-ztl/" class="text-med-blue hover:underline">guide du stationnement et de la ZTL</a>. Si vous logez à Praiano ou à Sorrente, un taxi aller-retour coûte plus cher que le garage, mais il vous évite à la fois le stationnement et le retour au volant sur la route côtière à deux heures du matin.
    </p>
  </div>

  <!-- Conseils -->
  <div class="bg-white p-8 rounded-[2rem] shadow-xl border border-slate-100">
    <div class="flex items-center gap-4 mb-6">
      <svg class="w-6 h-6 text-med-gold flex-shrink-0" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M9 18h6"/><path d="M10 22h4"/><path d="M15.09 14c.18-.98.65-1.74 1.41-2.5A4.65 4.61 0 0 0 18 8 6 6 0 0 0 6 8c0 1 .23 2.23 1.5 3.5A4.61 4.61 0 0 1 8.91 14"/></svg>
      <h3 class="text-xl font-bold">Les Conseils de l'Expert</h3>
    </div>
    <div class="space-y-6">
      <div>
        <p class="font-bold text-slate-900 mb-1">Réservez votre retour dès novembre</p>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Le soir du Nouvel An, les taxis et les chauffeurs privés de la côte sont réservés des semaines à l'avance. Convenez du point de prise en charge par écrit (l'arrêt Sponda sur la route principale est le plus simple) et gardez du temps pour la remontée depuis la plage.</p>
      </div>
      <div>
        <p class="font-bold text-slate-900 mb-1">Des chaussures pour les marches, pas pour la fête</p>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Positano n'est qu'escaliers et ruelles en pente, et après minuit elles sont par endroits mal éclairées et bondées. Chaussures plates qui accrochent et veste chaude : la nuit, en décembre, le vent de la mer est froid sur la plage.</p>
      </div>
      <div>
        <p class="font-bold text-slate-900 mb-1">Vérifiez le programme le 31</p>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Les informations données ici viennent des deux dernières éditions. Les horaires et les organisateurs peuvent changer, et une tempête peut bouleverser le programme le jour même. Le site de la commune est la source officielle.</p>
      </div>
      <div>
        <p class="font-bold text-slate-900 mb-1">L'alternative : Sorrente</p>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Si rejoindre Positano en hiver vous semble trop compliqué, le <a href="/fr-fr/evenements/peninsule-sorrentine/capodanno-sorrento/" class="text-med-blue hover:underline">Nouvel An à Sorrente</a> propose un concert, le Ciuccio di Fuoco sur la Piazza Tasso et un feu d'artifice depuis Marina Piccola, dans une ville où davantage d'hôtels restent ouverts et d'où part le train pour Naples.</p>
      </div>
    </div>
  </div>

</BlogPostLayout>
