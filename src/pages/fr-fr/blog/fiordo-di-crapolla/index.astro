---
import BlogPostLayout from '../../../../layouts/BlogPostLayout.astro';

const lang = 'fr-fr';
const post = {
  title: 'Le Fjord de Crapolla',
  subtitle: 'Le trésor caché des 700 marches',
  category: 'DÉCOUVERTES',
  date: '15 mai 2026',
  readTime: '12 min',
  image: '/images/fiordo-crapolla-hero.jpg',
  imageAlt: 'Fjord de Crapolla - Massa Lubrense, Péninsule Sorrentine',
  path: '/fr-fr/blog/fiordo-di-crapolla/',
};

const metaTitle = 'Le Fjord de Crapolla : Le trésor caché de la Péninsule Sorrentine 2026';
const metaDescription = 'Guide complet du Fjord de Crapolla : 700 marches, chapelle médiévale, ruines romaines, histoire archéologique et conseils pratiques pour visiter ce lieu secret à Massa Lubrense.';

const breadcrumbs = [
  { name: 'Accueil', url: '/fr-fr/' },
  { name: 'Blog', url: '/fr-fr/blog/' },
  { name: 'Fjord de Crapolla', url: '/fr-fr/blog/fiordo-di-crapolla/' },
];

const quickInfo = [
  { label: 'Point de départ', value: 'Via Casal di Torca (Massa Lubrense)' },
  { label: 'Nombre de marches', value: '~700 (pierre naturelle)' },
  { label: 'Dénivellation', value: 'Environ 160 mètres' },
  { label: 'Difficulté', value: 'Moyenne/Haute (effort physique intense)' },
  { label: 'Eau', value: 'Aucune sur place (prévoir 2 litres minimum)' },
  { label: 'Temps de descente', value: 'Environ 45-60 minutes' },
  { label: 'À voir', value: 'Chapelle San Pietro, ruines romaines, monazeni' },
  { label: 'Meilleure saison', value: 'Avril-juin, septembre-octobre' },
];

const faq = [
  {
    q: 'Quel est le nombre exact de marches ?',
    a: 'Il n\'existe pas de nombre précis : le comptage varie entre 680 et 700 selon le point de départ et la façon de compter les dernières marches. La plupart des visiteurs rapportent environ 700 marches.',
  },
  {
    q: 'Combien de temps prend la montée ?',
    a: 'La montée prend généralement 60-90 minutes. Cela dépend de votre niveau de forme physique et de l\'heure du jour (pendant les mois chauds, la chaleur de la pierre ralentit considérablement votre rythme).',
  },
  {
    q: 'Est-il obligatoire de prévoir de l\'eau ?',
    a: 'Absolument oui. Il n\'y a pas de fontaines ni de points de ravitaillement sur le parcours. Prévoyez au moins 2 litres par personne, davantage en été.',
  },
  {
    q: 'Y a-t-il des dangers sur le sentier ?',
    a: 'Le parcours n\'est pas techniquement difficile, mais la pierre calcaire peut être glissante, surtout avec des chaussures inadaptées. Portez toujours des chaussures de randonnée avec une bonne adhérence.',
  },
  {
    q: 'Puis-je me baigner ?',
    a: 'Oui, l\'eau est cristalline et la plage est merveilleuse. La zone fait partie de la Réserve Marine de Punta Campanella, donc l\'écosystème est protégé.',
  },
  {
    q: 'Dois-je réserver ou demander une permission ?',
    a: 'Aucune réservation nécessaire. C\'est un lieu public, mais n\'oubliez pas d\'emporter vos déchets et de respecter l\'environnement.',
  },
];

const sidebarLinks = [
  { label: 'Massa Lubrense', href: '/fr-fr/peninsule-sorrentine/massa-lubrense/' },
  { label: 'Punta Campanella', href: '/fr-fr/blog/punta-campanella/' },
  { label: 'Quand visiter', href: '/fr-fr/guide/quand-visiter/' },
  { label: 'Comment y aller', href: '/fr-fr/guide/comment-venir/' },
];

const relatedArticles = [
  {
    title: 'Punta Campanella',
    category: 'DÉCOUVERTES',
    date: '10 mai 2026',
    image: '/images/punta-campanella-hero.jpg',
    imageAlt: 'Punta Campanella - Massa Lubrense, Péninsule Sorrentine',
    path: '/fr-fr/blog/punta-campanella/'
  },
  {
    title: 'Vallée des Amalfiains : Randonnée au cœur vert d\'Amalfi',
    category: 'DÉCOUVERTES',
    date: '22 avril 2026',
    image: '/images/valle-ferriere-hero.jpg',
    imageAlt: 'Cascade dans la Vallée des Amalfiains, Amalfi - Côte d\'Amalfi',
    path: '/fr-fr/blog/vallee-des-ferriere/'
  }
];

const authorRole = 'Guide d\'Archéologie & Randonnée · Péninsule Sorrentine';

const keyTakeaways = [
  'Le Fjord de Crapolla n\'est pas seulement une plage secrète, mais un monument naturel et archéologique aux racines remontant à l\'Antiquité classique, dédié au dieu Apollon.',
  'Les ~700 marches en pierre calcaire ont été construites avec la sagesse ancienne pour surmonter une dénivellation vertigineuse d\'environ 160 mètres, et restent l\'attrait distinctif du lieu.',
  'La Chapelle Saint-Pierre est bâtie sur les ruines d\'un temple païen dédié à Apollon ; au Moyen Âge, une importante abbaye bénédictine s\'y épanouissait.',
  'Les monazeni (cavités creusées dans la roche par les Romains) témoignent de la manière dont le site a été utilisé pendant des siècles comme refuge naturel et entreposage de bateaux.',
  'Le moment idéal pour visiter est entre 6h00 et 12h00 en été, en évitant la chaleur torride de la pierre calcaire pendant les heures centrales de la journée.',
];

const videoSchema = {
  "@context": "https://schema.org",
  "@type": "VideoObject",
  "name": "Le Fjord de Crapolla : Le trésor caché des 700 marches",
  "description": "Vidéo du Fjord de Crapolla - l\'un des endroits les plus fascinants de la Péninsule Sorrentine avec ses 700 marches en pierre, la Chapelle San Pietro et l\'histoire archéologique antique.",
  "thumbnailUrl": "/images/fiordo-crapolla-hero.jpg",
  "uploadDate": "2026-05-15",
  "duration": "PT1M30S",
  "contentUrl": "/videos/fiordo-crapolla-video.mp4",
  "videoDetails": {
    "width": "1280",
    "height": "720"
  }
};
---

<BlogPostLayout
  lang={lang}
  post={post}
  metaTitle={metaTitle}
  metaDescription={metaDescription}
  breadcrumbs={breadcrumbs}
  quickInfo={quickInfo}
  faq={faq}
  sidebarLinks={sidebarLinks}
  authorRole={authorRole}
  relatedArticles={relatedArticles}
  schema={[videoSchema]}
  pageKey="fiordo-di-crapolla"
>

  <!-- Key Takeaways -->
  <div class="bg-slate-900 text-white p-8 rounded-[2rem]">
    <div class="flex items-center gap-3 mb-6">
      <svg class="w-5 h-5 text-med-gold flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
      <h2 class="font-serif text-lg font-bold text-med-gold uppercase tracking-[0.15em]">Points clés</h2>
    </div>
    <ul class="space-y-4">
      {keyTakeaways.map((point) => (
        <li class="flex items-start gap-3">
          <span class="w-1.5 h-1.5 rounded-full bg-med-gold flex-shrink-0 mt-2"></span>
          <span class="text-white/80 text-xs sm:text-sm leading-relaxed">{point}</span>
        </li>
      ))}
    </ul>
  </div>

  <!-- Intro -->
  <div>
    <p class="text-slate-600 text-xl leading-relaxed mb-6 font-light">
      Le Fjord de Crapolla, à <a href="/fr-fr/peninsule-sorrentine/massa-lubrense/" class="text-med-blue hover:underline">Massa Lubrense</a>, est un monument naturel et archéologique à ciel ouvert. Protégée par de hautes parois, cette crique n'est accessible qu'à ceux qui acceptent de la "mériter" après une longue marche.
    </p>
  </div>

  <!-- Video Section -->
  <div class="rounded-[2rem] shadow-xl mb-8 flex justify-center bg-slate-900 py-4">
    <video muted="muted"
      controls controlsList="nofullscreen" id="disable-audio"
      poster="/images/fiordo-crapolla-hero.jpg"
      class="max-w-full max-h-[500px]"
      width="1280"
      height="720"
    >
      <source src="/videos/fiordo-crapolla-video.mp4?v=2" type="video/mp4" />
      Votre navigateur ne supporte pas la balise vidéo. Veuillez télécharger la vidéo pour la visionner.
    </video>
    <script>
  function cleanApostrophes(text) {
    return String(text).replace(/\'/g, "'");
  }
      let video = document.getElementById("disable-audio");
      if (!video) video = document.querySelector('video');
      if (video) {
        const forceMuted = () => {
          video.muted = true;
          video.volume = 0;
        };
        forceMuted();
        video.addEventListener('play', forceMuted);
        video.addEventListener('playing', forceMuted);
        video.addEventListener('volumechange', forceMuted);
        video.addEventListener('timeupdate', forceMuted);
        video.addEventListener('seeked', forceMuted);
      }
    </script>
  </div>

  <!-- Le Sentier -->
  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">Le Sentier : Entre maquis et mythes</h2>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      Le départ se fait du hameau de Torca. Le sentier serpente entre murets de pierre sèche et végétation méditerranéenne (myrte, lentisque). On y admire l'archipel des Li Galli et l'île d'Isca, refuge du dramaturge Eduardo De Filippo.
    </p>

    <div class="bg-white p-8 rounded-[2rem] border border-slate-100 shadow-sm my-6">
      <h3 class="font-serif text-xl font-bold text-slate-900 mb-4">Le Défi des 700 Marches</h3>
      <p class="text-slate-600 leading-relaxed mb-4">
        La particularité de Crapolla est son escalier monumental de 700 marches en pierre. Chaque marche témoigne d'un savoir-faire ancien pour dompter la falaise.
      </p>
      <p class="text-slate-600 leading-relaxed">
        Des faïences indiquent le nombre de marches parcourues, une information cruciale pour gérer son effort à la remontée.
      </p>
    </div>
  </div>

  <!-- La Chapelle -->
  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">La Chapelle Saint-Pierre et le Temple d'Apollon</h2>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      Avant la plage, on découvre la Chapelle Saint-Pierre. Cette petite église blanche possède une importance historique fascinante.
    </p>

    <div class="space-y-6 mb-8">
      <div class="bg-white p-6 rounded-[2rem] border border-slate-100 shadow-sm">
        <h4 class="font-bold text-slate-900 mb-2">Origines classiques</h4>
        <p class="text-slate-600 text-sm leading-relaxed">"Crapolla" vient d'Acra-Apollo. L'église est bâtie sur les restes d'un temple romain dédié au dieu du soleil.</p>
      </div>
      <div class="bg-white p-6 rounded-[2rem] border border-slate-100 shadow-sm">
        <h4 class="font-bold text-slate-900 mb-2">L'Abbaye</h4>
        <p class="text-slate-600 text-sm leading-relaxed">Au Moyen Âge, une importante abbaye bénédictine y fleurissait. Aujourd'hui, des colonnes de marbre romain réutilisées dans la chapelle témoignent de cette époque.</p>
      </div>
      <div class="bg-white p-6 rounded-[2rem] border border-slate-100 shadow-sm">
        <h4 class="font-bold text-slate-900 mb-2">La Légende</h4>
        <p class="text-slate-600 text-sm leading-relaxed">L'Apôtre Pierre aurait débarqué ici lors de son voyage vers Rome pour évangéliser l'Occident.</p>
      </div>
    </div>

    <blockquote class="border-l-4 border-med-gold pl-6 my-8">
      <p class="text-slate-700 text-xl font-serif italic leading-relaxed">
        "Crapolla est où l'histoire classique, l'histoire médiévale et la nature sauvage se rencontrent dans un espace incroyablement petit et intact."
      </p>
    </blockquote>
  </div>

  <!-- Le Village -->
  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">Le Village de Pêcheurs et la Plage</h2>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      En bas, découvrez les restes d'un ancien village de pêcheurs. Vous y trouverez les monazeni : des cavités creusées par les Romains et utilisées pendant des siècles pour stocker les bateaux. La plage est un petit ruban de galets blancs où l'eau est d'une pureté cristalline.
    </p>

    <div class="overflow-hidden rounded-[2rem] border border-slate-100 shadow-sm">
      <table class="w-full text-xs sm:text-sm">
        <thead class="bg-slate-900 text-white">
          <tr>
            <th class="text-left p-5 font-serif font-bold text-med-gold">Caractéristique</th>
            <th class="text-left p-5 font-serif font-bold text-med-gold">Détail</th>
          </tr>
        </thead>
        <tbody class="bg-white">
          <tr class="border-b border-slate-100">
            <td class="p-5 font-bold">Point de départ</td>
            <td class="p-5 text-slate-600">Via Casal di Torca (Massa Lubrense)</td>
          </tr>
          <tr class="border-b border-slate-100">
            <td class="p-5 font-bold">Nombre de marches</td>
            <td class="p-5 text-slate-600">environ 700</td>
          </tr>
          <tr class="border-b border-slate-100">
            <td class="p-5 font-bold">Dénivellation</td>
            <td class="p-5 text-slate-600">environ 160 mètres</td>
          </tr>
          <tr class="border-b border-slate-100">
            <td class="p-5 font-bold">Difficulté</td>
            <td class="p-5 text-slate-600">Moyenne/Haute (effort physique intense au retour)</td>
          </tr>
          <tr>
            <td class="p-5 font-bold">Eau</td>
            <td class="p-5 text-slate-600">Aucune sur place (prévoir 2 litres minimum)</td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>

  <!-- Conseils -->
  <div class="bg-white p-8 rounded-[2rem] shadow-xl border border-slate-100">
    <div class="flex items-center gap-4 mb-6">
      <svg class="w-6 h-6 text-med-gold flex-shrink-0" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M9 18h6"/><path d="M10 22h4"/><path d="M15.09 14c.18-.98.65-1.74 1.41-2.5A4.65 4.65 0 0 0 18 8 6 6 0 0 0 6 8c0 1 .23 2.23 1.5 3.5A4.61 4.61 0 0 1 8.91 14"/></svg>
      <h3 class="text-xl font-bold">Conseils d'Expert</h3>
    </div>
    <div class="space-y-6">
      <div>
        <p class="font-bold text-slate-900 mb-1">Le Meilleur Moment</p>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Évitez la montée entre 12h00 et 16h00 en été. L'escalier est exposé au sud et la chaleur de la pierre peut être épuisante.</p>
      </div>
      <div>
        <p class="font-bold text-slate-900 mb-1">Chaussures</p>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Ne commettez pas l'erreur de descendre en sandales. La pierre est glissante et les marches sont irrégulières. Portez des chaussures de randonnée avec une bonne accroche.</p>
      </div>
      <div>
        <p class="font-bold text-slate-900 mb-1">Respect</p>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Crapolla est un site archéologique et naturel. Emportez vos déchets : il n'y a pas de services de nettoyage et la beauté du lieu dépend du respect des visiteurs.</p>
      </div>
    </div>
  </div>

</BlogPostLayout>
