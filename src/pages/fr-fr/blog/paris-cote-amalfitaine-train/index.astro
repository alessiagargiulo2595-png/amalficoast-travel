---
import BlogPostLayout from '../../../../layouts/BlogPostLayout.astro';

const lang = 'fr-fr';
const post = {
  title: 'De Paris à la côte amalfitaine en train',
  subtitle: "L'itinéraire régulier via Milan et Naples, la durée réelle, et l'Orient-Express de trois nuits qui fait aujourd'hui le même trajet comme un voyage",
  category: 'GUIDE',
  date: '14 septembre 2026',
  readTime: '11 min',
  image: '/images/frecciarossa-napoli-hero.webp',
  imageAlt: "Frecciarossa 1000 à Naples Centrale, le dernier changement sur la route depuis Paris",
  path: '/fr-fr/blog/paris-cote-amalfitaine-train/',
};

const metaTitle = 'Paris à la côte amalfitaine en train : trajets 2026';
const metaDescription = "Aucun train direct. Paris-Milan en 7 heures environ, Milan-Naples en 4h30, puis Sorrente ou Salerne : 13 à 14 heures au total. Plus le Venice Simplon-Orient-Express de Paris à la côte amalfitaine et son prix.";

const breadcrumbs = [
  { name: 'Accueil', url: '/fr-fr/' },
  { name: 'Blog', url: '/fr-fr/blog/' },
  { name: 'De Paris à la côte amalfitaine en train', url: '/fr-fr/blog/paris-cote-amalfitaine-train/' },
];

const quickInfo = [
  { label: 'Train direct', value: 'Aucun, le trajet compte trois étapes' },
  { label: 'Paris-Milan', value: 'Environ 7h, 2 allers-retours par jour' },
  { label: 'Milan-Naples', value: 'Environ 4h30 en Frecciarossa' },
  { label: 'Naples-Sorrente', value: 'Environ 1h en Circumvesuviana' },
  { label: 'Naples-Salerne', value: '35 min à grande vitesse' },
  { label: 'Durée totale', value: 'Entre 13 et 14 heures' },
  { label: 'Meilleure option', value: 'Deux jours avec une nuit d\'étape' },
  { label: 'Version luxe', value: 'Orient-Express, 3 nuits, à partir de 9 900 euros' },
];

const faq = [
  {
    q: 'Existe-t-il un train direct de Paris à la côte amalfitaine ?',
    a: "Non. Aucune voie ferrée n'atteint Positano, Amalfi ou Ravello, et il n'existe aucun service direct entre Paris et le sud de l'Italie. Le voyage se compose de trois étapes : Paris-Milan, Milan-Naples, puis Naples vers Sorrente ou Salerne, les deux portes ferroviaires de la côte.",
  },
  {
    q: 'Combien de temps dure le trajet avec les trains réguliers ?',
    a: "Entre 13 et 14 heures de trajet effectif, avant d'ajouter les marges de correspondance. Environ 7 heures de Paris à Milan, environ 4 heures 30 de Milan à Naples, puis entre 35 minutes et une heure pour la dernière étape. Le faire en une seule journée est techniquement possible et franchement pénible.",
  },
  {
    q: 'La ligne Paris-Milan circule-t-elle normalement ?',
    a: "Oui. Le parcours par la vallée de la Maurienne avait été coupé par un éboulement fin août 2023 et a rouvert le 31 mars 2025, avec le retour des TGV Inoui de la SNCF et des Frecciarossa de Trenitalia. Des travaux dans le tunnel du Mont-Cenis ont ensuite suspendu les trains directs du 11 septembre au 9 octobre 2026, la liaison directe reprenant à partir du 10 octobre 2026.",
  },
  {
    q: 'Faut-il viser Sorrente ou Salerne ?',
    a: "Salerne si vous allez à Amalfi, Positano, Ravello ou Minori : la ville a le terminal des ferries et les bus SITA le long de la route côtière. Sorrente si vous logez sur la péninsule sorrentine ou si vous voulez le ferry pour Capri. Salerne est aussi plus rapide à rejoindre, puisque les trains à grande vitesse y marquent l'arrêt.",
  },
  {
    q: "Qu'est-ce que l'Orient-Express Paris-côte amalfitaine ?",
    a: "Un itinéraire de trois nuits à bord du Venice Simplon-Orient-Express exploité par Belmond : une nuit à bord à travers la France et la Riviera italienne, une visite guidée privée de Pompéi et deux nuits à l'hôtel Caruso de Ravello. Le départ inaugural a quitté Paris le 4 mai 2026 et a affiché complet ; d'autres départs sont programmés pour 2027, à partir de 9 900 euros environ par personne.",
  },
  {
    q: "Peut-on voyager de nuit plutôt que de dormir à l'hôtel ?",
    a: "Pas dans un train direct. L'ancien train de nuit entre Paris et l'Italie ne circule plus, l'équivalent pratique est donc une nuit d'hôtel à Milan, Turin, Rome ou Naples. Beaucoup choisissent Rome, parce que cela coupe le voyage presque en deux et qu'il reste à peine plus d'une heure jusqu'à Naples.",
  },
];

const sidebarLinks = [
  { label: 'La côte amalfitaine en train', href: '/fr-fr/blog/cote-amalfitaine-en-train/' },
  { label: 'Où atterrir', href: '/fr-fr/blog/ou-atterrir-cote-amalfitaine/' },
  { label: 'Ferries', href: '/fr-fr/guide/ferries/' },
  { label: 'Bus SITA', href: '/fr-fr/guide/bus-sita/' },
  { label: 'Côte amalfitaine', href: '/fr-fr/cote-amalfitaine/' },
];

const authorRole = 'Spécialiste Côte Amalfitaine';

const relatedArticles = [
  {
    title: 'La côte amalfitaine en train',
    category: 'GUIDE',
    date: '10 août 2026',
    image: '/images/treno-costiera-hero.webp',
    imageAlt: 'La côte amalfitaine en train',
    path: '/fr-fr/blog/cote-amalfitaine-en-train/'
  },
  {
    title: 'Où atterrir pour la côte amalfitaine',
    category: 'GUIDE',
    date: '5 août 2026',
    image: '/images/aeroporti-costiera-hero.webp',
    imageAlt: 'Aéroports pour la côte amalfitaine',
    path: '/fr-fr/blog/ou-atterrir-cote-amalfitaine/'
  }
];

const imageCredit = {
  author: 'philip.mallis / Wikimedia Commons',
  sourceUrl: 'https://commons.wikimedia.org/wiki/File:Trenitalia_Frecciarossa_ETR400_(Frecciarossa_1000)_trains_at_Napoli_Centrale_Railway_Station_in_Naples,_Italy.jpg',
  license: 'CC BY-SA 2.0',
  licenseUrl: 'https://creativecommons.org/licenses/by-sa/2.0/',
};

const keyTakeaways = [
  "Il n'existe aucun train direct. De Paris à la côte amalfitaine, ce sont trois étapes, 13 à 14 heures de trajet, et cela fonctionne bien mieux réparti sur deux jours.",
  'De Paris Gare de Lyon à Milan Centrale, comptez environ 7 heures, avec deux allers-retours par jour assurés par SNCF TGV Inoui et Trenitalia Frecciarossa.',
  'Milan-Naples est la partie facile : environ 4 heures 30 en Frecciarossa, avec des départs tout au long de la journée.',
  "Les portes ferroviaires de la côte sont Salerne et Sorrente. Ni Positano ni Amalfi n'ont de gare, et n'en auront jamais.",
  "Le Venice Simplon-Orient-Express vend désormais un voyage Paris-côte amalfitaine, mais c'est un séjour de trois nuits qui se termine dans un hôtel de Ravello, pas un moyen de s'y rendre.",
];
---

<BlogPostLayout
  lang={lang}
  post={post}
  metaTitle={metaTitle}
  metaDescription={metaDescription}
  breadcrumbs={breadcrumbs}
  quickInfo={quickInfo}
  faq={faq}
  sidebarLinks={sidebarLinks}
  authorRole={authorRole}
  relatedArticles={relatedArticles}
  imageCredit={imageCredit}
  pageKey="paris-to-amalfi-coast-train"
>

  <!-- Points Clés -->
  <div class="bg-slate-900 text-white p-8 rounded-[2rem]">
    <div class="flex items-center gap-3 mb-6">
      <svg class="w-5 h-5 text-med-gold flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
      <h2 class="font-serif text-lg font-bold text-med-gold uppercase tracking-[0.15em]">Points Clés</h2>
    </div>
    <ul class="space-y-4">
      {keyTakeaways.map((point) => (
        <li class="flex items-start gap-3">
          <span class="w-1.5 h-1.5 rounded-full bg-med-gold flex-shrink-0 mt-2"></span>
          <span class="text-white/80 text-xs sm:text-sm leading-relaxed">{point}</span>
        </li>
      ))}
    </ul>
  </div>

  <!-- Intro -->
  <div>
    <p class="text-slate-600 text-xl leading-relaxed mb-6 font-light">
      Derrière la formule "de Paris à la côte amalfitaine en train" se cachent aujourd'hui deux voyages très différents. L'un est une succession de trains à grande vitesse ordinaires qui vous conduit de la gare de Lyon à un hôtel au-dessus de la mer pour le prix d'un vol, dans le temps qu'il faut pour lire un long roman. L'autre est une voiture-lit qui coûte le prix d'une petite voiture et fait du trajet lui-même les vacances. Les deux méritent d'être connus, mais ce dont la plupart des gens ont besoin, ce sont les détails pratiques du premier.
    </p>
  </div>

  <!-- Les trois étapes -->
  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">L'itinéraire régulier : trois étapes</h2>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      Puisque aucune ligne n'atteint les villages de la côte, tout voyage ferroviaire depuis la France se termine à <strong>Salerne</strong> ou à <strong>Sorrente</strong>, et le dernier tronçon se fait en ferry, en bus ou en voiture. La combinaison ci-dessous est la plus rapide parmi les fiables.
    </p>

    <div class="overflow-x-auto rounded-[2rem] border border-slate-100 shadow-sm">
      <table class="w-full text-xs sm:text-sm">
        <thead class="bg-slate-900 text-white">
          <tr>
            <th class="text-left p-5 font-serif font-bold text-med-gold">Étape</th>
            <th class="text-left p-5 font-serif font-bold text-med-gold">Service</th>
            <th class="text-left p-5 font-serif font-bold text-med-gold">Durée</th>
          </tr>
        </thead>
        <tbody class="bg-white">
          <tr class="border-b border-slate-100">
            <td class="p-5 font-bold">Paris Gare de Lyon - Milan Centrale</td>
            <td class="p-5 text-slate-600">TGV Inoui ou Frecciarossa, via Lyon, Chambéry, Modane et Turin. Deux allers-retours par jour.</td>
            <td class="p-5 text-slate-600">Environ 7h</td>
          </tr>
          <tr class="border-b border-slate-100">
            <td class="p-5 font-bold">Milan Centrale - Naples Centrale</td>
            <td class="p-5 text-slate-600">Frecciarossa ou Italo, fréquents dans la journée, via Bologne, Florence et Rome.</td>
            <td class="p-5 text-slate-600">Environ 4h30</td>
          </tr>
          <tr class="border-b border-slate-100">
            <td class="p-5 font-bold">Naples - Salerne</td>
            <td class="p-5 text-slate-600">Les trains à grande vitesse continuent vers le sud ; les régionaux sont plus lents mais moins chers.</td>
            <td class="p-5 text-slate-600">35 min à 1h15</td>
          </tr>
          <tr>
            <td class="p-5 font-bold">Naples - Sorrente</td>
            <td class="p-5 text-slate-600">Circumvesuviana ou Campania Express depuis Napoli Porta Nolana ou Garibaldi.</td>
            <td class="p-5 text-slate-600">Environ 1h</td>
          </tr>
        </tbody>
      </table>
    </div>

    <p class="text-slate-600 text-lg leading-relaxed mt-6">
      Ajoutez les trajets entre les quais à Milan et à Naples et vous arrivez à 13 à 15 heures de porte à porte. Ce qui se passe après Salerne ou Sorrente est détaillé dans notre guide de <a href="/fr-fr/blog/cote-amalfitaine-en-train/" class="text-med-blue hover:underline">la côte amalfitaine en train</a>.
    </p>
  </div>

  <!-- Suisse -->
  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">L'alternative suisse, et quand elle devient nécessaire</h2>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      La traversée alpine entre la France et l'Italie est le maillon fragile de ce voyage. Un éboulement dans la vallée de la Maurienne a coupé la ligne fin août 2023 et l'a tenue fermée un an et demi, jusqu'à sa réouverture le <strong>31 mars 2025</strong>. Des travaux dans le tunnel du Mont-Cenis ont ensuite de nouveau suspendu les directs Paris-Milan, du <strong>11 septembre au 9 octobre 2026</strong>, la liaison directe reprenant à partir du 10 octobre 2026.
    </p>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      Chaque fois que cela arrive, le détour passe par la Suisse : Paris-Bâle en TGV Lyria en trois heures environ, puis un EuroCity par le Gothard jusqu'à Milan. C'est plus long, généralement de deux heures, mais c'est un beau trajet et tout le voyage reste sur rail. Cela vaut la peine de vérifier avant de réserver même une année normale, car ce corridor tombe plus souvent que d'autres.
    </p>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div class="bg-white p-6 rounded-[2rem] border border-slate-100 shadow-sm">
        <h4 class="font-bold text-slate-900 mb-2">Réservez tôt l'étape française</h4>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Avec seulement deux allers-retours quotidiens sur le direct Paris-Milan, les tarifs bas disparaissent vite. Les billets ouvrent en général quatre à six mois à l'avance et les meilleurs prix partent dans les premières semaines.</p>
      </div>
      <div class="bg-white p-6 rounded-[2rem] border border-slate-100 shadow-sm">
        <h4 class="font-bold text-slate-900 mb-2">Achetez les étapes italiennes à part</h4>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Il n'existe pas de billet unique : une correspondance ratée est votre problème, pas celui du chemin de fer. Prévoyez une large marge à Milan et traitez Milan-Naples comme un achat séparé.</p>
      </div>
    </div>
  </div>

  <!-- Où couper -->
  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">Où couper le voyage</h2>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      Le faire en une journée, c'est partir de Paris à l'aube et arriver sur la côte à la nuit tombée, une bien mauvaise façon de découvrir un lieu dont tout l'intérêt est le panorama. Une nuit d'étape change complètement le voyage.
    </p>

    <div class="bg-white p-8 rounded-[2rem] border border-slate-100 shadow-sm">
      <h3 class="font-serif text-xl font-bold text-slate-900 mb-5">Trois escales sensées</h3>
      <div class="space-y-3">
        <div class="flex items-start gap-3">
          <div class="w-6 h-6 rounded-full bg-med-gold/15 flex-shrink-0 flex items-center justify-center text-med-gold font-bold text-xs">1</div>
          <p class="text-slate-600 text-xs sm:text-sm leading-relaxed"><strong>Milan.</strong> L'évidence : vous arrivez en début de soirée, avec des hôtels à côté de Centrale, et vous repartez le lendemain matin avec encore quatre heures et demie devant vous. Simple, à défaut d'être exaltant.</p>
        </div>
        <div class="flex items-start gap-3">
          <div class="w-6 h-6 rounded-full bg-med-gold/15 flex-shrink-0 flex items-center justify-center text-med-gold font-bold text-xs">2</div>
          <p class="text-slate-600 text-xs sm:text-sm leading-relaxed"><strong>Rome.</strong> Le meilleur compromis. À environ neuf heures de Paris, il ne reste guère plus d'une heure jusqu'à Naples le lendemain : vous atteignez la côte vers midi et il vous reste un après-midi.</p>
        </div>
        <div class="flex items-start gap-3">
          <div class="w-6 h-6 rounded-full bg-med-gold/15 flex-shrink-0 flex items-center justify-center text-med-gold font-bold text-xs">3</div>
          <p class="text-slate-600 text-xs sm:text-sm leading-relaxed"><strong>Naples.</strong> Aller jusqu'au bout et dormir près de Centrale, puis prendre le premier bateau ou le premier train au matin. Cela marche, et vous offre une soirée à Naples, ce qui n'est pas une punition.</p>
        </div>
      </div>
    </div>
  </div>

  <!-- Orient-Express -->
  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">La version Orient-Express</h2>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      En 2026, Belmond a lancé le <strong>Venice Simplon-Orient-Express</strong> sur un nouvel itinéraire de Paris à la côte amalfitaine, et c'est bien pour cela que la recherche s'est envolée. Ce n'est pas un transport. C'est un forfait de trois nuits : une nuit en cabine à bord pendant que le train traverse la France et longe les deux Rivieras, une visite guidée privée de Pompéi, puis deux nuits au Caruso, l'hôtel de Belmond installé dans un palais du onzième siècle au-dessus de <a href="/fr-fr/cote-amalfitaine/ravello/" class="text-med-blue hover:underline">Ravello</a>.
    </p>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      Le départ inaugural a quitté Paris à 11h00 le 4 mai 2026 et est arrivé à Pompéi le 7 mai. Il a affiché complet, et d'autres départs ont été programmés pour 2027, dont un fin avril et un en juin. Les prix démarrent autour de <strong>9 900 euros par personne</strong> en cabine historique pour deux, repas, boissons, excursions et transfert final vers Naples compris.
    </p>

    <blockquote class="border-l-4 border-med-gold pl-6 my-8">
      <p class="text-slate-700 text-xl font-serif italic leading-relaxed">
        "L'un de ces voyages est un moyen d'atteindre la côte amalfitaine. L'autre est une raison de partir."
      </p>
    </blockquote>

    <p class="text-slate-600 text-lg leading-relaxed">
      Il vaut mieux être clair sur ce que l'on achète : l'Orient-Express se termine à Ravello et inclut deux nuits d'hôtel, il remplace donc la première partie de vacances plutôt qu'un billet d'avion. Si l'objectif est simplement d'arriver sans prendre l'avion, l'itinéraire régulier décrit plus haut fait la même chose pour une fraction minuscule du prix.
    </p>
  </div>

  <!-- Conseils -->
  <div class="bg-white p-8 rounded-[2rem] shadow-xl border border-slate-100">
    <div class="flex items-center gap-4 mb-6">
      <svg class="w-6 h-6 text-med-gold flex-shrink-0" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M9 18h6"/><path d="M10 22h4"/><path d="M15.09 14c.18-.98.65-1.74 1.41-2.5A4.65 4.65 0 0 0 18 8 6 6 0 0 0 6 8c0 1 .23 2.23 1.5 3.5A4.61 4.61 0 0 1 8.91 14"/></svg>
      <h3 class="text-xl font-bold">Les Conseils de l'Expert</h3>
    </div>
    <div class="space-y-6">
      <div>
        <p class="font-bold text-slate-900 mb-1">Choisissez Salerne ou Sorrente avant tout achat</p>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Cela change toute la dernière journée. Salerne vous donne les <a href="/fr-fr/guide/ferries/" class="text-med-blue hover:underline">ferries</a> vers Amalfi et Positano et le <a href="/fr-fr/guide/bus-sita/" class="text-med-blue hover:underline">bus SITA</a> sur la route côtière. Sorrente vous donne la péninsule et Capri. Se tromper ajoute deux heures de retour en arrière.</p>
      </div>
      <div>
        <p class="font-bold text-slate-900 mb-1">Ne prévoyez pas d'arriver après le coucher du soleil</p>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Les ferries s'arrêtent en fin d'après-midi, la route côtière est lente de nuit et la plupart des adresses de Positano finissent par un escalier. Visez le milieu d'après-midi sur la côte, ce qui depuis Paris suppose réalistement une nuit quelque part en Italie.</p>
      </div>
      <div>
        <p class="font-bold text-slate-900 mb-1">Voyagez léger pour la dernière étape</p>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">La Circumvesuviana vers Sorrente est une ligne de banlieue sans porte-bagages et souvent sans place assise. Le Campania Express est la version touristique du même parcours, avec place garantie et moins d'arrêts, et le supplément vaut la peine au bout d'une longue journée.</p>
      </div>
      <div>
        <p class="font-bold text-slate-900 mb-1">Comparez honnêtement avec l'avion</p>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Paris-Naples en avion dure environ deux heures. Le train gagne sur le confort, la logique centre à centre et les émissions, et perd nettement sur le temps. Notre guide sur <a href="/fr-fr/blog/ou-atterrir-cote-amalfitaine/" class="text-med-blue hover:underline">où atterrir</a> présente l'alternative.</p>
      </div>
    </div>
  </div>

</BlogPostLayout>
