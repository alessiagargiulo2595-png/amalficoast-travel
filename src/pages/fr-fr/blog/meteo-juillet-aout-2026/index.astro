---
import BlogPostLayout from '../../../../layouts/BlogPostLayout.astro';

const lang = 'fr-fr';
const post = {
  title: 'Météo Côte Amalfitaine Juillet et Août 2026',
  subtitle: 'Positano et Amalfi en été : températures, relief, kit de survie et les trois meteo hacks pour ne pas perdre la tête',
  category: 'GUIDE',
  date: '6 juillet 2026',
  readTime: '8 min',
  image: '/images/meteo-costiera-luglio-agosto-hero.webp',
  imageAlt: 'Vue panoramique de Positano sur la Côte Amalfitaine en été',
  path: '/fr-fr/blog/meteo-juillet-aout-2026/',
};

const metaTitle = 'Météo Côte Amalfitaine Juillet Août 2026 | Positano et Amalfi';
const metaDescription = "Juillet 31°C, août 32°C avec 66% d'humidité. Comment fonctionne le microclimat de la Côte, quelles plages passent à l'ombre dès 15h30, quoi mettre dans la valise et 3 meteo hacks pour Positano et Amalfi.";

const breadcrumbs = [
  { name: 'Accueil', url: '/fr-fr/' },
  { name: 'Blog', url: '/fr-fr/blog/' },
  { name: 'Météo Juillet et Août 2026', url: '/fr-fr/blog/meteo-juillet-aout-2026/' },
];

const quickInfo = [
  { label: 'Maximale moyenne juillet', value: '31°C (pics 34°C)' },
  { label: 'Maximale moyenne août', value: '32°C (humidité 66%)' },
  { label: 'Minimale nocturne', value: '22-23°C' },
  { label: 'Température mer', value: '25°C juil., 27°C août' },
  { label: 'Heures de soleil', value: '10-11 par jour' },
  { label: 'Indice UV', value: '9-10 (très élevé)' },
  { label: 'Risque de pluie', value: "Rares orages de chaleur fin août" },
  { label: 'Vent local', value: '"Faugn", brise chaude du soir' },
];

const faq = [
  {
    q: 'Fait-il plus chaud en juillet ou en août sur la Côte Amalfitaine ?',
    a: "En août. Juillet affiche une moyenne de 31°C avec un air plus sec, tandis qu'août se stabilise à 32-33°C avec 66-70% d'humidité et une roche calcaire qui accumule la chaleur depuis des semaines. Le ressenti, surtout dans les ruelles étroites d'Amalfi et d'Atrani, est nettement plus lourd en août.",
  },
  {
    q: "À quelle heure la plage d'Amalfi passe-t-elle à l'ombre ?",
    a: "Les plages d'Amalfi, Atrani et Minori sont orientées sud-est : le soleil disparaît derrière la montagne vers 15h30-16h00 en plein été. Idéal pour un rafraîchissement l'après-midi, mais dommage si vous voulez rester au soleil jusqu'au coucher. Dans ce cas, direction Positano ou Praiano (Gavitella), qui restent éclairées jusqu'à 19h30-20h00.",
  },
  {
    q: "Ai-je vraiment besoin d'un SPF 50 même si je bronze facilement ?",
    a: "Oui, toujours. L'indice UV atteint 9-10 en juillet et août, et les falaises calcaires blanches réfléchissent la lumière comme un miroir. La réverbération est plus agressive qu'une plage italienne moyenne : SPF 50, chapeau à large bord et lunettes polarisées sont les trois alliés qui sauvent votre première journée.",
  },
  {
    q: "Quand la mer est-elle la plus chaude, juillet ou août ?",
    a: "En août. En juillet, l'eau oscille autour de 25°C, parfaite pour de longues baignades. En août, elle culmine à 27°C, pratiquement une piscine chauffée, avec une visibilité sous-marine exceptionnelle les jours de calme plat.",
  },
  {
    q: 'Pleut-il en août sur la Côte Amalfitaine ?',
    a: "Très rarement. Août compte en moyenne 3 jours avec précipitations, presque toujours des orages de chaleur en fin d'après-midi qui durent 20-30 minutes, rafraîchissent l'air et laissent des ciels spectaculaires. Ils gâchent rarement une journée entière, mais gardez un œil sur le radar à partir de 17h00.",
  },
  {
    q: "Comment s'habiller sur la Côte en plein été ?",
    a: "Tissus naturels et légers : lin, coton, soie. Évitez les synthétiques qui augmentent la transpiration. Pour marcher, portez des sandales à semelle en caoutchouc ou des tennis en toile avec un bon grip : les marches en calcaire et les pavés de Positano deviennent glissants avec le mélange chaleur et sel marin. Laissez les talons à l'hôtel.",
  },
  {
    q: "Vaut-il mieux se déplacer en bus ou en ferry entre juillet et août ?",
    a: "Ferry, sans hésitation. Prendre le bus SITA entre 11h00 et 15h00 en plein été signifie attendre en plein soleil avec le trafic bloqué. Les ferries Travelmar coûtent plus cher, mais la brise marine transforme le trajet en une croisière panoramique ventilée. Le tronçon Salerne-Amalfi-Positano se parcourt en 60 à 70 minutes environ.",
  },
  {
    q: "Qu'est-ce que le 'Faugn' de la Côte Amalfitaine ?",
    a: "C'est le nom local d'une brise chaude et sèche qui descend des montagnes la nuit, typique des soirées d'été. Il arrive qu'à 23h00 une bouffée d'air tiède surgisse, surtout lors des sorties en bateau au clair de lune ou sur les terrasses les plus hautes. Emportez toujours une chemise légère à manches longues pour les excursions du soir en mer.",
  },
  {
    q: 'Ravello est-elle vraiment plus fraîche que la côte ?',
    a: "Oui. À 365 mètres d'altitude, Ravello enregistre constamment 3 à 4°C de moins qu'Amalfi ou Positano, avec une ventilation sèche qui régénère. C'est la parenthèse parfaite loin de la chaleur des plages, surtout lors des journées les plus lourdes de fin août.",
  },
  {
    q: 'Quelle est la plage la plus ensoleillée de la Côte Amalfitaine ?',
    a: "La Gavitella à Praiano. Exposée à l'ouest, elle reçoit la lumière directe jusqu'à 19h30-20h00 et voit le soleil se coucher droit dans la mer face à Capri : c'est la seule plage de la Côte où l'on peut prendre l'apéritif en maillot pendant que le soleil plonge sur l'horizon marin.",
  },
];

const sidebarLinks = [
  { label: 'Positano', href: '/fr-fr/cote-amalfitaine/positano/' },
  { label: 'Amalfi', href: '/fr-fr/cote-amalfitaine/amalfi/' },
  { label: 'Praiano', href: '/fr-fr/cote-amalfitaine/praiano/' },
  { label: 'Ravello', href: '/fr-fr/cote-amalfitaine/ravello/' },
  { label: 'Plages de la Côte Amalfitaine', href: '/fr-fr/plages/' },
];

const authorRole = 'Rédaction locale · Côte Amalfitaine';

const relatedArticles = [
  {
    title: 'Heure Dorée Couchers de Soleil',
    category: 'DÉCOUVERTES',
    date: '2 mai 2026',
    image: '/images/tramonto-costiera.webp',
    imageAlt: 'Coucher de soleil sur la plage de la Côte Amalfitaine',
    path: '/fr-fr/blog/coucher-soleil-plages/'
  },
  {
    title: 'Plages Confortables et Équipées',
    category: 'GUIDE',
    date: '18 avril 2026',
    image: '/images/spiagge-bambini.webp',
    imageAlt: 'Plages confortables et équipées de la Côte Amalfitaine',
    path: '/fr-fr/blog/plages-confortables-equipees/'
  }
];

const keyTakeaways = [
  "Juillet affiche 31°C en moyenne avec un air sec et une mer à 25°C : le mois parfait pour bronzer. Août grimpe à 32-33°C avec 66-70% d'humidité et une mer à 27°C.",
  "Les plages d'Amalfi, Atrani et Minori passent à l'ombre entre 15h30 et 16h00 ; Positano, Praiano et la Gavitella restent ensoleillées jusqu'au soir.",
  "Ravello, à 365 mètres d'altitude, affiche toujours 3 à 4°C de moins que la côte : l'échappée régénérante des journées lourdes.",
  "Fin août apporte de rares orages de chaleur en fin d'après-midi : 20-30 minutes qui rafraîchissent l'air et laissent des ciels spectaculaires.",
  "En haute saison, les ferries Travelmar battent les bus SITA sur tous les fronts : plus rapides, ventilés et sans risque d'attente en plein soleil.",
];
---

<BlogPostLayout
  lang={lang}
  post={post}
  metaTitle={metaTitle}
  metaDescription={metaDescription}
  breadcrumbs={breadcrumbs}
  quickInfo={quickInfo}
  faq={faq}
  sidebarLinks={sidebarLinks}
  authorRole={authorRole}
  relatedArticles={relatedArticles}
  pageKey="meteo-juillet-aout-2026"
>

  <!-- Key Takeaways -->
  <div class="bg-slate-900 text-white p-8 rounded-[2rem]">
    <h2 class="font-serif text-lg font-bold text-med-gold uppercase tracking-[0.15em] mb-6">Key Takeaways</h2>
    <ul class="space-y-4">
      {keyTakeaways.map((point) => (
        <li class="flex items-start gap-3">
          <span class="w-1.5 h-1.5 rounded-full bg-med-gold flex-shrink-0 mt-2"></span>
          <span class="text-white/80 text-xs sm:text-sm leading-relaxed">{point}</span>
        </li>
      ))}
    </ul>
  </div>

  <!-- Intro -->
  <div>
    <p class="text-slate-600 text-xl leading-relaxed mb-6 font-light">
      En ce moment même, l'été 2026 bat son plein et <a href="/fr-fr/cote-amalfitaine/positano/" class="text-med-blue hover:underline">Positano</a> et <a href="/fr-fr/cote-amalfitaine/amalfi/" class="text-med-blue hover:underline">Amalfi</a> sont littéralement le centre du monde. Juillet et août riment avec mer cristalline, couchers de soleil infinis et Dolce Vita. Mais cela signifie aussi températures élevées, soleil de plomb et logistique intense.
    </p>
    <p class="text-slate-600 text-lg leading-relaxed">
      La <a href="/fr-fr/cote-amalfitaine/" class="text-med-blue hover:underline">Côte</a> possède un microclimat unique : les monts Lattari bloquent les vents du nord, créant une barrière thermique, tandis que la mer se transforme en piscine chauffée. Voici comment décrypter la météo et organiser vos journées pour éviter les pics de chaleur et vivre le voyage d'une vie.
    </p>
  </div>

  <!-- Bulletin Thermique -->
  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">Le Bulletin Thermique : Ce Qui Vous Attend Vraiment</h2>
    <p class="text-slate-600 text-lg leading-relaxed mb-8">
      Soyons clairs : il fait chaud pendant ces deux mois. Mais la chaleur varie d'un mois à l'autre.
    </p>

    <div class="bg-white p-8 rounded-[2rem] border border-slate-100 shadow-sm mb-6">
      <p class="text-med-gold text-xs font-medium uppercase tracking-[0.25em] mb-3">Juillet</p>
      <h3 class="font-serif text-2xl font-bold text-slate-900 mb-4">Soleil de Plomb et Chaleur Sèche</h3>
      <p class="text-slate-600 text-lg leading-relaxed mb-5">
        Le mois parfait pour les amoureux du bronzage. Les journées offrent jusqu'à 15 heures de lumière et l'humidité reste contenue.
      </p>
      <ul class="space-y-4">
        <li class="flex items-start gap-3">
          <span class="w-1.5 h-1.5 rounded-full bg-med-gold flex-shrink-0 mt-2"></span>
          <span class="text-slate-600 text-xs sm:text-sm leading-relaxed"><strong>Les températures.</strong> En journée, la moyenne est de 31°C, mais en cas d'anticyclone africain, on atteint vite 34°C.</span>
        </li>
        <li class="flex items-start gap-3">
          <span class="w-1.5 h-1.5 rounded-full bg-med-gold flex-shrink-0 mt-2"></span>
          <span class="text-slate-600 text-xs sm:text-sm leading-relaxed"><strong>Le soir.</strong> Le thermomètre descend autour de 22°C. La brise marine rafraîchit l'air juste assez pour dîner en terrasse.</span>
        </li>
        <li class="flex items-start gap-3">
          <span class="w-1.5 h-1.5 rounded-full bg-med-gold flex-shrink-0 mt-2"></span>
          <span class="text-slate-600 text-xs sm:text-sm leading-relaxed"><strong>La mer.</strong> Une eau splendide à 25°C. Idéale pour des heures de baignade sans avoir froid en sortant.</span>
        </li>
      </ul>
    </div>

    <div class="bg-white p-8 rounded-[2rem] border border-slate-100 shadow-sm">
      <p class="text-med-gold text-xs font-medium uppercase tracking-[0.25em] mb-3">Août</p>
      <h3 class="font-serif text-2xl font-bold text-slate-900 mb-4">Le Pic de Chaleur (et de Moiteur)</h3>
      <p class="text-slate-600 text-lg leading-relaxed mb-5">
        En août, la chaleur accumulée par les falaises calcaires se fait sentir et l'humidité monte à 65-70%.
      </p>
      <ul class="space-y-4">
        <li class="flex items-start gap-3">
          <span class="w-1.5 h-1.5 rounded-full bg-med-gold flex-shrink-0 mt-2"></span>
          <span class="text-slate-600 text-xs sm:text-sm leading-relaxed"><strong>Les températures.</strong> Le mercure se stabilise à 32-33°C, mais le ressenti est plus lourd qu'en juillet, surtout dans les ruelles étroites.</span>
        </li>
        <li class="flex items-start gap-3">
          <span class="w-1.5 h-1.5 rounded-full bg-med-gold flex-shrink-0 mt-2"></span>
          <span class="text-slate-600 text-xs sm:text-sm leading-relaxed"><strong>Les orages d'été.</strong> Fin août, l'air brûlant rencontre la mer chaude. Le résultat ? De brefs mais intenses orages de chaleur en fin d'après-midi. Ils durent 20 minutes, rafraîchissent l'atmosphère et offrent des ciels incroyables.</span>
        </li>
        <li class="flex items-start gap-3">
          <span class="w-1.5 h-1.5 rounded-full bg-med-gold flex-shrink-0 mt-2"></span>
          <span class="text-slate-600 text-xs sm:text-sm leading-relaxed"><strong>La mer.</strong> Elle atteint son maximum annuel à 27°C. Une vraie baignoire thermale.</span>
        </li>
      </ul>
    </div>
  </div>

  <!-- Piège de l'ombre -->
  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">Le Piège de l'Ombre : Quand le Relief Change Vos Plans</h2>
    <p class="text-slate-600 text-lg leading-relaxed mb-8">
      C'est l'erreur classique de débutant qui gâche une journée de plage. Les montagnes de la Côte tombent à pic dans la mer et bloquent la lumière plus tôt qu'on ne le pense. Chaque tronçon de côte a son propre horaire d'ombre.
    </p>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
      <div class="bg-white p-6 rounded-[2rem] border border-slate-100 shadow-sm">
        <p class="text-med-gold text-xs font-medium uppercase tracking-[0.2em] mb-2">Amalfi · Atrani · Minori</p>
        <h4 class="font-bold text-slate-900 mb-2 text-lg">Soleil le matin, ombre après 15h30</h4>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Ces plages sont exposées sud-est. Le soleil est magnifique le matin, mais vers 15h30-16h00, il passe derrière la montagne et la plage se retrouve à l'ombre. Idéal si vous fuyez la canicule, dommage si vous vouliez prendre l'apéritif au soleil.</p>
      </div>
      <div class="bg-white p-6 rounded-[2rem] border border-slate-100 shadow-sm">
        <p class="text-med-gold text-xs font-medium uppercase tracking-[0.2em] mb-2">Positano · Praiano</p>
        <h4 class="font-bold text-slate-900 mb-2 text-lg">Soleil jusqu'au soir, le paradis Gavitella</h4>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Ici, c'est le versant opposé. Le soleil embrasse cette côte jusqu'au soir. À Praiano, plus précisément sur la plage de la Gavitella, on trouve le soleil le plus long de la Côte : on peut rester en maillot jusqu'à 20h00 et voir le soleil plonger dans la mer face à Capri.</p>
      </div>
      <div class="bg-white p-6 rounded-[2rem] border border-slate-100 shadow-sm">
        <p class="text-med-gold text-xs font-medium uppercase tracking-[0.2em] mb-2">Ravello</p>
        <h4 class="font-bold text-slate-900 mb-2 text-lg">Si vous étouffez, montez</h4>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">À 365 mètres d'altitude, <a href="/fr-fr/cote-amalfitaine/ravello/" class="text-med-blue hover:underline">Ravello</a> affiche toujours 3 à 4°C de moins qu'en bas, avec une brise sèche salvatrice. L'échappée régénérante des journées lourdes.</p>
      </div>
    </div>
  </div>

  <!-- Valise & Kit -->
  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">Valise et Kit de Survie pour la Côte</h2>
    <p class="text-slate-600 text-lg leading-relaxed mb-8">
      Marcher sur la Côte en août n'a rien d'une promenade plate à Miami. C'est un entraînement vertical, et chaque choix vestimentaire compte.
    </p>

    <div class="bg-white p-8 rounded-[2rem] border border-slate-100 shadow-sm">
      <div class="space-y-6">
        <div>
          <p class="font-bold text-slate-900 mb-2 text-lg">Le drame des chaussures</p>
          <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Laissez les talons à l'hôtel et oubliez les tongs en plastique bon marché pour marcher. Les marches en calcaire et les pavés en pierre volcanique (surtout à Positano) deviennent glissants avec le combo chaleur et sel marin. Optez pour des sandales plates avec semelle en caoutchouc ou des tennis en toile adhérentes.</p>
        </div>
        <div class="border-t border-slate-100 pt-6">
          <p class="font-bold text-slate-900 mb-2 text-lg">Le lin, encore le lin</p>
          <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Les tissus synthétiques vous feront transpirer deux fois plus. Choisissez des chemises, robes et pantalons amples en lin ou en coton léger. La soie est excellente pour le soir. Évitez les jeans serrés et les polos moulants : la Côte vit d'élégance décontractée, pas de vêtements contraignants.</p>
        </div>
        <div class="border-t border-slate-100 pt-6">
          <p class="font-bold text-slate-900 mb-2 text-lg">La réverbération assassine</p>
          <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Les roches blanches de la Côte reflètent la lumière comme un miroir. L'indice UV frôle un dangereux 9/10. Lunettes de soleil polarisées, chapeau à large bord et crème solaire SPF 50 sont non négociables si vous ne voulez pas finir comme une écrevisse dès le premier jour.</p>
        </div>
      </div>
    </div>
  </div>

  <!-- 3 Meteo Hacks -->
  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">Les 3 Meteo Hacks de l'Expert pour Ne Pas Perdre la Tête</h2>
    <p class="text-slate-600 text-lg leading-relaxed mb-8">
      Trois astuces de local qui font la différence entre des vacances subies et des vacances vécues.
    </p>

    <div class="space-y-4">
      <div class="bg-white p-6 rounded-[2rem] border border-slate-100 shadow-sm">
        <div class="flex items-start gap-4">
          <div class="w-8 h-8 rounded-full bg-med-gold/15 flex-shrink-0 flex items-center justify-center text-med-gold font-serif font-bold">1</div>
          <div>
            <h4 class="font-bold text-slate-900 mb-2 text-lg">Bannissez les bus aux heures de pointe</h4>
            <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Prendre le <a href="/fr-fr/guide/bus-sita/" class="text-med-blue hover:underline">bus SITA</a> entre 11h00 et 15h00 en août est un sport extrême. Vous attendrez en plein soleil et subirez des embouteillages monstres. Utilisez les <a href="/fr-fr/guide/ferries/" class="text-med-blue hover:underline">ferries Travelmar</a>. Plus chers, mais la brise marine transforme le trajet en une croisière panoramique rafraîchissante.</p>
          </div>
        </div>
      </div>
      <div class="bg-white p-6 rounded-[2rem] border border-slate-100 shadow-sm">
        <div class="flex items-start gap-4">
          <div class="w-8 h-8 rounded-full bg-med-gold/15 flex-shrink-0 flex items-center justify-center text-med-gold font-serif font-bold">2</div>
          <div>
            <h4 class="font-bold text-slate-900 mb-2 text-lg">Le "Faugn" du soir</h4>
            <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">C'est le nom local de la brise chaude qui descend des montagnes la nuit. Il arrive qu'à 23h00 un coup de vent chaud et sec se lève. Pensez-y pour les sorties en bateau au clair de lune : prévoyez toujours une chemise légère à manches longues.</p>
          </div>
        </div>
      </div>
      <div class="bg-white p-6 rounded-[2rem] border border-slate-100 shadow-sm">
        <div class="flex items-start gap-4">
          <div class="w-8 h-8 rounded-full bg-med-gold/15 flex-shrink-0 flex items-center justify-center text-med-gold font-serif font-bold">3</div>
          <div>
            <h4 class="font-bold text-slate-900 mb-2 text-lg">Granité tactique</h4>
            <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Quand la chaleur vous assomme, cherchez les petits kiosques de rue qui préparent des granités minute avec les vrais citrons Sfusati d'Amalfi IGP. Ce n'est pas un cliché Instagram, c'est le seul vrai remède local pour faire remonter la tension et contrer la déshydratation des escaliers.</p>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- L'Été en Chiffres -->
  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">L'Été en Chiffres</h2>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      Pour les amateurs de données propres, voici la synthèse de juillet et août 2026 sur la Côte Amalfitaine.
    </p>

    <div class="overflow-hidden rounded-[2rem] border border-slate-100 shadow-sm">
      <table class="w-full text-xs sm:text-sm">
        <thead class="bg-slate-900 text-white">
          <tr>
            <th class="text-left p-5 font-serif font-bold text-med-gold">Indicateur météo</th>
            <th class="text-left p-5 font-serif font-bold text-med-gold">Juillet</th>
            <th class="text-left p-5 font-serif font-bold text-med-gold">Août</th>
          </tr>
        </thead>
        <tbody class="bg-white">
          <tr class="border-b border-slate-100">
            <td class="p-5 font-bold">Maximale moyenne diurne</td>
            <td class="p-5 text-slate-600">31°C</td>
            <td class="p-5 text-slate-600">32°C</td>
          </tr>
          <tr class="border-b border-slate-100">
            <td class="p-5 font-bold">Minimale moyenne nocturne</td>
            <td class="p-5 text-slate-600">22°C</td>
            <td class="p-5 text-slate-600">23°C</td>
          </tr>
          <tr class="border-b border-slate-100">
            <td class="p-5 font-bold">Température de la mer</td>
            <td class="p-5 text-slate-600">25°C (fraîche)</td>
            <td class="p-5 text-slate-600">27°C (chaude)</td>
          </tr>
