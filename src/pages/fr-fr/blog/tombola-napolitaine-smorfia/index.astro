---
import BlogPostLayout from '../../../../layouts/BlogPostLayout.astro';

const lang = 'fr-fr';
const post = {
  title: 'Tombola napolitaine et smorfia : ce que veulent dire les numéros',
  subtitle: "Le jeu de Noël de toutes les familles de Campanie, comment il fonctionne, et pourquoi le 47 est un mort, le 48 un mort qui parle et le 71 quelqu'un qu'on préfère ne pas croiser",
  category: 'DÉCOUVERTES',
  date: '19 novembre 2026',
  readTime: '11 min',
  image: '/images/tombola-numeri-hero.webp',
  imageAlt: "Pions en bois de la tombola avec le 31 et le 73 en rouge",
  path: '/fr-fr/blog/tombola-napolitaine-smorfia/',
};

const metaTitle = 'Tombola napolitaine et smorfia : le sens des numéros';
const metaDescription = "Comment se joue la tombola napolitaine à Noël et ce que signifient les numéros de la smorfia : 33, 47, 48, 71, 77, 90 et d'autres, en napolitain et traduits.";

const breadcrumbs = [
  { name: 'Accueil', url: '/fr-fr/' },
  { name: 'Blog', url: '/fr-fr/blog/' },
  { name: 'Tombola napolitaine et smorfia', url: '/fr-fr/blog/tombola-napolitaine-smorfia/' },
];

const quickInfo = [
  { label: "Ce que c'est", value: 'Un loto familial, proche du bingo' },
  { label: 'Quand', value: 'Les fêtes de Noël' },
  { label: 'Numéros', value: 'De 1 à 90' },
  { label: 'Carton', value: '15 numéros sur 3 lignes' },
  { label: 'Gains', value: 'Ambo, terno, quaterna, cinquina, tombola' },
  { label: 'Le panier', value: 'Panariello' },
  { label: 'La smorfia', value: 'Un sens pour chaque numéro' },
  { label: 'Les plus cités', value: '47, 48, 71, 90' },
];

const faq = [
  {
    q: "Qu'est-ce que la tombola napolitaine ?",
    a: "Un jeu de hasard familial qui se joue pendant les fêtes de Noël. Les numéros de 1 à 90 sont tirés un par un d'un panier et les joueurs les couvrent sur leurs cartons, un peu comme au loto ou au bingo. On gagne en étant le premier à aligner deux, trois, quatre ou cinq numéros sur une même ligne, et le gros lot, la tombola, revient à celui qui remplit le premier tout son carton. À Naples, chaque numéro est annoncé avec son sens dans la smorfia.",
  },
  {
    q: 'Quand joue-t-on à la tombola ?',
    a: "Pendant les fêtes de Noël : après le dîner du réveillon, le jour de Noël, le soir de la Saint-Sylvestre et les soirées plus calmes entre les deux. La tradition la relie à la pause de Noël du lotto, quand les familles se mirent à en jouer une version à la maison.",
  },
  {
    q: 'Que signifie le 71 dans la smorfia ?',
    a: "Le 71, c'est \"L'ommo 'e merda\", littéralement l'homme de merde : une personne qui ne vaut rien, sans dignité ni parole. C'est l'un des numéros vulgaires de la smorfia et l'un des plus cités, parce qu'à table on l'annonce volontiers en regardant un parent bien précis.",
  },
  {
    q: 'Quelle différence entre le 47 et le 48 ?',
    a: "À Naples, le 47 est \"'O muorto\", le mort, et le 48 \"'O muorto che parla\", le mort qui parle, qui en rêve signifie un message d'un défunt. Dans beaucoup d'autres villes italiennes, le mort qui parle est le 47, d'où le titre du film de Totò de 1950, 47 morto che parla.",
  },
  {
    q: 'Pourquoi la peur fait-elle 90 ?',
    a: "Parce que dans la smorfia le 90 est \"'A paura\", la peur. L'expression italienne la paura fa novanta, la peur fait quatre-vingt-dix, en vient directement et s'emploie dans toute l'Italie, y compris par des gens qui n'ont jamais joué à la tombola à Naples.",
  },
  {
    q: "Qu'est-ce que la tombola scostumata ?",
    a: "La version grivoise, appelée aussi tombola vajassa ou tombola dei femminielli. Celui qui tient le panier tire les numéros, annonce leur sens en napolitain et les enchaîne en une histoire improvisée très épicée. Elle était traditionnellement menée par les femminielli des quartiers populaires ; aujourd'hui on la voit surtout comme spectacle de Noël dans les théâtres de Naples.",
  },
];

const sidebarLinks = [
  { label: 'Crèches à Naples et Sorrente', href: '/fr-fr/blog/creches-naples-sorrente/' },
  { label: 'Pâtisseries de Noël napolitaines', href: '/fr-fr/blog/patisseries-noel-napolitaines/' },
  { label: 'Fête des morts et Halloween', href: '/fr-fr/blog/fete-des-morts-halloween/' },
  { label: 'Sorrente', href: '/fr-fr/peninsule-sorrentine/sorrente/' },
];

const authorRole = 'Spécialiste Péninsule Sorrentine';

const relatedArticles = [
  {
    title: 'Crèches à Naples et Sorrente : guide pour décembre',
    category: 'GUIDE',
    date: '10 novembre 2026',
    image: '/images/presepe-natale-hero.webp',
    imageAlt: 'Crèche à Naples',
    path: '/fr-fr/blog/creches-naples-sorrente/'
  },
  {
    title: 'Pâtisseries de Noël napolitaines',
    category: 'GASTRONOMIE',
    date: '14 novembre 2026',
    image: '/images/struffoli-hero.webp',
    imageAlt: 'Struffoli, la douceur de Noël napolitaine',
    path: '/fr-fr/blog/patisseries-noel-napolitaines/'
  }
];

const keyTakeaways = [
  "La tombola napolitaine est un loto familial avec les numéros de 1 à 90, joué pendant les fêtes de Noël.",
  "La tradition la fait naître à Naples en 1734, quand le lotto fut suspendu pour Noël et que les familles se mirent à tirer les numéros chez elles.",
  "On gagne avec l'ambo, le terno, la quaterna et la cinquina (de deux à cinq numéros sur une ligne) et avec la tombola, le carton complet.",
  "Chaque numéro est annoncé avec son sens dans la smorfia, le livre des rêves napolitain : 47 est le mort, 48 le mort qui parle, 90 la peur.",
  "Certains sens sont volontairement vulgaires, le 71 en tête, et la version grivoise du jeu, la tombola scostumata, est devenue un spectacle de Noël.",
];

const numbers = [
  { n: 1, nap: "L'Italia", lit: "L'Italie", text: "Le premier numéro revient au pays. Les smorfie plus anciennes lui donnaient d'autres images, mais aujourd'hui chaque tableau porte l'Italie." },
  { n: 10, nap: "'E fasule", lit: "Les haricots", text: "Un numéro modeste pour un aliment modeste. Cohérent, puisque les haricots secs sont justement ce que beaucoup de familles utilisent pour couvrir les numéros des cartons." },
  { n: 13, nap: "Sant'Antuono", lit: "Saint Antoine", text: "Sant'Antuono, c'est saint Antoine le Grand, l'un des saints les plus aimés de Campanie. Ici le 13 ne porte pas malheur : ce rôle revient au 17." },
  { n: 16, nap: "'O culo", lit: "Le derrière", text: "Littéralement le derrière, et par extension la chance, car en italien avere culo veut dire avoir du bol. Celui qui gagne trop l'entendra souvent." },
  { n: 17, nap: "'A disgrazzia", lit: "Le malheur", text: "Le 17 est le chiffre maudit en Italie. L'explication habituelle : le XVII romain, une fois les lettres réarrangées, donne VIXI, en latin j'ai vécu, autrement dit je suis mort." },
  { n: 22, nap: "'O pazzo", lit: "Le fou", text: "On l'annonce en regardant celui qui se comporte le plus bizarrement à table, ce qui un soir de Noël n'est jamais difficile à trancher." },
  { n: 25, nap: "Natale", lit: "Noël", text: "La date parle d'elle-même. Quand le 25 sort pendant une tombola de Noël, la table applaudit un peu." },
  { n: 28, nap: "'E zizze", lit: "Les seins", text: "L'un des numéros effrontés. Les grands-mères le disent sans ciller, les ados gloussent." },
  { n: 33, nap: "L'anne 'e Cristo", lit: "Les années du Christ", text: "Trente-trois, l'âge auquel le Christ mourut. On l'écrit aussi ll'anne 'e Criste, plus proche de la prononciation." },
  { n: 34, nap: "'A capa", lit: "La tête", text: "Simple et anatomique : capa est le mot napolitain pour tête. Rêver d'une tête, la sienne ou celle d'un autre, mène ici." },
  { n: 37, nap: "'O monaco", lit: "Le moine", text: "Une ville aussi riche en couvents que Naples devait bien donner un numéro au moine. Rêver d'un frère ou d'un moine mène au 37." },
  { n: 43, nap: "'Onna Pereta fore 'o balcone", lit: "Donna Pereta dehors au balcon", text: "Une femme penchée à son balcon, figure éternelle de la ruelle napolitaine qui voit tout et commente tout. Pereta n'est pas un prénom qu'on trouve à l'état civil." },
  { n: 45, nap: "'O vino bbuono", lit: "Le bon vin", text: "Le bon vin, précisément. De circonstance à une table où l'on mange depuis l'après-midi." },
  { n: 47, nap: "'O muorto", lit: "Le mort", text: "Le mort, tout simplement. Rêver d'un défunt mène traditionnellement ici, sauf si le mort parle." },
  { n: 48, nap: "'O muorto che parla", lit: "Le mort qui parle", text: "Si le mort parle dans le rêve, c'est le 48, et ce qu'il dit est censé suggérer d'autres numéros. Hors de Naples, beaucoup de villes donnent le mort qui parle au 47, d'où le film de Totò de 1950, 47 morto che parla." },
  { n: 55, nap: "'A musica", lit: "La musique", text: "La musique, dans une ville qui exporte des chansons. On l'écrit aussi 'a museca, comme on le prononce." },
  { n: 69, nap: "Sotto e 'ncoppa", lit: "Sens dessus dessous", text: "Littéralement dessous et dessus. Un regard sur les deux chiffres suffit, la logique se passe de commentaire." },
  { n: 71, nap: "L'ommo 'e merda", lit: "L'homme de merde", text: "Un homme qui ne vaut rien, sans dignité ni parole. C'est le numéro vulgaire le plus célèbre, annoncé avec gourmandise, souvent en regardant un oncle en particulier. On l'écrit aussi l'omm 'e mmerd, comme ça se prononce." },
  { n: 75, nap: "Pulecenella", lit: "Polichinelle", text: "Le masque de la comédie napolitaine, blouse blanche et demi-masque noir, pauvre, affamé et toujours capable de s'en tirer." },
  { n: 77, nap: "'E riavule", lit: "Les diables", text: "À Naples, le 77, ce sont les diables. La lecture du 77 comme les jambes des femmes, que beaucoup citent, appartient à d'autres traditions : un sonnet romain de 1883 lui donne déjà ce sens." },
  { n: 85, nap: "Ll'aneme d''o priatorio", lit: "Les âmes du purgatoire", text: "Les âmes des défunts qui attendent au purgatoire, au cœur de la dévotion populaire napolitaine et de la fête des morts de novembre." },
  { n: 89, nap: "'A vecchia", lit: "La vieille", text: "La vieille, figure fixe des contes et de la ruelle. On évite en général de l'annoncer en regardant la grand-mère qui tient le panier." },
  { n: 90, nap: "'A paura", lit: "La peur", text: "Le dernier numéro, et l'origine de l'expression la paura fa novanta, la peur fait quatre-vingt-dix, qu'on emploie quand la frayeur pousse quelqu'un à faire ce qu'il ne ferait jamais." },
];
---

<BlogPostLayout
  lang={lang}
  post={post}
  metaTitle={metaTitle}
  metaDescription={metaDescription}
  breadcrumbs={breadcrumbs}
  quickInfo={quickInfo}
  faq={faq}
  sidebarLinks={sidebarLinks}
  authorRole={authorRole}
  relatedArticles={relatedArticles}
  pageKey="neapolitan-tombola-smorfia"
>

  <!-- Key Takeaways -->
  <div class="bg-slate-900 text-white p-8 rounded-[2rem]">
    <div class="flex items-center gap-3 mb-6">
      <svg class="w-5 h-5 text-med-gold flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
      <h2 class="font-serif text-lg font-bold text-med-gold uppercase tracking-[0.15em]">Points Clés</h2>
    </div>
    <ul class="space-y-4">
      {keyTakeaways.map((point) => (
        <li class="flex items-start gap-3">
          <span class="w-1.5 h-1.5 rounded-full bg-med-gold flex-shrink-0 mt-2"></span>
          <span class="text-white/80 text-xs sm:text-sm leading-relaxed">{point}</span>
        </li>
      ))}
    </ul>
  </div>

  <!-- Intro -->
  <div>
    <p class="text-slate-600 text-xl leading-relaxed mb-6 font-light">
      Le dîner de Noël est terminé, la table a été débarrassée juste assez pour faire de la place, et quelqu'un sort un petit panier en osier plein de numéros en bois. Pendant les trois heures suivantes, toute une famille napolitaine va se disputer pour des haricots secs. Le jeu s'appelle la <em>tombola</em>, une version familiale du lotto qui fonctionne à peu près comme le loto ou le bingo, et ce qui la rend napolitaine, c'est la voix de celui qui tient le panier : chaque numéro sort avec son sens dans la <em>smorfia</em>, le livre des rêves, et certains de ces sens ne sont pas pour les oreilles du curé.
    </p>
  </div>

  <!-- What it is -->
  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">Ce qu'est la tombola et quand on y joue</h2>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      La tombola est un jeu de hasard à 90 numéros. Une personne les tire un par un d'un panier et les annonce à voix haute ; tous les autres les couvrent sur leurs propres cartons. On gagne en complétant le premier deux, trois, quatre ou cinq numéros sur une même ligne, et le gros lot revient à celui qui couvre tout son carton. Si vous connaissez le loto, vous connaissez presque tout.
    </p>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      Elle appartient aux fêtes de Noël, qui en Italie durent jusqu'à l'Épiphanie, le 6 janvier. Les soirées classiques sont le réveillon après le dîner de poisson, le jour de Noël après le déjeuner et la Saint-Sylvestre en attendant minuit, mais dans beaucoup de maisons le panier sort n'importe quel soir où la famille est réunie et où personne n'a envie d'affronter le froid. Grands-parents et enfants jouent à la même table, avec quelques pièces par carton, et l'argent reste de toute façon dans la famille.
    </p>
    <p class="text-slate-600 text-lg leading-relaxed">
      On y joue dans toute la Campanie, de Naples à <a href="/fr-fr/peninsule-sorrentine/sorrente/" class="text-med-blue hover:underline">Sorrente</a> et jusqu'aux villages de la côte amalfitaine. Si vous passez Noël ici et qu'on vous demande si vous voulez un carton, la réponse est oui.
    </p>
  </div>

  <!-- Origin -->
  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">D'où elle vient : un roi, un dominicain et le lotto</h2>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      Naples jouait au lotto bien avant l'existence de la tombola. La structure à 90 numéros remonte à un jeu génois du XVIe siècle, et le lotto était arrivé à Naples à la fin du XVIIe siècle, joué légalement et illégalement à parts égales.
    </p>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      La tradition situe la naissance de la tombola en <strong>1734</strong>, sous Charles de Bourbon, futur Charles III d'Espagne. Le roi voulait placer le lotto sous contrôle public, pour que le trésor en profite plutôt que les banques clandestines. Face à lui se dressait le frère dominicain <strong>Gregorio Maria Rocco</strong>, prédicateur célèbre, qui qualifiait le jeu de divertissement trompeur et immoral détournant le peuple de la prière. Le compromis, selon le récit, fut que le lotto s'arrêterait pendant les fêtes de Noël. Faute de pouvoir jouer en public, les familles napolitaines mirent les numéros dans un panier et les tirèrent à la maison.
    </p>
    <p class="text-slate-600 text-lg leading-relaxed">
      Prenez les détails comme une tradition bien établie plutôt que comme un décret documenté : c'est l'histoire que répètent toutes les sources napolitaines, et personne n'en a proposé de meilleure. Le nom vient probablement du culbutage des numéros dans le panier avant chaque tirage, tombolare en italien.
    </p>
  </div>

  <!-- How to play -->
  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">Comment on joue</h2>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      Il faut trois choses : les <strong>cartelle</strong>, les cartons ; le <strong>cartellone</strong>, le grand tableau avec les 90 numéros ; et le <strong>panariello</strong>, le petit panier en osier qui contient les 90 numéros en bois ou en plastique. Chaque carton compte trois lignes de cinq numéros, quinze en tout, répartis sur neuf colonnes. Chacun achète autant de cartons qu'il veut, souvent pour quelques centimes pièce, et l'argent récolté forme la cagnotte.
    </p>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      Celui qui tient le cartellone tire et annonce, place chaque numéro sur le tableau et joue aussi : le tableau vaut six cartons et peut gagner comme tout le monde. On couvre les numéros avec ce qu'on trouve en cuisine. Les haricots secs sont le classique, les morceaux d'écorce de mandarine arrivent juste derrière.
    </p>

    <div class="overflow-x-auto rounded-[2rem] border border-slate-100 shadow-sm mb-6">
      <table class="w-full text-xs sm:text-sm">
        <thead class="bg-slate-900 text-white">
          <tr>
            <th class="text-left p-5 font-serif font-bold text-med-gold">Gain</th>
            <th class="text-left p-5 font-serif font-bold text-med-gold">Ce qu'il faut</th>
          </tr>
        </thead>
        <tbody class="bg-white">
          <tr class="border-b border-slate-100">
            <td class="p-5 font-bold">Ambo</td>
            <td class="p-5 text-slate-600">Deux numéros sur la même ligne d'un carton.</td>
          </tr>
          <tr class="border-b border-slate-100">
            <td class="p-5 font-bold">Terno</td>
            <td class="p-5 text-slate-600">Trois numéros sur la même ligne.</td>
          </tr>
          <tr class="border-b border-slate-100">
            <td class="p-5 font-bold">Quaterna</td>
            <td class="p-5 text-slate-600">Quatre numéros sur la même ligne.</td>
          </tr>
          <tr class="border-b border-slate-100">
            <td class="p-5 font-bold">Cinquina</td>
            <td class="p-5 text-slate-600">Les cinq numéros d'une ligne.</td>
          </tr>
          <tr class="border-b border-slate-100">
            <td class="p-5 font-bold">Tombola</td>
            <td class="p-5 text-slate-600">Les quinze numéros d'un carton. Le gros lot, annoncé en criant le nom du jeu.</td>
          </tr>
          <tr>
            <td class="p-5 font-bold">Tombolino</td>
            <td class="p-5 text-slate-600">Un gain facultatif pour le deuxième carton complet, pour faire durer la partie un peu plus.</td>
          </tr>
        </tbody>
      </table>
    </div>

    <ul class="space-y-3">
      <li class="flex items-start gap-3"><span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span><span class="text-slate-700"><strong>Annoncez-le à voix haute.</strong> Chaque gain doit être réclamé avant le tirage du numéro suivant, sinon il passe à celui qui le réclame ensuite.</span></li>
      <li class="flex items-start gap-3"><span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span><span class="text-slate-700"><strong>Les gains dans l'ordre.</strong> D'abord l'ambo, puis le terno, et ainsi de suite jusqu'à la tombola. Personne ne peut gagner un terno avant que quelqu'un ait fait ambo.</span></li>
      <li class="flex items-start gap-3"><span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span><span class="text-slate-700"><strong>Le panier tourne.</strong> Dans beaucoup de familles, celui qui fait tombola prend le cartellone pour la manche suivante.</span></li>
    </ul>
  </div>

  <!-- Smorfia -->
  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">La smorfia, expliquée</h2>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      La <em>smorfia</em> est le livre des rêves napolitain : un dictionnaire populaire qui traduit les rêves et les faits du quotidien en numéros de 1 à 90, né pour savoir quoi jouer au lotto. Vous rêvez d'un chat, vous jouez le 3. Un parent disparu vous parle en rêve, vous jouez le 48. On rattache généralement le nom à Morphée, dieu grec des rêves ; les origines restent incertaines, avec des théories qui vont de la kabbale à la numérologie pythagoricienne.
    </p>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      Elle s'est transmise oralement bien avant d'être imprimée, et quand on l'a mise par écrit, on l'a organisée en images, pour que ceux qui ne savaient pas lire puissent s'en servir. C'est pourquoi le cartellone napolitain montre encore un petit dessin dans chaque case. Les sens peuvent changer d'une ville à l'autre, et même à Naples on trouve des variantes et plusieurs graphies d'une même expression.
    </p>
    <p class="text-slate-600 text-lg leading-relaxed">
      À la tombola, la smorfia devient théâtre. Celui qui annonce dit rarement le numéro seul : il dit le sens, parfois seulement le sens, et la table doit deviner le numéro. Un bon meneur enchaîne les numéros en piques adressées aux personnes présentes. À la fin des années 1970, Massimo Troisi, Lello Arena et Enzo De Caro ont même baptisé leur trio comique La Smorfia.
    </p>
  </div>

  <!-- Numbers -->
  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">Ce que veulent dire les numéros</h2>
    <p class="text-slate-600 text-lg leading-relaxed mb-8">
      Voici les numéros les plus recherchés et ceux qu'on entend le plus souvent à une table napolitaine. Pour chacun : l'expression en napolitain, dans la graphie la plus courante, la traduction littérale et une courte note. Quelques-uns sont vulgaires ; ils font partie du jeu, et les retirer serait mentir.
    </p>
    <div class="space-y-4">
      {numbers.map((item) => (
        <div class="bg-white p-6 rounded-[2rem] border border-slate-100 shadow-sm">
          <h3 class="font-serif text-xl font-bold text-slate-900 mb-2">Que signifie le {item.n} ?</h3>
          <p class="text-slate-900 font-semibold mb-2"><span class="text-med-gold">{item.n}</span> · <em>{item.nap}</em> · {item.lit}</p>
          <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">{item.text}</p>
        </div>
      ))}
    </div>
  </div>

  <!-- Scostumata -->
  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">La tombola scostumata</h2>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      Il y a la tombola en famille, et puis il y a la <em>tombola scostumata</em>, la mal élevée, appelée aussi <em>tombola vajassa</em> ou <em>tombola dei femminielli</em>. Les règles sont les mêmes. Ce qui change, c'est le meneur, qui annonce chaque numéro avec son sens le plus salé, strictement en napolitain, et relie un tirage au suivant pour bâtir une histoire improvisée de plus en plus indécente à mesure que le tableau se remplit.
    </p>
    <p class="text-slate-600 text-lg leading-relaxed">
      Traditionnellement, elle était menée par les <em>femminielli</em>, figure reconnue des quartiers populaires de Naples, lors de parties réservées aux femmes et aux enfants. Aujourd'hui elle survit surtout comme spectacle de Noël : théâtres et cabarets de Naples montent des tombolate scostumate chaque décembre, souvent avec le dîner compris. Inutile de bien parler napolitain. Les gestes font presque tout le travail.
    </p>
  </div>

  <!-- Where to buy -->
  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">Où acheter une tombola</h2>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      En décembre, les jeux de tombola apparaissent partout en Campanie : papeteries, magasins de jouets, bureaux de tabac et supermarchés les empilent près des caisses. Celle à chercher est la version napolitaine, avec le cartellone illustré et l'image de la smorfia dans chaque case ; un tableau avec seulement des chiffres fonctionne, mais on perd la moitié du plaisir.
    </p>
    <p class="text-slate-600 text-lg leading-relaxed">
      Si vous êtes à Naples, les ateliers de la Via San Gregorio Armeno vendent des souvenirs napolitains à côté des santons de crèche, et c'est une bonne rue pour chercher des objets autour de la smorfia. L'assortiment varie d'une boutique à l'autre, alors voyez-le comme une flânerie plutôt qu'un achat garanti. Notre guide des <a href="/fr-fr/blog/creches-naples-sorrente/" class="text-med-blue hover:underline">crèches de Naples et Sorrente</a> explique comment y aller depuis la péninsule.
    </p>
  </div>

