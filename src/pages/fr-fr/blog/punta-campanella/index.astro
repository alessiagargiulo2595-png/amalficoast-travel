---
import BlogPostLayout from '../../../../layouts/BlogPostLayout.astro';

const lang = 'fr-fr';
const post = {
  title: 'Punta Campanella',
  subtitle: 'Là où le Mythe Rencontre les Deux Golfes',
  category: 'DÉCOUVERTES',
  date: '10 mai 2026',
  readTime: '8 min',
  image: '/images/punta-campanella-hero.jpg',
  imageAlt: 'Punta Campanella - Massa Lubrense, Péninsule de Sorrente',
  path: '/fr-fr/blog/punta-campanella/',
};

const metaTitle = 'Punta Campanella : Randonnée, Archéologie et le Mythe d\'Ulysse 2026';
const metaDescription = 'Guide complet de Punta Campanella : randonnée en Péninsule de Sorrente avec vues sur Capri, Temple d\'Athéna, tour médiévale et légendes d\'Ulysse.';

const breadcrumbs = [
  { name: 'Accueil', url: '/fr-fr/' },
  { name: 'Blog', url: '/fr-fr/blog/' },
  { name: 'Punta Campanella', url: '/fr-fr/blog/punta-campanella/' },
];

const quickInfo = [
  { label: 'Point de départ', value: 'Place de Termini (Massa Lubrense)' },
  { label: 'Difficulté', value: 'E (Randonnée) - Facile/Moyen' },
  { label: 'Durée', value: 'Environ 1 heure (aller simple)' },
  { label: 'Équipement', value: 'Chaussures de randonnée, eau, chapeau' },
  { label: 'Accès', value: 'Gratuit (Réserve Marine Protégée)' },
  { label: 'Vues', value: 'Capri, Golfe de Naples, Côte Amalfitaine' },
  { label: 'À voir', value: 'Temple d\'Athéna, Clocheton, Faraglioni, Baie de Ieranto' },
  { label: 'Meilleure période', value: 'Avril - Octobre (Coucher de soleil spectaculaire)' },
];

const faq = [
  {
    q: 'Peut-on atteindre Punta Campanella en voiture ?',
    a: 'Non, c\'est un sentier piétonnier. Garez votre voiture à Termini et continuez à pied.',
  },
  {
    q: 'Peut-on se baigner à Punta Campanella ?',
    a: 'Oui, mais il n\'y a pas de plages de sable. L\'accès à la mer se fait par des roches et des falaises. Recommandé uniquement pour les nageurs expérimentés en raison des courants à la confluence des deux golfes.',
  },
  {
    q: 'Est-ce adapté aux enfants ?',
    a: 'Oui, le sentier principal est large et sûr, mais évitez les heures les plus chaudes de la journée car il y a très peu d\'ombre.',
  },
  {
    q: 'Quel est le meilleur moment pour le coucher de soleil ?',
    a: 'En haute saison (mai-septembre), le soleil se couche juste à côté des Faraglioni de Capri autour de 19-20h. Apportez une lampe frontale pour le retour.',
  },
  {
    q: 'Quelle est la légende d\'Ulysse ?',
    a: 'Selon la mythologie grecque, c\'est ici qu\'Ulysse a rencontré les Sirènes. Pour résister à leur chant enchanteur, il s\'est fait attacher au mât de son navire.',
  },
  {
    q: 'Y a-t-il un accès à la Baie de Ieranto depuis Punta Campanella ?',
    a: 'Oui, à partir de la bifurcation principale, vous pouvez vous diriger vers la Baie de Ieranto (pour les randonneurs expérimentés). C\'est une crique vierge propriété du FAI avec une eau d\'une pureté primordiale.',
  },
];

const sidebarLinks = [
  { label: 'Randonnée & Sentier des Dieux', href: '/fr-fr/experiences/trekking/' },
  { label: 'Découvrez Massa Lubrense', href: '/fr-fr/peninsule-sorrentine/massa-lubrense/' },
  { label: 'Baie de Ieranto', href: '/fr-fr/plages/peninsule-sorrentine/spiaggia-di-ieranto/' },
  { label: 'Quand visiter', href: '/fr-fr/guide/quand-visiter/' },
  { label: 'Comment y aller', href: '/fr-fr/guide/comment-venir/' },
];

const relatedArticles = [
  {
    title: 'Valle delle Ferriere',
    category: 'DÉCOUVERTES',
    date: '22 avril 2026',
    image: '/images/valle-ferriere-hero.jpg',
    imageAlt: 'Cascade dans la Valle delle Ferriere, Amalfi - Côte Amalfitaine',
    path: '/fr-fr/blog/vallee-des-ferriere/'
  },
  {
    title: 'Atrani',
    category: 'DÉCOUVERTES',
    date: '22 avril 2026',
    image: '/images/atrani-hero.jpg',
    imageAlt: 'Atrani - Le plus petit village d\'Italie sur la Côte Amalfitaine',
    path: '/fr-fr/blog/atrani/'
  }
];

const authorRole = 'Guide d\'Aventure & d\'Histoire · Péninsule de Sorrente';

const keyTakeaways = [
  'Punta Campanella est l\'endroit où la géographie devient histoire : la frontière sacrée entre le Golfe de Naples et le Golfe de Salerne avec une vue à 360 degrés.',
  'Le majestueux Temple d\'Athéna (plus tard dédié à Minerve par les Romains) s\'élevait ici comme un phare de la civilisation antique ; aujourd\'hui des vestiges archéologiques surgissent de la végétation méditerranéenne.',
  'Le nom "Campanella" provient de la tour de guet du XIVe siècle avec une cloche qui sonnait l\'alarme contre les raids sarrasins.',
  'Le sentier est classé E (Randonnée) : environ 1 heure depuis Termini. Accès gratuit à la Réserve Marine Protégée. Vue à 360 degrés : Vésuve, Côte de Sorrente, Côte Amalfitaine, Capri et îles de Li Galli.',
  'Le coucher de soleil à Punta Campanella est une expérience mystique : le soleil se couche juste à côté des Faraglioni de Capri, teignant la mer d\'or.',
];

const videoSchema = {
  "@context": "https://schema.org",
  "@type": "VideoObject",
  "name": "Punta Campanella : Là où le Mythe Rencontre les Deux Golfes",
  "description": "Vidéo du site de Punta Campanella en Péninsule de Sorrente avec une vue à 360 degrés sur deux golfes, archéologie et légendes d\'Ulysse.",
  "thumbnailUrl": "/images/punta-campanella-hero.jpg",
  "uploadDate": "2026-05-10",
  "duration": "PT0M30S",
  "contentUrl": "/videos/punta-campanella-video.mp4",
  "videoDetails": {
    "width": "1280",
    "height": "720"
  }
};
---

<BlogPostLayout
  lang={lang}
  post={post}
  metaTitle={metaTitle}
  metaDescription={metaDescription}
  breadcrumbs={breadcrumbs}
  quickInfo={quickInfo}
  faq={faq}
  sidebarLinks={sidebarLinks}
  authorRole={authorRole}
  relatedArticles={relatedArticles}
  schema={[videoSchema]}
  pageKey="punta-campanella"
>

  <!-- Video Section -->
  <div class="rounded-[2rem] shadow-xl mb-8 flex justify-center bg-slate-900 py-4">
    <video muted="muted"
      controls controlsList="nofullscreen" id="disable-audio"
      poster="/images/punta-campanella-hero.jpg"
      class="max-w-full max-h-[500px]"
      width="1280"
      height="720"
    >
      <source src="/videos/punta-campanella-video.mp4?v=2" type="video/mp4" />
      Votre navigateur ne supporte pas la vidéo HTML5.
    </video>
    <script>
  function cleanApostrophes(text) {
    return String(text).replace(/\'/g, "'");
  }
      let video = document.getElementById("disable-audio");
      if (!video) video = document.querySelector('video');
      if (video) {
        const forceMuted = () => {
          video.muted = true;
          video.volume = 0;
        };
        forceMuted();
        video.addEventListener('play', forceMuted);
        video.addEventListener('playing', forceMuted);
        video.addEventListener('volumechange', forceMuted);
        video.addEventListener('timeupdate', forceMuted);
        video.addEventListener('seeked', forceMuted);
      }
    </script>
  </div>

  <!-- Key Takeaways -->
  <div class="bg-slate-900 text-white p-8 rounded-[2rem]">
    <div class="flex items-center gap-3 mb-6">
      <svg class="w-5 h-5 text-med-gold flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
      <h2 class="font-serif text-lg font-bold text-med-gold uppercase tracking-[0.15em]">Points Clés</h2>
    </div>
    <ul class="space-y-4">
      {keyTakeaways.map((point) => (
        <li class="flex items-start gap-3">
          <span class="w-1.5 h-1.5 rounded-full bg-med-gold flex-shrink-0 mt-2"></span>
          <span class="text-white/80 text-xs sm:text-sm leading-relaxed">{point}</span>
        </li>
      ))}
    </ul>
  </div>

  <!-- Intro -->
  <div>
    <p class="text-slate-600 text-xl leading-relaxed mb-6 font-light">
      Il existe un lieu, à l'extrémité de la péninsule de Sorrente, où la terre s'amincit jusqu'à devenir une pointe rocheuse tendue vers <a href="/fr-fr/iles/capri/" class="text-med-blue hover:underline">Capri</a>. Ce lieu, c'est Punta Campanella. Plus qu'une réserve marine protégée, c'est la frontière sacrée entre le golfe de Naples et celui de Salerne, un bout de terre où l'histoire millénaire, le mythe d'Ulysse et une nature sauvage s'unissent.
    </p>
  </div>

  <!-- Un voyage entre mythe et archéologie -->
  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">Un Voyage entre Mythe et Archéologie</h2>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      Marcher vers Punta Campanella, c'est emprunter la même route que les Grecs et les Romains. Ici s'élevait le majestueux Temple d'Athéna (dédié plus tard à Minerve par les Romains), véritable phare de civilisation pour les marins antiques. Aujourd'hui, des vestiges archéologiques affleurent parmi la végétation méditerranéenne, témoins d'un passé où ce promontoire était considéré comme sacré.
    </p>

    <div class="bg-white p-8 rounded-[2rem] border border-slate-100 shadow-sm my-6">
      <h3 class="font-serif text-xl font-bold text-slate-900 mb-4">La Tour-Clocheton du XIVe Siècle</h3>
      <p class="text-slate-600 leading-relaxed mb-4">
        Le nom "Campanella" (petite cloche) provient de la tour de guet du XIVe siècle, partie du système défensif contre les raids sarrasins. Au sommet de la tour se trouvait une <strong>cloche qui sonnait l'alarme</strong> en cas de danger, dont le tintement résonnait de tour en tour le long de toute la côte.
      </p>
      <p class="text-slate-600 leading-relaxed">
        Encore aujourd'hui, bien que ruinée, la tour domine le paysage et raconte des histoires de vigilance nocturne, de marins anxieux et d'une communauté qui protégeait son territoire avec vigilance constante.
      </p>
    </div>

    <blockquote class="border-l-4 border-med-gold pl-6 my-8">
      <p class="text-slate-700 text-xl font-serif italic leading-relaxed">
        "Punta Campanella est le lieu où la géographie devient histoire, et l'histoire devient légende."
      </p>
    </blockquote>
  </div>

  <!-- Le Sentier -->
  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">Le Sentier : Randonnée entre Ciel et Mer</h2>
    <p class="text-slate-600 text-lg leading-relaxed mb-8">
      L'itinéraire part du village de Termini (<a href="/fr-fr/peninsule-sorrentine/massa-lubrense/" class="text-med-blue hover:underline">Massa Lubrense</a>). C'est un parcours à la portée de tous, offrant des panoramas à couper le souffle.
    </p>

    <div class="space-y-4 mb-8">
      <div class="bg-white p-6 rounded-[2rem] border border-slate-100 shadow-sm flex gap-5">
        <div class="w-10 h-10 rounded-full bg-med-gold/10 flex-shrink-0 flex items-center justify-center text-med-gold font-bold text-xs sm:text-sm">1</div>
        <div>
          <h4 class="font-bold text-slate-900 mb-1">Le Parcours</h4>
          <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Le sentier serpente entre oliviers centenaires et arbustes de myrte et de romarin. À mesure que l'on descend vers le phare, la silhouette de Capri semble presque à portée de main.</p>
        </div>
      </div>
      <div class="bg-white p-6 rounded-[2rem] border border-slate-100 shadow-sm flex gap-5">
        <div class="w-10 h-10 rounded-full bg-med-gold/10 flex-shrink-0 flex items-center justify-center text-med-gold font-bold text-xs sm:text-sm">2</div>
        <div>
          <h4 class="font-bold text-slate-900 mb-1">La Vue Panoramique</h4>
          <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Arrivé à la tour, le regard embrasse l'horizon à 360 degrés : d'un côté le Vésuve et la côte de Sorrente, de l'autre la côte amalfitaine et l'archipel des Li Galli.</p>
        </div>
      </div>
    </div>

    <div class="overflow-hidden rounded-[2rem] border border-slate-100 shadow-sm">
      <table class="w-full text-xs sm:text-xs sm:text-sm">
        <thead class="bg-slate-900 text-white">
          <tr>
            <th class="text-left p-5 font-serif font-bold text-med-gold">Caractéristique</th>
            <th class="text-left p-5 font-serif font-bold text-med-gold">Détail</th>
          </tr>
        </thead>
        <tbody class="bg-white">
          <tr class="border-b border-slate-100">
            <td class="p-5 font-bold">Point de départ</td>
            <td class="p-5 text-slate-600">Place de Termini (Massa Lubrense)</td>
          </tr>
          <tr class="border-b border-slate-100">
            <td class="p-5 font-bold">Difficulté</td>
            <td class="p-5 text-slate-600">E (Randonnée) - Facile/Moyen</td>
          </tr>
          <tr class="border-b border-slate-100">
            <td class="p-5 font-bold">Temps de marche</td>
            <td class="p-5 text-slate-600">Environ 1 heure (aller simple)</td>
          </tr>
          <tr class="border-b border-slate-100">
            <td class="p-5 font-bold">Équipement</td>
            <td class="p-5 text-slate-600">Chaussures de randonnée, eau, chapeau</td>
          </tr>
          <tr>
            <td class="p-5 font-bold">Accès</td>
            <td class="p-5 text-slate-600">Gratuit (Réserve Marine Protégée)</td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>

  <!-- Conseils de l'Expert -->
  <div class="bg-white p-8 rounded-[2rem] shadow-xl border border-slate-100">
    <div class="flex items-center gap-4 mb-6">
      <svg class="w-6 h-6 text-med-gold flex-shrink-0" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M9 18h6"/><path d="M10 22h4"/><path d="M15.09 14c.18-.98.65-1.74 1.41-2.5A4.65 4.65 0 0 0 18 8 6 6 0 0 0 6 8c0 1 .23 2.23 1.5 3.5A4.61 4.61 0 0 1 8.91 14"/></svg>
      <h3 class="text-xl font-bold">Conseils de l'Expert</h3>
    </div>
    <div class="space-y-6">
      <div>
        <p class="font-bold text-slate-900 mb-1">Le Moment Magique : Le Coucher de Soleil</p>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Le coucher de soleil à Punta Campanella est une expérience mystique. Le soleil descend exactement à côté des Faraglioni de Capri. Si vous restez pour le coucher, prévoyez une lampe frontale pour le retour à Termini.</p>
      </div>
      <div>
        <p class="font-bold text-slate-900 mb-1">La Baie de Ieranto</p>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Pour les randonneurs expérimentés, bifurquez vers la <a href="/fr-fr/plages/peninsule-sorrentine/spiaggia-di-ieranto/" class="text-med-blue hover:underline">Baie de Ieranto</a>, une crique préservée propriété du FAI. Les bateaux à moteur sont interdits, garantissant des eaux cristallines.</p>
      </div>
      <div>
        <p class="font-bold text-slate-900 mb-1">Respect de l'Environnement</p>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Vous êtes dans une Réserve Naturelle. Ne laissez pas de déchets et restez sur les sentiers balisés pour préserver la rare flore endémique de la région.</p>
      </div>
    </div>
  </div>

  <!-- La Légende d'Ulysse -->
  <div class="bg-slate-50 p-8 rounded-[2rem] border-l-4 border-med-gold my-8">
    <div class="flex items-start gap-4">
      <svg class="w-6 h-6 text-med-gold flex-shrink-0 mt-1" fill="currentColor" viewBox="0 0 24 24"><path d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
      <div>
        <h3 class="font-bold text-slate-900 mb-2 text-lg">Le Saviez-vous ?</h3>
        <p class="text-slate-700 leading-relaxed">
          La légende raconte que c'est ici qu'Ulysse a rencontré les Sirènes. Pour résister à leur chant enchanteur, il s'est fait attacher au mât de son navire. Chaque coucher de soleil depuis ces falaises, il semble que l'on entend encore ce chant lointain, caressé par les vagues.
        </p>
      </div>
    </div>
  </div>

</BlogPostLayout>
