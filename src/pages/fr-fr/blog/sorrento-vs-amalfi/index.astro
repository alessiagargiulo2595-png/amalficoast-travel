---
import BlogPostLayout from '../../../../layouts/BlogPostLayout.astro';

const lang = 'fr-fr';
const post = {
  title: 'Sorrente ou Amalfi',
  subtitle: 'Choisir votre base : guide 2026',
  category: 'GUIDES',
  date: '29 mai 2026',
  readTime: '11 min',
  image: '/images/sorrento-vs-amalfi-hero.webp',
  imageAlt: 'Sorrente et Amalfi : choisir la base parfaite pour votre voyage',
  path: '/fr-fr/blog/sorrento-vs-amalfi/',
};

const metaTitle = 'Sorrente ou Amalfi 2026 : Meilleure Base pour Votre Voyage en Italie ? | Guide Honnête';
const metaDescription = 'Sorrente ou Amalfi comme base 2026 : comparaison complète pour lune de miel, famille, grands groupes. Pompéi, Capri, Ravello : où loger pour les excursions que vous voulez vraiment.';

const breadcrumbs = [
  { name: 'Accueil', url: '/fr-fr/' },
  { name: 'Blog', url: '/fr-fr/blog/' },
  { name: 'Sorrente ou Amalfi', url: '/fr-fr/blog/sorrento-vs-amalfi/' },
];

const quickInfo = [
  { label: 'Distance', value: '35 km le long de la SS163' },
  { label: 'Temps de trajet', value: '~1h30 bus SITA ou 1h ferry' },
  { label: 'Sorrente', value: '~16 000 habitants · Golfe de Naples' },
  { label: 'Amalfi', value: '~5 000 habitants · centre Côte Amalfitaine' },
  { label: 'Plus proche de Pompéi', value: 'Sorrente (30 min en train)' },
  { label: 'Plus proche de Ravello', value: 'Amalfi (25 min en bus)' },
];

const faq = [
  {
    q: 'Sorrente ou Amalfi comme base pour première visite ?',
    a: "Sorrente, si vous voulez Pompéi et Capri facilement. Sorrente a train direct pour Pompéi (30 min) et ferry le plus rapide pour Capri (20 min). Amalfi est le cœur géographique de la Côte Amalfitaine elle-même : meilleur pour Ravello, Minori, Maiori et Grotte d'Émeraude. Pour un premier voyage en Italie de 7 jours avec Pompéi sur la liste, choisissez Sorrente. Pour des vacances pures Côte, choisissez Amalfi.",
  },
  {
    q: 'Sorrente ou Amalfi pour grandes familles ou groupes ?',
    a: "Sorrente, facilement. Ville plus grande, plus d'appartements et villas 4-5 chambres, grands supermarchés (Conad, Coop), restaurants qui gèrent groupes de 8-12 sans réservation, transfert plus facile depuis l'aéroport de Naples (voiture privée ou bus Curreri). Amalfi a moins de grandes locations et capacité restaurant plus serrée.",
  },
  {
    q: 'Sorrente ou Amalfi pour lune de miel ?',
    a: "Idéalement aucune : le choix lune de miel est Positano. Mais forcés à choisir, Amalfi est plus romantique. Les marches de la cathédrale médiévale la nuit, les terrasses de l'Hotel Santa Caterina ou Belmond Caruso, le bateau pour Capri au coucher de soleil. Sorrente est trop ville de travail. Si votre partenaire veut spécifiquement des matins romantiques Pompéi + Capri, Sorrente fonctionne.",
  },
  {
    q: 'Sorrente ou Amalfi : laquelle est moins chère ?',
    a: "Sorrente est 20-30% moins chère. Sorrente 3★ : €120-180/nuit. Amalfi 3★ : €150-220/nuit. Restaurants similaires (Amalfi légèrement plus élevé). La grande économie à Sorrente sont les transferts : billets de train moins chers que la même distance en ferry, et accès aéroport Naples ne nécessite pas de taxi.",
  },
  {
    q: 'Sorrente ou Amalfi pour excursion à Pompéi ?',
    a: "Sorrente gagne décisivement. Train 30 min (Circumvesuviana ou Campania Express) directement à la station Pompei Scavi, toutes les 30 min, €2,20 le billet. D'Amalfi à Pompéi : bus SITA pour Salerne (1h10) + train régional Salerne-Pompei (45 min) = 2h+ par trajet. Pompéi est une excursion depuis Sorrente, pas depuis Amalfi.",
  },
  {
    q: 'Sorrente ou Amalfi pour excursion à Ravello ?',
    a: "Amalfi gagne décisivement. Ravello est directement au-dessus d'Amalfi : bus SITA toutes les 30 min, 25 min, €2,40. De Sorrente à Ravello : bus SITA Sorrente-Amalfi (1h30) + bus Amalfi-Ravello (25 min) = 2h par trajet. Si Ravello Festival est dans vos plans, vous logez à Amalfi.",
  },
  {
    q: 'Sorrente ou Amalfi pour excursion à Capri ?',
    a: "Sorrente. Ferry le plus rapide : Sorrente → Capri 20-25 min, toute l'année, chaque heure. Amalfi → Capri : 1h, seulement saisonnier (avril-octobre). Coût similaire (~€20 aller). Si Capri est incontournable, base à Sorrente.",
  },
];

const sidebarLinks = [
  { label: 'Guide Sorrente', href: '/fr-fr/peninsule-sorrentine/sorrente/' },
  { label: 'Guide Amalfi', href: '/fr-fr/cote-amalfitaine/amalfi/' },
  { label: 'Guide Ravello', href: '/fr-fr/cote-amalfitaine/ravello/' },
  { label: 'Bus SITA', href: '/fr-fr/guide/bus-sita/' },
  { label: 'Ferries', href: '/fr-fr/guide/ferries/' },
  { label: 'Sorrente ou Positano', href: '/fr-fr/blog/sorrento-vs-positano/' },
];

const authorRole = 'Expert logistique voyages · Côte Amalfitaine';

const relatedArticles = [
  {
    title: 'Positano ou Amalfi',
    category: 'GUIDES',
    date: '29 mai 2026',
    image: '/images/positano-vs-amalfi-hero.webp',
    imageAlt: 'Positano et Amalfi : comparaison',
    path: '/fr-fr/blog/positano-vs-amalfi/',
  },
  {
    title: 'Sorrente ou Positano',
    category: 'GUIDES',
    date: '29 mai 2026',
    image: '/images/sorrento-vs-positano-hero.webp',
    imageAlt: 'Sorrente et Positano : comparaison',
    path: '/fr-fr/blog/sorrento-vs-positano/',
  },
];

const compareSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: 'Sorrente ou Amalfi : la meilleure base pour votre voyage',
  about: [
    { '@type': 'Place', name: 'Sorrente', address: { '@type': 'PostalAddress', addressLocality: 'Sorrento', addressRegion: 'NA', addressCountry: 'IT' } },
    { '@type': 'Place', name: 'Amalfi', address: { '@type': 'PostalAddress', addressLocality: 'Amalfi', addressRegion: 'SA', addressCountry: 'IT' } },
  ],
};
---

<BlogPostLayout
  lang={lang}
  post={post}
  metaTitle={metaTitle}
  metaDescription={metaDescription}
  breadcrumbs={breadcrumbs}
  quickInfo={quickInfo}
  faq={faq}
  sidebarLinks={sidebarLinks}
  authorRole={authorRole}
  relatedArticles={relatedArticles}
  extraSchema={[compareSchema]}
>

  <div>
    <p class="text-slate-600 text-xl leading-relaxed mb-6 font-light">
      <strong>Sorrente ou Amalfi comme base ?</strong> C'est la question pour les voyageurs qui veulent "tout voir" (Pompéi, Capri, Positano, Ravello) en un seul voyage de 5-7 jours. Les deux villes sont aux extrémités opposées de la région et chacune est la porte d'entrée vers la moitié de la liste de souhaits. La réponse dépend de quelle moitié compte le plus.
    </p>
    <p class="text-slate-600 text-lg leading-relaxed">
      Vérification rapide avant de commencer : Sorrente n'est techniquement pas sur la <a href="/fr-fr/cote-amalfitaine/" class="text-med-blue hover:underline">Côte Amalfitaine</a> (elle est sur la Péninsule Sorrentine, face au Golfe de Naples). Amalfi est dans le cœur géographique et historique de la Côte. Cette distinction façonne chaque excursion de ce guide.
    </p>
  </div>

  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">Si Pompéi est sur votre liste : Sorrente</h2>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      Pompéi est le plus grand facteur décisif. <a href="/fr-fr/peninsule-sorrentine/sorrente/" class="text-med-blue hover:underline">Sorrente</a> est sur la ligne Circumvesuviana : 30 minutes porte à porte jusqu'à la station Pompei Scavi, toutes les 30 minutes, €2,20 par trajet. Vous pouvez quitter l'hôtel à 8h30 et être dans les ruines à 9h30, devançant les foules des bus touristiques.
    </p>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      Depuis Amalfi, Pompéi est une épreuve de 2 heures par trajet (bus pour Salerne + train, ou bus pour Sorrente + train). Une "journée Pompéi" depuis Amalfi consomme 12 heures et arrive aux ruines après les bus touristiques. Soit vous sautez Pompéi depuis Amalfi soit vous avez base à Sorrente.
    </p>
    <div class="bg-white p-8 rounded-[2rem] border border-slate-100 shadow-sm">
      <h3 class="font-serif text-xl font-bold text-slate-900 mb-4">Matrice excursions depuis Sorrente</h3>
      <ul class="space-y-4 text-slate-600">
        <li class="flex items-start gap-3">
          <span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span>
          <span class="text-slate-700"><strong>Pompéi :</strong> 30 min train ⭐</span>
        </li>
        <li class="flex items-start gap-3">
          <span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span>
          <span class="text-slate-700"><strong>Capri :</strong> 20 min ferry ⭐</span>
        </li>
        <li class="flex items-start gap-3">
          <span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span>
          <span class="text-slate-700"><strong>Naples (Musée Archéologique) :</strong> 1h15 train</span>
        </li>
        <li class="flex items-start gap-3">
          <span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span>
          <span class="text-slate-700"><strong>Positano :</strong> 50 min bus / 35 min ferry</span>
        </li>
        <li class="flex items-start gap-3">
          <span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span>
          <span class="text-slate-700"><strong>Herculanum :</strong> 50 min train</span>
        </li>
        <li class="flex items-start gap-3">
          <span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span>
          <span class="text-slate-700"><strong>Mont Vésuve :</strong> 1h30 train + bus</span>
        </li>
      </ul>
    </div>
  </div>

  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">Si la Côte Amalfitaine EST le voyage : Amalfi</h2>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      Si vous ne chassez pas Pompéi, si le voyage concerne spécifiquement la Côte Amalfitaine, alors <a href="/fr-fr/cote-amalfitaine/amalfi/" class="text-med-blue hover:underline">Amalfi</a> est la meilleure base. Elle est au centre de la Côte et est la seule ville avec connexions fréquentes vers tout ce qui se trouve au sud de Positano.
    </p>
    <div class="bg-white p-8 rounded-[2rem] border border-slate-100 shadow-sm">
      <h3 class="font-serif text-xl font-bold text-slate-900 mb-4">Matrice excursions depuis Amalfi</h3>
      <ul class="space-y-4 text-slate-600">
        <li class="flex items-start gap-3">
          <span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span>
          <span class="text-slate-700"><strong>Ravello :</strong> 25 min bus ⭐</span>
        </li>
        <li class="flex items-start gap-3">
          <span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span>
          <span class="text-slate-700"><strong>Positano :</strong> 25 min ferry / 40 min bus</span>
        </li>
        <li class="flex items-start gap-3">
          <span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span>
          <span class="text-slate-700"><strong>Grotte d'Émeraude :</strong> 15 min bus</span>
        </li>
        <li class="flex items-start gap-3">
          <span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span>
          <span class="text-slate-700"><strong>Minori et Maiori :</strong> 15-20 min bus</span>
        </li>
        <li class="flex items-start gap-3">
          <span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span>
          <span class="text-slate-700"><strong>Cetara (capitale des anchois) :</strong> 30 min bus</span>
        </li>
        <li class="flex items-start gap-3">
          <span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span>
          <span class="text-slate-700"><strong>Salerne (pour trains au sud) :</strong> 35 min ferry</span>
        </li>
        <li class="flex items-start gap-3">
          <span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span>
          <span class="text-slate-700"><strong>Capri :</strong> 1h ferry (saisonnier)</span>
        </li>
      </ul>
    </div>
    <p class="text-slate-600 text-lg leading-relaxed mt-6">
      De plus, Amalfi a ses propres attractions valant chacune une demi-journée. La cathédrale normano-arabe, le Musée du Papier, l'Arsenal médiéval. Depuis Sorrente, aucune de celles-ci n'est une excursion rapide.
    </p>
  </div>

  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">Pour grands groupes ou familles 4+ : Sorrente</h2>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      La logistique de groupe favorise Sorrente. La ville est significativement plus grande (16 000 habitants vs 5 000), avec plus de locations de villas 4-5 chambres sur Airbnb et VRBO, restaurants qui gèrent confortablement groupes de 8-12 sans réservation, et grands supermarchés (Conad Superstore sur Corso Italia) qui rendent possible l'auto-restauration.
    </p>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      Transfert aéroport Naples : van privé 7 places Naples → Sorrente coûte €120-150 et prend 1 heure. Naples → Amalfi coûte €180-220 et prend 1h45 minimum, souvent 2h+ en été. Pour famille de 4-6, c'est une différence significative.
    </p>
    <div class="bg-med-cream p-8 rounded-[2rem] border border-med-gold/20">
      <h3 class="font-serif text-xl font-bold text-slate-900 mb-4">Checklist grand groupe/famille</h3>
      <table class="w-full text-sm">
        <tbody class="divide-y divide-med-gold/20">
          <tr><td class="py-2 font-semibold">Appartements 5+ chambres disponibles</td><td class="py-2">Sorrente : beaucoup · Amalfi : peu</td></tr>
          <tr><td class="py-2 font-semibold">Grand supermarché</td><td class="py-2">Sorrente ✓ (Conad) · Amalfi (petit)</td></tr>
          <tr><td class="py-2 font-semibold">Temps transfert aéroport</td><td class="py-2">Sorrente 1h · Amalfi 1h45+</td></tr>
          <tr><td class="py-2 font-semibold">Réservation restaurant 10+</td><td class="py-2">Sorrente ✓ · Amalfi limité</td></tr>
          <tr><td class="py-2 font-semibold">Gare ferroviaire</td><td class="py-2">Sorrente ✓ · Amalfi aucune</td></tr>
        </tbody>
      </table>
    </div>
  </div>

  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">Pour lunes de miel (si pas Positano) : Amalfi</h2>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      Honnêtement : la plupart des jeunes mariés choisissent Positano. Mais si vous voulez spécifiquement la Côte Amalfitaine et préférez la profondeur historique au charme de carte postale, Amalfi livre. Belmond Hotel Caruso (techniquement à Ravello mais avec l'ambiance Amalfi), Santa Caterina, Hotel Marina Riviera : la romance ici c'est dîners aux chandelles sur une terrasse du XIIe siècle, pas maisons aux couleurs pastel.
    </p>
    <p class="text-slate-600 text-lg leading-relaxed">
      Sorrente fonctionne pour lunes de miel seulement si votre voyage mélange Pompéi + Capri + romance. La ville elle-même est trop ville de travail pour paraître romantique : vous romancez sur le bateau coucher de soleil à Capri, pas à l'hôtel.
    </p>
  </div>

  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">Le verdict en 30 secondes</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8">
      <div class="bg-white p-6 rounded-[2rem] border border-slate-100 shadow-sm">
        <p class="text-med-gold text-[10px] font-bold uppercase tracking-[0.2em] mb-3">Choisissez Sorrente si :</p>
        <ul class="space-y-3 text-slate-600 text-sm">
          <li class="flex items-start gap-3"><span class="w-2 h-2 bg-med-gold rounded-full mt-2 flex-shrink-0"></span><span>Pompéi est sur la liste des incontournables</span></li>
          <li class="flex items-start gap-3"><span class="w-2 h-2 bg-med-gold rounded-full mt-2 flex-shrink-0"></span><span>Capri est une excursion incontournable</span></li>
          <li class="flex items-start gap-3"><span class="w-2 h-2 bg-med-gold rounded-full mt-2 flex-shrink-0"></span><span>Grande famille ou groupe (4+ personnes)</span></li>
          <li class="flex items-start gap-3"><span class="w-2 h-2 bg-med-gold rounded-full mt-2 flex-shrink-0"></span><span>Budget serré moins de €200/nuit</span></li>
          <li class="flex items-start gap-3"><span class="w-2 h-2 bg-med-gold rounded-full mt-2 flex-shrink-0"></span><span>Aéroport Naples in/out, sans voiture</span></li>
        </ul>
      </div>
      <div class="bg-white p-6 rounded-[2rem] border border-slate-100 shadow-sm">
        <p class="text-med-gold text-[10px] font-bold uppercase tracking-[0.2em] mb-3">Choisissez Amalfi si :</p>
        <ul class="space-y-3 text-slate-600 text-sm">
          <li class="flex items-start gap-3"><span class="w-2 h-2 bg-med-gold rounded-full mt-2 flex-shrink-0"></span><span>Le voyage concerne spécifiquement la Côte Amalfitaine</span></li>
          <li class="flex items-start gap-3"><span class="w-2 h-2 bg-med-gold rounded-full mt-2 flex-shrink-0"></span><span>Ravello Festival ou Ravello en général</span></li>
          <li class="flex items-start gap-3"><span class="w-2 h-2 bg-med-gold rounded-full mt-2 flex-shrink-0"></span><span>Vous voulez explorer Grotte d'Émeraude, Minori, Maiori, Cetara</span></li>
          <li class="flex items-start gap-3"><span class="w-2 h-2 bg-med-gold rounded-full mt-2 flex-shrink-0"></span><span>Voyageur culturel : histoire médiévale, cathédrales</span></li>
          <li class="flex items-start gap-3"><span class="w-2 h-2 bg-med-gold rounded-full mt-2 flex-shrink-0"></span><span>Lune de miel slow (Belmond, Santa Caterina)</span></li>
        </ul>
      </div>
    </div>
    <blockquote class="border-l-4 border-med-gold pl-6 mb-8">
      <p class="text-slate-700 text-lg font-serif italic leading-relaxed">
        "💡 Conseil local : l'itinéraire le plus intelligent de 7 jours divise les séjours : 3 nuits Sorrente (Pompéi mardi, Capri mercredi, Positano excursion jeudi), puis 4 nuits Amalfi (Ravello vendredi, Grotte d'Émeraude samedi, Minori dimanche, lenteur lundi). Vous voyez toute la région sans revenir en arrière et les billets bus/ferry coûtent autant que si vous étiez restés au même endroit."
      </p>
    </blockquote>
  </div>

  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">Tableau de comparaison rapide</h2>
    <div class="overflow-hidden rounded-[2rem] border border-slate-100 shadow-sm">
      <table class="w-full text-sm">
        <thead class="bg-slate-900 text-white">
          <tr>
            <th class="text-left p-4 font-bold text-med-gold">Caractéristique</th>
            <th class="text-left p-4 font-bold text-med-gold">Sorrente</th>
            <th class="text-left p-4 font-bold text-med-gold">Amalfi</th>
          </tr>
        </thead>
        <tbody class="bg-white">
          <tr class="border-b border-slate-100"><td class="p-4 font-semibold">Région</td><td class="p-4">Péninsule Sorrentine (Golfe de Naples)</td><td class="p-4">Centre Côte Amalfitaine</td></tr>
          <tr class="border-b border-slate-100"><td class="p-4 font-semibold">Distance Pompéi</td><td class="p-4">30 min train ⭐</td><td class="p-4">2h+ (bus + train)</td></tr>
          <tr class="border-b border-slate-100"><td class="p-4 font-semibold">Distance Ravello</td><td class="p-4">2h (bus + bus)</td><td class="p-4">25 min bus ⭐</td></tr>
          <tr class="border-b border-slate-100"><td class="p-4 font-semibold">Ferry Capri</td><td class="p-4">20 min, toute l'année</td><td class="p-4">1h, saisonnier</td></tr>
          <tr class="border-b border-slate-100"><td class="p-4 font-semibold">Gare ferroviaire</td><td class="p-4">Oui (Circumvesuviana)</td><td class="p-4">Non</td></tr>
          <tr class="border-b border-slate-100"><td class="p-4 font-semibold">Atmosphère</td><td class="p-4">Ville de travail, élégante</td><td class="p-4">Cité maritime médiévale</td></tr>
          <tr class="border-b border-slate-100"><td class="p-4 font-semibold">Coût moyen hôtel</td><td class="p-4">€120-300</td><td class="p-4">€150-450</td></tr>
          <tr><td class="p-4 font-semibold">Idéal pour</td><td class="p-4">Première visite, familles, amateurs de Pompéi</td><td class="p-4">Puristes Côte, fans Ravello, culturels</td></tr>
        </tbody>
      </table>
    </div>
  </div>

</BlogPostLayout>
