---
import BlogPostLayout from '../../../../layouts/BlogPostLayout.astro';

const lang = 'fr-fr';
const post = {
  title: 'Pompéi et Herculanum depuis Sorrente et Positano',
  subtitle: "Train, bus ou chauffeur vers les deux villes ensevelies par le Vésuve, avec billets 2026, horaires d'ouverture et une réponse claire sur laquelle choisir",
  category: 'GUIDE',
  date: '18 octobre 2026',
  readTime: '11 min',
  image: '/images/pompei-basilica-hero.webp',
  imageAlt: "Les colonnes en briques et la colonnade à deux niveaux de la Basilique de Pompéi",
  path: '/fr-fr/blog/pompei-herculanum-depuis-sorrente-positano/',
};

const metaTitle = 'Pompéi et Herculanum depuis Sorrente ou Positano 2026';
const metaDescription = "Rejoindre Pompéi et Herculanum depuis Sorrente et Positano : Circumvesuviana, bus SITA, prix des billets 2026, horaires d'ouverture et une journée type.";

const breadcrumbs = [
  { name: 'Accueil', url: '/fr-fr/' },
  { name: 'Blog', url: '/fr-fr/blog/' },
  { name: 'Pompéi et Herculanum depuis Sorrente et Positano', url: '/fr-fr/blog/pompei-herculanum-depuis-sorrente-positano/' },
];

const quickInfo = [
  { label: 'Sorrente-Pompéi', value: 'Circumvesuviana, env. 35 à 45 min' },
  { label: 'Sorrente-Herculanum', value: 'Circumvesuviana, env. 1 h' },
  { label: 'Positano-Pompéi', value: 'Bus SITA + train, 2 h ou plus' },
  { label: 'Billet Pompéi', value: 'Dès 20 € (Express), 25 € (Pompeii+)' },
  { label: 'Billet Herculanum', value: '16 € plein tarif' },
  { label: 'Horaires d\'hiver', value: 'Dernière entrée 15h30 sur les deux sites' },
  { label: 'Entrée gratuite', value: 'Premier dimanche de chaque mois' },
  { label: 'Temps nécessaire', value: 'Herculanum 2 h, Pompéi 3 à 4 h' },
];

const faq = [
  {
    q: 'Comment aller de Sorrente à Pompéi ?',
    a: "Prenez la Circumvesuviana, ligne Napoli-Sorrento, à la gare de Sorrente et descendez à Pompei Scavi-Villa dei Misteri. Le trajet dure environ 35 à 45 minutes et l'entrée de Porta Marina est à quelques minutes à pied du quai. Ne descendez pas à Pompei Santuario, sur une autre ligne, qui dessert l'entrée de l'amphithéâtre. L'horaire EAV en vigueur depuis le 17 octobre 2026 prévoit un train toutes les 30 minutes depuis et vers Sorrente.",
  },
  {
    q: 'Existe-t-il un bus direct de Positano à Pompéi ?',
    a: "Pas un sur lequel on peut compter. Nous n'avons pu confirmer aucun bus public direct entre Positano et Pompéi pour l'automne et l'hiver 2026. L'itinéraire public fiable est le bus SITA de Positano à Sorrente, environ 50 minutes avec une circulation normale, puis la Circumvesuviana. Sinon : voiture de location, chauffeur privé ou excursion organisée.",
  },
  {
    q: 'Le Campania Express circule-t-il ?',
    a: "Pas en ce moment. Le train touristique avait repris le 28 mars 2026 avec des arrêts à Ercolano, Pompei et Castellammare, mais EAV l'a suspendu à partir du 1er octobre 2026 jusqu'à nouvel ordre. Les détenteurs de billets pour des dates ultérieures peuvent demander un remboursement via le formulaire de réclamation d'EAV. Vérifiez eavsrl.it avant le printemps prochain.",
  },
  {
    q: 'Combien coûte le billet pour Pompéi en 2026 ?',
    a: "Depuis le 12 janvier 2026, le billet Pompeii Express, cité antique seule, coûte 20 € et Pompeii+ coûte 25 €, avec en plus la villa des Mystères, la villa de Diomède, la Villa Regina à Boscoreale et la navette. Les citoyens de l'UE de 18 à 24 ans paient 2 €. Les billets sont nominatifs, prévoyez une pièce d'identité. Achat sur le site officiel Vivaticket ou aux guichets du parc.",
  },
  {
    q: "Pompéi ou Herculanum, si je n'ai le temps que pour un seul ?",
    a: "Herculanum si vous avez une demi-journée, cherchez de l'ombre et moins de monde et aimez les détails : poutres en bois, étages et pièces peintes y sont conservés. Pompéi si vous voulez l'échelle d'une ville romaine entière, avec forum, théâtres, amphithéâtre et longues rues pavées, et disposez d'au moins trois ou quatre heures.",
  },
  {
    q: 'Peut-on visiter les deux en une journée ?',
    a: "Oui, ils sont à environ 20 à 25 minutes l'un de l'autre sur la même ligne. Depuis Sorrente, cela fonctionne si vous partez tôt, avec Herculanum le matin et Pompéi l'après-midi en hiver. Depuis Positano, la journée devient très longue : mieux vaut deux jours séparés ou un chauffeur.",
  },
];

const sidebarLinks = [
  { label: 'Sorrente', href: '/fr-fr/peninsule-sorrentine/sorrente/' },
  { label: 'Positano', href: '/fr-fr/cote-amalfitaine/positano/' },
  { label: 'Sorrente, Pompéi et histoire en 3 jours', href: '/fr-fr/itineraires/3-jours/sorrente-pompei-histoire/' },
  { label: 'Bus SITA', href: '/fr-fr/guide/bus-sita/' },
  { label: 'La côte amalfitaine en train', href: '/fr-fr/blog/cote-amalfitaine-en-train/' },
  { label: 'Comment venir', href: '/fr-fr/guide/comment-venir/' },
];

const authorRole = 'Spécialiste Côte Amalfitaine';

const relatedArticles = [
  {
    title: 'La côte amalfitaine en train',
    category: 'GUIDE',
    date: '10 août 2026',
    image: '/images/treno-costiera-hero.webp',
    imageAlt: 'La côte amalfitaine en train',
    path: '/fr-fr/blog/cote-amalfitaine-en-train/'
  },
  {
    title: 'Sorrente ou Positano : Où Loger sur la Côte Amalfitaine',
    category: 'GUIDE',
    date: '15 juin 2026',
    image: '/images/sorrento-vs-positano-hero.webp',
    imageAlt: 'Sorrente et Positano comparés',
    path: '/fr-fr/blog/sorrento-vs-positano/'
  }
];

const keyTakeaways = [
  "Depuis Sorrente, les deux sites sont sur la même ligne de la Circumvesuviana : environ 35 à 45 minutes jusqu'à Pompei Scavi-Villa dei Misteri et environ une heure jusqu'à Ercolano Scavi, avec un train toutes les 30 minutes selon l'horaire en vigueur depuis le 17 octobre 2026.",
  "Depuis Positano, aucun transport public direct fiable. Prenez le bus SITA jusqu'à Sorrente puis le train, ou bien voiture, chauffeur privé ou excursion.",
  "Le train touristique Campania Express est suspendu depuis le 1er octobre 2026 jusqu'à nouvel ordre : pour l'instant, il reste le train de banlieue ordinaire.",
  "Depuis le 12 janvier 2026, Pompéi coûte 20 € (Express) ou 25 € (Pompeii+), avec des billets nominatifs et un plafond de 20 000 entrées par jour. Herculanum coûte 16 €.",
  "Du 15 octobre au 15 mars, la dernière entrée est à 15h30 sur les deux sites. Les deux sont gratuits le premier dimanche de chaque mois, sans réservation en ligne.",
];
---

<BlogPostLayout
  lang={lang}
  post={post}
  metaTitle={metaTitle}
  metaDescription={metaDescription}
  breadcrumbs={breadcrumbs}
  quickInfo={quickInfo}
  faq={faq}
  sidebarLinks={sidebarLinks}
  authorRole={authorRole}
  relatedArticles={relatedArticles}
  pageKey="pompeii-herculaneum-from-sorrento"
>

  <!-- Key Takeaways -->
  <div class="bg-slate-900 text-white p-8 rounded-[2rem]">
    <div class="flex items-center gap-3 mb-6">
      <svg class="w-5 h-5 text-med-gold flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
      <h2 class="font-serif text-lg font-bold text-med-gold uppercase tracking-[0.15em]">Points Clés</h2>
    </div>
    <ul class="space-y-4">
      {keyTakeaways.map((point) => (
        <li class="flex items-start gap-3">
          <span class="w-1.5 h-1.5 rounded-full bg-med-gold flex-shrink-0 mt-2"></span>
          <span class="text-white/80 text-xs sm:text-sm leading-relaxed">{point}</span>
        </li>
      ))}
    </ul>
  </div>

  <!-- Intro -->
  <div>
    <p class="text-slate-600 text-xl leading-relaxed mb-6 font-light">
      Pompéi et Herculanum se trouvent sur la même voie ferrée entre Naples et <a href="/fr-fr/peninsule-sorrentine/sorrente/" class="text-med-blue hover:underline">Sorrente</a>, et pour qui séjourne sur la péninsule, c'est l'excursion évidente. Depuis Sorrente, un train suffit. Depuis <a href="/fr-fr/cote-amalfitaine/positano/" class="text-med-blue hover:underline">Positano</a>, il faut davantage d'organisation, car le train s'arrête à Sorrente et la route côtière est lente. Ce guide couvre les deux points de départ, les règles de billetterie modifiées en 2026, les horaires d'hiver et d'été, et comment choisir entre les deux sites si vous n'avez le temps que pour un seul.
    </p>
  </div>

  <!-- Which one -->
  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">Pompéi ou Herculanum ?</h2>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      Toutes deux ont été détruites par l'éruption du Vésuve en 79 apr. J.-C., mais elles ont été ensevelies différemment et, sur place, elles ne se ressemblent pas. Pompéi a été recouverte de cendres et de pierres ponces ; c'était une grande ville commerçante et sa surface fouillée est environ dix fois celle d'Herculanum. Herculanum, ville côtière plus petite et plus riche, a disparu sous une vingtaine de mètres de matériaux volcaniques qui l'ont scellée plus complètement : c'est pourquoi poutres en bois, escaliers, étages et pièces peintes y sont conservés comme on le voit rarement à Pompéi.
    </p>

    <div class="overflow-x-auto rounded-[2rem] border border-slate-100 shadow-sm mb-6">
      <table class="w-full text-xs sm:text-sm">
        <thead class="bg-slate-900 text-white">
          <tr>
            <th class="text-left p-5 font-serif font-bold text-med-gold"></th>
            <th class="text-left p-5 font-serif font-bold text-med-gold">Pompéi</th>
            <th class="text-left p-5 font-serif font-bold text-med-gold">Herculanum</th>
          </tr>
        </thead>
        <tbody class="bg-white">
          <tr class="border-b border-slate-100">
            <td class="p-5 font-bold">Taille</td>
            <td class="p-5 text-slate-600">Une ville entière, de longues marches entre les zones</td>
            <td class="p-5 text-slate-600">Compacte, vue d'en haut et parcourue en boucle</td>
          </tr>
          <tr class="border-b border-slate-100">
            <td class="p-5 font-bold">Temps nécessaire</td>
            <td class="p-5 text-slate-600">3 à 4 heures minimum, une journée se remplit vite</td>
            <td class="p-5 text-slate-600">Environ 2 heures</td>
          </tr>
          <tr class="border-b border-slate-100">
            <td class="p-5 font-bold">Conservation</td>
            <td class="p-5 text-slate-600">Plan urbain, forum, théâtres, amphithéâtre, fresques</td>
            <td class="p-5 text-slate-600">Étages, bois, mobilier, intérieurs intacts</td>
          </tr>
          <tr class="border-b border-slate-100">
            <td class="p-5 font-bold">Depuis Sorrente</td>
            <td class="p-5 text-slate-600">Env. 35 à 45 min jusqu'à Pompei Scavi-Villa dei Misteri</td>
            <td class="p-5 text-slate-600">Env. 1 h jusqu'à Ercolano Scavi, puis 6 min à pied</td>
          </tr>
          <tr class="border-b border-slate-100">
            <td class="p-5 font-bold">Plein tarif 2026</td>
            <td class="p-5 text-slate-600">20 € Express, 25 € Pompeii+</td>
            <td class="p-5 text-slate-600">16 €</td>
          </tr>
          <tr class="border-b border-slate-100">
            <td class="p-5 font-bold">Affluence</td>
            <td class="p-5 text-slate-600">Jusqu'à 20 000 par jour, grands groupes</td>
            <td class="p-5 text-slate-600">Bien moins, plus calme l'après-midi</td>
          </tr>
          <tr>
            <td class="p-5 font-bold">Ombre</td>
            <td class="p-5 text-slate-600">Très peu, éprouvant en juillet et août</td>
            <td class="p-5 text-slate-600">Plus de pièces couvertes, distances courtes</td>
          </tr>
        </tbody>
      </table>
    </div>

    <p class="text-slate-600 text-lg leading-relaxed">
      Notre avis : pour une première visite avec une journée entière, Pompéi, parce que rien d'autre ne donne aussi bien la mesure d'une ville romaine complète. Pour une demi-journée, pour les familles avec de jeunes enfants, pour ceux qui supportent mal la chaleur ou les longues marches, ou pour qui connaît déjà Pompéi, Herculanum est le meilleur usage du temps. Notez que la villa des Papyrus et le théâtre antique d'Herculanum sont actuellement fermés pour travaux, sans date de réouverture annoncée.
    </p>
  </div>

  <!-- From Sorrento -->
  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">Depuis Sorrente : la Circumvesuviana</h2>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      Sorrente est le terminus de la Circumvesuviana Napoli-Sorrento, exploitée par EAV, et les deux sites ont leur propre gare sur cette ligne. C'est un train de banlieue, pas un service touristique : pas de porte-bagages, souvent debout aux heures chargées et une réputation de pickpockets bien méritée. Il reste le moyen le plus rapide.
    </p>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-6">
      <div class="bg-white p-6 rounded-[2rem] border border-slate-100 shadow-sm">
        <h4 class="font-bold text-slate-900 mb-2">Pour Pompéi</h4>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Descendez à Pompei Scavi-Villa dei Misteri, environ 35 à 45 minutes depuis Sorrente. Les entrées de Porta Marina et de la Piazza Esedra sont à quelques minutes à pied. Pompei Santuario se trouve sur la ligne de Poggiomarino et dessert l'entrée Piazza Anfiteatro : ce n'est pas l'arrêt pour les trains venant de Sorrente.</p>
      </div>
      <div class="bg-white p-6 rounded-[2rem] border border-slate-100 shadow-sm">
        <h4 class="font-bold text-slate-900 mb-2">Pour Herculanum</h4>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Descendez à Ercolano Scavi, environ une heure depuis Sorrente. Selon le parc, l'entrée au 187 Corso Resina est à 6 minutes à pied en descente depuis la gare, soit 6 minutes de montée au retour.</p>
      </div>
      <div class="bg-white p-6 rounded-[2rem] border border-slate-100 shadow-sm">
        <h4 class="font-bold text-slate-900 mb-2">Fréquence</h4>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Le nouvel horaire EAV des lignes vésuviennes, en vigueur depuis le 17 octobre 2026, prévoit un train toutes les 30 minutes depuis et vers Sorrente. Vérifiez les départs du jour sur orariotreni.eavsrl.it et repérez le dernier train de retour avant de partir.</p>
      </div>
      <div class="bg-white p-6 rounded-[2rem] border border-slate-100 shadow-sm">
        <h4 class="font-bold text-slate-900 mb-2">Billets</h4>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Un aller simple depuis Sorrente coûte quelques euros (les guides récents indiquent environ 3,30 € jusqu'à Pompei Scavi). EAV précise que ses propres titres ne sont pas concernés par l'ajustement tarifaire régional du 1er octobre 2026. Achat en gare, ou carte sans contact aux portiques Tap&amp;Go là où ils sont installés, avec la même carte à l'entrée et à la sortie.</p>
      </div>
    </div>

    <h3 class="font-serif text-2xl font-bold text-slate-900 mb-4">Et le Campania Express ?</h3>
    <p class="text-slate-600 text-lg leading-relaxed">
      Le Campania Express est la version touristique d'EAV sur la même ligne : places réservées, climatisation, espace pour les bagages et arrêts seulement à Ercolano, Pompei, Castellammare et dans les principales gares de la péninsule. Il avait repris le 28 mars 2026 avec huit trajets par jour, mais EAV l'a suspendu à partir du <strong>1er octobre 2026 jusqu'à nouvel ordre</strong>. Si vous avez acheté un billet pour une date ultérieure, EAV rembourse via son formulaire de réclamation, ou le revendeur si vous avez réservé par un tiers. Pour un voyage au printemps 2027, vérifiez sur eavsrl.it s'il a repris avant de compter dessus.
    </p>
  </div>

  <!-- From Positano -->
  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">Depuis Positano : bus, voiture ou chauffeur</h2>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      Positano n'a pas de gare, et les monts Lattari séparent le village de la plaine du Vésuve. Chaque option contourne la péninsule par l'ouest via Sorrente ou passe par les collines, et chacune a ses inconvénients.
    </p>
    <ul class="space-y-3 mb-6">
      <li class="flex items-start gap-3"><span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span><span class="text-slate-700"><strong>Bus SITA et train.</strong> Le <a href="/fr-fr/guide/bus-sita/" class="text-med-blue hover:underline">bus SITA</a> de Positano à Sorrente met environ 50 minutes avec une circulation normale et s'arrête près de la gare, puis la Circumvesuviana comme ci-dessus. Comptez deux heures ou plus par trajet jusqu'à Pompéi, davantage pour Herculanum. Les billets de bus s'achètent avant de monter, et SITA Sud a ajusté ses tarifs au 1er octobre 2026.</span></li>
      <li class="flex items-start gap-3"><span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span><span class="text-slate-700"><strong>Bateau pour Sorrente en saison.</strong> Quand les ferries côtiers circulent, le bateau de Positano à Sorrente évite la file d'attente du bus en été. Ils sont saisonniers et s'arrêtent l'hiver : consultez notre <a href="/fr-fr/guide/ferries/" class="text-med-blue hover:underline">guide des ferries</a> pour vos dates.</span></li>
      <li class="flex items-start gap-3"><span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span><span class="text-slate-700"><strong>Bus direct.</strong> Nous n'avons pu confirmer aucun bus public direct de Positano à Pompéi pour l'automne et l'hiver 2026. Les calculateurs d'itinéraires affichent un autocar longue distance certains jours, mais sans horaire publié par l'opérateur, nous n'organiserions pas une journée autour.</span></li>
      <li class="flex items-start gap-3"><span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span><span class="text-slate-700"><strong>Voiture.</strong> Pompéi est sur l'autoroute A3 Napoli-Salerno, sortie Pompei Scavi. Depuis Positano, comptez environ une heure à une heure et demie selon la circulation, bien plus les week-ends d'été, plus le stationnement payant près des entrées. Lisez nos conseils sur le <a href="/fr-fr/guide/parking-ztl/" class="text-med-blue hover:underline">stationnement et les ZTL</a> avant de louer.</span></li>
      <li class="flex items-start gap-3"><span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span><span class="text-slate-700"><strong>Chauffeur privé ou excursion.</strong> La solution la plus chère et la moins fatigante. Un chauffeur vous dépose à un site, vous reprend à l'autre et vous ramène à Positano pour le dîner : c'est la seule façon de faire les deux sites dans la journée depuis Positano sans s'épuiser. Les excursions de groupe depuis Positano et Sorrente incluent en général un guide et évitent le train.</span></li>
    </ul>

    <div class="overflow-x-auto rounded-[2rem] border border-slate-100 shadow-sm">
      <table class="w-full text-xs sm:text-sm">
        <thead class="bg-slate-900 text-white">
          <tr>
            <th class="text-left p-5 font-serif font-bold text-med-gold">Trajet</th>
            <th class="text-left p-5 font-serif font-bold text-med-gold">Comment</th>
            <th class="text-left p-5 font-serif font-bold text-med-gold">Durée</th>
          </tr>
        </thead>
        <tbody class="bg-white">
          <tr class="border-b border-slate-100">
            <td class="p-5 font-bold">Sorrente-Pompéi</td>
            <td class="p-5 text-slate-600">Circumvesuviana jusqu'à Pompei Scavi-Villa dei Misteri</td>
            <td class="p-5 text-slate-600">35 à 45 min</td>
          </tr>
          <tr class="border-b border-slate-100">
            <td class="p-5 font-bold">Sorrente-Herculanum</td>
            <td class="p-5 text-slate-600">Circumvesuviana jusqu'à Ercolano Scavi</td>
            <td class="p-5 text-slate-600">Env. 1 h</td>
          </tr>
          <tr class="border-b border-slate-100">
            <td class="p-5 font-bold">Herculanum-Pompéi</td>
            <td class="p-5 text-slate-600">Circumvesuviana, même ligne</td>
            <td class="p-5 text-slate-600">20 à 25 min</td>
          </tr>
          <tr class="border-b border-slate-100">
            <td class="p-5 font-bold">Positano-Pompéi</td>
            <td class="p-5 text-slate-600">Bus SITA jusqu'à Sorrente, puis train</td>
            <td class="p-5 text-slate-600">2 h ou plus</td>
          </tr>
          <tr>
            <td class="p-5 font-bold">Positano-Pompéi</td>
            <td class="p-5 text-slate-600">Voiture ou chauffeur privé</td>
            <td class="p-5 text-slate-600">Env. 1 h à 1 h 30, selon la circulation</td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>

  <!-- Tickets and hours -->
  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">Billets et horaires 2026</h2>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      Les prix et règles ci-dessous sont ceux publiés par le Parco Archeologico di Pompei et le Parco Archeologico di Ercolano au moment de la rédaction. Les deux parcs modifient les détails à court préavis, vérifiez donc les pages officielles avant de partir.
    </p>

    <h3 class="font-serif text-2xl font-bold text-slate-900 mb-4">Pompéi</h3>
    <ul class="space-y-3 mb-6">
      <li class="flex items-start gap-3"><span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span><span class="text-slate-700"><strong>Pompeii Express, 20 €.</strong> La cité antique seule. La villa des Mystères, hors les murs, n'est pas comprise, mais on peut ajouter les villas suburbaines pour 8 € par carte à la Porta Ercolano.</span></li>
      <li class="flex items-start gap-3"><span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span><span class="text-slate-700"><strong>Pompeii+, 25 €.</strong> Ajoute la villa des Mystères, la villa de Diomède, la Villa Regina à Boscoreale et la navette entre les sites.</span></li>
      <li class="flex items-start gap-3"><span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span><span class="text-slate-700"><strong>Pompeii Plus, 30 €.</strong> Valable trois jours, une entrée par site, avec en plus Oplontis, Stabies et Boscoreale.</span></li>
      <li class="flex items-start gap-3"><span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span><span class="text-slate-700"><strong>Tarif réduit, 2 €.</strong> Citoyens de l'UE de 18 à 24 ans. Les moins de 18 ans entrent gratuitement selon les règles des musées d'État italiens. Ces prix s'appliquent depuis le 12 janvier 2026.</span></li>
      <li class="flex items-start gap-3"><span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span><span class="text-slate-700"><strong>Billets nominatifs.</strong> Chaque billet porte le nom du visiteur, n'est pas cessible et n'est pas remboursable sauf fermeture exceptionnelle. Le personnel peut demander une pièce d'identité à l'entrée. Le plafond est de 20 000 entrées par jour, sans possibilité de ressortir et revenir.</span></li>
      <li class="flex items-start gap-3"><span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span><span class="text-slate-700"><strong>Créneaux en haute saison.</strong> Du 16 mars au 14 octobre, l'accès est divisé en un créneau de 9h00 à 13h00 et un de 13h00 à 17h30, chacun avec son quota. Réservation en ligne sur le site officiel Vivaticket ou achat aux entrées.</span></li>
    </ul>

    <h3 class="font-serif text-2xl font-bold text-slate-900 mb-4">Herculanum</h3>
    <ul class="space-y-3 mb-6">
      <li class="flex items-start gap-3"><span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span><span class="text-slate-700"><strong>Plein tarif, 16 €.</strong> Réduit à 2 € pour les 18 à 24 ans, gratuit pour les catégories prévues par la loi. Les moins de 12 ans doivent être accompagnés.</span></li>
      <li class="flex items-start gap-3"><span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span><span class="text-slate-700"><strong>Ercolano Card, 30 €.</strong> Valable 365 jours à partir de la première utilisation, intéressante seulement si vous comptez revenir. La Campania Artecard est aussi acceptée, à activer au guichet.</span></li>
      <li class="flex items-start gap-3"><span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span><span class="text-slate-700"><strong>Ouvert tous les jours sauf le 25 décembre.</strong> Billets en ligne depuis la page billetterie du parc et au guichet.</span></li>
    </ul>

    <div class="overflow-x-auto rounded-[2rem] border border-slate-100 shadow-sm mb-6">
      <table class="w-full text-xs sm:text-sm">
        <thead class="bg-slate-900 text-white">
          <tr>
            <th class="text-left p-5 font-serif font-bold text-med-gold">Période</th>
            <th class="text-left p-5 font-serif font-bold text-med-gold">Pompéi</th>
            <th class="text-left p-5 font-serif font-bold text-med-gold">Herculanum</th>
          </tr>
        </thead>
        <tbody class="bg-white">
          <tr class="border-b border-slate-100">
            <td class="p-5 font-bold">15 octobre au 15 mars</td>
            <td class="p-5 text-slate-600">9h00 à 17h00, dernière entrée 15h30</td>
            <td class="p-5 text-slate-600">8h30 à 17h00, dernière entrée 15h30, sortie du site avant 16h40</td>
          </tr>
          <tr class="border-b border-slate-100">
            <td class="p-5 font-bold">16 mars au 14 octobre</td>
            <td class="p-5 text-slate-600">9h00 à 19h00, dernière entrée 17h30</td>
            <td class="p-5 text-slate-600">8h30 à 19h30, dernière entrée 18h00</td>
          </tr>
          <tr>
            <td class="p-5 font-bold">Fermeture</td>
            <td class="p-5 text-slate-600">25 décembre et 1er janvier</td>
            <td class="p-5 text-slate-600">25 décembre</td>
          </tr>
        </tbody>
      </table>
    </div>

    <h3 class="font-serif text-2xl font-bold text-slate-900 mb-4">Les premiers dimanches gratuits</h3>
    <p class="text-slate-600 text-lg leading-relaxed">
      Les deux parcs sont gratuits le premier dimanche de chaque mois dans le cadre de l'initiative Domenica al Museo du ministère. À Pompéi, ces jours-là, pas de réservation en ligne ni de billet nominatif : on passe directement les tourniquets, le plafond de 20 000 entrées par jour restant en vigueur. À Herculanum, pas de réservation non plus, et le billet gratuit se retire au guichet le jour même. Herculanum est aussi gratuit le 25 avril, le 2 juin et le 4 novembre. Les prochains premiers dimanches sont le <strong>1er novembre 2026</strong> (également férié), le <strong>6 décembre 2026</strong> et le <strong>3 janvier 2027</strong>. Attendez-vous à de longues files et à des sites bondés : gratuit ne veut pas dire confortable.
    </p>
  </div>

  <!-- One day or two -->
  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">Les deux en un jour ou sur deux jours ?</h2>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      Depuis Sorrente, une journée pour les deux est réaliste. Les deux gares sont à 20 à 25 minutes l'une de l'autre, Herculanum demande environ deux heures et Pompéi trois à quatre. Le piège, ce sont les horaires d'hiver : avec une dernière entrée à 15h30, il faut être à Pompéi en début d'après-midi, donc commencer Herculanum dès l'ouverture. En été, l'ordre s'inverse : Pompéi dès le matin pour les heures plus fraîches, Herculanum l'après-midi car la dernière entrée y est plus tardive.
    </p>
    <p class="text-slate-600 text-lg leading-relaxed">
      Depuis Positano, ajoutez environ une heure par trajet entre le bus et l'attente à l'arrêt, et une journée pour les deux devient une sortie de douze heures. Mieux vaut les répartir sur deux jours, dormir une nuit à Sorrente comme dans notre <a href="/fr-fr/itineraires/3-jours/sorrente-pompei-histoire/" class="text-med-blue hover:underline">itinéraire de trois jours Sorrente, Pompéi et histoire</a>, ou réserver un chauffeur.
    </p>
  </div>

