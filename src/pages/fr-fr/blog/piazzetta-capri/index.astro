---
import BlogPostLayout from '../../../../layouts/BlogPostLayout.astro';

const lang = 'fr-fr';
const post = {
  title: 'La Piazzetta de Capri : Le salon du monde',
  subtitle: 'Histoire, cafes historiques et vie mondaine de la place la plus celebre de la Mediterranee',
  category: 'DÉCOUVERTES',
  date: '8 juillet 2026',
  readTime: '9 min',
  image: '/images/piazzetta-capri-hero.webp',
  imageAlt: 'La Piazzetta de Capri au coucher du soleil, avec la tour de l horloge et les cafes historiques',
  path: '/fr-fr/blog/piazzetta-capri/',
};

const metaTitle = 'La Piazzetta de Capri : Histoire, cafes et vie mondaine de l ile';
const metaDescription = 'Guide de la Piazzetta de Capri (Piazza Umberto I) : histoire du "salon du monde", les cafes Bar Tiberio, Caso, Vermouth, la Tour de l horloge, la Cathedrale Santo Stefano et les celebrites.';

const breadcrumbs = [
  { name: 'Accueil', url: '/fr-fr/' },
  { name: 'Blog', url: '/fr-fr/blog/' },
  { name: 'La Piazzetta de Capri', url: '/fr-fr/blog/piazzetta-capri/' },
];

const quickInfo = [
  { label: 'Nom officiel', value: 'Piazza Umberto I' },
  { label: 'Surnom', value: '"Le salon du monde"' },
  { label: 'Dimensions', value: 'Environ 250 m2 (tres petite)' },
  { label: 'Cafes historiques', value: 'Bar Tiberio, Caso, Vermouth, Piccolo Bar' },
  { label: 'Monuments', value: 'Tour de l horloge, Cathedrale Santo Stefano' },
  { label: 'Meilleur moment', value: 'Aperitif (18h-20h)' },
  { label: 'Acces', value: 'Du Funiculaire en 1 minute' },
  { label: 'Espresso', value: '3-5 EUR assis' },
];

const faq = [
  { q: 'Pourquoi la Piazzetta de Capri s appelle-t-elle "salon du monde" ?', a: 'Le surnom est ne dans les annees 50, quand la Piazzetta devint le point de rendez-vous de toute la jet-set internationale : Sophia Loren, Brigitte Bardot, Onassis, Jackie Kennedy, Federico Fellini, le Shah de Perse. La petite place (seulement 250 m2) rassemblait simultanement acteurs hollywoodiens, magnats grecs, intellectuels italiens et noblesse europeenne. Le journaliste Curzio Malaparte a forge la formule "salon du monde".' },
  { q: 'Quels sont les cafes historiques de la Piazzetta ?', a: 'Les quatre cafes symboles sont : Bar Tiberio (le plus ancien, fonde en 1909), Caso (lieu historique des intellectuels), Vermouth (aujourd hui Gran Caffe, deja frequente dans les annees 30), et Piccolo Bar. Tous ont des tables en terrasse. Un espresso assis coute 3-5 euros, un Aperol Spritz 12-15 euros. Le prix inclut la "scenographie".' },
  { q: 'Que voir sur la Piazzetta ?', a: 'Trois monuments definissent la Piazzetta : (1) la Tour de l horloge, ancienne tour civique avec horloge du XVII siecle ; (2) la Cathedrale Santo Stefano (1685), de style baroque, avec sol en majolique et autel de marbres polychromes ; (3) les quatre cafes historiques disposes sur les cotes. Tout en 50 metres carres d intensite.' },
  { q: 'Comment rejoindre la Piazzetta de Capri ?', a: 'Du port de Marina Grande le Funiculaire arrive directement a la Piazzetta en 4 minutes (billet ~2 euros). C est le moyen le plus rapide et scenographique. Sinon, bus ATC (~2 euros) ou a pied (45 minutes de montee). Depuis Anacapri on arrive en bus en 15 minutes.' },
  { q: 'Quel est le meilleur moment pour visiter la Piazzetta ?', a: 'L heure de l aperitif (entre 18h et 20h) est le moment symbole. La lumiere doree, la passeggiata des Capresi qui rentrent du travail, l ouverture des vitrines, la musique. En haute saison le matin tot (avant 10h) est poetique et presque desert. A eviter l apres-midi en aout, quand c est tres frequente.' },
  { q: 'Combien coute un cafe sur la Piazzetta ?', a: 'Un espresso au comptoir coute environ 1,50 euro (prix italien standard). Le meme espresso en terrasse coute 3-5 euros : on paie le panorama, la position, la scenographie. Un Aperol Spritz assis va de 12 a 18 euros. C est l une des places les plus cheres d Italie, mais l experience vaut au moins une fois dans une vie.' },
];

const sidebarLinks = [
  { label: 'Capri', href: '/fr-fr/iles/capri/' },
  { label: 'Anacapri', href: '/fr-fr/iles/anacapri/' },
  { label: 'Jardins de Tibere et Via Krupp', href: '/fr-fr/blog/jardins-tibere-via-krupp/' },
  { label: 'Ferries pour Capri', href: '/fr-fr/guide/ferries/' },
  { label: 'Tours en bateau', href: '/fr-fr/experiences/tours-en-bateau/' },
];

const relatedArticles = [
  {
    title: 'Jardins de Tibere et Via Krupp',
    category: 'DÉCOUVERTES',
    date: '19 mai 2026',
    image: '/images/giardini-tiberio-via-krupp-hero.webp',
    imageAlt: 'Via Krupp vue des Jardins d Auguste, Capri',
    path: '/fr-fr/blog/jardins-tibere-via-krupp/'
  },
  {
    title: 'Capri vs Ischia',
    category: 'GUIDES',
    date: '4 juin 2026',
    image: '/images/capri-vs-ischia-hero.webp',
    imageAlt: 'Capri et Ischia comparees : glamour vs authenticite',
    path: '/fr-fr/blog/capri-vs-ischia/'
  }
];

const authorRole = 'Editeur patrimoine · Ile de Capri';
---

<BlogPostLayout
  lang={lang}
  post={post}
  metaTitle={metaTitle}
  metaDescription={metaDescription}
  breadcrumbs={breadcrumbs}
  quickInfo={quickInfo}
  faq={faq}
  sidebarLinks={sidebarLinks}
  authorRole={authorRole}
  relatedArticles={relatedArticles}
  pageKey="piazzetta-capri"
>

  <!-- Intro -->
  <div>
    <p class="text-slate-600 text-xl leading-relaxed mb-6 font-light">
      Elle s appelle Piazza Umberto I, mais a Capri on l appelle simplement "la Piazzetta". Deux cent cinquante metres carres, quatre cafes historiques, une tour civique et une cathedrale baroque : c est l une des plus petites places d Italie, et probablement la plus celebre du monde. Dans les annees 50, le journaliste Curzio Malaparte la baptisa "le salon du monde", surnom qui resiste encore aujourd hui.
    </p>
    <p class="text-slate-600 text-lg leading-relaxed">
      La Piazzetta est le point ou Capri se reunit : des pecheurs qui montent de Marina Grande par le Funiculaire aux touristes a peine debarques, des intellectuels aux stars hollywoodiennes. Peu de places mediterraneennes concentrent une telle intensite de vie, d histoire et de mondanite. Voici le guide pour la comprendre vraiment.
    </p>
  </div>

  <!-- History -->
  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">La Piazzetta : Du marche au salon du monde</h2>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      Au Moyen Age, la Piazzetta etait l esplanade devant la Cathedrale Santo Stefano, siege du marche citadin et du Sedile di Capri (organe d auto-gouvernement de l ile). Une place de travail et d administration, non de mondanite. Ainsi resta-t-elle pendant des siecles, jusqu a la fin du XIX siecle.
    </p>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      La transformation commenca au debut du XX siecle, quand Capri commenca a attirer ecrivains, artistes et intellectuels en fuite des grandes capitales europeennes : Norman Douglas, Maxim Gorki, Compton Mackenzie. La Piazzetta devint leur point de rendez-vous de l apres-midi, le lieu ou l on discutait de litterature et politique devant un cafe.
    </p>
    <div class="bg-white p-8 rounded-[2rem] border border-slate-100 shadow-sm my-8">
      <h3 class="font-serif text-xl font-bold text-slate-900 mb-4">Les annees 50 : l explosion</h3>
      <p class="text-slate-600 leading-relaxed mb-4">
        C est dans l apres-guerre que Capri devint le symbole de la Dolce Vita mediterraneenne. Dans les annees 50 et 60, la Piazzetta accueillait simultanement Sophia Loren et Vittorio De Sica, Brigitte Bardot, Aristote Onassis et Maria Callas, Jackie Kennedy, Audrey Hepburn, le Shah de Perse, Federico Fellini, Roberto Rossellini. Une concentration de celebrites au metre carre sans comparaison.
      </p>
      <p class="text-slate-600 leading-relaxed">
        C est en ces annees-la que Curzio Malaparte, ecrivain en residence dans la celebre Villa Malaparte sur Punta Massullo, definit la Piazzetta comme "le salon du monde". Le surnom se diffusa dans la presse internationale et devint la formule par laquelle elle est encore identifiee aujourd hui.
      </p>
    </div>
    <p class="text-slate-600 text-lg leading-relaxed">
      Aujourd hui la Piazzetta reste le coeur social de <a href="/fr-fr/iles/capri/" class="text-med-blue hover:underline">Capri</a> : le meme lieu ou les Capresi s arretent pour le cafe du matin et ou les touristes s assoient au coucher du soleil pour admirer la tour de l horloge. Cent ans d histoire mondaine qui continuent.
    </p>
  </div>

  <!-- Cafes -->
  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">Les quatre cafes historiques</h2>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      Quatre cafes disposes aux cotes de la Piazzetta ont ecrit l histoire mondaine de l ile. Tous ont des tables en terrasse et une identite propre.
    </p>
    <div class="grid sm:grid-cols-2 gap-6">
      <div class="bg-white rounded-[2rem] p-8 border border-slate-100 shadow-sm">
        <p class="text-med-gold font-bold text-xs uppercase tracking-wider mb-2">Depuis 1909</p>
        <h3 class="font-semibold text-charcoal mb-2">Bar Tiberio</h3>
        <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">Le plus ancien de la Piazzetta. Fonde en 1909 par la famille Tiberio, il a traverse quatre generations. Les tables sous la Tour de l horloge sont parmi les plus photographiees du monde. Espresso ~4 euros, granita au citron ~7 euros.</p>
      </div>
      <div class="bg-white rounded-[2rem] p-8 border border-slate-100 shadow-sm">
        <p class="text-med-gold font-bold text-xs uppercase tracking-wider mb-2">Depuis 1920</p>
        <h3 class="font-semibold text-charcoal mb-2">Gran Caffe (ex Vermouth)</h3>
        <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">Ouvert dans les annees 20 sous le nom de "Bar Vermouth", il est reste le plus elegant. Sols en majolique, comptoir en marbre blanc, atmosphere annees 50. Lieu historique de la jet-set internationale d apres-guerre.</p>
      </div>
      <div class="bg-white rounded-[2rem] p-8 border border-slate-100 shadow-sm">
        <p class="text-med-gold font-bold text-xs uppercase tracking-wider mb-2">Historique</p>
        <h3 class="font-semibold text-charcoal mb-2">Caso</h3>
        <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">Le cafe des intellectuels, frequente par Norman Douglas et les ecrivains de Capri dans les annees 30. Atmosphere plus recueillie, clientele en moyenne plus locale.</p>
      </div>
      <div class="bg-white rounded-[2rem] p-8 border border-slate-100 shadow-sm">
        <p class="text-med-gold font-bold text-xs uppercase tracking-wider mb-2">Compact</p>
        <h3 class="font-semibold text-charcoal mb-2">Piccolo Bar</h3>
        <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">Le plus petit de la Piazzetta. Peu de tables, service rapide. Ideal pour un cafe rapide avant de prendre le Funiculaire pour la Marina Grande.</p>
      </div>
    </div>
  </div>

  <!-- Monuments -->
  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">Les monuments de la Piazzetta</h2>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      Deux monuments definissent le profil de la Piazzetta et sont devenus symboles de Capri dans le monde.
    </p>
    <div class="space-y-4">
      <div class="bg-white p-6 rounded-[2rem] border border-slate-100 shadow-sm flex gap-5">
        <div class="w-10 h-10 rounded-full bg-med-gold/10 flex-shrink-0 flex items-center justify-center text-med-gold font-bold text-xs sm:text-sm">1</div>
        <div>
          <h4 class="font-bold text-slate-900 mb-1">La Tour de l horloge</h4>
          <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">L ancienne tour civique avec le majestueux cadran du XVII siecle. A l origine clocher de la Cathedrale ; aujourd hui symbole iconique de la Piazzetta. La coupole en majolique bleue et jaune la rend reconnaissable sur chaque photo de Capri.</p>
        </div>
      </div>
      <div class="bg-white p-6 rounded-[2rem] border border-slate-100 shadow-sm flex gap-5">
        <div class="w-10 h-10 rounded-full bg-med-gold/10 flex-shrink-0 flex items-center justify-center text-med-gold font-bold text-xs sm:text-sm">2</div>
        <div>
          <h4 class="font-bold text-slate-900 mb-1">La Cathedrale Santo Stefano</h4>
          <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Construite en 1685 en style baroque, facade sobre et interieur spectaculaire. Le sol en majolique du XVIII siecle, l autel en marbres polychromes et les statues des saints protecteurs de l ile. Entree gratuite, ouverte de 7h a 19h.</p>
        </div>
      </div>
      <div class="bg-white p-6 rounded-[2rem] border border-slate-100 shadow-sm flex gap-5">
        <div class="w-10 h-10 rounded-full bg-med-gold/10 flex-shrink-0 flex items-center justify-center text-med-gold font-bold text-xs sm:text-sm">3</div>
        <div>
          <h4 class="font-bold text-slate-900 mb-1">L escalier de la Cathedrale</h4>
          <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Les marches baroques qui montent vers la Cathedrale sont le point d observation prefere des photographes. D ici on embrasse toute la Piazzetta avec les cafes sur les cotes, la Tour de l horloge et, en arriere-plan, le Mont Solaro d Anacapri.</p>
        </div>
      </div>
    </div>
  </div>

  <!-- Local Tips -->
  <div class="bg-white p-8 rounded-[2rem] shadow-xl border border-slate-100">
    <div class="flex items-center gap-4 mb-6">
      <svg class="w-6 h-6 text-med-gold flex-shrink-0" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M9 18h6"/><path d="M10 22h4"/><path d="M15.09 14c.18-.98.65-1.74 1.41-2.5A4.65 4.65 0 0 0 18 8 6 6 0 0 0 6 8c0 1 .23 2.23 1.5 3.5A4.61 4.61 0 0 1 8.91 14"/></svg>
      <h3 class="text-xl font-bold">4 conseils pour vivre la Piazzetta</h3>
    </div>
    <div class="space-y-6">
      <div>
        <p class="font-bold text-slate-900 mb-1">1. Allez-y a l aperitif (18h-20h)</p>
        <p class="text-slate-600 leading-relaxed text-xs sm:text-sm">Le moment symbole. La lumiere doree sur la Tour de l horloge, le passage des Capresi qui rentrent du travail, l ouverture des vitrines. Cafes pleins mais avec energie joyeuse, non chaotique.</p>
      </div>
      <div>
        <p class="font-bold text-slate-900 mb-1">2. Cafe au comptoir pour economiser</p>
        <p class="text-slate-600 leading-relaxed text-xs sm:text-sm">Si vous ne souhaitez pas vous asseoir et admirer la "scenographie", au comptoir un espresso coute 1,50 euro (prix italien standard). En terrasse le meme espresso coute 3-5 euros. La difference paie la vue.</p>
      </div>
      <div>
        <p class="font-bold text-slate-900 mb-1">3. Visitez la Cathedrale</p>
        <p class="text-slate-600 leading-relaxed text-xs sm:text-sm">L entree est gratuite mais presque tous la negligent. Le sol en majolique et les autels en marbres polychromes sont parmi les tresors baroques les plus sous-estimes de Campanie.</p>
      </div>
      <div>
        <p class="font-bold text-slate-900 mb-1">4. Matin tot pour le calme</p>
        <p class="text-slate-600 leading-relaxed text-xs sm:text-sm">Avant 10h en haute saison, la Piazzetta est presque deserte. La lumiere est parfaite pour photographier la Tour de l horloge sans foule. Cafes ouverts des 7h30.</p>
      </div>
    </div>
  </div>

  <!-- Curiosity -->
  <div class="bg-slate-50 p-8 rounded-[2rem] border-l-4 border-med-gold my-8">
    <div class="flex items-start gap-4">
      <svg class="w-6 h-6 text-med-gold flex-shrink-0 mt-1" fill="currentColor" viewBox="0 0 24 24"><path d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
      <div>
        <h3 class="font-bold text-slate-900 mb-2 text-lg">Le saviez-vous ?</h3>
        <p class="text-slate-700 leading-relaxed">
          La Piazzetta mesure seulement 250 metres carres. C est l une des places publiques les plus petites d Italie, et pourtant elle a accueilli simultanement des personnages qui valaient individuellement plus que des capitales europeennes entieres. Onassis et Maria Callas, Jackie Kennedy et Audrey Hepburn, Sophia Loren et Vittorio De Sica s y sont croises en quelques etes entre 1955 et 1965.
        </p>
      </div>
    </div>
  </div>

</BlogPostLayout>
