---
import BlogPostLayout from '../../../../layouts/BlogPostLayout.astro';

const lang = 'fr-fr';
const post = {
  title: 'Capri ou Ischia',
  subtitle: 'Quelle île du Golfe visiter en 2026',
  category: 'GUIDES',
  date: '29 mai 2026',
  readTime: '10 min',
  image: '/images/capri-vs-ischia-hero.webp',
  imageAlt: 'Capri et Ischia : choisir la bonne île du Golfe de Naples',
  path: '/fr-fr/blog/capri-vs-ischia/',
};

const metaTitle = 'Capri ou Ischia 2026 : Quelle Île est Meilleure ? | Comparaison Honnête';
const metaDescription = 'Capri ou Ischia : guide 2026 avec cas d\'usage (lune de miel, famille, excursion, thermes). Glamour iconique vs île thermale authentique. Choisissez la bonne île du Golfe de Naples.';

const breadcrumbs = [
  { name: 'Accueil', url: '/fr-fr/' },
  { name: 'Blog', url: '/fr-fr/blog/' },
  { name: 'Capri ou Ischia', url: '/fr-fr/blog/capri-vs-ischia/' },
];

const quickInfo = [
  { label: 'Taille Capri', value: '10 km²' },
  { label: 'Taille Ischia', value: '46 km²' },
  { label: 'Ferry depuis Naples', value: 'Capri 40-50 min · Ischia 50-80 min' },
  { label: 'Ferry depuis Sorrente', value: 'Capri 20 min · Ischia (pas direct)' },
  { label: 'Pour excursion', value: 'Capri' },
  { label: 'Pour 3+ nuits', value: 'Ischia' },
  { label: 'Pour thermes', value: 'Ischia (exclusif)' },
];

const faq = [
  {
    q: 'Capri ou Ischia pour excursion d\'une journée ?',
    a: "Capri, sans question. Capri est assez petite (10 km²) pour couvrir ses points iconiques (Piazzetta, Via Krupp, Jardins d'Auguste, Grotte Bleue, tour en bateau aux Faraglioni) en 6-8 heures. Ischia est 5x plus grande et nécessite au moins 2 nuits pour avoir du sens; une excursion là-bas signifie voir une plage et un village, manquer tout le reste.",
  },
  {
    q: 'Capri ou Ischia pour lune de miel ?',
    a: "Capri, par tradition. Capri livre les icônes (Faraglioni au coucher de soleil en bateau, apéritif Piazzetta au Caffè Tiberio, Villa San Michele à Anacapri) plus hôtels 5★ aux noms connus (Punta Tragara, Capri Palace). Ischia est plus authentique et bien moins chère, mais manque de la mystique romantique de Capri. Pour 2-3 nuits de pure lune de miel, Capri.",
  },
  {
    q: 'Capri ou Ischia pour familles avec enfants ?',
    a: "Ischia, de loin. Ischia a des parcs thermaux (Negombo, Jardins Poseidon) qui divertissent les enfants toute la journée, grandes plages de sable (Maronti, Citara), appartements et hôtels familiaux à moitié prix de Capri, et ambiance moins frénétique. Capri est difficile avec poussettes : ruelles étroites, verticale, chère, faite pour couples pas familles.",
  },
  {
    q: 'Capri ou Ischia : laquelle est moins chère ?',
    a: "Ischia est 40-60% moins chère globalement. Hôtel 3★ Ischia : €100-160; même catégorie Capri €280-450. Restaurants Ischia : €15-22 pour pasta + vue mer; Capri €25-40. Transat Ischia : €15-25. Transat Capri : €30-60.",
  },
  {
    q: 'Capri ou Ischia : combien de nuits ?',
    a: "Capri fonctionne comme excursion d'une journée depuis Sorrente ou Amalfi (zéro nuit), ou comme 2-3 nuits pour expérience île romantique. Ischia nécessite minimum 3 nuits pour justifier le ferry et explorer correctement : moins de 2 nuits vous manquez les parcs thermaux, le Château Aragonais et la côte sud. Ne faites pas d'excursion à Ischia.",
  },
  {
    q: 'Capri ou Ischia pour thermes ?',
    a: "Ischia, exclusivement. Ischia est volcanique : toute l'île est sur des sources thermales. Negombo et Jardins Poseidon sont les deux parcs thermaux célèbres, chacun avec 15+ piscines à températures différentes, forfaits day-spa dès €30. Capri a zéro source thermale. Si une journée spa compte, le choix est automatique.",
  },
  {
    q: 'Capri ou Ischia pour randonnée ?',
    a: "Toutes deux excellentes, styles différents. Capri : courtes promenades scéniques (lacets Via Krupp, Sentiero dei Fortini côtier, télésiège + marche Monte Solaro). Sentiers demi-journée au maximum. Ischia : vraies randonnées (sommet Monte Epomeo 3-4h aller-retour depuis Forio, sentiers volcaniques, parcours ruraux plus longs). Si la randonnée est la raison principale, Ischia gagne.",
  },
];

const sidebarLinks = [
  { label: 'Guide Capri', href: '/fr-fr/iles/capri/' },
  { label: 'Guide Anacapri', href: '/fr-fr/iles/anacapri/' },
  { label: 'Guide Ischia', href: '/fr-fr/iles/ischia/' },
  { label: 'Guide Forio (Ischia)', href: '/fr-fr/iles/forio/' },
  { label: 'Guide Procida', href: '/fr-fr/iles/procida/' },
  { label: 'Ferries : routes', href: '/fr-fr/guide/ferries/' },
];

const authorRole = 'Expert logistique voyages · Golfe de Naples';

const relatedArticles = [
  {
    title: 'Procida ou Ischia',
    category: 'GUIDES',
    date: '1 juin 2026',
    image: '/images/procida-vs-ischia-hero.webp',
    imageAlt: 'Procida et Ischia : comparaison',
    path: '/fr-fr/blog/procida-vs-ischia/',
  },
  {
    title: 'Sorrente ou Positano',
    category: 'GUIDES',
    date: '29 mai 2026',
    image: '/images/sorrento-vs-positano-hero.webp',
    imageAlt: 'Sorrente et Positano : comparaison',
    path: '/fr-fr/blog/sorrento-vs-positano/',
  },
];

const compareSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: 'Capri ou Ischia : quelle île du Golfe de Naples visiter',
  about: [
    { '@type': 'Place', name: 'Capri', address: { '@type': 'PostalAddress', addressLocality: 'Capri', addressRegion: 'NA', addressCountry: 'IT' } },
    { '@type': 'Place', name: 'Ischia', address: { '@type': 'PostalAddress', addressLocality: 'Ischia', addressRegion: 'NA', addressCountry: 'IT' } },
  ],
};
---

<BlogPostLayout
  lang={lang}
  post={post}
  metaTitle={metaTitle}
  metaDescription={metaDescription}
  breadcrumbs={breadcrumbs}
  quickInfo={quickInfo}
  faq={faq}
  sidebarLinks={sidebarLinks}
  authorRole={authorRole}
  relatedArticles={relatedArticles}
  extraSchema={[compareSchema]}
>

  <div>
    <p class="text-slate-600 text-xl leading-relaxed mb-6 font-light">
      <strong>Capri ou Ischia ?</strong> Deux îles, à quinze minutes de ferry l'une de l'autre, voyages complètement différents. <a href="/fr-fr/iles/capri/" class="text-med-blue hover:underline">Capri</a> est l'icône globale : petite, verticale, chère, économie entièrement touristique. <a href="/fr-fr/iles/ischia/" class="text-med-blue hover:underline">Ischia</a> est sa sœur aînée volcanique : sources thermales partout, moitié du prix, double variété, moins célèbre. Ce guide choisit la bonne île pour votre situation en cinq minutes.
    </p>
  </div>

  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">Pour excursion d'une journée : Capri</h2>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      Capri est construite pour l'économie des excursions d'une journée. 10 km² totaux, chaque icône à 30 minutes de marche ou courte funiculaire depuis Marina Grande. Une journée standard de Capri depuis Sorrente ou Naples :
    </p>
    <div class="bg-white p-8 rounded-[2rem] border border-slate-100 shadow-sm mb-6">
      <h3 class="font-serif text-xl font-bold text-slate-900 mb-4">Excursion Capri en 8 heures</h3>
      <ul class="space-y-4 text-slate-600">
        <li class="flex items-start gap-3">
          <span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span>
          <span class="text-slate-700"><strong>9:00</strong> Ferry Sorrente → Capri, 20 min</span>
        </li>
        <li class="flex items-start gap-3">
          <span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span>
          <span class="text-slate-700"><strong>9:30</strong> Tour en bateau autour de l'île (2h, inclut Faraglioni et Grotte Bleue)</span>
        </li>
        <li class="flex items-start gap-3">
          <span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span>
          <span class="text-slate-700"><strong>12:00</strong> Funiculaire vers Capri ville, déjeuner Piazzetta</span>
        </li>
        <li class="flex items-start gap-3">
          <span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span>
          <span class="text-slate-700"><strong>14:00</strong> Via Krupp + Jardins d'Auguste (1h)</span>
        </li>
        <li class="flex items-start gap-3">
          <span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span>
          <span class="text-slate-700"><strong>15:30</strong> Bus pour Anacapri, Villa San Michele (1h)</span>
        </li>
        <li class="flex items-start gap-3">
          <span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span>
          <span class="text-slate-700"><strong>17:00</strong> Apéritif de retour à Capri ville</span>
        </li>
        <li class="flex items-start gap-3">
          <span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span>
          <span class="text-slate-700"><strong>18:30</strong> Ferry retour vers Sorrente</span>
        </li>
      </ul>
    </div>
    <p class="text-slate-600 text-lg leading-relaxed">
      Ischia ne peut pas livrer cela en une journée. L'île est 5x plus grande; même une journée "uniquement les highlights" nécessite 2-3 heures de bus ou scooter. Si vous avez seulement une journée et voulez les icônes, Capri.
    </p>
  </div>

  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">Pour 3+ nuits : Ischia</h2>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      Pour un vrai séjour d'île (matins lents, après-midis spa thermal, dîners coucher de soleil, journées plage), Ischia est le meilleur choix de loin. La variété justifie le temps :
    </p>
    <div class="bg-white p-8 rounded-[2rem] border border-slate-100 shadow-sm">
      <h3 class="font-serif text-xl font-bold text-slate-900 mb-4">4 nuits à Ischia</h3>
      <ul class="space-y-4 text-slate-600">
        <li class="flex items-start gap-3">
          <span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span>
          <span class="text-slate-700"><strong>Jour 1 :</strong> Ischia Porto + Château Aragonais (forteresse insulaire médiévale)</span>
        </li>
        <li class="flex items-start gap-3">
          <span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span>
          <span class="text-slate-700"><strong>Jour 2 :</strong> Forio + coucher de soleil à Chiesa del Soccorso (l'église blanche iconique)</span>
        </li>
        <li class="flex items-start gap-3">
          <span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span>
          <span class="text-slate-700"><strong>Jour 3 :</strong> Negombo ou Jardins Poseidon (journée complète)</span>
        </li>
        <li class="flex items-start gap-3">
          <span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span>
          <span class="text-slate-700"><strong>Jour 4 :</strong> Sant'Angelo + plage Maronti + sources thermales naturelles Sorgeto</span>
        </li>
      </ul>
    </div>
    <p class="text-slate-600 text-lg leading-relaxed mt-6">
      Trois ou quatre nuits à Capri tendent à sembler serrées après avoir épuisé les icônes. Vous épuisez les highlights au jour 2 et commencez à payer €40/pasta pour dîners répétés. La plupart des voyageurs qui restent plus de 2 nuits à Capri le regrettent en silence.
    </p>
  </div>

  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">Pour familles avec enfants : Ischia</h2>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      Ischia est construite pour les séjours familiaux. Grandes plages de sable (Maronti est 2 km de sable), parcs thermaux avec piscines enfants et maîtres-nageurs (Jardins Poseidon a 22 piscines à températures différentes, jardins, pelouse pour pique-nique), appartements familiaux abordables (€80-150/nuit pour 4 personnes), et ambiance moins stressante que la foule touristique de Capri.
    </p>
    <div class="bg-med-cream p-8 rounded-[2rem] border border-med-gold/20 mb-6">
      <h3 class="font-serif text-xl font-bold text-slate-900 mb-4">Checklist famille</h3>
      <table class="w-full text-sm">
        <tbody class="divide-y divide-med-gold/20">
          <tr><td class="py-2 font-semibold">Plage de sable avec espace enfants</td><td class="py-2">Ischia ✓ (Maronti, Citara) · Capri (rocheux seulement)</td></tr>
          <tr><td class="py-2 font-semibold">Parcs thermaux pour enfants</td><td class="py-2">Ischia ✓ · Capri ✗</td></tr>
          <tr><td class="py-2 font-semibold">Appartement famille €100-150</td><td class="py-2">Ischia courant · Capri rare</td></tr>
          <tr><td class="py-2 font-semibold">Grand supermarché</td><td class="py-2">Ischia ✓ · Capri petits seulement</td></tr>
          <tr><td class="py-2 font-semibold">Adapté aux poussettes</td><td class="py-2">Forio et Ischia Porto ✓ · Capri ✗</td></tr>
        </tbody>
      </table>
    </div>
  </div>

  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">Pour voyageurs avec budget : Ischia économise 40-60%</h2>
    <div class="overflow-hidden rounded-[2rem] border border-slate-100 shadow-sm mb-6">
      <table class="w-full text-sm">
        <thead class="bg-slate-900 text-white">
          <tr>
            <th class="text-left p-4 font-bold text-med-gold">Élément (mai 2026)</th>
            <th class="text-left p-4 font-bold text-med-gold">Ischia</th>
            <th class="text-left p-4 font-bold text-med-gold">Capri</th>
          </tr>
        </thead>
        <tbody class="bg-white">
          <tr class="border-b border-slate-100"><td class="p-4 font-semibold">Hôtel 3★ double</td><td class="p-4">€100-160</td><td class="p-4">€280-450</td></tr>
          <tr class="border-b border-slate-100"><td class="p-4 font-semibold">4★ avec vue mer</td><td class="p-4">€180-350</td><td class="p-4">€500-1 200</td></tr>
          <tr class="border-b border-slate-100"><td class="p-4 font-semibold">Pasta restaurant moyen</td><td class="p-4">€15-22</td><td class="p-4">€25-40</td></tr>
          <tr class="border-b border-slate-100"><td class="p-4 font-semibold">Transat + parasol</td><td class="p-4">€15-25</td><td class="p-4">€30-60</td></tr>
          <tr class="border-b border-slate-100"><td class="p-4 font-semibold">Parc thermal journée</td><td class="p-4">€30-40</td><td class="p-4">N/A</td></tr>
          <tr><td class="p-4 font-semibold">Espresso au bar</td><td class="p-4">€1,50</td><td class="p-4">€3-4</td></tr>
        </tbody>
      </table>
    </div>
  </div>

  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">Le verdict en 30 secondes</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8">
      <div class="bg-white p-6 rounded-[2rem] border border-slate-100 shadow-sm">
        <p class="text-med-gold text-[10px] font-bold uppercase tracking-[0.2em] mb-3">Choisissez Capri si :</p>
        <ul class="space-y-3 text-slate-600 text-sm">
          <li class="flex items-start gap-3"><span class="w-2 h-2 bg-med-gold rounded-full mt-2 flex-shrink-0"></span><span>Excursion d'une journée depuis Sorrente, Naples ou Amalfi</span></li>
          <li class="flex items-start gap-3"><span class="w-2 h-2 bg-med-gold rounded-full mt-2 flex-shrink-0"></span><span>Lune de miel, séjour iconique 2-3 nuits</span></li>
          <li class="flex items-start gap-3"><span class="w-2 h-2 bg-med-gold rounded-full mt-2 flex-shrink-0"></span><span>Vous voulez le célèbre tour en bateau aux Faraglioni + Grotte Bleue</span></li>
          <li class="flex items-start gap-3"><span class="w-2 h-2 bg-med-gold rounded-full mt-2 flex-shrink-0"></span><span>Budget €400+/nuit ne vous effraie pas</span></li>
          <li class="flex items-start gap-3"><span class="w-2 h-2 bg-med-gold rounded-full mt-2 flex-shrink-0"></span><span>Le "j'ai été à Capri" de la bucket list compte</span></li>
        </ul>
      </div>
      <div class="bg-white p-6 rounded-[2rem] border border-slate-100 shadow-sm">
        <p class="text-med-gold text-[10px] font-bold uppercase tracking-[0.2em] mb-3">Choisissez Ischia si :</p>
        <ul class="space-y-3 text-slate-600 text-sm">
          <li class="flex items-start gap-3"><span class="w-2 h-2 bg-med-gold rounded-full mt-2 flex-shrink-0"></span><span>3+ nuits de temps insulaire lent</span></li>
          <li class="flex items-start gap-3"><span class="w-2 h-2 bg-med-gold rounded-full mt-2 flex-shrink-0"></span><span>Thermes et bien-être au programme</span></li>
          <li class="flex items-start gap-3"><span class="w-2 h-2 bg-med-gold rounded-full mt-2 flex-shrink-0"></span><span>Famille avec enfants</span></li>
          <li class="flex items-start gap-3"><span class="w-2 h-2 bg-med-gold rounded-full mt-2 flex-shrink-0"></span><span>Budget moins de €200/nuit avec vue mer</span></li>
          <li class="flex items-start gap-3"><span class="w-2 h-2 bg-med-gold rounded-full mt-2 flex-shrink-0"></span><span>Randonnée (Monte Epomeo) et villages authentiques</span></li>
        </ul>
      </div>
    </div>
    <blockquote class="border-l-4 border-med-gold pl-6 mb-8">
      <p class="text-slate-700 text-lg font-serif italic leading-relaxed">
        "💡 Conseil local : faites les deux. Un island hop de 4 jours (1 jour Capri en excursion, 3 nuits Ischia) vous donne les photos bucket list plus un vrai séjour insulaire, budget total moins de €700/personne hôtels inclus. Ajoutez Procida comme étape demi-journée entre les deux, et vous avez couvert l'arc complet des îles du Golfe."
      </p>
    </blockquote>
  </div>

  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">Tableau de comparaison rapide</h2>
    <div class="overflow-hidden rounded-[2rem] border border-slate-100 shadow-sm">
      <table class="w-full text-sm">
        <thead class="bg-slate-900 text-white">
          <tr>
            <th class="text-left p-4 font-bold text-med-gold">Caractéristique</th>
            <th class="text-left p-4 font-bold text-med-gold">Capri</th>
            <th class="text-left p-4 font-bold text-med-gold">Ischia</th>
          </tr>
        </thead>
        <tbody class="bg-white">
          <tr class="border-b border-slate-100"><td class="p-4 font-semibold">Taille</td><td class="p-4">10 km² (petite)</td><td class="p-4">46 km² (grande)</td></tr>
          <tr class="border-b border-slate-100"><td class="p-4 font-semibold">Ambiance</td><td class="p-4">Iconique, glamour, verticale</td><td class="p-4">Authentique, volcanique, plus lente</td></tr>
          <tr class="border-b border-slate-100"><td class="p-4 font-semibold">Idéal pour</td><td class="p-4">Excursion ou 2 nuits romantiques</td><td class="p-4">3+ nuits, famille ou bien-être</td></tr>
          <tr class="border-b border-slate-100"><td class="p-4 font-semibold">Plages</td><td class="p-4">Rocheuses, petites (Marina Piccola)</td><td class="p-4">Longues sable (Maronti, Citara)</td></tr>
          <tr class="border-b border-slate-100"><td class="p-4 font-semibold">Thermes</td><td class="p-4">Aucun</td><td class="p-4">Multiples parcs ⭐</td></tr>
          <tr class="border-b border-slate-100"><td class="p-4 font-semibold">Icônes</td><td class="p-4">Faraglioni, Grotte Bleue, Piazzetta</td><td class="p-4">Château Aragonais, coucher de soleil Forio</td></tr>
          <tr class="border-b border-slate-100"><td class="p-4 font-semibold">Coût moyen hôtel</td><td class="p-4">€280-1 200</td><td class="p-4">€100-350</td></tr>
          <tr><td class="p-4 font-semibold">Style lune de miel</td><td class="p-4">Icônes célèbres + glam 5★</td><td class="p-4">Luxe silencieux + spa thermal</td></tr>
        </tbody>
      </table>
    </div>
  </div>

</BlogPostLayout>
