---
import BlogPostLayout from '../../../../layouts/BlogPostLayout.astro';

const lang = 'fr-fr';
const post = {
  title: 'École primaire à Sorrente : guide pour les familles',
  subtitle: "Comment fonctionne la scuola primaria italienne, quelles écoles Sorrente possède réellement, quand ont lieu les inscriptions et ce que doivent prévoir les familles qui ne parlent pas italien",
  category: 'GUIDE',
  date: '25 septembre 2026',
  readTime: '10 min',
  image: '/images/piazza-tasso-sorrento-hero.webp',
  imageAlt: "Piazza Tasso, la place principale de Sorrente et le centre de la vie quotidienne",
  path: '/fr-fr/blog/ecole-primaire-sorrente/',
};

const metaTitle = 'École primaire à Sorrente : écoles et inscriptions | 2026';
const metaDescription = "Sorrente compte quatre écoles primaires, deux publiques et deux privées sous contrat, réunies dans deux istituti comprensivi. Règles d'âge, fenêtre d'inscription de janvier sur la plateforme Unica, temps plein et option anglophone la plus proche.";

const breadcrumbs = [
  { name: 'Accueil', url: '/fr-fr/' },
  { name: 'Blog', url: '/fr-fr/blog/' },
  { name: 'École primaire à Sorrente', url: '/fr-fr/blog/ecole-primaire-sorrente/' },
];

const quickInfo = [
  { label: "Type d'école", value: 'Scuola primaria, 5 ans' },
  { label: 'Âge', value: 'De 6 à 11 ans' },
  { label: "Règle d'entrée", value: 'Six ans avant le 31 décembre' },
  { label: 'Entrée anticipée', value: 'Possible si six ans avant le 30 avril' },
  { label: 'Écoles à Sorrente', value: '4 : deux publiques, deux sous contrat' },
  { label: 'Istituti comprensivi', value: '2 : Sorrento Capoluogo et Tasso' },
  { label: 'Inscription', value: 'En ligne en janvier, SPID ou CIE requis' },
  { label: "Langue d'enseignement", value: 'Italien' },
];

const faq = [
  {
    q: "À quel âge commence l'école primaire en Italie ?",
    a: "L'enfant entre en classe prima en septembre de l'année où il a six ans, à condition que l'anniversaire tombe au plus tard le 31 décembre. Les familles peuvent aussi demander une entrée anticipée, l'iscrizione anticipata, pour les enfants qui auront six ans avant le 30 avril de l'année suivante. L'école primaire dure ensuite cinq ans, jusqu'à onze ans environ.",
  },
  {
    q: "Combien d'écoles primaires y a-t-il à Sorrente ?",
    a: "Quatre dans la commune de Sorrente : deux publiques, Sorrento Capoluogo Via Vittorio Veneto et Angelina Lauro Via Capasso, et deux privées sous contrat, le Conservatorio Santa Maria della Pietà Via Pietà et Santa Maria delle Grazie Piazza Sant'Antonino. Les publiques dépendent de deux istituti comprensivi, qui regroupent aussi la maternelle et le collège.",
  },
  {
    q: 'Quand ouvrent les inscriptions ?',
    a: "En janvier, pour l'année scolaire qui commence en septembre suivant. Pour 2026/2027 la fenêtre a couru du 13 janvier au 14 février 2026. Le ministère publie la circulaire avec les dates exactes en décembre, la fenêtre de l'année d'après n'est donc généralement connue que quelques semaines à l'avance.",
  },
  {
    q: 'Comment déposer le dossier ?',
    a: "En ligne, sur la plateforme Unica du ministère de l'Éducation. Un parent se connecte avec une identité numérique, SPID, CIE ou eIDAS, saisit les données de l'enfant et indique une école en premier choix plus deux solutions de repli au maximum. Le codice fiscale de l'enfant est nécessaire. Les enfants qui arrivent en cours d'année s'inscrivent directement auprès de l'école, hors plateforme.",
  },
  {
    q: "Existe-t-il une école primaire anglophone à Sorrente ?",
    a: "Non. Il n'y a aucune école primaire internationale ou anglophone sur la péninsule sorrentine. L'option la plus proche est l'International School of Naples à Bagnoli, qui suit un programme américain en anglais de la maternelle à la douzième classe. Depuis Sorrente, il faut compter environ une heure et demie, ce qui l'exclut comme trajet quotidien pour la plupart des familles.",
  },
  {
    q: "Cette page parle-t-elle de la Sorrento Primary School en Australie ?",
    a: "Non. Des écoles de ce nom existent à Sorrento, en Australie-Occidentale, et à Sorrento, dans le Victoria, et elles n'ont rien à voir avec celle-ci. Cette page traite de l'école primaire à Sorrente en Campanie, la ville du golfe de Naples.",
  },
];

const sidebarLinks = [
  { label: 'Sorrente', href: '/fr-fr/peninsule-sorrentine/sorrente/' },
  { label: 'Étudier à Sorrente', href: '/fr-fr/blog/study-abroad-sorrente/' },
  { label: 'Sorrente ou Positano', href: '/fr-fr/blog/sorrento-vs-positano/' },
  { label: 'Bus SITA', href: '/fr-fr/guide/bus-sita/' },
  { label: 'Ferries', href: '/fr-fr/guide/ferries/' },
];

const authorRole = 'Spécialiste Péninsule Sorrentine';

const relatedArticles = [
  {
    title: 'Etudier a Sorrente : Study abroad sur la peninsule sorrentine',
    category: 'GUIDE',
    date: '4 juillet 2026',
    image: '/images/study-abroad-sorrento-hero.webp',
    imageAlt: 'Étudier à Sorrente',
    path: '/fr-fr/blog/study-abroad-sorrente/'
  },
  {
    title: 'Films tournes a Sorrente : quand le cinema choisit la peninsule',
    category: 'DÉCOUVERTES',
    date: '30 juin 2026',
    image: '/images/film-fatti-a-sorrento-hero.webp',
    imageAlt: 'Films tournés à Sorrente',
    path: '/fr-fr/blog/films-tournes-a-sorrente/'
  }
];

const imageCredit = {
  author: 'Berthold Werner / Wikimedia Commons',
  sourceUrl: 'https://commons.wikimedia.org/wiki/File:Piazza_Tasso_-_Sorrento_BW_2013-05-12.jpg',
  license: 'CC BY-SA 3.0',
  licenseUrl: 'https://creativecommons.org/licenses/by-sa/3.0/',
};

const keyTakeaways = [
  "La scuola primaria italienne dure cinq ans, commence en septembre de l'année des six ans de l'enfant et est gratuite dans les écoles publiques.",
  'Sorrente compte quatre écoles primaires, deux publiques et deux sous contrat, réunies dans deux istituti comprensivi installés Via Vittorio Veneto et Via Marziale.',
  "L'inscription se fait en ligne en janvier sur la plateforme Unica du ministère, et un parent doit disposer d'une identité numérique italienne comme SPID ou CIE.",
  "Le choix qui compte le plus sur place est entre tempo normale et tempo pieno, car les places à temps plein avec cantine sont limitées et n'existent pas dans tous les bâtiments.",
  "L'enseignement est en italien. Il n'y a pas d'école primaire anglophone sur la péninsule, et l'école internationale la plus proche est à Naples, trop loin pour un trajet quotidien.",
];
---

<BlogPostLayout
  lang={lang}
  post={post}
  metaTitle={metaTitle}
  metaDescription={metaDescription}
  breadcrumbs={breadcrumbs}
  quickInfo={quickInfo}
  faq={faq}
  sidebarLinks={sidebarLinks}
  authorRole={authorRole}
  relatedArticles={relatedArticles}
  imageCredit={imageCredit}
  pageKey="sorrento-primary-school"
>

  <!-- Points Clés -->
  <div class="bg-slate-900 text-white p-8 rounded-[2rem]">
    <div class="flex items-center gap-3 mb-6">
      <svg class="w-5 h-5 text-med-gold flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
      <h2 class="font-serif text-lg font-bold text-med-gold uppercase tracking-[0.15em]">Points Clés</h2>
    </div>
    <ul class="space-y-4">
      {keyTakeaways.map((point) => (
        <li class="flex items-start gap-3">
          <span class="w-1.5 h-1.5 rounded-full bg-med-gold flex-shrink-0 mt-2"></span>
          <span class="text-white/80 text-xs sm:text-sm leading-relaxed">{point}</span>
        </li>
      ))}
    </ul>
  </div>

  <!-- Intro -->
  <div>
    <p class="text-slate-600 text-xl leading-relaxed mb-6 font-light">
      La plupart des gens viennent à <a href="/fr-fr/peninsule-sorrentine/sorrente/" class="text-med-blue hover:underline">Sorrente</a> pour une semaine. Une minorité y arrive pour un an ou plus, en général à cause d'un travail dans le tourisme, d'un poste à distance que l'on pourrait exercer n'importe où ou d'un retour dans une maison de famille, et découvre alors que la question de savoir où va à l'école un enfant de six ans ne figure dans aucun guide de voyage. Cette page décrit ce que la ville propose réellement, comment le système italien fonctionne pour un enfant venu de l'extérieur, et les quelques dates qui décident de tout.
    </p>
  </div>

  <!-- Fonctionnement -->
  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">Comment fonctionne la scuola primaria</h2>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      L'école primaire en Italie dure cinq ans, de la <em>classe prima</em> à la <em>classe quinta</em>, et couvre à peu près de six à onze ans. Elle est obligatoire et, dans le public, gratuite : les familles paient le matériel, les sorties et la cantine, pas l'enseignement. Avant vient la <em>scuola dell'infanzia</em>, facultative, à partir de trois ans ; après viennent les trois années de <em>scuola secondaria di primo grado</em>, ce que tout le monde appelle le collège.
    </p>
    <p class="text-slate-600 text-lg leading-relaxed mb-8">
      En Campanie, l'année scolaire va normalement de la mi-septembre aux premiers jours de juin, avec les vacances de Noël, de Pâques et les jours fériés nationaux et locaux. Le seul vrai choix structurel fait par les familles au moment de l'inscription concerne l'emploi du temps.
    </p>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div class="bg-white p-6 rounded-[2rem] border border-slate-100 shadow-sm">
        <h4 class="font-bold text-slate-900 mb-2">Tempo normale</h4>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Le matin seulement, généralement 27 à 30 heures par semaine, sortie en début d'après-midi et sans cantine. C'est la règle dans le Sud et l'option la moins chère, mais elle suppose que quelqu'un soit à la maison à midi.</p>
      </div>
      <div class="bg-white p-6 rounded-[2rem] border border-slate-100 shadow-sm">
        <h4 class="font-bold text-slate-900 mb-2">Tempo pieno</h4>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Temps plein, environ 40 heures par semaine, déjeuner à la cantine et cours l'après-midi compris. Les places sont limitées, n'existent pas dans tous les bâtiments et sont attribuées selon la demande : c'est la première question à poser quand on appelle une école.</p>
      </div>
    </div>
  </div>

  <!-- Les écoles -->
  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">Les écoles primaires de Sorrente</h2>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      Sorrente est une petite ville et la liste est courte. Quatre écoles primaires fonctionnent dans la commune, deux publiques et deux privées sous contrat rattachées à des institutions religieuses. Les publiques se trouvent à l'intérieur des <em>istituti comprensivi</em>, l'unité italienne qui réunit maternelle, primaire et collège sous une même direction.
    </p>

    <div class="overflow-x-auto rounded-[2rem] border border-slate-100 shadow-sm">
      <table class="w-full text-xs sm:text-sm">
        <thead class="bg-slate-900 text-white">
          <tr>
            <th class="text-left p-5 font-serif font-bold text-med-gold">École</th>
            <th class="text-left p-5 font-serif font-bold text-med-gold">Type</th>
            <th class="text-left p-5 font-serif font-bold text-med-gold">Adresse</th>
          </tr>
        </thead>
        <tbody class="bg-white">
          <tr class="border-b border-slate-100">
            <td class="p-5 font-bold">Sorrento Capoluogo</td>
            <td class="p-5 text-slate-600">Publique, I.C. Sorrento</td>
            <td class="p-5 text-slate-600">Via Vittorio Veneto, Sorrente</td>
          </tr>
          <tr class="border-b border-slate-100">
            <td class="p-5 font-bold">Angelina Lauro</td>
            <td class="p-5 text-slate-600">Publique</td>
            <td class="p-5 text-slate-600">Via Capasso, Sorrente</td>
          </tr>
          <tr class="border-b border-slate-100">
            <td class="p-5 font-bold">Conservatorio Santa Maria della Pietà</td>
            <td class="p-5 text-slate-600">Sous contrat, institution religieuse</td>
            <td class="p-5 text-slate-600">Via Pietà 24, Sorrente</td>
          </tr>
          <tr>
            <td class="p-5 font-bold">Santa Maria delle Grazie</td>
            <td class="p-5 text-slate-600">Sous contrat</td>
            <td class="p-5 text-slate-600">Piazza Sant'Antonino 14, Sorrente</td>
          </tr>
        </tbody>
      </table>
    </div>

    <p class="text-slate-600 text-lg leading-relaxed mt-6">
      Dans le système public, les classes de primaire se répartissent sur deux bâtiments : le site principal Vittorio Veneto, Via Vittorio Veneto 16, et un second site Via Marziale 18, qui est aussi l'adresse de l'istituto comprensivo Tasso et où les sections à temps plein ont été installées. Le bâtiment que fréquentera votre enfant dépend de la section dans laquelle il est placé, et pas seulement de l'école demandée : mieux vaut poser la question au moment de l'inscription que de le supposer.
    </p>
  </div>

  <!-- Inscription -->
  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">Comment s'inscrire, étape par étape</h2>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      L'inscription en classe prima est une procédure nationale en ligne avec une fenêtre fixe, et la manquer revient à négocier directement avec une école pour ce qu'il reste. La séquence ci-dessous vaut pour une famille déjà résidente, ou sur le point de l'être, à Sorrente.
    </p>

    <div class="bg-white p-8 rounded-[2rem] border border-slate-100 shadow-sm">
      <h3 class="font-serif text-xl font-bold text-slate-900 mb-5">Les cinq étapes</h3>
      <div class="space-y-3">
        <div class="flex items-start gap-3">
          <div class="w-6 h-6 rounded-full bg-med-gold/15 flex-shrink-0 flex items-center justify-center text-med-gold font-bold text-xs">1</div>
          <p class="text-slate-600 text-xs sm:text-sm leading-relaxed"><strong>Mettre les papiers en ordre.</strong> L'enfant a besoin d'un <em>codice fiscale</em> italien, et au moins un parent d'une identité numérique, SPID, CIE ou un accès européen eIDAS équivalent. Les deux prennent du temps : commencez à l'automne, pas en janvier.</p>
        </div>
        <div class="flex items-start gap-3">
          <div class="w-6 h-6 rounded-full bg-med-gold/15 flex-shrink-0 flex items-center justify-center text-med-gold font-bold text-xs">2</div>
          <p class="text-slate-600 text-xs sm:text-sm leading-relaxed"><strong>Guetter la circulaire ministérielle.</strong> Elle paraît en décembre et fixe la fenêtre. Pour 2026/2027 les demandes ont couru du 13 janvier au 14 février 2026, et ces dernières années l'ouverture a toujours eu lieu en janvier.</p>
        </div>
        <div class="flex items-start gap-3">
          <div class="w-6 h-6 rounded-full bg-med-gold/15 flex-shrink-0 flex items-center justify-center text-med-gold font-bold text-xs">3</div>
          <p class="text-slate-600 text-xs sm:text-sm leading-relaxed"><strong>Aller aux open days.</strong> Les écoles les organisent dans les semaines qui précèdent l'ouverture. C'est là que l'on voit les bâtiments, que l'on rencontre les enseignants et que l'on apprend si le temps plein sera proposé l'année suivante.</p>
        </div>
        <div class="flex items-start gap-3">
          <div class="w-6 h-6 rounded-full bg-med-gold/15 flex-shrink-0 flex items-center justify-center text-med-gold font-bold text-xs">4</div>
          <p class="text-slate-600 text-xs sm:text-sm leading-relaxed"><strong>Déposer la demande sur Unica.</strong> Une école en premier choix, jusqu'à deux solutions de repli. En cas de sureffectif, la résidence dans le secteur est généralement le premier critère, suivi des autres situations familiales prévues par le règlement de chaque école.</p>
        </div>
        <div class="flex items-start gap-3">
          <div class="w-6 h-6 rounded-full bg-med-gold/15 flex-shrink-0 flex items-center justify-center text-med-gold font-bold text-xs">5</div>
          <p class="text-slate-600 text-xs sm:text-sm leading-relaxed"><strong>Régler les services avec la commune.</strong> La cantine, la garderie du matin et du soir et le transport scolaire sont des services municipaux avec leurs propres demandes, et ne font pas partie de l'inscription scolaire.</p>
        </div>
      </div>
    </div>
  </div>

  <!-- Sans italien -->
  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">Si votre famille ne parle pas italien</h2>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      La réponse honnête est qu'un enfant dans une école primaire de Sorrente sera enseigné en italien, par des enseignants qui, le plus souvent, ne travaillent qu'en italien, aux côtés de camarades qui le parlent tous à la maison. L'école publique italienne accepte les enfants à n'importe quel moment de l'année scolaire, quelle que soit la langue et la situation administrative, ce qui est une vraie force du système, et un soutien en italien langue seconde existe ; mais ce que chaque école peut réellement offrir varie beaucoup.
    </p>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      Pour la plupart des enfants de six ou sept ans, cela se révèle supportable, et souvent remarquablement rapide. À partir de neuf ou dix ans, arriver sans un mot d'italien dans un programme déjà exigeant en histoire, en géographie et en grammaire est nettement plus dur, et mérite réflexion.
    </p>
    <p class="text-slate-600 text-lg leading-relaxed mb-8">
      Il n'existe pas d'école primaire anglophone sur la péninsule. L'alternative la plus proche est l'<strong>International School of Naples</strong> à Bagnoli, à l'extrémité ouest de la ville, qui enseigne un programme américain en anglais de la maternelle à la douzième classe, compte environ 300 élèves de nombreuses nationalités et ne communique sa grille tarifaire que par son bureau des admissions. Depuis Sorrente il faut compter environ une heure et demie par trajet, en traversant tout Naples : en pratique, les familles qui en ont besoin se rapprochent de la ville plutôt que de faire la navette.
    </p>

    <blockquote class="border-l-4 border-med-gold pl-6 my-8">
      <p class="text-slate-700 text-xl font-serif italic leading-relaxed">
        "À Sorrente, la question n'est pas quel programme international choisir. Elle est de savoir à quelle vitesse un enfant apprend l'italien, et la réponse est en général : plus vite que ses parents."
      </p>
    </blockquote>
  </div>

  <!-- Conseils -->
  <div class="bg-white p-8 rounded-[2rem] shadow-xl border border-slate-100">
    <div class="flex items-center gap-4 mb-6">
      <svg class="w-6 h-6 text-med-gold flex-shrink-0" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M9 18h6"/><path d="M10 22h4"/><path d="M15.09 14c.18-.98.65-1.74 1.41-2.5A4.65 4.65 0 0 0 18 8 6 6 0 0 0 6 8c0 1 .23 2.23 1.5 3.5A4.61 4.61 0 0 1 8.91 14"/></svg>
      <h3 class="text-xl font-bold">Les Conseils de l'Expert</h3>
    </div>
    <div class="space-y-6">
      <div>
        <p class="font-bold text-slate-900 mb-1">Demandez le bâtiment, pas seulement l'école</p>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Les classes publiques de primaire à Sorrente sont réparties sur plusieurs sites, et la distance entre la Via Vittorio Veneto et la Via Marziale compte quand on la parcourt deux fois par jour avec un enfant de six ans. Faites confirmer le site avant d'accepter une place.</p>
      </div>
      <div>
        <p class="font-bold text-slate-900 mb-1">Traitez la résidence comme le facteur décisif</p>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Si une école a plus de demandes que de places, le secteur l'emporte en général. Si vous cherchez encore où louer en ville, vérifiez à quelle école appartient l'adresse avant de signer : il est bien plus facile de choisir l'appartement autour de l'école que l'inverse.</p>
      </div>
      <div>
        <p class="font-bold text-slate-900 mb-1">Ne comptez pas sur l'entrée anticipée</p>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">La voie de l'anticipataria existe pour les enfants qui ont six ans avant le 30 avril de l'année suivante, mais les écoles la jugent sur la maturité et sur le nombre de classes qu'elles peuvent former. Déposez la demande si vous la souhaitez, et gardez un plan avec une année de scuola dell'infanzia supplémentaire.</p>
      </div>
      <div>
        <p class="font-bold text-slate-900 mb-1">La péninsule est plus grande que Sorrente</p>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Sant'Agnello, Piano di Sorrento, Meta et Massa Lubrense ont leurs propres istituti comprensivi, à quelques minutes en Circumvesuviana ou en <a href="/fr-fr/guide/bus-sita/" class="text-med-blue hover:underline">bus SITA</a>. S'il vous faut le temps plein et que Sorrente ne le propose pas, la commune voisine l'offre souvent.</p>
      </div>
    </div>
  </div>

</BlogPostLayout>
