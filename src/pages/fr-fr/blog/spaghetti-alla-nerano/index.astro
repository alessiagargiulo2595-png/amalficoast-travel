---
import BlogPostLayout from '../../../../layouts/BlogPostLayout.astro';

const lang = 'fr-fr';
const post = {
  title: 'Spaghetti alla Nerano',
  subtitle: "Les pâtes aux courgettes frites nées dans une baie minuscule en 1952, et où manger l'original aujourd'hui",
  category: 'GASTRONOMIE',
  date: '17 août 2026',
  readTime: '8 min',
  image: '/images/nerano-hero.webp',
  imageAlt: 'Spaghetti alla Nerano, les pâtes aux courgettes frites de Marina del Cantone',
  path: '/fr-fr/blog/spaghetti-alla-nerano/',
};

const metaTitle = "Spaghetti alla Nerano : où manger l'original | Guide 2026";
const metaDescription = "Le plat est né à Nerano en 1952 au Ristorante Maria Grazia. Où le manger à Marina del Cantone, comment rejoindre la baie depuis Sorrente en bus SITA ou en bateau, et ce qui le distingue de simples pâtes aux courgettes.";

const breadcrumbs = [
  { name: 'Accueil', url: '/fr-fr/' },
  { name: 'Blog', url: '/fr-fr/blog/' },
  { name: 'Spaghetti alla Nerano', url: '/fr-fr/blog/spaghetti-alla-nerano/' },
];

const quickInfo = [
  { label: 'Plat', value: 'Spaghetti aux courgettes frites et fromage' },
  { label: 'Né à', value: 'Nerano, Marina del Cantone (1952)' },
  { label: 'Créé par', value: 'Donna Rosa, Ristorante Maria Grazia' },
  { label: 'Où', value: 'Massa Lubrense, péninsule sorrentine' },
  { label: 'Fromage', value: 'Provolone del Monaco AOP ou caciotta locale' },
  { label: 'Depuis Sorrente', value: 'Environ 50 min en bus SITA' },
  { label: 'Réservation', value: 'Indispensable en juillet et août' },
  { label: 'Meilleure saison', value: 'De juin à septembre, pour les courgettes' },
];

const faq = [
  {
    q: 'Où les Spaghetti alla Nerano ont-ils été inventés ?',
    a: "Au Ristorante Maria Grazia, à Marina del Cantone, la petite baie sous le village de Nerano, dans la commune de Massa Lubrense. Le plat a été créé en 1952 par Donna Rosa, et le restaurant, fondé en 1901, est toujours tenu par ses descendants.",
  },
  {
    q: 'Où faut-il les manger à Nerano ?',
    a: "Maria Grazia est la maison d'origine, la raison pour laquelle le plat porte le nom du village. Lo Scoglio da Tommaso, posé sur l'eau dans la même baie, est l'autre adresse historique, devenue célèbre à l'étranger après le tournage de Stanley Tucci. Quelques minutes à pied les séparent.",
  },
  {
    q: 'Comment aller à Nerano depuis Sorrente ?',
    a: "En bus SITA depuis la gare de Sorrente, environ 50 minutes, parfois avec un changement à Sant Agata sui Due Golfi. En voiture, comptez une trentaine de minutes, mais le stationnement à Marina del Cantone est limité et payant l'été. Beaucoup arrivent par la mer depuis Sorrente, Positano ou Capri.",
  },
  {
    q: 'Quel fromage entre dans les Spaghetti alla Nerano ?',
    a: "Le choix traditionnel est le Provolone del Monaco AOP, le fromage de vache affiné de la péninsule sorrentine, parfois associé à une caciotta locale ou remplacé par elle. C'est le fromage qui donne du corps à la sauce : il n'y a pas de crème dans la version originale.",
  },
  {
    q: 'En quoi diffèrent-ils de simples pâtes aux courgettes ?',
    a: "Sur deux points. Les courgettes sont frites à part et laissées reposer, ce qui les attendrit et les concentre au lieu de les cuire à la vapeur. Ensuite la sauce se monte hors du feu : le fromage râpé est émulsionné avec l'eau de cuisson riche en amidon, ce qui donne un enrobage brillant plutôt qu'un fond liquide.",
  },
  {
    q: 'Faut-il réserver ?',
    a: "Oui, en haute saison. Marina del Cantone est une toute petite baie avec une poignée de restaurants, qui reçoit en même temps les arrivées par la route et par la mer. Pour juillet et août, réservez très en avance, surtout pour une table au déjeuner.",
  },
];

const sidebarLinks = [
  { label: 'Marina del Cantone', href: '/fr-fr/plages/peninsule-sorrentine/marina-del-cantone/' },
  { label: 'Massa Lubrense', href: '/fr-fr/peninsule-sorrentine/massa-lubrense/' },
  { label: 'Baia di Recommone', href: '/fr-fr/blog/baia-recommone/' },
  { label: 'Bus SITA', href: '/fr-fr/guide/bus-sita/' },
  { label: 'Punta Campanella', href: '/fr-fr/blog/punta-campanella/' },
];

const authorRole = 'Spécialiste Côte Amalfitaine';

const relatedArticles = [
  {
    title: "Les Anchois de Cetara : L'Or d'Argent de la Côte Amalfitaine",
    category: 'GASTRONOMIE',
    date: '4 avril 2026',
    image: '/images/alici-cetara-hero.webp',
    imageAlt: 'Les anchois de Cetara et la Colatura AOP - Côte Amalfitaine',
    path: '/fr-fr/blog/anchois-cetara/'
  },
  {
    title: 'Les Scialatielli : les Pâtes Fraîches Inventées à Amalfi',
    category: 'GASTRONOMIE',
    date: '27 mai 2026',
    image: '/images/scialatielli-hero.webp',
    imageAlt: 'Les scialatielli, les pâtes fraîches de la Côte Amalfitaine',
    path: '/fr-fr/blog/scialatielli/'
  }
];

const keyTakeaways = [
  "Les Spaghetti alla Nerano sont nés en 1952 sous les mains de Donna Rosa, au Ristorante Maria Grazia, dans la baie de Marina del Cantone sous le village de Nerano.",
  "Le village appartient à Massa Lubrense, sur la péninsule sorrentine, et non à la côte amalfitaine proprement dite : c'est pourquoi tant de visiteurs n'y parviennent jamais.",
  "La sauce repose sur des courgettes frites et du fromage râpé émulsionné avec l'eau de cuisson. Il n'y a pas de crème dans la recette d'origine.",
  "Maria Grazia est le berceau du plat ; Lo Scoglio da Tommaso, dans la même baie, est l'adresse rendue célèbre à l'étranger par Stanley Tucci.",
  "Depuis Sorrente, comptez environ 50 minutes de bus SITA, et la réservation au déjeuner est indispensable en juillet et août.",
];
---

<BlogPostLayout
  lang={lang}
  post={post}
  metaTitle={metaTitle}
  metaDescription={metaDescription}
  breadcrumbs={breadcrumbs}
  quickInfo={quickInfo}
  faq={faq}
  sidebarLinks={sidebarLinks}
  authorRole={authorRole}
  relatedArticles={relatedArticles}
  pageKey="spaghetti-alla-nerano"
>

  <!-- Key Takeaways -->
  <div class="bg-slate-900 text-white p-8 rounded-[2rem]">
    <div class="flex items-center gap-3 mb-6">
      <svg class="w-5 h-5 text-med-gold flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
      <h2 class="font-serif text-lg font-bold text-med-gold uppercase tracking-[0.15em]">Points Clés</h2>
    </div>
    <ul class="space-y-4">
      {keyTakeaways.map((point) => (
        <li class="flex items-start gap-3">
          <span class="w-1.5 h-1.5 rounded-full bg-med-gold flex-shrink-0 mt-2"></span>
          <span class="text-white/80 text-xs sm:text-sm leading-relaxed">{point}</span>
        </li>
      ))}
    </ul>
  </div>

  <!-- Intro -->
  <div>
    <p class="text-slate-600 text-xl leading-relaxed mb-6 font-light">
      Presque tous les plats italiens célèbres portent le nom d'une ville. Celui-ci porte le nom d'un hameau de quelques centaines d'habitants, caché à la pointe extrême de la péninsule sorrentine. Nerano domine une baie appelée <a href="/fr-fr/plages/peninsule-sorrentine/marina-del-cantone/" class="text-med-blue hover:underline">Marina del Cantone</a>, face à Capri, et les pâtes qui portent son nom y ont été inventées, dans une seule cuisine, un soir de 1952. Aujourd'hui presque tous les restaurants entre Naples et Salerne en servent une version. Un seul endroit peut revendiquer l'original.
    </p>
  </div>

  <!-- Origin -->
  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">Nerano, 1952 : la naissance du plat</h2>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      La cuisine était celle du <strong>Ristorante Maria Grazia</strong>, une affaire de famille ouverte en 1901 sur la plage de Marina del Cantone. Aux fourneaux, Donna Rosa, et le plat qu'elle assemble en 1952 utilise ce que le potager et la fromagerie du coin peuvent fournir : courgettes, fromage, basilic, huile d'olive. Rien qui doive être livré, ce qui, sur une route aussi raide, comptait beaucoup.
    </p>
    <p class="text-slate-600 text-lg leading-relaxed mb-8">
      Le restaurant est toujours tenu par ses descendants, et la famille a toujours gardé pour elle la façon de lier la sauce. Cette réticence fait partie de la légende, mais la vraie raison du voyage du plat est plus simple : la baie est devenue un mouillage pour les bateaux venus de Capri et de <a href="/fr-fr/cote-amalfitaine/positano/" class="text-med-blue hover:underline">Positano</a>, et ceux qui en descendaient rapportaient le nom chez eux.
    </p>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div class="bg-white p-6 rounded-[2rem] border border-slate-100 shadow-sm">
        <h4 class="font-bold text-slate-900 mb-2">Un hameau, pas une ville</h4>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Nerano est une frazione de <a href="/fr-fr/peninsule-sorrentine/massa-lubrense/" class="text-med-blue hover:underline">Massa Lubrense</a>, qui en compte dix-sept dispersées sur le promontoire. Elle n'a pas de centre au sens habituel : une place, et une route qui descend à la mer.</p>
      </div>
      <div class="bg-white p-6 rounded-[2rem] border border-slate-100 shadow-sm">
        <h4 class="font-bold text-slate-900 mb-2">Ce n'est pas la côte amalfitaine</h4>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">La baie regarde le golfe de Salerne mais relève administrativement de la péninsule sorrentine. Qui ne cherche que le long de la route amalfitaine n'y arrive jamais, et c'est précisément pour cela qu'elle est restée petite.</p>
      </div>
    </div>
  </div>

  <!-- Where to eat -->
  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">Où manger les Spaghetti alla Nerano à Nerano</h2>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      Les deux adresses qui comptent occupent le même court ruban de plage, à quelques minutes de marche l'une de l'autre. Ce sont des expériences très différentes, et le choix dépend vraiment de ce que vous cherchez.
    </p>

    <div class="overflow-hidden rounded-[2rem] border border-slate-100 shadow-sm">
      <table class="w-full text-xs sm:text-xs sm:text-sm">
        <thead class="bg-slate-900 text-white">
          <tr>
            <th class="text-left p-5 font-serif font-bold text-med-gold">Restaurant</th>
            <th class="text-left p-5 font-serif font-bold text-med-gold">À savoir</th>
          </tr>
        </thead>
        <tbody class="bg-white">
          <tr class="border-b border-slate-100">
            <td class="p-5 font-bold">Maria Grazia</td>
            <td class="p-5 text-slate-600">Le berceau. Ouvert depuis 1901, toujours dans la famille, et la raison pour laquelle le plat s'appelle alla Nerano. On y vient pour la version dont descend la recette, plus que pour la vue.</td>
          </tr>
          <tr class="border-b border-slate-100">
            <td class="p-5 font-bold">Lo Scoglio da Tommaso</td>
            <td class="p-5 text-slate-600">Construit au-dessus de l'eau sur son propre ponton, avec les produits du potager familial. Filmé par Stanley Tucci pour "Searching for Italy", d'où des réservations qui partent des mois à l'avance en été.</td>
          </tr>
          <tr>
            <td class="p-5 font-bold">Partout ailleurs</td>
            <td class="p-5 text-slate-600">Vous trouverez le plat sur les cartes des deux côtes. Considérez-les comme des interprétations. Si une cuisine le sert à la crème, elle ne suit pas la méthode de Nerano.</td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>

  <!-- Getting there -->
  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">Comment rejoindre Nerano et Marina del Cantone</h2>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      La baie est à une trentaine de minutes de Sorrente par la route, mais la route est étroite et le dernier tronçon plonge vers la mer. Choisissez votre moyen de transport avant de partir plutôt que le jour même.
    </p>

    <div class="bg-white p-8 rounded-[2rem] border border-slate-100 shadow-sm">
      <h3 class="font-serif text-xl font-bold text-slate-900 mb-5">Trois façons de descendre dans la baie</h3>
      <div class="space-y-3">
        <div class="flex items-start gap-3">
          <div class="w-6 h-6 rounded-full bg-med-gold/15 flex-shrink-0 flex items-center justify-center text-med-gold font-bold text-xs">1</div>
          <p class="text-slate-600 text-xs sm:text-sm leading-relaxed"><strong>En <a href="/fr-fr/guide/bus-sita/" class="text-med-blue hover:underline">bus SITA</a></strong> depuis la gare de Sorrente, environ 50 minutes. Certaines courses imposent un changement à Sant Agata sui Due Golfi : vérifiez l'horaire de la liaison directe pour Nerano.</p>
        </div>
        <div class="flex items-start gap-3">
          <div class="w-6 h-6 rounded-full bg-med-gold/15 flex-shrink-0 flex items-center justify-center text-med-gold font-bold text-xs">2</div>
          <p class="text-slate-600 text-xs sm:text-sm leading-relaxed"><strong>En voiture</strong>, une trentaine de minutes depuis Sorrente via Massa Lubrense. Le stationnement à Marina del Cantone est limité et payant, et en août il est plein dès le milieu de matinée.</p>
        </div>
        <div class="flex items-start gap-3">
          <div class="w-6 h-6 rounded-full bg-med-gold/15 flex-shrink-0 flex items-center justify-center text-med-gold font-bold text-xs">3</div>
          <p class="text-slate-600 text-xs sm:text-sm leading-relaxed"><strong>Par la mer</strong> depuis Sorrente, Positano ou Capri. C'est ainsi qu'arrive la majorité des visiteurs en été, et plusieurs restaurants disposent de leur propre mouillage.</p>
        </div>
      </div>
    </div>
  </div>

  <!-- The technique -->
  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">Ce qui les distingue de simples pâtes aux courgettes</h2>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      La liste des ingrédients est d'une brièveté presque gênante : tout repose donc sur la méthode. Deux gestes séparent le vrai plat d'une assiette de pâtes aux courgettes.
    </p>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      D'abord, les courgettes sont <strong>frites à part et laissées reposer</strong>, souvent plusieurs heures. Elles s'affaissent et se sucrent au lieu de cuire à la vapeur, et l'huile qu'elles rendent porte leur goût jusque dans la sauce finale. Ensuite, la sauce se termine hors du feu : le fromage râpé, traditionnellement du <strong>Provolone del Monaco AOP</strong> de la péninsule ou une caciotta locale, est émulsionné avec l'eau de cuisson riche en amidon jusqu'à ce qu'il nappe au lieu de se déposer.
    </p>

    <blockquote class="border-l-4 border-med-gold pl-6 my-8">
      <p class="text-slate-700 text-xl font-serif italic leading-relaxed">
        "Il n'y a pas de crème dans les Spaghetti alla Nerano. Ce qui ressemble à de la crème, c'est du fromage, de l'eau et de la patience."
      </p>
    </blockquote>
  </div>

  <!-- Local Tips -->
  <div class="bg-white p-8 rounded-[2rem] shadow-xl border border-slate-100">
    <div class="flex items-center gap-4 mb-6">
      <svg class="w-6 h-6 text-med-gold flex-shrink-0" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M9 18h6"/><path d="M10 22h4"/><path d="M15.09 14c.18-.98.65-1.74 1.41-2.5A4.65 4.65 0 0 0 18 8 6 6 0 0 0 6 8c0 1 .23 2.23 1.5 3.5A4.61 4.61 0 0 1 8.91 14"/></svg>
      <h3 class="text-xl font-bold">Les Conseils de l'Expert</h3>
    </div>
    <div class="space-y-6">
      <div>
        <p class="font-bold text-slate-900 mb-1">Réservez avant de partir, pas à l'arrivée</p>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Marina del Cantone ne compte qu'une poignée de restaurants et reçoit en même temps les arrivées par la route et par la mer. En juillet et août, les tables du déjeuner dans les deux maisons historiques partent des mois à l'avance.</p>
      </div>
      <div>
        <p class="font-bold text-slate-900 mb-1">Venez à la saison des courgettes</p>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Le plat dépend entièrement de la qualité du légume : il donne donc le meilleur de juin à septembre. Hors saison on vous le servira quand même, mais avec un produit qui n'a pas poussé sur le promontoire.</p>
      </div>
      <div>
        <p class="font-bold text-slate-900 mb-1">Faites de la baie une journée entière</p>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Le déjeuner appelle naturellement une baignade. <a href="/fr-fr/blog/baia-recommone/" class="text-med-blue hover:underline">Baia di Recommone</a> est la crique suivante, et le sentier de la Baia di Ieranto part de la place de Nerano et file vers <a href="/fr-fr/blog/punta-campanella/" class="text-med-blue hover:underline">Punta Campanella</a>, Capri devant vous tout du long.</p>
      </div>
    </div>
  </div>

</BlogPostLayout>
