---
import BlogPostLayout from '../../../../layouts/BlogPostLayout.astro';

const lang = 'fr-fr';
const post = {
  title: 'Positano ou Amalfi',
  subtitle: 'Où loger sur la Côte Amalfitaine : guide 2026',
  category: 'GUIDES',
  date: '29 mai 2026',
  readTime: '11 min',
  image: '/images/positano-vs-amalfi-hero.webp',
  imageAlt: 'Positano et Amalfi : comparaison entre les deux icônes de la Côte',
  path: '/fr-fr/blog/positano-vs-amalfi/',
};

const metaTitle = 'Positano ou Amalfi 2026 : Quoi Choisir pour Votre Voyage ? | Comparaison Locale';
const metaDescription = 'Positano ou Amalfi : guide 2026 avec cas d\'usage (lune de miel, famille, première fois). Hôtels, prix, transports, plages. Choisissez la bonne ville de la Côte en 5 minutes.';

const breadcrumbs = [
  { name: 'Accueil', url: '/fr-fr/' },
  { name: 'Blog', url: '/fr-fr/blog/' },
  { name: 'Positano ou Amalfi', url: '/fr-fr/blog/positano-vs-amalfi/' },
];

const quickInfo = [
  { label: 'Distance', value: '17 km le long de la SS163' },
  { label: 'Temps de trajet', value: '~40 min bus SITA ou 25 min ferry' },
  { label: 'Positano', value: '~4 000 habitants · carte postale verticale' },
  { label: 'Amalfi', value: '~5 000 habitants · cité maritime médiévale' },
  { label: 'Tarifs hôtel', value: 'Positano €250-1 500 · Amalfi €150-700' },
  { label: 'Pour lune de miel', value: 'Positano' },
  { label: 'Pour familles', value: 'Amalfi' },
];

const faq = [
  {
    q: 'Positano ou Amalfi pour la lune de miel ?',
    a: "Positano. Le drame visuel (maisons aux couleurs pastel cascadant vers une plage turquoise) est inégalé. Les jeunes mariés veulent l'image iconique, et cette image est Positano. Amalfi est historiquement plus riche (c'était une république maritime) mais visuellement plus méditerranéenne conventionnelle. Si vos photos de lune de miel comptent, Positano gagne.",
  },
  {
    q: 'Positano ou Amalfi pour les familles avec enfants ?',
    a: "Amalfi, clairement. Amalfi a une place principale plate (Piazza Duomo), de larges allées piétonnes, une longue plage publique, supermarchés et pharmacies au même niveau que l'hôtel. Positano c'est 600+ marches et impossible avec des poussettes. Familles avec adolescents 14+ peuvent gérer Positano; avec enfants plus jeunes, choisissez Amalfi.",
  },
  {
    q: 'Positano ou Amalfi : laquelle est moins chère ?',
    a: "Amalfi est 30-40% moins chère globalement. Hôtel 3★ à Amalfi : €150-220; même catégorie à Positano : €280-450. Pasta au restaurant : €14 à Amalfi vs €20 à Positano. Transat : €20-30 vs €35-60. Espresso au bar : €1,50 vs €2,50.",
  },
  {
    q: 'Positano ou Amalfi : combien de nuits ?',
    a: "Positano fonctionne comme étape romantique de 2-3 nuits ou base slow luxury de 4+ nuits. Amalfi fonctionne comme base 3-5 nuits pour explorer le reste de la Côte : c'est le centre géographique et logistique, avec les meilleures connexions ferry/bus vers Ravello, Minori, Maiori, Capri, Salerne. 1 nuit dans l'une ou l'autre est trop court pour la logistique.",
  },
  {
    q: 'Puis-je faire excursion Positano-Amalfi (ou vice-versa) ?',
    a: "Oui, facilement. Bus SITA Amalfi → Positano toutes les 30-60 min (€2,40, ~40 min). Ferry saisonnier (avril-octobre) plus rapide et panoramique : 25 min, €11. Dans les deux directions, arrivez avant 11h et partez avant 17h pour éviter le pic d'affluence.",
  },
  {
    q: 'Positano ou Amalfi pour excursion à Ravello ?',
    a: "Amalfi, beaucoup plus facile. Ravello est sur la falaise directement au-dessus d'Amalfi : bus SITA toutes les 30 min, 25 min de trajet, €2,40. Depuis Positano, la même excursion exige de passer d'abord par Amalfi : 1h15 par trajet. Festival musical à Ravello ? Vous logez à Amalfi.",
  },
  {
    q: 'Positano ou Amalfi pour le Sentier des Dieux (Sentiero degli Dei) ?',
    a: "Positano, de peu. Le classique Sentier des Dieux se termine à Nocelle (au-dessus de Positano) et descend dans le village : logistique facile. Depuis Amalfi vous devez d'abord prendre un bus pour Bomerano (1h+ via Agerola). Si vous faites le sentier une seule fois, Positano est la meilleure base pour la descente finale.",
  },
];

const sidebarLinks = [
  { label: 'Guide Amalfi', href: '/fr-fr/cote-amalfitaine/amalfi/' },
  { label: 'Guide Positano', href: '/fr-fr/cote-amalfitaine/positano/' },
  { label: 'Guide Ravello', href: '/fr-fr/cote-amalfitaine/ravello/' },
  { label: 'Bus SITA : horaires', href: '/fr-fr/guide/bus-sita/' },
  { label: 'Ferries : routes', href: '/fr-fr/guide/ferries/' },
  { label: 'Sorrente ou Positano', href: '/fr-fr/blog/sorrento-vs-positano/' },
];

const authorRole = 'Expert logistique voyages · Côte Amalfitaine';

const relatedArticles = [
  {
    title: 'Sorrente ou Positano',
    category: 'GUIDES',
    date: '29 mai 2026',
    image: '/images/sorrento-vs-positano-hero.webp',
    imageAlt: 'Sorrente et Positano : comparaison',
    path: '/fr-fr/blog/sorrento-vs-positano/',
  },
  {
    title: 'Praiano ou Positano',
    category: 'GUIDES',
    date: '1 juin 2026',
    image: '/images/praiano-vs-positano-hero.webp',
    imageAlt: 'Praiano et Positano comparés',
    path: '/fr-fr/blog/praiano-vs-positano/',
  },
];

const compareSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: 'Positano ou Amalfi : où loger sur la Côte Amalfitaine',
  about: [
    { '@type': 'Place', name: 'Positano', address: { '@type': 'PostalAddress', addressLocality: 'Positano', addressRegion: 'SA', addressCountry: 'IT' } },
    { '@type': 'Place', name: 'Amalfi', address: { '@type': 'PostalAddress', addressLocality: 'Amalfi', addressRegion: 'SA', addressCountry: 'IT' } },
  ],
};
---

<BlogPostLayout
  lang={lang}
  post={post}
  metaTitle={metaTitle}
  metaDescription={metaDescription}
  breadcrumbs={breadcrumbs}
  quickInfo={quickInfo}
  faq={faq}
  sidebarLinks={sidebarLinks}
  authorRole={authorRole}
  relatedArticles={relatedArticles}
  extraSchema={[compareSchema]}
>

  <div>
    <p class="text-slate-600 text-xl leading-relaxed mb-6 font-light">
      <strong>Positano ou Amalfi ?</strong> Les deux icônes de la Côte Amalfitaine sont à 17 km le long de la même route dramatique de falaise, mais offrent des expériences fondamentalement différentes. Positano est l'icône visuelle : maisons aux couleurs pastel, beach clubs exclusifs, vues mer à $400/nuit. Amalfi est le cœur historique : république maritime médiévale avec cathédrale normano-arabe et prix 30% plus bas. Ce guide choisit la bonne ville pour votre voyage spécifique (lune de miel, famille, randonnée, Ravello).
    </p>
  </div>

  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">Pour la lune de miel : Positano</h2>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      Les jeunes mariés viennent pour l'image. <a href="/fr-fr/cote-amalfitaine/positano/" class="text-med-blue hover:underline">Positano</a> EST l'image de la Côte Amalfitaine : la photo sur chaque tableau Pinterest, chaque couverture de magazine, chaque liste de "meilleures destinations européennes". <a href="/fr-fr/cote-amalfitaine/amalfi/" class="text-med-blue hover:underline">Amalfi</a> a sa propre beauté (marches de la cathédrale, arsenal médiéval), mais ne livre pas le moment de carte postale.
    </p>
    <div class="bg-white p-8 rounded-[2rem] border border-slate-100 shadow-sm mb-6">
      <h3 class="font-serif text-xl font-bold text-slate-900 mb-4">Expériences de lune de miel que seul Positano offre</h3>
      <ul class="space-y-4 text-slate-600">
        <li class="flex items-start gap-3">
          <span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span>
          <span class="text-slate-700"><strong>Déjeuner en bateau Da Adolfo.</strong> Le restaurant de plage accessible uniquement en bateau, navette gratuite depuis Spiaggia Grande, mozzarella sur feuilles de citron : le déjeuner le plus photographié de la Côte.</span>
        </li>
        <li class="flex items-start gap-3">
          <span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span>
          <span class="text-slate-700"><strong>Cocktail à La Sponda.</strong> La terrasse de l'hôtel Le Sirenuse au coucher de soleil : vues 5★ Michelin sans y séjourner.</span>
        </li>
        <li class="flex items-start gap-3">
          <span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span>
          <span class="text-slate-700"><strong>Coucher de soleil depuis la <a href="/fr-fr/plages/cote-amalfitaine/fornillo-positano/" class="text-med-blue hover:underline">Plage de Fornillo</a>.</strong> Marchez la Via Positanesi d'America, apéritif chez Pupetto, le dôme orange brillant sur la baie.</span>
        </li>
      </ul>
    </div>
    <p class="text-slate-600 text-lg leading-relaxed">
      Amalfi a sa romance, mais c'est la romance d'une cité historique, plus Venise que lune de miel à Bali. Si vous êtes venus pour L'esthétique de la Côte Amalfitaine, Positano la livre. Point.
    </p>
  </div>

  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">Pour les familles : Amalfi</h2>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      Amalfi résout chaque problème familial de Positano. La place principale (Piazza Duomo) est plate. La plage est juste sous la route principale, avec une longue promenade pavée et ombragée. Hôtels avec parking. Trottoirs adaptés aux poussettes. Grand supermarché (Conad) à deux minutes de la place. Pharmacie pédiatrique sur la rue principale.
    </p>
    <div class="bg-med-cream p-8 rounded-[2rem] border border-med-gold/20 mb-6">
      <h3 class="font-serif text-xl font-bold text-slate-900 mb-4">Logistique famille, face à face</h3>
      <table class="w-full text-sm">
        <tbody class="divide-y divide-med-gold/20">
          <tr><td class="py-2 font-semibold">Rues adaptées aux poussettes</td><td class="py-2">Amalfi ✓ · Positano ✗</td></tr>
          <tr><td class="py-2 font-semibold">Parking hôtel</td><td class="py-2">Amalfi ✓ · Positano très limité</td></tr>
          <tr><td class="py-2 font-semibold">Chemin plat vers la plage</td><td class="py-2">Amalfi ✓ · Positano escaliers seulement</td></tr>
          <tr><td class="py-2 font-semibold">Supermarché à 5 min</td><td class="py-2">Amalfi ✓ · Positano ✗</td></tr>
          <tr><td class="py-2 font-semibold">Attraction pour enfants</td><td class="py-2">Musée du Papier, cloître Cathédrale</td></tr>
          <tr><td class="py-2 font-semibold">Excursion rapide Ravello</td><td class="py-2">25 min bus depuis Amalfi</td></tr>
        </tbody>
      </table>
    </div>
    <p class="text-slate-600 text-lg leading-relaxed">
      Bonus : depuis Amalfi vous pouvez mettre les enfants sur le ferry vers Capri (1 heure) pour le tour de la Grotte Bleue : une journée magique sans pousser de poussette.
    </p>
  </div>

  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">Pour première visite : dépend du style</h2>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      Ici la réponse se divise. Si vous êtes venus "voir la Côte Amalfitaine" et que cela signifie la vue de carte postale → <strong>Positano</strong>. Si vous êtes venus explorer la Côte dans son ensemble, avec excursions à Ravello, Minori, Capri et Salerne → <strong>Amalfi</strong>.
    </p>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      Amalfi est au centre géographique de la Côte. Chaque bus SITA et chaque route de ferry passe ici. Depuis Amalfi :
    </p>
    <div class="overflow-hidden rounded-[2rem] border border-slate-100 shadow-sm mb-6">
      <table class="w-full text-sm">
        <thead class="bg-slate-900 text-white">
          <tr>
            <th class="text-left p-4 font-bold text-med-gold">D'Amalfi à</th>
            <th class="text-left p-4 font-bold text-med-gold">Moyen</th>
            <th class="text-left p-4 font-bold text-med-gold">Temps</th>
          </tr>
        </thead>
        <tbody class="bg-white">
          <tr class="border-b border-slate-100"><td class="p-4 font-semibold">Ravello</td><td class="p-4">Bus SITA</td><td class="p-4">25 min</td></tr>
          <tr class="border-b border-slate-100"><td class="p-4 font-semibold">Positano</td><td class="p-4">Ferry / bus</td><td class="p-4">25 / 40 min</td></tr>
          <tr class="border-b border-slate-100"><td class="p-4 font-semibold">Minori et Maiori</td><td class="p-4">Bus SITA</td><td class="p-4">15-20 min</td></tr>
          <tr class="border-b border-slate-100"><td class="p-4 font-semibold">Capri</td><td class="p-4">Ferry</td><td class="p-4">1h</td></tr>
          <tr class="border-b border-slate-100"><td class="p-4 font-semibold">Salerne (pour trains au sud)</td><td class="p-4">Ferry / bus</td><td class="p-4">35 / 70 min</td></tr>
          <tr><td class="p-4 font-semibold">Grotte d'Émeraude</td><td class="p-4">Bus / ferry</td><td class="p-4">15 min</td></tr>
        </tbody>
      </table>
    </div>
    <p class="text-slate-600 text-lg leading-relaxed">
      Le désavantage logistique de Positano : chaque excursion à l'est commence par bus via Amalfi, ajoutant 30-40 minutes par trajet à tout ce qui se trouve à l'est de Positano.
    </p>
  </div>

  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">Pour voyageurs avec budget : Amalfi économise 30-40%</h2>
    <div class="overflow-hidden rounded-[2rem] border border-slate-100 shadow-sm mb-6">
      <table class="w-full text-sm">
        <thead class="bg-slate-900 text-white">
          <tr>
            <th class="text-left p-4 font-bold text-med-gold">Élément (moyenne mai 2026)</th>
            <th class="text-left p-4 font-bold text-med-gold">Amalfi</th>
            <th class="text-left p-4 font-bold text-med-gold">Positano</th>
          </tr>
        </thead>
        <tbody class="bg-white">
          <tr class="border-b border-slate-100"><td class="p-4 font-semibold">Hôtel 3★, double</td><td class="p-4">€150-220</td><td class="p-4">€280-450</td></tr>
          <tr class="border-b border-slate-100"><td class="p-4 font-semibold">4★ avec vue mer</td><td class="p-4">€250-450</td><td class="p-4">€500-900</td></tr>
          <tr class="border-b border-slate-100"><td class="p-4 font-semibold">Transat + parasol</td><td class="p-4">€20-30</td><td class="p-4">€35-60</td></tr>
          <tr class="border-b border-slate-100"><td class="p-4 font-semibold">Pasta gamme moyenne</td><td class="p-4">€14-18</td><td class="p-4">€18-25</td></tr>
          <tr><td class="p-4 font-semibold">Parking hôtel/nuit</td><td class="p-4">€20-35</td><td class="p-4">€40-70</td></tr>
        </tbody>
      </table>
    </div>
  </div>

  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">Le verdict en 30 secondes</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8">
      <div class="bg-white p-6 rounded-[2rem] border border-slate-100 shadow-sm">
        <p class="text-med-gold text-[10px] font-bold uppercase tracking-[0.2em] mb-3">Choisissez Positano si :</p>
        <ul class="space-y-3 text-slate-600 text-sm">
          <li class="flex items-start gap-3"><span class="w-2 h-2 bg-med-gold rounded-full mt-2 flex-shrink-0"></span><span>Voyage de lune de miel ou anniversaire</span></li>
          <li class="flex items-start gap-3"><span class="w-2 h-2 bg-med-gold rounded-full mt-2 flex-shrink-0"></span><span>Vous êtes venus pour l'image iconique de carte postale</span></li>
          <li class="flex items-start gap-3"><span class="w-2 h-2 bg-med-gold rounded-full mt-2 flex-shrink-0"></span><span>Le Sentier des Dieux est sur la bucket list</span></li>
          <li class="flex items-start gap-3"><span class="w-2 h-2 bg-med-gold rounded-full mt-2 flex-shrink-0"></span><span>Budget €400+/nuit pour la chambre que vous voulez vraiment</span></li>
          <li class="flex items-start gap-3"><span class="w-2 h-2 bg-med-gold rounded-full mt-2 flex-shrink-0"></span><span>2-3 nuits dans un voyage italien plus large</span></li>
        </ul>
      </div>
      <div class="bg-white p-6 rounded-[2rem] border border-slate-100 shadow-sm">
        <p class="text-med-gold text-[10px] font-bold uppercase tracking-[0.2em] mb-3">Choisissez Amalfi si :</p>
        <ul class="space-y-3 text-slate-600 text-sm">
          <li class="flex items-start gap-3"><span class="w-2 h-2 bg-med-gold rounded-full mt-2 flex-shrink-0"></span><span>Voyage avec enfants de moins de 14 ans</span></li>
          <li class="flex items-start gap-3"><span class="w-2 h-2 bg-med-gold rounded-full mt-2 flex-shrink-0"></span><span>Vous voulez explorer toute la Côte (Ravello, Minori, Maiori, Capri)</span></li>
          <li class="flex items-start gap-3"><span class="w-2 h-2 bg-med-gold rounded-full mt-2 flex-shrink-0"></span><span>Budget moins de €250/nuit avec vue mer</span></li>
          <li class="flex items-start gap-3"><span class="w-2 h-2 bg-med-gold rounded-full mt-2 flex-shrink-0"></span><span>Voyageur culturel : cathédrale, musée du papier, histoire maritime</span></li>
          <li class="flex items-start gap-3"><span class="w-2 h-2 bg-med-gold rounded-full mt-2 flex-shrink-0"></span><span>3-5 nuits avec plusieurs excursions prévues</span></li>
        </ul>
      </div>
    </div>
    <blockquote class="border-l-4 border-med-gold pl-6 mb-8">
      <p class="text-slate-700 text-lg font-serif italic leading-relaxed">
        "💡 Conseil local : ici aussi le séjour partagé fonctionne magnifiquement. 2 nuits à Positano au début pour la romance et les photos iconiques, puis 3 nuits à Amalfi comme base pour explorer le reste de la Côte (soirée au Ravello Festival, journée à Minori pour les citrons, excursion à Capri). Vous vivez toute l'expérience Côte sans brûler le budget sur un seul hôtel."
      </p>
    </blockquote>
  </div>

  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">Tableau de comparaison rapide</h2>
    <div class="overflow-hidden rounded-[2rem] border border-slate-100 shadow-sm">
      <table class="w-full text-sm">
        <thead class="bg-slate-900 text-white">
          <tr>
            <th class="text-left p-4 font-bold text-med-gold">Caractéristique</th>
            <th class="text-left p-4 font-bold text-med-gold">Positano</th>
            <th class="text-left p-4 font-bold text-med-gold">Amalfi</th>
          </tr>
        </thead>
        <tbody class="bg-white">
          <tr class="border-b border-slate-100"><td class="p-4 font-semibold">Terrain</td><td class="p-4">600+ marches, vertical</td><td class="p-4">Place plate, pentes douces</td></tr>
          <tr class="border-b border-slate-100"><td class="p-4 font-semibold">Style visuel</td><td class="p-4">Village pastel de carte postale</td><td class="p-4">Maritime médiéval, cathédrale normano-arabe</td></tr>
          <tr class="border-b border-slate-100"><td class="p-4 font-semibold">Plage</td><td class="p-4">Spiaggia Grande + Fornillo</td><td class="p-4">Longue plage publique avec promenade</td></tr>
          <tr class="border-b border-slate-100"><td class="p-4 font-semibold">Accès Ravello</td><td class="p-4">1h15 (via Amalfi)</td><td class="p-4">25 min bus direct</td></tr>
          <tr class="border-b border-slate-100"><td class="p-4 font-semibold">Accès Capri</td><td class="p-4">35 min ferry</td><td class="p-4">1h ferry</td></tr>
          <tr class="border-b border-slate-100"><td class="p-4 font-semibold">Coût moyen hôtel</td><td class="p-4">€280-900</td><td class="p-4">€150-450</td></tr>
          <tr class="border-b border-slate-100"><td class="p-4 font-semibold">Adapté aux poussettes</td><td class="p-4">Non</td><td class="p-4">Oui</td></tr>
          <tr><td class="p-4 font-semibold">Idéal pour</td><td class="p-4">Lunes de miel, photographes, slow travellers</td><td class="p-4">Familles, voyageurs culturels, explorateurs Côte</td></tr>
        </tbody>
      </table>
    </div>
  </div>

</BlogPostLayout>
