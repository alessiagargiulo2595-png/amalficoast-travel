---
import BlogPostLayout from '../../../../layouts/BlogPostLayout.astro';

const lang = 'fr-fr';
const post = {
  title: "Le Ciuccio di fuoco : la Saint-Sylvestre à Sorrente et Sant'Agata",
  subtitle: "L'âne de feu qui clôt la vieille année l'après-midi du 31 décembre, sur la Piazza Tasso et sur la place de Sant'Agata sui Due Golfi : ce que c'est, à quelle heure il brûle et comment l'intégrer au reste de la soirée",
  category: 'DÉCOUVERTES',
  date: '28 novembre 2026',
  readTime: '8 min',
  image: '/images/ciuccio-di-fuoco-hero.webp',
  imageAlt: "Une flamme sur fond noir",
  path: '/fr-fr/blog/ciuccio-di-fuoco-sorrente-santagata/',
};

const metaTitle = "Ciuccio di fuoco : Saint-Sylvestre à Sorrente et Sant'Agata";
const metaDescription = "L'âne de feu du 31 décembre sur la Piazza Tasso de Sorrente et à Sant'Agata sui Due Golfi : signification, horaires récents, accès et suite de la soirée.";

const breadcrumbs = [
  { name: 'Accueil', url: '/fr-fr/' },
  { name: 'Blog', url: '/fr-fr/blog/' },
  { name: 'Le Ciuccio di fuoco', url: '/fr-fr/blog/ciuccio-di-fuoco-sorrente-santagata/' },
];

const quickInfo = [
  { label: 'Date', value: '31 décembre, fin d\'après-midi' },
  { label: 'Sorrente', value: 'Piazza Tasso, 18 h ces dernières années' },
  { label: 'Avant', value: 'Défilé folklorique dès 17 h, Corso Italia' },
  { label: "Sant'Agata", value: 'Sur la place, après le chant de 16 h/16 h 30' },
  { label: "Organisateur à Sant'Agata", value: 'Pro Loco Due Golfi' },
  { label: 'Prix', value: 'Gratuit, places ouvertes' },
  { label: 'Durée', value: 'Quelques minutes de feux' },
  { label: 'Programme 2026', value: 'Publié en général fin décembre' },
];

const faq = [
  {
    q: "Qu'est-ce que le Ciuccio di fuoco ?",
    a: "C'est une silhouette d'âne en papier mâché, garnie de feux d'artifice, que l'on allume sur la place principale l'après-midi du 31 décembre. Les charges partent les unes après les autres pendant quelques minutes et la figure se consume. Elle représente l'année qui s'achève : on renvoie l'âne pour que la nouvelle année commence sur une page blanche.",
  },
  {
    q: 'À quelle heure a lieu le Ciuccio di fuoco à Sorrente ?',
    a: "Lors des dernières éditions, à 18 h sur la Piazza Tasso, après un défilé folklorique qui part vers 17 h entre le Corso Italia et le centre historique. La commune de Sorrente publie le programme de la Saint-Sylvestre dans les derniers jours de décembre : vérifiez l'horaire à ce moment-là.",
  },
  {
    q: "Y a-t-il aussi un Ciuccio di fuoco à Sant'Agata sui Due Golfi ?",
    a: "Oui. Sant'Agata, le hameau perché de Massa Lubrense, allume le sien sur la place du village à la fin de la Canzone de lo Capo d'Anno, le chant traditionnel du Nouvel An que l'on porte dans les rues l'après-midi. La Pro Loco Due Golfi l'a organisé lors des éditions passées, et en 2024 l'allumage était annoncé à 16 h 30. Il a lieu avant celui de Sorrente.",
  },
  {
    q: 'Est-ce adapté aux enfants ?',
    a: "C'est surtout pour eux, et les familles du coin viennent chaque année avec les plus petits. C'est bruyant et ça projette des étincelles : restez à quelques mètres de la figure, gardez les jeunes enfants en bordure de la foule et pensez à une protection auditive pour les bébés.",
  },
  {
    q: "Peut-on voir les deux le même après-midi ?",
    a: "En théorie oui, car Sant'Agata passe en général en premier et les deux lieux sont à environ 8 km. En pratique, cela dépend des horaires exacts de l'année et de la circulation, et le soir du 31 le centre de Sorrente est fermé aux voitures. Mieux vaut en choisir un, sauf si les deux horaires sont confirmés avec un écart net.",
  },
  {
    q: 'Que se passe-t-il à Sorrente après le Ciuccio ?',
    a: "La Piazza Tasso reste le cœur de la nuit. En 2024 et 2025, il y avait musique live et DJ set de 23 h à 3 h, le compte à rebours sur la place et des feux d'artifice depuis Marina Piccola à 1 h. La journée commence en fin de matinée avec le concert de fin d'année au Teatro Tasso.",
  },
];

const sidebarLinks = [
  { label: 'Sorrente', href: '/fr-fr/peninsule-sorrentine/sorrente/' },
  { label: 'Massa Lubrense', href: '/fr-fr/peninsule-sorrentine/massa-lubrense/' },
  { label: 'Nouvel An à Sorrente', href: '/fr-fr/evenements/peninsule-sorrentine/capodanno-sorrento/' },
  { label: 'Bus SITA', href: '/fr-fr/guide/bus-sita/' },
  { label: 'Nouvel An à Positano', href: '/fr-fr/blog/nouvel-an-positano-feux-artifice/' },
];

const authorRole = 'Spécialiste Côte Amalfitaine';

const relatedArticles = [
  {
    title: "Feux d'artifice du Nouvel An à Positano",
    category: 'GUIDE',
    date: '24 novembre 2026',
    image: '/images/spiaggia-grande-positano-hero.webp',
    imageAlt: 'La Spiaggia Grande de Positano',
    path: '/fr-fr/blog/nouvel-an-positano-feux-artifice/'
  },
  {
    title: 'Illuminations de Noël à Sorrente et Salerne',
    category: 'GUIDE',
    date: '21 octobre 2026',
    image: '/images/luci-artista-salerno-hero.webp',
    imageAlt: 'Illuminations de Noël à Salerne',
    path: '/fr-fr/blog/illuminations-noel-sorrente-salerne/'
  }
];


const keyTakeaways = [
  "Le Ciuccio di fuoco est un âne en papier mâché rempli de feux d'artifice, brûlé sur la place le 31 décembre pour congédier la vieille année. À Sorrente, il fait partie de la Saint-Sylvestre depuis les années 1960.",
  "Il brûle en fin d'après-midi, pas à minuit. À Sorrente, les dernières éditions avaient lieu à 18 h sur la Piazza Tasso, après un défilé folklorique dès 17 h.",
  "Sant'Agata sui Due Golfi, sur les collines de Massa Lubrense, a le sien, allumé sur la place à la fin de la Canzone de lo Capo d'Anno, avant celui de Sorrente.",
  "Les deux sont gratuits et courts : quelques minutes de feux. Arrivez tôt pour bien voir, et tenez les enfants à l'écart des étincelles.",
  "Les programmes 2026 ne sont pas encore sortis. Sorrente publie le sien en général dans les derniers jours de décembre ; Massa Lubrense publie son calendrier de Noël en décembre.",
];
---

<BlogPostLayout
  lang={lang}
  post={post}
  metaTitle={metaTitle}
  metaDescription={metaDescription}
  breadcrumbs={breadcrumbs}
  quickInfo={quickInfo}
  faq={faq}
  sidebarLinks={sidebarLinks}
  authorRole={authorRole}
  relatedArticles={relatedArticles}
  pageKey="ciuccio-di-fuoco"
>

  <!-- Key Takeaways -->
  <div class="bg-slate-900 text-white p-8 rounded-[2rem]">
    <div class="flex items-center gap-3 mb-6">
      <svg class="w-5 h-5 text-med-gold flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
      <h2 class="font-serif text-lg font-bold text-med-gold uppercase tracking-[0.15em]">Points Clés</h2>
    </div>
    <ul class="space-y-4">
      {keyTakeaways.map((point) => (
        <li class="flex items-start gap-3">
          <span class="w-1.5 h-1.5 rounded-full bg-med-gold flex-shrink-0 mt-2"></span>
          <span class="text-white/80 text-xs sm:text-sm leading-relaxed">{point}</span>
        </li>
      ))}
    </ul>
  </div>

  <!-- Intro -->
  <div>
    <p class="text-slate-600 text-xl leading-relaxed mb-6 font-light">
      Dans la péninsule de Sorrente, la vieille année n'attend pas minuit pour s'en aller. En fin d'après-midi du 31 décembre, à l'heure où l'on prend encore un café ou fait les derniers achats, on met le feu sur la place à un âne en papier mâché chargé de feux d'artifice, et pendant quelques minutes la place n'est que détonations, étincelles et fumée. Cela se passe à <a href="/fr-fr/peninsule-sorrentine/sorrente/" class="text-med-blue hover:underline">Sorrente</a>, sur la Piazza Tasso, et un peu plus tôt sur la colline à Sant'Agata sui Due Golfi, dans la commune de <a href="/fr-fr/peninsule-sorrentine/massa-lubrense/" class="text-med-blue hover:underline">Massa Lubrense</a>. On l'appelle le <em>ciuccio di fuoco</em>, l'âne de feu, et pour beaucoup de familles du coin, c'est le vrai début de la Saint-Sylvestre.
    </p>
  </div>

  <!-- What it is -->
  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">Ce qu'est le Ciuccio di fuoco</h2>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      <em>Ciuccio</em>, en napolitain, veut dire âne. La figure est construite en papier mâché, remplie et enveloppée de feux d'artifice, puis installée au milieu de la place. Une fois la mèche allumée, les charges partent en séquence, avec des gerbes d'étincelles, des sifflements et des détonations, et l'âne se consume entièrement. Le tout dure quelques minutes. À Sorrente, en 2024, c'est le maire qui a allumé la mèche, devant une place remplie d'habitants et de visiteurs.
    </p>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      Personne ne sait dire exactement d'où vient la coutume. Les récits locaux la rattachent à la vie paysanne de la péninsule, quand on brûlait des tas de paille le dernier jour de l'année pour éloigner la malchance, les mauvais esprits et la faim. L'âne, l'animal qui portait les charges des fermes et des terrasses, est devenu l'année elle-même : on le brûle pour qu'il emporte la vieille année avec lui. À Sorrente, le rituel accompagne la Saint-Sylvestre depuis les années 1960.
    </p>

    <blockquote class="border-l-4 border-med-gold pl-6 my-8">
      <p class="text-slate-700 text-xl font-serif italic leading-relaxed">
        « Ici, le feu ne sert pas à détruire, mais à conclure. »
      </p>
    </blockquote>

    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      Le ciuccio arrive rarement seul. Aux deux endroits, il conclut un parcours dans les rues avec la <strong>Canzone di Capodanno</strong> (à Sant'Agata, la <em>Canzone de lo Capo d'Anno</em>), le vieux chant de vœux que des groupes de musiciens portent dans les rues entre le 30 décembre et le jour de l'An, en souhaitant une bonne année à ceux qu'ils croisent. Il se chante en dialecte et part de la même idée : dire au revoir à l'année ensemble, dans la rue.
    </p>
  </div>

  <!-- Sorrento -->
  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">Sorrente : la Piazza Tasso à 18 h</h2>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      À Sorrente, le ciuccio fait partie du programme officiel de la Saint-Sylvestre, intégré à la saison d'hiver M'illumino d'Inverno portée par la commune. Le déroulé de l'après-midi est le même depuis des années :
    </p>
    <ul class="space-y-3 mb-6">
      <li class="flex items-start gap-3"><span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span><span class="text-slate-700"><strong>Dès 17 h, le défilé.</strong> Le groupe folklorique Piedigrotta Sorrentina parcourt le Corso Italia et le centre historique en jouant la Canzone di Capodanno.</span></li>
      <li class="flex items-start gap-3"><span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span><span class="text-slate-700"><strong>18 h, le ciuccio.</strong> L'âne est allumé sur la Piazza Tasso. Dans les programmes de 2017 et de 2025, l'acteur Marco Palmieri participait au spectacle.</span></li>
      <li class="flex items-start gap-3"><span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span><span class="text-slate-700"><strong>Gratuit.</strong> Tout se passe sur la place, sans billet ni zone réservée.</span></li>
    </ul>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      Ces horaires viennent des programmes des dernières éditions. Le programme 2026 n'est pas encore publié : Sorrente le diffuse en général dans les derniers jours de décembre, et les détails peuvent changer. Notre page sur le <a href="/fr-fr/evenements/peninsule-sorrentine/capodanno-sorrento/" class="text-med-blue hover:underline">Nouvel An à Sorrente</a> sera mise à jour avec l'annonce officielle.
    </p>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      La Piazza Tasso se remplit bien avant 18 h, car le défilé amène sa propre foule. Avec de jeunes enfants, une place en bordure est plus pratique que le centre : on voit les feux tout aussi bien et on peut s'écarter quand le bruit monte.
    </p>
  </div>

  <!-- Sant'Agata -->
  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">Sant'Agata sui Due Golfi : la version du village</h2>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      Sant'Agata est le plus grand hameau de Massa Lubrense, sur la crête au-dessus de Sorrente, d'où l'on voit d'un côté le golfe de Naples et de l'autre celui de Salerne. Son ciuccio a davantage l'allure d'une fête de village que celui de Sorrente, sur une place plus petite et avec moins de monde.
    </p>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      Ici, le chant d'abord, le feu ensuite. L'après-midi du 31, la <em>Canzone de lo Capo d'Anno</em> traverse les rues du village, ces dernières années au départ du Corso Sant'Agata, au croisement avec la Via Torricella, et à la fin l'âne est allumé sur la place. Lors des éditions passées, l'allumage était organisé par la Pro Loco Due Golfi. Les programmes récents placent le chant à 16 h ou 16 h 30, et en 2024 l'allumage était annoncé à 16 h 30, avec un brunch offert par la commune.
    </p>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-6">
      <div class="bg-white p-6 rounded-[2rem] border border-slate-100 shadow-sm">
        <h4 class="font-bold text-slate-900 mb-2">Avant Sorrente</h4>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Comme le chant part vers 16 h, le ciuccio de Sant'Agata passe avant celui de la Piazza Tasso. Si vous logez sur la colline, c'est celui à voir.</p>
      </div>
      <div class="bg-white p-6 rounded-[2rem] border border-slate-100 shadow-sm">
        <h4 class="font-bold text-slate-900 mb-2">Pas toujours au calendrier</h4>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Le calendrier 2025/2026 de Massa Lubrense mentionnait le chant mais pas le ciuccio. Au village, on l'attend quand même le 31, mais vérifiez le programme de décembre ou renseignez-vous auprès de la Pro Loco.</p>
      </div>
    </div>
  </div>

  <!-- Getting there -->
  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">Comment y aller le 31 décembre</h2>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      C'est l'hiver, et cela change les options. Il n'y a pas de ferries le long de la côte, et les bus roulent selon des horaires de jour férié qui s'arrêtent tôt.
    </p>

    <div class="overflow-x-auto rounded-[2rem] border border-slate-100 shadow-sm">
      <table class="w-full text-xs sm:text-sm">
        <thead class="bg-slate-900 text-white">
          <tr>
            <th class="text-left p-5 font-serif font-bold text-med-gold">Vers</th>
            <th class="text-left p-5 font-serif font-bold text-med-gold">Comment</th>
            <th class="text-left p-5 font-serif font-bold text-med-gold">À savoir</th>
          </tr>
        </thead>
        <tbody class="bg-white">
          <tr class="border-b border-slate-100">
            <td class="p-5 font-bold">Sorrente, depuis Naples</td>
            <td class="p-5 text-slate-600">Circumvesuviana jusqu'à la gare de Sorrente</td>
            <td class="p-5 text-slate-600">Environ 1 h ; la Piazza Tasso est à cinq minutes à pied de la gare</td>
          </tr>
          <tr class="border-b border-slate-100">
            <td class="p-5 font-bold">Sorrente, en voiture</td>
            <td class="p-5 text-slate-600">Parkings hors du centre</td>
            <td class="p-5 text-slate-600">Le soir du 31, le centre est fermé à la circulation</td>
          </tr>
          <tr class="border-b border-slate-100">
            <td class="p-5 font-bold">Sant'Agata, depuis Sorrente</td>
            <td class="p-5 text-slate-600">Bus depuis le secteur de la gare, ou voiture</td>
            <td class="p-5 text-slate-600">Environ 8 km, une vingtaine de minutes de route</td>
          </tr>
          <tr>
            <td class="p-5 font-bold">Les deux, depuis la côte amalfitaine</td>
            <td class="p-5 text-slate-600">Bus SITA par la route côtière</td>
            <td class="p-5 text-slate-600">Service d'hiver réduit, prévoyez d'abord le retour</td>
          </tr>
        </tbody>
      </table>
    </div>

    <p class="text-slate-600 text-lg leading-relaxed mt-6">
      Les bus SITA relient Sorrente aux hameaux de Massa Lubrense, Sant'Agata compris, et EAV exploite les lignes locales de la péninsule. Le 31, les passages s'espacent et les derniers partent tôt : vérifiez le retour avant de partir. Notre <a href="/fr-fr/guide/bus-sita/" class="text-med-blue hover:underline">guide des bus SITA</a> explique où trouver les horaires et acheter les billets. Depuis Positano ou Amalfi, en hiver, le bus est la seule option publique et il n'y a aucun moyen de rentrer tard dans la nuit.
    </p>
  </div>

  <!-- Combining -->
  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">Organiser le reste de la soirée autour</h2>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      Comme il a lieu avant la nuit noire, le ciuccio s'intègre facilement à un programme de Saint-Sylvestre sans lui faire concurrence. À Sorrente, lors des dernières éditions, la journée s'est déroulée ainsi :
    </p>
    <ul class="space-y-3 mb-6">
      <li class="flex items-start gap-3"><span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span><span class="text-slate-700"><strong>11 h 30, Teatro Tasso.</strong> Le concert de fin d'année de la Società dei Concerti di Sorrento ouvre la journée.</span></li>
      <li class="flex items-start gap-3"><span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span><span class="text-slate-700"><strong>De 17 h à 18 h, défilé et ciuccio.</strong> Le chant dans les rues, puis l'âne sur la Piazza Tasso.</span></li>
      <li class="flex items-start gap-3"><span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span><span class="text-slate-700"><strong>Dîner.</strong> Les restaurants ouverts le 31 proposent en général un menu fixe de Saint-Sylvestre ; réservez avant de partir.</span></li>
      <li class="flex items-start gap-3"><span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span><span class="text-slate-700"><strong>De 23 h à 3 h, Piazza Tasso.</strong> Musique live et DJ set, avec le compte à rebours sur la place.</span></li>
      <li class="flex items-start gap-3"><span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span><span class="text-slate-700"><strong>1 h, feux d'artifice.</strong> En 2024 et 2025, ils ont été tirés depuis une plateforme au large de Marina Piccola, une heure après minuit.</span></li>
    </ul>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      Si vous logez à Sant'Agata ou ailleurs à Massa Lubrense, le plus simple est de voir le ciuccio au village l'après-midi et de dîner sur la colline, puis de décider si vous descendez à Sorrente pour minuit, ce qui suppose une voiture, un taxi ou une longue marche au retour. Si vous préférez des feux à minuit sur une plage, le <a href="/fr-fr/blog/nouvel-an-positano-feux-artifice/" class="text-med-blue hover:underline">Nouvel An à Positano</a> est l'autre option sur cette portion de côte, mais c'est une autre soirée : il n'existe aucune façon pratique de faire Positano et Sorrente la même nuit.
    </p>
  </div>

  <!-- Local Tips -->
  <div class="bg-white p-8 rounded-[2rem] shadow-xl border border-slate-100">
    <div class="flex items-center gap-4 mb-6">
      <svg class="w-6 h-6 text-med-gold flex-shrink-0" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M9 18h6"/><path d="M10 22h4"/><path d="M15.09 14c.18-.98.65-1.74 1.41-2.5A4.65 4.61 0 0 0 18 8 6 6 0 0 0 6 8c0 1 .23 2.23 1.5 3.5A4.61 4.61 0 0 1 8.91 14"/></svg>
      <h3 class="text-xl font-bold">Les Conseils de l'Expert</h3>
    </div>
    <div class="space-y-6">
      <div>
        <p class="font-bold text-slate-900 mb-1">Arrivez une demi-heure avant</p>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Le spectacle est court et la foule arrive avec le défilé. Être sur la Piazza Tasso dès 17 h 30, ou sur la place de Sant'Agata avant la fin du chant, fait la différence entre voir l'âne et voir la nuque des autres.</p>
      </div>
      <div>
        <p class="font-bold text-slate-900 mb-1">Gardez vos distances</p>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Ce sont des feux d'artifice au milieu d'une place. Restez à quelques mètres de la figure, ne laissez pas les enfants courir vers elle et prévoyez une protection auditive pour les bébés.</p>
      </div>
      <div>
        <p class="font-bold text-slate-900 mb-1">Pas de verre sur la place</p>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Ces dernières années, Sorrente a interdit les boissons en verre dans le centre le soir de la Saint-Sylvestre, et les contrôles sont stricts. Prenez un gobelet en plastique ou trinquez au bar.</p>
      </div>
      <div>
        <p class="font-bold text-slate-900 mb-1">Vérifiez le programme la dernière semaine de décembre</p>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Les horaires indiqués ici viennent des dernières éditions. La commune de Sorrente et l'office de tourisme de Massa Lubrense ne publient les horaires définitifs qu'en décembre, et un après-midi de pluie peut tout décaler.</p>
      </div>
    </div>
  </div>

</BlogPostLayout>
