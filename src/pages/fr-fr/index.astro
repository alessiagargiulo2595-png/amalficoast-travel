---
import BaseLayout from '../../layouts/BaseLayout.astro';

const lang = 'fr-fr';

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "TouristDestination",
    "name": "Côte Amalfitaine",
    "alternateName": "Amalfi Coast",
    "description": "Patrimoine de l'UNESCO, 50 km de falaises sur la Méditerranée en Campanie, Italie.",
    "url": "https://amalficoast-travel.com/fr-fr/",
    "geo": { "@type": "GeoCoordinates", "latitude": "40.634", "longitude": "14.602" },
    "containedInPlace": { "@type": "Country", "name": "Italy" }
  }
];

const silos = [
  {
    title: 'Côte Amalfitaine',
    subtitle: '50 km de falaises UNESCO',
    href: '/fr-fr/cote-amalfitaine/',
    borghi: ['Positano', 'Amalfi', 'Ravello', 'Praiano', 'Maiori', 'Minori'],
    img: '/images/costiera-hero.webp',
  },
  {
    title: 'Péninsule Sorrentine',
    subtitle: 'La porte du Sud',
    href: '/fr-fr/peninsule-sorrentine/',
    borghi: ['Sorrente', 'Vico Equense', 'Massa Lubrense', "Sant'Agnello"],
    img: '/images/sorrento-hero.webp',
  },
  {
    title: 'Îles du Golfe',
    subtitle: 'Capri, Ischia, Procida',
    href: '/fr-fr/iles/',
    borghi: ['Capri', 'Ischia', 'Procida'],
    img: '/images/capri-hero.webp',
  },
];

const borghi = [
  {
    name: 'Positano',
    subtitle: 'Une carte postale vivante',
    description: 'Célèbre pour ses maisons de couleur pastel en cascade, ses boutiques de luxe et la spectaculaire Spiaggia Grande.',
    img: '/images/positano-hero.webp',
    href: '/fr-fr/cote-amalfitaine/positano/',
    tags: ['Iconique', 'Mode', 'Grande Plage'],
  },
  {
    name: 'Amalfi',
    subtitle: "L'ancienne République Maritime",
    description: 'Le cœur historique de la côte avec la majestueuse Cathédrale de Sant\'Andrea, les anciennes papeteries et la place principale.',
    img: '/images/amalfi-hero.webp',
    href: '/fr-fr/cote-amalfitaine/amalfi/',
    tags: ['Histoire', 'Cathédrale', 'Place'],
  },
  {
    name: 'Ravello',
    subtitle: 'La ville de la musique',
    description: 'Suspendue entre ciel et mer, elle offre les panoramas les plus spectaculaires depuis ses magnifiques villas historiques et jardins.',
    img: '/images/ravello-hero.webp',
    href: '/fr-fr/cote-amalfitaine/ravello/',
    tags: ['Musique', 'Villa Cimbrone', 'Panorama'],
  },
  {
    name: 'Maiori',
    subtitle: 'La plus longue plage',
    description: 'La promenade la plus longue de la Côte, authentique et tranquille, avec les restes d\'une villa romaine.',
    img: '/images/maiori-hero.webp',
    href: '/fr-fr/cote-amalfitaine/maiori/',
    tags: ['Plage', 'Détente', 'Authenticité'],
  },
  {
    name: 'Minori',
    subtitle: "L'âme gastronomique",
    description: 'Célèbre pour la liqueur de citron et la cuisine locale authentique, avec les restes de la Villa Romaine dominant la mer.',
    img: '/images/minori-hero.webp',
    href: '/fr-fr/cote-amalfitaine/minori/',
    tags: ['Gastronomie', 'Villa Romaine', 'Citrons'],
  },
  {
    name: 'Vietri sul Mare',
    subtitle: 'La capitale de la céramique',
    description: 'La porte orientale de la Côte, célèbre pour ses céramiques peintes à la main et l\'artisanat local.',
    img: '/images/vietri-hero.webp',
    href: '/fr-fr/cote-amalfitaine/vietri-sul-mare/',
    tags: ['Céramique', 'Artisanat', 'Musée'],
  },
];

const topBeaches = [
  { name: 'Spiaggia Grande', location: 'Positano', href: '/fr-fr/plages/cote-amalfitaine/spiaggia-grande-positano/' },
  { name: 'Spiaggia di Ieranto', location: 'Massa Lubrense', href: '/fr-fr/plages/peninsule-sorrentine/spiaggia-di-ieranto/' },
  { name: 'Marina Piccola', location: 'Capri', href: '/fr-fr/plages/iles/marina-piccola-capri/' },
  { name: 'Fiordo di Furore', location: 'Praiano', href: '/fr-fr/plages/cote-amalfitaine/fiordo-di-furore/' },
];

const reasonsToVisit = [
  {
    title: 'Panoramas Incomparables',
    description: 'Des falaises à pic sur la mer et des vues qui coupent le souffle à chaque courbe de la Route 163.'
  },
  {
    title: 'Une Histoire Millénaire',
    description: 'Des anciennes Républiques Maritimes aux fastes des villas nobles et des monastères médiévaux.'
  },
  {
    title: 'Saveurs Authentiques',
    description: 'Des pâtes fraîches aux citrons non traités, un voyage dans le goût méditerranéen le plus authentique.'
  },
  {
    title: 'Expériences Uniques',
    description: 'Sentiers de montagne, excursions en bateau à travers les grottes et traditions artisanales séculaires.'
  }
];

const experiences = [
  {
    title: 'Cours de Cuisine',
    href: '/fr-fr/experiences/cours-de-cuisine/',
    img: '/images/cooking-class-hero.webp',
  },
  {
    title: 'Visite Limoncello',
    href: '/fr-fr/experiences/tour-limoncello/',
    img: '/images/limoncello-mercato-hero.webp',
  },
  {
    title: 'Expérience Mozzarella',
    href: '/fr-fr/experiences/experience-mozzarella/',
    img: '/images/mozzarella-provolone-hero.webp',
  },
  {
    title: 'Restaurants Étoilés',
    href: '/fr-fr/experiences/restaurants-etoiles/',
    img: '/images/stellati-hero.webp',
  }
];

const blogHighlights = [
  {
    title: 'Grotta dello Smeraldo: Guide de la Perle de Conca dei Marini',
    category: 'De la Rédaction',
    href: '/fr-fr/blog/',
    img: '/images/grotta-smeraldo-hero.webp',
  },
  {
    title: 'Sentiers moins fréquentés: Vallée des Ferrières',
    category: 'Trekking',
    href: '/fr-fr/blog/',
    img: '/images/valle-ferriere-hero.webp',
  },
  {
    title: 'Cetara et la colatura: l\'or des abysses',
    category: 'Gastronomie',
    href: '/fr-fr/blog/',
    img: '/images/maiori-hero.webp',
  },
  {
    title: 'Vins de la Côte Amalfitaine',
    category: 'Gastronomie',
    href: '/fr-fr/blog/',
    img: '/images/vini-costa-amalfi-hero.webp',
  }
];
---

<BaseLayout
  title="Guide de la Côte Amalfitaine 2026 - Positano, Amalfi, Ravello"
  description="Guide touristique complet de la Côte Amalfitaine. Villages, plages, ferries, itinéraires et conseils pratiques actualisés. Patrimoine UNESCO en Campanie, Italie."
  lang={lang}
  schema={schema}
  pageKey="home"
>

  <!-- HERO -->
  <section class="relative h-[90svh] sm:min-h-[90vh] md:h-screen flex flex-col items-center justify-center bg-charcoal overflow-hidden">
    <img src="/images/hero-hp.webp" alt="Côte Amalfitaine vue d'en haut" referrerpolicy="no-referrer" class="absolute inset-0 w-full h-full object-cover object-center" loading="eager" fetchpriority="high" decoding="sync" />
    <div class="absolute inset-0 bg-gradient-to-b from-black/60 sm:from-black/55 via-black/40 sm:via-black/30 to-black/70 sm:to-black/65"></div>

    <div class="relative text-center px-6 max-w-4xl mx-auto md:flex md:flex-col md:justify-center">
      <p class="text-med-gold text-xs font-medium uppercase tracking-[0.3em] mb-6 mt-6">Patrimoine de l'UNESCO · Campanie, Italie</p>
      <h1 class="font-serif text-white leading-tight mb-6" style="font-size: clamp(2.8rem, 7vw, 5.5rem); letter-spacing: -0.02em;">
        La Côte<br/>
        <em class="not-italic text-med-gold">Amalfitaine</em>
      </h1>
      <p class="text-blue-100 text-lg md:text-xl leading-relaxed max-w-2xl mx-auto mb-[4vh] md:mb-0 font-light">
        Cinquante kilomètres de falaises à pic sur la Méditerranée. Des villages perchés, des citrons géants,
        des ferries colorés et une Italie qui ne cesse de surprendre.
      </p>
      <div class="flex flex-row gap-3 justify-center md:mt-6">
        <a href="/fr-fr/cote-amalfitaine/positano/"
           class="inline-block bg-med-blue text-white font-semibold px-8 py-3.5 rounded-full hover:scale-105 hover:shadow-[0_8px_30px_rgba(0,91,150,0.5)] transition-all duration-300 text-xs sm:text-sm">
          Commencez par Positano
        </a>
        <a href="/fr-fr/itineraires/"
           class="inline-block border-2 border-white/50 text-white font-medium px-8 py-3.5 rounded-full hover:bg-white/10 hover:border-white transition-all duration-300 text-xs sm:text-sm">
          Choisissez votre itinéraire
        </a>
      </div>
    </div>

    <!-- Scroll indicator -->
    <div class="absolute bottom-[2vh] md:bottom-[4vh] left-1/2 -translate-x-1/2 flex flex-col items-center gap-2 text-white/40 z-20">
      <svg class="w-4 h-4 animate-bounce" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
      </svg>
    </div>
  </section>

  <!-- 3 SILOS - TERRITORIES SECTION -->
  <section class="py-16 bg-white">
    <div class="max-w-7xl mx-auto px-6">
      <div class="text-center mb-12">
        <h2 class="font-serif text-4xl md:text-5xl font-bold text-slate-900 mb-4">Trois territoires, histoires infinies</h2>
        <div class="w-20 h-1 bg-med-gold mx-auto rounded-full"></div>
      </div>

      <!-- MOBILE: Swiper slider -->
      <div class="swiper swiper-silos md:hidden">
        <div class="swiper-wrapper pb-12">
          {silos.map(silo => (
            <div class="swiper-slide">
              <a href={silo.href} class="group relative aspect-[16/9] md:aspect-[4/5] overflow-hidden rounded-[3rem] shadow-none md:shadow-[0_20px_50px_rgba(0,0,0,0.3)] block hover:scale-[1.02] transition-transform duration-500">
                <img
                  src={silo.img}
                  alt={silo.title}
                  referrerpolicy="no-referrer"
                  class="w-full h-full object-cover transition-transform duration-1000 group-hover:scale-110"
                  loading="lazy"
                  decoding="async"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/20 to-transparent" />
                <div class="absolute bottom-8 left-8 right-8">
                  <span class="text-med-gold text-xs font-bold uppercase tracking-[0.3em] mb-2 block">{silo.subtitle}</span>
                  <h3 class="font-serif text-3xl font-bold text-white tracking-tight mb-3">{silo.title}</h3>
                  <div class="flex flex-wrap gap-2">
                    {silo.borghi.slice(0, 3).map(b => (
                      <span class="text-[10px] text-white/70 bg-white/10 px-2 py-0.5 rounded-full">{b}</span>
                    ))}
                  </div>
                </div>
              </a>
            </div>
          ))}
        </div>
        <div class="swiper-pagination"></div>
      </div>

      <!-- DESKTOP: Grid -->
      <div class="hidden md:grid grid-cols-1 md:grid-cols-3 gap-6">
        {silos.map(silo => (
          <a href={silo.href} class="group relative aspect-[4/5] overflow-hidden rounded-[3rem] shadow-none md:shadow-[0_20px_50px_rgba(0,0,0,0.3)] block hover:scale-[1.02] transition-transform duration-500">
            <img
              src={silo.img}
              alt={silo.title}
              referrerpolicy="no-referrer"
              class="w-full h-full object-cover transition-transform duration-1000 group-hover:scale-110"
              loading="lazy"
              decoding="async"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/20 to-transparent" />
            <div class="absolute bottom-8 left-8 right-8">
              <span class="text-med-gold text-xs font-bold uppercase tracking-[0.3em] mb-2 block">{silo.subtitle}</span>
              <h3 class="font-serif text-3xl font-bold text-white tracking-tight mb-3">{silo.title}</h3>
              <div class="flex flex-wrap gap-2">
                {silo.borghi.slice(0, 3).map(b => (
                  <span class="text-[10px] text-white/70 bg-white/10 px-2 py-0.5 rounded-full">{b}</span>
                ))}
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- CURIOSITÉS - Did You Know -->
  <section class="bg-charcoal py-12">
    <div class="max-w-7xl mx-auto px-6">
      <p class="text-med-gold text-xs uppercase tracking-[0.3em] font-medium text-center mb-8">Curiosités</p>

      <!-- MOBILE: Swiper slider -->
      <div class="swiper swiper-curiosita md:hidden">
        <div class="swiper-wrapper pb-12">
          <div class="swiper-slide">
            <div class="group bg-white/5 p-8 rounded-[2rem] border border-white/10 hover:bg-white/10 transition-all duration-300 h-full flex flex-col">
              <div class="w-14 h-14 rounded-2xl bg-med-gold/10 text-med-gold flex items-center justify-center mb-6 group-hover:scale-110 transition-transform flex-shrink-0">
                <svg class="w-7 h-7" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 6.75V15m6-6v8.25m.503-10.498 4.875 2.812M6.497 9.252 1.622 12.064m19.88 0-4.875 2.812M1.622 12.064l4.875 2.812m0 0 4.498 2.598a.75.75 0 0 0 .75 0l4.498-2.598m-9.746 0V17.25"/></svg>
              </div>
              <div class="font-serif text-5xl font-bold text-white mb-3 tracking-tight">50 km</div>
              <p class="text-white/70 font-medium mb-2">de littoral</p>
              <p class="text-white/50 text-xs sm:text-sm leading-relaxed font-light">De Positano à Vietri sul Mare, inscrit au patrimoine mondial de l'UNESCO en 1997.</p>
            </div>
          </div>
          <div class="swiper-slide">
            <div class="group bg-white/5 p-8 rounded-[2rem] border border-white/10 hover:bg-white/10 transition-all duration-300 h-full flex flex-col">
              <div class="w-14 h-14 rounded-2xl bg-med-gold/10 text-med-gold flex items-center justify-center mb-6 group-hover:scale-110 transition-transform flex-shrink-0">
                <svg class="w-7 h-7" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 21a9.004 9.004 0 0 0 8.716-6.747M12 21a9.004 9.004 0 0 1-8.716-6.747M12 21c2.485 0 4.5-4.03 4.5-9S14.485 3 12 3m0 18c-2.485 0-4.5-4.03-4.5-9S9.515 3 12 3m0 0a8.997 8.997 0 0 1 7.843 4.582M12 3a8.997 8.997 0 0 0-7.843 4.582m15.686 0A11.953 11.953 0 0 1 12 10.5c-2.998 0-5.74-1.1-7.843-2.918m15.686 0A8.959 8.959 0 0 1 21 12c0 .778-.099 1.533-.284 2.253"/></svg>
              </div>
              <div class="font-serif text-5xl font-bold text-white mb-3 tracking-tight">IXe s.</div>
              <p class="text-white/70 font-medium mb-2">naissance d'Amalfi</p>
              <p class="text-white/50 text-xs sm:text-sm leading-relaxed font-light">Première puissance maritime d'Europe, avec des routes commerciales jusqu'à Constantinople.</p>
            </div>
          </div>
          <div class="swiper-slide">
            <div class="group bg-white/5 p-8 rounded-[2rem] border border-white/10 hover:bg-white/10 transition-all duration-300 h-full flex flex-col">
              <div class="w-14 h-14 rounded-2xl bg-med-gold/10 text-med-gold flex items-center justify-center mb-6 group-hover:scale-110 transition-transform flex-shrink-0">
                <svg class="w-7 h-7" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z"/><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1 1 15 0Z"/></svg>
              </div>
              <div class="font-serif text-5xl font-bold text-white mb-3 tracking-tight">350 m</div>
              <p class="text-white/70 font-medium mb-2">l'altitude de Ravello</p>
              <p class="text-white/50 text-xs sm:text-sm leading-relaxed font-light">Wagner y écrivit Parsifal. Gore Vidal vécut à Ravello pendant trente ans.</p>
            </div>
          </div>
        </div>
        <div class="swiper-pagination"></div>
      </div>

      <!-- DESKTOP: Griglia curiosità -->
      <div class="hidden md:grid grid-cols-1 grid-cols-1 md:grid-cols-3 gap-8">
        <div class="group bg-white/5 p-8 rounded-[2rem] border border-white/10 hover:bg-white/10 transition-all duration-300">
          <div class="w-14 h-14 rounded-2xl bg-med-gold/10 text-med-gold flex items-center justify-center mb-6 group-hover:scale-110 transition-transform">
            <svg class="w-7 h-7" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 6.75V15m6-6v8.25m.503-10.498 4.875 2.812M6.497 9.252 1.622 12.064m19.88 0-4.875 2.812M1.622 12.064l4.875 2.812m0 0 4.498 2.598a.75.75 0 0 0 .75 0l4.498-2.598m-9.746 0V17.25"/></svg>
          </div>
          <div class="font-serif text-5xl font-bold text-white mb-3 tracking-tight">50 km</div>
          <p class="text-white/70 font-medium mb-2">de littoral</p>
          <p class="text-white/50 text-xs sm:text-sm leading-relaxed font-light">De Positano à Vietri sul Mare, inscrit au patrimoine mondial de l'UNESCO en 1997.</p>
        </div>
        <div class="group bg-white/5 p-8 rounded-[2rem] border border-white/10 hover:bg-white/10 transition-all duration-300">
          <div class="w-14 h-14 rounded-2xl bg-med-gold/10 text-med-gold flex items-center justify-center mb-6 group-hover:scale-110 transition-transform">
            <svg class="w-7 h-7" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 21a9.004 9.004 0 0 0 8.716-6.747M12 21a9.004 9.004 0 0 1-8.716-6.747M12 21c2.485 0 4.5-4.03 4.5-9S14.485 3 12 3m0 18c-2.485 0-4.5-4.03-4.5-9S9.515 3 12 3m0 0a8.997 8.997 0 0 1 7.843 4.582M12 3a8.997 8.997 0 0 0-7.843 4.582m15.686 0A11.953 11.953 0 0 1 12 10.5c-2.998 0-5.74-1.1-7.843-2.918m15.686 0A8.959 8.959 0 0 1 21 12c0 .778-.099 1.533-.284 2.253"/></svg>
          </div>
          <div class="font-serif text-5xl font-bold text-white mb-3 tracking-tight">IXe s.</div>
          <p class="text-white/70 font-medium mb-2">naissance d'Amalfi</p>
          <p class="text-white/50 text-xs sm:text-sm leading-relaxed font-light">Première puissance maritime d'Europe, avec des routes commerciales jusqu'à Constantinople.</p>
        </div>
        <div class="group bg-white/5 p-8 rounded-[2rem] border border-white/10 hover:bg-white/10 transition-all duration-300">
          <div class="w-14 h-14 rounded-2xl bg-med-gold/10 text-med-gold flex items-center justify-center mb-6 group-hover:scale-110 transition-transform">
            <svg class="w-7 h-7" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z"/><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1 1 15 0Z"/></svg>
          </div>
          <div class="font-serif text-5xl font-bold text-white mb-3 tracking-tight">350 m</div>
          <p class="text-white/70 font-medium mb-2">l'altitude de Ravello</p>
          <p class="text-white/50 text-xs sm:text-sm leading-relaxed font-light">Wagner y écrivit Parsifal. Gore Vidal vécut à Ravello pendant trente ans.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- POURQUOI VISITER -->
  <section class="py-16 bg-white">
    <div class="max-w-7xl mx-auto px-6">
      <div class="text-center mb-12">
        <h2 class="font-serif text-4xl md:text-5xl font-bold text-slate-900 mb-6">Pourquoi Visiter la Côte</h2>
        <div class="w-20 h-1 bg-med-gold mx-auto rounded-full"></div>
      </div>
      <div class="grid grid-cols-2 md:grid-cols-2 lg:grid-cols-4 gap-8">
        {reasonsToVisit.map((reason, i) => (
          <div class="text-center border-2 border-med-gold rounded-2xl p-5 sm:p-8" style={`animation: fadeIn 0.8s ease-in-out ${i * 0.1}s both`}>
            <h3 class="text-base sm:text-xl font-serif font-bold text-slate-900 mb-3 sm:mb-4">{reason.title}</h3>
            <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">{reason.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- BORGHI INCANTATI -->
  <section id="borghi" class="py-16 bg-med-cream">
    <div class="max-w-7xl mx-auto px-6">

      <div class="flex flex-col md:flex-row justify-between items-end mb-12 gap-6">
        <div class="max-w-2xl">
          <p class="text-med-gold text-xs font-bold uppercase tracking-[0.3em] mb-3">Explorer la Côte</p>
          <h2 class="font-serif text-4xl md:text-5xl font-bold text-slate-900 tracking-tight mb-4">Les Villages Enchantés</h2>
          <div class="w-20 h-1 bg-med-gold rounded-full mb-4"></div>
          <p class="text-slate-500 text-lg font-light">Découvrez les perles de la côte, chacune avec son âme et ses traditions séculaires.</p>
        </div>
        <a href="/fr-fr/cote-amalfitaine/" class="group flex items-center gap-2 text-med-blue font-semibold hover:text-med-gold transition-colors flex-shrink-0">
          Toutes les destinations
          <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
        </a>
      </div>

      <!-- MOBILE: Swiper slider -->
      <div class="swiper swiper-borghi md:hidden">
        <div class="swiper-wrapper pb-12">
          {borghi.map((b) => (
            <div class="swiper-slide">
