---
import BaseLayout from '../../../layouts/BaseLayout.astro';

const lang = 'fr-fr';

const breadcrumbs = [
  { name: 'Home', url: '/fr-fr/' },
  { name: 'Îles du Golfe', url: '/fr-fr/iles/' },
];

const isole = [
  {
    name: 'Capri',
    href: '/fr-fr/iles/capri/',
    desc: 'La Grotte Bleue, les Faraglioni et la mondaine Piazzetta : l\'île la plus iconique du Golfe de Naples.',
    tag: 'La plus iconique',
  },
  {
    name: 'Anacapri',
    href: '/fr-fr/iles/anacapri/',
    desc: 'Le village haut de Capri : Villa San Michele, le télésiège vers le Monte Solaro (589 m) et l\'Escalier Phénicien.',
    tag: 'Nature & panoramas',
  },
  {
    name: 'Ischia',
    href: '/fr-fr/iles/ischia/',
    desc: 'L\'île verte du Golfe : thermes naturels, le Château Aragonais, plages volcaniques et le Monte Epomeo.',
    tag: 'Thermes & nature',
  },
  {
    name: 'Forio',
    href: '/fr-fr/iles/forio/',
    desc: 'Les Jardins Poséidon, l\'église du Soccorso au coucher de soleil et les thermes naturels de la baie de Sorgeto.',
    tag: 'Couchers de soleil & thermes',
  },
  {
    name: 'Procida',
    href: '/fr-fr/iles/procida/',
    desc: 'La plus petite et la plus authentique : maisons colorées à Marina Corricella, Capitale italienne de la Culture 2022.',
    tag: 'La plus authentique',
  },
];

const destinationSchema = {
  "@context": "https://schema.org",
  "@type": "TouristDestination",
  "name": "Îles du Golfe de Naples",
  "description": "Capri, Anacapri, Ischia, Forio et Procida : les îles du Golfe de Naples, accessibles en ferry depuis Naples, Pozzuoli et Sorrente.",
  "url": "https://amalficoast-travel.com/fr-fr/iles/",
  "touristType": ["Mer", "Culture", "Thermes", "Nature"],
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": 40.5500,
    "longitude": 14.1000
  }
};
---

<BaseLayout
  title="Îles du Golfe de Naples 2026 : Capri, Anacapri, Ischia, Forio et Procida"
  description="Guide des îles du Golfe de Naples : Capri, Anacapri, Ischia, Forio et Procida. Comment y aller, que voir, quand partir. Tout pour planifier votre excursion en ferry."
  lang={lang}
  breadcrumbs={breadcrumbs}
  schema={[destinationSchema]}
  pageKey="islands"

  heroImage="/images/isole-hero.jpg"
>

  <!-- Hero -->
  <section class="relative h-[75vh] sm:h-[90vh] flex items-center bg-charcoal overflow-hidden">
    <img src="/images/isole-hero.jpg" alt="Îles du Golfe de Naples" class="absolute inset-0 w-full h-full object-cover" loading="eager" fetchpriority="high" decoding="sync" referrerpolicy="no-referrer"/>

    <div class="absolute inset-0 bg-gradient-to-b from-black/25 via-black/40 to-black/75"></div>
    <div class="relative z-10 max-w-7xl mx-auto px-6 py-24">
      <nav class="flex items-center gap-2 text-white/60 text-xs mb-6">
        <a href="/fr-fr/" class="hover:text-white transition-colors">Home</a>
        <span>/</span>
        <span class="text-white">Îles du Golfe</span>
      </nav>
      <div class="max-w-3xl">
        <p class="text-med-gold text-xs sm:text-sm font-medium uppercase tracking-[0.3em] mb-3">Golfe de Naples</p>
        <h1 class="font-serif text-display text-white mb-4">Les Îles du Golfe</h1>
        <p class="text-xl text-white/80 leading-relaxed">
          Trois îles distinctes : Capri (glamour, Grotte Bleue), Ischia (thermes volcaniques, Château), Procida (authentique, sans foule). Toutes accessibles en ferry &lt;1 heure depuis Naples.
        </p>
      </div>
    </div>
  </section>

  <div class="max-w-editorial mx-auto px-4 sm:px-6 lg:px-8 py-16 space-y-20">

    <!-- Intro -->
    <section class="text-justify">
      <p class="text-xl leading-relaxed text-charcoal">
        Le Golfe de Naples est l'un des plus beaux de la Méditerranée, et ses îles sont sa couronne. Chacune a une identité forte et inimitable : difficile de les visiter toutes en un seul voyage, mais impossible d'en choisir une seule.
      </p>
      <p class="mt-4 text-slate-600 leading-relaxed">
        Capri, Ischia et Procida sont toutes accessibles depuis Naples Molo Beverello ou Pozzuoli grâce aux ferries et hydroglisseurs fréquents. En été les liaisons se multiplient. Depuis Sorrente, Capri est atteignable en 20-25 minutes d'hydroglisseur.
      </p>
    </section>

    <!-- Isole Grid -->
    <section>
      <div class="flex items-end justify-between mb-8">
        <h2 class="font-serif text-3xl font-semibold">Les îles du Golfe</h2>
        <p class="text-xs sm:text-sm text-slate-400 hidden sm:block">Golfe de Naples, Campanie</p>
      </div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {isole.map((b, i) => {
          const stripeColors = ['#D4AF37', '#E2725B', '#005B96', '#40E0D0'];
          const stripeColor = stripeColors[i % stripeColors.length];
          return (
            <a href={b.href} class="group relative overflow-hidden bg-white border border-slate-100 rounded-[2rem] p-6 pl-7 shadow-sm hover:border-med-blue/30 hover:shadow-xl transition-all duration-300">
              <span class="absolute left-0 top-0 bottom-0 w-1.5" style={`background-color: ${stripeColor}`}></span>
              <div class="flex items-start justify-between mb-3">
                <h3 class="font-serif text-xl font-semibold text-slate-900 group-hover:text-med-blue transition-colors">{b.name}</h3>
                <span class="text-[10px] uppercase tracking-wide px-2 py-1 rounded-full font-semibold flex-shrink-0 ml-2 text-white" style={`background-color: ${stripeColor}`}>{b.tag}</span>
              </div>
              <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">{b.desc}</p>
              <p class="text-med-blue text-xs sm:text-sm font-medium mt-4 group-hover:translate-x-1 transition-transform inline-flex items-center gap-1">
                Découvrir {b.name}
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 18l6-6-6-6"/></svg>
              </p>
            </a>
          );
        })}
      </div>
    </section>

    <!-- Stats -->
    <section class="bg-charcoal text-white rounded-[2rem] p-10">
      <p class="text-[10px] uppercase tracking-[0.3em] text-med-gold font-medium mb-8">Les îles en chiffres</p>
      <div class="grid sm:grid-cols-4 gap-8 text-center">
        <div>
          <p class="font-serif text-5xl font-bold text-med-gold">3</p>
          <p class="text-white/60 text-xs sm:text-sm mt-2">îles dans le Golfe de Naples</p>
        </div>
        <div>
          <p class="font-serif text-5xl font-bold text-med-gold">25 min</p>
          <p class="text-white/60 text-xs sm:text-sm mt-2">Sorrente → Capri en hydroglisseur</p>
        </div>
        <div>
          <p class="font-serif text-5xl font-bold text-med-gold">789 m</p>
          <p class="text-white/60 text-xs sm:text-sm mt-2">Monte Epomeo, Ischia</p>
        </div>
        <div>
          <p class="font-serif text-5xl font-bold text-med-gold">2022</p>
          <p class="text-white/60 text-xs sm:text-sm mt-2">Procida Capitale de la Culture</p>
        </div>
      </div>
    </section>

    <!-- Come arrivare riepilogo -->
    <section>
      <h2 class="font-serif text-3xl font-semibold text-slate-900 mb-8">Comment rejoindre les îles</h2>
      <div class="overflow-x-auto rounded-2xl border border-slate-200">
        <table class="w-full text-xs sm:text-xs sm:text-sm">
          <thead>
            <tr class="bg-slate-900 text-white">
              <th class="text-left px-4 py-3 font-semibold">Île</th>
              <th class="text-left px-4 py-3 font-semibold">Depuis Naples (Beverello)</th>
              <th class="text-left px-4 py-3 font-semibold">Depuis Sorrente</th>
              <th class="text-left px-4 py-3 font-semibold">Depuis Pozzuoli</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100">
            <tr class="hover:bg-slate-50 transition-colors">
              <td class="px-4 py-3 font-semibold text-charcoal">Capri</td>
              <td class="px-4 py-3">~50 min (ferry) / ~40 min (hydroglisseur)</td>
              <td class="px-4 py-3">~20-25 min (hydroglisseur)</td>
              <td class="px-4 py-3 text-slate-400">-</td>
            </tr>
            <tr class="hover:bg-slate-50 transition-colors">
              <td class="px-4 py-3 font-semibold text-charcoal">Ischia</td>
              <td class="px-4 py-3">~75 min (ferry) / ~50 min (hydroglisseur)</td>
              <td class="px-4 py-3 text-slate-400">-</td>
              <td class="px-4 py-3">~35 min (ferry)</td>
            </tr>
            <tr class="hover:bg-slate-50 transition-colors">
              <td class="px-4 py-3 font-semibold text-charcoal">Procida</td>
              <td class="px-4 py-3">~35 min (hydroglisseur)</td>
              <td class="px-4 py-3 text-slate-400">-</td>
              <td class="px-4 py-3">~15 min (ferry)</td>
            </tr>
          </tbody>
        </table>
      </div>
      <p class="text-xs text-slate-400 mt-2">* Temps indicatifs. Consultez caremar.it, snav.it, medmar.it pour les horaires à jour.</p>
    </section>

  </div>

</BaseLayout>
