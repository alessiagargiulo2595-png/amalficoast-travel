const lineNames = {"ML2":"Sorrente → Massa Lubrense → Sant'Agata","ML1":"Sant'Agata → Massa Lubrense → Sorrente","NV2":"Sorrente → Priora → Sant'Agata (via Nastro Verde)","NV1":"Sant'Agata → Priora → Sorrente (via Nastro Verde)"};
