---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../../components/Breadcrumbs.astro';

const lang = 'fr-fr';

const breadcrumbs = [
  { name: 'Accueil', url: '/fr-fr/' },
  { name: 'Guide pratique', url: '/fr-fr/' },
  { name: 'Bus SITA', url: '/fr-fr/guide/bus-sita/' },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Comment fonctionne le bus SITA sur la Côte Amalfitaine ?",
      "acceptedAnswer": { "@type": "Answer", "text": "Le bus SITA (aujourd'hui SITA Sud, exploité par EAV) parcourt la SS163 entre Sorrente et Salerne, avec des arrêts à Positano, Praiano, Amalfi, Maiori et Minori. Les billets doivent être achetés avant de monter dans un bureau de tabac ou kiosque - ils ne sont pas vendus dans le bus. Prix : environ €2,50-4 par trajet ; les tarifs ont été ajustés au 1er octobre 2026, vérifiez le prix en vigueur à l'achat." }
    },
    {
      "@type": "Question",
      "name": "Combien de temps dure le trajet de Sorrente à Amalfi ?",
      "acceptedAnswer": { "@type": "Answer", "text": "L'horaire officiel en vigueur depuis le 14 septembre 2026 prévoit de 75 à 100 minutes selon l'itinéraire. En été (juillet-août), le trafic sur la SS163 peut porter le trajet à 2-2,5 heures. D'Amalfi à Positano, comptez 40 minutes jusqu'à l'arrêt Sponda et 50 jusqu'à Chiesa Nuova." }
    },
    {
      "@type": "Question",
      "name": "Puis-je emporter de gros bagages dans le bus SITA ?",
      "acceptedAnswer": { "@type": "Answer", "text": "Les bus SITA sur la SS163 sont petits. En été ils sont bondés. Les grandes valises sont difficiles à gérer : utilisez un sac compact ou un sac à dos." }
    },
    {
      "@type": "Question",
      "name": "À quelle heure partent le premier et le dernier bus SITA entre Sorrente et Amalfi ?",
      "acceptedAnswer": { "@type": "Answer", "text": "Selon l'horaire en vigueur depuis le 14 septembre 2026, le premier bus de Sorrente vers Amalfi part à 06:30 du lundi au samedi (08:30 le dimanche et les jours fériés) et le dernier à 19:50 (19:15 le dimanche et les jours fériés). D'Amalfi vers Sorrente, le premier part à 06:20 tous les jours et le dernier à 21:30 (21:00 le dimanche et les jours fériés). Vérifiez sur sitasudtrasporti.it avant de partir, surtout les jours fériés." }
    }
  ]
};

