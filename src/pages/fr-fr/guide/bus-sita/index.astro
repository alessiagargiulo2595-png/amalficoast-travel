                <th class="text-left px-2 py-2 sm:px-3 sm:py-3 font-semibold whitespace-nowrap">Nerano Cantone</th>
                <th class="text-left px-2 py-2 sm:px-3 sm:py-3 font-semibold whitespace-nowrap">Itinéraire</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
              {neranoOut.map(([day, dep, arr, r]) => (
