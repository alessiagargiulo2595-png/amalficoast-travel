                  <td class="px-2 py-1.5 sm:px-3 sm:py-2 whitespace-nowrap text-slate-600">{dayLabels[day]}</td>
                  <td class="px-2 py-1.5 sm:px-3 sm:py-2 font-mono">{dep}</td>
                  <td class="px-2 py-1.5 sm:px-3 sm:py-2 font-mono">{arr}</td>
                  <td class="px-2 py-1.5 sm:px-3 sm:py-2 whitespace-nowrap text-slate-500">{neranoRoutes[r]}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <div class="overflow-x-auto rounded-2xl border border-slate-200">
          <table class="w-full text-xs sm:text-sm">
            <caption class="text-left text-xs text-white px-2 py-2 sm:px-4 sm:py-2 bg-slate-900 rounded-t-2xl border-b border-med-gold font-medium">Nerano (Marina del Cantone) → Sorrente</caption>
