---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../../components/Breadcrumbs.astro';
import { getTranslations, getLocalePath } from '../../../../i18n/translations';

const lang = 'fr-fr';
const t = getTranslations(lang);

const breadcrumbs = [
  { name: 'Home', url: '/fr-fr/' },
  { name: 'Planification', url: '/fr-fr/planification/' },
  { name: 'Comment venir', url: '/fr-fr/guide/comment-venir/' },
];
---

<BaseLayout
  title={t.meta.getting_here_title}
  description={t.meta.getting_here_description}
  lang={lang}
  breadcrumbs={breadcrumbs}
 pageKey="comment-venir">
  <!-- Hero -->
  <section class="relative h-[75vh] sm:h-[90vh] flex items-center bg-charcoal overflow-hidden">
    <img src="/images/come-arrivare-hero.jpg" alt="Port de Sorrente, Côte Amalfitaine" class="absolute inset-0 w-full h-full object-cover" loading="eager" referrerpolicy="no-referrer"/>
    <div class="absolute inset-0 bg-gradient-to-b from-black/25 via-black/40 to-black/75"></div>
    <div class="relative z-10 max-w-7xl mx-auto px-6 text-center">
      <p class="text-med-gold text-xs sm:text-sm uppercase tracking-[0.3em] mb-3 font-medium">Guide pratique</p>
      <h1 class="font-serif text-4xl md:text-5xl font-bold text-white mb-4 tracking-tight">Comment se rendre sur la Côte Amalfitaine</h1>
      <p class="text-white/80 text-lg max-w-2xl mx-auto font-light">Train, avion, ferry ou voiture : toutes les options pour rejoindre la côte depuis l'Italie et l'étranger.</p>
    </div>
    <Breadcrumbs breadcrumbs={breadcrumbs} />
  </section>

  <section class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <p class="text-base sm:text-lg text-slate-600 leading-relaxed">
      La Côte Amalfitaine ne possède ni aéroport ni gare ferroviaire sur son tronçon principal. La façon la plus commode d'y accéder est de passer par Naples (aéroport international et gare à grande vitesse) ou par Salerne (accessible en train depuis toute l'Italie). De là, il existe des ferries, des bus et des transferts privés.
    </p>
  </section>

  <!-- Notre conseil -->
  <section class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 pb-12">
    <div class="bg-slate-900 rounded-[2rem] p-6 sm:p-8">
      <div class="flex items-start gap-4">
        <div class="w-10 h-10 rounded-xl bg-med-gold/15 flex items-center justify-center flex-shrink-0 mt-1">
          <svg class="w-5 h-5 text-med-gold" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 18v-5.25m0 0a6.01 6.01 0 0 0 1.5-.189m-1.5.189a6.01 6.01 0 0 1-1.5-.189m3.75 7.478a12.06 12.06 0 0 1-4.5 0m3.75 2.383a14.406 14.406 0 0 1-3 0M14.25 18v-.192c0-.983.658-1.823 1.508-2.316a7.5 7.5 0 1 0-7.517 0c.85.493 1.509 1.333 1.509 2.316V18"/></svg>
        </div>
        <div>
          <p class="text-med-gold text-xs font-bold uppercase tracking-wider mb-2">Notre conseil</p>
          <p class="text-white/80 text-sm sm:text-base leading-relaxed"><strong class="text-white">Haute saison (mai-oct) :</strong> volez sur Naples, prenez le ferry direct pour Positano ou Amalfi. Zéro trafic, vues à couper le souffle.</p>
          <p class="text-white/80 text-sm sm:text-base leading-relaxed mt-2"><strong class="text-white">Basse saison (nov-avr) :</strong> train à grande vitesse jusqu'à Salerne + bus SITA. Plus économique et les ferries ne circulent pas.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Comparaison des moyens -->
  <section class="bg-slate-900 py-16">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-[10px] uppercase tracking-[0.3em] text-med-gold font-medium mb-3">Comparaison rapide</p>
      <h2 class="text-2xl font-bold font-serif text-white mb-10">Quel transport choisir ?</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-4">

        <div class="bg-white/5 border border-med-gold/30 rounded-2xl p-5 relative">
          <span class="absolute -top-3 left-4 bg-med-gold text-white text-[10px] font-bold uppercase tracking-wider px-3 py-1 rounded-full">Recommandé</span>
          <div class="mt-2">
            <p class="text-white font-bold text-lg mb-1">Ferry</p>
            <p class="text-white/40 text-xs mb-4">Avr - Oct</p>
            <div class="space-y-2 text-xs text-white/60">
              <p><span class="text-white/80 font-medium">Coût :</span> 15 € - 25 €</p>
              <p><span class="text-white/80 font-medium">Temps :</span> 1h - 1h30</p>
              <p><span class="text-white/80 font-medium">Confort :</span> <span class="text-med-gold">Élevé</span></p>
              <p><span class="text-white/80 font-medium">Circulation :</span> Zéro</p>
            </div>
          </div>
        </div>

        <div class="bg-white/5 border border-white/10 rounded-2xl p-5">
          <p class="text-white font-bold text-lg mb-1">Train + Bus</p>
          <p class="text-white/40 text-xs mb-4">Toute l'année</p>
          <div class="space-y-2 text-xs text-white/60">
            <p><span class="text-white/80 font-medium">Coût :</span> 6 € - 10 €</p>
            <p><span class="text-white/80 font-medium">Temps :</span> 2h30 - 3h</p>
            <p><span class="text-white/80 font-medium">Confort :</span> Moyen</p>
            <p><span class="text-white/80 font-medium">Circulation :</span> Possible en bus</p>
          </div>
        </div>

        <div class="bg-white/5 border border-white/10 rounded-2xl p-5">
          <p class="text-white font-bold text-lg mb-1">Transfert privé</p>
          <p class="text-white/40 text-xs mb-4">Toute l'année</p>
          <div class="space-y-2 text-xs text-white/60">
            <p><span class="text-white/80 font-medium">Coût :</span> 90 € - 150 €</p>
            <p><span class="text-white/80 font-medium">Temps :</span> 1h - 1h30</p>
            <p><span class="text-white/80 font-medium">Confort :</span> <span class="text-med-gold">Élevé</span></p>
            <p><span class="text-white/80 font-medium">Circulation :</span> Possible</p>
          </div>
        </div>

        <div class="bg-white/5 border border-white/10 rounded-2xl p-5">
          <p class="text-white font-bold text-lg mb-1">Voiture personnelle</p>
          <p class="text-white/40 text-xs mb-4">Basse saison seulement</p>
          <div class="space-y-2 text-xs text-white/60">
            <p><span class="text-white/80 font-medium">Coût :</span> Carburant + parking</p>
            <p><span class="text-white/80 font-medium">Temps :</span> Variable</p>
            <p><span class="text-white/80 font-medium">Confort :</span> Moyen</p>
            <p><span class="text-white/80 font-medium">Circulation :</span> <span class="text-red-400">Dense en été</span></p>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- Moyens de transport -->
  <section class="py-16">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">

      <!-- Depuis Naples -->
      <div class="bg-white rounded-[2rem] shadow-sm border border-slate-100 p-6 sm:p-8">
        <div class="flex items-center gap-4 mb-6">
          <div class="w-12 h-12 bg-med-gold rounded-2xl flex items-center justify-center">
            <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"/></svg>
          </div>
          <div>
            <h2 class="text-2xl font-bold font-serif">Depuis Naples</h2>
            <p class="text-med-gold text-xs sm:text-sm">Aéroport de Capodichino · Gare Centrale de Naples</p>
          </div>
        </div>
        <p class="text-slate-600 leading-relaxed mb-6">
          Naples est la principale porte d'entrée vers la Côte Amalfitaine. L'aéroport international de Naples-Capodichino (NAP) dispose de vols directs depuis toutes les grandes villes européennes, dont de nombreux vols low-cost depuis Rome, Milan, Londres, Paris, Francfort et Madrid. Depuis Naples, trois options s'offrent à vous :
        </p>
        <div class="space-y-4">
          <div class="bg-med-gold/5 rounded-2xl p-4 sm:p-5">
            <h3 class="font-semibold text-slate-900 mb-2">Ferry direct (été)</h3>
            <p class="text-slate-600 text-xs sm:text-sm">D'avril à octobre, des ferries rapides depuis le Molo Beverello de Naples rejoignent directement Positano et Amalfi en environ 1h30. Confortable, pittoresque et sans embouteillages. Réservez à l'avance en haute saison.</p>
          </div>
          <div class="bg-med-gold/5 rounded-2xl p-4 sm:p-5">
            <h3 class="font-semibold text-slate-900 mb-2">Bus SITA via Sorrente</h3>
            <p class="text-slate-600 text-xs sm:text-sm">Circumvesuviana de Naples à Sorrente (environ 1h), puis bus SITA le long de la côte. Économique mais long (2h30–3h au total). Bonne option pour éviter la voiture.</p>
          </div>
          <div class="bg-med-gold/5 rounded-2xl p-4 sm:p-5">
            <h3 class="font-semibold text-slate-900 mb-2">Transfert privé</h3>
            <p class="text-slate-600 text-xs sm:text-sm">Taxi ou NCC depuis l'aéroport de Naples : environ 90–120 euros jusqu'à Positano/Amalfi (1h–1h30 sans trafic). Pratique pour les familles ou avec des bagages volumineux.</p>
          </div>
        </div>
      </div>

      <!-- Depuis Salerne -->
      <div class="bg-white rounded-[2rem] shadow-sm border border-slate-100 p-6 sm:p-8">
        <div class="flex items-center gap-4 mb-6">
          <div class="w-12 h-12 bg-med-gold rounded-2xl flex items-center justify-center">
            <svg class="w-6 h-6 text-white" fill="currentColor" viewBox="0 0 24 24"><rect x="2" y="7" width="20" height="10" rx="1"/><rect x="4" y="17" width="3" height="2"/><rect x="17" y="17" width="3" height="2"/><path d="M2 7L4 2h16l2 5"/></svg>
          </div>
          <div>
            <h2 class="text-2xl font-bold font-serif">Depuis Salerne</h2>
            <p class="text-med-gold text-xs sm:text-sm">Porte orientale de la Côte Amalfitaine</p>
          </div>
        </div>
        <p class="text-slate-600 leading-relaxed mb-6">
          Salerne est une entrée souvent méconnue mais très pratique. La gare de Salerne est desservie par les trains à grande vitesse (1h40 depuis Rome, 2h30 depuis Milan) et de nombreux trains régionaux. L'aéroport Salerne-Côte d'Amalfi (QSR) est le plus proche de la côte, avec des vols nationaux et quelques liaisons européennes. Depuis Salerne, le bus SITA vers la côte est fréquent et met 45 minutes jusqu'à Amalfi. Des ferries circulent aussi en été.
        </p>
        <div class="space-y-4">
          <div class="bg-med-gold/5 rounded-2xl p-4 sm:p-5">
            <h3 class="font-semibold text-slate-900 mb-2">Aéroport Salerne-Côte d'Amalfi (QSR)</h3>
            <p class="text-slate-600 text-xs sm:text-sm">L'aéroport le plus proche de la Côte Amalfitaine, à seulement 20 km de Vietri sul Mare. Vols depuis Milan, Rome et quelques villes européennes. Depuis l'aéroport, bus ou transfert privé vers la côte en environ 30 minutes.</p>
          </div>
          <div class="bg-med-gold/5 rounded-2xl p-4 sm:p-5">
            <h3 class="font-semibold text-slate-900 mb-2">Ferry depuis Salerne (été)</h3>
            <p class="text-slate-600 text-xs sm:text-sm">Ferries de Salerne vers Amalfi et Positano d'avril à octobre. Environ 45 minutes jusqu'à Amalfi, avec de magnifiques vues sur la côte. Moins cher que les ferries depuis Naples.</p>
          </div>
        </div>
      </div>

      <!-- Depuis Sorrente -->
      <div class="bg-white rounded-[2rem] shadow-sm border border-slate-100 p-6 sm:p-8">
        <div class="flex items-center gap-4 mb-6">
          <div class="w-12 h-12 bg-med-gold rounded-2xl flex items-center justify-center">
            <svg class="w-6 h-6 text-white" fill="currentColor" viewBox="0 0 24 24"><path d="M3 13h18v2H3zm0-4h18v2H3zm0 8h18v2H3zm9-12L6 8h12l-6-3zm0 14l-6 3h12l-6-3z"/></svg>
          </div>
          <div>
            <h2 class="text-2xl font-bold font-serif">Depuis Sorrente</h2>
            <p class="text-med-gold text-xs sm:text-sm">En ferry ou par la route panoramique</p>
          </div>
        </div>
        <p class="text-slate-600 leading-relaxed">
          Sorrente est une base très fréquentée pour visiter à la fois la Péninsule Sorrentine et la Côte Amalfitaine. Les ferries depuis Sorrente atteignent Positano en 25 minutes : c'est la façon la plus pittoresque et rapide d'entrer sur la côte. Alternativement, le bus SITA emprunte la SP145 et la SS163 en environ 1h30 jusqu'à Amalfi.
        </p>
      </div>

      <!-- En voiture -->
      <div class="bg-white rounded-[2rem] shadow-sm border border-slate-100 p-6 sm:p-8">
        <div class="flex items-center gap-4 mb-6">
          <div class="w-12 h-12 bg-med-gold rounded-2xl flex items-center justify-center">
            <svg class="w-6 h-6 text-white" fill="currentColor" viewBox="0 0 24 24"><path d="M18.92 6.01C18.72 5.42 18.16 5 17.5 5h-11c-.66 0-1.22.42-1.42 1.01L3 12v8c0 .55.45 1 1 1h1c.55 0 1-.45 1-1v-1h12v1c0 .55.45 1 1 1h1c.55 0 1-.45 1-1v-8l-2.08-5.99zM6.5 16c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2zm11 0c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2z"/></svg>
          </div>
          <div>
            <h2 class="text-2xl font-bold font-serif">En voiture</h2>
            <p class="text-med-gold text-xs sm:text-sm font-medium">⚠️ Déconseillé en juillet et août</p>
          </div>
        </div>
        <p class="text-slate-600 leading-relaxed mb-6">
          La SS163, la route côtière qui traverse la Côte Amalfitaine, est l'une des routes les plus spectaculaires d'Europe mais aussi l'une des plus étroites. En haute saison, la circulation peut être paralysante, avec des heures de bouchons. Si vous prenez la voiture, voici quelques conseils :
        </p>
        <ul class="space-y-3">
          <li class="flex gap-3 text-xs sm:text-sm text-slate-600">
            <svg class="w-5 h-5 text-med-gold flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
            Partez avant 8h ou après 19h pour éviter les embouteillages
          </li>
          <li class="flex gap-3 text-xs sm:text-sm text-slate-600">
            <svg class="w-5 h-5 text-med-gold flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
            Garez-vous à Sorrente ou Salerne et utilisez les transports en commun ou les ferries le long de la côte
          </li>
          <li class="flex gap-3 text-xs sm:text-sm text-slate-600">
            <svg class="w-5 h-5 text-med-gold flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
            Les parkings à Amalfi et Positano coûtent 3–5 €/heure et sont souvent complets en haute saison
          </li>
          <li class="flex gap-3 text-xs sm:text-sm text-slate-600">
            <svg class="w-5 h-5 text-med-gold flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
            Au printemps (avril–mai) et en automne (septembre–octobre) conduire est agréable et pratique
          </li>
        </ul>
      </div>

    </div>
  </section>

  <!-- D'où partez-vous ? -->
  <section class="pb-16">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl font-bold font-serif text-slate-900 mb-8">D'où partez-vous ?</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4 sm:gap-6">

        <div class="bg-white rounded-[2rem] shadow-sm border border-slate-100 p-6">
          <p class="text-med-gold text-xs font-bold uppercase tracking-wider mb-3">Depuis Rome</p>
          <ul class="space-y-2 text-slate-600 text-xs sm:text-sm">
            <li class="flex gap-2"><span class="text-med-gold font-bold">1.</span> Train AV Rome - Salerne (1h40, à partir de 19 €)</li>
            <li class="flex gap-2"><span class="text-med-gold font-bold">2.</span> Bus SITA Salerne - Amalfi (45 min, 2,40 €)</li>
            <li class="flex gap-2"><span class="text-slate-400 text-xs">Total : environ 2h30 - la voie la plus rapide</span></li>
          </ul>
        </div>

        <div class="bg-white rounded-[2rem] shadow-sm border border-slate-100 p-6">
          <p class="text-med-blue text-xs font-bold uppercase tracking-wider mb-3">Depuis Milan</p>
          <ul class="space-y-2 text-slate-600 text-xs sm:text-sm">
            <li class="flex gap-2"><span class="text-med-blue font-bold">A.</span> Vol Milan - Naples (1h15, à partir de 30 €) + ferry</li>
            <li class="flex gap-2"><span class="text-med-blue font-bold">B.</span> Vol Milan - Salerne (1h20) - aéroport le plus proche de la côte</li>
            <li class="flex gap-2"><span class="text-med-blue font-bold">C.</span> Train AV Milan - Salerne (4h30, à partir de 39 €) + bus</li>
            <li class="flex gap-2"><span class="text-slate-400 text-xs">Salerne est le plus proche, Naples a plus de vols</span></li>
          </ul>
        </div>

        <div class="bg-white rounded-[2rem] shadow-sm border border-slate-100 p-6">
          <p class="text-slate-500 text-xs font-bold uppercase tracking-wider mb-3">Depuis l'étranger</p>
          <ul class="space-y-2 text-slate-600 text-xs sm:text-sm">
            <li class="flex gap-2"><span class="text-slate-400 font-bold">✈</span> Volez sur Naples (NAP) - vols directs depuis Londres, Paris, Berlin, Madrid, Amsterdam</li>
            <li class="flex gap-2"><span class="text-slate-400 font-bold">✈</span> Salerne (QSR) - aéroport Côte d'Amalfi, le plus proche de la côte</li>
            <li class="flex gap-2"><span class="text-slate-400 font-bold">✈</span> Alternativement : Rome Fiumicino + train AV à Salerne</li>
            <li class="flex gap-2"><span class="text-slate-400 text-xs">Salerne est le plus proche, Naples a plus de vols low-cost, Rome plus d'intercontinentaux</span></li>
          </ul>
        </div>

      </div>
    </div>
  </section>

  <!-- Distances et temps de trajet - Onglets par destination -->
  <section class="bg-slate-100 py-16">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl font-bold font-serif text-slate-900 mb-8 text-center">Distances et temps de trajet</h2>

      <!-- Boutons d'onglets -->
      <div class="flex flex-wrap justify-center gap-2 mb-8" role="tablist">
        <button role="tab" aria-selected="true" data-tab="costiera" class="tab-btn px-4 py-2 rounded-full text-xs sm:text-sm font-medium bg-slate-900 text-white transition-colors">Côte Amalfitaine</button>
        <button role="tab" aria-selected="false" data-tab="penisola" class="tab-btn px-4 py-2 rounded-full text-xs sm:text-sm font-medium bg-white text-slate-600 hover:bg-slate-200 transition-colors">Péninsule Sorrentine</button>
        <button role="tab" aria-selected="false" data-tab="isole" class="tab-btn px-4 py-2 rounded-full text-xs sm:text-sm font-medium bg-white text-slate-600 hover:bg-slate-200 transition-colors">Îles</button>
      </div>

      <!-- Onglet : Côte Amalfitaine -->
      <div data-panel="costiera" class="tab-panel">
        <div class="overflow-x-auto">
          <table class="w-full bg-white rounded-2xl shadow-sm overflow-hidden">
            <thead class="bg-slate-900 text-white">
              <tr>
                <th class="px-3 py-2 sm:px-6 sm:py-4 text-left text-xs sm:text-sm font-semibold">Depuis</th>
                <th class="px-3 py-2 sm:px-6 sm:py-4 text-left text-xs sm:text-sm font-semibold">Vers</th>
                <th class="px-3 py-2 sm:px-6 sm:py-4 text-left text-xs sm:text-sm font-semibold">Transport</th>
                <th class="px-3 py-2 sm:px-6 sm:py-4 text-left text-xs sm:text-sm font-semibold">Durée</th>
                <th class="px-3 py-2 sm:px-6 sm:py-4 text-left text-xs sm:text-sm font-semibold">Prix</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
            <!-- Positano -->
            <tr class="hover:bg-slate-50">
              <td class="px-3 py-2 sm:px-6 sm:py-4 text-xs sm:text-sm">Naples (Beverello)</td>
              <td class="px-3 py-2 sm:px-6 sm:py-4 text-xs sm:text-sm font-medium">Positano</td>
              <td class="px-3 py-2 sm:px-6 sm:py-4 text-xs sm:text-sm">Ferry (été)</td>
              <td class="px-3 py-2 sm:px-6 sm:py-4 text-xs sm:text-sm text-med-gold font-medium">1h 30min</td>
              <td class="px-3 py-2 sm:px-6 sm:py-4 text-xs sm:text-sm">18 € - 22 €</td>
            </tr>
            <tr class="hover:bg-slate-50">
              <td class="px-3 py-2 sm:px-6 sm:py-4 text-xs sm:text-sm">Sorrente</td>
