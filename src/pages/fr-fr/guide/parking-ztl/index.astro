---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../../components/Breadcrumbs.astro';
import Swiper from 'swiper';
import { Pagination } from 'swiper/modules';

const lang = 'fr-fr';

const breadcrumbs = [
  { name: 'Accueil', url: '/fr-fr/' },
  { name: 'Guide pratique', url: '/fr-fr/' },
  { name: 'Parking & ZTL', url: '/fr-fr/guide/parking-ztl/' },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Existe-t-il des parkings gratuits sur la Côte Amalfitaine ?",
      "acceptedAnswer": { "@type": "Answer", "text": "Très peu. Les places à lignes blanches se trouvent surtout loin des centres : Montepertuso et Nocelle au-dessus de Positano, quelques tronçons en bord de route sur la SS163 et sur la route d'Agerola avant Amalfi, la Via Chiunzi à Maiori, la Via Rota et la Via Parsano à Sorrente. En juillet et août, elles sont généralement prises avant 9h00. Lisez toujours le panneau à côté du marquage : beaucoup de places blanches sont réservées aux résidents ou limitées dans le temps avec le disque de stationnement." }
    },
    {
      "@type": "Question",
      "name": "Combien coûte le stationnement à Positano ?",
      "acceptedAnswer": { "@type": "Answer", "text": "Les garages privés du centre, comme Mandara et De Gennaro, coûtent environ 8-12 € de l'heure et 50-90 € par jour en été. Les places municipales à lignes bleues coûtent environ 3 € de l'heure mais sont presque toujours occupées. Les places gratuites n'existent qu'en hauteur, à Montepertuso et Nocelle, reliées au centre par le bus local." }
    },
    {
      "@type": "Question",
      "name": "Combien coûte le parking à Amalfi ?",
      "acceptedAnswer": { "@type": "Answer", "text": "Les parkings Luna Rossa et Berma coûtent environ 5 € de l'heure le jour et 4 € de l'heure la nuit ; ceux du port (Darsena, Flavio Gioia) environ 6 € de l'heure le jour. En 2026, un supplément s'appliquait aux deux premières heures de journée. En juillet et août ils sont pleins dès le milieu de matinée : arrivez avant 9h00 ou venez en bus ou en ferry." }
    },
    {
      "@type": "Question",
      "name": "Où se garer pour visiter la Côte Amalfitaine ?",
      "acceptedAnswer": { "@type": "Answer", "text": "Les options les plus pratiques : 1) Vietri sul Mare ou Salerne, qui ont les plus grands parkings de la côte, puis bus SITA ou ferry Travelmar. 2) Sorrente (garage Achille Lauro, environ 2-3 €/h) ou une gare de la Circumvesuviana comme Vico Equense ou Sant'Agnello, puis bus ou hydroglisseur. 3) Praiano, avec des lignes bleues municipales et des tickets de 6 et 14 heures, à mi-chemin entre Positano et Amalfi." }
    },
    {
      "@type": "Question",
      "name": "Peut-on aller à Positano en voiture ?",
      "acceptedAnswer": { "@type": "Answer", "text": "Oui, la SS163 traverse le haut de Positano, mais de nombreux jours entre Pâques et octobre la circulation alternée s'applique de 10h00 à 18h00. La route intérieure à sens unique (Via Pasitea, Piazza dei Mulini, Via Cristoforo Colombo) est une ZTL avec portiques à caméras, ouverte uniquement aux véhicules autorisés. Si vous réservez un garage au centre ou un hôtel avec parking, demandez-leur d'enregistrer votre plaque avant votre arrivée." }
    },
    {
      "@type": "Question",
      "name": "Où se garer à Sorrente ?",
      "acceptedAnswer": { "@type": "Answer", "text": "Les principales options sont le garage Achille Lauro, Via Correale (environ 2-3 €/h, 24-30 € par jour, gratuit moins de 30 minutes), Fuorimura Parking et Sorrento Parking (à partir d'environ 27 € par jour) et le garage Marina Piccola au port (environ 26 € pour 6 heures, 32 € pour 24 heures), pratique pour une journée à Capri. Les lignes bleues coûtent 1 € les 30 minutes ou 2 € de l'heure. Le centre est en ZTL le soir et le dimanche." }
    },
    {
      "@type": "Question",
      "name": "Que signifient les lignes bleues, blanches et jaunes en Italie ?",
      "acceptedAnswer": { "@type": "Answer", "text": "Les lignes bleues indiquent un stationnement payant : payez à l'horodateur ou avec une application et laissez le ticket visible. Les lignes blanches sont gratuites, sauf limite indiquée par un panneau (disque, résidents, nettoyage des rues). Les lignes jaunes sont réservées : résidents avec permis, titulaires de la carte handicapé, livraisons, taxis ou bus. Se garer sur une place jaune ou dépasser le temps payé sur les bleues coûte à partir d'environ 42 €, et dans les zones de mise en fourrière signalées la voiture peut être enlevée." }
    }
  ]
};

const amalfiCoast = [
  { town: "Positano", where: "Garages privés sur la route intérieure (Mandara, De Gennaro) ; lignes bleues municipales ; places gratuites en hauteur à Montepertuso et Nocelle", cost: "Garages environ 8-12 €/h, 50-90 € par jour en été. Lignes bleues environ 3 €/h", notes: "Les garages du centre sont pleins dès le milieu de matinée en juillet et août : réservez. La route intérieure est une ZTL à caméras, demandez au garage ou à l'hôtel d'enregistrer votre plaque." },
  { town: "Praiano", where: "Lignes bleues municipales le long de la SS163 et des rues du village ; parking privé à Marina di Praia", cost: "3 €/h, 15 € pour 6 h, 30 € pour 14 h (2026)", notes: "Payant 08h00-22h00 d'avril à octobre, 08h00-20h00 de novembre à mars, jours fériés compris. Quelques lignes blanches, souvent réservées aux résidents." },
  { town: "Amalfi", where: "Luna Rossa (creusé dans la roche entre Amalfi et Atrani, environ 170 places, tunnel piéton vers le centre) ; Berma ; parkings du port Darsena et Flavio Gioia", cost: "Luna Rossa et Berma environ 5 €/h le jour, 4 €/h la nuit. Port environ 6 €/h le jour. 2026 : supplément sur les deux premières heures de journée", notes: "Luna Rossa : interdit aux voitures GPL et méthane, hauteur max. 2 m ; prévoyez des espèces pour la caisse de sortie. En été, généralement plein avant 10h00. Le centre historique est en ZTL." },
  { town: "Atrani", where: "Quelques places à lignes bleues près de la plage ; Luna Rossa, dont le tunnel mène aussi à Atrani", cost: "Lignes bleues environ 2,50-3 €/h", notes: "Un guide de 2026 signale en été une limite de 4 heures pour les non-résidents et une interdiction de stationner la nuit (20h00-08h00). Préférez Luna Rossa." },
  { town: "Ravello", where: "Garage sous la Piazza Duomo (environ 140 places) ; parking de l'Auditorium Oscar Niemeyer ; lignes bleues Via Boccaccio et Via della Repubblica", cost: "Piazza Duomo : environ 5 €/h le jour selon les guides 2026 (anciennes listes : 2,50 €/h, 15 € par jour). Auditorium : environ 4 €/h le jour, 2,50 €/h la nuit, 40 € pour 24 h", notes: "Le centre est en ZTL. Les places en rue près du centre peuvent atteindre 5 €/h. Le garage de la Piazza Duomo peut fermer pour des événements et des mariages." },
  { town: "Minori", where: "Lignes bleues sur le front de mer ; petit parking payant au bout de la Via Roma (environ 20 places)", cost: "Environ 3 €/h", notes: "De nouveaux tarifs 2026 ont été approuvés en février 2026 : fiez-vous à l'horodateur. Très peu de places en été." },
  { town: "Maiori", where: "Lignes bleues le long du front de mer ; parking du port", cost: "Lignes bleues environ 3 €/h en été, en semaine et les jours fériés. Port environ 5 €/h", notes: "Lignes blanches gratuites Via Chiunzi (route de Tramonti), loin de la plage. Le long front de mer fait de Maiori l'une des communes les plus simples." },
  { town: "Cetara", where: "Parking du port (lignes bleues) ; parking Pastena dans le haut du village (Via Cannillo)", cost: "Port environ 3 €/h de mars à octobre, 1,50 €/h de novembre à février (une source indique 4 €/h). Pastena environ 3 €/h", notes: "Parking du port ouvert environ 07h00-02h00. Quand il est plein, la descente peut être fermée et l'on vous envoie au Pastena." },
  { town: "Vietri sul Mare", where: "Piazza Matteotti ; parking de la gare (environ 150 places) ; Piazza Mercato ; lignes bleues à la Marina di Vietri", cost: "Piazza Matteotti 3 € la première heure, puis 1,50 € par 30 min. Gare et Piazza Mercato environ 2 €/h ou 20 € par jour. Marina juin-août 2,50 €/h en semaine, 3 €/h le week-end", notes: "La plus grande offre de stationnement de la côte. Un ascenseur public gratuit fonctionne près de la gare. La Piazza Matteotti est gratuite au petit matin (vérifiez la plage horaire sur l'horodateur)." },
  { town: "Furore", where: "Parking à Marina di Praia ; lignes bleues dans le haut du village", cost: "Environ 2,50 €/h à Marina di Praia", notes: "Pas de parking au Fiordo : environ 2 km à pied le long de la SS163. Ne vous arrêtez pas sur le pont." },
  { town: "Conca dei Marini", where: "Une poignée de places municipales à lignes bleues", cost: "Un guide de 2026 indique 20 € par jour ; aucun tarif horaire fiable trouvé", notes: "Très peu de places. Le bus SITA est plus simple." },
];

const sorrentoPeninsula = [
  { town: "Sorrente", where: "Achille Lauro (Via Correale, sous la Piazza Lauro) ; Fuorimura Parking ; Sorrento Parking (Via San Renato) ; Parcheggio Stinga (Via degli Aranci) ; garage Marina Piccola au port", cost: "Achille Lauro environ 2-3 €/h, 24-30 € par jour, gratuit moins de 30 min. Fuorimura environ 2,50 €/h, à partir de 27 € par jour. Sorrento Parking 3 €/h, à partir de 27 € par jour. Marina Piccola environ 26 € pour 6 h, 32 € pour 24 h. Lignes bleues 1 € les 30 min, 2 €/h", notes: "Lignes blanches gratuites Via Rota et Via Parsano, rarement libres. Marina Piccola convient pour une journée à Capri. Le centre est en ZTL le soir et le dimanche." },
  { town: "Sant'Agnello", where: "Lignes bleues Via Cocumella et Viale dei Pini ; parking de la gare Circumvesuviana (Piazzale Don Minzoni)", cost: "Tarifs par zone ; aucun chiffre actuel fiable trouvé", notes: "À un arrêt de train ou 15-20 minutes à pied du centre de Sorrente : une base plus calme que le centre-ville." },
  { town: "Piano di Sorrento", where: "Lignes bleues gérées par SIS ; Piazza della Repubblica ; parking de la gare Circumvesuviana (Via Stazione)", cost: "Corso Italia et Piazza Cota 1,50 €/h. La plupart des rues 1 €/h, rues périphériques 0,50 €/h. Piazza della Repubblica : 30 premières minutes gratuites, puis 1 €", notes: "Payant du lundi au samedi 08h30-13h30 et 15h30-21h30 (juin-septembre), 08h30-13h30 et 15h00-20h00 (octobre-mai). La pause de midi est gratuite." },
  { town: "Meta", where: "Parking de la plage Marina di Meta avec ascenseur ; lignes bleues en ville (zones A, B, C)", cost: "Marina di Meta juin-septembre 3 €/h ou 15 € par jour (08h00-24h00) ; mars-mai et octobre 1,50 €/h ou 6 € par jour ; novembre-février 1 €/h. Lignes bleues en ville environ 1 €/h", notes: "L'ascenseur vers la plage coûte 1 €. Meta applique dans son centre sa propre règle de circulation alternée, inversée : voir notre guide." },
  { town: "Vico Equense", where: "Parkings saisonniers de Marina d'Aequa et Marina di Vico ; lignes bleues au centre", cost: "Marinas : 8 € pour les 6 premières heures, puis 2 €/h (10 € pour les voitures de plus de 5 places) ; tarif du soir 5 € dès 19h00 (tarifs 2025)", notes: "La haute saison va du 1er juin au 10 septembre. Vico a une gare de la Circumvesuviana, un bon point de parking-relais avant Sorrente." },
  { town: "Massa Lubrense (Marina del Cantone, Nerano)", where: "Lignes bleues municipales ; deux petits parkings à Marina del Cantone ; parkings privés, dont Il Venione avec navette", cost: "Lignes bleues 2 €/h de mi-avril à mi-octobre (délibération de 2023), environ 3 €/h selon des sources plus récentes. Parkings de Marina del Cantone 3 €/h. Privés environ 10-25 € par jour, places réservées à Nerano jusqu'à 50 € par jour", notes: "En août et le week-end, les parkings sont pleins avant 9h00. En 2025 la commune a ouvert des aires de stationnement temporaires (ordonnance 79/2025) faute de places." },
  { town: "Sant'Agata sui Due Golfi", where: "Aucun parking public nommé trouvé", cost: "Aucun tarif publié fiable", notes: "Demandez à votre hébergement où vous garer. Des bus locaux partent de Sorrente." },
];

const ztlData = [
  { location: "Positano", period: "Toute l'année, portiques à caméras", note: "Route intérieure à sens unique (Via Pasitea, Piazza dei Mulini, Via Cristoforo Colombo) réservée aux véhicules autorisés. Les clients d'hôtels et de garages doivent faire enregistrer leur plaque." },
  { location: "Amalfi", period: "Toute l'année (centre historique)", note: "Garez-vous à Luna Rossa, à la Berma ou au port et entrez à pied. Les hôtels peuvent enregistrer leurs clients pour le déchargement." },
  { location: "Ravello", period: "Centre historique", note: "Utilisez le garage de la Piazza Duomo ou le parking de l'Auditorium, juste à l'extérieur des rues à accès limité." },
  { location: "Sorrente", period: "Le soir dès 19h30 et le dimanche (centre)", note: "Les garages cités plus haut restent accessibles. Vérifiez les panneaux aux entrées." },
  { location: "SS163 Amalfitana", period: "De Pâques à octobre, 10h00-18h00", note: "Circulation alternée certains jours (plaques impaires les jours impairs). Motos et scooters exemptés." },
  { location: "Meta et SS145", period: "Du printemps à octobre, jours fixés", note: "Règles communales de circulation alternée, inversées à Meta. Vérifiez le calendrier avant de partir." },
];
---

<BaseLayout
  title="Parking Côte Amalfitaine 2026 : Prix et Places Gratuites"
  description="Se garer sur la Côte Amalfitaine et la Péninsule Sorrentine, village par village : parkings, prix à l'heure et à la journée, lignes bleues, places gratuites à lignes blanches, ZTL et amendes."
  lang={lang}
  breadcrumbs={breadcrumbs}
  schema={[faqSchema]}
 pageKey="parking-ztl"
  heroImage="/images/parcheggi-hero.webp"
>

  <section class="relative h-[75vh] sm:h-[90vh] flex items-center bg-charcoal overflow-hidden">
    <img src="/images/parcheggi-hero.webp" alt="Sorrente, Péninsule Sorrentine" class="absolute inset-0 w-full h-full object-cover" loading="eager" fetchpriority="high" decoding="sync" referrerpolicy="no-referrer"/>
    <div class="absolute inset-0 bg-gradient-to-b from-black/25 via-black/40 to-black/75"></div>
    <div class="relative z-10 max-w-7xl mx-auto px-6 py-20">
      <div class="max-w-3xl">
        <p class="text-med-gold text-xs sm:text-sm font-medium uppercase tracking-[0.3em] mb-3">Guide pratique</p>
        <h1 class="font-serif text-display text-white mb-4">Parking sur la Côte Amalfitaine : prix par village et places gratuites</h1>
        <p class="text-xl text-white/80 leading-relaxed">
          Les places sont rares et payantes presque partout. Voici les parkings village par village, leurs prix, les endroits où il reste des places gratuites à lignes blanches et le fonctionnement des ZTL.
        </p>
      </div>
    </div>
    <Breadcrumbs breadcrumbs={breadcrumbs} />
  </section>

  <div class="max-w-editorial mx-auto px-4 sm:px-6 lg:px-8 pt-0 pb-4 space-y-12">

    <section class="max-w-editorial">
      <div style="background-color: #E2725B; border-color: #E2725B; padding: 6px 12px 6px 12px;" class="border rounded-[2rem] mb-6 mt-8">
        <p class="font-semibold mb-0 mt-0 text-white text-sm leading-tight" style="margin-top: -2px;">⚠️ Attention aux ZTL</p>
        <p class="text-xs text-white/95 leading-tight">Les ZTL (zones à trafic limité) de la Côte Amalfitaine sont surveillées par caméras. Y entrer sans autorisation coûte à partir de 87 € (montants 2026), et l'amende arrive chez le loueur ou à votre domicile des mois plus tard, souvent avec des frais de gestion en plus.</p>
      </div>
      <p class="text-xl leading-relaxed text-charcoal">
        La meilleure façon de visiter la côte en voiture est le « stationnement stratégique » : laissez la voiture là où les places sont plus faciles à trouver (Vietri, Salerne, Sorrente, une gare de la Circumvesuviana ou Praiano) et continuez en bus, en ferry ou en hydroglisseur. Si vous entrez quand même dans les villages, les tableaux ci-dessous vous disent où aller et combien prévoir.
      </p>
      <p class="text-sm text-slate-500 leading-relaxed mt-4">
        Prix indicatifs, relevés en octobre 2026 auprès des gestionnaires, des mairies et de la presse locale, avec des données de 2023-2026. Les tarifs changent à chaque saison : seul le panneau du parking ou de l'horodateur fait foi.
      </p>
    </section>

    <section id="lignes">
      <h2 class="font-serif text-2xl font-semibold text-slate-900 mb-6">Lignes bleues, blanches et jaunes : ce qu'elles signifient</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4 sm:gap-6">
        <div class="bg-med-cream rounded-[2rem] p-5 sm:p-6 border border-slate-100">
          <div class="w-12 h-1.5 rounded-full mb-3" style="background-color: #2563eb;"></div>
          <h3 class="font-semibold text-charcoal text-sm mb-2">Lignes bleues : payant</h3>
          <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">Payez à l'horodateur (pièces, souvent carte) ou avec une application comme EasyPark et laissez le ticket visible. Horaires et tarifs figurent sur le panneau ; en dehors de ces horaires, le stationnement est en général gratuit.</p>
        </div>
        <div class="bg-med-cream rounded-[2rem] p-5 sm:p-6 border border-slate-100">
          <div class="w-12 h-1.5 rounded-full mb-3 bg-white border border-slate-300"></div>
          <h3 class="font-semibold text-charcoal text-sm mb-2">Lignes blanches : gratuit</h3>
          <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">Gratuit, sauf limite indiquée par le panneau : disque de stationnement (disco orario), résidents uniquement, nettoyage des rues ou horaires de fourrière. Lisez le panneau avant de partir.</p>
        </div>
        <div class="bg-med-cream rounded-[2rem] p-5 sm:p-6 border border-slate-100">
          <div class="w-12 h-1.5 rounded-full mb-3" style="background-color: #eab308;"></div>
          <h3 class="font-semibold text-charcoal text-sm mb-2">Lignes jaunes : réservé</h3>
          <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">Résidents avec permis, titulaires de la carte handicapé, livraisons, taxis et bus. Ne vous y garez jamais sans le bon permis, même cinq minutes.</p>
        </div>
      </div>
    </section>

    <section id="parking-gratuit">
      <h2 class="font-serif text-2xl font-semibold text-slate-900 mb-6">Parking gratuit (lignes blanches) : la réalité</h2>
      <p class="text-lg leading-relaxed text-charcoal mb-6">
        Se garer gratuitement sur la Côte Amalfitaine est rare. Dans les centres, presque toutes les places sont bleues ou jaunes, et les rares lignes blanches sont souvent réservées aux résidents par un petit panneau. Les places gratuites qui existent sont en périphérie, en hauteur ou le long de la route principale, et en juillet et août elles disparaissent en général avant 9h00. En mai, début juin et octobre, un matin de semaine, vos chances sont réelles.
      </p>
      <h3 class="font-semibold text-charcoal mb-3">Où trouver des lignes blanches</h3>
      <ul class="space-y-3 mb-6">
        <li class="flex items-start gap-3"><span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span><span class="text-slate-700"><strong>Positano.</strong> Montepertuso et Nocelle, sur les collines au-dessus du village. De là, descendez avec le bus local Flavio Gioia ou à pied (environ 35 minutes).</span></li>
        <li class="flex items-start gap-3"><span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span><span class="text-slate-700"><strong>Amalfi.</strong> Des tronçons en bord de route sur la SS163, environ 1,5 km avant le centre en venant de Positano, et sur la route d'Agerola (SS366), environ 1 km au-dessus de la ville. Le retour à pied suit la route, avec peu ou pas de trottoir.</span></li>
        <li class="flex items-start gap-3"><span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span><span class="text-slate-700"><strong>Maiori.</strong> Via Chiunzi, la route vers Tramonti, loin du front de mer.</span></li>
        <li class="flex items-start gap-3"><span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span><span class="text-slate-700"><strong>Praiano.</strong> Des places éparses le long de la route. Beaucoup sont réservées aux résidents : le panneau indique où commence la partie réservée.</span></li>
        <li class="flex items-start gap-3"><span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span><span class="text-slate-700"><strong>Sorrente.</strong> Via Rota (loin du centre) et Via Parsano (près du Corso Italia). Rarement libres en saison.</span></li>
      </ul>
      <h3 class="font-semibold text-charcoal mb-3">Règles, amendes et fourrière</h3>
      <ul class="space-y-3">
        <li class="flex items-start gap-3"><span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span><span class="text-slate-700"><strong>Disque de stationnement.</strong> Là où le panneau montre un disque et une durée limitée, réglez le disque bleu (disco orario) sur votre heure d'arrivée, arrondie à la demi-heure suivante, et laissez-le sur le tableau de bord. Les voitures de location n'en ont pas toujours : il coûte quelques euros chez le marchand de journaux ou à la station-service.</span></li>
        <li class="flex items-start gap-3"><span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span><span class="text-slate-700"><strong>Amendes.</strong> Stationner sur une place jaune, dépasser le temps payé sur les bleues ou oublier le disque coûte à partir d'environ 42 €. Les places handicapés et les entrées en ZTL coûtent bien plus cher.</span></li>
        <li class="flex items-start gap-3"><span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span><span class="text-slate-700"><strong>Fourrière.</strong> Là où le panneau indique « zona rimozione », la voiture peut être enlevée, et vous payez l'amende, le remorquage et le gardiennage. En été, la police municipale est très présente, surtout sur la SS163, où une voiture mal garée bloque les bus.</span></li>
        <li class="flex items-start gap-3"><span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span><span class="text-slate-700"><strong>Jamais en bord de chaussée.</strong> Une voiture laissée à moitié sur la SS163 hors des places marquées est vite verbalisée et peut être enlevée. Pas de marquage, pas de place.</span></li>
      </ul>
    </section>

    <section id="cote-amalfitaine">
      <h2 class="font-serif text-2xl font-semibold text-slate-900 mb-6">Côte Amalfitaine : parkings et prix village par village</h2>
      <div class="overflow-x-auto rounded-2xl border border-slate-200">
        <table class="w-full min-w-[760px] text-xs sm:text-sm">
          <thead>
            <tr class="bg-slate-900 text-white">
              <th class="text-left px-3 py-3 font-semibold">Village</th>
              <th class="text-left px-3 py-3 font-semibold">Où se garer</th>
              <th class="text-left px-3 py-3 font-semibold">Coût (indicatif)</th>
              <th class="text-left px-3 py-3 font-semibold">Remarques</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100">
            {amalfiCoast.map(r => (
              <tr class="hover:bg-slate-50 transition-colors align-top">
