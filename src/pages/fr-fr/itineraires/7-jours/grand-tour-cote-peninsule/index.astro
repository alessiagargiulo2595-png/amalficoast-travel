---
import BaseLayout from '../../../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../../../components/Breadcrumbs.astro';

const lang = 'fr-fr';

const breadcrumbs = [
  { name: 'Accueil', url: '/fr-fr/' },
  { name: 'Planification', url: '/fr-fr/planification/' },
  { name: 'Grand Tour - 7 jours', url: '/fr-fr/itineraires/7-jours/grand-tour-cote-peninsule/' },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Comment organiser 7 jours entre la Côte Amalfitaine et la Péninsule Sorrentine ?",
      "acceptedAnswer": { "@type": "Answer", "text": "Le parcours classique : 2 nuits à Naples (jours 1–2), puis Sorrente ou Amalfi comme base pour la Côte (jours 3–5), avec excursion à Capri (jour 4 ou 5), puis les îles en fin de séjour (jours 6–7). Bus SITA, Circumvesuviana et hydrofoils permettent de tout faire sans voiture." }
    },
    {
      "@type": "Question",
      "name": "Combien de nuits à Naples avant la Côte ?",
      "acceptedAnswer": { "@type": "Answer", "text": "1 à 2 nuits suffisent pour Naples : Spaccanapoli, Musée Archéologique National, pizza authentique, Certosa di San Martino. Avec 2 nuits on peut inclure Herculanum ou Pompéi en excursion à la journée. Naples est le point d'arrivée et de départ naturel pour toute la région." }
    }
  ]
};

const days = [
  { day: 'Jour 1', title: 'Naples', items: ['Arrivée à Naples. Spaccanapoli, centre historique UNESCO.', 'Musée Archéologique National : collections de Pompéi, mosaïques, bronzes.', 'Pizza authentique dans le quartier historique : Da Michele, Sorbillo ou Brandi.'] },
  { day: 'Jour 2', title: 'Pompéi ou Herculanum', items: ['Excursion en Circumvesuviana : fouilles d\'Herculanum (matin, 2–3h) + Vésuve (après-midi).', 'Alternative : Pompéi toute la journée (3–4h sur le site).', 'Retour à Naples pour le dîner.'] },
  { day: 'Jour 3', title: 'Sorrente et arrivée sur la Côte', items: ['Circumvesuviana Naples→Sorrente (70 min). Check-in Sorrente ou Amalfi.', 'Après-midi : centre de Sorrente, Vallone dei Mulini, Marina Grande.', 'Bus SITA vers Positano (optionnel, 50 min) : premier aperçu de la Côte.'] },
  { day: 'Jour 4', title: 'Capri', items: ['Hydrofoil de Sorrente à Capri (20–25 min). Premier départ 07h30.', 'Grotte Bleue tôt le matin. Anacapri et Monte Solaro en télésiège.', 'Faraglioni l\'après-midi. Apéritif sur la Piazzetta. Retour en soirée.'] },
  { day: 'Jour 5', title: 'Amalfi et Ravello', items: ['Bus SITA Sorrente→Amalfi (90 min) ou ferry Sorrente→Amalfi.', 'Cathédrale, Cloître du Paradis, Musée du Papier.', 'Bus pour Ravello (25 min) : Villa Rufolo, Villa Cimbrone. Dîner à Amalfi.'] },
  { day: 'Jour 6', title: 'Positano et tour en bateau', items: ['Bus SITA vers Positano (45 min depuis Amalfi). Matin libre sur la plage.', 'Tour en bateau depuis Positano (Grotte Émeraude, criques, ~€50–80, 4h).', 'Retour à Amalfi ou Positano. Dîner au bord du port.'] },
  { day: 'Jour 7', title: 'Ischia ou Procida et départ', items: ['Ferry Amalfi/Naples→Ischia ou Procida (excursion demi-journée).', 'Procida : Marina Corricella, Terra Murata, plage du Pozzo Vecchio.', 'Retour à Naples pour le départ.'] },
];
const touristTripSchema = {
  "@context": "https://schema.org",
  "@type": "TouristTrip",
  "name": "Grand Tour - 7 jours",
  "description": "Itinéraire complet de 7 jours : Naples, Côte Amalfitaine, Capri et îles du Golfe. Pompéi, Sorrente, Positano, Amalfi, Ravello - le Grand Tour du sud de l",
  "image": "https://amalficoast-travel.com/images/costiera-hero.jpg",
  "url": "https://amalficoast-travel.com/fr-fr/itineraires/7-jours/grand-tour-cote-peninsule/",
  "itinerary": {
    "@type": "ItemList",
    "numberOfItems": days.length,
    "itemListElement": days.map((d, i) => ({
      "@type": "ListItem",
      "position": i + 1,
      "name": `${d.day}: ${d.title}`,
      "description": d.items.join(' \u00b7 ')
    }))
  },
  "touristType": "Sightseeing"
};

const destinationHighlights = [];
const planningTips = [];
---

<BaseLayout
  title="Grand Tour Côte Amalfitaine 7 Jours 2026 | Naples, Capri, Positano, Amalfi"
  description="Itinéraire complet de 7 jours : Naples, Côte Amalfitaine, Capri et îles du Golfe. Pompéi, Sorrente, Positano, Amalfi, Ravello - le Grand Tour du sud de l'Italie."
  lang={lang}
  breadcrumbs={breadcrumbs}
  schema={[faqSchema, touristTripSchema]}
 pageKey="grand-tour-cote-peninsule"
  heroImage="/images/costiera-hero.jpg"
>

  <!-- Hero Section -->
  <section class="relative bg-charcoal overflow-hidden min-h-[70vh] sm:min-h-[75vh] flex items-center justify-center">
    <img src="/images/costiera-hero.jpg" alt="Grand Tour Côte Amalfitaine" class="absolute inset-0 w-full h-full object-cover opacity-30" loading="eager" fetchpriority="high" decoding="sync" referrerpolicy="no-referrer"/>
    <div class="absolute inset-0 bg-gradient-to-b from-black/75 via-black/40 to-black/70"></div>
    <div class="relative max-w-editorial mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <div class="max-w-3xl mx-auto">
        <p class="text-med-gold text-xs sm:text-sm font-medium uppercase tracking-[0.3em] mb-3">Itinéraire · 7 jours</p>
        <h1 class="font-serif text-display text-white mb-4">Grand Tour : Côte & Péninsule</h1>
        <p class="text-xl text-white/80 leading-relaxed max-w-2xl mx-auto">
          Une semaine pour tout voir : Naples, Capri, Côte Amalfitaine et îles du Golfe en transports publics.
        </p>
      </div>
    </div>
    <Breadcrumbs breadcrumbs={breadcrumbs} />
  </section>

  <div class="max-w-editorial mx-auto px-4 sm:px-6 lg:px-8 pt-6 pb-10 space-y-10">

    <!-- Quick Stats Grid -->
    <section class="grid grid-cols-2 sm:grid-cols-4 gap-2 sm:gap-4 overflow-x-auto snap-x snap-mandatory sm:overflow-visible">
      <div class="bg-slate-900 rounded-2xl p-6 hover:shadow-md transition-shadow flex flex-col items-center justify-center aspect-square snap-start">
        <svg class="w-8 h-8 text-med-gold mb-3" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
          <rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/>
        </svg>
        <p class="text-xs text-white/60 font-semibold uppercase tracking-wide mb-2">Durée</p>
        <p class="font-serif text-lg font-semibold text-med-gold text-center">7 jours<br/>6 nuits</p>
      </div>
      <div class="bg-slate-900 rounded-2xl p-6 hover:shadow-md transition-shadow flex flex-col items-center justify-center aspect-square snap-start">
        <svg class="w-8 h-8 text-med-gold mb-3" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
          <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/>
        </svg>
        <p class="text-xs text-white/60 font-semibold uppercase tracking-wide mb-2">Bases</p>
        <p class="font-serif text-lg font-semibold text-med-gold text-center">Naples +<br/>Amalfi/Sorrente</p>
      </div>
      <div class="bg-slate-900 rounded-2xl p-6 hover:shadow-md transition-shadow flex flex-col items-center justify-center aspect-square snap-start">
        <svg class="w-8 h-8 text-med-gold mb-3" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
          <path d="M6 9l6-6 6 6M5 9v9a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V9M9 14h6"/>
        </svg>
        <p class="text-xs text-white/60 font-semibold uppercase tracking-wide mb-2">Transports</p>
        <p class="font-serif text-lg font-semibold text-med-gold text-center">Train + bus<br/>+ hydroglisseurs</p>
      </div>
      <div class="bg-slate-900 rounded-2xl p-6 hover:shadow-md transition-shadow flex flex-col items-center justify-center aspect-square snap-start">
        <svg class="w-8 h-8 text-med-gold mb-3" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
          <circle cx="12" cy="12" r="1"/><path d="M12 1v6M12 17v6M4.22 4.22l4.24 4.24M15.54 15.54l4.24 4.24M1 12h6M17 12h6M4.22 19.78l4.24-4.24M15.54 8.46l4.24-4.24"/>
        </svg>
        <p class="text-xs text-white/60 font-semibold uppercase tracking-wide mb-2">Budget transports</p>
        <p class="font-serif text-lg font-semibold text-med-gold text-center">€80–120<br/><span class="text-xs">p.p.</span></p>
      </div>
    </section>


    <!-- Day by Day Itinerary -->
    <section>
      <h2 class="font-serif text-2xl font-semibold text-slate-900 mb-8">Programme jour par jour</h2>
      <div class="space-y-6">
        {days.map((d) => (
          <div class="bg-white border border-slate-200 rounded-2xl overflow-hidden hover:shadow-md transition-shadow">
            <div class="bg-slate-900 px-6 py-6 flex items-start gap-4 sm:items-center sm:gap-3">
              <span class="text-[10px] uppercase tracking-wide bg-white/15 text-white px-3 py-1.5 rounded-full font-bold flex-shrink-0">{d.day}</span>
              <div class="flex-1 min-w-0">
                <h3 class="font-serif font-semibold text-white text-lg">{d.title}</h3>
                {d.highlight && <p class="text-xs text-med-gold mt-1 font-medium">{d.highlight}</p>}
              </div>
            </div>
            <ul class="px-6 py-5 space-y-3">
              {d.items.map((item, itemIdx) => {
                const isLocalTip = item.includes('Local tip:');
                const displayText = item.replace('Local tip: ', '');
                const isLastItem = itemIdx === d.items.length - 1;
                return (
                  <li class={`flex gap-3 text-sm relative ${isLocalTip ? 'bg-med-gold/10 p-3 rounded-lg border border-med-gold/20' : ''}`}>
                    <div class="flex flex-col items-center">
                      {isLocalTip ? (
                        <svg class="w-5 h-5 text-med-gold flex-shrink-0 self-center" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
                          <circle cx="12" cy="8" r="5"/>
                          <path d="M12 13v2"/>
                          <rect x="10" y="15" width="4" height="3" rx="0.5"/>
                        </svg>
                      ) : (
                        <span class="w-2 h-2 rounded-full bg-med-blue flex-shrink-0"></span>
                      )}
                      {!isLastItem && <div class="w-0.5 h-6 bg-med-blue/30 mt-1"></div>}
                    </div>
                    <span class={`leading-relaxed ${isLocalTip ? 'font-semibold text-slate-800' : 'text-slate-700'}`}>
                      {isLocalTip && <strong>Local tip: </strong>}
                      {displayText}
                    </span>
                  </li>
                );
              })}
            </ul>
          </div>
        ))}
      </div>
    </section>

    {destinationHighlights.length > 0 && (
      <section>
        <h2 class="font-serif text-2xl font-semibold text-slate-900 mb-8">Destinations de l'itinéraire</h2>
        <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4">
          {destinationHighlights.map((dest) => (
            <a href={dest.url} class="group block bg-white border border-slate-200 rounded-2xl p-5 hover:shadow-lg hover:border-med-blue/30 transition-all">
              <h3 class="font-semibold text-charcoal mb-2 group-hover:text-med-blue transition-colors">{dest.name}</h3>
              <p class="text-xs text-slate-500 leading-relaxed mb-3">{dest.desc}</p>
              <span class="text-xs font-semibold text-med-blue inline-flex items-center gap-1 group-hover:gap-2 transition-all">
                Découvrir →
              </span>
            </a>
          ))}
        </div>
      </section>
    )}

    {planningTips.length > 0 && (
      <section class="bg-med-cream border border-med-gold/20 rounded-[2rem] p-6">
        <h2 class="font-serif text-xl font-semibold text-charcoal mb-6">Conseils pratiques</h2>
        <ul class="space-y-4">
          {planningTips.map(({ num, text }) => (
            <li class="flex items-start gap-4 text-sm text-charcoal">
              <span class="text-2xl font-bold text-white flex-shrink-0 leading-none mt-0.5 bg-[#E2725B] w-9 h-9 flex items-center justify-center rounded-full">{num}</span>
              <span class="leading-relaxed">{text}</span>
            </li>
          ))}
        </ul>
      </section>
    )}

    <!-- FAQ -->
    <section id="faq">
      <h2 class="font-serif text-2xl font-semibold text-slate-900 mb-6">Questions fréquentes</h2>
      <div class="space-y-4">
        {faqSchema.mainEntity.map((q) => (
          <details class="group border border-slate-200 rounded-2xl overflow-hidden">
            <summary class="flex items-center justify-between px-6 py-4 cursor-pointer select-none text-charcoal font-medium hover:bg-slate-50 transition-colors">
              {q.name}
              <svg class="w-4 h-4 text-slate-400 group-open:rotate-180 transition-transform flex-shrink-0 ml-3" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
            </summary>
            <div class="px-6 pb-5 text-slate-600 leading-relaxed text-sm border-t border-slate-100 pt-4">
              {q.acceptedAnswer.text}
            </div>
          </details>
        ))}
      </div>
    </section>

    <!-- Banner: Itinerary Planner -->
    <section class="relative overflow-hidden rounded-[2.5rem] bg-gradient-to-br from-slate-900 via-slate-950 to-blue-950 px-6 sm:px-10 md:px-14 py-10 md:py-14 shadow-[0_20px_60px_rgba(0,0,0,0.35)]">
      <div class="absolute -top-20 -left-20 w-72 h-72 bg-blue-500/15 rounded-full blur-3xl pointer-events-none"></div>
      <div class="absolute -bottom-20 -right-20 w-72 h-72 bg-amber-500/10 rounded-full blur-3xl pointer-events-none"></div>
      <div class="relative z-10 grid md:grid-cols-[3fr_2fr] md:items-center gap-8">
        <div>
          <span class="inline-block px-4 py-1.5 rounded-full text-xs font-semibold tracking-wide uppercase bg-med-gold/15 text-med-gold border border-med-gold/25 mb-6">Nouveau : Voyage sur Mesure</span>
          <h2 class="text-3xl md:text-4xl font-bold text-white leading-tight mb-2">Concevez votre</h2>
          <p class="font-serif text-3xl md:text-4xl italic text-med-blue mb-5">itinéraire idéal</p>
          <p class="text-white/60 text-base md:text-lg leading-relaxed max-w-xl mb-8">Répondez à quelques questions simples - point de départ, jours et intérêts - et recevez un itinéraire personnalisé avec transports, coûts et horaires.</p>
          <div class="flex flex-wrap gap-6">
            <div class="flex items-center gap-2.5">
              <div class="w-9 h-9 rounded-xl bg-white/5 border border-white/10 flex items-center justify-center">
                <svg class="w-4 h-4 text-med-gold" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
              </div>
              <span class="text-white/50 text-sm">30 secondes pour configurer</span>
            </div>
            <div class="flex items-center gap-2.5">
              <div class="w-9 h-9 rounded-xl bg-white/5 border border-white/10 flex items-center justify-center">
                <svg class="w-4 h-4 text-med-gold" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 6.75V15m6-6v8.25m.503 3.498l4.875-2.437c.381-.19.622-.58.622-1.006V4.82c0-.836-.88-1.38-1.628-1.006l-3.869 1.934c-.317.159-.69.159-1.006 0L9.503 3.252a1.125 1.125 0 00-1.006 0L3.622 5.689C3.24 5.88 3 6.27 3 6.695V19.18c0 .836.88 1.38 1.628 1.006l3.869-1.934c.317-.159.69-.159 1.006 0l4.994 2.497c.317.158.69.158 1.006 0z"/></svg>
              </div>
              <span class="text-white/50 text-sm">Conseils anti-foule inclus</span>
            </div>
          </div>
        </div>
        <div class="mt-8 md:mt-0 md:flex md:justify-center">
          <a href="/fr-fr/planificateur-itineraire/" class="inline-flex items-center gap-2.5 px-7 py-3.5 bg-gradient-to-r from-med-gold to-yellow-600 text-slate-900 font-bold rounded-xl hover:shadow-[0_0_30px_rgba(212,175,55,0.4)] hover:scale-105 transition-all duration-300">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 2L2 12l4 0 0 6 4 0 0-4 4 0 0 4 4 0 0-6 4 0L12 2z"/></svg>
            Configurer maintenant
          </a>
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="bg-gradient-to-r from-med-blue to-med-blue/80 rounded-2xl p-10 text-center text-white">
      <h2 class="font-serif text-3xl font-bold mb-3">Prêt à partir ?</h2>
      <p class="text-white/90 mb-6 max-w-2xl mx-auto">
        Lisez le guide complet des transports publics de la Côte Amalfitaine : comment y aller, horaires, billets et astuces pour économiser.
      </p>
      <a href="/fr-fr/guide/comment-venir/" class="inline-block bg-white text-med-blue font-semibold px-8 py-3 rounded-full hover:bg-slate-100 transition-colors">
        Guide des transports →
      </a>
    </section>

  </div>

</BaseLayout>
