---
import BaseLayout from '../../../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../../../components/Breadcrumbs.astro';

const lang = 'fr-fr';

const breadcrumbs = [
  { name: 'Home', url: '/fr-fr/' },
  { name: 'Planification', url: '/fr-fr/planification/' },
  { name: 'Côte Amalfitaine depuis Naples', url: '/fr-fr/itineraires/1-jour/cote-amalfitaine-depuis-naples/' },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Comment rejoindre la Côte Amalfitaine depuis Naples en une journée ?",
      "acceptedAnswer": { "@type": "Answer", "text": "Le trajet le plus pratique est : train Naples→Salerne (40 min, Trenitalia/Italo), puis ferry Travelmar Salerne→Amalfi (45 min, saisonnier avr-oct) ou bus SITA depuis Salerne. Autre option : train Naples→Sorrente (Circumvésuvienne, 70 min) et bus SITA Sorrente→Amalfi (90 min)." }
    },
    {
      "@type": "Question",
      "name": "Que voir en une journée sur la Côte Amalfitaine au départ de Naples ?",
      "acceptedAnswer": { "@type": "Answer", "text": "Avec une seule journée : arrivez à Amalfi (Cathédrale, centre historique, 2h), puis Ravello en bus (25 min, Villa Rufolo et panoramas, 1h30), puis revenez à Amalfi et prenez le bus pour Positano (45 min, promenade et plage, 1h30). Retour depuis Positano en bus ou en ferry." }
    },
    {
      "@type": "Question",
      "name": "À quelle heure partir de Naples pour la Côte Amalfitaine ?",
      "acceptedAnswer": { "@type": "Answer", "text": "Partez de Naples avant 7h30-8h00. Le train de 7h45 arrive à Salerne à 8h25 ; le ferry Travelmar part vers 9h00 et arrive à Amalfi avant 10h00. Cela vous donne 8 à 9 heures de visite avant le retour." }
    }
  ]
};

const destinations = [
  { name: 'Amalfi', url: '/fr-fr/cote-amalfitaine/amalfi/' },
  { name: 'Ravello', url: '/fr-fr/cote-amalfitaine/ravello/' },
  { name: 'Positano', url: '/fr-fr/cote-amalfitaine/positano/' },
  { name: 'Spiaggia Grande Positano', url: '/fr-fr/plages/cote-amalfitaine/spiaggia-grande-positano/' },
  { name: 'Praiano', url: '/fr-fr/cote-amalfitaine/praiano/' },
  { name: 'Sorrente', url: '/fr-fr/peninsule-sorrentine/sorrento/' },
];

const destinationHighlights = destinations.map(d => ({ name: d.name, desc: '', url: d.url }));

const schedule = [
  { time: '07:45', place: 'Naples Centrale', action: 'Train pour Salerne (Trenitalia/Italo, 40 min, ~€5-12)', transport: 'train' },
  { time: '09:00', place: 'Salerne', action: 'Ferry Travelmar pour Amalfi (45 min, ~€8, saisonnier avr-oct)', transport: 'ferry' },
  { time: '09:45', place: 'Amalfi', action: 'Cathédrale Sant\'Andrea, Cloître du Paradis, corso et centre historique (2h)', transport: 'visit' },
  { time: '12:00', place: 'Amalfi → Ravello', action: 'Bus SITA local pour Ravello (25 min, ~€1,50). Déjeuner en place.', transport: 'bus' },
  { time: '13:30', place: 'Ravello', action: 'Villa Rufolo, belvédère, Villa Cimbrone (1h30)', transport: 'visit' },
  { time: '15:15', place: 'Ravello → Amalfi → Positano', action: 'Bus pour Amalfi (25 min), puis bus SITA pour Positano (45 min)', transport: 'bus' },
  { time: '16:30', place: 'Positano', action: 'Promenade via Cristoforo Colombo, Grande Plage, apéritif (1h30)', transport: 'visit' },
  { time: '18:30', place: 'Positano → Naples', action: 'Bus SITA pour Sorrente (50 min), puis Circumvésuvienne pour Naples (70 min)', transport: 'bus' },
];

const tips = [
  'Le ferry Travelmar depuis Salerne est saisonnier (avr-oct) : en hiver, prenez le bus SITA depuis Salerne.',
  'Achetez le billet de bus SITA dans un bureau de tabac avant de monter - il ne se vend pas à bord.',
  'En juillet-août, le bus Amalfi→Positano peut prendre 1h30 au lieu de 45 min : prévoyez une marge.',
  'Ravello vaut le détour : la Villa Rufolo (€7) est l\'un des plus beaux belvédères de la Côte.',
  'Le retour depuis Positano en bus SITA est plus lent (virages + trafic) - comptez au moins 1h pour Sorrente.',
];

const transportBadge: Record<string, { label: string; cls: string }> = {
  train: { label: 'TRAIN', cls: 'bg-orange-100 text-orange-700' },
  ferry: { label: 'FERRY', cls: 'bg-blue-100 text-blue-700' },
  bus:   { label: 'BUS', cls: 'bg-green-100 text-green-700' },
  walk:  { label: 'À PIED', cls: 'bg-gray-100 text-slate-500' },
  visit: { label: '', cls: '' },
};
---

<BaseLayout
  title="Côte Amalfitaine en 1 Jour depuis Naples 2026 | Itinéraire Complet"
  description="Itinéraire d'une journée sur la Côte Amalfitaine depuis Naples : Amalfi, Ravello et Positano par train, ferry et bus SITA. Horaires, tarifs et conseils."
  lang={lang}
  breadcrumbs={breadcrumbs}
  schema={[faqSchema]}
 pageKey="cote-amalfitaine-depuis-naples">

  <section class="relative bg-charcoal overflow-hidden min-h-[70vh] sm:min-h-[75vh] flex items-center justify-center">
    <img src="/images/costiera-hero.jpg" alt="Côte Amalfitaine depuis Naples" class="absolute inset-0 w-full h-full object-cover opacity-30" loading="eager" referrerpolicy="no-referrer"/>
    <div class="absolute inset-0 bg-gradient-to-b from-black/20 via-black/40 to-black/80"></div>
    <div class="relative max-w-editorial mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <div class="max-w-3xl mx-auto">
        <p class="text-med-gold text-xs sm:text-sm font-medium uppercase tracking-[0.3em] mb-3">Itinéraire · 1 jour</p>
        <h1 class="font-serif text-display text-white mb-4">Côte Amalfitaine depuis Naples</h1>
        <p class="text-xl text-white/80 leading-relaxed max-w-2xl mx-auto">
          Amalfi, Ravello et Positano sans voiture en une journée : train, ferry, bus.
        </p>
      </div>
    </div>
    <Breadcrumbs breadcrumbs={breadcrumbs} />
  </section>

  <div class="max-w-editorial mx-auto px-4 sm:px-6 lg:px-8 pt-6 pb-10 space-y-10">

    <section class="text-center mb-2">
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-2 sm:gap-4 mb-6 overflow-x-auto snap-x snap-mandatory sm:overflow-visible pb-2 sm:pb-0">
        <div class="w-full bg-slate-900 rounded-2xl p-4 sm:p-6 hover:shadow-md transition-shadow flex flex-col items-center justify-center aspect-square snap-start">
          <svg class="w-8 h-8 text-med-gold mb-3" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg>
          <p class="text-xs text-white/60 font-semibold uppercase tracking-wide mb-2">Durée</p>
          <p class="font-serif text-lg font-semibold text-med-gold">1 jour</p>
        </div>
        <div class="w-full bg-slate-900 rounded-2xl p-4 sm:p-6 hover:shadow-md transition-shadow flex flex-col items-center justify-center aspect-square snap-start">
          <svg class="w-8 h-8 text-med-gold mb-3" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
          <p class="text-xs text-white/60 font-semibold uppercase tracking-wide mb-2">Point de départ</p>
          <p class="font-serif text-lg font-semibold text-med-gold">Naples</p>
        </div>
        <div class="w-full bg-slate-900 rounded-2xl p-4 sm:p-6 hover:shadow-md transition-shadow flex flex-col items-center justify-center aspect-square snap-start">
          <svg class="w-8 h-8 text-med-gold mb-3" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M6 9l6-6 6 6M5 9v9a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V9M9 14h6"/></svg>
          <p class="text-xs text-white/60 font-semibold uppercase tracking-wide mb-2">Transports</p>
          <p class="font-serif text-lg font-semibold text-med-gold">Train + ferry<br/>+ bus local</p>
        </div>
        <div class="w-full bg-slate-900 rounded-2xl p-4 sm:p-6 hover:shadow-md transition-shadow flex flex-col items-center justify-center aspect-square snap-start">
          <svg class="w-8 h-8 text-med-gold mb-3" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><circle cx="12" cy="12" r="1"/><path d="M12 1v6M12 17v6M4.22 4.22l4.24 4.24M15.54 15.54l4.24 4.24M1 12h6M17 12h6M4.22 19.78l4.24-4.24M15.54 8.46l4.24-4.24"/></svg>
          <p class="text-xs text-white/60 font-semibold uppercase tracking-wide mb-2">Budget transports</p>
          <p class="font-serif text-lg font-semibold text-med-gold">€25–40<br/><span class="text-xs">p.p.</span></p>
        </div>
      </div>

      <div>
        <p class="text-lg text-slate-700 leading-relaxed">
          Une excursion d'une journée sur la <strong>Côte Amalfitaine</strong> depuis <strong>Naples</strong> : prenez le train pour <strong>Salerne</strong>, puis le <strong>ferry Travelmar</strong> pour <strong>Amalfi</strong>. Visitez la Cathédrale et le centre historique, montez à <strong>Ravello</strong> pour les vues spectaculaires de Villa Rufolo, puis descendez à <strong>Positano</strong> pour une promenade et la mer. Retour via Sorrente. <strong>Budget transports : €25–40</strong>.
        </p>
      </div>
    </section>

    <section>
      <h2 class="font-serif text-2xl font-semibold text-slate-900 mb-8">Programme de la journée</h2>
      <div class="bg-white border border-slate-200 rounded-2xl overflow-hidden">
        <div class="px-6 py-8 space-y-6">
          {schedule.map((item, idx) => {
            const badge = transportBadge[item.transport];
            const isLastItem = idx === schedule.length - 1;
            return (
              <div class="flex gap-4">
                <div class="flex flex-col items-center flex-shrink-0">
                  <div class="w-16 bg-slate-900 text-med-gold rounded-full px-2 py-1 text-center text-sm font-semibold flex items-center justify-center">{item.time}</div>
                  {!isLastItem && <div class="w-0.5 h-12 bg-med-blue/30 mt-2"></div>}
                </div>
                <div class="pb-4 flex-1">
                  <p class="font-semibold text-slate-900 mb-1">{item.place}</p>
                  <p class="text-slate-700 text-sm mb-2" set:html={item.action} />
                  {badge.label && <span class={`text-xs font-semibold px-2 py-1 rounded-full ${badge.cls}`}>{badge.label}</span>}
                </div>
              </div>
            );
          })}
        </div>
      </div>
    </section>

    <section>
      <h2 class="font-serif text-2xl font-semibold text-slate-900 mb-8">Destinations de l'itinéraire</h2>
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4">
        {destinationHighlights.map((dest) => (
          <a href={dest.url} class="group block bg-white border border-slate-200 rounded-2xl p-5 hover:shadow-lg hover:border-med-blue/30 transition-all">
            <h3 class="font-semibold text-charcoal mb-2 group-hover:text-med-blue transition-colors">{dest.name}</h3>
            <p class="text-xs text-slate-500 leading-relaxed mb-3">{dest.desc}</p>
            <span class="text-xs font-semibold text-med-blue inline-flex items-center gap-1 group-hover:gap-2 transition-all">Découvrir →</span>
          </a>
        ))}
      </div>
    </section>

    <section class="bg-med-cream border border-med-gold/20 rounded-[2rem] p-6">
      <h2 class="font-serif text-xl font-semibold text-charcoal mb-6">Conseils pratiques</h2>
      <ul class="space-y-4">
        {tips.map((text, idx) => {
          const nums = ['❶', '❷', '❸', '❹', '❺'];
          return (
            <li class="flex items-start gap-4 text-sm text-charcoal">
              <span class="text-2xl font-bold text-white flex-shrink-0 leading-none mt-0.5 bg-[#E2725B] w-9 h-9 flex items-center justify-center rounded-full">{nums[idx] || '•'}</span>
              <span class="leading-relaxed" set:html={text} />
            </li>
          );
        })}
      </ul>
    </section>

    <section id="faq">
      <h2 class="font-serif text-2xl font-semibold text-slate-900 mb-6">Questions fréquemment posées</h2>
      <div class="space-y-4">
        {faqSchema.mainEntity.map((q) => (
          <details class="group border border-slate-200 rounded-2xl overflow-hidden">
            <summary class="flex items-center justify-between px-6 py-4 cursor-pointer select-none text-charcoal font-medium hover:bg-slate-50 transition-colors">
              {q.name}
              <svg class="w-4 h-4 text-slate-400 group-open:rotate-180 transition-transform flex-shrink-0 ml-3" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
            </summary>
            <div class="px-6 pb-5 text-slate-600 leading-relaxed text-sm border-t border-slate-100 pt-4">{q.acceptedAnswer.text}</div>
          </details>
        ))}
      </div>
    </section>

    <section class="bg-gradient-to-r from-med-blue to-med-blue/80 rounded-2xl p-10 text-center text-white">
      <h2 class="font-serif text-3xl font-bold mb-3">Découvrez la Côte Amalfitaine</h2>
      <p class="text-white/90 mb-6 max-w-2xl mx-auto">Lire le guide complet des transports de la Côte Amalfitaine : ferries, bus SITA, horaires et conseils pour économiser.</p>
      <a href="/fr-fr/guide/ferries/" class="inline-block bg-white text-med-blue font-semibold px-8 py-3 rounded-full hover:bg-slate-100 transition-colors">Guide des ferries →</a>
    </section>

  </div>

</BaseLayout>
