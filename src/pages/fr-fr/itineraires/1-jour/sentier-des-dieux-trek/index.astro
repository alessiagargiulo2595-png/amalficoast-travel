---
import BaseLayout from '../../../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../../../components/Breadcrumbs.astro';

const lang = 'fr-fr';

const breadcrumbs = [
  { name: 'Home', url: '/fr-fr/' },
  { name: 'Planification', url: '/fr-fr/planification/' },
  { name: 'Trek Sentier des Dieux', url: '/fr-fr/itineraires/1-jour/sentier-des-dieux-trek/' },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Comment organiser le Sentier des Dieux en une journée depuis Naples ?",
      "acceptedAnswer": { "@type": "Answer", "text": "Partez de Naples avec la Circumvésuvienne jusqu'à Sorrente (70 min), puis bus SITA pour Amalfi (90 min), puis bus local pour Agerola (45 min). Le sentier Agerola→Nocelle fait 8 km, 3-4h. Depuis Nocelle, bus local pour Positano (15 min), puis bus SITA ou ferry pour Sorrente et Circumvésuvienne pour Naples." }
    },
    {
      "@type": "Question",
      "name": "Faut-il réserver pour le Sentier des Dieux ?",
      "acceptedAnswer": { "@type": "Answer", "text": "En haute saison (juillet-août), le Sentier des Dieux nécessite une réservation obligatoire sur le portail du Parc des Monts Lattari. Le coût est symbolique (~€5). Hors saison, aucune réservation n'est requise. Vérifiez toujours les conditions sur le site officiel avant de partir." }
    },
    {
      "@type": "Question",
      "name": "Que faut-il emporter pour le Sentier des Dieux ?",
      "acceptedAnswer": { "@type": "Answer", "text": "Obligatoire : chaussures de randonnée (pas de sandales ni baskets lisses), au moins 1,5 L d'eau, protection solaire, chapeau. Le sentier n'a ni fontaines ni boutiques. Emportez un en-cas. Au printemps/automne, une veste légère est conseillée pour le vent en altitude." }
    }
  ]
};

const schedule = [
  { time: '07:00', place: 'Naples', action: 'Circumvésuvienne pour Sorrente (70 min, ~€3,90)', transport: 'train' },
  { time: '08:15', place: 'Sorrente', action: 'Bus SITA pour Amalfi (90 min, ~€3,50€) - départ 8h30', transport: 'bus' },
  { time: '10:00', place: 'Amalfi', action: 'Bus local pour Agerola, hameau San Lazzaro (45 min, ~€1,50). Début du sentier.', transport: 'bus' },
  { time: '11:00', place: 'Agerola (618 m)', action: 'Départ Sentier des Dieux. 8 km, ~500 m de descente, EE. Paysages à couper le souffle.', transport: 'walk' },
  { time: '14:30', place: 'Nocelle', action: 'Arrivée à Nocelle. Pause et déjeuner dans l\'un des refuges/bars locaux.', transport: 'visit' },
  { time: '15:15', place: 'Nocelle → Positano', action: 'Bus local pour Positano centre (15 min, ~€1,50) ou à pied (~1 000 marches, 45 min)', transport: 'bus' },
  { time: '16:00', place: 'Positano', action: 'Promenade, glace, plage (1h libre)', transport: 'visit' },
  { time: '17:15', place: 'Positano → Naples', action: 'Bus SITA pour Sorrente (~50 min), puis Circumvésuvienne pour Naples (70 min)', transport: 'bus' },
];

const tips = [
  'Saison idéale : avril-juin et septembre-octobre. Juillet-août est très chaud et très fréquenté.',
  'Le bus d\'Amalfi pour Agerola a des horaires limités : vérifiez sur eavsrl.it la veille au soir.',
  'Partez toujours dans le sens Agerola→Nocelle : presque tout en descente, balisage conçu dans ce sens.',
  'Le sentier n\'a pas de points d\'eau : emportez au moins 1,5 L. Le dernier bar est à Agerola avant le départ.',
  'Depuis Nocelle on descend à Positano à pied (~1 000 marches, 45 min) ou en bus (15 min, ~€1,50).',
];

const transportBadge: Record<string, { label: string; cls: string }> = {
  train: { label: 'TRAIN', cls: 'bg-orange-100 text-orange-700' },
  ferry: { label: 'FERRY', cls: 'bg-blue-100 text-blue-700' },
  bus:   { label: 'BUS', cls: 'bg-green-100 text-green-700' },
  walk:  { label: 'TREKKING', cls: 'bg-red-100 text-red-700' },
  visit: { label: '', cls: '' },
};

const destinationHighlights = [
  { name: 'Agerola', desc: 'Village de montagne (618 m) avec point de départ du Sentier des Dieux', url: '/fr-fr/cote-amalfitaine/agerola/' },
  { name: 'Positano', desc: 'Village pittoresque avec maisons colorées, plage et galeries d\'art', url: '/fr-fr/cote-amalfitaine/positano/' },
];
---

<BaseLayout
  title="Sentier des Dieux en 1 Jour depuis Naples 2026 | Itinéraire de Trekking"
  description="Le Sentier des Dieux (Agerola–Nocelle) en une journée depuis Naples : horaires, transports, réservation et conseils. 8 km de trekking avec vue sur la Côte Amalfitaine."
  lang={lang}
  breadcrumbs={breadcrumbs}
  schema={[faqSchema]}
  pageKey="sentier-des-dieux-trek"
>

  <!-- Hero Section -->
  <section class="relative bg-charcoal overflow-hidden min-h-[70vh] sm:min-h-[75vh] flex items-center justify-center">
    <img src="/images/trekking-hero.jpg" alt="Sentier des Dieux, Côte Amalfitaine" class="absolute inset-0 w-full h-full object-cover opacity-30" loading="eager" referrerpolicy="no-referrer"/>
    <div class="absolute inset-0 bg-gradient-to-b from-black/20 via-black/40 to-black/80"></div>
    <div class="relative max-w-editorial mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <div class="max-w-3xl mx-auto">
        <p class="text-med-gold text-xs sm:text-sm font-medium uppercase tracking-[0.3em] mb-3">Itinéraire · Trekking · 1 jour</p>
        <h1 class="font-serif text-display text-white mb-4">Trek Sentier des Dieux</h1>
        <p class="text-xl text-white/80 leading-relaxed max-w-2xl mx-auto">
          Sentier des Dieux : trois heures et demie de trekking entre Positano et Praiano.
        </p>
      </div>
    </div>
    <Breadcrumbs breadcrumbs={breadcrumbs} />
  </section>

  <div class="max-w-editorial mx-auto px-4 sm:px-6 lg:px-8 pt-6 pb-10 space-y-10">

    <!-- Intro & Stats Section - Featured -->
    <section class="text-center mb-2">
      <!-- Quick Stats Grid - 4 columns for Trekking -->
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-2 sm:gap-4 mb-6 overflow-x-auto snap-x snap-mandatory sm:overflow-visible pb-2 sm:pb-0">
        <div class="w-full bg-slate-900 rounded-2xl p-4 sm:p-6 hover:shadow-md transition-shadow flex flex-col items-center justify-center aspect-square snap-start">
          <svg class="w-8 h-8 text-med-gold mb-3" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
            <path d="M3 12h18M3 12l4-4M3 12l4 4"/>
          </svg>
          <p class="text-xs text-white/60 font-semibold uppercase tracking-wide mb-2">Distance</p>
          <p class="font-serif text-lg font-semibold text-med-gold">8 km</p>
        </div>
        <div class="w-full bg-slate-900 rounded-2xl p-4 sm:p-6 hover:shadow-md transition-shadow flex flex-col items-center justify-center aspect-square snap-start">
          <svg class="w-8 h-8 text-med-gold mb-3" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
            <polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/>
          </svg>
          <p class="text-xs text-white/60 font-semibold uppercase tracking-wide mb-2">Dénivelé</p>
          <p class="font-serif text-lg font-semibold text-med-gold">~500 m ↓</p>
        </div>
        <div class="w-full bg-slate-900 rounded-2xl p-4 sm:p-6 hover:shadow-md transition-shadow flex flex-col items-center justify-center aspect-square snap-start">
          <svg class="w-8 h-8 text-med-gold mb-3" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
            <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/>
            <line x1="12" y1="9" x2="12" y2="13"/>
            <line x1="12" y1="17" x2="12.01" y2="17"/>
          </svg>
          <p class="text-xs text-white/60 font-semibold uppercase tracking-wide mb-2">Difficulté</p>
          <p class="font-serif text-lg font-semibold text-med-gold">EE</p>
        </div>
        <div class="w-full bg-slate-900 rounded-2xl p-4 sm:p-6 hover:shadow-md transition-shadow flex flex-col items-center justify-center aspect-square snap-start">
          <svg class="w-8 h-8 text-med-gold mb-3" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
            <circle cx="12" cy="12" r="1"/>
            <path d="M12 1v6M12 17v6M4.22 4.22l4.24 4.24M15.54 15.54l4.24 4.24M1 12h6M17 12h6M4.22 19.78l4.24-4.24M15.54 8.46l4.24-4.24"/>
          </svg>
          <p class="text-xs text-white/60 font-semibold uppercase tracking-wide mb-2">Budget transports</p>
          <p class="font-serif text-lg font-semibold text-med-gold">€12–18<br/><span class="text-xs">p.p.</span></p>
        </div>
      </div>

      <!-- Warning Banner -->
      <div class="mb-6 bg-red-50 border border-red-200 rounded-2xl px-5 py-4">
        <p class="font-semibold text-red-800 text-xs sm:text-sm">Réservation obligatoire juillet-août - Parc des Monts Lattari (~€5)</p>
      </div>

      <!-- SEO Text Below -->
      <div>
        <p class="text-lg text-slate-700 leading-relaxed">
          Le <strong>Sentier des Dieux</strong> est une <strong>randonnée de 8 km</strong> avec des vues spectaculaires sur la <strong>Côte Amalfitaine</strong>. <strong>3–4 heures</strong> d'<strong>Agerola à Nocelle</strong> avec <strong>500 m de descente</strong> (difficulté EE). Accessible depuis Naples en train et bus. <strong>Budget: €12–18 pour les transports</strong>.
        </p>
      </div>
    </section>


    <!-- Day by Day Itinerary -->
    <section>
      <h2 class="font-serif text-2xl font-semibold text-slate-900 mb-8">Programme de la journée</h2>
      <div class="bg-white border border-slate-200 rounded-2xl overflow-hidden">
        <div class="px-6 py-8 space-y-6">
          {schedule.map((item, idx) => {
            const badge = transportBadge[item.transport];
            const isLastItem = idx === schedule.length - 1;
            return (
              <div class="flex gap-4">
                <div class="flex flex-col items-center flex-shrink-0">
                  <div class="w-16 bg-slate-900 text-med-gold rounded-full px-2 py-1 text-center text-sm font-semibold flex items-center justify-center">
                    {item.time}
                  </div>
                  {!isLastItem && <div class="w-0.5 h-12 bg-med-blue/30 mt-2"></div>}
                </div>
                <div class="pb-4 flex-1">
                  <p class="font-semibold text-slate-900 mb-1">{item.place}</p>
                  <p class="text-slate-700 text-sm mb-2">{item.action}</p>
                  {badge.label && (
                    <span class={`text-xs font-semibold px-2 py-1 rounded-full ${badge.cls}`}>
                      {badge.label}
                    </span>
                  )}
                </div>
              </div>
            );
          })}
        </div>
      </div>
    </section>

    <!-- Destinations Highlighted -->
    <section>
      <h2 class="font-serif text-2xl font-semibold text-slate-900 mb-8">Destinations de l'itinéraire</h2>
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4">
        {destinationHighlights.map((dest) => (
          <a href={dest.url} class="group block bg-white border border-slate-200 rounded-2xl p-5 hover:shadow-lg hover:border-med-blue/30 transition-all">
            <h3 class="font-semibold text-charcoal mb-2 group-hover:text-med-blue transition-colors">{dest.name}</h3>
            <p class="text-xs text-slate-500 leading-relaxed mb-3">{dest.desc}</p>
            <span class="text-xs font-semibold text-med-blue inline-flex items-center gap-1 group-hover:gap-2 transition-all">
              Découvrez →
            </span>
          </a>
        ))}
      </div>
    </section>

    <!-- Planning Tips -->
    <section class="bg-med-cream border border-med-gold/20 rounded-[2rem] p-6">
      <h2 class="font-serif text-xl font-semibold text-charcoal mb-6">Conseils pratiques</h2>
      <ul class="space-y-4">
        {tips.map((text, idx) => {
          const nums = ['❶', '❷', '❸', '❹', '❺'];
          return (
            <li class="flex items-start gap-4 text-sm text-charcoal">
              <span class="text-2xl font-bold text-white flex-shrink-0 leading-none mt-0.5 bg-[#E2725B] w-9 h-9 flex items-center justify-center rounded-full">{nums[idx] || '•'}</span>
              <span class="leading-relaxed">{text}</span>
            </li>
          );
        })}
      </ul>
    </section>

    <!-- FAQ -->
    <section id="faq">
      <h2 class="font-serif text-2xl font-semibold text-slate-900 mb-6">Questions fréquemment posées</h2>
      <div class="space-y-4">
        {faqSchema.mainEntity.map((q) => (
          <details class="group border border-slate-200 rounded-2xl overflow-hidden">
            <summary class="flex items-center justify-between px-6 py-4 cursor-pointer select-none text-charcoal font-medium hover:bg-slate-50 transition-colors">
              {q.name}
              <svg class="w-4 h-4 text-slate-400 group-open:rotate-180 transition-transform flex-shrink-0 ml-3" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
            </summary>
            <div class="px-6 pb-5 text-slate-600 leading-relaxed text-sm border-t border-slate-100 pt-4">
              {q.acceptedAnswer.text}
            </div>
          </details>
        ))}
      </div>
    </section>

    <!-- CTA -->
    <section class="bg-gradient-to-r from-med-blue to-med-blue/80 rounded-2xl p-10 text-center text-white">
      <h2 class="font-serif text-3xl font-bold mb-3">Planifiez votre aventure de trekking</h2>
      <p class="text-white/90 mb-6 max-w-2xl mx-auto">
        Guide complet du Sentier des Dieux : réservation, équipement, meilleure saison et comment venir depuis Naples.
      </p>
      <a href="/fr-fr/guida/sentieri/" class="inline-block bg-white text-med-blue font-semibold px-8 py-3 rounded-full hover:bg-slate-100 transition-colors">
        Guide des sentiers →
      </a>
    </section>

  </div>

</BaseLayout>
