---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import CorrelationSlider from '../../../../components/CorrelationSlider.astro';
import Breadcrumbs from '../../../../components/Breadcrumbs.astro';

const lang = 'fr-fr';

const breadcrumbs = [
  { name: 'Accueil', url: '/fr-fr/' },
  { name: 'Côte Amalfitaine', url: '/fr-fr/cote-amalfitaine/' },
  { name: 'Agerola', url: '/fr-fr/cote-amalfitaine/agerola/' },
];

const touristAttractionSchema = {
  "@context": "https://schema.org",
  "@type": "TouristAttraction",
  "name": "Agerola",
  "description": "Agerola est le balcon vert de la Côte Amalfitaine, point de départ du Sentier des Dieux et patrie du Fior di Latte. À 600 m d'altitude, elle offre randonnée, air frais et panoramas à couper le souffle.",
  "url": "https://amalficoast-travel.com/fr-fr/cote-amalfitaine/agerola/",
  "touristType": ["Randonnée", "Nature", "Gastronomie", "Panoramas"],
  "address": { "@type": "PostalAddress", "addressLocality": "Agerola", "addressRegion": "Naples", "addressCountry": "IT", "postalCode": "80051" },
  "geo": { "@type": "GeoCoordinates", "latitude": 40.6383, "longitude": 14.5417 }
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Comment se rendre à Agerola ?",
      "acceptedAnswer": { "@type": "Answer", "text": "En bus SITA depuis Amalfi (environ 40 min) ou depuis Castellammare di Stabia/Gragnano (environ 30 min). En voiture depuis Naples : autoroute A3, sortie Castellammare di Stabia, puis SS366 vers Agerola. Parking disponible à Bomerano et San Lazzaro." }
    },
    {
      "@type": "Question",
      "name": "Le Sentier des Dieux part-il d'Agerola ?",
      "acceptedAnswer": { "@type": "Answer", "text": "Oui, le parcours classique part de Bomerano (hameau d'Agerola) et arrive à Nocelle au-dessus de Positano, environ 7,8 km, 3-4 heures de marche. Le sentier est classé difficulté moyenne. À éviter par temps de pluie ou de brouillard épais." }
    },
    {
      "@type": "Question",
      "name": "Qu'est-ce que le Fior di Latte d'Agerola ?",
      "acceptedAnswer": { "@type": "Answer", "text": "C'est une mozzarella fraîche à pâte filée produite avec le lait des vaches d'Agerola élevées en altitude. Elle a une saveur délicate et une texture moelleuse unique. Chaque fromagerie d'Agerola a sa propre version : le meilleur moyen de la goûter est de l'acheter directement au producteur." }
    },
    {
      "@type": "Question",
      "name": "Agerola convient-elle aux familles ?",
      "acceptedAnswer": { "@type": "Answer", "text": "Oui, l'altitude (600 m) rend le climat frais même en été. Il y a des sentiers faciles, des parcs de jeux, des agritourismes avec animaux et des fromageries visitables. C'est une alternative parfaite à la chaleur de la côte pour une journée différente." }
    },
    {
      "@type": "Question",
      "name": "Que manger à Agerola ?",
      "acceptedAnswer": { "@type": "Answer", "text": "Le Fior di Latte et les produits laitiers sont le point fort. À essayer aussi : les fusilli au ragù de lapin, la pizza au Fior di Latte local, les desserts à base de ricotta et les fromages affinés. Les agritourismes proposent des menus complets à prix raisonnables." }
    }
  ]
};

const schemas = [touristAttractionSchema, faqSchema];

const fastFacts = [
  { dt: 'Emplacement', dd: 'Monti Lattari, NA' },
  { dt: 'Altitude', dd: '~600 m' },
  { dt: 'Population', dd: '~7 500 habitants' },
  { dt: 'Hameaux', dd: 'Bomerano, San Lazzaro, Pianillo' },
  { dt: 'Depuis Amalfi', dd: '40 min (bus SITA)' },
  { dt: 'Sentier des Dieux', dd: 'Départ à Bomerano' },
  { dt: 'Spécialités', dd: 'Fior di Latte, fromages' },
  { dt: 'Meilleure période', dd: 'Avr-Oct (randonnée)' },
  { dt: 'Idéal pour', dd: 'Randonnée, familles, foodies' },
];

const tips = [
  'Partez tôt sur le Sentier des Dieux (avant 8h) : vous aurez le sentier presque pour vous et la meilleure lumière pour les photos.',
  'Achetez le Fior di Latte directement dans les fromageries de San Lazzaro : moins cher et encore tiède, tout juste fait.',
  'Si le Sentier des Dieux vous semble trop fréquenté, essayez le Sentier des Tre Calli ou le sentier vers la Grotte de Santa Barbara.',
  'En été Agerola est 8 à 10 degrés plus fraîche que la côte : emportez une veste légère même en août.',
];
---

<BaseLayout
  title="Agerola 2026 : Sentier des Dieux, Fior di Latte et Randonnée"
  description="Guide complet d'Agerola : point de départ du Sentier des Dieux, patrie du Fior di Latte, randonnée sur les Monti Lattari et panoramas sur la Côte Amalfitaine à 600 m d'altitude."
  lang={lang}
  breadcrumbs={breadcrumbs}
  schema={schemas}
  pageKey="agerola"

  heroImage="/images/agerola-hero.webp"
>

  <!-- Hero -->
  <section class="relative h-[75vh] sm:h-[90vh] flex items-center bg-charcoal overflow-hidden">
    <img src="/images/agerola-hero.webp" alt="Agerola, le balcon vert de la Côte Amalfitaine" class="absolute inset-0 w-full h-full object-cover" loading="eager" fetchpriority="high" decoding="sync" referrerpolicy="no-referrer"/>
    <div class="absolute inset-0 bg-gradient-to-b from-black/10 via-black/40 to-black/80 z-10"></div>
    <div class="relative z-20 max-w-editorial mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <p class="text-med-gold text-xs sm:text-sm font-medium uppercase tracking-[0.3em] mb-3">Monti Lattari — 600 m d'altitude</p>
        <h1 class="font-serif text-display text-white mb-4">Agerola</h1>
        <p class="text-xl text-white/80 leading-relaxed max-w-2xl">
          Le balcon vert de la Côte. Départ du Sentier des Dieux, patrie du Fior di Latte et des panoramas les plus vertigineux de la région.
        </p>
        <div class="flex flex-wrap gap-3 mt-8">
          <a href="#fast-facts" class="px-5 py-2.5 bg-med-gold text-white text-xs sm:text-sm font-semibold rounded-full hover:scale-105 hover:shadow-[0_8px_25px_rgba(212,175,55,0.4)] transition-all duration-300">Infos Pratiques</a>
          <a href="#sentier-des-dieux" class="px-5 py-2.5 bg-white/10 backdrop-blur text-white text-xs sm:text-sm font-medium rounded-full border border-white/20 hover:bg-white/20 transition-colors">Sentier des Dieux</a>
          <a href="#faq" class="px-5 py-2.5 bg-white/10 backdrop-blur text-white text-xs sm:text-sm font-medium rounded-full border border-white/20 hover:bg-white/20 transition-colors">FAQ</a>
        </div>
      </div>
    </div>
    <Breadcrumbs breadcrumbs={breadcrumbs} />
  </section>

  <section class="max-w-editorial mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="grid lg:grid-cols-[1fr_320px] gap-12">

      <div class="space-y-16">

        <div class="prose-editorial">
          <p class="text-xl leading-relaxed text-charcoal">
            Agerola est le secret le mieux gardé de la Côte Amalfitaine. À 600 mètres d'altitude, cachée dans les Monti Lattari, cette communauté de bergers et d'agriculteurs offre ce que la côte ne peut pas donner : air frais, silence, sentiers spectaculaires et une tradition fromagère qui remonte au Moyen Âge.
          </p>
          <p class="mt-4 text-slate-600 leading-relaxed">
            C'est d'ici que part le célèbre <strong>Sentier des Dieux</strong>, l'une des plus belles randonnées d'Europe. Mais Agerola n'est pas seulement le point de départ d'un sentier : c'est un monde à part, fait de hameaux épars (Bomerano, San Lazzaro, Pianillo), de fromageries artisanales et de trattorias où l'on mange encore avec les produits du jardin.
          </p>
        </div>

        <!-- Le saviez-vous ? -->
        <div class="bg-slate-900 border border-white/10 rounded-[3rem] p-8">
          <p class="text-[10px] uppercase tracking-[0.3em] text-med-gold font-medium mb-4">Le saviez-vous ?</p>
          <div class="grid sm:grid-cols-3 gap-6">
            <div class="text-center">
              <p class="font-serif text-5xl font-bold text-med-gold">7,8 km</p>
              <p class="text-white/60 text-xs italic mt-1">le Sentier des Dieux, de Bomerano à Nocelle</p>
            </div>
            <div class="text-center">
              <p class="font-serif text-5xl font-bold text-med-gold">600 m</p>
              <p class="text-white/60 text-xs italic mt-1">altitude moyenne, 8-10°C plus frais que la côte</p>
            </div>
            <div class="text-center">
              <p class="font-serif text-5xl font-bold text-med-gold">XIIe s.</p>
              <p class="text-white/60 text-xs italic mt-1">tradition fromagère documentée</p>
            </div>
          </div>
        </div>

        <!-- Le Sentier des Dieux -->
        <div id="sentier-des-dieux">
          <h2 class="font-serif text-3xl font-semibold text-slate-900 mb-6">Le Sentier des Dieux</h2>
          <p class="text-slate-600 text-lg leading-relaxed mb-6">
            La randonnée la plus célèbre de la Côte Amalfitaine, un sentier panoramique creusé dans la roche des Monti Lattari à pic sur la mer.
          </p>
          <div class="bg-white p-6 rounded-2xl border border-slate-100 space-y-4">
            <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
              <div>
                <p class="text-xs text-slate-400 uppercase tracking-wider">Départ</p>
                <p class="font-medium text-charcoal">Bomerano (Agerola)</p>
              </div>
              <div>
                <p class="text-xs text-slate-400 uppercase tracking-wider">Arrivée</p>
                <p class="font-medium text-charcoal">Nocelle (Positano)</p>
              </div>
              <div>
                <p class="text-xs text-slate-400 uppercase tracking-wider">Distance</p>
                <p class="font-medium text-charcoal">~7,8 km</p>
              </div>
              <div>
                <p class="text-xs text-slate-400 uppercase tracking-wider">Durée</p>
                <p class="font-medium text-charcoal">3-4 heures</p>
              </div>
            </div>
            <p class="text-slate-600 text-sm leading-relaxed">
              <strong>Difficulté :</strong> Moyenne. Dénivelé en descente d'environ 600 m. Chaussures de randonnée obligatoires, bâtons conseillés. Emportez au moins 1,5 litre d'eau. <strong>Ne pas parcourir par temps de pluie ou de brouillard.</strong> Depuis Nocelle, on descend à Positano par 1 500 marches ou en bus local.
            </p>
          </div>
        </div>

        <!-- Que voir -->
        <div>
          <h2 class="font-serif text-3xl font-semibold text-slate-900 mb-8">Que voir à Agerola</h2>
          <div class="space-y-8">
            {[
              { n: 1, title: 'Bomerano et le départ du Sentier', text: 'Le hameau le plus connu, avec la petite place d\'où part le Sentier des Dieux. Bar, épiceries et le point d\'information du Parc des Monti Lattari. Depuis ici, le panorama sur Capri et la côte est déjà spectaculaire.' },
              { n: 2, title: 'Fromageries et Fior di Latte', text: 'Le Fior di Latte d\'Agerola est une mozzarella fraîche produite avec le lait des vaches d\'Agerola élevées en altitude. Plusieurs fromageries accueillent les visiteurs pour des dégustations. À essayer aussi la provola fumée et la ricotta fraîche.' },
              { n: 3, title: 'Sentier des Tre Calli', text: 'Alternative moins fréquentée au Sentier des Dieux. Relie Agerola à Positano à travers un parcours qui traverse des forêts de châtaigniers et des terrasses de citronniers. Plus long (5-6 heures) mais tout aussi panoramique.' },
              { n: 4, title: 'Parc Régional des Monti Lattari', text: 'Agerola est au cœur du parc : sentiers balisés, forêts de chênes verts et de châtaigniers, grottes karstiques et une biodiversité unique. Le Centre des Visiteurs de San Lazzaro fournit cartes et informations.' },
              { n: 5, title: 'Grotte de Santa Barbara', text: 'Une grotte karstique accessible lors d\'une excursion d\'environ 2 heures depuis San Lazzaro. À l\'intérieur, stalactites et une atmosphère envoûtante. Visite libre, mais un guide local est recommandé.' },
            ].map(({ n, title, text }) => (
              <div class="grid sm:grid-cols-[auto_1fr] gap-4">
                <div class="w-14 h-14 rounded-[1rem] bg-med-gold/10 flex items-center justify-center flex-shrink-0 text-med-gold font-serif font-bold text-xl">{n}</div>
                <div>
                  <h3 class="font-semibold text-charcoal text-lg mb-1">{title}</h3>
                  <p class="text-slate-600 leading-relaxed">{text}</p>
                </div>
              </div>
            ))}
          </div>
        </div>

        <!-- Conseil Local -->
        <div class="relative overflow-hidden rounded-[3rem] bg-med-blue p-10 md:p-14 text-white shadow-2xl">
          <div class="relative z-10 flex flex-col md:flex-row items-start md:items-center gap-8">
            <div class="w-20 h-20 rounded-2xl bg-white/10 flex items-center justify-center flex-shrink-0 border border-white/20"><svg class="w-10 h-10 text-med-gold" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 3v2.25m6.364.386-1.591 1.591M21 12h-2.25m-.386 6.364-1.591-1.591M12 18.75V21m-4.773-4.227-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0Z"/></svg></div>
            <div>
              <p class="text-med-gold text-xs font-bold uppercase tracking-[0.3em] mb-2">Conseil Local</p>
              <h3 class="font-serif text-2xl font-bold text-white mb-3 tracking-tight">Fior di Latte de la fromagerie</h3>
              <p class="text-white/70 leading-relaxed">Arrêtez-vous dans une fromagerie de San Lazzaro vers 10h du matin, quand le Fior di Latte sort encore tiède. Achetez-en, ajoutez un peu de pain local et une tomate : le déjeuner parfait avant le sentier.</p>
            </div>
          </div>
          <div class="absolute bottom-0 left-0 translate-y-1/2 -translate-x-1/2 w-80 h-80 bg-med-gold/10 rounded-full blur-3xl pointer-events-none"></div>
        </div>

        <!-- FAQ -->
        <div id="faq">
          <h2 class="font-serif text-3xl font-semibold text-slate-900 mb-8">Questions fréquentes sur Agerola</h2>
          <div class="space-y-4">
            {faqSchema.mainEntity.map((q) => (
              <details class="group border border-slate-200 rounded-2xl overflow-hidden">
                <summary class="flex items-center justify-between px-6 py-4 cursor-pointer select-none text-charcoal font-medium hover:bg-slate-50 transition-colors">
                  {q.name}
                  <svg class="w-4 h-4 text-slate-400 group-open:rotate-180 transition-transform flex-shrink-0 ml-3" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
                </summary>
                <div class="px-6 pb-5 text-slate-600 leading-relaxed text-xs sm:text-sm border-t border-slate-100 pt-4">
                  {q.acceptedAnswer.text}
                </div>
              </details>
            ))}
          </div>
        </div>

      </div>

      <aside class="space-y-6 lg:sticky lg:top-24 self-start">
        <div id="fast-facts" class="bg-slate-900 text-white rounded-[3rem] p-6">
          <p class="text-[10px] uppercase tracking-[0.3em] text-med-gold font-medium mb-4">Infos Pratiques - Agerola</p>
          <dl class="space-y-3">
            {fastFacts.map(({ dt, dd }, i) => (
              <>
                <div class="flex justify-between items-start gap-3">
                  <dt class="text-white/40 text-xs sm:text-sm font-light flex-shrink-0">{dt}</dt>
                  <dd class="text-white font-medium text-xs sm:text-sm text-right">{dd}</dd>
                </div>
                {i < fastFacts.length - 1 && <div class="border-t border-white/5"></div>}
              </>
            ))}
          </dl>
        </div>

        <div class="bg-med-cream border border-med-gold/30 rounded-[2rem] p-6">
          <p class="text-[10px] uppercase tracking-[0.3em] text-med-gold font-medium mb-3">Conseils d'initiés</p>
          <ul class="space-y-3">
            {tips.map(tip => (
              <li class="flex items-start gap-2 text-xs sm:text-sm text-charcoal">
                <span class="w-1.5 h-1.5 rounded-full bg-med-gold mt-1.5 flex-shrink-0"></span>
                <span>{tip}</span>
              </li>
            ))}
          </ul>
        </div>

        <div class="bg-white border border-slate-100 rounded-[2rem] p-6 shadow-sm">
          <p class="text-[10px] uppercase tracking-[0.3em] text-slate-400 font-medium mb-3">Explorer la Côte</p>
          <nav class="space-y-1">
            {[
              { href: '/fr-fr/cote-amalfitaine/furore/', label: 'Furore' },
              { href: '/fr-fr/cote-amalfitaine/praiano/', label: 'Praiano' },
              { href: '/fr-fr/cote-amalfitaine/positano/', label: 'Positano' },
              { href: '/fr-fr/cote-amalfitaine/amalfi/', label: 'Amalfi' },
              { href: '/fr-fr/cote-amalfitaine/tramonti/', label: 'Tramonti' },
            ].map(({ href, label }) => (
              <a href={href} class="flex items-center gap-2 px-3 py-2 rounded-xl text-xs sm:text-sm text-charcoal hover:bg-med-blue/5 hover:text-med-blue transition-colors">
                <span class="w-1.5 h-1.5 rounded-full bg-med-blue/30"></span> {label}
              </a>
            ))}
          </nav>
        </div>
      </aside>

    </div>
  </section>

  <CorrelationSlider
    heading="Explorer aussi sur la Côte Amalfitaine"
    items={[
      { name: 'Furore',   href: '/fr-fr/cote-amalfitaine/furore/',   tag: 'Le village qui n\'existe pas', desc: 'Le Fjord spectaculaire et le village peint sans centre.' },
      { name: 'Praiano',  href: '/fr-fr/cote-amalfitaine/praiano/',  tag: 'Coucher de soleil & Calme',   desc: 'Le coucher de soleil depuis San Gennaro et la marina tranquille.' },
      { name: 'Positano', href: '/fr-fr/cote-amalfitaine/positano/', tag: 'Mode & Vues',                  desc: 'Les maisons colorées perchées sur la mer et la plage Fornillo.' },
      { name: 'Tramonti', href: '/fr-fr/cote-amalfitaine/tramonti/', tag: 'Arrière-pays & Vin',           desc: 'Le poumon vert de la Côte, terre de vins et de traditions.' },
      { name: 'Amalfi',   href: '/fr-fr/cote-amalfitaine/amalfi/',   tag: 'République Maritime',         desc: 'La capitale historique avec la Cathédrale et le Musée du Papier.' },
    ]}
    lang="fr-fr"
  />

</BaseLayout>
