---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import CorrelationSlider from '../../../../components/CorrelationSlider.astro';
import Breadcrumbs from '../../../../components/Breadcrumbs.astro';

const lang = 'fr-fr';

const breadcrumbs = [
  { name: 'Accueil', url: '/fr-fr/' },
  { name: 'Côte Amalfitaine', url: '/fr-fr/cote-amalfitaine/' },
  { name: 'Erchie', url: '/fr-fr/cote-amalfitaine/erchie/' },
];

const touristAttractionSchema = {
  "@context": "https://schema.org",
  "@type": "TouristAttraction",
  "name": "Erchie",
  "description": "Erchie est un petit bourg marin de la Côte Amalfitaine, hameau de Maiori, avec une plage de sable protégée par une tour sarrasine et une atmosphère authentique loin du tourisme de masse.",
  "url": "https://amalficoast-travel.com/fr-fr/cote-amalfitaine/erchie/",
  "touristType": ["Mer", "Détente", "Authenticité", "Familles"],
  "address": { "@type": "PostalAddress", "addressLocality": "Erchie", "addressRegion": "Salerne", "addressCountry": "IT", "postalCode": "84010" },
  "geo": { "@type": "GeoCoordinates", "latitude": 40.6278, "longitude": 14.6792 }
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Comment se rendre à Erchie ?",
      "acceptedAnswer": { "@type": "Answer", "text": "En voiture : sur la SS163 entre Cetara et Maiori, il y a un embranchement qui descend vers le bourg (parking limité). En bus SITA : arrêt Erchie sur la ligne Salerne-Amalfi. En bateau : accessible par la mer depuis Maiori ou Cetara." }
    },
    {
      "@type": "Question",
      "name": "La plage d'Erchie est-elle de sable ?",
      "acceptedAnswer": { "@type": "Answer", "text": "Oui, Erchie possède l'une des rares plages de sable de la Côte Amalfitaine. C'est une baie protégée aux eaux calmes et peu profondes près du rivage, idéale pour les familles avec enfants. Il y a une partie libre et une partie équipée avec chaises longues et parasols." }
    },
    {
      "@type": "Question",
      "name": "Erchie est-elle bondée en été ?",
      "acceptedAnswer": { "@type": "Answer", "text": "Beaucoup moins que les plages de Positano ou Amalfi. Erchie est connue surtout des locaux et des Campaniens. En août, elle peut être fréquentée mais jamais surpeuplée. Arrivez le matin tôt pour le meilleur emplacement." }
    },
    {
      "@type": "Question",
      "name": "Y a-t-il des restaurants à Erchie ?",
      "acceptedAnswer": { "@type": "Answer", "text": "Oui, il y a quelques trattorias et restaurants de poisson directement sur la plage et dans le bourg. Cuisine de mer toute fraîche à des prix contenus comparés aux restaurants de la côte principale." }
    },
    {
      "@type": "Question",
      "name": "Qu'est-ce que la Tour d'Erchie ?",
      "acceptedAnswer": { "@type": "Answer", "text": "C'est une tour sarrasine du XVIe siècle qui domine la baie. Construite pour défendre le bourg contre les incursions de pirates, elle est aujourd'hui l'un des symboles les plus photographiés de la zone. Elle n'est pas visitable à l'intérieur mais constitue un élément scénographique extraordinaire." }
    }
  ]
};

const schemas = [touristAttractionSchema, faqSchema];

const fastFacts = [
  { dt: 'Emplacement', dd: 'Côte Amalfitaine, SA' },
  { dt: 'Commune', dd: 'Hameau de Maiori' },
  { dt: 'Depuis Salerne', dd: '25 min (voiture/bus)' },
  { dt: 'Depuis Amalfi', dd: '20 min (voiture/bus)' },
  { dt: 'Plage', dd: 'Sable (rare sur la Côte !)' },
  { dt: 'Tour', dd: 'Tour sarrasine XVIe s.' },
  { dt: 'Services', dd: 'Restaurants, lidos, parking' },
  { dt: 'Meilleure période', dd: 'Mai-Sep' },
  { dt: 'Idéal pour', dd: 'Familles, détente, mer' },
];

const tips = [
  'Erchie possède l\'une des très rares plages de sable de la Côte : parfaite pour les familles avec de jeunes enfants.',
  'Le parking est très limité : arrivez tôt ou prenez le bus SITA depuis Salerne ou Maiori.',
  'Déjeunez dans l\'une des trattorias sur la plage : poisson frais à moitié prix par rapport à Amalfi.',
  'La baie est protégée des vents : même quand la mer est agitée ailleurs, l\'eau est souvent calme ici.',
];
---

<BaseLayout
  title="Erchie 2026 : La Plage de Sable Secrète de la Côte Amalfitaine"
  description="Guide d'Erchie : la plage de sable cachée de la Côte Amalfitaine, la tour sarrasine, les trattorias de poisson. Le bourg marin authentique entre Cetara et Maiori."
  lang={lang}
  breadcrumbs={breadcrumbs}
  schema={schemas}
  pageKey="erchie"

  heroImage="/images/erchie-hero.webp"
>

  <!-- Hero -->
  <section class="relative h-[75vh] sm:h-[90vh] flex items-center bg-charcoal overflow-hidden">
    <img src="/images/erchie-hero.webp" alt="Erchie, bourg marin de la Côte Amalfitaine" class="absolute inset-0 w-full h-full object-cover" loading="eager" fetchpriority="high" decoding="sync" referrerpolicy="no-referrer"/>
    <div class="absolute inset-0 bg-gradient-to-b from-black/10 via-black/40 to-black/80 z-10"></div>
    <div class="relative z-20 max-w-editorial mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <p class="text-med-gold text-xs sm:text-sm font-medium uppercase tracking-[0.3em] mb-3">Bourg Marin de la Côte</p>
        <h1 class="font-serif text-display text-white mb-4">Erchie</h1>
        <p class="text-xl text-white/80 leading-relaxed max-w-2xl">
          Un amphithéâtre de maisons blanches sur une baie de sable, protégé par une tour sarrasine. Le secret le mieux gardé de la Côte.
        </p>
        <div class="flex flex-wrap gap-3 mt-8">
          <a href="#fast-facts" class="px-5 py-2.5 bg-med-gold text-white text-xs sm:text-sm font-semibold rounded-full hover:scale-105 hover:shadow-[0_8px_25px_rgba(212,175,55,0.4)] transition-all duration-300">Infos Pratiques</a>
          <a href="#plage" class="px-5 py-2.5 bg-white/10 backdrop-blur text-white text-xs sm:text-sm font-medium rounded-full border border-white/20 hover:bg-white/20 transition-colors">La Plage</a>
          <a href="#faq" class="px-5 py-2.5 bg-white/10 backdrop-blur text-white text-xs sm:text-sm font-medium rounded-full border border-white/20 hover:bg-white/20 transition-colors">FAQ</a>
        </div>
      </div>
    </div>
    <Breadcrumbs breadcrumbs={breadcrumbs} />
  </section>

  <section class="max-w-editorial mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="grid lg:grid-cols-[1fr_320px] gap-12">

      <div class="space-y-16">

        <div class="prose-editorial">
          <p class="text-xl leading-relaxed text-charcoal">
            Erchie est le bourg que les touristes ne trouvent pas. Caché dans une baie entre <a href="/fr-fr/cote-amalfitaine/cetara/" class="text-med-blue hover:underline">Cetara</a> et <a href="/fr-fr/cote-amalfitaine/maiori/" class="text-med-blue hover:underline">Maiori</a>, ce petit amphithéâtre de maisons blanches donnant sur une plage de sable est l'endroit où les Campaniens vont à la mer pour éviter la foule.
          </p>
          <p class="mt-4 text-slate-600 leading-relaxed">
            Hameau de Maiori, Erchie conserve une atmosphère de village de pêcheurs que le reste de la Côte a perdu depuis longtemps. La tour sarrasine du XVIe siècle domine la baie, les barques colorées sont tirées sur le sable et les restaurants servent du poisson pêché le matin même.
          </p>
        </div>

        <!-- Le saviez-vous ? -->
        <div class="bg-slate-900 border border-white/10 rounded-[3rem] p-8">
          <p class="text-[10px] uppercase tracking-[0.3em] text-med-gold font-medium mb-4">Le saviez-vous ?</p>
          <div class="grid sm:grid-cols-3 gap-6">
            <div class="text-center">
              <p class="font-serif text-5xl font-bold text-med-gold">XVIe s.</p>
              <p class="text-white/60 text-xs italic mt-1">la Tour sarrasine qui domine la baie</p>
            </div>
            <div class="text-center">
              <p class="font-serif text-5xl font-bold text-med-gold">Sable</p>
              <p class="text-white/60 text-xs italic mt-1">une rareté sur la Côte Amalfitaine</p>
            </div>
            <div class="text-center">
              <p class="font-serif text-5xl font-bold text-med-gold">~200</p>
              <p class="text-white/60 text-xs italic mt-1">résidents dans le bourg</p>
            </div>
          </div>
        </div>

        <!-- La Plage -->
        <div id="plage">
          <h2 class="font-serif text-3xl font-semibold text-slate-900 mb-6">La Plage d'Erchie</h2>
          <p class="text-slate-600 text-lg leading-relaxed mb-6">
            La plage d'Erchie est l'une des rares plages de sable de la Côte Amalfitaine. Une baie protégée aux eaux calmes, peu profondes près du rivage, idéale pour les familles.
          </p>
          <div class="space-y-6">
            <div class="bg-white p-6 rounded-2xl border border-slate-100">
              <h3 class="font-bold text-slate-900 mb-2">Plage principale</h3>
              <p class="text-slate-600 text-sm">Sable fin avec zone libre et zone équipée (chaises longues et parasols en location). La tour sarrasine forme un fond scénographique. Eau calme grâce à la configuration de la baie.</p>
            </div>
            <div class="bg-white p-6 rounded-2xl border border-slate-100">
              <h3 class="font-bold text-slate-900 mb-2">Crique orientale</h3>
              <p class="text-slate-600 text-sm">Une petite crique de galets accessible à pied depuis le bourg, plus sauvage et tranquille. Idéale pour ceux qui cherchent la solitude et le snorkeling dans des eaux limpides.</p>
            </div>
          </div>
        </div>

        <!-- Que voir -->
        <div>
          <h2 class="font-serif text-3xl font-semibold text-slate-900 mb-8">Que voir à Erchie</h2>
          <div class="space-y-8">
            {[
              { n: 1, title: 'Tour Sarrasine', text: 'Le symbole d\'Erchie : une tour de guet du XVIe siècle construite pour défendre la côte contre les incursions de pirates. Elle domine la baie de sa masse imposante. Non visitable à l\'intérieur mais incontournable comme toile de fond photographique.' },
              { n: 2, title: 'Abbaye de Santa Maria de Erchie', text: 'Une ancienne abbaye bénédictine fondée au XIe siècle, perchée au-dessus du bourg. Les vestiges de la structure médiévale sont partiellement visitables et offrent une vue panoramique sur la baie.' },
              { n: 3, title: 'Le bourg des pêcheurs', text: 'Promenez-vous entre les maisons blanches, les escaliers fleuris et les barques colorées tirées sur le sable. Erchie a conservé l\'aspect d\'un village de pêcheurs grâce à sa position à l\'écart de la route principale.' },
              { n: 4, title: 'Sentier Erchie-Cetara', text: 'Un parcours côtier qui relie Erchie à Cetara à travers la garrigue méditerranéenne. Environ 3 km, 1 heure de marche, panoramas sur la côte et sur la mer. Difficulté facile.' },
            ].map(({ n, title, text }) => (
              <div class="grid sm:grid-cols-[auto_1fr] gap-4">
                <div class="w-14 h-14 rounded-[1rem] bg-med-gold/10 flex items-center justify-center flex-shrink-0 text-med-gold font-serif font-bold text-xl">{n}</div>
                <div>
                  <h3 class="font-semibold text-charcoal text-lg mb-1">{title}</h3>
                  <p class="text-slate-600 leading-relaxed">{text}</p>
                </div>
              </div>
            ))}
          </div>
        </div>

        <!-- Conseil Local -->
        <div class="relative overflow-hidden rounded-[3rem] bg-med-blue p-10 md:p-14 text-white shadow-2xl">
          <div class="relative z-10 flex flex-col md:flex-row items-start md:items-center gap-8">
            <div class="w-20 h-20 rounded-2xl bg-white/10 flex items-center justify-center flex-shrink-0 border border-white/20"><svg class="w-10 h-10 text-med-gold" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 3v2.25m6.364.386-1.591 1.591M21 12h-2.25m-.386 6.364-1.591-1.591M12 18.75V21m-4.773-4.227-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0Z"/></svg></div>
            <div>
              <p class="text-med-gold text-xs font-bold uppercase tracking-[0.3em] mb-2">Conseil Local</p>
              <h3 class="font-serif text-2xl font-bold text-white mb-3 tracking-tight">Le secret des Campaniens</h3>
              <p class="text-white/70 leading-relaxed">Erchie, c'est là où vont les Salernitains et les Campaniens quand ils veulent la mer sans la foule de la Côte. Vrai sable, eau calme, poisson frais et prix honnêtes. En semaine hors saison, vous pourriez avoir la plage presque pour vous.</p>
            </div>
          </div>
          <div class="absolute bottom-0 left-0 translate-y-1/2 -translate-x-1/2 w-80 h-80 bg-med-gold/10 rounded-full blur-3xl pointer-events-none"></div>
        </div>

        <!-- FAQ -->
        <div id="faq">
          <h2 class="font-serif text-3xl font-semibold text-slate-900 mb-8">Questions fréquentes sur Erchie</h2>
          <div class="space-y-4">
            {faqSchema.mainEntity.map((q) => (
              <details class="group border border-slate-200 rounded-2xl overflow-hidden">
                <summary class="flex items-center justify-between px-6 py-4 cursor-pointer select-none text-charcoal font-medium hover:bg-slate-50 transition-colors">
                  {q.name}
                  <svg class="w-4 h-4 text-slate-400 group-open:rotate-180 transition-transform flex-shrink-0 ml-3" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
                </summary>
                <div class="px-6 pb-5 text-slate-600 leading-relaxed text-xs sm:text-sm border-t border-slate-100 pt-4">
                  {q.acceptedAnswer.text}
                </div>
              </details>
            ))}
          </div>
        </div>

      </div>

      <aside class="space-y-6 lg:sticky lg:top-24 self-start">
        <div id="fast-facts" class="bg-slate-900 text-white rounded-[3rem] p-6">
          <p class="text-[10px] uppercase tracking-[0.3em] text-med-gold font-medium mb-4">Infos Pratiques - Erchie</p>
          <dl class="space-y-3">
            {fastFacts.map(({ dt, dd }, i) => (
              <>
                <div class="flex justify-between items-start gap-3">
                  <dt class="text-white/40 text-xs sm:text-sm font-light flex-shrink-0">{dt}</dt>
                  <dd class="text-white font-medium text-xs sm:text-sm text-right">{dd}</dd>
                </div>
                {i < fastFacts.length - 1 && <div class="border-t border-white/5"></div>}
              </>
            ))}
          </dl>
        </div>

        <div class="bg-med-cream border border-med-gold/30 rounded-[2rem] p-6">
          <p class="text-[10px] uppercase tracking-[0.3em] text-med-gold font-medium mb-3">Conseils d'initiés</p>
          <ul class="space-y-3">
            {tips.map(tip => (
              <li class="flex items-start gap-2 text-xs sm:text-sm text-charcoal">
                <span class="w-1.5 h-1.5 rounded-full bg-med-gold mt-1.5 flex-shrink-0"></span>
                <span>{tip}</span>
              </li>
            ))}
          </ul>
        </div>

        <div class="bg-white border border-slate-100 rounded-[2rem] p-6 shadow-sm">
          <p class="text-[10px] uppercase tracking-[0.3em] text-slate-400 font-medium mb-3">Explorer la Côte</p>
          <nav class="space-y-1">
            {[
              { href: '/fr-fr/cote-amalfitaine/cetara/', label: 'Cetara' },
              { href: '/fr-fr/cote-amalfitaine/maiori/', label: 'Maiori' },
              { href: '/fr-fr/cote-amalfitaine/vietri-sul-mare/', label: 'Vietri sul Mare' },
              { href: '/fr-fr/cote-amalfitaine/minori/', label: 'Minori' },
              { href: '/fr-fr/cote-amalfitaine/amalfi/', label: 'Amalfi' },
            ].map(({ href, label }) => (
              <a href={href} class="flex items-center gap-2 px-3 py-2 rounded-xl text-xs sm:text-sm text-charcoal hover:bg-med-blue/5 hover:text-med-blue transition-colors">
                <span class="w-1.5 h-1.5 rounded-full bg-med-blue/30"></span> {label}
              </a>
            ))}
          </nav>
        </div>
      </aside>

    </div>
  </section>

  <CorrelationSlider
    heading="Explorer aussi sur la Côte Amalfitaine"
    items={[
      { name: 'Cetara',   href: '/fr-fr/cote-amalfitaine/cetara/',   tag: 'Village de Pêcheurs', desc: 'Le village de pêcheurs et berceau de la colatura di alici AOP.' },
      { name: 'Maiori',   href: '/fr-fr/cote-amalfitaine/maiori/',   tag: 'Plage & Détente',     desc: 'La plus longue plage de sable de la côte : 300 m.' },
      { name: 'Vietri',   href: '/fr-fr/cote-amalfitaine/vietri-sul-mare/', tag: 'Céramiques', desc: 'La porte de la Côte, célèbre pour ses céramiques artistiques.' },
      { name: 'Minori',   href: '/fr-fr/cote-amalfitaine/minori/',   tag: 'Saveurs & Culture',   desc: 'Villa romaine et scialatielli frais.' },
      { name: 'Amalfi',   href: '/fr-fr/cote-amalfitaine/amalfi/',   tag: 'République Maritime', desc: 'La capitale historique avec la Cathédrale et le Musée du Papier.' },
    ]}
    lang="fr-fr"
  />

</BaseLayout>
