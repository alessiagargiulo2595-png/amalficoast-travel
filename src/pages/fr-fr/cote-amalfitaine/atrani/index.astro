---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../../components/Breadcrumbs.astro';
import CorrelationSlider from '../../../../components/CorrelationSlider.astro';

const lang = 'fr-fr';

const breadcrumbs = [
  { name: 'Accueil', url: '/fr-fr/' },
  { name: 'Côte Amalfitaine', url: '/fr-fr/cote-amalfitaine/' },
  { name: 'Atrani', url: '/fr-fr/cote-amalfitaine/atrani/' },
];

const touristAttractionSchema = {
  "@context": "https://schema.org",
  "@type": "TouristAttraction",
  "name": "Atrani",
  "description": "Atrani est la plus petite commune d'Italie par superficie (0,12 km²), un bourg médiéval entre les falaises à seulement 700 mètres d'Amalfi.",
  "url": "https://amalficoast-travel.com/fr-fr/cote-amalfitaine/atrani/",
  "image": "https://amalficoast-travel.com/images/atrani-hero.webp",
  "touristType": ["Authenticité", "Histoire", "Mer", "Photographie"],
  "address": { "@type": "PostalAddress", "addressLocality": "Atrani", "addressRegion": "Salerno", "addressCountry": "IT", "postalCode": "84010" },
  "geo": { "@type": "GeoCoordinates", "latitude": 40.6364, "longitude": 14.6083 }
};

const placeSchema = {
  "@context": "https://schema.org",
  "@type": "Place",
  "name": "Atrani, Côte Amalfitaine",
  "description": "La plus petite commune d'Italie, village médiéval authentique à 700 m d'Amalfi.",
  "geo": { "@type": "GeoCoordinates", "latitude": 40.6364, "longitude": 14.6083 }
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Quelle distance entre Atrani et Amalfi ?",
      "acceptedAnswer": { "@type": "Answer", "text": "Atrani se trouve à seulement 700 mètres d'Amalfi. On y arrive à pied en 10-15 minutes par un tunnel piétonnier ou en longeant la route côtière. Ce sont les deux communes les plus proches de toute la Côte Amalfitaine." }
    },
    {
      "@type": "Question",
      "name": "Comment se rendre à Atrani ?",
      "acceptedAnswer": { "@type": "Answer", "text": "Le meilleur moyen est à pied depuis Amalfi (10-15 min). En bus : ligne SITA Salerne-Amalfi, arrêt Atrani. En voiture : stationnement extrêmement limité, il est conseillé de se garer à Amalfi (parking Luna Rossa) et de marcher." }
    },
    {
      "@type": "Question",
      "name": "Pourquoi Atrani est-il célèbre ?",
      "acceptedAnswer": { "@type": "Answer", "text": "Atrani est la plus petite commune d'Italie par superficie (0,12 km²). C'était le lieu où étaient couronnés et enterrés les Doges de la République Maritime d'Amalfi. Récemment, le village est devenu célèbre comme décor de la série Netflix Ripley (2024)." }
    },
    {
      "@type": "Question",
      "name": "Que manger à Atrani ?",
      "acceptedAnswer": { "@type": "Answer", "text": "Le plat typique est le sarchiapone : courgettes longues farcies de viande hachée, provola fumée, œufs et pain rassis, cuites dans la sauce tomate. Il faut aussi goûter le poisson frais dans les restaurants de la place." }
    },
    {
      "@type": "Question",
      "name": "Peut-on se baigner à Atrani ?",
      "acceptedAnswer": { "@type": "Answer", "text": "Oui, Atrani possède une petite plage de sable et galets directement sur la place du village. C'est l'une des rares plages libres de la Côte. Eau limpide et ambiance authentique, beaucoup moins bondée qu'Amalfi." }
    }
  ]
};
---

<BaseLayout
  title="Atrani : Le Plus Petit Village d'Italie sur la Côte Amalfitaine"
  description="Guide d'Atrani, la plus petite commune d'Italie à 700 m d'Amalfi. Place sur la mer, histoire des Doges, décor de Ripley Netflix, plage et sarchiapone."
  lang={lang}
  breadcrumbs={breadcrumbs}
  schema={[touristAttractionSchema, placeSchema, faqSchema]}
  pageKey="atrani"

  heroImage="/images/atrani-hero.webp"
>

  <section class="relative h-[52.5vh] sm:h-[70vh] flex items-end bg-charcoal overflow-hidden">
    <img src="/images/atrani-hero.webp" alt="Atrani, le plus petit village d'Italie sur la Côte Amalfitaine" class="absolute inset-0 w-full h-full object-cover" loading="eager" fetchpriority="high" decoding="sync" referrerpolicy="no-referrer"/>
    <div class="absolute inset-0 bg-gradient-to-b from-black/75 via-black/40 to-black/70"></div>
    <div class="relative z-10 max-w-7xl mx-auto px-6 pb-16 pt-32 w-full">
      <div class="max-w-3xl">
        <p class="text-med-gold text-xs sm:text-sm font-medium uppercase tracking-[0.3em] mb-3">Côte Amalfitaine</p>
        <h1 class="font-serif text-display text-white mb-4">Atrani</h1>
        <p class="text-xl text-white/80 leading-relaxed">Le plus petit village d'Italie. À 700 mètres d'Amalfi, un autre monde.</p>
        <div class="flex flex-wrap gap-3 mt-8">
          <a href="#fast-facts" class="px-5 py-2.5 bg-med-gold text-white text-xs sm:text-sm font-semibold rounded-full hover:scale-105 hover:shadow-[0_8px_25px_rgba(212,175,55,0.4)] transition-all duration-300">En Bref</a>
          <a href="#que-voir" class="px-5 py-2.5 bg-white/10 backdrop-blur text-white text-xs sm:text-sm font-medium rounded-full border border-white/20 hover:bg-white/20 transition-colors">À Voir</a>
          <a href="#faq" class="px-5 py-2.5 bg-white/10 backdrop-blur text-white text-xs sm:text-sm font-medium rounded-full border border-white/20 hover:bg-white/20 transition-colors">FAQ</a>
        </div>
      </div>
    </div>
    <Breadcrumbs breadcrumbs={breadcrumbs} />
  </section>

  <section class="bg-med-cream py-24 px-6">
    <div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-3 gap-16">
      <div class="lg:col-span-2 space-y-12">

        <div>
          <h2 class="font-serif text-4xl font-bold text-slate-900 mb-6">La Plus Petite Commune d'Italie</h2>
          <p class="text-slate-600 text-lg leading-relaxed mb-4">
            <strong>Atrani</strong> est la <strong>plus petite commune d'Italie</strong> par superficie : à peine 0,12 km&sup2; de ruelles, escaliers et arcs médiévaux serrés entre deux falaises surplombant la mer. À seulement 700 mètres d'Amalfi, et pourtant un monde complètement différent.
          </p>
          <p class="text-slate-600 text-lg leading-relaxed">
            Ici, pas de boutiques de luxe ni de restaurants pour touristes. Il y a une petite place où les enfants jouent au ballon, une petite plage libre et le bruit de l'eau qui coule entre les maisons. Qui arrive à Atrani découvre la Côte Amalfitaine telle qu'elle était avant le tourisme de masse.
          </p>
        </div>

        <div class="bg-slate-900 border border-white/10 rounded-[3rem] p-8">
          <p class="text-[10px] uppercase tracking-[0.3em] text-med-gold font-medium mb-4">Le saviez-vous ?</p>
          <div class="grid sm:grid-cols-3 gap-6">
            <div class="text-center">
              <p class="font-serif text-5xl font-bold text-med-gold">0,12</p>
              <p class="text-white/60 text-xs italic mt-1">km&sup2; de superficie totale</p>
            </div>
            <div class="text-center">
              <p class="font-serif text-5xl font-bold text-med-gold">839</p>
              <p class="text-white/60 text-xs italic mt-1">habitants (un village vivant)</p>
            </div>
            <div class="text-center">
              <p class="font-serif text-5xl font-bold text-med-gold">700</p>
              <p class="text-white/60 text-xs italic mt-1">mètres à pied depuis Amalfi</p>
            </div>
          </div>
          <p class="text-white/40 text-xs mt-6 italic">Au Moyen Âge, Atrani était le lieu où étaient couronnés les Doges de la République Maritime d'Amalfi. La Collégiale de San Salvatore de' Birecto conserve encore la dalle de porphyre où se déroulait la cérémonie.</p>
        </div>

        <div id="que-voir">
          <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">Que Voir à Atrani</h2>
          <div class="space-y-8">
            <div>
              <h3 class="text-xl font-bold text-slate-900 mb-3">Piazza Umberto I</h3>
              <p class="text-slate-600 leading-relaxed">Le cœur du village. L'une des rares places de la Côte donnant directement sur la mer, avec bars, restaurants et la vie quotidienne des habitants. C'est ici que se déroule la Fête de Sainte Marie-Madeleine (22 juillet).</p>
            </div>
            <div>
              <h3 class="text-xl font-bold text-slate-900 mb-3">Collégiale de San Salvatore de' Birecto</h3>
              <p class="text-slate-600 leading-relaxed">Fondée au Xe siècle, elle conserve la <strong>dalle de porphyre</strong> sur laquelle étaient couronnés les Doges d'Amalfi. La porte de bronze est une copie de celle de Constantinople. Un morceau d'histoire de la République Maritime.</p>
            </div>
            <div>
              <h3 class="text-xl font-bold text-slate-900 mb-3">Église Santa Maria Maddalena</h3>
              <p class="text-slate-600 leading-relaxed">La coupole en majolique et le clocher dominent le profil d'Atrani depuis la côte. L'intérieur baroque abrite un crucifix en bois du XIIIe siècle. La fête du 22 juillet est parmi les plus animées de la Côte.</p>
            </div>
            <div>
              <h3 class="text-xl font-bold text-slate-900 mb-3">Grotte de Masaniello</h3>
              <p class="text-slate-600 leading-relaxed">La légende raconte que Masaniello, le célèbre révolutionnaire napolitain, se cacha dans une grotte au-dessus d'Atrani lors de la révolte de 1647. Le sentier menant à la grotte offre des vues sur la côte.</p>
            </div>
          </div>
        </div>

        <div>
          <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">La Plage d'Atrani</h2>
          <p class="text-slate-600 text-lg leading-relaxed mb-6">La petite plage d'Atrani est l'une des rares plages libres de la Côte. Sable et galets, eau limpide et une ambiance qui évoque davantage un village de pêcheurs qu'une destination touristique.</p>
          <div class="bg-white p-6 rounded-2xl border border-slate-100">
            <h3 class="font-bold text-slate-900 mb-2">Plage de la Piazzetta</h3>
            <p class="text-slate-600 text-sm">Directement sous la Piazza Umberto I. Plage libre, pas d'établissement balnéaire. Eaux profondes et propres. Beaucoup moins bondée que la Spiaggia Grande d'Amalfi, à seulement 15 minutes à pied.</p>
          </div>
        </div>

        <div>
          <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">Atrani et Ripley : Le Décor Netflix</h2>
          <p class="text-slate-600 text-lg leading-relaxed">En 2024, la série Netflix <strong>Ripley</strong>, avec Andrew Scott, a utilisé Atrani comme décor principal pour les scènes situées dans la ville côtière fictive. La place, les escaliers et les ruelles du village ont été filmés en noir et blanc, restituant l'atmosphère suspendue et mystérieuse du roman de Patricia Highsmith.</p>
        </div>

        <div>
          <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">Que Manger à Atrani</h2>
          <div class="space-y-6">
            <div class="bg-med-gold/10 p-6 rounded-2xl border border-med-gold/20">
              <h3 class="font-bold text-slate-900 mb-2 text-lg">Sarchiapone</h3>
              <p class="text-slate-600 leading-relaxed">Le plat typique d'Atrani : courgettes longues farcies de viande hachée, provola fumée, œufs et pain rassis, cuites dans la sauce tomate. Un comfort food de la tradition amalfitaine.</p>
            </div>
            <div class="bg-med-gold/10 p-6 rounded-2xl border border-med-gold/20">
              <h3 class="font-bold text-slate-900 mb-2 text-lg">Poisson Frais sur la Piazzetta</h3>
              <p class="text-slate-600 leading-relaxed">Les restaurants de la place proposent du poisson du jour à des prix plus honnêtes qu'à Amalfi. Friture mixte, spaghetti aux fruits de mer et anchois marinés sont les spécialités.</p>
            </div>
          </div>
        </div>

        <div id="faq">
          <h2 class="font-serif text-3xl font-semibold text-slate-900 mb-8">Questions fréquentes sur Atrani</h2>
          <div class="space-y-4">
            {faqSchema.mainEntity.map((q) => (
              <details class="group border border-slate-200 rounded-2xl overflow-hidden">
                <summary class="flex items-center justify-between px-6 py-4 cursor-pointer select-none text-charcoal font-medium hover:bg-slate-50 transition-colors">
                  {q.name}
                  <svg class="w-4 h-4 text-slate-400 group-open:rotate-180 transition-transform flex-shrink-0 ml-3" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
                </summary>
                <div class="px-6 pb-5 text-slate-600 leading-relaxed text-xs sm:text-sm border-t border-slate-100 pt-4">{q.acceptedAnswer.text}</div>
              </details>
            ))}
          </div>
        </div>

        <div>
          <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">Comment y Arriver</h2>
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
            <div class="bg-white p-6 rounded-[2rem] border border-slate-100 shadow-sm">
              <p class="text-med-gold text-xs font-bold uppercase tracking-wider mb-2">À Pied depuis Amalfi</p>
              <p class="text-slate-700 font-medium mb-1">10-15 minutes</p>
              <p class="text-slate-500 text-xs sm:text-sm">Tunnel piétonnier ou promenade le long de la côte. Le moyen le plus pratique et le plus beau.</p>
            </div>
            <div class="bg-white p-6 rounded-[2rem] border border-slate-100 shadow-sm">
              <p class="text-med-gold text-xs font-bold uppercase tracking-wider mb-2">Bus SITA</p>
              <p class="text-slate-700 font-medium mb-1">Arrêt Atrani</p>
              <p class="text-slate-500 text-xs sm:text-sm">Ligne Salerne-Amalfi. Arrêt dédié sur la SS163.</p>
            </div>
            <div class="bg-white p-6 rounded-[2rem] border border-slate-100 shadow-sm">
              <p class="text-med-gold text-xs font-bold uppercase tracking-wider mb-2">En Voiture</p>
              <p class="text-slate-700 font-medium mb-1">Stationnement limité</p>
              <p class="text-slate-500 text-xs sm:text-sm">Très peu de places. Mieux vaut se garer à Amalfi (Luna Rossa) et marcher.</p>
            </div>
          </div>
        </div>

      </div>

      <aside class="space-y-6 lg:sticky lg:top-24 self-start">
        <div id="fast-facts" class="bg-slate-900 text-white rounded-[3rem] p-6">
          <p class="text-[10px] uppercase tracking-[0.3em] text-med-gold font-medium mb-4">En Bref - Atrani</p>
          <dl class="space-y-3">
            <div class="flex justify-between items-start gap-3"><dt class="text-white/40 text-xs sm:text-sm font-light flex-shrink-0">Situation</dt><dd class="text-white font-medium text-xs sm:text-sm text-right">700 m d'Amalfi<br/>25 km de Salerne</dd></div>
            <div class="border-t border-white/5"></div>
            <div class="flex justify-between items-start gap-3"><dt class="text-white/40 text-xs sm:text-sm font-light flex-shrink-0">Superficie</dt><dd class="text-white font-medium text-xs sm:text-sm text-right">0,12 km&sup2;<br/>Le plus petit d'Italie</dd></div>
            <div class="border-t border-white/5"></div>
            <div class="flex justify-between items-start gap-3"><dt class="text-white/40 text-xs sm:text-sm font-light flex-shrink-0">Habitants</dt><dd class="text-white font-medium text-xs sm:text-sm text-right">Environ 839</dd></div>
            <div class="border-t border-white/5"></div>
            <div class="flex justify-between items-start gap-3"><dt class="text-white/40 text-xs sm:text-sm font-light flex-shrink-0">Plat Typique</dt><dd class="text-white font-medium text-xs sm:text-sm text-right">Sarchiapone</dd></div>
            <div class="border-t border-white/5"></div>
            <div class="flex justify-between items-start gap-3"><dt class="text-white/40 text-xs sm:text-sm font-light flex-shrink-0">Fête Patronale</dt><dd class="text-white font-medium text-xs sm:text-sm text-right">22 Juillet<br/>Ste Marie-Madeleine</dd></div>
            <div class="border-t border-white/5"></div>
            <div class="flex justify-between items-start gap-3"><dt class="text-white/40 text-xs sm:text-sm font-light flex-shrink-0">Curiosité</dt><dd class="text-white font-medium text-xs sm:text-sm text-right">Décor de Ripley<br/>(Netflix, 2024)</dd></div>
            <div class="border-t border-white/5"></div>
            <div class="flex justify-between items-start gap-3"><dt class="text-white/40 text-xs sm:text-sm font-light flex-shrink-0">Idéal pour</dt><dd class="text-white font-medium text-xs sm:text-sm text-right">Authenticité<br/>Photographie<br/>Tranquillité</dd></div>
          </dl>
          <div class="mt-10 pt-8 border-t border-white/10">
            <a href="/fr-fr/cote-amalfitaine/" class="inline-flex items-center gap-2 text-med-gold text-xs sm:text-sm font-medium hover:text-white transition-colors">← Retour à la Côte Amalfitaine</a>
          </div>
        </div>
      </aside>

    </div>
  </section>

  <CorrelationSlider
    heading="Explorez la Côte"
    items={[
      { name: 'Amalfi', href: '/fr-fr/cote-amalfitaine/amalfi/', tag: 'République Maritime', desc: 'À seulement 700 m d\'Atrani : la Cathédrale, le Musée du Papier et le port.' },
      { name: 'Ravello', href: '/fr-fr/cote-amalfitaine/ravello/', tag: 'Musique & Jardins', desc: 'Villa Rufolo, Villa Cimbrone et le Festival Musical à 350 m.' },
      { name: 'Positano', href: '/fr-fr/cote-amalfitaine/positano/', tag: 'Mode & Panorama', desc: 'Les maisons colorées surplombant la mer et la plage Fornillo.' },
      { name: 'Minori', href: '/fr-fr/cote-amalfitaine/minori/', tag: 'Saveurs & Culture', desc: 'Villa romaine du Ier siècle, scialatielli frais et pâtisseries.' },
      { name: 'Cetara', href: '/fr-fr/cote-amalfitaine/cetara/', tag: 'Gastronomie', desc: 'Le village de pêcheurs et la colatura di alici DOP.' },
      { name: 'Praiano', href: '/fr-fr/cote-amalfitaine/praiano/', tag: 'Coucher de Soleil', desc: 'Le coucher de soleil depuis San Gennaro et la paisible Marina di Praia.' },
    ]}
    lang="fr-fr"
  />

</BaseLayout>
