---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import CorrelationSlider from '../../../../components/CorrelationSlider.astro';
import Breadcrumbs from '../../../../components/Breadcrumbs.astro';

const lang = 'fr-fr';

const breadcrumbs = [
  { name: 'Accueil', url: '/fr-fr/' },
  { name: 'Côte Amalfitaine', url: '/fr-fr/cote-amalfitaine/' },
  { name: 'Salerne', url: '/fr-fr/cote-amalfitaine/salerne/' },
];

const touristAttractionSchema = {
  "@context": "https://schema.org",
  "@type": "TouristAttraction",
  "name": "Salerne",
  "description": "Salerne est la porte d'entrée de la Côte Amalfitaine, ville universitaire millénaire avec sa cathédrale normande, le Jardin de Minerve, le Lungomare Trieste et les célèbres Luci d'Artista en hiver.",
  "url": "https://amalficoast-travel.com/fr-fr/cote-amalfitaine/salerne/",
  "touristType": ["Culture", "Histoire", "Gastronomie", "Base de voyage"],
  "address": { "@type": "PostalAddress", "addressLocality": "Salerno", "addressRegion": "Salerne", "addressCountry": "IT", "postalCode": "84121" },
  "geo": { "@type": "GeoCoordinates", "latitude": 40.6824, "longitude": 14.7681 }
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Comment se rendre à Salerne depuis Naples ?",
      "acceptedAnswer": { "@type": "Answer", "text": "En train Trenitalia Régionale depuis Naples Centrale jusqu'à Salerne en environ 35-40 minutes (~4-7 euros). Les trains Frecciarossa et Italo font le trajet en 25 minutes. En voiture : environ 60 km par l'autoroute A3 Naples-Salerne (péage environ 3 euros)." }
    },
    {
      "@type": "Question",
      "name": "Que voir à Salerne en une journée ?",
      "acceptedAnswer": { "@type": "Answer", "text": "La Cathédrale et la Crypte de San Matteo, le centre historique médiéval avec la Via dei Mercanti, le Jardin de Minerve, le Lungomare Trieste, le Château Arechi pour le panorama. En hiver (novembre-janvier), les Luci d'Artista sont incontournables." }
    },
    {
      "@type": "Question",
      "name": "Salerne est-elle une bonne base pour la Côte Amalfitaine ?",
      "acceptedAnswer": { "@type": "Answer", "text": "Oui, c'est la base la plus pratique et la plus économique. Depuis Salerne partent les ferrys Travelmar vers Amalfi, Positano, Minori et Maiori (avril-octobre). Les bus SITA desservent toute la côte. Les hôtels coûtent 40 à 50 % moins cher qu'à Amalfi ou Positano." }
    },
    {
      "@type": "Question",
      "name": "Quand visiter Salerne ?",
      "acceptedAnswer": { "@type": "Answer", "text": "Avril-juin et septembre-octobre pour le climat et la proximité de la côte. Novembre-janvier pour les Luci d'Artista, l'installation lumineuse qui attire plus de 2 millions de visiteurs. Juillet et août sont chauds mais la ville n'est pas aussi surpeuplée que la Côte." }
    },
    {
      "@type": "Question",
      "name": "Que manger à Salerne ?",
      "acceptedAnswer": { "@type": "Answer", "text": "La milza imbottita (rate farcie, spécialité locale), la scazzetta del cardinale (gâteau à la génoise, crème et fraises), la pizza salernitaine, le poisson frais au marché de Via Roma. La Via dei Mercanti regorge de trattorias authentiques." }
    }
  ]
};

const schemas = [touristAttractionSchema, faqSchema];

const fastFacts = [
  { dt: 'Emplacement', dd: 'Golfe de Salerne, SA' },
  { dt: 'Altitude', dd: '0-300 m' },
  { dt: 'Population', dd: '~130 000 habitants' },
  { dt: 'Depuis Naples', dd: '35 min (train régional)' },
  { dt: 'Port de ferrys', dd: 'Piazza della Concordia' },
  { dt: 'Vers Amalfi', dd: '75 min (ferry)' },
  { dt: 'Meilleure période', dd: 'Avr-Juin / Nov-Jan' },
  { dt: 'Spécialités', dd: 'Milza, scazzetta, poisson' },
  { dt: 'Événement phare', dd: 'Luci d\'Artista (Nov-Jan)' },
];

const tips = [
  'Le Jardin de Minerve est le premier jardin botanique d\'Europe (XIIIe s.) et reste peu visité : un joyau caché dans le centre historique.',
  'La Via dei Mercanti est la vraie âme de Salerne : boutiques, trattorias et pâtisseries à des prix locaux, non touristiques.',
  'Prenez le ferry du matin pour Amalfi : le panorama de la Côte vu depuis la mer est imbattable.',
  'Le Château Arechi (accessible en bus ou à pied en 30 min depuis le centre) offre la plus belle vue sur le Golfe et la ville.',
];
---

<BaseLayout
  title="Salerne 2026 : Guide Complet | Porte de la Côte Amalfitaine"
  description="Guide complet de Salerne : cathédrale normande, Jardin de Minerve, Luci d'Artista, Lungomare Trieste. La porte d'entrée de la Côte Amalfitaine avec ferrys vers Amalfi et Positano."
  lang={lang}
  breadcrumbs={breadcrumbs}
  schema={schemas}
  pageKey="salerno"

  heroImage="/images/salerno-hero.webp"
>

  <!-- Hero -->
  <section class="relative h-[75vh] sm:h-[90vh] flex items-center bg-charcoal overflow-hidden">
    <img src="/images/salerno-hero.webp" alt="Salerne, porte de la Côte Amalfitaine" class="absolute inset-0 w-full h-full object-cover" loading="eager" fetchpriority="high" decoding="sync" referrerpolicy="no-referrer"/>
    <div class="absolute inset-0 bg-gradient-to-b from-black/10 via-black/40 to-black/80 z-10"></div>
    <div class="relative z-20 max-w-editorial mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <p class="text-med-gold text-xs sm:text-sm font-medium uppercase tracking-[0.3em] mb-3">Porte de la Côte Amalfitaine</p>
        <h1 class="font-serif text-display text-white mb-4">Salerne</h1>
        <p class="text-xl text-white/80 leading-relaxed max-w-2xl">
          Ville universitaire millénaire, base idéale pour la Côte. Cathédrale normande, Luci d'Artista et le plus beau front de mer de Campanie.
        </p>
        <div class="flex flex-wrap gap-3 mt-8">
          <a href="#fast-facts" class="px-5 py-2.5 bg-med-gold text-white text-xs sm:text-sm font-semibold rounded-full hover:scale-105 hover:shadow-[0_8px_25px_rgba(212,175,55,0.4)] transition-all duration-300">Infos Pratiques</a>
          <a href="#comment-arriver" class="px-5 py-2.5 bg-white/10 backdrop-blur text-white text-xs sm:text-sm font-medium rounded-full border border-white/20 hover:bg-white/20 transition-colors">Comment arriver</a>
          <a href="#faq" class="px-5 py-2.5 bg-white/10 backdrop-blur text-white text-xs sm:text-sm font-medium rounded-full border border-white/20 hover:bg-white/20 transition-colors">FAQ</a>
        </div>
      </div>
    </div>
    <Breadcrumbs breadcrumbs={breadcrumbs} />
  </section>

  <section class="max-w-editorial mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="grid lg:grid-cols-[1fr_320px] gap-12">

      <div class="space-y-16">

        <div class="prose-editorial">
          <p class="text-xl leading-relaxed text-charcoal">
            Salerne est la ville que tout le monde traverse mais que peu prennent le temps de connaître. Pourtant, avec son centre historique médiéval, sa cathédrale normande qui abrite les reliques de Saint Matthieu et l'un des fronts de mer les plus beaux d'Italie, elle mériterait au moins une journée entière.
          </p>
          <p class="mt-4 text-slate-600 leading-relaxed">
            Fondée comme colonie romaine en 197 av. J.-C., Salerne atteignit son apogée avec l'<strong>École de Médecine de Salerne</strong>, la première et la plus importante institution médicale d'Europe au Moyen Âge. Aujourd'hui c'est une ville vivante et à taille humaine, avec un port qui relie directement <a href="/fr-fr/cote-amalfitaine/amalfi/" class="text-med-blue hover:underline">Amalfi</a>, <a href="/fr-fr/cote-amalfitaine/positano/" class="text-med-blue hover:underline">Positano</a> et <a href="/fr-fr/cote-amalfitaine/minori/" class="text-med-blue hover:underline">Minori</a> par ferry.
          </p>
        </div>

        <!-- Le saviez-vous ? -->
        <div class="bg-slate-900 border border-white/10 rounded-[3rem] p-8">
          <p class="text-[10px] uppercase tracking-[0.3em] text-med-gold font-medium mb-4">Le saviez-vous ?</p>
          <div class="grid sm:grid-cols-3 gap-6">
            <div class="text-center">
              <p class="font-serif text-5xl font-bold text-med-gold">XIe s.</p>
              <p class="text-white/60 text-xs italic mt-1">École de Médecine de Salerne, première d'Europe</p>
            </div>
            <div class="text-center">
              <p class="font-serif text-5xl font-bold text-med-gold">2M+</p>
              <p class="text-white/60 text-xs italic mt-1">visiteurs pour les Luci d'Artista chaque année</p>
            </div>
            <div class="text-center">
              <p class="font-serif text-5xl font-bold text-med-gold">1,5 km</p>
              <p class="text-white/60 text-xs italic mt-1">le Lungomare Trieste piétonnier</p>
            </div>
          </div>
          <p class="text-white/40 text-xs mt-6 italic">
            Robert Guiscard, chef normand, fit de Salerne la capitale du Duché en 1077. La cathédrale qu'il fit construire est encore aujourd'hui le cœur de la ville.
          </p>
        </div>

        <!-- Que voir -->
        <div>
          <h2 class="font-serif text-3xl font-semibold text-slate-900 mb-8">Que voir à Salerne</h2>
          <div class="space-y-8">
            {[
              { n: 1, title: 'Cathédrale de San Matteo', text: 'Le symbole de Salerne, fondée en 1080 par Robert Guiscard. La façade romane avec son portail en bronze du XIe siècle introduit un intérieur baroque avec la Crypte qui abrite les reliques de l\'apôtre Matthieu. Le quadriportique à colonnes romaines est l\'un des plus beaux du sud de l\'Italie. Entrée gratuite.' },
              { n: 2, title: 'Jardin de Minerve', text: 'Le premier jardin botanique d\'Europe, fondé au XIIIe siècle par le médecin Matteo Silvatico de l\'École de Médecine. Aménagé en terrasses sur la colline du centre historique, avec des plantes médicinales, des fontaines et une vue spectaculaire sur le Golfe. Entrée environ 3 euros. À ne pas manquer.' },
              { n: 3, title: 'Lungomare Trieste', text: '1,5 km de promenade piétonnière donnant sur le Golfe de Salerne, considérée comme l\'une des plus belles d\'Italie. Palmiers, bancs, bars et vue sur Capri par temps clair. Parfait pour l\'apéritif au coucher du soleil.' },
              { n: 4, title: 'Château Arechi', text: 'La forteresse lombarde à 300 m d\'altitude domine la ville et le golfe. Accessible en bus (ligne 19) ou à pied en 30 minutes depuis le centre. Abrite un musée de céramiques médiévales et offre le panorama le plus vaste de la région. Entrée environ 5 euros.' },
              { n: 5, title: 'Via dei Mercanti et centre historique', text: 'L\'artère médiévale du commerce salernitain, une succession de boutiques, trattorias et églises. Parcourez-la de la Piazza Sedile del Campo jusqu\'à l\'Arco di Arechi. Les ruelles latérales cachent des pâtisseries historiques et des cours secrètes.' },
            ].map(({ n, title, text }) => (
              <div class="grid sm:grid-cols-[auto_1fr] gap-4">
                <div class="w-14 h-14 rounded-[1rem] bg-med-gold/10 flex items-center justify-center flex-shrink-0 text-med-gold font-serif font-bold text-xl">{n}</div>
                <div>
                  <h3 class="font-semibold text-charcoal text-lg mb-1">{title}</h3>
                  <p class="text-slate-600 leading-relaxed">{text}</p>
                </div>
              </div>
            ))}
          </div>
        </div>

        <!-- Comment arriver -->
        <div id="comment-arriver">
          <h2 class="font-serif text-3xl font-semibold text-slate-900 mb-6">Comment se rendre à Salerne</h2>
          <div class="space-y-6">
            <div class="bg-white rounded-[3rem] p-8 border border-slate-100 hover:shadow-xl transition-all duration-300">
              <h3 class="font-semibold text-charcoal mb-3">Train (depuis Naples)</h3>
              <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">Trenitalia Régionale depuis Naples Centrale : ~35-40 min, environ 4-7 euros. Frecciarossa et Italo : ~25 min. La gare de Salerne est à 10 minutes à pied du centre historique et du port de ferrys.</p>
            </div>
            <div class="bg-white rounded-[3rem] p-8 border border-slate-100 hover:shadow-xl transition-all duration-300">
              <h3 class="font-semibold text-charcoal mb-3">Ferrys vers la Côte</h3>
              <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">Depuis le port de la Piazza della Concordia (5 min de la gare), Travelmar relie Salerne à <a href="/fr-fr/cote-amalfitaine/cetara/" class="text-med-blue hover:underline">Cetara</a>, <a href="/fr-fr/cote-amalfitaine/maiori/" class="text-med-blue hover:underline">Maiori</a>, <a href="/fr-fr/cote-amalfitaine/minori/" class="text-med-blue hover:underline">Minori</a>, <a href="/fr-fr/cote-amalfitaine/amalfi/" class="text-med-blue hover:underline">Amalfi</a> et <a href="/fr-fr/cote-amalfitaine/positano/" class="text-med-blue hover:underline">Positano</a> (avril-octobre). Billet environ 8-10 euros.</p>
            </div>
            <div class="bg-white rounded-[3rem] p-8 border border-slate-100 hover:shadow-xl transition-all duration-300">
              <h3 class="font-semibold text-charcoal mb-3">Bus SITA</h3>
              <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">Les bus SITA partent de la gare et parcourent toute la SS163 jusqu'à <a href="/fr-fr/cote-amalfitaine/amalfi/" class="text-med-blue hover:underline">Amalfi</a> (environ 75 min, 2,50 euros). Service toute l'année, fréquence toutes les 60-90 min.</p>
            </div>
          </div>
        </div>

        <!-- Conseil Local -->
        <div class="relative overflow-hidden rounded-[3rem] bg-med-blue p-10 md:p-14 text-white shadow-2xl">
          <div class="relative z-10 flex flex-col md:flex-row items-start md:items-center gap-8">
            <div class="w-20 h-20 rounded-2xl bg-white/10 flex items-center justify-center flex-shrink-0 border border-white/20"><svg class="w-10 h-10 text-med-gold" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 3v2.25m6.364.386-1.591 1.591M21 12h-2.25m-.386 6.364-1.591-1.591M12 18.75V21m-4.773-4.227-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0Z"/></svg></div>
            <div>
              <p class="text-med-gold text-xs font-bold uppercase tracking-[0.3em] mb-2">Conseil Local</p>
              <h3 class="font-serif text-2xl font-bold text-white mb-3 tracking-tight">Base parfaite pour la Côte</h3>
              <p class="text-white/70 leading-relaxed">Dormez à Salerne et prenez le ferry du matin pour Amalfi : vous économisez 40 à 50 % sur les hôtels et profitez du panorama de la côte depuis la mer. Le soir, le centre historique de Salerne propose des restaurants authentiques à des prix locaux.</p>
            </div>
          </div>
          <div class="absolute bottom-0 left-0 translate-y-1/2 -translate-x-1/2 w-80 h-80 bg-med-gold/10 rounded-full blur-3xl pointer-events-none"></div>
        </div>

        <!-- FAQ -->
        <div id="faq">
          <h2 class="font-serif text-3xl font-semibold text-slate-900 mb-8">Questions fréquentes sur Salerne</h2>
          <div class="space-y-4">
            {faqSchema.mainEntity.map((q) => (
              <details class="group border border-slate-200 rounded-2xl overflow-hidden">
                <summary class="flex items-center justify-between px-6 py-4 cursor-pointer select-none text-charcoal font-medium hover:bg-slate-50 transition-colors">
                  {q.name}
                  <svg class="w-4 h-4 text-slate-400 group-open:rotate-180 transition-transform flex-shrink-0 ml-3" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
                </summary>
                <div class="px-6 pb-5 text-slate-600 leading-relaxed text-xs sm:text-sm border-t border-slate-100 pt-4">
                  {q.acceptedAnswer.text}
                </div>
              </details>
            ))}
          </div>
        </div>

      </div>

      <aside class="space-y-6 lg:sticky lg:top-24 self-start">
        <div id="fast-facts" class="bg-slate-900 text-white rounded-[3rem] p-6">
          <p class="text-[10px] uppercase tracking-[0.3em] text-med-gold font-medium mb-4">Infos Pratiques - Salerne</p>
          <dl class="space-y-3">
            {fastFacts.map(({ dt, dd }, i) => (
              <>
                <div class="flex justify-between items-start gap-3">
                  <dt class="text-white/40 text-xs sm:text-sm font-light flex-shrink-0">{dt}</dt>
                  <dd class="text-white font-medium text-xs sm:text-sm text-right">{dd}</dd>
                </div>
                {i < fastFacts.length - 1 && <div class="border-t border-white/5"></div>}
              </>
            ))}
          </dl>
        </div>

        <div class="bg-med-cream border border-med-gold/30 rounded-[2rem] p-6">
          <p class="text-[10px] uppercase tracking-[0.3em] text-med-gold font-medium mb-3">Conseils d'initiés</p>
          <ul class="space-y-3">
            {tips.map(tip => (
              <li class="flex items-start gap-2 text-xs sm:text-sm text-charcoal">
                <span class="w-1.5 h-1.5 rounded-full bg-med-gold mt-1.5 flex-shrink-0"></span>
                <span>{tip}</span>
              </li>
            ))}
          </ul>
        </div>

        <div class="bg-white border border-slate-100 rounded-[2rem] p-6 shadow-sm">
          <p class="text-[10px] uppercase tracking-[0.3em] text-slate-400 font-medium mb-3">Explorer la Côte</p>
          <nav class="space-y-1">
            {[
              { href: '/fr-fr/cote-amalfitaine/amalfi/', label: 'Amalfi' },
              { href: '/fr-fr/cote-amalfitaine/positano/', label: 'Positano' },
              { href: '/fr-fr/cote-amalfitaine/ravello/', label: 'Ravello' },
              { href: '/fr-fr/cote-amalfitaine/cetara/', label: 'Cetara' },
              { href: '/fr-fr/cote-amalfitaine/vietri-sul-mare/', label: 'Vietri sul Mare' },
            ].map(({ href, label }) => (
              <a href={href} class="flex items-center gap-2 px-3 py-2 rounded-xl text-xs sm:text-sm text-charcoal hover:bg-med-blue/5 hover:text-med-blue transition-colors">
                <span class="w-1.5 h-1.5 rounded-full bg-med-blue/30"></span> {label}
              </a>
            ))}
          </nav>
        </div>
      </aside>

    </div>
  </section>

  <CorrelationSlider
    heading="Explorer aussi sur la Côte Amalfitaine"
    items={[
      { name: 'Amalfi',   href: '/fr-fr/cote-amalfitaine/amalfi/',   tag: 'République Maritime', desc: 'La capitale historique avec la Cathédrale de Sant\'Andrea et le Musée du Papier.' },
      { name: 'Cetara',   href: '/fr-fr/cote-amalfitaine/cetara/',   tag: 'Village de Pêcheurs',  desc: 'Le village de pêcheurs et berceau de la colatura di alici AOP.' },
      { name: 'Vietri',   href: '/fr-fr/cote-amalfitaine/vietri-sul-mare/', tag: 'Céramiques',   desc: 'La porte de la Côte, célèbre pour ses céramiques artistiques.' },
      { name: 'Ravello',  href: '/fr-fr/cote-amalfitaine/ravello/',  tag: 'Musique & Jardins',   desc: 'Villa Rufolo, Villa Cimbrone et le Festival de Musique à 350 m.' },
      { name: 'Positano', href: '/fr-fr/cote-amalfitaine/positano/', tag: 'Mode & Vues',          desc: 'Les maisons colorées perchées sur la mer et la plage de Fornillo.' },
    ]}
    lang="fr-fr"
  />

</BaseLayout>
