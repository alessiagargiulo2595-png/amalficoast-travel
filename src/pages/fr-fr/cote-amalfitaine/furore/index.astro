---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import CorrelationSlider from '../../../../components/CorrelationSlider.astro';
import Breadcrumbs from '../../../../components/Breadcrumbs.astro';

const lang = 'fr-fr';

const breadcrumbs = [
  { name: 'Accueil', url: '/fr-fr/' },
  { name: 'Côte Amalfitaine', url: '/fr-fr/cote-amalfitaine/' },
  { name: 'Furore', url: '/fr-fr/cote-amalfitaine/furore/' },
];

const touristAttractionSchema = {
  "@context": "https://schema.org",
  "@type": "TouristAttraction",
  "name": "Furore",
  "description": "Furore est le village qui n'existe pas de la Côte Amalfitaine : sans vrai centre, les maisons s'accrochent à la montagne autour du célèbre Fjord de Furore, un canyon spectaculaire qui plonge dans la mer.",
  "url": "https://amalficoast-travel.com/fr-fr/cote-amalfitaine/furore/",
  "touristType": ["Nature", "Photographie", "Art", "Mer"],
  "address": { "@type": "PostalAddress", "addressLocality": "Furore", "addressRegion": "Salerne", "addressCountry": "IT", "postalCode": "84010" },
  "geo": { "@type": "GeoCoordinates", "latitude": 40.6264, "longitude": 14.5525 }
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Qu'est-ce que le Fjord de Furore ?",
      "acceptedAnswer": { "@type": "Answer", "text": "C'est une profonde crique naturelle (un fjord karstique) où le torrent Schiato se jette dans la mer à travers un canyon de 30 mètres. Un petit pont routier le surplombe, créant l'une des images les plus iconiques de la Côte. La plage au pied du fjord est accessible par un escalier." }
    },
    {
      "@type": "Question",
      "name": "Comment se rendre au Fjord de Furore ?",
      "acceptedAnswer": { "@type": "Answer", "text": "En bus SITA sur la ligne Amalfi-Positano (arrêt Furore Fiordo). En voiture, le fjord est sur la SS163 entre Praiano et Conca dei Marini : il y a un petit parking avant le pont. À pied, un escalier d'environ 200 marches descend jusqu'à la plage." }
    },
    {
      "@type": "Question",
      "name": "Pourquoi Furore est-il appelé le village qui n'existe pas ?",
      "acceptedAnswer": { "@type": "Answer", "text": "Parce que Furore n'a pas de centre historique traditionnel : les maisons, les églises et les boutiques sont disséminées le long de la route et accrochées à la montagne sans former un noyau compact. C'est une commune dispersée où chaque coin est un petit hameau en soi." }
    },
    {
      "@type": "Question",
      "name": "Peut-on se baigner au Fjord de Furore ?",
      "acceptedAnswer": { "@type": "Answer", "text": "Oui, la petite plage de galets au pied du fjord est baignable. L'eau est limpide et fraîche grâce au torrent. Arrivez tôt : l'espace est très limité et en été il se remplit rapidement. Il n'y a pas de services (ni bar, ni location de parasols)." }
    },
    {
      "@type": "Question",
      "name": "Que sont les fresques murales de Furore ?",
      "acceptedAnswer": { "@type": "Answer", "text": "Furore est un village peint (Paese Dipinto). Depuis les années 1980, des artistes italiens et internationaux ont réalisé des fresques sur les murs des maisons le long de la route. On en compte aujourd'hui plus de 100, transformant le bourg en une galerie d'art à ciel ouvert." }
    }
  ]
};

const schemas = [touristAttractionSchema, faqSchema];

const fastFacts = [
  { dt: 'Emplacement', dd: 'Côte Amalfitaine, SA' },
  { dt: 'Altitude', dd: '0-650 m' },
  { dt: 'Population', dd: '~800 habitants' },
  { dt: 'Depuis Amalfi', dd: '15 min (voiture/bus)' },
  { dt: 'Depuis Positano', dd: '10 min (voiture/bus)' },
  { dt: 'Plage', dd: 'Galets (Fjord)' },
  { dt: 'Spécialités', dd: 'Fresques, Fjord, vin' },
  { dt: 'Meilleure période', dd: 'Avr-Oct' },
  { dt: 'Idéal pour', dd: 'Photos, nature, art' },
];

const tips = [
  'La plus belle photo du Fjord se prend depuis le pont routier : arrivez tôt le matin quand le soleil illumine le canyon.',
  'La plage du Fjord est minuscule : en été, arrivez avant 9h ou vous ne trouverez plus de place.',
  'Promenez-vous le long de la SS163 en cherchant les fresques : il y en a plus de 100 et elles racontent l\'histoire du bourg.',
  'Chaque année en juillet se tient la Mediterranean Cup : des plongeurs professionnels sautent depuis le pont du Fjord (14 m).',
];
---

<BaseLayout
  title="Furore 2026 : Le Fjord, les Fresques Murales et le Village qui n'Existe Pas"
  description="Guide de Furore : le célèbre Fjord, les fresques du Village Peint, la plage cachée. Le bourg le plus insolite de la Côte Amalfitaine, sans centre mais avec une âme unique."
  lang={lang}
  breadcrumbs={breadcrumbs}
  schema={schemas}
  pageKey="furore"
>

  <!-- Hero -->
  <section class="relative h-[75vh] sm:h-[90vh] flex items-center bg-charcoal overflow-hidden">
    <img src="/images/fiordo-furore-hero.webp" alt="Le Fjord de Furore, Côte Amalfitaine" class="absolute inset-0 w-full h-full object-cover" loading="eager" referrerpolicy="no-referrer"/>
    <div class="absolute inset-0 bg-gradient-to-b from-black/10 via-black/40 to-black/80 z-10"></div>
    <div class="relative z-20 max-w-editorial mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <p class="text-med-gold text-xs sm:text-sm font-medium uppercase tracking-[0.3em] mb-3">Le Village Peint de la Côte</p>
        <h1 class="font-serif text-display text-white mb-4">Furore</h1>
        <p class="text-xl text-white/80 leading-relaxed max-w-2xl">
          Le village qui n'existe pas. Un fjord spectaculaire, 100+ fresques murales et des maisons accrochées à la montagne sans aucun centre.
        </p>
        <div class="flex flex-wrap gap-3 mt-8">
          <a href="#fast-facts" class="px-5 py-2.5 bg-med-gold text-white text-xs sm:text-sm font-semibold rounded-full hover:scale-105 hover:shadow-[0_8px_25px_rgba(212,175,55,0.4)] transition-all duration-300">Infos Pratiques</a>
          <a href="#fjord" class="px-5 py-2.5 bg-white/10 backdrop-blur text-white text-xs sm:text-sm font-medium rounded-full border border-white/20 hover:bg-white/20 transition-colors">Le Fjord</a>
          <a href="#faq" class="px-5 py-2.5 bg-white/10 backdrop-blur text-white text-xs sm:text-sm font-medium rounded-full border border-white/20 hover:bg-white/20 transition-colors">FAQ</a>
        </div>
      </div>
    </div>
    <Breadcrumbs breadcrumbs={breadcrumbs} />
  </section>

  <section class="max-w-editorial mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="grid lg:grid-cols-[1fr_320px] gap-12">

      <div class="space-y-16">

        <div class="prose-editorial">
          <p class="text-xl leading-relaxed text-charcoal">
            Furore est un paradoxe : une commune de la Côte Amalfitaine sans centre, un bourg célèbre pour un fjord qui est en réalité un canyon, un village de 800 âmes qui attire des photographes du monde entier. C'est l'endroit le plus insolite et le plus surprenant de toute la côte.
          </p>
          <p class="mt-4 text-slate-600 leading-relaxed">
            Les maisons de Furore sont disséminées le long de la SS163 et accrochées aux terrasses qui descendent vers la mer. Il n'y a pas de place, pas de front de mer : il n'y a que la roche, les citronniers, les fresques et ce fjord qui semble sorti d'un film. Le nom lui-même vient du latin <em>furor</em>, le fracas de la mer qui s'engouffre dans la gorge.
          </p>
        </div>

        <!-- Le saviez-vous ? -->
        <div class="bg-slate-900 border border-white/10 rounded-[3rem] p-8">
          <p class="text-[10px] uppercase tracking-[0.3em] text-med-gold font-medium mb-4">Le saviez-vous ?</p>
          <div class="grid sm:grid-cols-3 gap-6">
            <div class="text-center">
              <p class="font-serif text-5xl font-bold text-med-gold">100+</p>
              <p class="text-white/60 text-xs italic mt-1">fresques murales sur les maisons du bourg</p>
            </div>
            <div class="text-center">
              <p class="font-serif text-5xl font-bold text-med-gold">30 m</p>
              <p class="text-white/60 text-xs italic mt-1">profondeur du canyon du Fjord</p>
            </div>
            <div class="text-center">
              <p class="font-serif text-5xl font-bold text-med-gold">~800</p>
              <p class="text-white/60 text-xs italic mt-1">habitants, l'une des plus petites communes d'Italie</p>
            </div>
          </div>
        </div>

        <!-- Le Fjord -->
        <div id="fjord">
          <h2 class="font-serif text-3xl font-semibold text-slate-900 mb-6">Le Fjord de Furore</h2>
          <p class="text-slate-600 text-lg leading-relaxed mb-6">
            Le <strong>Fjord de Furore</strong> est l'attraction naturelle la plus photographiée de la Côte après Positano. Un canyon karstique où le torrent Schiato rencontre la mer, creusant une gorge profonde de 30 mètres dans la roche calcaire.
          </p>
          <div class="space-y-6">
            <div class="bg-white p-6 rounded-2xl border border-slate-100">
              <h3 class="font-bold text-slate-900 mb-2">La plage du Fjord</h3>
              <p class="text-slate-600 text-sm">Une petite langue de galets au pied du canyon, accessible par un escalier d'environ 200 marches depuis la SS163. Eau cristalline et fraîche, aucun service. Espace très limité : arrivée conseillée avant 9h en été.</p>
            </div>
            <div class="bg-white p-6 rounded-2xl border border-slate-100">
              <h3 class="font-bold text-slate-900 mb-2">Le pont et la vue</h3>
              <p class="text-slate-600 text-sm">Le pont routier qui surplombe le fjord offre la vue plongeante la plus iconique. Le matin tôt, la lumière pénètre dans le canyon en éclairant les barques échouées. Chaque année en juillet, lors de la Mediterranean Cup, des plongeurs professionnels sautent depuis le pont (14 m).</p>
            </div>
            <div class="bg-white p-6 rounded-2xl border border-slate-100">
              <h3 class="font-bold text-slate-900 mb-2">Les anciennes maisons de pêcheurs</h3>
              <p class="text-slate-600 text-sm">Au pied du fjord, on peut encore voir les anciennes maisons-grottes où vivaient les pêcheurs de Furore, creusées dans la roche et reliées par des escaliers raides. Certaines ont été restaurées et accueillent aujourd'hui des ateliers et des résidences artistiques.</p>
            </div>
          </div>
        </div>

        <!-- Que voir -->
        <div>
          <h2 class="font-serif text-3xl font-semibold text-slate-900 mb-8">Que voir à Furore</h2>
          <div class="space-y-8">
            {[
              { n: 1, title: 'Les Fresques du Village Peint', text: 'Depuis les années 1980, des artistes italiens et internationaux ont transformé Furore en une galerie à ciel ouvert. Plus de 100 fresques décorent murs, façades et escaliers tout au long de la route. Un parcours d\'art spontané et gratuit.' },
              { n: 2, title: 'Église San Giacomo', text: 'L\'église principale de Furore, perchée en hauteur avec une vue panoramique sur la mer et les vignobles. Simple et suggestive, elle représente le cœur spirituel d\'un bourg sans centre.' },
              { n: 3, title: 'Sentier de la Volpe Pescatrice', text: 'Un sentier qui relie le niveau de la mer à la partie haute du village à travers les anciennes terrasses. Panoramas spectaculaires sur la côte et sur le Fjord vu d\'en haut. Durée environ 1-2 heures.' },
              { n: 4, title: 'Vignobles de Furore', text: 'Le vin de Furore est parmi les plus prestigieux de l\'AOC Costa d\'Amalfi. Les vignobles extrêmes, suspendus à la roche à pic sur la mer, produisent le célèbre Fiorduva de Marisa Cuomo, l\'un des blancs les plus recherchés d\'Italie.' },
            ].map(({ n, title, text }) => (
              <div class="grid sm:grid-cols-[auto_1fr] gap-4">
                <div class="w-14 h-14 rounded-[1rem] bg-med-gold/10 flex items-center justify-center flex-shrink-0 text-med-gold font-serif font-bold text-xl">{n}</div>
                <div>
                  <h3 class="font-semibold text-charcoal text-lg mb-1">{title}</h3>
                  <p class="text-slate-600 leading-relaxed">{text}</p>
                </div>
              </div>
            ))}
          </div>
        </div>

        <!-- Conseil Local -->
        <div class="relative overflow-hidden rounded-[3rem] bg-med-blue p-10 md:p-14 text-white shadow-2xl">
          <div class="relative z-10 flex flex-col md:flex-row items-start md:items-center gap-8">
            <div class="w-20 h-20 rounded-2xl bg-white/10 flex items-center justify-center flex-shrink-0 border border-white/20"><svg class="w-10 h-10 text-med-gold" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 3v2.25m6.364.386-1.591 1.591M21 12h-2.25m-.386 6.364-1.591-1.591M12 18.75V21m-4.773-4.227-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0Z"/></svg></div>
            <div>
              <p class="text-med-gold text-xs font-bold uppercase tracking-[0.3em] mb-2">Conseil Local</p>
              <h3 class="font-serif text-2xl font-bold text-white mb-3 tracking-tight">Le Fiorduva de Marisa Cuomo</h3>
              <p class="text-white/70 leading-relaxed">Si vous aimez le vin, cherchez le Fiorduva : un blanc produit à partir de raisins cueillis à la main sur les terrasses à pic sur le Fjord. C'est l'un des vins les plus primés de Campanie et il ne se trouve qu'ici et dans quelques rares caves sélectionnées.</p>
            </div>
          </div>
          <div class="absolute bottom-0 left-0 translate-y-1/2 -translate-x-1/2 w-80 h-80 bg-med-gold/10 rounded-full blur-3xl pointer-events-none"></div>
        </div>

        <!-- FAQ -->
        <div id="faq">
          <h2 class="font-serif text-3xl font-semibold text-slate-900 mb-8">Questions fréquentes sur Furore</h2>
          <div class="space-y-4">
            {faqSchema.mainEntity.map((q) => (
              <details class="group border border-slate-200 rounded-2xl overflow-hidden">
                <summary class="flex items-center justify-between px-6 py-4 cursor-pointer select-none text-charcoal font-medium hover:bg-slate-50 transition-colors">
                  {q.name}
                  <svg class="w-4 h-4 text-slate-400 group-open:rotate-180 transition-transform flex-shrink-0 ml-3" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
                </summary>
                <div class="px-6 pb-5 text-slate-600 leading-relaxed text-xs sm:text-sm border-t border-slate-100 pt-4">
                  {q.acceptedAnswer.text}
                </div>
              </details>
            ))}
          </div>
        </div>

      </div>

      <aside class="space-y-6 lg:sticky lg:top-24 self-start">
        <div id="fast-facts" class="bg-slate-900 text-white rounded-[3rem] p-6">
          <p class="text-[10px] uppercase tracking-[0.3em] text-med-gold font-medium mb-4">Infos Pratiques - Furore</p>
          <dl class="space-y-3">
            {fastFacts.map(({ dt, dd }, i) => (
              <>
                <div class="flex justify-between items-start gap-3">
                  <dt class="text-white/40 text-xs sm:text-sm font-light flex-shrink-0">{dt}</dt>
                  <dd class="text-white font-medium text-xs sm:text-sm text-right">{dd}</dd>
                </div>
                {i < fastFacts.length - 1 && <div class="border-t border-white/5"></div>}
              </>
            ))}
          </dl>
        </div>

        <div class="bg-med-cream border border-med-gold/30 rounded-[2rem] p-6">
          <p class="text-[10px] uppercase tracking-[0.3em] text-med-gold font-medium mb-3">Conseils d'initiés</p>
          <ul class="space-y-3">
            {tips.map(tip => (
              <li class="flex items-start gap-2 text-xs sm:text-sm text-charcoal">
                <span class="w-1.5 h-1.5 rounded-full bg-med-gold mt-1.5 flex-shrink-0"></span>
                <span>{tip}</span>
              </li>
            ))}
          </ul>
        </div>

        <div class="bg-white border border-slate-100 rounded-[2rem] p-6 shadow-sm">
          <p class="text-[10px] uppercase tracking-[0.3em] text-slate-400 font-medium mb-3">Explorer la Côte</p>
          <nav class="space-y-1">
            {[
              { href: '/fr-fr/cote-amalfitaine/conca-dei-marini/', label: 'Conca dei Marini' },
              { href: '/fr-fr/cote-amalfitaine/praiano/', label: 'Praiano' },
              { href: '/fr-fr/cote-amalfitaine/agerola/', label: 'Agerola' },
              { href: '/fr-fr/cote-amalfitaine/amalfi/', label: 'Amalfi' },
              { href: '/fr-fr/cote-amalfitaine/positano/', label: 'Positano' },
            ].map(({ href, label }) => (
              <a href={href} class="flex items-center gap-2 px-3 py-2 rounded-xl text-xs sm:text-sm text-charcoal hover:bg-med-blue/5 hover:text-med-blue transition-colors">
                <span class="w-1.5 h-1.5 rounded-full bg-med-blue/30"></span> {label}
              </a>
            ))}
          </nav>
        </div>
      </aside>

    </div>
  </section>

  <CorrelationSlider
    heading="Explorer aussi sur la Côte Amalfitaine"
    items={[
      { name: 'Conca dei Marini', href: '/fr-fr/cote-amalfitaine/conca-dei-marini/', tag: 'Grotte & Sfogliatella', desc: 'La Grotte d\'Émeraude et la patrie de la sfogliatella Santa Rosa.' },
      { name: 'Praiano',  href: '/fr-fr/cote-amalfitaine/praiano/',  tag: 'Coucher de Soleil & Calme', desc: 'Le coucher de soleil depuis San Gennaro et la plage Gavitella.' },
      { name: 'Agerola',  href: '/fr-fr/cote-amalfitaine/agerola/',  tag: 'Randonnée & Nature',       desc: 'Sentier des Dieux, Fior di Latte et panoramas à 600 m.' },
      { name: 'Positano', href: '/fr-fr/cote-amalfitaine/positano/', tag: 'Mode & Vues',               desc: 'Les maisons colorées perchées sur la mer de la Côte.' },
      { name: 'Amalfi',   href: '/fr-fr/cote-amalfitaine/amalfi/',   tag: 'République Maritime',      desc: 'La capitale historique avec la Cathédrale et le Musée du Papier.' },
    ]}
    lang="fr-fr"
  />

</BaseLayout>
