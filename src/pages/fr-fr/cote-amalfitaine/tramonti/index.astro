---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import CorrelationSlider from '../../../../components/CorrelationSlider.astro';
import Breadcrumbs from '../../../../components/Breadcrumbs.astro';

const lang = 'fr-fr';

const breadcrumbs = [
  { name: 'Accueil', url: '/fr-fr/' },
  { name: 'Côte Amalfitaine', url: '/fr-fr/cote-amalfitaine/' },
  { name: 'Tramonti', url: '/fr-fr/cote-amalfitaine/tramonti/' },
];

const touristAttractionSchema = {
  "@context": "https://schema.org",
  "@type": "TouristAttraction",
  "name": "Tramonti",
  "description": "Tramonti est le poumon vert de la Côte Amalfitaine, une commune composée de 13 hameaux épars parmi vignobles, citronniers et anciennes églises. Terre de vins Costa d'Amalfi DOC, de pizza et de traditions rurales.",
  "url": "https://amalficoast-travel.com/fr-fr/cote-amalfitaine/tramonti/",
  "touristType": ["Œnotourisme", "Nature", "Authenticité", "Traditions"],
  "address": { "@type": "PostalAddress", "addressLocality": "Tramonti", "addressRegion": "Salerne", "addressCountry": "IT", "postalCode": "84010" },
  "geo": { "@type": "GeoCoordinates", "latitude": 40.6933, "longitude": 14.6333 }
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Comment se rendre à Tramonti ?",
      "acceptedAnswer": { "@type": "Answer", "text": "En voiture : par le Col de Chiunzi (SS373) depuis Angri/Nocera, environ 20 min depuis l'autoroute A3. En bus SITA : depuis Amalfi ou Maiori (environ 30 min). Il n'y a pas de gare ferroviaire. La voiture est le moyen le plus pratique car les 13 hameaux sont dispersés." }
    },
    {
      "@type": "Question",
      "name": "Pourquoi Tramonti est-elle célèbre pour la pizza ?",
      "acceptedAnswer": { "@type": "Answer", "text": "Tramonti est considérée comme l'un des berceaux de la pizza napolitaine. De nombreux pizzaïolos émigrés de Tramonti ont ouvert des pizzerias dans le monde entier. La tradition locale prévoit l'utilisation d'ingrédients de proximité : tomate locale, Fior di Latte des fromageries du territoire et huile d'olive des collines." }
    },
    {
      "@type": "Question",
      "name": "Quels vins sont produits à Tramonti ?",
      "acceptedAnswer": { "@type": "Answer", "text": "Tramonti est la principale zone de production vinicole AOC Costa d'Amalfi sous-zone Tramonti. On y produit des blancs avec des cépages Falanghina, Biancolella et Pepella, et des rouges avec le Tintore di Tramonti (Piedirosso). Des caves comme Apicella, Reale et Monte di Grazia proposent des dégustations sur réservation." }
    },
    {
      "@type": "Question",
      "name": "Tramonti mérite-t-elle une visite ?",
      "acceptedAnswer": { "@type": "Answer", "text": "Absolument, surtout pour ceux qui cherchent l'authenticité. Aucun tourisme de masse, des prix très bas, une nature préservée et une gastronomie exceptionnelle. C'est l'antithèse de la Côte touristique : ici on vit comme il y a 50 ans." }
    },
    {
      "@type": "Question",
      "name": "Que voir à Tramonti ?",
      "acceptedAnswer": { "@type": "Answer", "text": "Le Conservatoire de San Giuseppe (fresques du XVIIe s.), les 13 hameaux épars avec leurs églises, les vignobles en terrasses où est produit le vin Costa d'Amalfi AOC, le Col de Chiunzi avec son panorama, et les sentiers naturels vers les Monti Lattari." }
    }
  ]
};

const schemas = [touristAttractionSchema, faqSchema];

const fastFacts = [
  { dt: 'Emplacement', dd: 'Arrière-pays côtier, SA' },
  { dt: 'Altitude', dd: '300-800 m' },
  { dt: 'Population', dd: '~4 000 habitants' },
  { dt: 'Hameaux', dd: '13 bourgs dispersés' },
  { dt: 'Depuis Amalfi', dd: '30 min (bus/voiture)' },
  { dt: 'Accès voiture', dd: 'Col de Chiunzi' },
  { dt: 'Spécialités', dd: 'Vin AOC, pizza, Fior di Latte' },
  { dt: 'Meilleure période', dd: 'Avr-Oct' },
  { dt: 'Idéal pour', dd: 'Œnotourisme, nature' },
];

const tips = [
  'Réservez une dégustation en cave : Apicella (la plus ancienne de la Côte, depuis 1870) ou Monte di Grazia pour le Tintore.',
  'Le Col de Chiunzi est le point le plus haut accessible en voiture : la vue sur la Vallée du Sarno et le Vésuve est extraordinaire.',
  'Les pizzerias de Tramonti sont celles que préfèrent les locaux de la Côte, pas les touristes : prix bas et qualité exceptionnelle.',
  'En automne (octobre) se tient la Sagra della Castagna : produits locaux, vin et atmosphère authentique dans les hameaux.',
];
---

<BaseLayout
  title="Tramonti 2026 : Le Poumon Vert de la Côte Amalfitaine"
  description="Guide de Tramonti : vins Costa d'Amalfi AOC, 13 hameaux authentiques, pizza traditionnelle, sentiers sur les Monti Lattari. L'arrière-pays secret de la Côte Amalfitaine."
  lang={lang}
  breadcrumbs={breadcrumbs}
  schema={schemas}
  pageKey="tramonti"
>

  <!-- Hero -->
  <section class="relative h-[75vh] sm:h-[90vh] flex items-center bg-charcoal overflow-hidden">
    <img src="/images/tramonti-hero.webp" alt="Tramonti, le poumon vert de la Côte Amalfitaine" class="absolute inset-0 w-full h-full object-cover" loading="eager" fetchpriority="high" decoding="sync" referrerpolicy="no-referrer"/>
    <div class="absolute inset-0 bg-gradient-to-b from-black/10 via-black/40 to-black/80 z-10"></div>
    <div class="relative z-20 max-w-editorial mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <p class="text-med-gold text-xs sm:text-sm font-medium uppercase tracking-[0.3em] mb-3">Arrière-pays de la Côte Amalfitaine</p>
        <h1 class="font-serif text-display text-white mb-4">Tramonti</h1>
        <p class="text-xl text-white/80 leading-relaxed max-w-2xl">
          Le poumon vert de la Côte. Vins AOC, pizza authentique et 13 hameaux où le temps s'est arrêté.
        </p>
        <div class="flex flex-wrap gap-3 mt-8">
          <a href="#fast-facts" class="px-5 py-2.5 bg-med-gold text-white text-xs sm:text-sm font-semibold rounded-full hover:scale-105 hover:shadow-[0_8px_25px_rgba(212,175,55,0.4)] transition-all duration-300">Infos Pratiques</a>
          <a href="#vins" class="px-5 py-2.5 bg-white/10 backdrop-blur text-white text-xs sm:text-sm font-medium rounded-full border border-white/20 hover:bg-white/20 transition-colors">Vins AOC</a>
          <a href="#faq" class="px-5 py-2.5 bg-white/10 backdrop-blur text-white text-xs sm:text-sm font-medium rounded-full border border-white/20 hover:bg-white/20 transition-colors">FAQ</a>
        </div>
      </div>
    </div>
    <Breadcrumbs breadcrumbs={breadcrumbs} />
  </section>

  <section class="max-w-editorial mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="grid lg:grid-cols-[1fr_320px] gap-12">

      <div class="space-y-16">

        <div class="prose-editorial">
          <p class="text-xl leading-relaxed text-charcoal">
            Tramonti, c'est la Côte Amalfitaine que l'on n'attendait pas. Pas de mer, pas de touristes, pas de files d'attente : seulement des collines en terrasses, des vignobles qui défient la gravité, 13 hameaux épars reliés par des routes étroites et une tradition gastronomique qui rivalise avec n'importe quelle destination gourmet d'Italie.
          </p>
          <p class="mt-4 text-slate-600 leading-relaxed">
            Le nom lui-même raconte sa nature : <em>tra i monti</em>, entre les montagnes. Accessible depuis le <strong>Col de Chiunzi</strong> (l'un des passages les plus spectaculaires de Campanie), Tramonti est le berceau du vin <strong>Costa d'Amalfi AOC</strong> et de la tradition pizzaïole qui a conquis le monde.
          </p>
        </div>

        <!-- Le saviez-vous ? -->
        <div class="bg-slate-900 border border-white/10 rounded-[3rem] p-8">
          <p class="text-[10px] uppercase tracking-[0.3em] text-med-gold font-medium mb-4">Le saviez-vous ?</p>
          <div class="grid sm:grid-cols-3 gap-6">
            <div class="text-center">
              <p class="font-serif text-5xl font-bold text-med-gold">13</p>
              <p class="text-white/60 text-xs italic mt-1">hameaux épars, chacun avec son église</p>
            </div>
            <div class="text-center">
              <p class="font-serif text-5xl font-bold text-med-gold">1870</p>
              <p class="text-white/60 text-xs italic mt-1">année de fondation de la Cave Apicella</p>
            </div>
            <div class="text-center">
              <p class="font-serif text-5xl font-bold text-med-gold">AOC</p>
              <p class="text-white/60 text-xs italic mt-1">Costa d'Amalfi sous-zone Tramonti</p>
            </div>
          </div>
        </div>

        <!-- Les Vins -->
        <div id="vins">
          <h2 class="font-serif text-3xl font-semibold text-slate-900 mb-6">Les Vins de Tramonti</h2>
          <p class="text-slate-600 text-lg leading-relaxed mb-6">
            Tramonti est le cœur de la production vinicole de la Côte Amalfitaine. Les vignobles en terrasses, exposés au sud entre 200 et 600 m d'altitude, produisent des cépages uniques.
          </p>
          <div class="space-y-6">
            <div class="bg-med-gold/10 p-6 rounded-2xl border border-med-gold/20">
              <h3 class="font-bold text-slate-900 mb-2 text-lg">Tintore di Tramonti</h3>
              <p class="text-slate-600 leading-relaxed">Le cépage rouge autochtone le plus important : produit des vins intenses, tanniques, de couleur profonde presque noire. C'est un clone local du Piedirosso, mais avec des caractéristiques uniques dues à l'altitude et au sol volcanique.</p>
            </div>
            <div class="bg-med-gold/10 p-6 rounded-2xl border border-med-gold/20">
              <h3 class="font-bold text-slate-900 mb-2 text-lg">Blancs et Rosés</h3>
              <p class="text-slate-600 leading-relaxed">Falanghina, Biancolella et la rare Pepella produisent des blancs frais et minéraux. Les rosés de Piedirosso se marient parfaitement avec le poisson. Caves à visiter : Apicella, Reale, Monte di Grazia, Tenuta San Francesco.</p>
            </div>
          </div>
        </div>

        <!-- Que voir -->
        <div>
          <h2 class="font-serif text-3xl font-semibold text-slate-900 mb-8">Que voir à Tramonti</h2>
          <div class="space-y-8">
            {[
              { n: 1, title: 'Conservatoire de San Giuseppe e Teresa', text: 'Le monument le plus important de Tramonti, avec des fresques du XVIIe siècle et un orgue historique. Situé dans le hameau de Polvica, visitable sur demande. Un joyau oublié.' },
              { n: 2, title: 'Les 13 hameaux', text: 'Chaque hameau a son église, son identité et ses traditions. Les plus caractéristiques : Gete (panoramique), Corsano (avec le château), Campinola (avec l\'église de San Michele), Polvica (avec le Conservatoire).' },
              { n: 3, title: 'Col de Chiunzi', text: 'Le col de montagne à 656 m qui sépare la Côte de l\'Agro Nocerino. La vue sur la Vallée du Sarno, le Vésuve et la plaine campanienne est spectaculaire, surtout au coucher du soleil.' },
              { n: 4, title: 'Sentiers et nature', text: 'Tramonti est traversée par des sentiers CAI qui relient les hameaux et mènent vers les Monti Lattari. Forêts de châtaigniers, noisetiers et terrasses agricoles : un paysage rural intact.' },
            ].map(({ n, title, text }) => (
              <div class="grid sm:grid-cols-[auto_1fr] gap-4">
                <div class="w-14 h-14 rounded-[1rem] bg-med-gold/10 flex items-center justify-center flex-shrink-0 text-med-gold font-serif font-bold text-xl">{n}</div>
                <div>
                  <h3 class="font-semibold text-charcoal text-lg mb-1">{title}</h3>
                  <p class="text-slate-600 leading-relaxed">{text}</p>
                </div>
              </div>
            ))}
          </div>
        </div>

        <!-- Conseil Local -->
        <div class="relative overflow-hidden rounded-[3rem] bg-med-blue p-10 md:p-14 text-white shadow-2xl">
          <div class="relative z-10 flex flex-col md:flex-row items-start md:items-center gap-8">
            <div class="w-20 h-20 rounded-2xl bg-white/10 flex items-center justify-center flex-shrink-0 border border-white/20"><svg class="w-10 h-10 text-med-gold" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 3v2.25m6.364.386-1.591 1.591M21 12h-2.25m-.386 6.364-1.591-1.591M12 18.75V21m-4.773-4.227-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0Z"/></svg></div>
            <div>
              <p class="text-med-gold text-xs font-bold uppercase tracking-[0.3em] mb-2">Conseil Local</p>
              <h3 class="font-serif text-2xl font-bold text-white mb-3 tracking-tight">La pizza de Tramonti</h3>
              <p class="text-white/70 leading-relaxed">Tramonti est la patrie des pizzaïolos : des centaines de familles de Tramonti gèrent des pizzerias dans le monde entier. Les pizzerias locales utilisent du Fior di Latte frais et des tomates du jardin : qualité exceptionnelle à des prix que l'on ne trouve plus sur la côte.</p>
            </div>
          </div>
          <div class="absolute bottom-0 left-0 translate-y-1/2 -translate-x-1/2 w-80 h-80 bg-med-gold/10 rounded-full blur-3xl pointer-events-none"></div>
        </div>

        <!-- FAQ -->
        <div id="faq">
          <h2 class="font-serif text-3xl font-semibold text-slate-900 mb-8">Questions fréquentes sur Tramonti</h2>
          <div class="space-y-4">
            {faqSchema.mainEntity.map((q) => (
              <details class="group border border-slate-200 rounded-2xl overflow-hidden">
                <summary class="flex items-center justify-between px-6 py-4 cursor-pointer select-none text-charcoal font-medium hover:bg-slate-50 transition-colors">
                  {q.name}
                  <svg class="w-4 h-4 text-slate-400 group-open:rotate-180 transition-transform flex-shrink-0 ml-3" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
                </summary>
                <div class="px-6 pb-5 text-slate-600 leading-relaxed text-xs sm:text-sm border-t border-slate-100 pt-4">
                  {q.acceptedAnswer.text}
                </div>
              </details>
            ))}
          </div>
        </div>

      </div>

      <aside class="space-y-6 lg:sticky lg:top-24 self-start">
        <div id="fast-facts" class="bg-slate-900 text-white rounded-[3rem] p-6">
          <p class="text-[10px] uppercase tracking-[0.3em] text-med-gold font-medium mb-4">Infos Pratiques - Tramonti</p>
          <dl class="space-y-3">
            {fastFacts.map(({ dt, dd }, i) => (
              <>
                <div class="flex justify-between items-start gap-3">
                  <dt class="text-white/40 text-xs sm:text-sm font-light flex-shrink-0">{dt}</dt>
                  <dd class="text-white font-medium text-xs sm:text-sm text-right">{dd}</dd>
                </div>
                {i < fastFacts.length - 1 && <div class="border-t border-white/5"></div>}
              </>
            ))}
          </dl>
        </div>

        <div class="bg-med-cream border border-med-gold/30 rounded-[2rem] p-6">
          <p class="text-[10px] uppercase tracking-[0.3em] text-med-gold font-medium mb-3">Conseils d'initiés</p>
          <ul class="space-y-3">
            {tips.map(tip => (
              <li class="flex items-start gap-2 text-xs sm:text-sm text-charcoal">
                <span class="w-1.5 h-1.5 rounded-full bg-med-gold mt-1.5 flex-shrink-0"></span>
                <span>{tip}</span>
              </li>
            ))}
          </ul>
        </div>

        <div class="bg-white border border-slate-100 rounded-[2rem] p-6 shadow-sm">
          <p class="text-[10px] uppercase tracking-[0.3em] text-slate-400 font-medium mb-3">Explorer la Côte</p>
          <nav class="space-y-1">
            {[
              { href: '/fr-fr/cote-amalfitaine/agerola/', label: 'Agerola' },
              { href: '/fr-fr/cote-amalfitaine/ravello/', label: 'Ravello' },
              { href: '/fr-fr/cote-amalfitaine/maiori/', label: 'Maiori' },
              { href: '/fr-fr/cote-amalfitaine/minori/', label: 'Minori' },
              { href: '/fr-fr/cote-amalfitaine/amalfi/', label: 'Amalfi' },
            ].map(({ href, label }) => (
              <a href={href} class="flex items-center gap-2 px-3 py-2 rounded-xl text-xs sm:text-sm text-charcoal hover:bg-med-blue/5 hover:text-med-blue transition-colors">
                <span class="w-1.5 h-1.5 rounded-full bg-med-blue/30"></span> {label}
              </a>
            ))}
          </nav>
        </div>
      </aside>

    </div>
  </section>

  <CorrelationSlider
    heading="Explorer aussi sur la Côte Amalfitaine"
    items={[
      { name: 'Agerola',  href: '/fr-fr/cote-amalfitaine/agerola/',  tag: 'Randonnée & Nature',  desc: 'Sentier des Dieux, Fior di Latte et panoramas à 600 m.' },
      { name: 'Ravello',  href: '/fr-fr/cote-amalfitaine/ravello/',  tag: 'Musique & Jardins',   desc: 'Villa Rufolo, Villa Cimbrone et le Festival de Musique.' },
      { name: 'Maiori',   href: '/fr-fr/cote-amalfitaine/maiori/',   tag: 'Plage & Détente',     desc: 'La plus longue plage de sable de la côte : 300 m.' },
      { name: 'Minori',   href: '/fr-fr/cote-amalfitaine/minori/',   tag: 'Saveurs & Culture',   desc: 'Villa romaine et scialatielli frais.' },
      { name: 'Furore',   href: '/fr-fr/cote-amalfitaine/furore/',   tag: 'Le village qui n\'existe pas', desc: 'Le Fjord spectaculaire et le village peint.' },
    ]}
    lang="fr-fr"
  />

</BaseLayout>
