---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../../components/Breadcrumbs.astro';
import CorrelationSlider from '../../../../components/CorrelationSlider.astro';

const lang = 'fr-fr';

const breadcrumbs = [
  { name: 'Accueil', url: '/fr-fr/' },
  { name: 'Plages', url: '/fr-fr/plages/' },
  { name: 'Marina di Praia', url: '/fr-fr/plages/cote-amalfitaine/marina-di-praia/' },
];

const facts = [
  { label: 'Revêtement', value: 'Sable et galets' },
  { label: 'Accès', value: 'Escaliers dans la roche (50 marches)' },
  { label: 'Ombre', value: 'À partir de 15h00' },
  { label: 'Équipements', value: 'Plage publique' },
  { label: 'Idéal pour', value: 'Coucher de soleil, snorkeling, tranquillité' },
  { label: 'Tour historique', value: 'Torre a Mare (XVIe s.)' },
  { label: 'Profondeur plongée', value: "Jusqu'à 25 mètres" },
  { label: 'Club nocturne', value: 'Africana (grotte naturelle, depuis 1963)' },
  { label: 'Nom original', value: '"Plaga" (latin : rive de la mer)' },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Comment accéder à Marina di Praia ?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Marina di Praia est accessible depuis le centre de Praiano en descendant environ 50 marches taillées directement dans la roche, le long de la via Mare. Le parcours dure environ 5 minutes à pied. Il est conseillé de porter des chaussures confortables. En alternative, il est possible d'arriver par la mer en taxi-boat depuis Praiano ou depuis Marina Grande di Positano (15–20 € par personne)."
      }
    },
    {
      "@type": "Question",
      "name": "Qu'est-ce que l'Africana Famous Club de Praiano ?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "L'Africana Famous Club est une discothèque légendaire creusée dans une grotte naturelle dans la falaise à côté de Marina di Praia. Ouverte en 1963, elle fut fréquentée par Jackie Kennedy, Sophia Loren et Federico Fellini. La piste de danse possède un plancher en verre qui laisse voir la mer en dessous. Elle est encore active en été et reste l'une des expériences nocturnes les plus uniques de la Côte Amalfitaine."
      }
    },
    {
      "@type": "Question",
      "name": "À quelle heure est le meilleur coucher de soleil à Marina di Praia ?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Le coucher de soleil à Marina di Praia est l'un des plus beaux de la Côte. La plage est exposée à l'ouest, donc le soleil descend directement sur l'horizon marin. La meilleure heure est vers 18h30–19h00 en été (juin–septembre), quand la lumière illumine les parois rocheuses de teintes roses et dorées. Apportez votre appareil photo et arrivez au moins 30 minutes avant."
      }
    },
    {
      "@type": "Question",
      "name": "Peut-on plonger à Marina di Praia ?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Oui, Marina di Praia est l'un des meilleurs spots de plongée de toute la Côte Amalfitaine. La paroi sous-marine descend jusqu'à 25 mètres avec des grottes, des murènes, des mérous et des pieuvres. Les plongées nocturnes sont très populaires en été. Certains centres de plongée locaux organisent des sorties guidées aussi bien pour débutants que pour plongeurs expérimentés."
      }
    },
    {
      "@type": "Question",
      "name": "Y a-t-il une plage publique à Marina di Praia ?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Oui, Marina di Praia est entièrement une plage publique : il n'y a pas d'établissements de bains ni de transats payants. Apportez tout le nécessaire (serviette, parasol, nourriture et eau) car les équipements sont minimaux. C'est là toute sa magie : elle offre une expérience authentique, loin de la foule commerciale de la Côte."
      }
    }
  ]
};

const beachSchema = {
  "@context": "https://schema.org",
  "@type": "Beach",
  "name": "Marina di Praia",
  "description": "Une plage sauvage et intime de Praiano, cachée derrière des escaliers taillés dans la roche. Sable doré et eaux transparentes loin de la foule.",
  "address": {
    "@type": "PostalAddress",
    "addressLocality": "Praiano",
    "addressRegion": "SA",
    "addressCountry": "IT"
  }
};

const nearbyBeaches = [
  { name: 'Fiordo di Furore', href: '/fr-fr/plages/cote-amalfitaine/fiordo-di-furore/', tag: 'Furore', desc: 'Le fjord le plus iconique enchâssé dans la roche.' },
  { name: 'Spiaggia Grande', href: '/fr-fr/plages/cote-amalfitaine/spiaggia-grande-positano/', tag: 'Positano', desc: 'Le cœur glamour de la Côte Amalfitaine.' },
  { name: 'Santa Croce', href: '/fr-fr/plages/cote-amalfitaine/santa-croce-amalfi/', tag: 'Mer uniquement', desc: "L'escapade secrète avec restaurants historiques." },
  { name: 'Cala Mitigliano', href: '/fr-fr/plages/peninsule-sorrentine/cala-mitigliano/', tag: 'Massa Lubrense', desc: 'Sauvage et intime, 300 marches vers le paradis.' },
];
---

<BaseLayout
  title="Marina di Praia : La Plage Secrète de Praiano"
  description="Marina di Praia à Praiano : la plage cachée accessible par des escaliers taillés dans la roche. Coucher de soleil parfait, eaux cristallines, loin de la foule de la Côte."
  lang={lang}
  breadcrumbs={breadcrumbs}
  schema={[beachSchema, faqSchema]}
  pageKey="marina-di-praia">

  <!-- Hero -->
  <section class="relative h-[52.5vh] sm:h-[70vh] overflow-hidden flex items-center justify-center">
    <img
      src="/images/praia-hero.jpg"
      alt="Marina di Praia, Praiano"
      class="absolute inset-0 w-full h-full object-cover"
      loading="eager"
      referrerpolicy="no-referrer"
    />
    <div class="absolute inset-0 hidden sm:block bg-gradient-to-b from-black/20 via-black/35 to-black/70"></div>
    <div class="relative z-10 text-center px-6 max-w-4xl text-white">
      <p class="text-med-gold text-xs sm:text-sm font-medium uppercase tracking-[0.3em] mb-3">Praiano · Sauvage et Authentique</p>
      <h1 class="font-serif text-display text-white mb-6">Marina di Praia</h1>
      <p class="text-lg md:text-xl font-light text-white/80">Une plage secrète accessible par des escaliers taillés dans la roche, avec le plus beau coucher de soleil de la Côte.</p>
    </div>
    <Breadcrumbs breadcrumbs={breadcrumbs} />
  </section>

  <!-- Contenu + Sidebar -->
  <section class="bg-med-cream py-24 px-6">
    <div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-3 gap-16">

      <!-- Texte principal -->
      <div class="lg:col-span-2 space-y-12">
        <div>
          <h2 class="font-serif text-4xl font-bold text-slate-900 mb-6">Au-delà de la Foule</h2>
          <p class="text-slate-600 text-lg leading-relaxed mb-6">
            Marina di Praia est le secret le mieux gardé de <a href="/fr-fr/cote-amalfitaine/praiano/" class="text-med-blue hover:underline">Praiano</a>. On ne la trouve pas sur la carte touristique principale, car elle n'est accessible que par une courte série de marches taillées directement dans la roche. Ce que l'on découvre de l'autre côté ? Une plage de sable doré et de galets, aux eaux turquoise, avec presque personne.
          </p>
          <p class="text-slate-600 text-lg leading-relaxed">
            C'est l'endroit parfait pour fuir la foule de la <a href="/fr-fr/cote-amalfitaine/" class="text-med-blue hover:underline">Côte Amalfitaine</a> sans renoncer aux eaux cristallines de Praiano. Au coucher du soleil, la lumière illumine les parois rocheuses au-dessus de la plage : la meilleure heure est vers 19h00 d'avril à septembre, quand la lumière est presque horizontale et l'eau reflète des teintes de rose et d'or.
          </p>
        </div>

        <!-- Coucher de soleil -->
        <div class="bg-white p-8 rounded-[2rem] shadow-xl border border-slate-100">
          <div class="flex items-center gap-4 mb-4">
            <svg class="w-6 h-6 text-med-gold flex-shrink-0" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M21 12.79A6 6 0 0 0 17.21 3 7 7 0 0 0 12 19a7 7 0 0 0 5.21-2.79"/></svg>
            <h3 class="text-xl font-bold">Le Coucher de Soleil Parfait</h3>
          </div>
          <p class="text-slate-600 leading-relaxed">
            Marina di Praia offre l'un des plus beaux couchers de soleil de la Côte. Arrivez vers <strong>18h30 (été)</strong> et vous aurez de la lumière jusqu'à 19h30. La plage est exposée à l'ouest, donc le soleil descend directement au-dessus de l'horizon marin. Apportez votre appareil photo.
          </p>
        </div>

        <!-- Histoire -->
        <div>
          <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">Histoire : Tour, Pirates et un Nom Ancien</h2>
          <p class="text-slate-600 text-lg leading-relaxed mb-6">
            Au Moyen Âge, Marina di Praia était un village de pêcheurs animé, l'un des nombreux mouillages cachés le long de la Côte. Le nom « Praia » vient du latin <em>plaga</em> — rive, rivage — et représente l'un des toponymes les plus anciens de la côte. Praiano lui-même, selon certains historiens, dérive de <em>prai-ano</em>, c'est-à-dire « mer ouverte ».
          </p>
          <p class="text-slate-600 text-lg leading-relaxed mb-6">
            Au XVIe siècle fut érigée la <strong>Torre a Mare</strong>, une tour de guet construite pour défendre la population contre les incursions des pirates sarrasins qui sillonnaient tout le Tyrrhénien. La tour est encore visible aujourd'hui, perchée sur la falaise au-dessus de la plage, et reste l'un des signes les plus visibles de l'histoire défensive de la Côte Amalfitaine.
          </p>
          <p class="text-slate-600 text-lg leading-relaxed">
            La configuration géologique de la baie est le résultat de millénaires d'érosion : l'anse étroite a été creusée par la mer entre deux parois de roche calcaire. La falaise en surplomb crée un abri naturel contre le soleil de l'après-midi — un avantage non négligeable pendant les chauds étés campaniens — et révèle dans son profil des millions d'années d'histoire géologique stratifiée.
          </p>
        </div>

        <!-- Africana -->
        <div class="bg-white p-8 rounded-[2rem] shadow-xl border border-slate-100">
          <div class="flex items-center gap-4 mb-4">
            <svg class="w-6 h-6 text-med-gold flex-shrink-0" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M9 18V5l12-2v13"/><circle cx="6" cy="18" r="3"/><circle cx="18" cy="16" r="3"/></svg>
            <h3 class="text-xl font-bold">L'Africana Famous Club : La Grotte des VIP</h3>
          </div>
          <p class="text-slate-600 leading-relaxed mb-4">
            À côté de la plage, creusée dans la roche vive de la falaise, se trouve l'une des discothèques les plus légendaires d'Italie : l'<strong>Africana Famous Club</strong>. Ouverte en 1963, elle devint rapidement le lieu de rendez-vous préféré de Jackie Kennedy, Sophia Loren et Federico Fellini. La caractéristique la plus extraordinaire ? La piste de danse possède un <strong>plancher en verre</strong> sous lequel on voit la mer qui coule.
          </p>
          <p class="text-slate-600 leading-relaxed">
            L'Africana est encore opérationnelle en été et reste une expérience nocturne unique en son genre. L'accès se fait par la mer ou par un parcours dans la roche — ce qui ajoute une touche de charme supplémentaire à une soirée déjà mémorable.
          </p>
        </div>

        <!-- Plongée -->
        <div>
          <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">Sous la Surface : Plongée et Snorkeling</h2>
          <p class="text-slate-600 text-lg leading-relaxed mb-6">
            Marina di Praia est considérée comme l'un des meilleurs spots de plongée de toute la Côte Amalfitaine. La paroi sous-marine descend verticalement jusqu'à <strong>25 mètres</strong>, offrant des grottes marines, des formations rocheuses et une biodiversité impressionnante. Parmi les espèces les plus observées : murènes, mérous, pieuvres et bancs de sars.
          </p>
          <p class="text-slate-600 text-lg leading-relaxed">
            Les plongées nocturnes sont particulièrement spectaculaires en été, quand la bioluminescence illumine l'eau sombre et que les prédateurs nocturnes deviennent actifs. Certains centres de plongée de la zone organisent des sorties guidées aussi bien pour débutants avec brevet open water que pour plongeurs avancés. Le snorkeling en surface est également excellent : les eaux sont limpides et la faune abondante.
          </p>
        </div>

        <!-- Stats -->
        <div class="bg-slate-900 text-white p-8 rounded-[2rem] grid grid-cols-2 sm:grid-cols-4 gap-6 text-center">
          <div>
            <p class="text-med-gold text-3xl font-bold">50</p>
            <p class="text-white/60 text-sm mt-1">marches dans la roche</p>
          </div>
          <div>
            <p class="text-med-gold text-3xl font-bold">25 m</p>
            <p class="text-white/60 text-sm mt-1">profondeur max plongée</p>
          </div>
          <div>
            <p class="text-med-gold text-3xl font-bold">1963</p>
            <p class="text-white/60 text-sm mt-1">ouverture Africana Club</p>
          </div>
          <div>
            <p class="text-med-gold text-3xl font-bold">XVIe s.</p>
            <p class="text-white/60 text-sm mt-1">Torre a Mare</p>
          </div>
        </div>

        <!-- Conseils d'initiés -->
        <div class="bg-med-cream p-8 rounded-[2rem] border border-med-gold/20">
          <h3 class="font-serif text-2xl font-bold text-slate-900 mb-6">Conseils d'initiés</h3>
          <ul class="space-y-4">
            <li class="flex items-start gap-3">
              <span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span>
              <span class="text-slate-600">Arrivez avant 10h pour trouver une place sur le sable — l'après-midi, la plage se remplit malgré les marches qui découragent les moins sportifs.</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span>
              <span class="text-slate-600">Apportez eau et nourriture : il n'y a pas de bar ni de kiosque sur la plage. Le bar le plus proche est au centre de Praiano, 5 minutes au-dessus des marches.</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span>
              <span class="text-slate-600">Pour la plongée, contactez les centres de plongée de Praiano au moins un jour à l'avance en juillet et août : les places s'épuisent vite.</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span>
              <span class="text-slate-600">L'Africana n'est ouverte qu'en été (juin–septembre). Vérifiez les horaires sur le site officiel avant d'organiser votre soirée.</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span>
              <span class="text-slate-600">Les marches de descente sont escarpées et sans rampe par endroits : avec de jeunes enfants ou des difficultés motrices, optez pour le taxi-boat.</span>
            </li>
          </ul>
        </div>

        <!-- Comment y Accéder -->
        <div>
          <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">Comment y Accéder</h2>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div class="bg-white p-6 rounded-[2rem] border border-slate-100 shadow-sm">
              <p class="text-med-gold text-xs font-bold uppercase tracking-wider mb-2">À pied</p>
              <p class="text-slate-700 font-medium mb-1">Depuis le centre de Praiano</p>
              <p class="text-slate-500 text-xs sm:text-sm">5 minutes à pied le long de la via Mare, puis 50 marches dans la roche. Chaussures confortables conseillées.</p>
            </div>
            <div class="bg-white p-6 rounded-[2rem] border border-slate-100 shadow-sm">
              <p class="text-med-gold text-xs font-bold uppercase tracking-wider mb-2">Taxi-Boat</p>
              <p class="text-slate-700 font-medium mb-1">Depuis Praiano ou Positano</p>
              <p class="text-slate-500 text-xs sm:text-sm">Ce n'est pas un débarquement régulier, mais les taxi-boats locaux la connaissent. Coût : 15–20 € par personne.</p>
            </div>
            <div class="bg-white p-6 rounded-[2rem] border border-slate-100 shadow-sm">
              <p class="text-med-gold text-xs font-bold uppercase tracking-wider mb-2">Bus SITA</p>
              <p class="text-slate-700 font-medium mb-1">Depuis Amalfi ou Positano</p>
              <p class="text-slate-500 text-xs sm:text-sm">Arrêt Praiano centre. De là, 5 minutes à pied jusqu'à l'entrée des marches. Idéal en venant de <a href="/fr-fr/cote-amalfitaine/positano/" class="text-med-blue hover:underline">Positano</a>.</p>
            </div>
            <div class="bg-white p-6 rounded-[2rem] border border-slate-100 shadow-sm">
              <p class="text-med-gold text-xs font-bold uppercase tracking-wider mb-2">Voiture / Moto</p>
              <p class="text-slate-700 font-medium mb-1">Parking à Praiano</p>
              <p class="text-slate-500 text-xs sm:text-sm">Parking public payant au centre de Praiano. En haute saison, il vaut mieux arriver avant 9h.</p>
            </div>
          </div>
        </div>

        <!-- Questions Fréquentes -->
        <div>
          <h2 class="font-serif text-3xl font-bold text-slate-900 mb-8">Questions Fréquentes</h2>
          <div class="space-y-4">
            {faqSchema.mainEntity.map((q) => (
              <details class="group border border-slate-200 rounded-2xl overflow-hidden bg-white">
                <summary class="flex items-center justify-between px-6 py-4 cursor-pointer select-none text-charcoal font-medium hover:bg-slate-50 transition-colors">
                  {q.name}
                  <svg class="w-4 h-4 text-slate-400 group-open:rotate-180 transition-transform flex-shrink-0 ml-3" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
                </summary>
                <div class="px-6 pb-5 text-slate-600 leading-relaxed text-xs sm:text-sm border-t border-slate-100 pt-4">
                  {q.acceptedAnswer.text}
                </div>
              </details>
            ))}
          </div>
        </div>
      </div>

      <!-- Sidebar Fast-Facts -->
      <aside class="lg:col-span-1">
        <div class="bg-slate-900 text-white p-10 rounded-[3rem] sticky top-32">
          <h3 class="font-serif text-2xl font-bold mb-8 flex items-center gap-3">
            <svg class="w-6 h-6 text-med-gold" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M2 12c.6.5 1.2 1 2.5 1 2.5 0 2.5-2 5-2 2.6 0 2.4 2 5 2 2.5 0 2.5-2 5-2 1.3 0 1.9.5 2.5 1"/><path d="M2 18c.6.5 1.2 1 2.5 1 2.5 0 2.5-2 5-2 2.6 0 2.4 2 5 2 2.5 0 2.5-2 5-2 1.3 0 1.9.5 2.5 1"/></svg> Infos Clés
          </h3>
          <div class="space-y-6">
            {facts.map((item) => (
              <div class="border-b border-white/5 pb-4 last:border-0">
                <span class="text-white/40 text-xs sm:text-sm font-light block mb-1">{item.label}</span>
                <span class="text-white font-medium text-xs sm:text-sm">{item.value}</span>
              </div>
            ))}
          </div>
          <div class="mt-10 pt-8 border-t border-white/10">
            <a
              href="/fr-fr/plages/"
              class="inline-flex items-center gap-2 text-med-gold text-xs sm:text-sm font-medium hover:text-white transition-colors"
            >
              ← Toutes les plages
            </a>
          </div>
        </div>
      </aside>

    </div>
  </section>

  <!-- Plages Voisines -->
  <CorrelationSlider
    title="Autres plages de la Côte Amalfitaine"
    items={nearbyBeaches}
    lang="fr-fr"
  />

  <!-- CTA -->
  <section class="bg-med-blue py-16 text-center">
    <div class="max-w-2xl mx-auto px-6">
      <h2 class="font-serif text-2xl font-bold text-white mb-4">Découvrez d'autres plages de la Côte Amalfitaine</h2>
      <a
        href="/fr-fr/plages/"
        class="inline-block bg-white text-med-blue font-semibold px-8 py-3 rounded-full hover:bg-med-cream transition-colors"
      >
        Guide complet des plages
      </a>
    </div>
  </section>

</BaseLayout>
