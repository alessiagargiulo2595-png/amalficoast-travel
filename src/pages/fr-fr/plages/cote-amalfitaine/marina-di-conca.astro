---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../../components/Breadcrumbs.astro';
import CorrelationSlider from '../../../../components/CorrelationSlider.astro';

const lang = 'fr-fr';

const breadcrumbs = [
  { name: 'Accueil', url: '/fr-fr/' },
  { name: 'Plages', url: '/fr-fr/plages/' },
  { name: 'Marina di Conca', url: '/fr-fr/plages/cote-amalfitaine/marina-di-conca/' },
];

const facts = [
  { label: 'Composition', value: 'Galets et sable fin' },
  { label: 'Accès', value: 'Escalier (environ 100 marches)' },
  { label: 'Ombre', value: 'À partir de 15h30 (falaises calcaires)' },
  { label: 'Services', value: 'Beach club + zone libre' },
  { label: 'Idéal pour', value: 'Tranquillité, snorkeling, authenticité' },
  { label: 'À proximité de', value: "Grotte d'Émeraude (2 km)" },
  { label: 'Transat + parasol', value: '€20–€30 par personne' },
  { label: 'Point historique', value: 'Ancien port des pêcheurs de Conca' },
  { label: 'Meilleure saison', value: 'Mai–juin, septembre' },
];

const faqSchema = {
  "@context": "https://schema.org", "@type": "FAQPage",
  "mainEntity": [
    { "@type": "Question", "name": "Comment rejoindre Marina di Conca ?", "acceptedAnswer": { "@type": "Answer", "text": "Marina di Conca se trouve à Conca dei Marini, sur la Strada Statale Amalfitana (SS163) entre Amalfi et Praiano. Depuis le centre du village on descend vers la mer par un escalier d'environ 100 marches taillé dans la roche. En voiture : parking limité payant le long de la SS163 en été. En bus : SITA ligne Amalfi–Sorrente, arrêt Conca dei Marini centre, puis 5 minutes à pied. Par la mer : taxi boat depuis Amalfi ou Positano." } },
    { "@type": "Question", "name": "Qu'est-ce qui rend Marina di Conca spéciale ?", "acceptedAnswer": { "@type": "Answer", "text": "Marina di Conca est l'une des plages les plus authentiques de la Côte Amalfitaine : petite (environ 100 mètres), nichée entre deux falaises calcaires, avec l'eau turquoise typique de Conca dei Marini. Moins touristique que les plages de Positano et d'Amalfi, encore fréquentée par les pêcheurs locaux. Elle se trouve à 2 km de la célèbre Grotte d'Émeraude, parfaite pour combiner visite de la grotte et demi-journée de plage." } },
    { "@type": "Question", "name": "Combien coûtent les transats à Marina di Conca ?", "acceptedAnswer": { "@type": "Answer", "text": "Marina di Conca offre l'un des meilleurs rapports qualité-prix de la Côte Amalfitaine. Les beach clubs proposent transat + parasol à partir de €20–30 par personne (contre €35–60 à Positano). Une grande zone libre permet d'apporter sa serviette et son parasol. Le restaurant La Tonnarella, sur la plage, est une tradition historique : poisson frais à prix honnêtes." } },
    { "@type": "Question", "name": "Peut-on faire du snorkeling à Marina di Conca ?", "acceptedAnswer": { "@type": "Answer", "text": "Oui. Les eaux de Marina di Conca sont cristallines et les fonds rocheux aux extrémités de la baie abritent une faune marine variée : sars, poulpes, girelles. La paroi est, sous la falaise vers la Grotte d'Émeraude, est particulièrement belle. Les matinées sont le meilleur moment : eau plus calme, meilleure visibilité, moins de bateaux." } },
    { "@type": "Question", "name": "Peut-on visiter la Grotte d'Émeraude depuis Marina di Conca ?", "acceptedAnswer": { "@type": "Answer", "text": "Oui. La Grotte d'Émeraude est à environ 2 km de Marina di Conca par la SS163. On peut s'y rendre à pied (20 min de montée sur la route nationale, sans trottoir), en voiture ou en taxi boat combiné. L'entrée se fait depuis la SS163, puis un ascenseur ou des escaliers vous mènent au niveau de la mer ; de là on visite en barque à rames (10 min, billet €5 + €5 ascenseur)." } },
    { "@type": "Question", "name": "Marina di Conca est-elle adaptée aux familles avec enfants ?", "acceptedAnswer": { "@type": "Answer", "text": "Partiellement. La mer est calme et peu profonde dans les premiers mètres, idéale pour les enfants. Mais l'accès par environ 100 marches est difficile avec poussettes ou très jeunes enfants. Si vous voyagez avec des moins de 3 ans, envisagez d'arriver en taxi boat. Les beach clubs ont des services essentiels (douches, toilettes)." } }
  ]
};

const beachSchema = {
  "@context": "https://schema.org", "@type": "Beach",
  "name": "Marina di Conca",
  "description": "La plage authentique de Conca dei Marini : petite crique de pêcheurs entre falaises calcaires, à 2 km de la Grotte d'Émeraude.",
  "geo": { "@type": "GeoCoordinates", "latitude": "40.6126", "longitude": "14.5660" },
  "address": { "@type": "PostalAddress", "addressLocality": "Conca dei Marini", "addressRegion": "SA", "addressCountry": "IT" },
  "amenityFeature": [
    { "@type": "LocationFeatureSpecification", "name": "Beach Club", "value": "Oui" },
    { "@type": "LocationFeatureSpecification", "name": "Plage libre", "value": "Oui" },
    { "@type": "LocationFeatureSpecification", "name": "Restaurants", "value": "Oui" }
  ]
};

const nearbyBeaches = [
  { name: 'Fiordo di Furore', href: '/fr-fr/plages/cote-amalfitaine/fiordo-di-furore/', tag: 'Furore', desc: 'Le fjord iconique encastré dans la roche.' },
  { name: 'Plage de Gavitella', href: '/fr-fr/plages/cote-amalfitaine/gavitella-praiano/', tag: 'Praiano', desc: 'La seule plage de Praiano au soleil toute la journée.' },
  { name: 'Marina di Praia', href: '/fr-fr/plages/cote-amalfitaine/marina-di-praia/', tag: 'Praiano', desc: 'Plage sauvage avec coucher de soleil parfait.' },
  { name: 'Santa Croce', href: '/fr-fr/plages/cote-amalfitaine/santa-croce-amalfi/', tag: 'Amalfi', desc: 'Accessible seulement en bateau, restaurants historiques.' },
];
---

<BaseLayout title="Marina di Conca : la Plage Authentique de Conca dei Marini" description="Marina di Conca : petite plage de pêcheurs près de la Grotte d'Émeraude. Comment y aller, prix 2026, snorkeling et tranquillité." lang={lang} breadcrumbs={breadcrumbs} schema={[beachSchema, faqSchema]} pageKey="marina-di-conca"
  heroImage="/images/marina-di-conca-hero.webp"
>

  <section class="relative h-[52.5vh] sm:h-[70vh] overflow-hidden flex items-center justify-center">
    <img src="/images/marina-di-conca-hero.webp" alt="Marina di Conca, Conca dei Marini" class="absolute inset-0 w-full h-full object-cover" loading="eager" fetchpriority="high" decoding="sync" referrerpolicy="no-referrer" />
    <div class="absolute inset-0 hidden sm:block bg-gradient-to-b from-black/20 via-black/35 to-black/70"></div>
    <div class="relative z-10 text-center px-6 max-w-4xl text-white">
      <p class="text-med-gold text-xs sm:text-sm font-medium uppercase tracking-[0.3em] mb-3">Conca dei Marini · Côte Amalfitaine</p>
      <h1 class="font-serif text-display text-white mb-6">Marina di Conca</h1>
      <p class="text-lg md:text-xl font-light text-white/80">Le port historique des pêcheurs, une petite baie turquoise sous la Grotte d'Émeraude.</p>
    </div>
    <Breadcrumbs breadcrumbs={breadcrumbs} />
  </section>

  <section class="bg-med-cream py-24 px-6">
    <div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-3 gap-16">
      <div class="lg:col-span-2 space-y-12">
        <div>
          <h2 class="font-serif text-4xl font-bold text-slate-900 mb-6">La Baie des Pêcheurs</h2>
          <p class="text-slate-600 text-lg leading-relaxed mb-6">Marina di Conca est la plage authentique de <strong>Conca dei Marini</strong>, l'un des villages les plus discrets de la <a href="/fr-fr/cote-amalfitaine/" class="text-med-blue hover:underline">Côte Amalfitaine</a>. Nichée entre deux hautes falaises calcaires et accessible par un escalier taillé dans la roche, c'est le port historique des pêcheurs locaux — une scène maritime qui conserve son caractère originel, loin du jet-set de Positano et de la foule d'Amalfi.</p>
          <p class="text-slate-600 text-lg leading-relaxed">La couleur de la mer y prend des tons turquoise profond, grâce aux fonds calcaires clairs qui réfléchissent la lumière méditerranéenne. C'est la même lumière qui donne son nom à la <strong>Grotte d'Émeraude</strong> voisine, à seulement 2 km d'ici.</p>
        </div>

        <div class="bg-white p-8 rounded-[2rem] shadow-xl border border-slate-100">
          <div class="flex items-center gap-4 mb-4">
            <svg class="w-6 h-6 text-med-gold flex-shrink-0" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><path d="M2 12h20M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
            <h3 class="text-xl font-bold">La Grotte d'Émeraude à 2 km</h3>
          </div>
          <p class="text-slate-600 leading-relaxed mb-4">Marina di Conca est la base parfaite pour visiter la <a href="/fr-fr/blog/grotte-emeraude/" class="text-med-blue hover:underline">Grotte d'Émeraude</a>, l'une des attractions naturelles les plus célèbres de la côte. Découverte en 1932 par Luigi Buonocore, elle doit son nom à la lumière vert émeraude qui se crée lorsque les rayons du soleil pénètrent par une ouverture sous-marine et illuminent l'eau intérieure.</p>
          <p class="text-slate-600 leading-relaxed">Itinéraire recommandé : matin à la grotte, déjeuner de poisson à Marina di Conca, après-midi à la plage. De mai à septembre la grotte est ouverte tous les jours (9h–17h), billet €5 + €5 ascenseur.</p>
        </div>

        <div>
          <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">Histoire : Sarrasins, Tonnara et Sophia Loren</h2>
          <p class="text-slate-600 text-lg leading-relaxed mb-6">Le nom <em>Conca dei Marini</em> dérive directement de la profession historique de ses habitants : <strong>marins</strong>. Du Moyen Âge jusqu'au XXe siècle, le village était une petite république maritime satellite d'Amalfi, et Marina di Conca était son port. Les barques de pêche — en particulier les caractéristiques <em>gozzi</em> en bois — étaient hissées chaque hiver sur la plage pour l'entretien, et les filets étaient étendus à sécher sur les galets, une scène qui s'est répétée pratiquement à l'identique pendant des siècles.</p>
          <p class="text-slate-600 text-lg leading-relaxed mb-6">La <strong>Torre di Capo di Conca</strong>, visible à l'est de la baie, fut construite au XVIe siècle dans le cadre du système défensif contre les incursions sarrasines. L'histoire raconte que c'est ici-même que furent repoussées plusieurs tentatives de débarquement des pirates de Khayr al-Din Barberousse, l'amiral ottoman qui terrorisa la Tyrrhénienne au XVIe siècle.</p>
          <p class="text-slate-600 text-lg leading-relaxed">Dans les années 1960, Conca dei Marini devint l'un des refuges préférés de l'élite du cinéma italien. <strong>Sophia Loren</strong>, Carlo Ponti, Gianni Agnelli, Jacqueline Kennedy fréquentèrent la zone, attirés par son authenticité discrète. C'est à cette époque que la petite Marina di Conca trouva son identité : non comme plage de tourisme de masse, mais comme refuge pour qui voulait fuir son propre succès.</p>
        </div>

        <div class="bg-white p-8 rounded-[2rem] shadow-xl border border-slate-100">
          <div class="flex items-center gap-4 mb-4">
            <svg class="w-6 h-6 text-med-gold flex-shrink-0" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M3 18l4-4 4 4 6-6 4 4"/><path d="M3 6h18v12H3z"/></svg>
            <h3 class="text-xl font-bold">La Tonnarella : le Restaurant sur la Plage</h3>
          </div>
          <p class="text-slate-600 leading-relaxed mb-4">Directement sur la plage, depuis des décennies, opère <strong>La Tonnarella</strong> — un restaurant simple et traditionnel géré par la même famille de pêcheurs. Spaghetti alle vongole, friture de paranza, poulpe grillé : la carte est très courte, mais le poisson arrive directement des gozzi hissés sur la plage. Prix honnêtes (€35–50 par personne), tables à moins d'un mètre de l'eau. Réserver les week-ends d'été est obligatoire.</p>
          <p class="text-slate-600 leading-relaxed">Pour qui déjeune au restaurant, le service transat est inclus — une formule pratiquement impossible à trouver dans les autres zones de la côte aux prix de Conca dei Marini.</p>
        </div>

        <div class="bg-slate-900 text-white p-8 rounded-[2rem] grid grid-cols-2 sm:grid-cols-4 gap-6 text-center">
          <div><p class="text-med-gold text-3xl font-bold">2 km</p><p class="text-white/60 text-sm mt-1">de la Grotte d'Émeraude</p></div>
          <div><p class="text-med-gold text-3xl font-bold">100</p><p class="text-white/60 text-sm mt-1">marches d'accès</p></div>
          <div><p class="text-med-gold text-3xl font-bold">XVI</p><p class="text-white/60 text-sm mt-1">siècle – Torre Capo</p></div>
          <div><p class="text-med-gold text-3xl font-bold">€20</p><p class="text-white/60 text-sm mt-1">transat (à partir de)</p></div>
        </div>

        <div class="bg-med-cream p-8 rounded-[2rem] border border-med-gold/20">
          <h3 class="font-serif text-2xl font-bold text-slate-900 mb-6">Conseils des Locaux</h3>
          <ul class="space-y-4">
            <li class="flex items-start gap-3"><span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span><span class="text-slate-600">Combinez la journée plage avec la visite de la <a href="/fr-fr/blog/grotte-emeraude/" class="text-med-blue hover:underline">Grotte d'Émeraude</a> : matin à la grotte (ouverture 9h), déjeuner à Marina di Conca, après-midi à la plage.</span></li>
            <li class="flex items-start gap-3"><span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span><span class="text-slate-600">Réservez La Tonnarella au moins 24h à l'avance les week-ends entre juin et septembre. Les tables au bord de l'eau partent en premier.</span></li>
            <li class="flex items-start gap-3"><span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span><span class="text-slate-600">Le meilleur snorkeling se trouve le long de la paroi est, vers Capo di Conca. Masque et palmes plus une demi-journée = beaucoup de faune visible.</span></li>
            <li class="flex items-start gap-3"><span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span><span class="text-slate-600">Le parking le long de la SS163 est limité : arrivez avant 9h en juillet et août, ou prenez le bus SITA depuis l'arrêt Conca centre (5 min à pied).</span></li>
            <li class="flex items-start gap-3"><span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span><span class="text-slate-600">Meilleure saison : septembre. Eau encore chaude (22-23°C), très peu de touristes, restaurant avec tables libres sans réservation.</span></li>
          </ul>
        </div>

        <div>
          <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">Comment Y Aller</h2>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div class="bg-white p-6 rounded-[2rem] border border-slate-100 shadow-sm"><p class="text-med-gold text-xs font-bold uppercase tracking-wider mb-2">Bus SITA ⭐</p><p class="text-slate-700 font-medium mb-1">Ligne Amalfi–Sorrente</p><p class="text-slate-500 text-xs sm:text-sm">Arrêt "Conca dei Marini centre", puis 5 min à pied par l'escalier. Voir <a href="/fr-fr/guide/bus-sita/" class="text-med-blue hover:underline">horaires SITA</a>.</p></div>
            <div class="bg-white p-6 rounded-[2rem] border border-slate-100 shadow-sm"><p class="text-med-gold text-xs font-bold uppercase tracking-wider mb-2">En voiture</p><p class="text-slate-700 font-medium mb-1">SS163 Amalfitana</p><p class="text-slate-500 text-xs sm:text-sm">Parking payant limité le long de la route nationale. Arrivez avant 9h en haute saison. <a href="/fr-fr/guide/parking-ztl/" class="text-med-blue hover:underline">Guide parking</a>.</p></div>
            <div class="bg-white p-6 rounded-[2rem] border border-slate-100 shadow-sm"><p class="text-med-gold text-xs font-bold uppercase tracking-wider mb-2">Taxi Boat</p><p class="text-slate-700 font-medium mb-1">Depuis Amalfi ou Positano</p><p class="text-slate-500 text-xs sm:text-sm">€15–25 par personne. Arrivée directe sur la plage, solution conseillée en haute saison.</p></div>
            <div class="bg-white p-6 rounded-[2rem] border border-slate-100 shadow-sm"><p class="text-med-gold text-xs font-bold uppercase tracking-wider mb-2">À pied</p><p class="text-slate-700 font-medium mb-1">Depuis le centre de Conca</p><p class="text-slate-500 text-xs sm:text-sm">Environ 100 marches taillées dans la roche. Portez des chaussures confortables. Non adapté aux poussettes.</p></div>
          </div>
        </div>

        <div>
          <h2 class="font-serif text-3xl font-bold text-slate-900 mb-8">Questions Fréquentes</h2>
          <div class="space-y-4">
            {faqSchema.mainEntity.map((q) => (
              <details class="group border border-slate-200 rounded-2xl overflow-hidden bg-white">
                <summary class="flex items-center justify-between px-6 py-4 cursor-pointer select-none text-charcoal font-medium hover:bg-slate-50 transition-colors">
                  {q.name}
                  <svg class="w-4 h-4 text-slate-400 group-open:rotate-180 transition-transform flex-shrink-0 ml-3" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
                </summary>
                <div class="px-6 pb-5 text-slate-600 leading-relaxed text-xs sm:text-sm border-t border-slate-100 pt-4">{q.acceptedAnswer.text}</div>
              </details>
            ))}
          </div>
        </div>
      </div>

      <aside class="lg:col-span-1">
        <div class="bg-slate-900 text-white p-10 rounded-[3rem] sticky top-32">
          <h3 class="font-serif text-2xl font-bold mb-8 flex items-center gap-3">
            <svg class="w-6 h-6 text-med-gold" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M2 12c.6.5 1.2 1 2.5 1 2.5 0 2.5-2 5-2 2.6 0 2.4 2 5 2 2.5 0 2.5-2 5-2 1.3 0 1.9.5 2.5 1"/><path d="M2 18c.6.5 1.2 1 2.5 1 2.5 0 2.5-2 5-2 2.6 0 2.4 2 5 2 2.5 0 2.5-2 5-2 1.3 0 1.9.5 2.5 1"/></svg> Infos Clés
          </h3>
          <div class="space-y-6">{facts.map((item) => (<div class="border-b border-white/5 pb-4 last:border-0"><span class="text-white/40 text-xs sm:text-sm font-light block mb-1">{item.label}</span><span class="text-white font-medium text-xs sm:text-sm">{item.value}</span></div>))}</div>
          <div class="mt-10 pt-8 border-t border-white/10"><a href="/fr-fr/plages/" class="inline-flex items-center gap-2 text-med-gold text-xs sm:text-sm font-medium hover:text-white transition-colors">← Toutes les plages</a></div>
        </div>
      </aside>
    </div>
  </section>

  <CorrelationSlider lang="fr-fr" items={nearbyBeaches} title="Plages Voisines à Explorer" />

  <section class="bg-med-blue py-16 text-center">
    <div class="max-w-2xl mx-auto px-6">
      <h2 class="font-serif text-2xl font-bold text-white mb-4">Découvrez plus de plages</h2>
      <a href="/fr-fr/plages/" class="inline-block bg-white text-med-blue font-semibold px-8 py-3 rounded-full hover:bg-med-cream transition-colors">Guide complet des plages</a>
    </div>
  </section>

</BaseLayout>
