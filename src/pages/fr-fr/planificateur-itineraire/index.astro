---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import TripPlanner from '../../../components/TripPlanner.astro';

const lang = 'fr-fr';
const pageKey = 'planner';

const breadcrumbs = [
  { name: 'Accueil', url: '/fr-fr/' },
  { name: 'Planification', url: '/fr-fr/planification/' },
  { name: 'Planificateur d\'itineraire', url: '/fr-fr/planificateur-itineraire/' },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Comment fonctionne le planificateur de voyage ?",
      "acceptedAnswer": { "@type": "Answer", "text": "Selectionne ton point de depart (Naples, Salerne, Sorrente ou Amalfi), le nombre de jours, le budget, la saison et tes centres d'interet. L'algorithme combine automatiquement les meilleures activites en un itineraire personnalise." }
    },
    {
      "@type": "Question",
      "name": "Puis-je personnaliser l'itineraire genere ?",
      "acceptedAnswer": { "@type": "Answer", "text": "L'itineraire genere est une suggestion basee sur tes criteres. Tu peux modifier tes preferences et le regenerer autant de fois que tu veux jusqu'a trouver la combinaison parfaite." }
    }
  ]
};
---

<BaseLayout
  title="Planifie ton voyage sur la Cote Amalfitaine | Planificateur gratuit"
  description="Cree ton itineraire personnalise pour la Cote Amalfitaine, la Peninsule de Sorrente et les iles du Golfe. Choisis jours, budget et interets."
  lang={lang}
  pageKey={pageKey}
  breadcrumbs={breadcrumbs}
  schema={[faqSchema]}
>
  <TripPlanner lang={lang} />

  <section class="bg-white py-12 md:py-16">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 text-center">
      <h2 class="font-display text-2xl md:text-3xl font-bold text-slate-900 mb-4">Envie d'en savoir plus ?</h2>
      <p class="text-slate-600 mb-6">Decouvre nos guides detailles sur les transports, itineraires et destinations.</p>
      <div class="flex flex-wrap justify-center gap-3">
        <a href="/fr-fr/guide/comment-venir/" class="px-5 py-3 bg-med-blue text-white font-semibold rounded-xl hover:bg-blue-700 transition-colors">Comment venir</a>
        <a href="/fr-fr/itineraires/" class="px-5 py-3 border-2 border-slate-300 text-slate-700 font-semibold rounded-xl hover:border-slate-500 transition-colors">Itineraires prets</a>
      </div>
    </div>
  </section>
</BaseLayout>
