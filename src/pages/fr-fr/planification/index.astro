---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import { getTranslations, getLocalePath } from '../../../i18n/translations';

const lang = 'fr-fr';
const t = getTranslations(lang);

const breadcrumbs = [
  { name: 'Home', url: '/fr-fr/' },
  { name: 'Planification', url: '/fr-fr/planification/' },
];

// Guide articles data
const guides = [
  {
    title: 'Comment s\'y rendre',
    desc: 'Train, avion, ferry ou voiture : toutes les options pour se rendre sur la Côte d\'Amalfi.',
    img: '/images/come-arrivare-hero.jpg',
    href: '/fr-fr/guide/comment-venir/',
    tag: 'Transport'
  },
  {
    title: 'Bus SITA',
    desc: 'Le guide complet des bus locaux : horaires, tarifs, billets et itinéraires le long de la côte.',
    img: '/images/bus-sita-hero.jpg',
    href: '/fr-fr/guide/bus-sita/',
    tag: 'Transport'
  },
  {
    title: 'Ferries',
    desc: 'Des petits ferries aux routes estivales de Naples et Salerne : comment atteindre chaque ville par la mer.',
    img: '/images/traghetti-hero.jpg',
    href: '/fr-fr/guide/ferries/',
    tag: 'Transport'
  },
  {
    title: 'Parking et zones ZTL',
    desc: 'Où se garer, horaires et tarifs. Comment éviter les zones à circulation restreinte et les amendes.',
    img: '/images/parcheggi-hero.jpg',
    href: '/fr-fr/guide/parking-ztl/',
    tag: 'Pratique'
  },
  {
    title: 'Quand visiter',
    desc: 'Saisons, météo, vacances et foules. Quand est le meilleur moment pour votre visite.',
    img: '/images/quando-visitare-hero.jpg',
    href: '/fr-fr/guide/quand-visiter/',
    tag: 'Planification'
  },
];
---

<BaseLayout
  title={t.meta.itineraries_title}
  description={t.meta.itineraries_description}
  lang={lang}
  pageKey="planning"
>
  <!-- Hero -->
  <section class="relative bg-charcoal text-white py-20 overflow-hidden">
    <img src="/images/itinerari-hero.jpg" alt="Planification Côte d'Amalfi" class="absolute inset-0 w-full h-full object-cover opacity-20" loading="eager" referrerpolicy="no-referrer"/>
    <div class="absolute inset-0 bg-charcoal/80"></div>
    <div class="relative z-10 max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <p class="text-white/80 text-xs sm:text-sm uppercase tracking-[0.3em] mb-3">Planifiez votre voyage</p>
      <h1 class="text-4xl md:text-5xl font-bold font-serif mb-4">Guides Pratiques</h1>
      <p class="text-white/80 text-lg max-w-2xl mx-auto">Comment y aller, comment se déplacer, quand visiter et où se garer sur la Côte d'Amalfi. Tout ce dont vous avez besoin pour un voyage parfait.</p>
    </div>
    <Breadcrumbs breadcrumbs={breadcrumbs} />
  </section>

  <!-- Intro -->
  <section class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <p class="text-lg text-slate-600 leading-relaxed">
      La Côte d'Amalfi est facile à explorer une fois que vous savez comment y aller, comment vous déplacer et les meilleures saisons pour la visiter. Vous trouverez ici toutes les informations pratiques dont vous avez besoin : des options de transport aux tarifs de stationnement, des bus locaux aux ferrys d'été.
    </p>
  </section>

  <!-- Guides Grid -->
  <section class="py-12 border-t border-slate-100">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {guides.map((guide) => (
          <a href={guide.href} class="group block bg-white rounded-2xl border border-slate-100 overflow-hidden hover:shadow-lg hover:border-med-blue/20 transition-all duration-300">
            <!-- Image with overlay -->
            <div class="relative h-44 overflow-hidden">
              <img src={guide.img} alt={guide.title} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
              <div class="absolute inset-0 bg-gradient-to-t from-black/50 to-transparent" />
              <!-- Category badge -->
              <span class="absolute bottom-3 left-3 text-[10px] font-bold uppercase tracking-wider text-white bg-med-blue/80 backdrop-blur-sm px-2.5 py-1 rounded-full">
                {guide.tag}
              </span>
            </div>
            <!-- Text section -->
            <div class="p-5">
              <h3 class="font-semibold text-charcoal text-sm mb-1.5 group-hover:text-med-blue transition-colors">{guide.title}</h3>
              <p class="text-xs text-slate-500 leading-relaxed">{guide.desc}</p>
              <span class="mt-3 inline-flex items-center text-xs font-semibold text-med-blue gap-1 group-hover:gap-2 transition-all">
                Lire le guide →
              </span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Itineraries CTA -->
  <section class="bg-med-blue py-16 text-center">
    <div class="max-w-2xl mx-auto px-4">
      <h2 class="text-2xl font-bold text-white mb-4">Prêt à explorer la côte ?</h2>
      <p class="text-white mb-6">Choisissez entre 1 jour, 3 jours ou 1 semaine d'itinéraires recommandés.</p>
      <a href={getLocalePath(lang, 'itineraries')}
        class="inline-block bg-white text-med-blue font-semibold px-8 py-3 rounded-full hover:bg-slate-100 transition-colors">
        Voir les itinéraires
      </a>
    </div>
  </section>
</BaseLayout>
