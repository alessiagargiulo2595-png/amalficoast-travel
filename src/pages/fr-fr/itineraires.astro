---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getTranslations, getLocalePath } from '../../i18n/translations';

const lang = 'fr-fr';
const breadcrumbs = [
  { name: 'Home', url: '/fr-fr/' },
  { name: 'Planification', url: '/fr-fr/planification/' },
  { name: 'Itinéraires', url: '/fr-fr/itineraires/' },
];
const t = getTranslations(lang);

// Card data organized by duration
const itineraries = {
  d1: [
    { title: 'Côte Amalfitaine de Naples', desc: 'En ferry de Naples: Amalfi, Ravello et Positano avec coucher de soleil en mer.', img: '/images/costiera-hero.jpg', href: '/fr-fr/itineraires/1-jour/cote-amalfitaine-depuis-naples/', tag: '1 jour' },
    { title: 'Côte Amalfitaine de Salerne', desc: 'Départ de Salerne: moins de foule, plus de paix. Parfait en été avec retour en soirée.', img: '/images/costiera-hero.jpg', href: '/fr-fr/itineraires/1-jour/cote-amalfitaine-depuis-salerne/', tag: '1 jour' },
    { title: 'Péninsule de Sorrente', desc: 'Sorrente, Massa Lubrense et Marina del Cantone en une journée de Naples.', img: '/images/sorrento-hero.jpg', href: '/fr-fr/itineraires/1-jour/peninsule-sorrentine-depuis-naples/', tag: '1 jour' },
    { title: 'Sentier des Dieux Trek', desc: '7,8 km de vues spectaculaires de Bomerano à Nocelle au-dessus de Positano.', img: '/images/trekking-hero.jpg', href: '/fr-fr/itineraires/1-jour/sentier-des-dieux-trek/', tag: '1 jour' },
    { title: 'Capri de Sorrente', desc: 'Grotte Bleue, Faraglioni, Villa Jovis: Capri essentiel en une journée.', img: '/images/capri-hero.jpg', href: '/fr-fr/itineraires/1-jour/capri-depuis-sorrente/', tag: '1 jour' },
  ],
  d3: [
    { title: 'Côte Amalfitaine Classique', desc: 'Amalfi, Positano, Ravello et Cetara: le meilleur de la côte en 3 jours.', img: '/images/costiera-hero.jpg', href: '/fr-fr/itineraires/3-jours/cote-amalfitaine-classique/', tag: '3 jours' },
    { title: 'Îles: Ischia & Procida', desc: 'Deux îles dans le Golfe de Naples avec plages, sources thermales et couleurs pastel.', img: '/images/ischia-hero.jpg', href: '/fr-fr/itineraires/3-jours/iles-ischia-procida/', tag: '3 jours' },
    { title: 'Sorrente, Pompéi & Histoire', desc: 'Art, histoire et mer: Sorrente, Pompéi et la Péninsule en 3 jours.', img: '/images/sorrento-hero.jpg', href: '/fr-fr/itineraires/3-jours/sorrente-pompei-histoire/', tag: '3 jours' },
  ],
  d7: [
    { title: 'Grand Tour Côte & Péninsule', desc: 'Une semaine complète: côte, péninsule, îles et villages cachés.', img: '/images/costiera-hero.jpg', href: '/fr-fr/itineraires/7-jours/grand-tour-cote-peninsule/', tag: '7 jours' },
    { title: 'Slow Travel: Villages & Gastronomie', desc: 'Sans hâte. Marchés, trattorias, sentiers et couchers de soleil en slow travel.', img: '/images/atrani-hero.jpg', href: '/fr-fr/itineraires/7-jours/slow-travel-villages-gastronomie/', tag: '7 jours' },
  ],
};
---

<BaseLayout
  title={t.meta.itineraries_title}
  description={t.meta.itineraries_description}
  lang={lang}
  pageKey="itineraries"

  heroImage="/images/itinerari-hero.jpg"
>
  <!-- Hero -->
  <section class="relative h-[45vh] sm:h-[60vh] flex items-center bg-charcoal overflow-hidden">
    <img src="/images/itinerari-hero.jpg" alt="Côte Amalfitaine itinéraires" class="absolute inset-0 w-full h-full object-cover" loading="eager" fetchpriority="high" decoding="sync" referrerpolicy="no-referrer"/>
    <div class="absolute inset-0 bg-gradient-to-b from-black/25 via-black/40 to-black/75"></div>
    <div class="relative z-10 max-w-7xl mx-auto px-6 py-16">
      <nav class="flex items-center gap-2 text-white/60 text-xs mb-6">
        <a href="/fr-fr/" class="hover:text-white transition-colors">Home</a>
        <span>/</span>
        <a href="/fr-fr/planification/" class="hover:text-white transition-colors">Planification</a>
        <span>/</span>
        <span class="text-white">Itinéraires</span>
      </nav>
      <div class="max-w-3xl">
        <p class="text-med-gold text-xs sm:text-sm font-medium uppercase tracking-[0.3em] mb-3">Planifiez votre voyage</p>
        <h1 class="font-serif text-display text-white mb-4">Itinéraires Côte Amalfitaine</h1>
        <p class="text-xl text-white/80 leading-relaxed">1 jour, 3 jours ou 1 semaine: itinéraires détaillés pour profiter au maximum de la Côte Amalfitaine selon le temps dont vous disposez.</p>
      </div>
    </div>
  </section>

  <!-- Intro -->
  <section class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <p class="text-lg text-slate-600 leading-relaxed">
      La Côte Amalfitaine offre des expériences différentes selon le temps dont vous disposez. Un jour pour les incontournables, trois jours pour découvrir les villages et les rythmes locaux, une semaine pour aller au-delà de la carte postale. Choisissez l'itinéraire qui vous convient.
    </p>
  </section>

  <!-- 1 Jour -->
  <section class="py-12 border-t border-slate-100">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center gap-4 mb-10">
        <span class="inline-block bg-med-blue/80 text-white text-xs font-bold uppercase tracking-wider px-3 py-1.5 rounded-full">1 jour</span>
        <h2 class="text-3xl font-bold font-serif text-charcoal">Le meilleur de la côte</h2>
        <div class="flex-1 h-px bg-slate-100"></div>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {itineraries.d1.map((it) => (
          <a href={it.href} class="group block bg-white rounded-2xl border border-slate-100 overflow-hidden hover:shadow-lg hover:border-med-blue/20 transition-all duration-300">
            <!-- Image with overlay -->
            <div class="relative h-44 overflow-hidden">
              <img src={it.img} alt={it.title} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
              <div class="absolute inset-0 bg-gradient-to-t from-black/50 to-transparent" />
              <!-- Duration badge -->
              <span class="absolute bottom-3 left-3 text-[10px] font-bold uppercase tracking-wider text-white bg-med-blue/80 backdrop-blur-sm px-2.5 py-1 rounded-full">
                {it.tag}
              </span>
            </div>
            <!-- Text section -->
            <div class="p-5">
              <h3 class="font-semibold text-charcoal text-sm mb-1.5 group-hover:text-med-blue transition-colors">{it.title}</h3>
              <p class="text-xs text-slate-500 leading-relaxed">{it.desc}</p>
              <span class="mt-3 inline-flex items-center text-xs font-semibold text-med-blue gap-1 group-hover:gap-2 transition-all">
                Découvrez l'itinéraire →
              </span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- 3 Jours -->
  <section class="py-12 border-t border-slate-100">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center gap-4 mb-10">
        <span class="inline-block bg-med-gold/90 text-white text-xs font-bold uppercase tracking-wider px-3 py-1.5 rounded-full">3 jours</span>
        <h2 class="text-3xl font-bold font-serif text-charcoal">Rythme parfait entre découvertes</h2>
        <div class="flex-1 h-px bg-slate-100"></div>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {itineraries.d3.map((it) => (
          <a href={it.href} class="group block bg-white rounded-2xl border border-slate-100 overflow-hidden hover:shadow-lg hover:border-med-gold/20 transition-all duration-300">
            <!-- Image with overlay -->
            <div class="relative h-44 overflow-hidden">
              <img src={it.img} alt={it.title} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
              <div class="absolute inset-0 bg-gradient-to-t from-black/50 to-transparent" />
              <!-- Duration badge -->
              <span class="absolute bottom-3 left-3 text-[10px] font-bold uppercase tracking-wider text-white bg-med-gold/90 backdrop-blur-sm px-2.5 py-1 rounded-full">
                {it.tag}
              </span>
            </div>
            <!-- Text section -->
            <div class="p-5">
              <h3 class="font-semibold text-charcoal text-sm mb-1.5 group-hover:text-med-gold transition-colors">{it.title}</h3>
              <p class="text-xs text-slate-500 leading-relaxed">{it.desc}</p>
              <span class="mt-3 inline-flex items-center text-xs font-semibold text-med-gold gap-1 group-hover:gap-2 transition-all">
                Découvrez l'itinéraire →
              </span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- 7 Jours -->
  <section class="py-12 border-t border-slate-100">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center gap-4 mb-10">
        <span class="inline-block bg-med-terracotta/80 text-white text-xs font-bold uppercase tracking-wider px-3 py-1.5 rounded-full">- 7 jours</span>
        <h2 class="text-3xl font-bold font-serif text-charcoal">Slow travel sans hâte</h2>
        <div class="flex-1 h-px bg-slate-100"></div>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 max-w-2xl">
        {itineraries.d7.map((it) => (
          <a href={it.href} class="group block bg-white rounded-2xl border border-slate-100 overflow-hidden hover:shadow-lg hover:border-med-terracotta/20 transition-all duration-300">
            <!-- Image with overlay -->
            <div class="relative h-44 overflow-hidden">
              <img src={it.img} alt={it.title} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
              <div class="absolute inset-0 bg-gradient-to-t from-black/50 to-transparent" />
              <!-- Duration badge -->
              <span class="absolute bottom-3 left-3 text-[10px] font-bold uppercase tracking-wider text-white bg-med-terracotta/80 backdrop-blur-sm px-2.5 py-1 rounded-full">
                {it.tag}
              </span>
            </div>
            <!-- Text section -->
            <div class="p-5">
              <h3 class="font-semibold text-charcoal text-sm mb-1.5 group-hover:text-med-terracotta transition-colors">{it.title}</h3>
              <p class="text-xs text-slate-500 leading-relaxed">{it.desc}</p>
              <span class="mt-3 inline-flex items-center text-xs font-semibold text-med-terracotta gap-1 group-hover:gap-2 transition-all">
                Découvrez l'itinéraire →
              </span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- BANNER: Planificateur d'itinéraire -->
  <section class="py-10 md:py-14">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="relative overflow-hidden rounded-[2.5rem] bg-gradient-to-br from-slate-900 via-slate-950 to-blue-950 px-6 sm:px-10 md:px-14 py-10 md:py-14 shadow-[0_20px_60px_rgba(0,0,0,0.35)]">
        <div class="absolute -top-20 -left-20 w-72 h-72 bg-blue-500/15 rounded-full blur-3xl pointer-events-none"></div>
        <div class="absolute -bottom-20 -right-20 w-72 h-72 bg-amber-500/10 rounded-full blur-3xl pointer-events-none"></div>
        <div class="relative z-10 grid md:grid-cols-[3fr_2fr] md:items-center gap-8">
          <div>
            <span class="inline-block px-4 py-1.5 rounded-full text-xs font-semibold tracking-wide uppercase bg-med-gold/15 text-med-gold border border-med-gold/25 mb-6">Nouveau : Planificateur de Voyage</span>
            <h2 class="text-3xl md:text-4xl font-bold text-white leading-tight mb-2">Dessine ton</h2>
            <p class="font-serif text-3xl md:text-4xl italic text-med-blue mb-5">itinéraire idéal</p>
            <p class="text-white/60 text-base md:text-lg leading-relaxed max-w-xl mb-8">Réponds à quelques questions simples - point de départ, jours et centres d'intérêt - et reçois un itinéraire personnalisé avec transports, coûts et horaires.</p>
            <div class="flex flex-wrap gap-6">
              <div class="flex items-center gap-2.5">
                <div class="w-9 h-9 rounded-xl bg-white/5 border border-white/10 flex items-center justify-center">
                  <svg class="w-4.5 h-4.5 text-med-gold" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                </div>
                <span class="text-white/50 text-sm">30 secondes pour configurer</span>
              </div>
              <div class="flex items-center gap-2.5">
                <div class="w-9 h-9 rounded-xl bg-white/5 border border-white/10 flex items-center justify-center">
                  <svg class="w-4.5 h-4.5 text-med-gold" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 6.75V15m6-6v8.25m.503 3.498l4.875-2.437c.381-.19.622-.58.622-1.006V4.82c0-.836-.88-1.38-1.628-1.006l-3.869 1.934c-.317.159-.69.159-1.006 0L9.503 3.252a1.125 1.125 0 00-1.006 0L3.622 5.689C3.24 5.88 3 6.27 3 6.695V19.18c0 .836.88 1.38 1.628 1.006l3.869-1.934c.317-.159.69-.159 1.006 0l4.994 2.497c.317.158.69.158 1.006 0z"/></svg>
                </div>
                <span class="text-white/50 text-sm">Conseils anti-foule inclus</span>
              </div>
            </div>
          </div>
          <div class="mt-8 md:mt-0 md:flex md:justify-center">
            <a href="/fr-fr/planificateur-itineraire/" class="inline-flex items-center gap-2.5 px-7 py-3.5 bg-gradient-to-r from-med-gold to-yellow-600 text-slate-900 font-bold rounded-xl hover:shadow-[0_0_30px_rgba(212,175,55,0.4)] hover:scale-105 transition-all duration-300">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 2L2 12l4 0 0 6 4 0 0-4 4 0 0 4 4 0 0-6 4 0L12 2z"/></svg>
              Planifie Maintenant
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="bg-med-blue py-16 text-center">
    <div class="max-w-2xl mx-auto px-4">
      <h2 class="text-2xl font-bold text-white mb-4">Comment me rendre à la côte?</h2>
      <p class="text-white mb-6">Toutes les options: train, ferry, bus et transferts privés.</p>
      <a href={getLocalePath(lang, 'getting-here')}
        class="inline-block bg-med-blue text-white font-semibold px-8 py-3 rounded-full hover:bg-med-blue transition-colors">
        Guide de transport
      </a>
    </div>
  </section>
</BaseLayout>
