---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../../components/Breadcrumbs.astro';
import Swiper from 'swiper';
import { Pagination } from 'swiper/modules';

const lang = 'es-es';

const breadcrumbs = [
  { name: 'Inicio', url: '/es-es/' },
  { name: 'Planificación', url: '/es-es/planificacion/' },
  { name: 'Aparcamiento & ZTL', url: '/es-es/guia/aparcamiento-ztl/' },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "¿Se puede ir en coche a Positano?",
      "acceptedAnswer": { "@type": "Answer", "text": "En verano Positano está cerrado al tráfico de 9:00 a 18:00 (ZTL). Solo los residentes y los huéspedes de hoteles pueden entrar en coche. Mejor consejo: aparca en Sorrento o Praiano y llega en bus SITA o ferry." }
    },
    {
      "@type": "Question",
      "name": "¿Dónde aparcar para visitar la Costa Amalfitana?",
      "acceptedAnswer": { "@type": "Answer", "text": "Mejores opciones: 1) Dejar el coche en Salerno o Vietri sul Mare y tomar el bus/ferry. 2) Aparcar en Sorrento (Garaje Achille Lauro, ~€2/h) y tomar el bus SITA o el hidrofoil. 3) Usar los aparcamientos de pago de Amalfi (Luna Rossa, Flavio Gioia, ~€4–5/h)." }
    },
    {
      "@type": "Question",
      "name": "¿Cuánto cuesta aparcar en Amalfi?",
      "acceptedAnswer": { "@type": "Answer", "text": "Los principales aparcamientos de Amalfi (Luna Rossa y Flavio Gioia) cuestan ~€4–5/hora o ~€25–30/día. Casi siempre llenos en julio y agosto. Se recomienda llegar antes de las 9:00 o usar el transporte público." }
    }
  ]
};

const ztlData = [
  { location: 'Positano', ztl: 'Sí', period: 'Jun–Sep (9:00–18:00)', note: 'Acceso reservado a residentes y huéspedes de hoteles. Bus SITA o ferry recomendados.' },
  { location: 'Amalfi', ztl: 'Sí', period: 'Todo el año (centro)', note: 'ZTL permanente en el núcleo histórico. Aparcamientos de pago en el paseo marítimo (~€4/h).' },
  { location: 'Ravello', ztl: 'Sí', period: 'Verano (10:00–19:00)', note: 'Solo bus SITA desde Amalfi (25 min, ~€1,50) o coche con autorización del hotel.' },
  { location: 'Sorrento', ztl: 'Sí', period: 'Verano (centro)', note: 'Garajes cubiertos disponibles. Piazza Lauro ~€2/h.' },
  { location: 'Praiano', ztl: 'No', period: '-', note: 'Aparcamientos gratuitos y de pago en la SS163. Excelente punto de parada.' },
  { location: 'Maiori', ztl: 'No', period: '-', note: 'Aparcamientos disponibles en el paseo marítimo. Más fácil que los pueblos del oeste.' },
  { location: 'Minori', ztl: 'No', period: '-', note: 'Aparcamientos en el paseo marítimo, gratuitos o de bajo coste.' },
];
---

<BaseLayout
  title="Aparcamiento & ZTL Costa Amalfitana 2026 | Dónde Dejar el Coche"
  description="Guía completa de aparcamientos y zonas ZTL en la Costa Amalfitana: Positano, Amalfi, Ravello, Sorrento. Dónde aparcar y cómo llegar a los pueblos sin estrés."
  lang={lang}
  breadcrumbs={breadcrumbs}
  schema={[faqSchema]}
 pageKey="aparcamiento-ztl">

  <section class="relative h-[75vh] sm:h-[90vh] flex items-center bg-charcoal overflow-hidden">
    <img src="/images/parcheggi-hero.jpg" alt="Sorrento, Península Sorrentina" class="absolute inset-0 w-full h-full object-cover" loading="eager" referrerpolicy="no-referrer"/>
    <div class="absolute inset-0 bg-gradient-to-b from-black/25 via-black/40 to-black/75"></div>
    <div class="relative z-10 max-w-7xl mx-auto px-6 py-20">
      <div class="max-w-3xl">
        <p class="text-med-gold text-xs sm:text-sm font-medium uppercase tracking-[0.3em] mb-3">Guía práctica</p>
        <h1 class="font-serif text-display text-white mb-4">Aparcamiento & Zonas ZTL</h1>
        <p class="text-xl text-white/80 leading-relaxed">
          La Costa Amalfitana en verano es una pesadilla para los conductores: ZTL en todas partes, carreteras estrechas y aparcamientos caros. Consejo principal: deja el coche y usa el transporte público.
        </p>
      </div>
    </div>
    <Breadcrumbs breadcrumbs={breadcrumbs} />
  </section>

  <div class="max-w-editorial mx-auto px-4 sm:px-6 lg:px-8 pt-0 pb-4 space-y-12">

    <section class="max-w-editorial">
      <div style="background-color: #E2725B; border-color: #E2725B; padding: 6px 12px 6px 12px;" class="border rounded-[2rem] mb-6 mt-8">
        <p class="font-semibold mb-0 mt-0 text-white text-sm leading-tight" style="margin-top: -2px;">⚠️ Atención a las ZTL</p>
        <p class="text-xs text-white/95 leading-tight">Las ZTL (Zonas de Tráfico Limitado) de la Costa Amalfitana están vigiladas con cámaras. Entrar sin autorización conlleva una multa de €80–160 que llega directamente a la empresa de alquiler o a tu domicilio.</p>
      </div>
      <p class="text-xl leading-relaxed text-charcoal">
        La mejor estrategia es el "aparcamiento estratégico": dejar el coche en un punto accesible (Salerno, Vietri, Sorrento o Praiano) y usar desde allí buses, ferrys o hidrofoils.
      </p>
    </section>

    <section>
      <h2 class="font-serif text-2xl font-semibold text-slate-900 mb-6">ZTL y aparcamiento en cada pueblo</h2>
      <div class="overflow-x-auto rounded-2xl border border-slate-200">
        <table class="w-full text-xs sm:text-sm">
          <thead>
            <tr class="bg-slate-900 text-white">
              <th class="text-left px-4 py-3 font-semibold">Pueblo</th>
              <th class="text-left px-4 py-3 font-semibold">ZTL</th>
              <th class="text-left px-4 py-3 font-semibold">Período</th>
              <th class="text-left px-4 py-3 font-semibold">Consejo</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100">
            {ztlData.map(r => (
              <tr class="hover:bg-slate-50 transition-colors">
                <td class="px-4 py-3 font-semibold text-charcoal">{r.location}</td>
                <td class="px-4 py-3">
                  {r.ztl === 'Sí'
                    ? <span class="text-[10px] bg-red-50 text-red-600 px-2 py-0.5 rounded-full font-medium">Sí</span>
                    : <span class="text-[10px] bg-med-blue/5 text-med-blue px-2 py-0.5 rounded-full font-medium">No</span>
                  }
                </td>
                <td class="px-4 py-3 text-slate-500">{r.period}</td>
                <td class="px-4 py-3 text-slate-600 text-xs">{r.note}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section id="faq">
      <h2 class="font-serif text-2xl font-semibold text-slate-900 mb-6">Preguntas frecuentes</h2>
      <div class="space-y-4">
        {faqSchema.mainEntity.map((q) => (
          <details class="group border border-slate-200 rounded-2xl overflow-hidden">
            <summary class="flex items-center justify-between px-6 py-4 cursor-pointer select-none text-charcoal font-medium hover:bg-slate-50 transition-colors">
              {q.name}
              <svg class="w-4 h-4 text-slate-400 group-open:rotate-180 transition-transform flex-shrink-0 ml-3" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
            </summary>
            <div class="px-6 pb-5 text-slate-600 leading-relaxed text-xs sm:text-sm border-t border-slate-100 pt-4">
              {q.acceptedAnswer.text}
            </div>
          </details>
        ))}
      </div>
    </section>

    <!-- EVERYTHING YOU NEED -->
    <section class="py-16 bg-white">
      <div class="max-w-editorial mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-12">
          <h2 class="font-serif text-2xl font-semibold text-slate-900 mb-6">Todo lo que necesitas</h2>
          <div class="w-20 h-1 bg-med-gold mx-auto rounded-full"></div>
        </div>

        <!-- MOBILE: Swiper slider -->
        <div class="swiper swiper-guides md:hidden">
          <div class="swiper-wrapper pb-12">
            <div class="swiper-slide">
              <a href="/es-es/guia/ferries/" class="block bg-slate-900 rounded-[2rem] p-6 border-0 hover:shadow-lg transition-all duration-300 h-full">
                <h3 class="font-serif text-xl font-bold text-med-gold mb-2">Ferrys e Hidrofoils</h3>
                <p class="text-white text-sm mb-3">Cómo llegar a la costa por mar</p>
                <p class="text-white/70 text-xs leading-relaxed mb-4">Horarios, tarifas y rutas principales desde Nápoles y Salerno</p>
                <span class="text-med-gold font-semibold text-sm">Leer la guía →</span>
              </a>
            </div>
            <div class="swiper-slide">
              <a href="/es-es/guia/bus-sita/" class="block bg-slate-900 rounded-[2rem] p-6 border-0 hover:shadow-lg transition-all duration-300 h-full">
                <h3 class="font-serif text-xl font-bold text-med-gold mb-2">Bus SITA</h3>
                <p class="text-white text-sm mb-3">Horarios, tarifas y rutas principales</p>
                <p class="text-white/70 text-xs leading-relaxed mb-4">Moverte por la costa en autobús: todas las líneas y paradas</p>
                <span class="text-med-gold font-semibold text-sm">Leer →</span>
              </a>
            </div>
            <div class="swiper-slide">
              <a href="/es-es/guia/cuando-visitar/" class="block bg-slate-900 rounded-[2rem] p-6 border-0 hover:shadow-lg transition-all duration-300 h-full">
                <h3 class="font-serif text-xl font-bold text-med-gold mb-2">Cuándo Visitar</h3>
                <p class="text-white text-sm mb-3">Mes a mes: clima y aglomeración</p>
                <p class="text-white/70 text-xs leading-relaxed mb-4">Elige el mejor momento para tu visita</p>
                <span class="text-med-gold font-semibold text-sm">Leer →</span>
              </a>
            </div>
          </div>
          <div class="swiper-pagination"></div>
        </div>

        <!-- DESKTOP: Grid 3 colonne -->
        <div class="hidden md:grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          <a href="/es-es/guia/ferries/" class="block bg-slate-900 rounded-[2rem] p-6 border-0 hover:shadow-lg transition-all duration-300">
            <h3 class="font-serif text-xl font-bold text-med-gold mb-2">Ferrys e Hidrofoils</h3>
            <p class="text-white text-sm mb-3">Cómo llegar a la costa por mar</p>
            <p class="text-white/70 text-xs leading-relaxed mb-4">Horarios, tarifas y rutas principales desde Nápoles y Salerno</p>
            <span class="text-med-gold font-semibold text-sm">Leer la guía →</span>
          </a>

          <a href="/es-es/guia/bus-sita/" class="block bg-slate-900 rounded-[2rem] p-6 border-0 hover:shadow-lg transition-all duration-300">
            <h3 class="font-serif text-xl font-bold text-med-gold mb-2">Bus SITA</h3>
            <p class="text-white text-sm mb-3">Horarios, tarifas y rutas principales</p>
            <p class="text-white/70 text-xs leading-relaxed mb-4">Moverte por la costa en autobús: todas las líneas y paradas</p>
            <span class="text-med-gold font-semibold text-sm">Leer →</span>
          </a>

          <a href="/es-es/guia/cuando-visitar/" class="block bg-slate-900 rounded-[2rem] p-6 border-0 hover:shadow-lg transition-all duration-300">
            <h3 class="font-serif text-xl font-bold text-med-gold mb-2">Cuándo Visitar</h3>
            <p class="text-white text-sm mb-3">Mes a mes: clima y aglomeración</p>
            <p class="text-white/70 text-xs leading-relaxed mb-4">Elige el mejor momento para tu visita</p>
            <span class="text-med-gold font-semibold text-sm">Leer →</span>
          </a>
        </div>
      </div>
    </section>

    <!-- AUTHENTIC EXPERIENCES -->
    <section class="py-16 bg-white overflow-hidden">
      <div class="max-w-editorial mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex flex-col md:flex-row justify-between items-end mb-12 gap-6">
          <div class="max-w-2xl">
            <span class="text-med-gold font-bold uppercase tracking-[0.3em] text-xs mb-4 block">Vive la Costa</span>
            <h2 class="font-serif text-2xl font-semibold text-slate-900 mb-6">Experiencias Auténticas</h2>
            <p class="text-slate-600 text-lg">De la gastronomía tradicional a los limonares, descubre el verdadero espíritu de la Costa.</p>
          </div>
          <a href="/es-es/experiencias/" class="group flex items-center gap-2 text-med-blue font-semibold hover:text-med-gold transition-colors">
            Todas las Experiencias
            <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
          </a>
        </div>

        <!-- MOBILE: Swiper slider -->
        <div class="swiper swiper-experiences md:hidden">
          <div class="swiper-wrapper pb-12">
            <div class="swiper-slide">
              <a href="/es-es/experiencias/clase-cocina/" class="group block">
                <div class="relative aspect-[16/10] rounded-[2.5rem] overflow-hidden mb-6 shadow-lg">
                  <img
                    src="/images/cooking-class-hero.webp"
                    alt="Clase de Cocina"
                    class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
                    loading="lazy"
                    decoding="async"
                  />
                  <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent" />
                  <div class="absolute bottom-6 left-6">
                    <h3 class="text-2xl font-serif font-bold text-white">Clase de Cocina</h3>
                  </div>
                </div>
              </a>
            </div>
            <div class="swiper-slide">
              <a href="/es-es/experiencias/tour-limoncello/" class="group block">
                <div class="relative aspect-[16/10] rounded-[2.5rem] overflow-hidden mb-6 shadow-lg">
                  <img
                    src="/images/limoncello-mercato-hero.webp"
                    alt="Tour Limoncello"
                    class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
                    loading="lazy"
                    decoding="async"
                  />
                  <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent" />
                  <div class="absolute bottom-6 left-6">
                    <h3 class="text-2xl font-serif font-bold text-white">Tour Limoncello</h3>
                  </div>
                </div>
              </a>
            </div>
            <div class="swiper-slide">
              <a href="/es-es/experiencias/experiencia-mozzarella/" class="group block">
                <div class="relative aspect-[16/10] rounded-[2.5rem] overflow-hidden mb-6 shadow-lg">
                  <img
                    src="/images/mozzarella-provolone-hero.webp"
                    alt="Experiencia Mozzarella"
                    class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
                    loading="lazy"
                    decoding="async"
                  />
                  <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent" />
                  <div class="absolute bottom-6 left-6">
                    <h3 class="text-2xl font-serif font-bold text-white">Experiencia Mozzarella</h3>
                  </div>
                </div>
              </a>
            </div>
            <div class="swiper-slide">
              <a href="/es-es/experiencias/restaurantes-estrella/" class="group block">
                <div class="relative aspect-[16/10] rounded-[2.5rem] overflow-hidden mb-6 shadow-lg">
                  <img
                    src="/images/ravello-hero.webp"
                    alt="Restaurantes Michelin"
                    class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
                    loading="lazy"
                    decoding="async"
                  />
                  <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent" />
                  <div class="absolute bottom-6 left-6">
                    <h3 class="text-2xl font-serif font-bold text-white">Restaurantes Michelin</h3>
                  </div>
                </div>
              </a>
            </div>
          </div>
          <div class="swiper-pagination"></div>
        </div>

        <!-- DESKTOP: Grid -->
        <div class="hidden md:grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
          <a href="/es-es/experiencias/clase-cocina/" class="group block">
            <div class="relative aspect-[16/10] rounded-[2.5rem] overflow-hidden mb-6 shadow-lg">
              <img
                src="/images/cooking-class-hero.webp"
                alt="Clase de Cocina"
                class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
                loading="lazy"
                decoding="async"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent" />
              <div class="absolute bottom-6 left-6">
                <h3 class="text-2xl font-serif font-bold text-white">Clase de Cocina</h3>
              </div>
            </div>
          </a>

          <a href="/es-es/experiencias/tour-limoncello/" class="group block">
            <div class="relative aspect-[16/10] rounded-[2.5rem] overflow-hidden mb-6 shadow-lg">
              <img
                src="/images/limoncello-mercato-hero.webp"
                alt="Tour Limoncello"
                class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
                loading="lazy"
                decoding="async"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent" />
              <div class="absolute bottom-6 left-6">
                <h3 class="text-2xl font-serif font-bold text-white">Tour Limoncello</h3>
              </div>
            </div>
          </a>

          <a href="/es-es/experiencias/experiencia-mozzarella/" class="group block">
            <div class="relative aspect-[16/10] rounded-[2.5rem] overflow-hidden mb-6 shadow-lg">
              <img
                src="/images/mozzarella-provolone-hero.webp"
                alt="Experiencia Mozzarella"
                class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
                loading="lazy"
                decoding="async"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent" />
              <div class="absolute bottom-6 left-6">
                <h3 class="text-2xl font-serif font-bold text-white">Experiencia Mozzarella</h3>
              </div>
            </div>
          </a>

          <a href="/es-es/experiencias/restaurantes-estrella/" class="group block">
            <div class="relative aspect-[16/10] rounded-[2.5rem] overflow-hidden mb-6 shadow-lg">
              <img
                src="/images/ravello-hero.webp"
                alt="Restaurantes Michelin"
                class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
                loading="lazy"
                decoding="async"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent" />
              <div class="absolute bottom-6 left-6">
                <h3 class="text-2xl font-serif font-bold text-white">Restaurantes Michelin</h3>
              </div>
            </div>
          </a>
        </div>
      </div>
    </section>

  </div>

<script>
  import Swiper from 'swiper';
  import { Pagination } from 'swiper/modules';

  // Guides slider
  new Swiper('.swiper-guides', {
    modules: [Pagination],
    slidesPerView: 1.2,
    spaceBetween: 16,
    pagination: { el: '.swiper-guides .swiper-pagination', clickable: true },
  });
</script>

<style is:global>
  @import 'swiper/css';
  @import 'swiper/css/pagination';

  :root {
    --swiper-pagination-color: #D4AF37;
  }

  .swiper-pagination-bullet {
    background-color: var(--swiper-pagination-color);
    opacity: 0.5;
  }

  .swiper-pagination-bullet-active {
    opacity: 1;
  }

  /* Hide sliders on desktop */
  @media (min-width: 768px) {
    .swiper {
      display: none !important;
    }
  }
</style>

</BaseLayout>
