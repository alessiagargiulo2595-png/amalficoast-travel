---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../../components/Breadcrumbs.astro';
import { getTranslations, getLocalePath } from '../../../../i18n/translations';

const lang = 'es-es';
const t = getTranslations(lang);

const breadcrumbs = [
  { name: 'Home', url: '/es-es/' },
  { name: 'Planificación', url: '/es-es/planificacion/' },
  { name: 'Cómo llegar', url: '/es-es/guia/como-llegar/' },
];
---

<BaseLayout
  title={t.meta.getting_here_title}
  description={t.meta.getting_here_description}
  lang={lang}
  breadcrumbs={breadcrumbs}
 pageKey="como-llegar"
  heroImage="/images/come-arrivare-hero.jpg"
>
  <!-- Hero -->
  <section class="relative h-[75vh] sm:h-[90vh] flex items-center bg-charcoal overflow-hidden">
    <img src="/images/come-arrivare-hero.jpg" alt="Puerto de Sorrento, Costa Amalfitana" class="absolute inset-0 w-full h-full object-cover" loading="eager" fetchpriority="high" decoding="sync" referrerpolicy="no-referrer"/>
    <div class="absolute inset-0 bg-gradient-to-b from-black/25 via-black/40 to-black/75"></div>
    <div class="relative z-10 max-w-7xl mx-auto px-6 text-center">
      <p class="text-med-gold text-xs sm:text-sm uppercase tracking-[0.3em] mb-3 font-medium">Guía práctica</p>
      <h1 class="font-serif text-4xl md:text-5xl font-bold text-white mb-4 tracking-tight">Cómo llegar a la Costa Amalfitana</h1>
      <p class="text-white/80 text-lg max-w-2xl mx-auto font-light">Tren, avión, ferry o coche: todas las opciones para llegar a la costa desde Italia y el extranjero.</p>
    </div>
    <Breadcrumbs breadcrumbs={breadcrumbs} />
  </section>

  <section class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <p class="text-base sm:text-lg text-slate-600 leading-relaxed">
      La Costa Amalfitana no tiene aeropuerto propio ni estación de tren en su tramo principal. La forma más cómoda de llegar es pasar por Nápoles (aeropuerto internacional y estación de alta velocidad) o por Salerno (accesible en tren desde toda Italia). Desde allí hay ferris, autobuses y traslados privados.
    </p>
  </section>

  <!-- Nuestro consejo -->
  <section class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 pb-12">
    <div class="bg-slate-900 rounded-[2rem] p-6 sm:p-8">
      <div class="flex items-start gap-4">
        <div class="w-10 h-10 rounded-xl bg-med-gold/15 flex items-center justify-center flex-shrink-0 mt-1">
          <svg class="w-5 h-5 text-med-gold" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 18v-5.25m0 0a6.01 6.01 0 0 0 1.5-.189m-1.5.189a6.01 6.01 0 0 1-1.5-.189m3.75 7.478a12.06 12.06 0 0 1-4.5 0m3.75 2.383a14.406 14.406 0 0 1-3 0M14.25 18v-.192c0-.983.658-1.823 1.508-2.316a7.5 7.5 0 1 0-7.517 0c.85.493 1.509 1.333 1.509 2.316V18"/></svg>
        </div>
        <div>
          <p class="text-med-gold text-xs font-bold uppercase tracking-wider mb-2">Nuestro consejo</p>
          <p class="text-white/80 text-sm sm:text-base leading-relaxed"><strong class="text-white">En temporada alta (may-oct):</strong> vuela a Nápoles, toma el ferry directo a Positano o Amalfi. Sin tráfico, vistas impresionantes.</p>
          <p class="text-white/80 text-sm sm:text-base leading-relaxed mt-2"><strong class="text-white">En temporada baja (nov-abr):</strong> tren de alta velocidad hasta Salerno + bus SITA. Más económico y los ferris no operan.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Comparación de métodos -->
  <section class="bg-slate-900 py-16">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-[10px] uppercase tracking-[0.3em] text-med-gold font-medium mb-3">Comparación rápida</p>
      <h2 class="text-2xl font-bold font-serif text-white mb-10">¿Qué transporte elegir?</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-4">

        <div class="bg-white/5 border border-med-gold/30 rounded-2xl p-5 relative">
          <span class="absolute -top-3 left-4 bg-med-gold text-white text-[10px] font-bold uppercase tracking-wider px-3 py-1 rounded-full">Recomendado</span>
          <div class="mt-2">
            <p class="text-white font-bold text-lg mb-1">Ferry</p>
            <p class="text-white/40 text-xs mb-4">Abr - Oct</p>
            <div class="space-y-2 text-xs text-white/60">
              <p><span class="text-white/80 font-medium">Coste:</span> €15 - €25</p>
              <p><span class="text-white/80 font-medium">Tiempo:</span> 1h - 1h30</p>
              <p><span class="text-white/80 font-medium">Comodidad:</span> <span class="text-med-gold">Alta</span></p>
              <p><span class="text-white/80 font-medium">Tráfico:</span> Ninguno</p>
            </div>
          </div>
        </div>

        <div class="bg-white/5 border border-white/10 rounded-2xl p-5">
          <p class="text-white font-bold text-lg mb-1">Tren + Bus</p>
          <p class="text-white/40 text-xs mb-4">Todo el año</p>
          <div class="space-y-2 text-xs text-white/60">
            <p><span class="text-white/80 font-medium">Coste:</span> €6 - €10</p>
            <p><span class="text-white/80 font-medium">Tiempo:</span> 2h30 - 3h</p>
            <p><span class="text-white/80 font-medium">Comodidad:</span> Media</p>
            <p><span class="text-white/80 font-medium">Tráfico:</span> Posible en bus</p>
          </div>
        </div>

        <div class="bg-white/5 border border-white/10 rounded-2xl p-5">
          <p class="text-white font-bold text-lg mb-1">Transfer privado</p>
          <p class="text-white/40 text-xs mb-4">Todo el año</p>
          <div class="space-y-2 text-xs text-white/60">
            <p><span class="text-white/80 font-medium">Coste:</span> €90 - €150</p>
            <p><span class="text-white/80 font-medium">Tiempo:</span> 1h - 1h30</p>
            <p><span class="text-white/80 font-medium">Comodidad:</span> <span class="text-med-gold">Alta</span></p>
            <p><span class="text-white/80 font-medium">Tráfico:</span> Posible</p>
          </div>
        </div>

        <div class="bg-white/5 border border-white/10 rounded-2xl p-5">
          <p class="text-white font-bold text-lg mb-1">Coche propio</p>
          <p class="text-white/40 text-xs mb-4">Solo temporada baja</p>
          <div class="space-y-2 text-xs text-white/60">
            <p><span class="text-white/80 font-medium">Coste:</span> Combustible + aparcamiento</p>
            <p><span class="text-white/80 font-medium">Tiempo:</span> Variable</p>
            <p><span class="text-white/80 font-medium">Comodidad:</span> Media</p>
            <p><span class="text-white/80 font-medium">Tráfico:</span> <span class="text-red-400">Intenso en verano</span></p>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- Métodos -->
  <section class="py-16">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">

      <!-- Desde Nápoles -->
      <div class="bg-white rounded-[2rem] shadow-sm border border-slate-100 p-6 sm:p-8">
        <div class="flex items-center gap-4 mb-6">
          <div class="w-12 h-12 bg-med-gold rounded-2xl flex items-center justify-center">
            <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"/></svg>
          </div>
          <div>
            <h2 class="text-2xl font-bold font-serif">Desde Nápoles</h2>
            <p class="text-med-gold text-xs sm:text-sm">Aeropuerto de Capodichino · Estación Central de Nápoles</p>
          </div>
        </div>
        <p class="text-slate-600 leading-relaxed mb-6">
          Nápoles es el principal punto de acceso a la Costa Amalfitana. El aeropuerto internacional de Nápoles-Capodichino (NAP) tiene vuelos directos desde todas las principales ciudades europeas, incluidos muchos vuelos de bajo coste desde Roma, Milán, Londres, París, Fráncfort y Madrid. Desde Nápoles hay tres opciones para llegar a la costa:
        </p>
        <div class="space-y-4">
          <div class="bg-med-gold/5 rounded-2xl p-4 sm:p-5">
            <h3 class="font-semibold text-slate-900 mb-2">Ferry directo (verano)</h3>
            <p class="text-slate-600 text-xs sm:text-sm">De abril a octubre, ferris rápidos desde el Molo Beverello de Nápoles llegan directamente a Positano y Amalfi en aproximadamente 1h30. Cómodo, pintoresco y sin atascos. Reserva con antelación en temporada alta.</p>
          </div>
          <div class="bg-med-gold/5 rounded-2xl p-4 sm:p-5">
            <h3 class="font-semibold text-slate-900 mb-2">Bus SITA vía Sorrento</h3>
            <p class="text-slate-600 text-xs sm:text-sm">Circumvesuviana de Nápoles a Sorrento (unos 1h), luego bus SITA por la costa. Económico pero lento (2h30–3h en total). Buena opción si quieres evitar el coche.</p>
          </div>
          <div class="bg-med-gold/5 rounded-2xl p-4 sm:p-5">
            <h3 class="font-semibold text-slate-900 mb-2">Traslado privado</h3>
            <p class="text-slate-600 text-xs sm:text-sm">Taxi o NCC desde el aeropuerto de Nápoles: unos 90–120 euros hasta Positano/Amalfi (1h–1h30 sin tráfico). Cómodo para familias o con equipaje voluminoso.</p>
          </div>
        </div>
      </div>

      <!-- Desde Salerno -->
      <div class="bg-white rounded-[2rem] shadow-sm border border-slate-100 p-6 sm:p-8">
        <div class="flex items-center gap-4 mb-6">
          <div class="w-12 h-12 bg-med-gold rounded-2xl flex items-center justify-center">
            <svg class="w-6 h-6 text-white" fill="currentColor" viewBox="0 0 24 24"><rect x="2" y="7" width="20" height="10" rx="1"/><rect x="4" y="17" width="3" height="2"/><rect x="17" y="17" width="3" height="2"/><path d="M2 7L4 2h16l2 5"/></svg>
          </div>
          <div>
            <h2 class="text-2xl font-bold font-serif">Desde Salerno</h2>
            <p class="text-med-gold text-xs sm:text-sm">Puerta de entrada oriental a la Costa Amalfitana</p>
          </div>
        </div>
        <p class="text-slate-600 leading-relaxed mb-6">
          Salerno es una entrada a menudo subestimada pero muy cómoda. La estación de Salerno está servida por trenes de alta velocidad (1h40 desde Roma, 2h30 desde Milán) y muchos trenes regionales. El aeropuerto Salerno-Costa de Amalfi (QSR) es el más cercano a la costa, con vuelos nacionales y algunas rutas europeas. Desde Salerno, el bus SITA hacia la costa es frecuente y tarda 45 minutos hasta Amalfi. En verano también hay ferris.
        </p>
        <div class="space-y-4">
          <div class="bg-med-gold/5 rounded-2xl p-4 sm:p-5">
            <h3 class="font-semibold text-slate-900 mb-2">Aeropuerto Salerno-Costa de Amalfi (QSR)</h3>
            <p class="text-slate-600 text-xs sm:text-sm">El aeropuerto más cercano a la Costa Amalfitana, a solo 20 km de Vietri sul Mare. Vuelos desde Milán, Roma y algunas ciudades europeas. Desde el aeropuerto, autobús o traslado privado hacia la costa en unos 30 minutos.</p>
          </div>
          <div class="bg-med-gold/5 rounded-2xl p-4 sm:p-5">
            <h3 class="font-semibold text-slate-900 mb-2">Ferry desde Salerno (verano)</h3>
            <p class="text-slate-600 text-xs sm:text-sm">Ferris de Salerno a Amalfi y Positano de abril a octubre. Unos 45 minutos hasta Amalfi, con hermosas vistas de la costa. Más económico que los ferris desde Nápoles.</p>
          </div>
        </div>
      </div>

      <!-- Desde Sorrento -->
      <div class="bg-white rounded-[2rem] shadow-sm border border-slate-100 p-6 sm:p-8">
        <div class="flex items-center gap-4 mb-6">
          <div class="w-12 h-12 bg-med-gold rounded-2xl flex items-center justify-center">
            <svg class="w-6 h-6 text-white" fill="currentColor" viewBox="0 0 24 24"><path d="M3 13h18v2H3zm0-4h18v2H3zm0 8h18v2H3zm9-12L6 8h12l-6-3zm0 14l-6 3h12l-6-3z"/></svg>
          </div>
          <div>
            <h2 class="text-2xl font-bold font-serif">Desde Sorrento</h2>
            <p class="text-med-gold text-xs sm:text-sm">En ferry o por la carretera panorámica</p>
          </div>
        </div>
        <p class="text-slate-600 leading-relaxed">
          Sorrento es una base muy frecuentada para visitar tanto la Península Sorrentina como la Costa Amalfitana. Los ferris desde Sorrento llegan a Positano en 25 minutos: es la forma más pintoresca y rápida de entrar en la costa. Alternativamente, el bus SITA recorre la SP145 y la SS163 en unas 1h30 hasta Amalfi.
        </p>
      </div>

      <!-- En coche -->
      <div class="bg-white rounded-[2rem] shadow-sm border border-slate-100 p-6 sm:p-8">
        <div class="flex items-center gap-4 mb-6">
          <div class="w-12 h-12 bg-med-gold rounded-2xl flex items-center justify-center">
            <svg class="w-6 h-6 text-white" fill="currentColor" viewBox="0 0 24 24"><path d="M18.92 6.01C18.72 5.42 18.16 5 17.5 5h-11c-.66 0-1.22.42-1.42 1.01L3 12v8c0 .55.45 1 1 1h1c.55 0 1-.45 1-1v-1h12v1c0 .55.45 1 1 1h1c.55 0 1-.45 1-1v-8l-2.08-5.99zM6.5 16c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2zm11 0c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2z"/></svg>
          </div>
          <div>
            <h2 class="text-2xl font-bold font-serif">En coche</h2>
            <p class="text-med-gold text-xs sm:text-sm font-medium">⚠️ No recomendado en julio y agosto</p>
          </div>
        </div>
        <p class="text-slate-600 leading-relaxed mb-6">
          La SS163, la carretera costera que atraviesa la Costa Amalfitana, es una de las más espectaculares de Europa pero también una de las más estrechas. En temporada alta el tráfico puede ser paralizante, con horas de atascos. Si usas el coche, ten en cuenta estos consejos:
        </p>
        <ul class="space-y-3">
          <li class="flex gap-3 text-xs sm:text-sm text-slate-600">
            <svg class="w-5 h-5 text-med-gold flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
            Salir antes de las 8h o después de las 19h para evitar el tráfico
          </li>
          <li class="flex gap-3 text-xs sm:text-sm text-slate-600">
            <svg class="w-5 h-5 text-med-gold flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
            Aparcar en Sorrento o Salerno y usar el transporte público o los ferris por la costa
          </li>
          <li class="flex gap-3 text-xs sm:text-sm text-slate-600">
            <svg class="w-5 h-5 text-med-gold flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
            Los aparcamientos en Amalfi y Positano cuestan 3–5 €/hora y a menudo están completos en temporada alta
          </li>
          <li class="flex gap-3 text-xs sm:text-sm text-slate-600">
            <svg class="w-5 h-5 text-med-gold flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
            En primavera (abril–mayo) y otoño (septiembre–octubre) conducir es agradable y cómodo
          </li>
        </ul>
      </div>

    </div>
  </section>

  <!-- Desde Roma / Milán / Extranjero -->
  <section class="pb-16">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl font-bold font-serif text-slate-900 mb-8">¿Desde dónde sales?</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4 sm:gap-6">

        <div class="bg-white rounded-[2rem] shadow-sm border border-slate-100 p-6">
          <p class="text-med-gold text-xs font-bold uppercase tracking-wider mb-3">Desde Roma</p>
          <ul class="space-y-2 text-slate-600 text-xs sm:text-sm">
            <li class="flex gap-2"><span class="text-med-gold font-bold">1.</span> Tren AV Roma - Salerno (1h40, desde €19)</li>
            <li class="flex gap-2"><span class="text-med-gold font-bold">2.</span> Bus SITA Salerno - Amalfi (45 min, €2.40)</li>
            <li class="flex gap-2"><span class="text-slate-400 text-xs">Total: unos 2h30 - la vía más rápida</span></li>
          </ul>
        </div>

        <div class="bg-white rounded-[2rem] shadow-sm border border-slate-100 p-6">
          <p class="text-med-blue text-xs font-bold uppercase tracking-wider mb-3">Desde Milán</p>
          <ul class="space-y-2 text-slate-600 text-xs sm:text-sm">
            <li class="flex gap-2"><span class="text-med-blue font-bold">A.</span> Vuelo Milán - Nápoles (1h15, desde €30) + ferry</li>
            <li class="flex gap-2"><span class="text-med-blue font-bold">B.</span> Vuelo Milán - Salerno (1h20) - aeropuerto más cercano a la costa</li>
            <li class="flex gap-2"><span class="text-med-blue font-bold">C.</span> Tren AV Milán - Salerno (4h30, desde €39) + bus</li>
            <li class="flex gap-2"><span class="text-slate-400 text-xs">Salerno es el más cercano, Nápoles tiene más vuelos</span></li>
          </ul>
        </div>

        <div class="bg-white rounded-[2rem] shadow-sm border border-slate-100 p-6">
          <p class="text-slate-500 text-xs font-bold uppercase tracking-wider mb-3">Desde el extranjero</p>
          <ul class="space-y-2 text-slate-600 text-xs sm:text-sm">
            <li class="flex gap-2"><span class="text-slate-400 font-bold">✈</span> Vuela a Nápoles (NAP) - vuelos directos desde Londres, París, Berlín, Madrid, Ámsterdam</li>
            <li class="flex gap-2"><span class="text-slate-400 font-bold">✈</span> Salerno (QSR) - aeropuerto Costa de Amalfi, el más cercano a la costa</li>
            <li class="flex gap-2"><span class="text-slate-400 font-bold">✈</span> Alternativa: Roma Fiumicino + tren AV a Salerno</li>
            <li class="flex gap-2"><span class="text-slate-400 text-xs">Salerno es el más cercano, Nápoles tiene más vuelos low cost, Roma más intercontinentales</span></li>
          </ul>
        </div>

      </div>
    </div>
  </section>

  <!-- Distancias y tiempos de viaje - Tab por destino -->
  <section class="bg-slate-100 py-16">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl font-bold font-serif text-slate-900 mb-8 text-center">Distancias y tiempos de viaje</h2>

      <!-- Tab buttons -->
      <div class="flex flex-wrap justify-center gap-2 mb-8" role="tablist">
        <button role="tab" aria-selected="true" data-tab="costiera" class="tab-btn px-4 py-2 rounded-full text-xs sm:text-sm font-medium bg-slate-900 text-white transition-colors">Costa Amalfitana</button>
        <button role="tab" aria-selected="false" data-tab="penisola" class="tab-btn px-4 py-2 rounded-full text-xs sm:text-sm font-medium bg-white text-slate-600 hover:bg-slate-200 transition-colors">Península Sorrentina</button>
        <button role="tab" aria-selected="false" data-tab="isole" class="tab-btn px-4 py-2 rounded-full text-xs sm:text-sm font-medium bg-white text-slate-600 hover:bg-slate-200 transition-colors">Islas</button>
      </div>

      <!-- Tab: Costa Amalfitana -->
      <div data-panel="costiera" class="tab-panel">
        <div class="overflow-x-auto">
          <table class="w-full bg-white rounded-2xl shadow-sm overflow-hidden">
            <thead class="bg-slate-900 text-white">
              <tr>
                <th class="px-3 py-2 sm:px-6 sm:py-4 text-left text-xs sm:text-sm font-semibold">Desde</th>
                <th class="px-3 py-2 sm:px-6 sm:py-4 text-left text-xs sm:text-sm font-semibold">Hasta</th>
                <th class="px-3 py-2 sm:px-6 sm:py-4 text-left text-xs sm:text-sm font-semibold">Transporte</th>
                <th class="px-3 py-2 sm:px-6 sm:py-4 text-left text-xs sm:text-sm font-semibold">Tiempo</th>
                <th class="px-3 py-2 sm:px-6 sm:py-4 text-left text-xs sm:text-sm font-semibold">Precio</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
            <!-- Positano -->
            <tr class="hover:bg-slate-50">
              <td class="px-3 py-2 sm:px-6 sm:py-4 text-xs sm:text-sm">Nápoles (Beverello)</td>
              <td class="px-3 py-2 sm:px-6 sm:py-4 text-xs sm:text-sm font-medium">Positano</td>
              <td class="px-3 py-2 sm:px-6 sm:py-4 text-xs sm:text-sm">Ferry (verano)</td>
              <td class="px-3 py-2 sm:px-6 sm:py-4 text-xs sm:text-sm text-med-gold font-medium">1h 30min</td>
              <td class="px-3 py-2 sm:px-6 sm:py-4 text-xs sm:text-sm">€18 - €22</td>
