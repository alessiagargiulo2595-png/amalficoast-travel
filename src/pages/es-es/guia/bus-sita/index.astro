---
import BaseLayout from '../../../../layouts/BaseLayout.astro';

const lang = 'es-es';

const breadcrumbs = [
  { name: 'Inicio', url: '/es-es/' },
  { name: 'Planificación', url: '/es-es/planificacion/' },
  { name: 'Bus SITA', url: '/es-es/guia/bus-sita/' },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "¿Cómo funciona el bus SITA en la Costa Amalfitana?",
      "acceptedAnswer": { "@type": "Answer", "text": "El bus SITA (actualmente SITA Sud, operado por EAV) recorre la SS163 entre Sorrento y Salerno, parando en Positano, Praiano, Amalfi, Maiori y Minori. Los billetes deben comprarse antes de subir en un estanco o quiosco - no se venden en el bus. Precio: unos €2,50-4 por trayecto; las tarifas se ajustaron el 1 de octubre de 2026, comprueba el precio vigente al comprar." }
    },
    {
      "@type": "Question",
      "name": "¿Cuánto tarda el bus de Sorrento a Amalfi?",
      "acceptedAnswer": { "@type": "Answer", "text": "El horario oficial vigente desde el 14 de septiembre de 2026 prevé de 75 a 100 minutos, según el recorrido. En verano (julio-agosto) el tráfico en la SS163 puede alargarlo a 2-2,5 horas. De Amalfi a Positano se tarda 40 minutos hasta la parada Sponda y 50 hasta Chiesa Nuova." }
    },
    {
      "@type": "Question",
      "name": "¿Puedo llevar equipaje grande en el bus SITA?",
      "acceptedAnswer": { "@type": "Answer", "text": "Los buses SITA en la SS163 son pequeños. En verano están abarrotados. Las maletas grandes son difíciles de manejar: usa una bolsa compacta o mochila." }
    },
    {
      "@type": "Question",
      "name": "¿A qué hora salen el primer y el último bus SITA entre Sorrento y Amalfi?",
      "acceptedAnswer": { "@type": "Answer", "text": "Con el horario vigente desde el 14 de septiembre de 2026, el primer bus de Sorrento a Amalfi sale a las 06:30 de lunes a sábado (08:30 domingos y festivos) y el último a las 19:50 (19:15 domingos y festivos). De Amalfi a Sorrento el primero sale a las 06:20 todos los días y el último a las 21:30 (21:00 domingos y festivos). Comprueba sitasudtrasporti.it antes de viajar, sobre todo en festivos." }
    }
  ]
};

