const lineNames = {"ML2":"Sorrento → Massa Lubrense → Sant'Agata","ML1":"Sant'Agata → Massa Lubrense → Sorrento","NV2":"Sorrento → Priora → Sant'Agata (vía Nastro Verde)","NV1":"Sant'Agata → Priora → Sorrento (vía Nastro Verde)"};
const runSpan = (a, b, n) => `de ${a} a ${b} (${n} salidas)`;
// [line, Mon-Sat first, Mon-Sat last, Mon-Sat runs, Sun/hol first, Sun/hol last, Sun/hol runs]
const peninsulaLines = [
