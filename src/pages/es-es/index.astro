---
import BaseLayout from '../../layouts/BaseLayout.astro';

const lang = 'es-es';

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "TouristDestination",
    "name": "Costa de Amalfi",
    "alternateName": "Amalfi Coast",
    "description": "Patrimonio de la Humanidad UNESCO, 50 km de acantilados en el Tirreno en Campania, Italia.",
    "url": "https://amalficoast-travel.com/es-es/",
    "geo": { "@type": "GeoCoordinates", "latitude": "40.634", "longitude": "14.602" },
    "containedInPlace": { "@type": "Country", "name": "Italy" }
  }
];

const silos = [
  {
    title: 'Costa de Amalfi',
    subtitle: '50 km de acantilados UNESCO',
    href: '/es-es/costiera-amalfitana/',
    borghi: ['Positano', 'Amalfi', 'Ravello', 'Praiano', 'Maiori', 'Minori'],
    img: '/images/costiera-hero.webp',
  },
  {
    title: 'Península de Sorrento',
    subtitle: 'La puerta del Sur de Italia',
    href: '/es-es/penisola-sorrentina/',
    borghi: ['Sorrento', 'Vico Equense', 'Massa Lubrense', "Sant'Agnello"],
    img: '/images/sorrento-hero.webp',
  },
  {
    title: 'Islas del Golfo',
    subtitle: 'Capri, Ischia, Procida',
    href: '/es-es/isole/',
    borghi: ['Capri', 'Ischia', 'Procida'],
    img: '/images/capri-hero.webp',
  },
];

const borghi = [
  {
    name: 'Positano',
    subtitle: 'La postal viviente',
    description: 'Famosa por sus casas de colores pastel en cascada, boutiques de lujo y la espectacular Playa Grande.',
    img: '/images/positano-hero.webp',
    href: '/es-es/costiera-amalfitana/positano/',
    tags: ['Icónico', 'Moda', 'Playa Grande'],
  },
  {
    name: 'Amalfi',
    subtitle: "La antigua República Marinera",
    description: 'Il cuore storico della costa con il maestoso Duomo di Sant\'Andrea, le cartiere antiche e la piazza principale.',
    img: '/images/amalfi-hero.webp',
    href: '/es-es/costiera-amalfitana/amalfi/',
    tags: ['Historia', 'Duomo', 'Plaza'],
  },
  {
    name: 'Ravello',
    subtitle: 'La ciudad de la música',
    description: 'Suspendida entre el cielo y el mar, ofrece las vistas más espectaculares desde sus magníficas villas históricas y jardines.',
    img: '/images/ravello-hero.webp',
    href: '/es-es/costiera-amalfitana/ravello/',
    tags: ['Música', 'Villa Cimbrone', 'Panorama'],
  },
  {
    name: 'Maiori',
    subtitle: 'La playa más larga',
    description: 'El paseo marítimo más extenso de la Costa, auténtico y tranquilo, con los restos de una villa romana.',
    img: '/images/maiori-hero.webp',
    href: '/es-es/costiera-amalfitana/maiori/',
    tags: ['Playa', 'Relax', 'Autenticidad'],
  },
  {
    name: 'Minori',
    subtitle: "El alma gastronómica",
    description: 'Famosa por el limoncello y la cocina local auténtica, con los restos de la Villa Romana asomada.',
    img: '/images/minori-hero.webp',
    href: '/es-es/costiera-amalfitana/minori/',
    tags: ['Gastronomía', 'Villa Romana', 'Limones'],
  },
  {
    name: 'Vietri sul Mare',
    subtitle: 'La capital de la cerámica',
    description: 'La porta orientale della Costiera, celebre per le ceramiche dipinte a mano e l\'arte artigianale locale.',
    img: '/images/vietri-hero.webp',
    href: '/es-es/costiera-amalfitana/vietri-sul-mare/',
    tags: ['Cerámica', 'Artesanía', 'Museo'],
  },
];

const topBeaches = [
  { name: 'Playa Grande', location: 'Positano', href: '/es-es/spiagge/costiera-amalfitana/spiaggia-grande-positano/' },
  { name: 'Playa de Ieranto', location: 'Massa Lubrense', href: '/es-es/penisola-sorrentina/spiaggia-di-ieranto/' },
  { name: 'Marina Piccola', location: 'Capri', href: '/es-es/spiagge/isole/marina-piccola-capri/' },
  { name: 'Fiordo de Furore', location: 'Praiano', href: '/es-es/spiagge/costiera-amalfitana/fiordo-di-furore/' },
];

const guidePratiche = [
  {
    section: 'Planificación',
    color: 'med-gold',
    items: [
      { label: 'Cómo llegar', href: '/es-es/como-llegar/' },
      { label: 'Cuándo visitar', href: '/es-es/cuando-visitar/' },
    ]
  },
  {
    section: 'Guías prácticas',
    color: 'med-blue',
    items: [
      { label: 'Ferris y Aliscafos', href: '/es-es/guia/ferris/' },
      { label: 'Bus SITA', href: '/es-es/guia/bus-sita/' },
      { label: 'Aparcamientos y ZTL', href: '/es-es/guia/aparcamientos-ztl/' },
      { label: 'Sorrento vs Praiano', href: '/es-es/blog/sorrento-vs-praiano/' },
    ]
  },
  {
    section: 'Blog & Consejos locales',
    color: 'med-water',
    items: [
      { label: 'Vinos de la Costa de Amalfi', href: '/es-es/blog/vinos-costa-amalfi/' },
      { label: 'Atrani: el pueblo más pequeño', href: '/es-es/blog/atrani/' },
      { label: 'Delizia al limone', href: '/es-es/blog/delizia-al-limone/' },
    ]
  }
];

const reasonsToVisit = [
  {
    title: 'Paisajes Incomparables',
    description: 'Acantilados que caen a pico sobre el mar y vistas que quitan el aliento en cada curva de la Carretera Estatal 163.'
  },
  {
    title: 'Historia Milenaria',
    description: 'Desde antiguas Repúblicas Marineras hasta el esplendor de villas nobles y monasterios medievales.'
  },
  {
    title: 'Sabores Auténticos',
    description: 'Desde pasta fresca hasta limones jugosos, un viaje por el gusto mediterráneo más genuino.'
  },
  {
    title: 'Experiencias Únicas',
    description: 'Senderos entre montañas, excursiones en barca entre cuevas y tradiciones artesanales seculares.'
  }
];

const experiences = [
  {
    title: 'Clase de Cocina',
    href: '/es-es/experiencias/clase-de-cocina-costa-amalfi/',
    img: '/images/cooking-class-hero.webp',
  },
  {
    title: 'Limoncello Tour',
    href: '/es-es/experiencias/limoncello-tour-costa-amalfi/',
    img: '/images/limoncello-mercato-hero.webp',
  },
  {
    title: 'Experiencia Mozzarella',
    href: '/es-es/experiencias/experiencia-mozzarella-agerola-tramonti/',
    img: '/images/mozzarella-provolone-hero.webp',
  },
  {
    title: 'Restaurantes con Estrella',
    href: '/es-es/experiencias/restaurantes-estrella-costa-amalfi/',
    img: '/images/ravello-hero.webp',
  }
];

const blogHighlights = [
  {
    title: 'Gruta de la Esmeralda: Guía de la Joya de Conca dei Marini',
    category: 'De la Redacción',
    href: '/es-es/blog/gruta-esmeralda/',
    img: '/images/grotta-smeraldo-hero.webp',
  },
  {
    title: 'Senderos menos frecuentados: Valle de las Forjas',
    category: 'Senderismo',
    href: '/es-es/blog/senderos-valle-forjas/',
  },
  {
    title: 'Cetara e la colatura: l\'oro degli abissi',
    category: 'Gastronomía',
    href: '/es-es/blog/cetara-coladura/',
  },
  {
    title: 'Vinos de la Costa de Amalfi',
    category: 'Gastronomía',
    href: '/es-es/blog/vinos-costa-amalfi/',
  }
];
---

<BaseLayout
  title="Guía de la Costa de Amalfi 2026 - Positano, Amalfi, Ravello"
  description="Guía turística completa de la Costa de Amalfi. Pueblos, playas, ferries, itinerarios y consejos prácticos actualizados. Patrimonio UNESCO en Campania, Italia."
  lang={lang}
  schema={schema}
>

  <!-- HERO -->
  <section class="relative min-h-[67.5vh] sm:min-h-[67.5vh] sm:min-h-[90vh] flex items-center justify-center bg-charcoal overflow-hidden">
    <img src="/images/hero-hp.webp" alt="Costa de Amalfi vista desde arriba" referrerpolicy="no-referrer" class="absolute inset-0 w-full h-full object-cover object-center" loading="eager" fetchpriority="high" decoding="sync" />
    <div class="absolute inset-0 bg-gradient-to-b from-black/55 via-black/30 to-black/65"></div>

    <div class="relative text-center px-6 max-w-4xl mx-auto">
      <p class="text-med-gold text-xs font-medium uppercase tracking-[0.3em] mb-6">Patrimonio dell'Umanità UNESCO · Campania, Italia</p>
      <h1 class="font-serif text-white leading-tight mb-6" style="font-size: clamp(2.8rem, 7vw, 5.5rem); letter-spacing: -0.02em;">
        La Costiera<br/>
        <em class="not-italic text-med-gold">Amalfitana</em>
      </h1>
      <p class="text-blue-100 text-lg md:text-xl leading-relaxed max-w-2xl mx-auto mb-10 font-light">
        Cincuenta kilómetros de acantilados a pico sobre el Tirreno. Pueblos acurrucados, limones gigantes,
        ferries de colores y una Italia que no deja de sorprender.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/es-es/costiera-amalfitana/positano/"
           class="inline-block bg-med-blue text-white font-semibold px-8 py-3.5 rounded-full hover:scale-105 hover:shadow-[0_8px_30px_rgba(0,91,150,0.5)] transition-all duration-300 text-xs sm:text-sm">
          Comienza por Positano
        </a>
        <a href="/es-es/itinerarios/"
           class="inline-block border-2 border-white/50 text-white font-medium px-8 py-3.5 rounded-full hover:bg-white/10 hover:border-white transition-all duration-300 text-xs sm:text-sm">
          Elige tu itinerario
        </a>
      </div>
    </div>

    <!-- Scroll indicator -->
    <div class="absolute bottom-8 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2 text-white/40">
      <svg class="w-4 h-4 animate-bounce" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
      </svg>
    </div>
  </section>

  <!-- 3 SILOS - TERRITORIES SECTION -->
  <section class="py-16 bg-white">
    <div class="max-w-7xl mx-auto px-6">
      <div class="text-center mb-12">
        <h2 class="font-serif text-4xl md:text-5xl font-bold text-slate-900 mb-4">Tres territorios, infinitas historias</h2>
        <div class="w-20 h-1 bg-med-gold mx-auto rounded-full"></div>
      </div>

      <!-- MOBILE: Swiper slider -->
      <div class="swiper swiper-silos md:hidden">
        <div class="swiper-wrapper pb-12">
          {silos.map(silo => (
            <div class="swiper-slide">
              <a href={silo.href} class="group relative aspect-[4/5] overflow-hidden rounded-[3rem] shadow-[0_20px_50px_rgba(0,0,0,0.3)] block hover:scale-[1.02] transition-transform duration-500">
                <img
                  src={silo.img}
                  alt={silo.title}
                  referrerpolicy="no-referrer"
                  class="w-full h-full object-cover transition-transform duration-1000 group-hover:scale-110"
                  loading="lazy"
                  decoding="async"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/20 to-transparent" />
                <div class="absolute bottom-8 left-8 right-8">
                  <span class="text-med-gold text-xs font-bold uppercase tracking-[0.3em] mb-2 block">{silo.subtitle}</span>
                  <h3 class="font-serif text-3xl font-bold text-white tracking-tight mb-3">{silo.title}</h3>
                  <div class="flex flex-wrap gap-2">
                    {silo.borghi.slice(0, 3).map(b => (
                      <span class="text-[10px] text-white/70 bg-white/10 px-2 py-0.5 rounded-full">{b}</span>
                    ))}
                  </div>
                </div>
              </a>
            </div>
          ))}
        </div>
        <div class="swiper-pagination"></div>
      </div>

      <!-- DESKTOP: Grid -->
      <div class="hidden md:grid grid-cols-1 md:grid-cols-3 gap-6">
        {silos.map(silo => (
          <a href={silo.href} class="group relative aspect-[4/5] overflow-hidden rounded-[3rem] shadow-[0_20px_50px_rgba(0,0,0,0.3)] block hover:scale-[1.02] transition-transform duration-500">
            <img
              src={silo.img}
              alt={silo.title}
              referrerpolicy="no-referrer"
              class="w-full h-full object-cover transition-transform duration-1000 group-hover:scale-110"
              loading="lazy"
              decoding="async"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/20 to-transparent" />
            <div class="absolute bottom-8 left-8 right-8">
              <span class="text-med-gold text-xs font-bold uppercase tracking-[0.3em] mb-2 block">{silo.subtitle}</span>
              <h3 class="font-serif text-3xl font-bold text-white tracking-tight mb-3">{silo.title}</h3>
              <div class="flex flex-wrap gap-2">
                {silo.borghi.slice(0, 3).map(b => (
                  <span class="text-[10px] text-white/70 bg-white/10 px-2 py-0.5 rounded-full">{b}</span>
                ))}
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- CURIOSITÀ - Did You Know -->
  <section class="bg-charcoal py-12">
    <div class="max-w-7xl mx-auto px-6">
      <p class="text-med-gold text-xs uppercase tracking-[0.3em] font-medium text-center mb-8">Curiosidades</p>

      <!-- MOBILE: Swiper slider -->
      <div class="swiper swiper-curiosita md:hidden">
        <div class="swiper-wrapper pb-12">
          <div class="swiper-slide">
            <div class="group bg-white/5 p-8 rounded-[2rem] border border-white/10 hover:bg-white/10 transition-all duration-300 h-full flex flex-col">
              <div class="w-14 h-14 rounded-2xl bg-med-gold/10 text-med-gold flex items-center justify-center mb-6 group-hover:scale-110 transition-transform flex-shrink-0">
                <svg class="w-7 h-7" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 6.75V15m6-6v8.25m.503-10.498 4.875 2.812M6.497 9.252 1.622 12.064m19.88 0-4.875 2.812M1.622 12.064l4.875 2.812m0 0 4.498 2.598a.75.75 0 0 0 .75 0l4.498-2.598m-9.746 0V17.25"/></svg>
              </div>
              <div class="font-serif text-5xl font-bold text-white mb-3 tracking-tight">50 km</div>
              <p class="text-white/70 font-medium mb-2">kilómetros de costa</p>
              <p class="text-white/50 text-xs sm:text-sm leading-relaxed font-light">De Positano a Vietri sul Mare, declarados Patrimonio UNESCO en 1997.</p>
            </div>
          </div>
          <div class="swiper-slide">
            <div class="group bg-white/5 p-8 rounded-[2rem] border border-white/10 hover:bg-white/10 transition-all duration-300 h-full flex flex-col">
              <div class="w-14 h-14 rounded-2xl bg-med-gold/10 text-med-gold flex items-center justify-center mb-6 group-hover:scale-110 transition-transform flex-shrink-0">
                <svg class="w-7 h-7" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 21a9.004 9.004 0 0 0 8.716-6.747M12 21a9.004 9.004 0 0 1-8.716-6.747M12 21c2.485 0 4.5-4.03 4.5-9S14.485 3 12 3m0 18c-2.485 0-4.5-4.03-4.5-9S9.515 3 12 3m0 0a8.997 8.997 0 0 1 7.843 4.582M12 3a8.997 8.997 0 0 0-7.843 4.582m15.686 0A11.953 11.953 0 0 1 12 10.5c-2.998 0-5.74-1.1-7.843-2.918m15.686 0A8.959 8.959 0 0 1 21 12c0 .778-.099 1.533-.284 2.253"/></svg>
              </div>
              <div class="font-serif text-5xl font-bold text-white mb-3 tracking-tight">IX sec.</div>
              <p class="text-white/70 font-medium mb-2">nascita di Amalfi</p>
              <p class="text-white/50 text-xs sm:text-sm leading-relaxed font-light">Prima potenza marinara d'Europa, con rotte commerciali fino a Costantinopoli.</p>
            </div>
          </div>
          <div class="swiper-slide">
            <div class="group bg-white/5 p-8 rounded-[2rem] border border-white/10 hover:bg-white/10 transition-all duration-300 h-full flex flex-col">
              <div class="w-14 h-14 rounded-2xl bg-med-gold/10 text-med-gold flex items-center justify-center mb-6 group-hover:scale-110 transition-transform flex-shrink-0">
                <svg class="w-7 h-7" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z"/><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1 1 15 0Z"/></svg>
              </div>
              <div class="font-serif text-5xl font-bold text-white mb-3 tracking-tight">350 m</div>
              <p class="text-white/70 font-medium mb-2">la altitud de Ravello</p>
              <p class="text-white/50 text-xs sm:text-sm leading-relaxed font-light">Wagner escribió aquí el Parsifal. Gore Vidal vivió en Ravello durante treinta años.</p>
            </div>
          </div>
        </div>
        <div class="swiper-pagination"></div>
      </div>

      <!-- DESKTOP: Griglia curiosità -->
      <div class="hidden md:grid grid-cols-1 grid-cols-1 md:grid-cols-3 gap-8">
        <div class="group bg-white/5 p-8 rounded-[2rem] border border-white/10 hover:bg-white/10 transition-all duration-300">
          <div class="w-14 h-14 rounded-2xl bg-med-gold/10 text-med-gold flex items-center justify-center mb-6 group-hover:scale-110 transition-transform">
            <svg class="w-7 h-7" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 6.75V15m6-6v8.25m.503-10.498 4.875 2.812M6.497 9.252 1.622 12.064m19.88 0-4.875 2.812M1.622 12.064l4.875 2.812m0 0 4.498 2.598a.75.75 0 0 0 .75 0l4.498-2.598m-9.746 0V17.25"/></svg>
          </div>
          <div class="font-serif text-5xl font-bold text-white mb-3 tracking-tight">50 km</div>
          <p class="text-white/70 font-medium mb-2">chilometri di costa</p>
          <p class="text-white/50 text-xs sm:text-sm leading-relaxed font-light">Da Positano a Vietri sul Mare, dichiarati Patrimonio UNESCO nel 1997.</p>
        </div>
        <div class="group bg-white/5 p-8 rounded-[2rem] border border-white/10 hover:bg-white/10 transition-all duration-300">
          <div class="w-14 h-14 rounded-2xl bg-med-gold/10 text-med-gold flex items-center justify-center mb-6 group-hover:scale-110 transition-transform">
            <svg class="w-7 h-7" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 21a9.004 9.004 0 0 0 8.716-6.747M12 21a9.004 9.004 0 0 1-8.716-6.747M12 21c2.485 0 4.5-4.03 4.5-9S14.485 3 12 3m0 18c-2.485 0-4.5-4.03-4.5-9S9.515 3 12 3m0 0a8.997 8.997 0 0 1 7.843 4.582M12 3a8.997 8.997 0 0 0-7.843 4.582m15.686 0A11.953 11.953 0 0 1 12 10.5c-2.998 0-5.74-1.1-7.843-2.918m15.686 0A8.959 8.959 0 0 1 21 12c0 .778-.099 1.533-.284 2.253"/></svg>
          </div>
          <div class="font-serif text-5xl font-bold text-white mb-3 tracking-tight">IX sec.</div>
          <p class="text-white/70 font-medium mb-2">nascita di Amalfi</p>
          <p class="text-white/50 text-xs sm:text-sm leading-relaxed font-light">Prima potenza marinara d'Europa, con rotte commerciali fino a Costantinopoli.</p>
        </div>
        <div class="group bg-white/5 p-8 rounded-[2rem] border border-white/10 hover:bg-white/10 transition-all duration-300">
          <div class="w-14 h-14 rounded-2xl bg-med-gold/10 text-med-gold flex items-center justify-center mb-6 group-hover:scale-110 transition-transform">
            <svg class="w-7 h-7" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z"/><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1 1 15 0Z"/></svg>
          </div>
          <div class="font-serif text-5xl font-bold text-white mb-3 tracking-tight">350 m</div>
          <p class="text-white/70 font-medium mb-2">l'altitudine di Ravello</p>
          <p class="text-white/50 text-xs sm:text-sm leading-relaxed font-light">Wagner scrisse qui il Parsifal. Gore Vidal visse a Ravello per trent'anni.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- PERCHÉ VISITARE -->
  <section class="py-16 bg-white">
    <div class="max-w-7xl mx-auto px-6">
      <div class="text-center mb-12">
        <h2 class="font-serif text-4xl md:text-5xl font-bold text-slate-900 mb-6">Perché Visitare la Costiera</h2>
        <div class="w-20 h-1 bg-med-gold mx-auto rounded-full"></div>
      </div>
      <div class="grid grid-cols-2 md:grid-cols-2 lg:grid-cols-4 gap-8">
        {reasonsToVisit.map((reason, i) => (
          <div class="text-center border-2 border-med-gold rounded-2xl p-8" style={`animation: fadeIn 0.8s ease-in-out ${i * 0.1}s both`}>
            <h3 class="text-xl font-serif font-bold text-slate-900 mb-4">{reason.title}</h3>
            <p class="text-slate-600 text-sm leading-relaxed">{reason.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- BORGHI INCANTATI -->
  <section id="borghi" class="py-16 bg-med-cream">
    <div class="max-w-7xl mx-auto px-6">
      <div class="flex flex-col md:flex-row justify-between items-end mb-12 gap-6">
        <div class="max-w-2xl">
          <p class="text-med-gold text-xs font-bold uppercase tracking-[0.3em] mb-3">Esplora la Costiera</p>
          <h2 class="font-serif text-4xl md:text-5xl font-bold text-slate-900 tracking-tight mb-4">I Borghi Incantati</h2>
