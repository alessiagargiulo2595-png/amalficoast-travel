---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getTranslations, getLocalePath } from '../../i18n/translations';

const lang = 'es-es';
const breadcrumbs = [
  { name: 'Home', url: '/es-es/' },
  { name: 'Planificación', url: '/es-es/planificacion/' },
  { name: 'Itinerarios', url: '/es-es/itinerarios/' },
];
const t = getTranslations(lang);

// Card data organized by duration
const itineraries = {
  d1: [
    { title: 'Costa Amalfitana desde Nápoles', desc: 'En ferry desde Nápoles: Amalfi, Ravello y Positano con atardecer en el mar.', img: '/images/costiera-hero.jpg', href: '/es-es/itinerarios/1-dia/costa-amalfitana-desde-napoles/', tag: '1 día' },
    { title: 'Costa Amalfitana desde Salerno', desc: 'Partida desde Salerno: menos multitudes, más paz. Perfecto en verano con regreso por la tarde.', img: '/images/costiera-hero.jpg', href: '/es-es/itinerarios/1-dia/costa-amalfitana-desde-salerno/', tag: '1 día' },
    { title: 'Península de Sorrentina', desc: 'Sorrento, Massa Lubrense y Marina del Cantone en un día desde Nápoles.', img: '/images/sorrento-hero.jpg', href: '/es-es/', tag: '1 día' },
    { title: 'Senderismo Camino de los Dioses', desc: '7,8 km de vistas espectaculares de Bomerano a Nocelle sobre Positano.', img: '/images/trekking-hero.jpg', href: '/es-es/itinerarios/1-dia/sendero-de-los-dioses-trek/', tag: '1 día' },
    { title: 'Capri desde Sorrento', desc: 'Gruta Azul, Farallones, Villa Jovis: Capri esencial en un día.', img: '/images/capri-hero.jpg', href: '/es-es/itinerarios/1-dia/capri-desde-sorrento/', tag: '1 día' },
  ],
  d3: [
    { title: 'Costa Amalfitana Clásica', desc: 'Amalfi, Positano, Ravello y Cetara: lo mejor de la costa en 3 días.', img: '/images/costiera-hero.jpg', href: '/es-es/itinerarios/3-dias/costa-amalfitana-clasica/', tag: '3 días' },
    { title: 'Islas: Ischia y Procida', desc: 'Dos islas del Golfo de Nápoles con playas, aguas termales y colores pastel.', img: '/images/ischia-hero.jpg', href: '/es-es/itinerarios/3-dias/islas-ischia-procida/', tag: '3 días' },
    { title: 'Sorrento, Pompeya e Historia', desc: 'Arte, historia y mar: Sorrento, Pompeya y la Península en 3 días.', img: '/images/sorrento-hero.jpg', href: '/es-es/itinerarios/3-dias/sorrento-pompeya-historia/', tag: '3 días' },
  ],
  d7: [
    { title: 'Gran Tour Costa y Península', desc: 'Una semana completa: costa, península, islas y pueblos ocultos.', img: '/images/costiera-hero.jpg', href: '/es-es/itinerarios/7-dias/gran-tour-costa-peninsula/', tag: '7 días' },
    { title: 'Slow Travel: Pueblos y Gastronomía', desc: 'Sin prisa. Mercados, trattorias, senderos y atardeceres en slow travel.', img: '/images/atrani-hero.jpg', href: '/es-es/itinerarios/7-dias/slow-travel-pueblos-gastronomia/', tag: '7 días' },
  ],
};
---

<BaseLayout
  title={t.meta.itineraries_title}
  description={t.meta.itineraries_description}
  lang={lang}
  pageKey="itineraries"

  heroImage="/images/itinerari-hero.jpg"
>
  <!-- Hero -->
  <section class="relative h-[45vh] sm:h-[60vh] flex items-center bg-charcoal overflow-hidden">
    <img src="/images/itinerari-hero.jpg" alt="Costa Amalfitana itinerarios" class="absolute inset-0 w-full h-full object-cover" loading="eager" fetchpriority="high" decoding="sync" referrerpolicy="no-referrer"/>
    <div class="absolute inset-0 bg-gradient-to-b from-black/25 via-black/40 to-black/75"></div>
    <div class="relative z-10 max-w-7xl mx-auto px-6 py-16">
      <nav class="flex items-center gap-2 text-white/60 text-xs mb-6">
        <a href="/es-es/" class="hover:text-white transition-colors">Home</a>
        <span>/</span>
        <a href="/es-es/planificacion/" class="hover:text-white transition-colors">Planificación</a>
        <span>/</span>
        <span class="text-white">Itinerarios</span>
      </nav>
      <div class="max-w-3xl">
        <p class="text-med-gold text-xs sm:text-sm font-medium uppercase tracking-[0.3em] mb-3">Planifica tu viaje</p>
        <h1 class="font-serif text-display text-white mb-4">Itinerarios Costa Amalfitana</h1>
        <p class="text-xl text-white/80 leading-relaxed">1 día, 3 días o 1 semana: itinerarios detallados para aprovechar al máximo la Costa Amalfitana según el tiempo que tengas.</p>
      </div>
    </div>
  </section>

  <!-- Intro -->
  <section class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <p class="text-lg text-slate-600 leading-relaxed">
      La Costa Amalfitana ofrece experiencias diferentes según el tiempo del que dispongas. Un día para lo imprescindible, tres días para descubrir pueblos y ritmos locales, una semana para ir más allá de la postal. Elige el itinerario que te convenga.
    </p>
  </section>

  <!-- 1 Día -->
  <section class="py-12 border-t border-slate-100">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center gap-4 mb-10">
        <span class="inline-block bg-med-blue/80 text-white text-xs font-bold uppercase tracking-wider px-3 py-1.5 rounded-full">1 día</span>
        <h2 class="text-3xl font-bold font-serif text-charcoal">Lo mejor de la costa</h2>
        <div class="flex-1 h-px bg-slate-100"></div>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {itineraries.d1.map((it) => (
          <a href={it.href} class="group block bg-white rounded-2xl border border-slate-100 overflow-hidden hover:shadow-lg hover:border-med-blue/20 transition-all duration-300">
            <!-- Image with overlay -->
            <div class="relative h-44 overflow-hidden">
              <img src={it.img} alt={it.title} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
              <div class="absolute inset-0 bg-gradient-to-t from-black/50 to-transparent" />
              <!-- Duration badge -->
              <span class="absolute bottom-3 left-3 text-[10px] font-bold uppercase tracking-wider text-white bg-med-blue/80 backdrop-blur-sm px-2.5 py-1 rounded-full">
                {it.tag}
              </span>
            </div>
            <!-- Text section -->
            <div class="p-5">
              <h3 class="font-semibold text-charcoal text-sm mb-1.5 group-hover:text-med-blue transition-colors">{it.title}</h3>
              <p class="text-xs text-slate-500 leading-relaxed">{it.desc}</p>
              <span class="mt-3 inline-flex items-center text-xs font-semibold text-med-blue gap-1 group-hover:gap-2 transition-all">
                Descubre el itinerario →
              </span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- 3 Días -->
  <section class="py-12 border-t border-slate-100">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center gap-4 mb-10">
        <span class="inline-block bg-med-gold/90 text-white text-xs font-bold uppercase tracking-wider px-3 py-1.5 rounded-full">3 días</span>
        <h2 class="text-3xl font-bold font-serif text-charcoal">Ritmo perfecto entre descubrimientos</h2>
        <div class="flex-1 h-px bg-slate-100"></div>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {itineraries.d3.map((it) => (
          <a href={it.href} class="group block bg-white rounded-2xl border border-slate-100 overflow-hidden hover:shadow-lg hover:border-med-gold/20 transition-all duration-300">
            <!-- Image with overlay -->
            <div class="relative h-44 overflow-hidden">
              <img src={it.img} alt={it.title} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
              <div class="absolute inset-0 bg-gradient-to-t from-black/50 to-transparent" />
              <!-- Duration badge -->
              <span class="absolute bottom-3 left-3 text-[10px] font-bold uppercase tracking-wider text-white bg-med-gold/90 backdrop-blur-sm px-2.5 py-1 rounded-full">
                {it.tag}
              </span>
            </div>
            <!-- Text section -->
            <div class="p-5">
              <h3 class="font-semibold text-charcoal text-sm mb-1.5 group-hover:text-med-gold transition-colors">{it.title}</h3>
              <p class="text-xs text-slate-500 leading-relaxed">{it.desc}</p>
              <span class="mt-3 inline-flex items-center text-xs font-semibold text-med-gold gap-1 group-hover:gap-2 transition-all">
                Descubre el itinerario →
              </span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- 7 Días -->
  <section class="py-12 border-t border-slate-100">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center gap-4 mb-10">
        <span class="inline-block bg-med-terracotta/80 text-white text-xs font-bold uppercase tracking-wider px-3 py-1.5 rounded-full">7 días</span>
        <h2 class="text-3xl font-bold font-serif text-charcoal">Slow travel sin prisa</h2>
        <div class="flex-1 h-px bg-slate-100"></div>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 max-w-2xl">
        {itineraries.d7.map((it) => (
          <a href={it.href} class="group block bg-white rounded-2xl border border-slate-100 overflow-hidden hover:shadow-lg hover:border-med-terracotta/20 transition-all duration-300">
            <!-- Image with overlay -->
            <div class="relative h-44 overflow-hidden">
              <img src={it.img} alt={it.title} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
              <div class="absolute inset-0 bg-gradient-to-t from-black/50 to-transparent" />
              <!-- Duration badge -->
              <span class="absolute bottom-3 left-3 text-[10px] font-bold uppercase tracking-wider text-white bg-med-terracotta/80 backdrop-blur-sm px-2.5 py-1 rounded-full">
                {it.tag}
              </span>
            </div>
            <!-- Text section -->
            <div class="p-5">
              <h3 class="font-semibold text-charcoal text-sm mb-1.5 group-hover:text-med-terracotta transition-colors">{it.title}</h3>
              <p class="text-xs text-slate-500 leading-relaxed">{it.desc}</p>
              <span class="mt-3 inline-flex items-center text-xs font-semibold text-med-terracotta gap-1 group-hover:gap-2 transition-all">
                Descubre el itinerario →
              </span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- BANNER: Planificador de Itinerario -->
  <section class="py-10 md:py-14">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="relative overflow-hidden rounded-[2.5rem] bg-gradient-to-br from-slate-900 via-slate-950 to-blue-950 px-6 sm:px-10 md:px-14 py-10 md:py-14 shadow-[0_20px_60px_rgba(0,0,0,0.35)]">
        <div class="absolute -top-20 -left-20 w-72 h-72 bg-blue-500/15 rounded-full blur-3xl pointer-events-none"></div>
        <div class="absolute -bottom-20 -right-20 w-72 h-72 bg-amber-500/10 rounded-full blur-3xl pointer-events-none"></div>
        <div class="relative z-10 grid md:grid-cols-[3fr_2fr] md:items-center gap-8">
          <div>
            <span class="inline-block px-4 py-1.5 rounded-full text-xs font-semibold tracking-wide uppercase bg-med-gold/15 text-med-gold border border-med-gold/25 mb-6">Nuevo: Planificador de Viaje</span>
            <h2 class="text-3xl md:text-4xl font-bold text-white leading-tight mb-2">Diseña tu</h2>
            <p class="font-serif text-3xl md:text-4xl italic text-med-blue mb-5">itinerario perfecto</p>
            <p class="text-white/60 text-base md:text-lg leading-relaxed max-w-xl mb-8">Responde unas sencillas preguntas - punto de partida, días e intereses - y obtén un itinerario personalizado con transporte, costes y horarios.</p>
            <div class="flex flex-wrap gap-6">
              <div class="flex items-center gap-2.5">
                <div class="w-9 h-9 rounded-xl bg-white/5 border border-white/10 flex items-center justify-center">
                  <svg class="w-4.5 h-4.5 text-med-gold" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                </div>
                <span class="text-white/50 text-sm">30 segundos para configurar</span>
              </div>
              <div class="flex items-center gap-2.5">
                <div class="w-9 h-9 rounded-xl bg-white/5 border border-white/10 flex items-center justify-center">
                  <svg class="w-4.5 h-4.5 text-med-gold" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 6.75V15m6-6v8.25m.503 3.498l4.875-2.437c.381-.19.622-.58.622-1.006V4.82c0-.836-.88-1.38-1.628-1.006l-3.869 1.934c-.317.159-.69.159-1.006 0L9.503 3.252a1.125 1.125 0 00-1.006 0L3.622 5.689C3.24 5.88 3 6.27 3 6.695V19.18c0 .836.88 1.38 1.628 1.006l3.869-1.934c.317-.159.69-.159 1.006 0l4.994 2.497c.317.158.69.158 1.006 0z"/></svg>
                </div>
                <span class="text-white/50 text-sm">Consejos anti-multitud incluidos</span>
              </div>
            </div>
          </div>
          <div class="mt-8 md:mt-0 md:flex md:justify-center">
            <a href="/es-es/planificador-itinerario/" class="inline-flex items-center gap-2.5 px-7 py-3.5 bg-gradient-to-r from-med-gold to-yellow-600 text-slate-900 font-bold rounded-xl hover:shadow-[0_0_30px_rgba(212,175,55,0.4)] hover:scale-105 transition-all duration-300">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 2L2 12l4 0 0 6 4 0 0-4 4 0 0 4 4 0 0-6 4 0L12 2z"/></svg>
              Planifica Ahora
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="bg-med-blue py-16 text-center">
    <div class="max-w-2xl mx-auto px-4">
      <h2 class="text-2xl font-bold text-white mb-4">¿Cómo llego a la costa?</h2>
      <p class="text-white mb-6">Todas las opciones: tren, ferry, autobús y traslados privados.</p>
      <a href={getLocalePath(lang, 'getting-here')}
        class="inline-block bg-med-blue text-white font-semibold px-8 py-3 rounded-full hover:bg-med-blue transition-colors">
        Guía de transporte
      </a>
    </div>
  </section>
</BaseLayout>
