---
import BaseLayout from '../../../layouts/BaseLayout.astro';

const lang = 'es-es';

const breadcrumbs = [
  { name: 'Home', url: '/es-es/' },
  { name: 'Islas del Golfo', url: '/es-es/islas/' },
];

const isole = [
  {
    name: 'Capri',
    href: '/es-es/islas/capri/',
    desc: 'La Gruta Azul, los Faraglioni y la mundana Piazzetta: la isla más icónica del Golfo de Nápoles.',
    tag: 'La más icónica',
  },
  {
    name: 'Anacapri',
    href: '/es-es/islas/anacapri/',
    desc: 'El pueblo alto de Capri: Villa San Michele, el telesilla al Monte Solaro (589 m) y la Escalera Fenicia.',
    tag: 'Naturaleza & panoramas',
  },
  {
    name: 'Ischia',
    href: '/es-es/islas/ischia/',
    desc: 'La isla verde del Golfo: termas naturales, el Castillo Aragonés, playas volcánicas y el Monte Epomeo.',
    tag: 'Termas & naturaleza',
  },
  {
    name: 'Forio',
    href: '/es-es/islas/forio/',
    desc: 'Los Jardines Poseidón, la Iglesia del Soccorso al atardecer y las termas naturales de la Bahía de Sorgeto.',
    tag: 'Atardeceres & termas',
  },
  {
    name: 'Procida',
    href: '/es-es/islas/procida/',
    desc: 'La más pequeña y auténtica: casas de colores en Marina Corricella, Capital Italiana de la Cultura 2022.',
    tag: 'La más auténtica',
  },
];

const destinationSchema = {
  "@context": "https://schema.org",
  "@type": "TouristDestination",
  "name": "Islas del Golfo de Nápoles",
  "description": "Capri, Anacapri, Ischia, Forio y Procida: las islas del Golfo de Nápoles, accesibles en ferry desde Nápoles, Pozzuoli y Sorrento.",
  "url": "https://amalficoast-travel.com/es-es/islas/",
  "touristType": ["Mar", "Cultura", "Termas", "Naturaleza"],
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": 40.5500,
    "longitude": 14.1000
  }
};
---

<BaseLayout
  title="Islas del Golfo de Nápoles 2026: Capri, Anacapri, Ischia, Forio y Procida"
  description="Guía a las islas del Golfo de Nápoles: Capri, Anacapri, Ischia, Forio y Procida. Cómo llegar, qué ver, cuándo ir. Todo para planificar tu excursión en ferry desde Nápoles."
  lang={lang}
  breadcrumbs={breadcrumbs}
  schema={[destinationSchema]}
  pageKey="islands"

  heroImage="/images/isole-hero.jpg"
>

  <!-- Hero -->
  <section class="relative h-[75vh] sm:h-[90vh] flex items-center bg-charcoal overflow-hidden">
    <img src="/images/isole-hero.jpg" alt="Islas del Golfo de Nápoles" class="absolute inset-0 w-full h-full object-cover" loading="eager" fetchpriority="high" decoding="sync" referrerpolicy="no-referrer"/>

    <div class="absolute inset-0 bg-gradient-to-b from-black/25 via-black/40 to-black/75"></div>
    <div class="relative z-10 max-w-7xl mx-auto px-6 py-24">
      <nav class="flex items-center gap-2 text-white/60 text-xs mb-6">
        <a href="/es-es/" class="hover:text-white transition-colors">Home</a>
        <span>/</span>
        <span class="text-white">Islas del Golfo</span>
      </nav>
      <div class="max-w-3xl">
        <p class="text-med-gold text-xs sm:text-sm font-medium uppercase tracking-[0.3em] mb-3">Golfo de Nápoles</p>
        <h1 class="font-serif text-display text-white mb-4">Las Islas del Golfo</h1>
        <p class="text-xl text-white/80 leading-relaxed">
          Tres islas distintas: Capri (glamour, Gruta Azul), Ischia (termas volcánicas, Castillo), Procida (auténtica, sin multitudes). Todas en ferry &lt;1 hora desde Nápoles.
        </p>
      </div>
    </div>
  </section>

  <div class="max-w-editorial mx-auto px-4 sm:px-6 lg:px-8 py-16 space-y-20">

    <!-- Intro -->
    <section class="text-justify">
      <p class="text-xl leading-relaxed text-charcoal">
        El Golfo de Nápoles es uno de los más bellos del Mediterráneo, y sus islas son su corona. Cada una tiene una identidad fuerte e inconfundible: difícil visitarlas todas en un solo viaje, pero imposible elegir solo una.
      </p>
      <p class="mt-4 text-slate-600 leading-relaxed">
        Capri, Ischia y Procida se alcanzan todas desde Nápoles Molo Beverello o Pozzuoli con ferries y aliscafos frecuentes. En verano las conexiones se multiplican. Desde Sorrento se llega a Capri en 20-25 minutos en aliscafo.
      </p>
    </section>

    <!-- Isole Grid -->
    <section>
      <div class="flex items-end justify-between mb-8">
        <h2 class="font-serif text-3xl font-semibold">Las islas del Golfo</h2>
        <p class="text-xs sm:text-sm text-slate-400 hidden sm:block">Golfo de Nápoles, Campania</p>
      </div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {isole.map((b, i) => {
          const stripeColors = ['#D4AF37', '#E2725B', '#005B96', '#40E0D0'];
          const stripeColor = stripeColors[i % stripeColors.length];
          return (
            <a href={b.href} class="group relative overflow-hidden bg-white border border-slate-100 rounded-[2rem] p-6 pl-7 shadow-sm hover:border-med-blue/30 hover:shadow-xl transition-all duration-300">
              <span class="absolute left-0 top-0 bottom-0 w-1.5" style={`background-color: ${stripeColor}`}></span>
              <div class="flex items-start justify-between mb-3">
                <h3 class="font-serif text-xl font-semibold text-slate-900 group-hover:text-med-blue transition-colors">{b.name}</h3>
                <span class="text-[10px] uppercase tracking-wide px-2 py-1 rounded-full font-semibold flex-shrink-0 ml-2 text-white" style={`background-color: ${stripeColor}`}>{b.tag}</span>
              </div>
              <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">{b.desc}</p>
              <p class="text-med-blue text-xs sm:text-sm font-medium mt-4 group-hover:translate-x-1 transition-transform inline-flex items-center gap-1">
                Descubrir {b.name}
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 18l6-6-6-6"/></svg>
              </p>
            </a>
          );
        })}
      </div>
    </section>

    <!-- Stats -->
    <section class="bg-charcoal text-white rounded-[2rem] p-10">
      <p class="text-[10px] uppercase tracking-[0.3em] text-med-gold font-medium mb-8">Las islas en cifras</p>
      <div class="grid sm:grid-cols-4 gap-8 text-center">
        <div>
          <p class="font-serif text-5xl font-bold text-med-gold">3</p>
          <p class="text-white/60 text-xs sm:text-sm mt-2">islas en el Golfo de Nápoles</p>
        </div>
        <div>
          <p class="font-serif text-5xl font-bold text-med-gold">25 min</p>
          <p class="text-white/60 text-xs sm:text-sm mt-2">Sorrento → Capri en aliscafo</p>
        </div>
        <div>
          <p class="font-serif text-5xl font-bold text-med-gold">789 m</p>
          <p class="text-white/60 text-xs sm:text-sm mt-2">Monte Epomeo, Ischia</p>
        </div>
        <div>
          <p class="font-serif text-5xl font-bold text-med-gold">2022</p>
          <p class="text-white/60 text-xs sm:text-sm mt-2">Procida Capital de la Cultura</p>
        </div>
      </div>
    </section>

    <!-- Come arrivare riepilogo -->
    <section>
      <h2 class="font-serif text-3xl font-semibold text-slate-900 mb-8">Cómo llegar a las islas</h2>
      <div class="overflow-x-auto rounded-2xl border border-slate-200">
        <table class="w-full text-xs sm:text-xs sm:text-sm">
          <thead>
            <tr class="bg-slate-900 text-white">
              <th class="text-left px-4 py-3 font-semibold">Isla</th>
              <th class="text-left px-4 py-3 font-semibold">Desde Nápoles (Beverello)</th>
              <th class="text-left px-4 py-3 font-semibold">Desde Sorrento</th>
              <th class="text-left px-4 py-3 font-semibold">Desde Pozzuoli</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100">
            <tr class="hover:bg-slate-50 transition-colors">
              <td class="px-4 py-3 font-semibold text-charcoal">Capri</td>
              <td class="px-4 py-3">~50 min (ferry) / ~40 min (aliscafo)</td>
              <td class="px-4 py-3">~20-25 min (aliscafo)</td>
              <td class="px-4 py-3 text-slate-400">-</td>
            </tr>
            <tr class="hover:bg-slate-50 transition-colors">
              <td class="px-4 py-3 font-semibold text-charcoal">Ischia</td>
              <td class="px-4 py-3">~75 min (ferry) / ~50 min (aliscafo)</td>
              <td class="px-4 py-3 text-slate-400">-</td>
              <td class="px-4 py-3">~35 min (ferry)</td>
            </tr>
            <tr class="hover:bg-slate-50 transition-colors">
              <td class="px-4 py-3 font-semibold text-charcoal">Procida</td>
              <td class="px-4 py-3">~35 min (aliscafo)</td>
              <td class="px-4 py-3 text-slate-400">-</td>
              <td class="px-4 py-3">~15 min (ferry)</td>
            </tr>
          </tbody>
        </table>
      </div>
      <p class="text-xs text-slate-400 mt-2">* Tiempos orientativos. Consulta caremar.it, snav.it, medmar.it para horarios actualizados.</p>
    </section>

  </div>

</BaseLayout>
