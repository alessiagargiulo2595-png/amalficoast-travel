---
import BlogPostLayout from '../../../../layouts/BlogPostLayout.astro';

const lang = 'es-es';
const post = {
  title: 'Positano o Amalfi',
  subtitle: 'Dónde alojarse en la Costa Amalfitana: guía 2026',
  category: 'GUÍAS',
  date: '29 de mayo de 2026',
  readTime: '11 min',
  image: '/images/positano-vs-amalfi-hero.webp',
  imageAlt: 'Positano y Amalfi: comparación entre los dos iconos de la Costa',
  path: '/es-es/blog/positano-vs-amalfi/',
};

const metaTitle = 'Positano o Amalfi 2026: ¿Cuál Elegir para tu Viaje? | Comparación Local';
const metaDescription = 'Positano o Amalfi: guía 2026 con casos de uso (luna de miel, familia, primera vez). Hoteles, precios, transporte, playas. Elige el pueblo correcto de la Costa en 5 minutos.';

const breadcrumbs = [
  { name: 'Inicio', url: '/es-es/' },
  { name: 'Blog', url: '/es-es/blog/' },
  { name: 'Positano o Amalfi', url: '/es-es/blog/positano-vs-amalfi/' },
];

const quickInfo = [
  { label: 'Distancia', value: '17 km por la SS163' },
  { label: 'Tiempo de viaje', value: '~40 min bus SITA o 25 min ferry' },
  { label: 'Positano', value: '~4.000 habitantes · postal vertical' },
  { label: 'Amalfi', value: '~5.000 habitantes · ciudad marítima medieval' },
  { label: 'Rango hotel', value: 'Positano €250-1.500 · Amalfi €150-700' },
  { label: 'Para luna de miel', value: 'Positano' },
  { label: 'Para familias', value: 'Amalfi' },
];

const faq = [
  {
    q: '¿Positano o Amalfi para luna de miel?',
    a: "Positano. El drama visual (casas color pastel cayendo en cascada hacia una playa turquesa) es insuperable. Los recién casados quieren la imagen icónica, y esa imagen es Positano. Amalfi es históricamente más rica (fue una república marítima) pero visualmente más mediterránea convencional. Si tus fotos de luna de miel importan, Positano gana.",
  },
  {
    q: '¿Positano o Amalfi para familias con niños?',
    a: "Amalfi, claramente. Amalfi tiene una plaza principal plana (Piazza Duomo), aceras peatonales anchas, una larga playa pública, supermercados y farmacias al mismo nivel que tu hotel. Positano son 600+ escalones e imposible con carritos. Familias con adolescentes 14+ pueden con Positano; con niños más pequeños, elige Amalfi.",
  },
  {
    q: '¿Positano o Amalfi: cuál es más barata?',
    a: "Amalfi es 30-40% más barata en general. Un hotel 3★ en Amalfi cuesta €150-220; la misma categoría en Positano €280-450. Pasta de restaurante: €14 en Amalfi vs €20 en Positano. Hamaca: €20-30 vs €35-60. Café espresso: €1,50 vs €2,50.",
  },
  {
    q: '¿Positano o Amalfi: cuántas noches?',
    a: "Positano funciona como parada romántica de 2-3 noches o base slow luxury de 4+ noches. Amalfi funciona como base 3-5 noches para explorar el resto de la Costa: es el centro geográfico y logístico, con las mejores conexiones de ferry/bus a Ravello, Minori, Maiori, Capri y Salerno. 1 noche en cualquiera es demasiado poco por la logística.",
  },
  {
    q: '¿Puedo hacer excursión Positano-Amalfi (o viceversa)?',
    a: "Sí, fácil. Bus SITA Amalfi → Positano cada 30-60 min (€2,40, ~40 min). Ferry estacional (abril-octubre) más rápido y panorámico: 25 min, €11. En ambas direcciones, llega antes de las 11 y sal antes de las 17 para evitar el pico de afluencia.",
  },
  {
    q: '¿Positano o Amalfi para excursión a Ravello?',
    a: "Amalfi, mucho más fácil. Ravello está en el acantilado directamente sobre Amalfi: bus SITA cada 30 min, 25 min de viaje, €2,40. Desde Positano la misma excursión exige pasar primero por Amalfi: 1h15 cada trayecto. ¿Festival musical en Ravello? Te quedas en Amalfi.",
  },
  {
    q: '¿Positano o Amalfi para el Sendero de los Dioses (Sentiero degli Dei)?',
    a: "Positano, por poco. El clásico Sendero de los Dioses termina en Nocelle (sobre Positano) y baja al pueblo: logística fácil. Desde Amalfi necesitas tomar primero un bus a Bomerano (1h+ vía Agerola). Si haces el sendero una sola vez, Positano es la mejor base para el final descendente.",
  },
];

const sidebarLinks = [
  { label: 'Guía Amalfi', href: '/es-es/costa-amalfitana/amalfi/' },
  { label: 'Guía Positano', href: '/es-es/costa-amalfitana/positano/' },
  { label: 'Guía Ravello', href: '/es-es/costa-amalfitana/ravello/' },
  { label: 'Bus SITA: horarios', href: '/es-es/guia/bus-sita/' },
  { label: 'Ferries: rutas', href: '/es-es/guia/ferries/' },
  { label: 'Sorrento o Positano', href: '/es-es/blog/sorrento-vs-positano/' },
];

const authorRole = 'Experto logística de viajes · Costa Amalfitana';

const relatedArticles = [
  {
    title: 'Sorrento o Positano',
    category: 'GUÍAS',
    date: '29 de mayo de 2026',
    image: '/images/sorrento-vs-positano-hero.webp',
    imageAlt: 'Sorrento y Positano: comparación',
    path: '/es-es/blog/sorrento-vs-positano/',
  },
  {
    title: 'Praiano o Positano',
    category: 'GUÍAS',
    date: '1 de junio de 2026',
    image: '/images/praiano-vs-positano-hero.webp',
    imageAlt: 'Praiano y Positano comparados',
    path: '/es-es/blog/praiano-vs-positano/',
  },
];

const compareSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: 'Positano o Amalfi: dónde alojarse en la Costa Amalfitana',
  about: [
    { '@type': 'Place', name: 'Positano', address: { '@type': 'PostalAddress', addressLocality: 'Positano', addressRegion: 'SA', addressCountry: 'IT' } },
    { '@type': 'Place', name: 'Amalfi', address: { '@type': 'PostalAddress', addressLocality: 'Amalfi', addressRegion: 'SA', addressCountry: 'IT' } },
  ],
};
---

<BlogPostLayout
  lang={lang}
  post={post}
  metaTitle={metaTitle}
  metaDescription={metaDescription}
  breadcrumbs={breadcrumbs}
  quickInfo={quickInfo}
  faq={faq}
  sidebarLinks={sidebarLinks}
  authorRole={authorRole}
  relatedArticles={relatedArticles}
  extraSchema={[compareSchema]}
>

  <div>
    <p class="text-slate-600 text-xl leading-relaxed mb-6 font-light">
      <strong>¿Positano o Amalfi?</strong> Los dos iconos de la Costa Amalfitana están a 17 km por la misma carretera dramática del acantilado, pero ofrecen experiencias radicalmente distintas. Positano es el icono visual: casas color pastel, beach clubs exclusivos, vistas al mar de $400 la noche. Amalfi es el corazón histórico: una república marítima medieval con catedral normando-árabe y precios un 30% más bajos. Esta guía elige el pueblo correcto para tu viaje específico (luna de miel, familia, senderismo, Ravello).
    </p>
  </div>

  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">Para luna de miel: Positano</h2>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      Los recién casados vienen por la imagen. <a href="/es-es/costa-amalfitana/positano/" class="text-med-blue hover:underline">Positano</a> ES la imagen de la Costa Amalfitana: la foto en cada tablero de Pinterest, cada portada de revista, cada lista de "mejores destinos europeos". <a href="/es-es/costa-amalfitana/amalfi/" class="text-med-blue hover:underline">Amalfi</a> tiene su propia belleza (escalinata de la catedral, arsenal medieval), pero no entrega el momento de postal.
    </p>
    <div class="bg-white p-8 rounded-[2rem] border border-slate-100 shadow-sm mb-6">
      <h3 class="font-serif text-xl font-bold text-slate-900 mb-4">Experiencias de luna de miel que solo ofrece Positano</h3>
      <ul class="space-y-4 text-slate-600">
        <li class="flex items-start gap-3">
          <span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span>
          <span class="text-slate-700"><strong>Comida en barco Da Adolfo.</strong> El restaurante de playa solo accesible en barco, lanzadera gratis desde la Spiaggia Grande, mozzarella sobre hojas de limón: la comida más fotografiada de la Costa.</span>
        </li>
        <li class="flex items-start gap-3">
          <span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span>
          <span class="text-slate-700"><strong>Cóctel en La Sponda.</strong> La terraza del hotel Le Sirenuse al atardecer: vistas 5★ Michelin sin alojarte allí.</span>
        </li>
        <li class="flex items-start gap-3">
          <span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span>
          <span class="text-slate-700"><strong>Atardecer en la <a href="/es-es/playas/costa-amalfitana/fornillo-positano/" class="text-med-blue hover:underline">Playa de Fornillo</a>.</strong> Camina la Via Positanesi d'America, aperitivo en Pupetto, la cúpula naranja brillando sobre la bahía.</span>
        </li>
      </ul>
    </div>
    <p class="text-slate-600 text-lg leading-relaxed">
      Amalfi tiene romance, pero es el romance de una ciudad histórica, más Venecia que luna de miel en Bali. Si viniste por LA estética de la Costa Amalfitana, Positano la entrega. Punto.
    </p>
  </div>

  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">Para familias: Amalfi</h2>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      Amalfi resuelve cada problema familiar de Positano. La plaza principal (Piazza Duomo) es plana. La playa está justo bajo la carretera principal, con un largo paseo pavimentado y con sombra. Hoteles con aparcamiento. Aceras aptas para carritos. Supermercado grande (Conad) a dos minutos de la plaza. Farmacia pediátrica en la calle principal.
    </p>
    <div class="bg-med-cream p-8 rounded-[2rem] border border-med-gold/20 mb-6">
      <h3 class="font-serif text-xl font-bold text-slate-900 mb-4">Logística familiar, cara a cara</h3>
      <table class="w-full text-sm">
        <tbody class="divide-y divide-med-gold/20">
          <tr><td class="py-2 font-semibold">Calles aptas para carritos</td><td class="py-2">Amalfi ✓ · Positano ✗</td></tr>
          <tr><td class="py-2 font-semibold">Aparcamiento de hotel</td><td class="py-2">Amalfi ✓ · Positano muy limitado</td></tr>
          <tr><td class="py-2 font-semibold">Camino plano a la playa</td><td class="py-2">Amalfi ✓ · Positano solo escaleras</td></tr>
          <tr><td class="py-2 font-semibold">Supermercado a 5 min</td><td class="py-2">Amalfi ✓ · Positano ✗</td></tr>
          <tr><td class="py-2 font-semibold">Atracción para niños</td><td class="py-2">Museo del Papel, claustro Catedral</td></tr>
          <tr><td class="py-2 font-semibold">Excursión rápida a Ravello</td><td class="py-2">25 min bus desde Amalfi</td></tr>
        </tbody>
      </table>
    </div>
    <p class="text-slate-600 text-lg leading-relaxed">
      Bonus: desde Amalfi puedes subir a los niños al ferry de Capri (1 hora) para el tour de la Gruta Azul: un día mágico sin empujar carritos.
    </p>
  </div>

  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">Para primera visita: depende del estilo</h2>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      Aquí la respuesta se divide. Si viniste a "ver la Costa Amalfitana" y eso significa la vista de postal → <strong>Positano</strong>. Si viniste a explorar la Costa en conjunto, con excursiones a Ravello, Minori, Capri y Salerno → <strong>Amalfi</strong>.
    </p>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      Amalfi está en el centro geográfico de la Costa. Cada bus SITA y cada ferry pasan por aquí. Desde Amalfi:
    </p>
    <div class="overflow-hidden rounded-[2rem] border border-slate-100 shadow-sm mb-6">
      <table class="w-full text-sm">
        <thead class="bg-slate-900 text-white">
          <tr>
            <th class="text-left p-4 font-bold text-med-gold">Desde Amalfi a</th>
            <th class="text-left p-4 font-bold text-med-gold">Medio</th>
            <th class="text-left p-4 font-bold text-med-gold">Tiempo</th>
          </tr>
        </thead>
        <tbody class="bg-white">
          <tr class="border-b border-slate-100"><td class="p-4 font-semibold">Ravello</td><td class="p-4">Bus SITA</td><td class="p-4">25 min</td></tr>
          <tr class="border-b border-slate-100"><td class="p-4 font-semibold">Positano</td><td class="p-4">Ferry / bus</td><td class="p-4">25 / 40 min</td></tr>
          <tr class="border-b border-slate-100"><td class="p-4 font-semibold">Minori y Maiori</td><td class="p-4">Bus SITA</td><td class="p-4">15-20 min</td></tr>
          <tr class="border-b border-slate-100"><td class="p-4 font-semibold">Capri</td><td class="p-4">Ferry</td><td class="p-4">1h</td></tr>
          <tr class="border-b border-slate-100"><td class="p-4 font-semibold">Salerno (para trenes al sur)</td><td class="p-4">Ferry / bus</td><td class="p-4">35 / 70 min</td></tr>
          <tr><td class="p-4 font-semibold">Gruta Esmeralda</td><td class="p-4">Bus / ferry</td><td class="p-4">15 min</td></tr>
        </tbody>
      </table>
    </div>
    <p class="text-slate-600 text-lg leading-relaxed">
      La desventaja logística de Positano: cada excursión al este empieza pasando por Amalfi, sumando 30-40 minutos por trayecto a todo lo que esté al este de Positano.
    </p>
  </div>

  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">Para viajeros con presupuesto: Amalfi ahorra 30-40%</h2>
    <div class="overflow-hidden rounded-[2rem] border border-slate-100 shadow-sm mb-6">
      <table class="w-full text-sm">
        <thead class="bg-slate-900 text-white">
          <tr>
            <th class="text-left p-4 font-bold text-med-gold">Concepto (mayo 2026)</th>
            <th class="text-left p-4 font-bold text-med-gold">Amalfi</th>
            <th class="text-left p-4 font-bold text-med-gold">Positano</th>
          </tr>
        </thead>
        <tbody class="bg-white">
          <tr class="border-b border-slate-100"><td class="p-4 font-semibold">Hotel 3★, doble</td><td class="p-4">€150-220</td><td class="p-4">€280-450</td></tr>
          <tr class="border-b border-slate-100"><td class="p-4 font-semibold">4★ con vista al mar</td><td class="p-4">€250-450</td><td class="p-4">€500-900</td></tr>
          <tr class="border-b border-slate-100"><td class="p-4 font-semibold">Hamaca + sombrilla</td><td class="p-4">€20-30</td><td class="p-4">€35-60</td></tr>
          <tr class="border-b border-slate-100"><td class="p-4 font-semibold">Pasta gama media</td><td class="p-4">€14-18</td><td class="p-4">€18-25</td></tr>
          <tr><td class="p-4 font-semibold">Aparcamiento hotel/noche</td><td class="p-4">€20-35</td><td class="p-4">€40-70</td></tr>
        </tbody>
      </table>
    </div>
  </div>

  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">El veredicto en 30 segundos</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8">
      <div class="bg-white p-6 rounded-[2rem] border border-slate-100 shadow-sm">
        <p class="text-med-gold text-[10px] font-bold uppercase tracking-[0.2em] mb-3">Elige Positano si:</p>
        <ul class="space-y-3 text-slate-600 text-sm">
          <li class="flex items-start gap-3"><span class="w-2 h-2 bg-med-gold rounded-full mt-2 flex-shrink-0"></span><span>Luna de miel o viaje de aniversario</span></li>
          <li class="flex items-start gap-3"><span class="w-2 h-2 bg-med-gold rounded-full mt-2 flex-shrink-0"></span><span>Viniste por la imagen icónica de postal</span></li>
          <li class="flex items-start gap-3"><span class="w-2 h-2 bg-med-gold rounded-full mt-2 flex-shrink-0"></span><span>El Sendero de los Dioses está en tu lista</span></li>
          <li class="flex items-start gap-3"><span class="w-2 h-2 bg-med-gold rounded-full mt-2 flex-shrink-0"></span><span>Presupuesto €400+ por noche para la habitación que realmente quieres</span></li>
          <li class="flex items-start gap-3"><span class="w-2 h-2 bg-med-gold rounded-full mt-2 flex-shrink-0"></span><span>2-3 noches dentro de un viaje italiano más amplio</span></li>
        </ul>
      </div>
      <div class="bg-white p-6 rounded-[2rem] border border-slate-100 shadow-sm">
        <p class="text-med-gold text-[10px] font-bold uppercase tracking-[0.2em] mb-3">Elige Amalfi si:</p>
        <ul class="space-y-3 text-slate-600 text-sm">
          <li class="flex items-start gap-3"><span class="w-2 h-2 bg-med-gold rounded-full mt-2 flex-shrink-0"></span><span>Viajas con niños menores de 14 años</span></li>
          <li class="flex items-start gap-3"><span class="w-2 h-2 bg-med-gold rounded-full mt-2 flex-shrink-0"></span><span>Quieres explorar toda la Costa (Ravello, Minori, Maiori, Capri)</span></li>
          <li class="flex items-start gap-3"><span class="w-2 h-2 bg-med-gold rounded-full mt-2 flex-shrink-0"></span><span>Presupuesto bajo €250 por noche con vista al mar</span></li>
          <li class="flex items-start gap-3"><span class="w-2 h-2 bg-med-gold rounded-full mt-2 flex-shrink-0"></span><span>Viajero cultural: catedral, museo del papel, historia marítima</span></li>
          <li class="flex items-start gap-3"><span class="w-2 h-2 bg-med-gold rounded-full mt-2 flex-shrink-0"></span><span>3-5 noches con varias excursiones planeadas</span></li>
        </ul>
      </div>
    </div>
    <blockquote class="border-l-4 border-med-gold pl-6 mb-8">
      <p class="text-slate-700 text-lg font-serif italic leading-relaxed">
        "💡 Consejo local: aquí también la doble estancia funciona maravillosamente. 2 noches en Positano al inicio para el romance y las fotos icónicas, luego 3 noches en Amalfi como base para explorar el resto de la Costa (noche del Ravello Festival, día a Minori por los limones, excursión a Capri). Vives la experiencia completa de la Costa sin gastar todo el presupuesto en un solo hotel."
      </p>
    </blockquote>
  </div>

  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">Tabla de comparación rápida</h2>
    <div class="overflow-hidden rounded-[2rem] border border-slate-100 shadow-sm">
      <table class="w-full text-sm">
        <thead class="bg-slate-900 text-white">
          <tr>
            <th class="text-left p-4 font-bold text-med-gold">Característica</th>
            <th class="text-left p-4 font-bold text-med-gold">Positano</th>
            <th class="text-left p-4 font-bold text-med-gold">Amalfi</th>
          </tr>
        </thead>
        <tbody class="bg-white">
          <tr class="border-b border-slate-100"><td class="p-4 font-semibold">Terreno</td><td class="p-4">600+ escalones, vertical</td><td class="p-4">Plaza plana, pendientes suaves</td></tr>
          <tr class="border-b border-slate-100"><td class="p-4 font-semibold">Estilo visual</td><td class="p-4">Pueblo pastel de postal</td><td class="p-4">Marítimo medieval, catedral normando-árabe</td></tr>
          <tr class="border-b border-slate-100"><td class="p-4 font-semibold">Playa</td><td class="p-4">Spiaggia Grande + Fornillo</td><td class="p-4">Larga playa pública con paseo</td></tr>
          <tr class="border-b border-slate-100"><td class="p-4 font-semibold">Acceso a Ravello</td><td class="p-4">1h15 (vía Amalfi)</td><td class="p-4">25 min bus directo</td></tr>
          <tr class="border-b border-slate-100"><td class="p-4 font-semibold">Acceso a Capri</td><td class="p-4">35 min ferry</td><td class="p-4">1h ferry</td></tr>
          <tr class="border-b border-slate-100"><td class="p-4 font-semibold">Coste medio hotel</td><td class="p-4">€280-900</td><td class="p-4">€150-450</td></tr>
          <tr class="border-b border-slate-100"><td class="p-4 font-semibold">Apto para carritos</td><td class="p-4">No</td><td class="p-4">Sí</td></tr>
          <tr><td class="p-4 font-semibold">Ideal para</td><td class="p-4">Lunas de miel, fotógrafos, slow travellers</td><td class="p-4">Familias, viajeros culturales, exploradores</td></tr>
        </tbody>
      </table>
    </div>
  </div>

</BlogPostLayout>
