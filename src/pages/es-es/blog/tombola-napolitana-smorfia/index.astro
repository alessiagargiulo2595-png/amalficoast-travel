---
import BlogPostLayout from '../../../../layouts/BlogPostLayout.astro';

const lang = 'es-es';
const post = {
  title: 'Tombola napolitana y smorfia: qué significan los números',
  subtitle: "El juego de Navidad de todas las familias de Campania, cómo funciona, y por qué el 47 es un muerto, el 48 un muerto que habla y el 71 alguien con quien mejor no cruzarse",
  category: 'DESCUBRIMIENTOS',
  date: '19 de noviembre de 2026',
  readTime: '11 min',
  image: '/images/tombola-numeri-hero.webp',
  imageAlt: "Fichas de madera de la tombola con el 31 y el 73 en rojo",
  path: '/es-es/blog/tombola-napolitana-smorfia/',
};

const metaTitle = 'Tombola napolitana y smorfia: qué significan los números';
const metaDescription = "Cómo se juega la tombola napolitana en Navidad y qué significan los números de la smorfia: 33, 47, 48, 71, 77, 90 y otros, en napolitano y con su traducción.";

const breadcrumbs = [
  { name: 'Inicio', url: '/es-es/' },
  { name: 'Blog', url: '/es-es/blog/' },
  { name: 'Tombola napolitana y smorfia', url: '/es-es/blog/tombola-napolitana-smorfia/' },
];

const quickInfo = [
  { label: 'Qué es', value: 'Una lotería casera, parecida al bingo' },
  { label: 'Cuándo', value: 'Las fiestas de Navidad' },
  { label: 'Números', value: 'Del 1 al 90' },
  { label: 'Cartón', value: '15 números en 3 filas' },
  { label: 'Premios', value: 'Ambo, terno, quaterna, cinquina, tombola' },
  { label: 'La cesta', value: 'Panariello' },
  { label: 'La smorfia', value: 'Un significado para cada número' },
  { label: 'Los más citados', value: '47, 48, 71, 90' },
];

const faq = [
  {
    q: '¿Qué es la tombola napolitana?',
    a: "Un juego de azar familiar que se juega durante las fiestas de Navidad. Los números del 1 al 90 se sacan uno a uno de una cesta y los jugadores los tapan en sus cartones, de forma muy parecida al bingo. Se gana siendo el primero en completar dos, tres, cuatro o cinco números en la misma fila, y el premio gordo, la tombola, es para quien llena antes todo el cartón. En Nápoles cada número se canta con su significado en la smorfia.",
  },
  {
    q: '¿Cuándo se juega a la tombola?',
    a: "Durante las fiestas de Navidad: después de la cena de Nochebuena, el día de Navidad, en Nochevieja y en las tardes más tranquilas de entremedias. La tradición la relaciona con la pausa navideña del lotto, cuando las familias empezaron a jugar su propia versión en casa.",
  },
  {
    q: '¿Qué significa el 71 en la smorfia?',
    a: "El 71 es \"L'ommo 'e merda\", literalmente el hombre de mierda: una persona que no vale nada, sin dignidad ni palabra. Es uno de los números vulgares de la smorfia y de los más citados, porque en la mesa se suele cantar mirando a un pariente muy concreto.",
  },
  {
    q: '¿Qué diferencia hay entre el 47 y el 48?',
    a: "En Nápoles el 47 es \"'O muorto\", el muerto, y el 48 es \"'O muorto che parla\", el muerto que habla, que en sueños significa un mensaje de alguien que ya no está. En muchas otras ciudades italianas el muerto que habla es el 47, y por eso la película de Totò de 1950 se titula 47 morto che parla.",
  },
  {
    q: '¿Por qué el miedo hace 90?',
    a: "Porque en la smorfia el 90 es \"'A paura\", el miedo. El dicho italiano la paura fa novanta, el miedo hace noventa, viene directamente de ahí y se usa en toda Italia, incluso por gente que nunca ha jugado a la tombola en Nápoles.",
  },
  {
    q: '¿Qué es la tombola scostumata?',
    a: "La versión picante, también llamada tombola vajassa o tombola dei femminielli. Quien sostiene la cesta saca los números, anuncia sus significados en napolitano y los encadena en una historia improvisada y muy subida de tono. Tradicionalmente la dirigían los femminielli de los barrios populares, y hoy se ve sobre todo como espectáculo navideño en teatros de Nápoles.",
  },
];

const sidebarLinks = [
  { label: 'Belenes en Nápoles y Sorrento', href: '/es-es/blog/belenes-napoles-sorrento/' },
  { label: 'Dulces navideños napolitanos', href: '/es-es/blog/dulces-navidad-napolitanos/' },
  { label: 'Fiesta de los Muertos y Halloween', href: '/es-es/blog/fiesta-de-los-muertos-halloween/' },
  { label: 'Sorrento', href: '/es-es/peninsula-sorrentina/sorrento/' },
];

const authorRole = 'Experto Local · Península Sorrentina';

const relatedArticles = [
  {
    title: 'Belenes en Nápoles y Sorrento: guía para diciembre',
    category: 'GUIDE',
    date: '10 de noviembre de 2026',
    image: '/images/presepe-natale-hero.webp',
    imageAlt: 'Belén en Nápoles',
    path: '/es-es/blog/belenes-napoles-sorrento/'
  },
  {
    title: 'Dulces navideños napolitanos',
    category: 'GASTRONOMÍA',
    date: '14 de noviembre de 2026',
    image: '/images/struffoli-hero.webp',
    imageAlt: 'Struffoli, el dulce navideño napolitano',
    path: '/es-es/blog/dulces-navidad-napolitanos/'
  }
];

const keyTakeaways = [
  "La tombola napolitana es una lotería casera con los números del 1 al 90, que las familias juegan durante las fiestas de Navidad.",
  "La tradición la sitúa en Nápoles en 1734, cuando el lotto se suspendió en Navidad y las familias empezaron a sacar los números en casa.",
  "Se gana con ambo, terno, quaterna y cinquina (de dos a cinco números en una fila) y con la tombola, el cartón completo.",
  "Cada número se canta con su significado en la smorfia, el libro de los sueños napolitano: 47 es el muerto, 48 el muerto que habla, 90 el miedo.",
  "Algunos significados son vulgares a propósito, el 71 el primero, y la versión picante del juego, la tombola scostumata, hoy es un espectáculo de Navidad.",
];

const numbers = [
  { n: 1, nap: "L'Italia", lit: "Italia", text: "El primer número le corresponde al país. Las smorfie más antiguas le daban otras imágenes, pero hoy todos los tableros llevan Italia." },
  { n: 10, nap: "'E fasule", lit: "Las alubias", text: "Un número humilde para una comida humilde. Y coherente, porque las alubias secas son justo lo que muchas familias usan para tapar los números de los cartones." },
  { n: 13, nap: "Sant'Antuono", lit: "San Antonio", text: "Sant'Antuono es san Antonio Abad, uno de los santos más queridos de Campania. Aquí el 13 no trae mala suerte: ese papel es del 17." },
  { n: 16, nap: "'O culo", lit: "El trasero", text: "Literalmente el trasero, y por extensión la suerte, porque en italiano avere culo significa tener potra. Quien gana demasiado lo oirá a menudo." },
  { n: 17, nap: "'A disgrazzia", lit: "La desgracia", text: "El 17 es el número gafe en Italia. La explicación habitual: el XVII romano, con las letras reordenadas, da VIXI, en latín he vivido, es decir, estoy muerto." },
  { n: 22, nap: "'O pazzo", lit: "El loco", text: "Se canta mirando a quien se comporta de forma más rara en la mesa, algo que una noche de Navidad nunca cuesta decidir." },
  { n: 25, nap: "Natale", lit: "Navidad", text: "La fecha habla por sí sola. Cuando sale el 25 en una tombola de Navidad, la mesa aplaude un poco." },
  { n: 28, nap: "'E zizze", lit: "Los pechos", text: "Uno de los números descarados. Las abuelas lo dicen sin pestañear, los adolescentes se ríen por lo bajo." },
  { n: 33, nap: "L'anne 'e Cristo", lit: "Los años de Cristo", text: "Treinta y tres, la edad a la que murió Cristo. También se escribe ll'anne 'e Criste, más cerca de la pronunciación." },
  { n: 34, nap: "'A capa", lit: "La cabeza", text: "Sencillo y anatómico: capa es la palabra napolitana para cabeza. Soñar con una cabeza, la propia o la de otro, lleva aquí." },
  { n: 37, nap: "'O monaco", lit: "El monje", text: "Una ciudad con tantos conventos como Nápoles tenía que darle un número al monje. Soñar con un fraile o un monje lleva al 37." },
  { n: 43, nap: "'Onna Pereta fore 'o balcone", lit: "Doña Pereta fuera en el balcón", text: "Una mujer asomada a su balcón, figura eterna del callejón napolitano que lo ve y lo comenta todo. Pereta no es un nombre que vaya a encontrar en el registro civil." },
  { n: 45, nap: "'O vino bbuono", lit: "El vino bueno", text: "El vino bueno, concretamente. Muy apropiado en una mesa que lleva comiendo desde la tarde." },
  { n: 47, nap: "'O muorto", lit: "El muerto", text: "El muerto, sin más. Soñar con alguien que ya no está lleva tradicionalmente aquí, salvo que el muerto hable." },
  { n: 48, nap: "'O muorto che parla", lit: "El muerto que habla", text: "Si el muerto habla en el sueño, el número es el 48, y lo que dice debería sugerir otros números. Fuera de Nápoles muchas ciudades asignan el muerto que habla al 47, de ahí la película de Totò de 1950, 47 morto che parla." },
  { n: 55, nap: "'A musica", lit: "La música", text: "La música, en una ciudad que exporta canciones. También se escribe 'a museca, tal como se pronuncia." },
  { n: 69, nap: "Sotto e 'ncoppa", lit: "Patas arriba", text: "Literalmente abajo y arriba. Basta mirar las dos cifras y la lógica no necesita más comentarios." },
  { n: 71, nap: "L'ommo 'e merda", lit: "El hombre de mierda", text: "Un hombre que no vale nada, sin dignidad ni palabra. Es el número vulgar más famoso y se canta con gusto, a menudo mirando a un tío en particular. También se escribe l'omm 'e mmerd, tal como suena." },
  { n: 75, nap: "Pulecenella", lit: "Pulcinella", text: "La máscara de la comedia napolitana, blusón blanco y media máscara negra, pobre, hambriento y siempre capaz de salir del paso." },
  { n: 77, nap: "'E riavule", lit: "Los diablos", text: "En Nápoles el 77 son los diablos. La lectura del 77 como las piernas de las mujeres, que muchos citan, pertenece a otras tradiciones: un soneto romano de 1883 ya le da ese significado." },
  { n: 85, nap: "Ll'aneme d''o priatorio", lit: "Las almas del purgatorio", text: "Las almas de los difuntos que esperan en el purgatorio, centrales en la devoción popular napolitana y en la fiesta de los muertos de noviembre." },
  { n: 89, nap: "'A vecchia", lit: "La vieja", text: "La vieja, figura fija de los cuentos y del callejón. Normalmente no se canta mirando a la abuela que sostiene la cesta." },
  { n: 90, nap: "'A paura", lit: "El miedo", text: "El último número, y el origen del dicho la paura fa novanta, el miedo hace noventa, que se usa cuando el susto empuja a alguien a hacer lo que nunca haría." },
];
---

<BlogPostLayout
  lang={lang}
  post={post}
  metaTitle={metaTitle}
  metaDescription={metaDescription}
  breadcrumbs={breadcrumbs}
  quickInfo={quickInfo}
  faq={faq}
  sidebarLinks={sidebarLinks}
  authorRole={authorRole}
  relatedArticles={relatedArticles}
  pageKey="neapolitan-tombola-smorfia"
>

  <!-- Key Takeaways -->
  <div class="bg-slate-900 text-white p-8 rounded-[2rem]">
    <div class="flex items-center gap-3 mb-6">
      <svg class="w-5 h-5 text-med-gold flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
      <h2 class="font-serif text-lg font-bold text-med-gold uppercase tracking-[0.15em]">Key Takeaways</h2>
    </div>
    <ul class="space-y-4">
      {keyTakeaways.map((point) => (
        <li class="flex items-start gap-3">
          <span class="w-1.5 h-1.5 rounded-full bg-med-gold flex-shrink-0 mt-2"></span>
          <span class="text-white/80 text-xs sm:text-sm leading-relaxed">{point}</span>
        </li>
      ))}
    </ul>
  </div>

  <!-- Intro -->
  <div>
    <p class="text-slate-600 text-xl leading-relaxed mb-6 font-light">
      La cena de Navidad ha terminado, la mesa se ha recogido lo justo para hacer sitio y alguien saca una cestita de mimbre llena de numeritos de madera. Durante las tres horas siguientes, una familia napolitana entera va a discutir por unas alubias secas. El juego es la <em>tombola</em>, una versión casera del lotto que funciona casi como el bingo, y lo que la hace napolitana es la voz de quien sostiene la cesta: cada número sale con su significado en la <em>smorfia</em>, el libro de los sueños, y algunos de esos significados no son aptos para el párroco.
    </p>
  </div>

  <!-- What it is -->
  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">Qué es la tombola y cuándo se juega</h2>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      La tombola es un juego de azar con 90 números. Una persona los saca uno a uno de una cesta y los canta en voz alta; todos los demás los tapan en sus propios cartones. Gana quien completa primero dos, tres, cuatro o cinco números en la misma fila, y el premio gordo es para quien tapa todo el cartón. Si conoce el bingo, ya conoce casi todo.
    </p>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      Pertenece a las fiestas de Navidad, que en Italia duran hasta la Epifanía, el 6 de enero. Las noches clásicas son la Nochebuena después de la cena de pescado, el día de Navidad después de comer y la Nochevieja esperando la medianoche, pero en muchas casas la cesta sale cualquier noche en que la familia está reunida y nadie quiere salir al frío. Abuelos y niños juegan en la misma mesa, con unas monedas por cartón, y el dinero se queda de todas formas en la familia.
    </p>
    <p class="text-slate-600 text-lg leading-relaxed">
      Se juega en toda Campania, de Nápoles a <a href="/es-es/peninsula-sorrentina/sorrento/" class="text-med-blue hover:underline">Sorrento</a> y hasta los pueblos de la Costa Amalfitana. Si pasa la Navidad aquí y alguien le pregunta si quiere un cartón, la respuesta es sí.
    </p>
  </div>

  <!-- Origin -->
  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">De dónde viene: un rey, un dominico y el lotto</h2>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      Nápoles jugaba al lotto mucho antes de que existiera la tombola. La estructura de 90 números viene de un juego genovés del siglo XVI, y el lotto había llegado a Nápoles a finales del XVII, jugado de forma legal e ilegal a partes iguales.
    </p>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      La tradición sitúa el nacimiento de la tombola en <strong>1734</strong>, bajo Carlos de Borbón, el futuro Carlos III de España. El rey quería el lotto bajo control público, para que se beneficiara el erario y no las bancas clandestinas. Frente a él estaba el fraile dominico <strong>Gregorio Maria Rocco</strong>, predicador famosísimo, que llamaba al juego un pasatiempo engañoso e inmoral que apartaba al pueblo de la oración. El acuerdo, según el relato, fue que el lotto se detendría durante las fiestas de Navidad. Sin poder jugar en público, las familias napolitanas metieron los números en una cesta y los sacaron en casa.
    </p>
    <p class="text-slate-600 text-lg leading-relaxed">
      Tome los detalles como una tradición consolidada más que como un decreto documentado: es la historia que repiten todas las fuentes napolitanas, y nadie ha propuesto una mejor. El nombre viene probablemente del voltear de los números en la cesta antes de cada extracción, tombolare en italiano.
    </p>
  </div>

  <!-- How to play -->
  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">Cómo se juega</h2>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      Hacen falta tres cosas: las <strong>cartelle</strong>, los cartones; el <strong>cartellone</strong>, el tablero grande con los 90 números; y el <strong>panariello</strong>, la cestita de mimbre con los 90 números de madera o de plástico. Cada cartón tiene tres filas de cinco números, quince en total, repartidos en nueve columnas. Cada uno compra los cartones que quiere, a menudo por unos céntimos cada uno, y el dinero recogido forma el bote.
    </p>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      Quien tiene el cartellone saca y canta, coloca cada número en el tablero y también juega: el tablero cuenta como seis cartones y puede ganar premios como cualquiera. Los números se tapan con lo que haya en la cocina. Las alubias secas son lo clásico, y los trocitos de piel de mandarina van justo detrás.
    </p>

    <div class="overflow-x-auto rounded-[2rem] border border-slate-100 shadow-sm mb-6">
      <table class="w-full text-xs sm:text-sm">
        <thead class="bg-slate-900 text-white">
          <tr>
            <th class="text-left p-5 font-serif font-bold text-med-gold">Premio</th>
            <th class="text-left p-5 font-serif font-bold text-med-gold">Qué hace falta</th>
          </tr>
        </thead>
        <tbody class="bg-white">
          <tr class="border-b border-slate-100">
            <td class="p-5 font-bold">Ambo</td>
            <td class="p-5 text-slate-600">Dos números en la misma fila de un cartón.</td>
          </tr>
          <tr class="border-b border-slate-100">
            <td class="p-5 font-bold">Terno</td>
            <td class="p-5 text-slate-600">Tres números en la misma fila.</td>
          </tr>
          <tr class="border-b border-slate-100">
            <td class="p-5 font-bold">Quaterna</td>
            <td class="p-5 text-slate-600">Cuatro números en la misma fila.</td>
          </tr>
          <tr class="border-b border-slate-100">
            <td class="p-5 font-bold">Cinquina</td>
            <td class="p-5 text-slate-600">Los cinco números de una fila.</td>
          </tr>
          <tr class="border-b border-slate-100">
            <td class="p-5 font-bold">Tombola</td>
            <td class="p-5 text-slate-600">Los quince números de un cartón. El premio principal, anunciado gritando el nombre del juego.</td>
          </tr>
          <tr>
            <td class="p-5 font-bold">Tombolino</td>
            <td class="p-5 text-slate-600">Un premio opcional para el segundo cartón completo, para que la partida dure un poco más.</td>
          </tr>
        </tbody>
      </table>
    </div>

    <ul class="space-y-3">
      <li class="flex items-start gap-3"><span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span><span class="text-slate-700"><strong>Cántelo en voz alta.</strong> Cada premio debe reclamarse antes de que salga el número siguiente; si no, pasa a quien lo reclame después.</span></li>
      <li class="flex items-start gap-3"><span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span><span class="text-slate-700"><strong>Los premios van en orden.</strong> Primero el ambo, luego el terno y así hasta la tombola. Nadie puede ganar un terno antes de que alguien haya hecho ambo.</span></li>
      <li class="flex items-start gap-3"><span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span><span class="text-slate-700"><strong>La cesta rota.</strong> En muchas familias quien hace tombola se queda el cartellone para la siguiente ronda.</span></li>
    </ul>
  </div>

  <!-- Smorfia -->
  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">La smorfia, explicada</h2>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      La <em>smorfia</em> es el libro de los sueños napolitano: un diccionario popular que traduce sueños y hechos cotidianos en números del 1 al 90, nacido para saber qué jugar al lotto. Sueña con un gato, juega el 3. Un pariente fallecido le habla en sueños, juega el 48. El nombre suele relacionarse con Morfeo, el dios griego de los sueños; los orígenes son inciertos, con teorías que van de la cábala a la numerología pitagórica.
    </p>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      Se transmitió de palabra mucho antes de imprimirse, y cuando se puso por escrito se organizó en imágenes, para que pudiera usarla también quien no sabía leer. Por eso el cartellone napolitano todavía muestra un dibujito en cada casilla. Los significados pueden cambiar de una ciudad a otra, e incluso dentro de Nápoles hay variantes y varias grafías de la misma frase.
    </p>
    <p class="text-slate-600 text-lg leading-relaxed">
      En la tombola la smorfia se vuelve teatro. Quien canta rara vez dice solo el número: dice el significado, a veces solo el significado, y la mesa tiene que adivinar el número. Un buen cantor encadena los números en pullas a los presentes. A finales de los años setenta, Massimo Troisi, Lello Arena y Enzo De Caro llegaron a llamar a su trío cómico La Smorfia.
    </p>
  </div>

  <!-- Numbers -->
  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">Qué significan los números</h2>
    <p class="text-slate-600 text-lg leading-relaxed mb-8">
      Estos son los números más buscados y los que más se oyen en una mesa napolitana. Para cada uno: la frase en napolitano, en la grafía más habitual, la traducción literal y una nota breve. Algunos son vulgares; forman parte del juego, y quitarlos sería mentir.
    </p>
    <div class="space-y-4">
      {numbers.map((item) => (
        <div class="bg-white p-6 rounded-[2rem] border border-slate-100 shadow-sm">
          <h3 class="font-serif text-xl font-bold text-slate-900 mb-2">¿Qué significa el {item.n}?</h3>
          <p class="text-slate-900 font-semibold mb-2"><span class="text-med-gold">{item.n}</span> · <em>{item.nap}</em> · {item.lit}</p>
          <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">{item.text}</p>
        </div>
      ))}
    </div>
  </div>

  <!-- Scostumata -->
  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">La tombola scostumata</h2>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      Está la tombola en familia, y luego está la <em>tombola scostumata</em>, la maleducada, también llamada <em>tombola vajassa</em> o <em>tombola dei femminielli</em>. Las reglas son las mismas. Lo que cambia es quien canta, que anuncia cada número con su significado más picante, estrictamente en napolitano, y enlaza una extracción con la siguiente hasta montar una historia improvisada que se vuelve más indecente a medida que se llena el tablero.
    </p>
    <p class="text-slate-600 text-lg leading-relaxed">
      Tradicionalmente la dirigían los <em>femminielli</em>, figura reconocida de los barrios populares de Nápoles, en partidas reservadas a mujeres y niños. Hoy sobrevive sobre todo como espectáculo de Navidad: teatros y cabarets de Nápoles ponen en escena tombolate scostumate cada diciembre, a menudo con cena incluida. No hace falta hablar bien napolitano. Los gestos hacen casi todo el trabajo.
    </p>
  </div>

  <!-- Where to buy -->
  <div>
