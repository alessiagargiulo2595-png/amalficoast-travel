---
import BlogPostLayout from '../../../../layouts/BlogPostLayout.astro';

const lang = 'es-es';
const post = {
  title: 'Punta Campanella',
  subtitle: 'Donde el Mito se Encuentra con los Dos Golfos',
  category: 'DESCUBRIMIENTOS',
  date: '10 de mayo de 2026',
  readTime: '8 min',
  image: '/images/punta-campanella-hero.jpg',
  imageAlt: 'Punta Campanella - Massa Lubrense, Península de Sorrento',
  path: '/es-es/blog/punta-campanella/',
};

const metaTitle = 'Punta Campanella: Senderismo, Arqueología y el Mito de Ulises 2026';
const metaDescription = 'Guía completa a Punta Campanella: senderismo en Península de Sorrento con vistas a Capri, Templo de Atenea, torre medieval, reserva marina protegida y leyendas de Ulises.';

const breadcrumbs = [
  { name: 'Inicio', url: '/es-es/' },
  { name: 'Blog', url: '/es-es/blog/' },
  { name: 'Punta Campanella', url: '/es-es/blog/punta-campanella/' },
];

const quickInfo = [
  { label: 'Punto de partida', value: 'Plaza de Termini (Massa Lubrense)' },
  { label: 'Dificultad', value: 'E (Excursionista) - Fácil/Media' },
  { label: 'Duración', value: 'Aproximadamente 1 hora (solo ida)' },
  { label: 'Equipo', value: 'Calzado de trekking, agua, sombrero' },
  { label: 'Acceso', value: 'Gratuito (Reserva Marina Protegida)' },
  { label: 'Vistas', value: 'Capri, Golfo de Nápoles, Costa Amalfitana' },
  { label: 'Qué ver', value: 'Templo de Atenea, Torre campanaria, Farallones, Bahía de Ieranto' },
  { label: 'Mejor época', value: 'Abril - Octubre (Atardecer espectacular)' },
];

const faq = [
  {
    q: '¿Se puede llegar en coche a Punta Campanella?',
    a: 'No, es un sendero peatonal. Puedes aparcar el coche en Termini y proseguir a pie.',
  },
  {
    q: '¿Se puede nadar en Punta Campanella?',
    a: 'Sí, pero no hay playas de arena. El acceso al mar es a través de rocas y peñascos. Se recomienda solo para nadadores experimentados debido a las corrientes.',
  },
  {
    q: '¿Es apto para niños?',
    a: 'Sí, el sendero principal es amplio y seguro, pero evita las horas más calurosas del día porque hay muy poca sombra.',
  },
  {
    q: '¿Cuándo es el mejor momento para el atardecer?',
    a: 'Durante la buena temporada (mayo-septiembre), el sol cae exactamente al lado de los Farallones de Capri alrededor de las 19-20h. Lleva una linterna frontal para el regreso.',
  },
  {
    q: '¿Cuál es la leyenda de Ulises?',
    a: 'Según la mitología griega, fue aquí donde Ulises encontró a las Sirenas. Para resistir su canto encantador, se hizo atar al mástil de su nave mientras los compañeros navegaban con los oídos tapados con cera.',
  },
  {
    q: '¿Hay acceso a la Bahía de Ieranto desde Punta Campanella?',
    a: 'Sí, desde el desvío principal puede dirigirse a la Bahía de Ieranto (para caminantes experimentados). Es una cala virgen propiedad del FAI con un mar de pureza primordial.',
  },
];

const sidebarLinks = [
  { label: 'Senderismo & Sendero de los Dioses', href: '/es-es/experiencias/trekking/' },
  { label: 'Descubre Massa Lubrense', href: '/es-es/peninsula-sorrentina/massa-lubrense/' },
  { label: 'Bahía de Ieranto', href: '/es-es/playas/peninsula-sorrentina/ieranto/' },
  { label: 'Cuándo visitar', href: '/es-es/cuando-visitar/' },
  { label: 'Cómo llegar', href: '/es-es/como-llegar/' },
];

const relatedArticles = [
  {
    title: 'Valle delle Ferriere',
    category: 'DESCUBRIMIENTOS',
    date: '22 de abril de 2026',
    image: '/images/valle-ferriere-hero.jpg',
    imageAlt: 'Cascada en la Valle delle Ferriere, Amalfi - Costa Amalfitana',
    path: '/es-es/blog/valle-delle-ferriere/'
  },
  {
    title: 'Atrani',
    category: 'DESCUBRIMIENTOS',
    date: '22 de abril de 2026',
    image: '/images/atrani-hero.jpg',
    imageAlt: 'Atrani - el pueblo más pequeño de Italia en la Costa Amalfitana',
    path: '/es-es/blog/atrani/'
  }
];

const authorRole = 'Guía de Aventura e Historia · Península de Sorrento';

const keyTakeaways = [
  'Punta Campanella es el punto donde la geografía se convierte en historia: frontera sagrada entre el Golfo de Nápoles y el Golfo de Salerno con vistas de 360 grados.',
  'Aquí se alzaba el majestuoso Templo de Atenea (dedicado a Minerva por los romanos), un faro de civilización en la antigüedad; hoy los restos arqueológicos afloran entre la vegetación.',
  'El nombre "Campanella" proviene de la torre de vigilancia del siglo XIV con una campana que sonaba la alarma contra incursiones sarracenas.',
  'El sendero es clasificado E (Excursionista): aproximadamente 1 hora desde Termini. Acceso gratuito a la Reserva Marina Protegida. Vista a 360 grados: Vesubio, Costa Sorrentina, Costa Amalfitana, Capri y Li Galli.',
  'El atardecer en Punta Campanella es una experiencia mística: el sol cae exactamente al lado de los Farallones de Capri tiñendo el mar de oro.',
];

const videoSchema = {
  "@context": "https://schema.org",
  "@type": "VideoObject",
  "name": "Punta Campanella: Donde el Mito Incontra los Dos Golfos",
  "description": "Video de la ubicación de Punta Campanella en la Península de Sorrento con vistas de 360 grados sobre dos golfs, arqueología y leyendas de Ulises.",
  "thumbnailUrl": "/images/punta-campanella-hero.jpg",
  "uploadDate": "2026-05-10",
  "duration": "PT0M30S",
  "contentUrl": "/videos/punta-campanella-video.mp4",
  "videoDetails": {
    "width": "1280",
    "height": "720"
  }
};
---

<BlogPostLayout
  lang={lang}
  post={post}
  metaTitle={metaTitle}
  metaDescription={metaDescription}
  breadcrumbs={breadcrumbs}
  quickInfo={quickInfo}
  faq={faq}
  sidebarLinks={sidebarLinks}
  authorRole={authorRole}
  relatedArticles={relatedArticles}
  schema={[videoSchema]}
>

  <!-- Video Section -->
  <div class="rounded-[2rem] overflow-hidden shadow-xl mb-8">
    <video
      controls
      poster="/images/punta-campanella-hero.jpg"
      class="w-full h-auto"
      width="1280"
      height="720"
    >
      <source src="/videos/punta-campanella-video.mp4" type="video/mp4" />
      Tu navegador no soporta video HTML5.
    </video>
  </div>

  <!-- Key Takeaways -->
  <div class="bg-slate-900 text-white p-8 rounded-[2rem]">
    <div class="flex items-center gap-3 mb-6">
      <svg class="w-5 h-5 text-med-gold flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
      <h2 class="font-serif text-lg font-bold text-med-gold uppercase tracking-[0.15em]">Puntos Clave</h2>
    </div>
    <ul class="space-y-4">
      {keyTakeaways.map((point) => (
        <li class="flex items-start gap-3">
          <span class="w-1.5 h-1.5 rounded-full bg-med-gold flex-shrink-0 mt-2"></span>
          <span class="text-white/80 text-xs sm:text-sm leading-relaxed">{point}</span>
        </li>
      ))}
    </ul>
  </div>

  <!-- Intro -->
  <div>
    <p class="text-slate-600 text-xl leading-relaxed mb-6 font-light">
      Existe un lugar, en el extremo de la Península Sorrentina, donde la tierra se estrecha hasta convertirse en una punta de roca proyectada hacia Capri. Ese lugar es Punta Campanella. No es solo una reserva marina protegida; es la frontera sagrada entre el Golfo de Nápoles y el Golfo de Salerno, un pedazo de tierra donde la historia milenaria, el mito de Ulises y una naturaleza salvaje se funden en una experiencia sensorial inolvidable.
    </p>
  </div>

  <!-- Un Viaje entre Mito y Arqueología -->
  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">Un Viaje entre Mito y Arqueología</h2>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      Caminar hacia Punta Campanella significa recorrer el mismo camino que griegos y romanos. Aquí se alzaba el majestuoso Templo de Atenea (más tarde dedicado a Minerva por los romanos), un faro de civilización que acogía a los marineros en la antigüedad. Hoy, los restos arqueológicos asoman entre la vegetación mediterránea, testigos de un pasado en el que este promontorio era considerado sagrado.
    </p>

    <div class="bg-white p-8 rounded-[2rem] border border-slate-100 shadow-sm my-6">
      <h3 class="font-serif text-xl font-bold text-slate-900 mb-4">La Torre Campanaria del Siglo XIV</h3>
      <p class="text-slate-600 leading-relaxed mb-4">
        El nombre "Campanella" proviene de la torre de vigilancia del siglo XIV, parte del sistema defensivo contra las incursiones sarracenas. En la cima de la torre había una <strong>campana que sonaba la alarma</strong> en caso de peligro, cuyo tañido rebotaba de torre en torre a lo largo de toda la costa, creando una cadena de comunicación que protegía los asentamientos costeros.
      </p>
      <p class="text-slate-600 leading-relaxed">
        Todavía hoy, aunque en ruinas, la torre domina el paisaje y cuenta historias de vigilancia nocturna, marineros ansiosos y una comunidad que protegía su territorio con constante vigilancia.
      </p>
    </div>

    <blockquote class="border-l-4 border-med-gold pl-6 my-8">
      <p class="text-slate-700 text-xl font-serif italic leading-relaxed">
        "Punta Campanella es donde la geografía se convierte en historia, y la historia se convierte en leyenda."
      </p>
    </blockquote>
  </div>

  <!-- El Sendero -->
  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">El Sendero: Senderismo entre Cielo y Mar</h2>
    <p class="text-slate-600 text-lg leading-relaxed mb-8">
      El itinerario para llegar a la punta parte del pueblo de Termini (pedanía de Massa Lubrense). Es un recorrido apto para todos, pero capaz de regalar vistas impresionantes.
    </p>

    <div class="space-y-4 mb-8">
      <div class="bg-white p-6 rounded-[2rem] border border-slate-100 shadow-sm flex gap-5">
        <div class="w-10 h-10 rounded-full bg-med-gold/10 flex-shrink-0 flex items-center justify-center text-med-gold font-bold text-xs sm:text-sm">1</div>
        <div>
          <h4 class="font-bold text-slate-900 mb-1">El Recorrido</h4>
          <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">El sendero serpentea entre olivos centenarios y arbustos de mirto y romero. A medida que se baja hacia el faro, la silueta de Capri se vuelve tan cercana que parece que se puede tocar.</p>
        </div>
      </div>
      <div class="bg-white p-6 rounded-[2rem] border border-slate-100 shadow-sm flex gap-5">
        <div class="w-10 h-10 rounded-full bg-med-gold/10 flex-shrink-0 flex items-center justify-center text-med-gold font-bold text-xs sm:text-sm">2</div>
        <div>
          <h4 class="font-bold text-slate-900 mb-1">La Vista Panorámica</h4>
          <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Al llegar a la torre, la mirada abarca 360 grados: por un lado el Vesubio y la costa sorrentina, por otro la escarpada Costa Amalfitana con el archipiélago de Li Galli.</p>
        </div>
      </div>
    </div>

    <div class="overflow-hidden rounded-[2rem] border border-slate-100 shadow-sm">
      <table class="w-full text-xs sm:text-xs sm:text-sm">
        <thead class="bg-slate-900 text-white">
          <tr>
            <th class="text-left p-5 font-serif font-bold text-med-gold">Característica</th>
            <th class="text-left p-5 font-serif font-bold text-med-gold">Detalle</th>
          </tr>
        </thead>
        <tbody class="bg-white">
          <tr class="border-b border-slate-100">
            <td class="p-5 font-bold text-slate-900">Punto de partida</td>
            <td class="p-5 text-slate-600">Plaza de Termini (Massa Lubrense)</td>
          </tr>
          <tr class="border-b border-slate-100">
            <td class="p-5 font-bold text-slate-900">Dificultad</td>
            <td class="p-5 text-slate-600">E (Excursionista) - Fácil/Media</td>
          </tr>
          <tr class="border-b border-slate-100">
            <td class="p-5 font-bold text-slate-900">Tiempo de trayecto</td>
            <td class="p-5 text-slate-600">Aproximadamente 1 hora (solo ida)</td>
          </tr>
          <tr class="border-b border-slate-100">
            <td class="p-5 font-bold text-slate-900">Equipo</td>
            <td class="p-5 text-slate-600">Calzado de trekking, agua, sombrero</td>
          </tr>
          <tr>
            <td class="p-5 font-bold text-slate-900">Acceso</td>
            <td class="p-5 text-slate-600">Gratuito (Reserva Marina Protegida)</td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>

  <!-- Local Tips -->
  <div class="bg-white p-8 rounded-[2rem] shadow-xl border border-slate-100">
    <div class="flex items-center gap-4 mb-6">
      <svg class="w-6 h-6 text-med-gold flex-shrink-0" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M9 18h6"/><path d="M10 22h4"/><path d="M15.09 14c.18-.98.65-1.74 1.41-2.5A4.65 4.65 0 0 0 18 8 6 6 0 0 0 6 8c0 1 .23 2.23 1.5 3.5A4.61 4.61 0 0 1 8.91 14"/></svg>
      <h3 class="text-xl font-bold text-slate-900">Consejos del Experto</h3>
    </div>
    <div class="space-y-6">
      <div>
        <p class="font-bold text-slate-900 mb-1">El Momento Mágico: El Atardecer</p>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">El atardecer en Punta Campanella es una experiencia mística. El sol cae exactamente al lado de los Farallones de Capri. Si decides quedarte, lleva una linterna frontal para el regreso a Termini.</p>
      </div>
      <div>
        <p class="font-bold text-slate-900 mb-1">La Bajada a la Bahía de Ieranto</p>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Si eres un caminante experto, puedes desviarte hacia la <a href="/es-es/playas/peninsula-sorrentina/ieranto/" class="text-med-blue hover:underline">Bahía de Ieranto</a>, una cala virgen propiedad del FAI. Es uno de los pocos lugares donde el acceso a motor está prohibido.</p>
      </div>
      <div>
        <p class="font-bold text-slate-900 mb-1">Respeto por el Ambiente</p>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Estás en una Reserva Natural. No abandones residuos y permanece en los senderos señalizados para preservar la rara flora endémica de la zona.</p>
      </div>
    </div>
  </div>

  <!-- La Leyenda de Ulises -->
  <div class="bg-slate-50 p-8 rounded-[2rem] border-l-4 border-med-gold my-8">
    <div class="flex items-start gap-4">
      <svg class="w-6 h-6 text-med-gold flex-shrink-0 mt-1" fill="currentColor" viewBox="0 0 24 24"><path d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
      <div>
        <h3 class="font-bold text-slate-900 mb-2 text-lg">¿Sabías que...?</h3>
        <p class="text-slate-700 leading-relaxed">
          La leyenda cuenta que fue aquí donde Ulises encontró a las Sirenas. Para resistir su canto encantador, se hizo atar al mástil de su nave mientras los compañeros navegaban con los oídos tapados con cera. Cada atardecer desde estos acantilados, parece que aún se escucha ese canto lejano, acariciado por las olas.
        </p>
      </div>
    </div>
  </div>

</BlogPostLayout>
