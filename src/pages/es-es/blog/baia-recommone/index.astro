---
import BlogPostLayout from '../../../../layouts/BlogPostLayout.astro';

const lang = 'es-es';
const post = { title: 'Baia di Recommone', subtitle: 'El Refugio Secreto entre Nerano y Crapolla', category: 'DESCUBRIMIENTOS', date: '20 de Mayo de 2026', readTime: '10 min', image: '/images/baia-recommone-hero.jpg', imageAlt: 'Baia di Recommone con torre y playa', path: '/es-es/blog/baia-recommone/' };
const metaTitle = 'Baia di Recommone: El Refugio Secreto entre Nerano y Crapolla';
const metaDescription = 'Descubre Baia di Recommone, la playa secreta entre Marina del Cantone y Fiordo di Crapolla. Torre aragonesa, agua cristalina y snorkel: una joya oculta de la Costa Amalfitana.';
const breadcrumbs = [
  { name: 'Inicio', url: '/es-es/' },
  { name: 'Blog', url: '/es-es/blog/' },
  { name: 'Baia di Recommone', url: '/es-es/blog/baia-recommone/' },
];
const quickInfo = [
  { label: 'Salida', value: 'Marina del Cantone / Nerano' },
  { label: 'Duración', value: '15–20 min' },
  { label: 'Dificultad', value: 'Fácil' },
  { label: 'Tipo de playa', value: 'Parcialmente libre, parcialmente equipada' },
  { label: 'Acceso', value: 'A pie o taxi acuático' },
];
const faq = [
  {
    q: '¿Cómo llego a Baia di Recommone?',
    a: 'Desde Marina del Cantone en Nerano, un sendero corto de 15–20 minutos en terreno fácil. Alternativamente, por taxi acuático directo.'
  },
  {
    q: '¿Es una playa libre?',
    a: 'Baia di Recommone es parcialmente libre (hacia la roca) y parcialmente equipada (con el restaurante Conca del Sogno). Ambos accesos son públicos.'
  },
  {
    q: '¿Puedo practicar snorkel?',
    a: 'Sí, el agua es cristalina y rica en vida marina (peces, pulpos, estrellas de mar). Es uno de los mejores lugares de snorkel de la Costa Amalfitana.'
  },
  {
    q: '¿Hay una fuente de agua dulce?',
    a: 'No, pero el restaurante Conca del Sogno ofrece agua (si consumes). Recomendamos llevar al menos 1L de agua desde Nerano.'
  },
  {
    q: '¿Cuál es la mejor época para visitarla?',
    a: 'Mayo–septiembre. Junio es ideal: sol perfecto y aún no muy concurrida. Julio-agosto es hermosa pero llena de turistas.'
  },
];
const sidebarLinks = [
  { label: 'Costa Amalfitana', href: '/es-es/costa-amalfitana/' },
  { label: 'Marina del Cantone', href: '/es-es/playas/peninsula-sorrentina/marina-del-cantone/' },
  { label: 'Fiordo de Crapolla', href: '/es-es/blog/fiordo-di-crapolla/' },
  { label: 'Punta Campanella', href: '/es-es/blog/punta-campanella/' },
];
const authorRole = 'Especialista en Viajes y Experto Costero';
const relatedArticles = [
  { title: 'Fiordo de Crapolla: El Tesoro Escondido de los 700 Escalones', href: '/es-es/blog/fiordo-di-crapolla/', category: 'DESCUBRIMIENTOS', image: '/images/fiordo-crapolla-hero.jpg' },
  { title: 'Punta Campanella: Donde la Leyenda Encuentra la Naturaleza', href: '/es-es/blog/punta-campanella/', category: 'DESCUBRIMIENTOS', image: '/images/punta-campanella-hero.jpg' },
  { title: 'Senderismo & Sendero de los Dioses', href: '/es-es/experiencias/trekking/', category: 'EXPERIENCIAS', image: '/images/trekking-hero.jpg' },
];
const keyTakeaways = [
  'Baia di Recommone es la joya escondida entre Nerano y Crapolla: 15 minutos a pie desde Marina del Cantone, completamente aislada del turismo masivo.',
  'El agua es extraordinariamente transparente y rica en vida marina, lo que la convierte en uno de los mejores lugares de snorkel de la Costa Amalfitana.',
  'La Torre de Recommone (siglo XV) domina la bahía y ofrece vistas espectaculares del Archipiélago de los Galli.',
  'Doble acceso: playa libre hacia la roca o restaurante Conca del Sogno con tumbona y servicios.',
  'Perfecta para quienes buscan tranquilidad, snorkel y paisajes salvajes, sin multitudes de turistas.'
];
const videoSchema = {
  "@context": "https://schema.org",
  "@type": "VideoObject",
  "name": "Baia di Recommone: El Refugio Secreto entre Nerano y Crapolla",
  "description": "Descubre Baia di Recommone, la playa secreta entre Marina del Cantone y Fiordo di Crapolla. Agua cristalina, torre aragonesa y snorkel espectacular.",
  "thumbnailUrl": "/images/baia-recommone-hero.jpg",
  "uploadDate": "2026-05-20",
  "duration": "PT2M15S",
  "contentUrl": "/videos/baia-recommone-video.mp4",
  "videoDetails": {
    "width": "1280",
    "height": "720"
  }
};
---

<BlogPostLayout lang={lang} post={post} metaTitle={metaTitle} metaDescription={metaDescription} breadcrumbs={breadcrumbs} quickInfo={quickInfo} faq={faq} sidebarLinks={sidebarLinks} authorRole={authorRole} relatedArticles={relatedArticles} schema={[videoSchema]} pageKey="baia-recommone">

  <div class="space-y-6">
    <p class="text-lg text-slate-700 leading-relaxed">
      Entre <a href="/es-es/playas/peninsula-sorrentina/marina-del-cantone/" class="text-med-blue hover:underline">Marina del Cantone</a> (Nerano) y el <a href="/es-es/blog/fiordo-di-crapolla/" class="text-med-blue hover:underline">Fiordo di Crapolla</a> existe una bahía que parece robada a la geografía: una media luna de arena y roca donde el agua es tan transparente que ves los peces como en un acuario. Se llama Baia di Recommone, y es el refugio secreto que los viajeros inteligentes de la Costa Amalfitana guardan celosamente. No es la más fácil de alcanzar (pero tampoco complicada), y está parcialmente equipada con un restaurante exclusivo. Por eso motivo, sigue siendo milagrosamente tranquila incluso en agosto.
    </p>
  </div>

  <div class="rounded-[2rem] shadow-xl mb-8 flex justify-center bg-slate-900 py-4">
    <video controls poster="/images/baia-recommone-hero.jpg" class="max-w-full max-h-[500px]" width="1280" height="720">
      <source src="/videos/baia-recommone-video.mp4?v=2" type="video/mp4" />
      Tu navegador no admite la etiqueta de video. Por favor, actualiza tu navegador para ver el video.
    </video>
    <script>
      const video = document.getElementById("disable-audio");
      if (!video) video = document.querySelector('video');
      if (video) {
        const forceMuted = () => {
          video.muted = true;
          video.volume = 0;
        };
        forceMuted();
        video.addEventListener('play', forceMuted);
        video.addEventListener('playing', forceMuted);
        video.addEventListener('volumechange', forceMuted);
        video.addEventListener('timeupdate', forceMuted);
        video.addEventListener('seeked', forceMuted);
      }
    </script>
  </div>

  <section class="space-y-6">
    <h2 class="font-serif text-3xl font-bold text-slate-900">El Sendero Panorámico: De Nerano a Recommone</h2>

    <p class="text-slate-700 leading-relaxed">
      La verdadera magia de Baia di Recommone comienza con el sendero que la conecta con Marina del Cantone. Es un camino de apenas 15–20 minutos, casi siempre en descenso, con vistas al mar que aumentan con cada paso. El sendero está bien señalizado y es muy fácil: perfecto para quienes no disfrutan las caminatas agotadoras, pero quieren vivir la experiencia de una playa salvaje.
    </p>

    <h3 class="font-serif text-2xl font-bold text-slate-900">Torre de Recommone: La Guardia Aragonesa de los Galli</h3>
    <p class="text-slate-700 leading-relaxed">
      Dominando la bahía se alza la Torre de Recommone, un ejemplo perfecto de arquitectura defensiva del siglo XV. Construida por los Aragoneses para proteger la costa de los ataques de piratas berberiscos, hoy es un monumento silencioso que vela sobre el Archipiélago de los Galli. Desde su base, las vistas son espectaculares: los Faraglioni de Li Galli se destacan en el horizonte, mientras que la costa de la Costiera desaparece a lo lejos. Es uno de esos momentos en que entiendes por qué los antiguos construían fortalezas en estos lugares.
    </p>

    <h3 class="font-serif text-2xl font-bold text-slate-900">La Gruta de los Pescadores: Refugio Natural y Almacén de Barcas</h3>
    <p class="text-slate-700 leading-relaxed">
      Escondida entre las rocas de la bahía hay una gruta natural que durante siglos fue utilizada por los pescadores locales como refugio y almacén de barcas. Hoy es un espacio público, un refugio natural donde descansar a la sombra durante las horas más calurosas del día. El agua alrededor de la gruta es particularmente rica en vida marina, lo que la convierte en un oasis perfecto para el snorkel.
    </p>
  </section>

  <section class="space-y-6">
    <h2 class="font-serif text-3xl font-bold text-slate-900">Un Mar Digno de un Oscar</h2>

    <p class="text-slate-700 leading-relaxed">
      Si existe un parámetro que define la calidad de una playa mediterránea, es la transparencia del agua. Baia di Recommone es uno de los pocos lugares de la <a href="/es-es/costa-amalfitana/" class="text-med-blue hover:underline">Costa Amalfitana</a> donde puedes ver el fondo a 3–4 metros de profundidad. El agua es tan cristalina que el primer impacto es casi abrumador. La bahía está naturalmente protegida de las olas gracias a la conformación de la roca, lo que significa que está tranquila incluso cuando el mar afuera está agitado.
    </p>

    <p class="text-slate-700 leading-relaxed">
      Para los amantes del snorkel, esto es una especie de paraíso terrenal. A pocos metros de la orilla nadan peces de varios tamaños, pulpos curiosos que salen de sus guaridas, estrellas de mar naranjas y violetas. No es raro ver algún morrena (siempre pacíficas) o erizos de mar. Es un snorkel íntimo y seguro, perfecto para principiantes y familias.
    </p>
  </section>

  <section class="space-y-6">
    <h2 class="font-serif text-3xl font-bold text-slate-900">Información Técnica</h2>

    <div class="overflow-x-auto">
      <table class="w-full border-collapse border border-slate-300">
        <tbody>
          <tr class="bg-slate-50">
            <td class="border border-slate-300 px-4 py-2 font-semibold text-slate-900">Salida</td>
            <td class="border border-slate-300 px-4 py-2 text-slate-700">Marina del Cantone / Nerano (vía sendero o taxi acuático)</td>
          </tr>
          <tr>
            <td class="border border-slate-300 px-4 py-2 font-semibold text-slate-900">Duración</td>
            <td class="border border-slate-300 px-4 py-2 text-slate-700">15–20 minutos (a pie)</td>
          </tr>
          <tr class="bg-slate-50">
            <td class="border border-slate-300 px-4 py-2 font-semibold text-slate-900">Dificultad</td>
            <td class="border border-slate-300 px-4 py-2 text-slate-700">Fácil</td>
          </tr>
          <tr>
            <td class="border border-slate-300 px-4 py-2 font-semibold text-slate-900">Tipo de playa</td>
            <td class="border border-slate-300 px-4 py-2 text-slate-700">Playa salvaje (sección libre), Conca del Sogno (sección equipada con restaurante)</td>
          </tr>
          <tr class="bg-slate-50">
            <td class="border border-slate-300 px-4 py-2 font-semibold text-slate-900">Acceso al agua</td>
            <td class="border border-slate-300 px-4 py-2 text-slate-700">A pie (sendero) o taxi acuático desde Marina del Cantone</td>
          </tr>
          <tr>
            <td class="border border-slate-300 px-4 py-2 font-semibold text-slate-900">Servicios</td>
            <td class="border border-slate-300 px-4 py-2 text-slate-700">Restaurante Conca del Sogno (para tumbonas y comida), de lo contrario total libertad</td>
          </tr>
          <tr class="bg-slate-50">
            <td class="border border-slate-300 px-4 py-2 font-semibold text-slate-900">Mejor época</td>
            <td class="border border-slate-300 px-4 py-2 text-slate-700">Mayo–septiembre; ideal junio (sol perfecto, aún tranquila)</td>
          </tr>
        </tbody>
      </table>
    </div>
  </section>

  <section class="space-y-6">
    <h2 class="font-serif text-3xl font-bold text-slate-900">Consejos del Experto</h2>

    <div class="space-y-4">
      <div class="border-l-4 border-med-gold bg-yellow-50 p-4 rounded-r-lg">
        <h4 class="font-semibold text-slate-900 mb-2">Elige tu acceso según el ambiente que quieras</h4>
        <p class="text-slate-700 text-sm">¿Quieres playa salvaje? Accede desde el lado de la roca (completamente libre). ¿Quieres comodidad y comida? El restaurante Conca del Sogno ofrece tumbonas, sombrillas y cocina (se recomienda reserva). Ambos accesos se cruzan, así que puedes combinarlos.</p>
      </div>

      <div class="border-l-4 border-med-blue bg-charcoal p-4 rounded-r-lg">
        <h4 class="font-semibold text-white mb-2">Toma un taxi acuático si no quieres caminar</h4>
        <p class="text-white/80 text-sm">Si el sendero no te atrae, Marina del Cantone tiene taxis acuáticos que salen directamente hacia Recommone. Cuesta ~€10–15 por persona, pero te ahorras la caminata y puedes llevar más equipaje.</p>
      </div>

      <div class="border-l-4 border-med-gold bg-yellow-50 p-4 rounded-r-lg">
        <h4 class="font-semibold text-slate-900 mb-2">Planifica el sol: la mañana es mejor</h4>
        <p class="text-slate-700 text-sm">Baia di Recommone recibe sol directo aproximadamente de 9:00 a 15:30. Después de las 15:30, la sombra de la roca cubre gran parte de la playa. Consejo: llega entre las 10:00 y las 11:00 para maximizar el tiempo de sol.</p>
      </div>

      <div class="border-l-4 border-med-blue bg-charcoal p-4 rounded-r-lg">
        <h4 class="font-semibold text-white mb-2">Lleva equipo de snorkel</h4>
        <p class="text-white/80 text-sm">Incluso solo un par de aletas y una máscara marcan la diferencia. Para una experiencia completa, lleva también un tubo y una cámara subacuática (el snorkel aquí es realmente espectacular).</p>
      </div>
    </div>
  </section>

  <section class="bg-slate-50 rounded-lg p-6 space-y-4">
    <h3 class="font-serif text-2xl font-bold text-slate-900">Puntos Clave</h3>
    <ul class="space-y-2">
      {keyTakeaways.map((item) => (
        <li class="flex items-start gap-3">
          <span class="text-med-gold font-bold text-xl flex-shrink-0">→</span>
          <span class="text-slate-700">{item}</span>
        </li>
      ))}
    </ul>
  </section>

</BlogPostLayout>
