---
import BlogPostLayout from '../../../../layouts/BlogPostLayout.astro';

const lang = 'es-es';
const post = {
  title: 'Spaghetti alla Nerano',
  subtitle: "La pasta con calabacín frito nacida en una bahía diminuta en 1952, y dónde comer el original hoy",
  category: 'GASTRONOMÍA',
  date: '17 de agosto de 2026',
  readTime: '8 min',
  image: '/images/nerano-hero.webp',
  imageAlt: 'Spaghetti alla Nerano, la pasta con calabacín frito de Marina del Cantone',
  path: '/es-es/blog/spaghetti-alla-nerano/',
};

const metaTitle = 'Spaghetti alla Nerano: dónde comer el original | Guía 2026';
const metaDescription = 'El plato nació en Nerano en 1952 en el Ristorante Maria Grazia. Dónde comerlo en Marina del Cantone, cómo llegar a la bahía desde Sorrento en bus SITA o en barco, y qué lo distingue de una pasta con calabacín cualquiera.';

const breadcrumbs = [
  { name: 'Inicio', url: '/es-es/' },
  { name: 'Blog', url: '/es-es/blog/' },
  { name: 'Spaghetti alla Nerano', url: '/es-es/blog/spaghetti-alla-nerano/' },
];

const quickInfo = [
  { label: 'Plato', value: 'Espaguetis con calabacín frito y queso' },
  { label: 'Nació en', value: 'Nerano, Marina del Cantone (1952)' },
  { label: 'Creado por', value: 'Donna Rosa, Ristorante Maria Grazia' },
  { label: 'Dónde', value: 'Massa Lubrense, península sorrentina' },
  { label: 'Queso', value: 'Provolone del Monaco DOP o caciotta local' },
  { label: 'Desde Sorrento', value: 'Unos 50 min en bus SITA' },
  { label: 'Reserva', value: 'Imprescindible en julio y agosto' },
  { label: 'Mejor temporada', value: 'De junio a septiembre, por el calabacín' },
];

const faq = [
  {
    q: '¿Dónde se inventaron los Spaghetti alla Nerano?',
    a: 'En el Ristorante Maria Grazia de Marina del Cantone, la pequeña bahía bajo el pueblo de Nerano, en el municipio de Massa Lubrense. El plato nació en 1952 de manos de Donna Rosa, y el restaurante, abierto en 1901, sigue en manos de sus descendientes.',
  },
  {
    q: '¿Dónde conviene comerlos en Nerano?',
    a: "Maria Grazia es la casa original, el motivo por el que el plato lleva el nombre del pueblo. L'Africano, el balneario más antiguo de la bahía, abierto en 1958 y todavía en manos de la familia Caputo, es la otra dirección que te señalan los del pueblo. Están a pocos minutos a pie.",
  },
  {
    q: '¿Cómo se llega a Nerano desde Sorrento?',
    a: 'En bus SITA desde la estación de Sorrento, unos 50 minutos, a veces con transbordo en Sant Agata sui Due Golfi. En coche son unos 30 minutos, pero el aparcamiento en Marina del Cantone es limitado y de pago en verano. Muchos llegan por mar desde Sorrento, Positano o Capri.',
  },
  {
    q: '¿Qué queso llevan los Spaghetti alla Nerano?',
    a: 'La elección tradicional es el Provolone del Monaco DOP, el queso de vaca curado de la península sorrentina, a veces combinado con una caciotta local o sustituido por ella. El queso es lo que da cuerpo a la salsa: en la versión original no hay nata.',
  },
  {
    q: '¿En qué se diferencian de una pasta con calabacín normal?',
    a: 'En dos cosas. El calabacín se fríe aparte y se deja reposar, así se ablanda y concentra en lugar de cocerse al vapor. Después la salsa se liga fuera del fuego, emulsionando el queso rallado con el agua de cocción rica en almidón, lo que produce una capa brillante en lugar de un fondo aguado.',
  },
  {
    q: '¿Hace falta reservar?',
    a: 'Sí, en temporada alta. Marina del Cantone es una bahía pequeñísima con un puñado de restaurantes y recibe a la vez llegadas por carretera y por mar. Para julio y agosto conviene reservar con mucha antelación, sobre todo para una mesa al mediodía.',
  },
];

const sidebarLinks = [
  { label: 'Marina del Cantone', href: '/es-es/playas/peninsula-sorrentina/marina-del-cantone/' },
  { label: 'Massa Lubrense', href: '/es-es/peninsula-sorrentina/massa-lubrense/' },
  { label: 'Baia di Recommone', href: '/es-es/blog/baia-recommone/' },
  { label: 'Bus SITA', href: '/es-es/guia/bus-sita/' },
  { label: 'Punta Campanella', href: '/es-es/blog/punta-campanella/' },
];

const authorRole = 'Experto Local · Costa Amalfitana';

const relatedArticles = [
  {
    title: 'Las Anchoas de Cetara: El Oro Plateado de la Costa Amalfitana',
    category: 'GASTRONOMÍA',
    date: '4 de abril de 2026',
    image: '/images/alici-cetara-hero.webp',
    imageAlt: 'Las anchoas de Cetara y la Colatura DOP - Costa Amalfitana',
    path: '/es-es/blog/anchoas-cetara/'
  },
  {
    title: 'Los Scialatielli: La Pasta de la Costa Amalfitana',
    category: 'GASTRONOMÍA',
    date: '27 de mayo de 2026',
    image: '/images/scialatielli-hero.webp',
    imageAlt: 'Los scialatielli, la pasta fresca de la Costa Amalfitana',
    path: '/es-es/blog/scialatielli/'
  }
];

const keyTakeaways = [
  'Los Spaghetti alla Nerano nacieron en 1952 de manos de Donna Rosa en el Ristorante Maria Grazia, en la bahía de Marina del Cantone bajo el pueblo de Nerano.',
  'El pueblo pertenece a Massa Lubrense, en la península sorrentina, y no a la costa amalfitana propiamente dicha: por eso tantos visitantes nunca llegan.',
  'La salsa se sostiene sobre calabacín frito y queso rallado emulsionado con el agua de cocción. En la receta original no hay nata.',
  "Maria Grazia es la cuna del plato; L'Africano, primer balneario de la bahía, abierto en 1958 y bautizado con el apodo de su fundador, es la otra dirección que merece el viaje.",
  'Desde Sorrento son unos 50 minutos de bus SITA, y en julio y agosto reservar para comer es imprescindible.',
];
---

<BlogPostLayout
  lang={lang}
  post={post}
  metaTitle={metaTitle}
  metaDescription={metaDescription}
  breadcrumbs={breadcrumbs}
  quickInfo={quickInfo}
  faq={faq}
  sidebarLinks={sidebarLinks}
  authorRole={authorRole}
  relatedArticles={relatedArticles}
  pageKey="spaghetti-alla-nerano"
>

  <!-- Key Takeaways -->
  <div class="bg-slate-900 text-white p-8 rounded-[2rem]">
    <div class="flex items-center gap-3 mb-6">
      <svg class="w-5 h-5 text-med-gold flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
      <h2 class="font-serif text-lg font-bold text-med-gold uppercase tracking-[0.15em]">Key Takeaways</h2>
    </div>
    <ul class="space-y-4">
      {keyTakeaways.map((point) => (
        <li class="flex items-start gap-3">
          <span class="w-1.5 h-1.5 rounded-full bg-med-gold flex-shrink-0 mt-2"></span>
          <span class="text-white/80 text-xs sm:text-sm leading-relaxed">{point}</span>
        </li>
      ))}
    </ul>
  </div>

  <!-- Intro -->
  <div>
    <p class="text-slate-600 text-xl leading-relaxed mb-6 font-light">
      Casi todos los platos italianos célebres llevan el nombre de una ciudad. Este lleva el de una aldea de unos pocos cientos de habitantes, escondida en la punta extrema de la península sorrentina. Nerano se asoma sobre una bahía llamada <a href="/es-es/playas/peninsula-sorrentina/marina-del-cantone/" class="text-med-blue hover:underline">Marina del Cantone</a>, frente a Capri, y la pasta que lleva su nombre se inventó allí, en una sola cocina, una noche de 1952. Hoy la sirve casi cualquier restaurante entre Nápoles y Salerno. Un único sitio puede reclamar el original.
    </p>
  </div>

  <!-- Origin -->
  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">Nerano, 1952: cómo nació el plato</h2>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      La cocina era la del <strong>Ristorante Maria Grazia</strong>, un negocio familiar abierto en 1901 en la playa de Marina del Cantone. Cocinaba Donna Rosa, y el plato que armó en 1952 usaba lo que podían dar la huerta y la quesería del lugar: calabacín, queso, albahaca, aceite de oliva. Nada que hubiera que traer de fuera, algo que en una carretera tan empinada pesaba bastante.
    </p>
    <p class="text-slate-600 text-lg leading-relaxed mb-8">
      El restaurante sigue en manos de sus descendientes, y la familia siempre se ha guardado el ligado final de la salsa. Esa reticencia forma parte de la leyenda, pero el motivo real de que el plato viajara es más simple: la bahía se convirtió en fondeadero para las barcas que llegaban de Capri y de <a href="/es-es/costa-amalfitana/positano/" class="text-med-blue hover:underline">Positano</a>, y quienes bajaban de ellas se llevaban el nombre a casa.
    </p>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div class="bg-white p-6 rounded-[2rem] border border-slate-100 shadow-sm">
        <h4 class="font-bold text-slate-900 mb-2">Una aldea, no un pueblo</h4>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Nerano es una frazione de <a href="/es-es/peninsula-sorrentina/massa-lubrense/" class="text-med-blue hover:underline">Massa Lubrense</a>, que reúne diecisiete de ellas repartidas por el promontorio. No tiene centro en el sentido habitual: hay una plaza y una carretera que baja al mar.</p>
      </div>
      <div class="bg-white p-6 rounded-[2rem] border border-slate-100 shadow-sm">
        <h4 class="font-bold text-slate-900 mb-2">No es la costa amalfitana</h4>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">La bahía mira al golfo de Salerno pero pertenece administrativamente a la península sorrentina. Quien busca solo a lo largo de la carretera amalfitana no llega nunca, y justo por eso ha seguido siendo pequeña.</p>
      </div>
    </div>
  </div>

  <!-- Where to eat -->
  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">Dónde comer los Spaghetti alla Nerano en Nerano</h2>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      Las dos direcciones que importan están en el mismo tramo corto de playa, a pocos minutos a pie una de otra. Son experiencias muy distintas, y la elección depende de verdad de lo que busques.
    </p>

    <div class="overflow-hidden rounded-[2rem] border border-slate-100 shadow-sm">
      <table class="w-full text-xs sm:text-xs sm:text-sm">
        <thead class="bg-slate-900 text-white">
          <tr>
            <th class="text-left p-5 font-serif font-bold text-med-gold">Restaurante</th>
            <th class="text-left p-5 font-serif font-bold text-med-gold">Qué saber</th>
          </tr>
        </thead>
        <tbody class="bg-white">
          <tr class="border-b border-slate-100">
            <td class="p-5 font-bold">Maria Grazia</td>
            <td class="p-5 text-slate-600">La cuna. Abierto desde 1901, todavía en la familia, y el motivo de que el plato se llame alla Nerano. Se viene por la versión de la que desciende la receta, más que por las vistas.</td>
          </tr>
          <tr class="border-b border-slate-100">
            <td class="p-5 font-bold">L'Africano</td>
            <td class="p-5 text-slate-600">El primer balneario que abrió en la bahía, en 1958, fundado por Edoardo Caputo y todavía llevado por sus hijos. El nombre viene del moreno que se ganó en una vida pasada sobre el agua. Una terraza pequeña sobre el mar, Dora en la cocina, y una versión del plato que en el pueblo ponen junto a la original.</td>
          </tr>
          <tr>
            <td class="p-5 font-bold">En todas partes</td>
            <td class="p-5 text-slate-600">Encontrarás el plato en las cartas de ambas costas. Tómalas como interpretaciones. Si una cocina lo sirve con nata, no está siguiendo el método de Nerano.</td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>

  <!-- Getting there -->
  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">Cómo llegar a Nerano y a Marina del Cantone</h2>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      La bahía está a unos 30 minutos de Sorrento por carretera, pero la carretera es estrecha y el último tramo baja en picado hasta el mar. Elige el medio antes de salir, no sobre la marcha.
    </p>

    <div class="bg-white p-8 rounded-[2rem] border border-slate-100 shadow-sm">
      <h3 class="font-serif text-xl font-bold text-slate-900 mb-5">Tres formas de bajar a la bahía</h3>
      <div class="space-y-3">
        <div class="flex items-start gap-3">
          <div class="w-6 h-6 rounded-full bg-med-gold/15 flex-shrink-0 flex items-center justify-center text-med-gold font-bold text-xs">1</div>
          <p class="text-slate-600 text-xs sm:text-sm leading-relaxed"><strong>En <a href="/es-es/guia/bus-sita/" class="text-med-blue hover:underline">bus SITA</a></strong> desde la estación de Sorrento, unos 50 minutos. Algunas salidas obligan a transbordar en Sant Agata sui Due Golfi, así que comprueba el horario del servicio directo a Nerano.</p>
        </div>
        <div class="flex items-start gap-3">
          <div class="w-6 h-6 rounded-full bg-med-gold/15 flex-shrink-0 flex items-center justify-center text-med-gold font-bold text-xs">2</div>
          <p class="text-slate-600 text-xs sm:text-sm leading-relaxed"><strong>En coche</strong>, unos 30 minutos desde Sorrento pasando por Massa Lubrense. El aparcamiento en Marina del Cantone es limitado y de pago, y en agosto se llena a media mañana.</p>
        </div>
        <div class="flex items-start gap-3">
          <div class="w-6 h-6 rounded-full bg-med-gold/15 flex-shrink-0 flex items-center justify-center text-med-gold font-bold text-xs">3</div>
          <p class="text-slate-600 text-xs sm:text-sm leading-relaxed"><strong>Por mar</strong> desde Sorrento, Positano o Capri. Es como llega la mayoría en verano, y varios restaurantes tienen amarre propio.</p>
        </div>
      </div>
    </div>
  </div>

  <!-- The technique -->
  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">Qué los distingue de una pasta con calabacín normal</h2>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      La lista de ingredientes es casi vergonzosamente corta, así que todo se juega en el método. Dos pasos separan el plato de verdad de unos espaguetis con calabacín cualesquiera.
    </p>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      Primero, el calabacín se <strong>fríe aparte y se deja reposar</strong>, a menudo durante horas. Se deshace y se endulza en lugar de cocerse al vapor, y el aceite que suelta lleva su sabor hasta la salsa final. Segundo, la salsa se termina fuera del fuego: el queso rallado, tradicionalmente <strong>Provolone del Monaco DOP</strong> de la península o una caciotta local, se emulsiona con el agua de cocción rica en almidón hasta que envuelve en vez de depositarse.
    </p>

    <blockquote class="border-l-4 border-med-gold pl-6 my-8">
      <p class="text-slate-700 text-xl font-serif italic leading-relaxed">
        "En los Spaghetti alla Nerano no hay nata. Lo que parece nata es queso, agua y paciencia."
      </p>
    </blockquote>
  </div>

  <!-- Local Tips -->
  <div class="bg-white p-8 rounded-[2rem] shadow-xl border border-slate-100">
    <div class="flex items-center gap-4 mb-6">
      <svg class="w-6 h-6 text-med-gold flex-shrink-0" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M9 18h6"/><path d="M10 22h4"/><path d="M15.09 14c.18-.98.65-1.74 1.41-2.5A4.65 4.65 0 0 0 18 8 6 6 0 0 0 6 8c0 1 .23 2.23 1.5 3.5A4.61 4.61 0 0 1 8.91 14"/></svg>
      <h3 class="text-xl font-bold">Consejos de Experto</h3>
    </div>
    <div class="space-y-6">
      <div>
        <p class="font-bold text-slate-900 mb-1">Reserva antes de viajar, no al llegar</p>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Marina del Cantone tiene apenas un puñado de restaurantes y recibe a la vez llegadas por carretera y por mar. En julio y agosto las mesas del mediodía en las dos casas históricas se agotan con meses de antelación.</p>
      </div>
      <div>
        <p class="font-bold text-slate-900 mb-1">Ve en temporada de calabacín</p>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">El plato depende por completo de la calidad de la verdura, así que da lo mejor de junio a septiembre. Fuera de temporada te lo servirán igual, pero con producto que no ha crecido en el promontorio.</p>
      </div>
      <div>
        <p class="font-bold text-slate-900 mb-1">Dedica a la bahía un día entero</p>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">La comida pide un baño. <a href="/es-es/blog/baia-recommone/" class="text-med-blue hover:underline">Baia di Recommone</a> es la cala siguiente, y el sendero a la Baia di Ieranto sale de la plaza de Nerano y avanza hacia <a href="/es-es/blog/punta-campanella/" class="text-med-blue hover:underline">Punta Campanella</a>, con Capri delante todo el camino.</p>
      </div>
    </div>
  </div>

</BlogPostLayout>
