---
import BlogPostLayout from '../../../../layouts/BlogPostLayout.astro';

const lang = 'es-es';
const post = {
  title: 'Sorrento o Amalfi',
  subtitle: 'Cómo elegir tu base: guía 2026',
  category: 'GUÍAS',
  date: '8 de junio de 2026',
  readTime: '11 min',
  image: '/images/sorrento-vs-amalfi-hero.webp',
  imageAlt: 'Sorrento y Amalfi: cómo elegir la base perfecta para tu viaje',
  path: '/es-es/blog/sorrento-vs-amalfi/',
};

const metaTitle = 'Sorrento o Amalfi 2026: ¿La Mejor Base para tu Viaje? | Guía Honesta';
const metaDescription = 'Sorrento o Amalfi como base 2026: comparación completa para luna de miel, familia, grupo grande. Pompeya, Capri, Ravello: dónde alojarse para las excursiones que realmente quieres.';

const breadcrumbs = [
  { name: 'Inicio', url: '/es-es/' },
  { name: 'Blog', url: '/es-es/blog/' },
  { name: 'Sorrento o Amalfi', url: '/es-es/blog/sorrento-vs-amalfi/' },
];

const quickInfo = [
  { label: 'Distancia', value: '35 km por la SS163' },
  { label: 'Tiempo de viaje', value: '~1h30 bus SITA o 1h ferry' },
  { label: 'Sorrento', value: '~16.000 habitantes · Golfo de Nápoles' },
  { label: 'Amalfi', value: '~5.000 habitantes · centro Costa Amalfitana' },
  { label: 'Más cerca de Pompeya', value: 'Sorrento (30 min en tren)' },
  { label: 'Más cerca de Ravello', value: 'Amalfi (25 min en bus)' },
];

const faq = [
  {
    q: '¿Sorrento o Amalfi como base para primera visita?',
    a: "Sorrento, si quieres Pompeya y Capri fácilmente. Sorrento tiene tren directo a Pompeya (30 min) y el ferry más rápido a Capri (20 min). Amalfi es el corazón geográfico de la Costa Amalfitana: mejor para Ravello, Minori, Maiori y Gruta Esmeralda. Para un primer viaje a Italia de 7 días con Pompeya en la lista, elige Sorrento. Para vacaciones puras de Costa, elige Amalfi.",
  },
  {
    q: '¿Sorrento o Amalfi para familias grandes o grupos?',
    a: "Sorrento, fácilmente. Ciudad más grande, más apartamentos y villas de 4-5 dormitorios, supermercados grandes (Conad, Coop), restaurantes que aceptan grupos de 8-12 sin reserva, traslado más fácil desde el aeropuerto de Nápoles (coche privado o bus Curreri). Amalfi tiene menos alquileres grandes y capacidad de restaurantes más justa.",
  },
  {
    q: '¿Sorrento o Amalfi para luna de miel?',
    a: "Ninguna idealmente: la elección de luna de miel es Positano. Pero si toca elegir, Amalfi es más romántica. La escalinata de la catedral medieval de noche, las terrazas del Hotel Santa Caterina o Belmond Caruso, el barco a Capri al atardecer. Sorrento es demasiado de ciudad de trabajo. Si tu pareja específicamente quiere mañanas románticas en Pompeya + Capri, Sorrento funciona.",
  },
  {
    q: '¿Sorrento o Amalfi: cuál es más barata?',
    a: "Sorrento es 20-30% más barata. Sorrento 3★: €120-180/noche. Amalfi 3★: €150-220/noche. Restaurantes similares (Amalfi ligeramente más alto). El gran ahorro de Sorrento son los traslados: los billetes de tren cuestan menos que la misma distancia en ferry, y el aeropuerto de Nápoles no necesita taxi.",
  },
  {
    q: '¿Sorrento o Amalfi para excursión a Pompeya?',
    a: "Sorrento gana decisivamente. Tren de 30 minutos (Circumvesuviana o Campania Express) directamente a la estación Pompei Scavi, cada 30 min, €2,20 billete. Desde Amalfi a Pompeya: bus SITA a Salerno (1h10) + tren regional Salerno-Pompei (45 min) = 2h+ cada trayecto. Pompeya es una excursión desde Sorrento, no desde Amalfi.",
  },
  {
    q: '¿Sorrento o Amalfi para excursión a Ravello?',
    a: "Amalfi gana decisivamente. Ravello está directamente sobre Amalfi: bus SITA cada 30 min, 25 min, €2,40. Desde Sorrento a Ravello: bus SITA Sorrento-Amalfi (1h30) + bus Amalfi-Ravello (25 min) = 2h cada trayecto. Si tienes Ravello Festival en tus planes, te quedas en Amalfi.",
  },
  {
    q: '¿Sorrento o Amalfi para excursión a Capri?',
    a: "Sorrento. Ferry más rápido: Sorrento → Capri 20-25 min, todo el año, cada hora. Amalfi → Capri: 1h, solo estacional (abril-octubre). Coste similar (~€20 ida). Si Capri es imprescindible, base en Sorrento.",
  },
];

const sidebarLinks = [
  { label: 'Guía Sorrento', href: '/es-es/peninsula-sorrentina/sorrento/' },
  { label: 'Guía Amalfi', href: '/es-es/costa-amalfitana/amalfi/' },
  { label: 'Guía Ravello', href: '/es-es/costa-amalfitana/ravello/' },
  { label: 'Bus SITA', href: '/es-es/guia/bus-sita/' },
  { label: 'Ferries', href: '/es-es/guia/ferries/' },
  { label: 'Sorrento o Positano', href: '/es-es/blog/sorrento-vs-positano/' },
];

const authorRole = 'Experto logística de viajes · Costa Amalfitana';

const relatedArticles = [
  {
    title: 'Positano o Amalfi',
    category: 'GUÍAS',
    date: '11 de junio de 2026',
    image: '/images/positano-vs-amalfi-hero.webp',
    imageAlt: 'Positano y Amalfi: comparación',
    path: '/es-es/blog/positano-vs-amalfi/',
  },
  {
    title: 'Maiori o Minori',
    category: 'GUÍAS',
    date: '23 de junio de 2026',
    image: '/images/maiori-vs-minori-hero.webp',
    imageAlt: 'Maiori y Minori: comparación',
    path: '/es-es/blog/maiori-vs-minori/',
  },
];

const compareSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: 'Sorrento o Amalfi: la mejor base para tu viaje',
  about: [
    { '@type': 'Place', name: 'Sorrento', address: { '@type': 'PostalAddress', addressLocality: 'Sorrento', addressRegion: 'NA', addressCountry: 'IT' } },
    { '@type': 'Place', name: 'Amalfi', address: { '@type': 'PostalAddress', addressLocality: 'Amalfi', addressRegion: 'SA', addressCountry: 'IT' } },
  ],
};
---

<BlogPostLayout
  lang={lang}
  post={post}
  metaTitle={metaTitle}
  metaDescription={metaDescription}
  breadcrumbs={breadcrumbs}
  quickInfo={quickInfo}
  faq={faq}
  sidebarLinks={sidebarLinks}
  authorRole={authorRole}
  relatedArticles={relatedArticles}
  extraSchema={[compareSchema]}
>

  <div>
    <p class="text-slate-600 text-xl leading-relaxed mb-6 font-light">
      <strong>¿Sorrento o Amalfi como base?</strong> Esta es la pregunta para los viajeros que quieren "verlo todo" (Pompeya, Capri, Positano, Ravello) en un solo viaje de 5-7 días. Las dos ciudades están en extremos opuestos de la región y cada una es la puerta de acceso a la mitad de la lista de deseos. La respuesta depende de qué mitad importa más.
    </p>
    <p class="text-slate-600 text-lg leading-relaxed">
      Comprobación rápida antes de empezar: Sorrento técnicamente no está en la <a href="/es-es/costa-amalfitana/" class="text-med-blue hover:underline">Costa Amalfitana</a> (está en la Península Sorrentina, frente al Golfo de Nápoles). Amalfi está en el corazón geográfico e histórico de la Costa. Esa distinción condiciona cada excursión de esta guía.
    </p>
  </div>

  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">Si Pompeya está en tu lista: Sorrento</h2>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      Pompeya es el factor decisivo más importante. <a href="/es-es/peninsula-sorrentina/sorrento/" class="text-med-blue hover:underline">Sorrento</a> está en la línea Circumvesuviana: 30 minutos puerta a puerta hasta la estación Pompei Scavi, cada 30 minutos, €2,20 por trayecto. Puedes salir del hotel a las 8:30 y estar dentro de las ruinas a las 9:30, adelantándote a las multitudes de los tour bus.
    </p>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      Desde Amalfi, Pompeya es una odisea de 2 horas por trayecto (bus a Salerno + tren, o bus a Sorrento + tren). Un "día de Pompeya" desde Amalfi consume 12 horas y llega a las ruinas después de los tour bus. O saltas Pompeya desde Amalfi o tienes base en Sorrento.
    </p>
    <div class="bg-white p-8 rounded-[2rem] border border-slate-100 shadow-sm">
      <h3 class="font-serif text-xl font-bold text-slate-900 mb-4">Matriz de excursiones desde Sorrento</h3>
      <ul class="space-y-4 text-slate-600">
        <li class="flex items-start gap-3">
          <span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span>
          <span class="text-slate-700"><strong>Pompeya:</strong> 30 min tren ⭐</span>
        </li>
        <li class="flex items-start gap-3">
          <span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span>
          <span class="text-slate-700"><strong>Capri:</strong> 20 min ferry ⭐</span>
        </li>
        <li class="flex items-start gap-3">
          <span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span>
          <span class="text-slate-700"><strong>Nápoles (Museo Arqueológico):</strong> 1h15 tren</span>
        </li>
        <li class="flex items-start gap-3">
          <span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span>
          <span class="text-slate-700"><strong>Positano:</strong> 50 min bus / 35 min ferry</span>
        </li>
        <li class="flex items-start gap-3">
          <span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span>
          <span class="text-slate-700"><strong>Herculano:</strong> 50 min tren</span>
        </li>
        <li class="flex items-start gap-3">
          <span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span>
          <span class="text-slate-700"><strong>Monte Vesubio:</strong> 1h30 tren + bus</span>
        </li>
      </ul>
    </div>
  </div>

  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">Si la Costa Amalfitana ES el viaje: Amalfi</h2>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      Si no persigues Pompeya, si el viaje trata específicamente de la Costa Amalfitana, entonces <a href="/es-es/costa-amalfitana/amalfi/" class="text-med-blue hover:underline">Amalfi</a> es la mejor base. Está en el centro de la Costa y es la única ciudad con conexiones frecuentes a todo lo que está al sur de Positano.
    </p>
    <div class="bg-white p-8 rounded-[2rem] border border-slate-100 shadow-sm">
      <h3 class="font-serif text-xl font-bold text-slate-900 mb-4">Matriz de excursiones desde Amalfi</h3>
      <ul class="space-y-4 text-slate-600">
        <li class="flex items-start gap-3">
          <span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span>
          <span class="text-slate-700"><strong>Ravello:</strong> 25 min bus ⭐</span>
        </li>
        <li class="flex items-start gap-3">
          <span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span>
          <span class="text-slate-700"><strong>Positano:</strong> 25 min ferry / 40 min bus</span>
        </li>
        <li class="flex items-start gap-3">
          <span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span>
          <span class="text-slate-700"><strong>Gruta Esmeralda:</strong> 15 min bus</span>
        </li>
        <li class="flex items-start gap-3">
          <span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span>
          <span class="text-slate-700"><strong>Minori y Maiori:</strong> 15-20 min bus</span>
        </li>
        <li class="flex items-start gap-3">
          <span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span>
          <span class="text-slate-700"><strong>Cetara (capital de las anchoas):</strong> 30 min bus</span>
        </li>
        <li class="flex items-start gap-3">
          <span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span>
          <span class="text-slate-700"><strong>Salerno (para trenes al sur):</strong> 35 min ferry</span>
        </li>
        <li class="flex items-start gap-3">
          <span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span>
          <span class="text-slate-700"><strong>Capri:</strong> 1h ferry (estacional)</span>
        </li>
      </ul>
    </div>
    <p class="text-slate-600 text-lg leading-relaxed mt-6">
      Además, Amalfi tiene sus propias atracciones que valen medio día cada una: la catedral normando-árabe, el Museo del Papel, el Arsenal medieval. Desde Sorrento, ninguna de estas es una excursión rápida.
    </p>
  </div>

  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">Para grupos grandes o familias 4+: Sorrento</h2>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      La logística de grupos favorece a Sorrento. La ciudad es notablemente más grande (16.000 habitantes vs 5.000), con más alquileres de villas de 4-5 dormitorios en Airbnb y VRBO, restaurantes que aceptan cómodamente grupos de 8-12 sin reserva y supermercados grandes (Conad Superstore en Corso Italia) que hacen viable cocinar.
    </p>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      Traslado desde aeropuerto de Nápoles: una furgoneta privada de 7 plazas Nápoles → Sorrento cuesta €120-150 y tarda 1 hora. Nápoles → Amalfi cuesta €180-220 y tarda 1h45 mínimo, a menudo 2h+ en verano. Para una familia de 4-6, es una diferencia significativa en ambos extremos del viaje.
    </p>
    <div class="bg-med-cream p-8 rounded-[2rem] border border-med-gold/20">
      <h3 class="font-serif text-xl font-bold text-slate-900 mb-4">Checklist grupo grande/familia</h3>
      <table class="w-full text-sm">
        <tbody class="divide-y divide-med-gold/20">
          <tr><td class="py-2 font-semibold">Apartamentos 5+ dormitorios</td><td class="py-2">Sorrento: muchos · Amalfi: pocos</td></tr>
          <tr><td class="py-2 font-semibold">Supermercado grande</td><td class="py-2">Sorrento ✓ (Conad) · Amalfi (pequeño)</td></tr>
          <tr><td class="py-2 font-semibold">Tiempo traslado aeropuerto</td><td class="py-2">Sorrento 1h · Amalfi 1h45+</td></tr>
          <tr><td class="py-2 font-semibold">Reserva restaurante 10+</td><td class="py-2">Sorrento ✓ · Amalfi limitado</td></tr>
          <tr><td class="py-2 font-semibold">Estación de tren</td><td class="py-2">Sorrento ✓ · Amalfi ninguna</td></tr>
        </tbody>
      </table>
    </div>
  </div>

  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">Para lunas de miel (si no Positano): Amalfi</h2>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      Honestamente: la mayoría de los recién casados elige Positano. Pero si quieres específicamente la Costa Amalfitana y prefieres la profundidad histórica al encanto de postal, Amalfi entrega. Belmond Hotel Caruso (técnicamente en Ravello pero con el ambiente Amalfi), Santa Caterina, Hotel Marina Riviera: el romance aquí es cenas a la luz de velas en una terraza del siglo XII, no casas color pastel.
    </p>
    <p class="text-slate-600 text-lg leading-relaxed">
      Sorrento funciona para luna de miel solo si tu viaje mezcla Pompeya + Capri + romance. La ciudad en sí es demasiado cotidiana para sentirse romántica: el romance lo encuentras en el barco al atardecer en Capri, no en el hotel.
    </p>
  </div>

  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">El veredicto en 30 segundos</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8">
      <div class="bg-white p-6 rounded-[2rem] border border-slate-100 shadow-sm">
        <p class="text-med-gold text-[10px] font-bold uppercase tracking-[0.2em] mb-3">Elige Sorrento si:</p>
        <ul class="space-y-3 text-slate-600 text-sm">
          <li class="flex items-start gap-3"><span class="w-2 h-2 bg-med-gold rounded-full mt-2 flex-shrink-0"></span><span>Pompeya está en la lista de cosas imprescindibles</span></li>
          <li class="flex items-start gap-3"><span class="w-2 h-2 bg-med-gold rounded-full mt-2 flex-shrink-0"></span><span>Capri es una excursión imprescindible</span></li>
          <li class="flex items-start gap-3"><span class="w-2 h-2 bg-med-gold rounded-full mt-2 flex-shrink-0"></span><span>Familia grande o grupo (4+ personas)</span></li>
          <li class="flex items-start gap-3"><span class="w-2 h-2 bg-med-gold rounded-full mt-2 flex-shrink-0"></span><span>Presupuesto ajustado bajo €200/noche</span></li>
          <li class="flex items-start gap-3"><span class="w-2 h-2 bg-med-gold rounded-full mt-2 flex-shrink-0"></span><span>Aeropuerto de Nápoles in/out, sin coche</span></li>
        </ul>
      </div>
      <div class="bg-white p-6 rounded-[2rem] border border-slate-100 shadow-sm">
        <p class="text-med-gold text-[10px] font-bold uppercase tracking-[0.2em] mb-3">Elige Amalfi si:</p>
        <ul class="space-y-3 text-slate-600 text-sm">
          <li class="flex items-start gap-3"><span class="w-2 h-2 bg-med-gold rounded-full mt-2 flex-shrink-0"></span><span>El viaje trata específicamente de la Costa Amalfitana</span></li>
          <li class="flex items-start gap-3"><span class="w-2 h-2 bg-med-gold rounded-full mt-2 flex-shrink-0"></span><span>Ravello Festival o Ravello en general</span></li>
          <li class="flex items-start gap-3"><span class="w-2 h-2 bg-med-gold rounded-full mt-2 flex-shrink-0"></span><span>Quieres explorar Gruta Esmeralda, Minori, Maiori, Cetara</span></li>
          <li class="flex items-start gap-3"><span class="w-2 h-2 bg-med-gold rounded-full mt-2 flex-shrink-0"></span><span>Viajero cultural: historia medieval, catedrales</span></li>
          <li class="flex items-start gap-3"><span class="w-2 h-2 bg-med-gold rounded-full mt-2 flex-shrink-0"></span><span>Luna de miel slow (Belmond, Santa Caterina)</span></li>
        </ul>
      </div>
    </div>
    <blockquote class="border-l-4 border-med-gold pl-6 mb-8">
      <p class="text-slate-700 text-lg font-serif italic leading-relaxed">
        "💡 Consejo local: el itinerario más inteligente de 7 días divide la estancia: 3 noches en Sorrento (Pompeya martes, Capri miércoles, Positano excursión jueves), luego 4 noches en Amalfi (Ravello viernes, Gruta Esmeralda sábado, Minori domingo, lentitud lunes). Ves toda la región sin retroceder y los billetes bus/ferry cuestan lo mismo que si te hubieras quedado en un solo sitio."
      </p>
    </blockquote>
  </div>

  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">Tabla de comparación rápida</h2>
    <div class="overflow-hidden rounded-[2rem] border border-slate-100 shadow-sm">
      <table class="w-full text-sm">
        <thead class="bg-slate-900 text-white">
          <tr>
            <th class="text-left p-4 font-bold text-med-gold">Característica</th>
            <th class="text-left p-4 font-bold text-med-gold">Sorrento</th>
            <th class="text-left p-4 font-bold text-med-gold">Amalfi</th>
          </tr>
        </thead>
        <tbody class="bg-white">
          <tr class="border-b border-slate-100"><td class="p-4 font-semibold">Región</td><td class="p-4">Península Sorrentina (Golfo de Nápoles)</td><td class="p-4">Centro Costa Amalfitana</td></tr>
          <tr class="border-b border-slate-100"><td class="p-4 font-semibold">Distancia Pompeya</td><td class="p-4">30 min tren ⭐</td><td class="p-4">2h+ (bus + tren)</td></tr>
          <tr class="border-b border-slate-100"><td class="p-4 font-semibold">Distancia Ravello</td><td class="p-4">2h (bus + bus)</td><td class="p-4">25 min bus ⭐</td></tr>
          <tr class="border-b border-slate-100"><td class="p-4 font-semibold">Ferry Capri</td><td class="p-4">20 min, todo el año</td><td class="p-4">1h, estacional</td></tr>
          <tr class="border-b border-slate-100"><td class="p-4 font-semibold">Estación de tren</td><td class="p-4">Sí (Circumvesuviana)</td><td class="p-4">No</td></tr>
          <tr class="border-b border-slate-100"><td class="p-4 font-semibold">Atmósfera</td><td class="p-4">Ciudad de trabajo, elegante</td><td class="p-4">Ciudad marítima medieval</td></tr>
          <tr class="border-b border-slate-100"><td class="p-4 font-semibold">Coste medio hotel</td><td class="p-4">€120-300</td><td class="p-4">€150-450</td></tr>
          <tr><td class="p-4 font-semibold">Ideal para</td><td class="p-4">Primera visita, familias, amantes de Pompeya</td><td class="p-4">Puristas de la Costa, fans de Ravello, culturales</td></tr>
        </tbody>
      </table>
    </div>
  </div>

</BlogPostLayout>
