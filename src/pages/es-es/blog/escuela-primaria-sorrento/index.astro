---
import BlogPostLayout from '../../../../layouts/BlogPostLayout.astro';

const lang = 'es-es';
const post = {
  title: 'Escuela primaria en Sorrento: guía para familias',
  subtitle: 'Cómo funciona la scuola primaria italiana, qué colegios tiene realmente Sorrento, cuándo se hacen las matrículas y qué deben prever las familias que no hablan italiano',
  category: 'GUIDE',
  date: '25 de septiembre de 2026',
  readTime: '10 min',
  image: '/images/piazza-tasso-sorrento-hero.webp',
  imageAlt: "Piazza Tasso, la plaza principal de Sorrento y el centro de la vida cotidiana de la ciudad",
  path: '/es-es/blog/escuela-primaria-sorrento/',
};

const metaTitle = 'Escuela primaria en Sorrento: colegios y matrícula | 2026';
const metaDescription = 'Sorrento tiene cuatro escuelas primarias, dos públicas y dos concertadas, reunidas en dos istituti comprensivi. Normas de edad, ventana de matrícula de enero en la plataforma Unica, jornada completa y la opción en inglés más cercana.';

const breadcrumbs = [
  { name: 'Inicio', url: '/es-es/' },
  { name: 'Blog', url: '/es-es/blog/' },
  { name: 'Escuela primaria en Sorrento', url: '/es-es/blog/escuela-primaria-sorrento/' },
];

const quickInfo = [
  { label: 'Tipo de centro', value: 'Scuola primaria, 5 años' },
  { label: 'Edad', value: 'De 6 a 11 años' },
  { label: 'Norma de entrada', value: 'Seis años antes del 31 de diciembre' },
  { label: 'Entrada anticipada', value: 'Posible si cumple seis antes del 30 de abril' },
  { label: 'Colegios en Sorrento', value: '4: dos públicos, dos concertados' },
  { label: 'Istituti comprensivi', value: '2: Sorrento Capoluogo y Tasso' },
  { label: 'Matrícula', value: 'Online en enero, con SPID o CIE' },
  { label: 'Lengua de enseñanza', value: 'Italiano' },
];

const faq = [
  {
    q: '¿A qué edad empieza la escuela primaria en Italia?',
    a: 'El niño entra en classe prima en septiembre del año en que cumple seis, siempre que el cumpleaños caiga el 31 de diciembre o antes. También se puede pedir la entrada anticipada, la iscrizione anticipata, para quienes cumplan seis antes del 30 de abril del año siguiente. La primaria dura después cinco años, hasta los once aproximadamente.',
  },
  {
    q: '¿Cuántas escuelas primarias hay en Sorrento?',
    a: 'Cuatro en el municipio de Sorrento: dos públicas, Sorrento Capoluogo en Via Vittorio Veneto y Angelina Lauro en Via Capasso, y dos concertadas, el Conservatorio Santa Maria della Pietà en Via Pietà y Santa Maria delle Grazie en Piazza Sant\'Antonino. Las públicas dependen de dos istituti comprensivi, que incluyen también infantil y secundaria de primer grado.',
  },
  {
    q: '¿Cuándo se abre la matrícula?',
    a: 'En enero, para el curso que empieza el septiembre siguiente. Para 2026/2027 la ventana fue del 13 de enero al 14 de febrero de 2026. El Ministerio publica la circular con las fechas exactas en diciembre, así que la ventana del curso siguiente suele conocerse solo unas semanas antes.',
  },
  {
    q: '¿Cómo se presenta la solicitud?',
    a: 'Online, en la plataforma Unica del Ministerio de Educación. Un progenitor accede con identidad digital, SPID, CIE o eIDAS, introduce los datos del niño e indica un centro como primera opción más hasta dos alternativas. Hace falta el codice fiscale del niño. Quien llega con el curso empezado se matricula directamente en el colegio, fuera de la plataforma.',
  },
  {
    q: '¿Hay una escuela primaria en inglés en Sorrento?',
    a: 'No. En la península sorrentina no existe ninguna escuela primaria internacional ni en lengua inglesa. La opción más cercana es la International School of Naples en Bagnoli, con currículo estadounidense en inglés desde infantil hasta el grado doce. Desde Sorrento está a hora y media larga, lo que la descarta como desplazamiento diario para casi todas las familias.',
  },
  {
    q: '¿Esta página habla de la Sorrento Primary School de Australia?',
    a: 'No. Existen colegios con ese nombre en Sorrento, Australia Occidental, y en Sorrento, Victoria, y no tienen nada que ver con este. Aquí se habla de la escuela primaria en Sorrento, en Campania, la ciudad del golfo de Nápoles.',
  },
];

const sidebarLinks = [
  { label: 'Sorrento', href: '/es-es/peninsula-sorrentina/sorrento/' },
  { label: 'Estudiar en Sorrento', href: '/es-es/blog/estudiar-en-sorrento/' },
  { label: 'Sorrento o Positano', href: '/es-es/blog/sorrento-vs-positano/' },
  { label: 'Bus SITA', href: '/es-es/guia/bus-sita/' },
  { label: 'Ferries', href: '/es-es/guia/ferries/' },
];

const authorRole = 'Experto Local · Península Sorrentina';

const relatedArticles = [
  {
    title: 'Estudiar en Sorrento: Study abroad en la peninsula sorrentina',
    category: 'GUIDE',
    date: '4 de julio de 2026',
    image: '/images/study-abroad-sorrento-hero.webp',
    imageAlt: 'Estudiar en Sorrento',
    path: '/es-es/blog/estudiar-en-sorrento/'
  },
  {
    title: 'Peliculas rodadas en Sorrento: cuando el cine elige la peninsula',
    category: 'DESCUBRIMIENTOS',
    date: '30 de junio de 2026',
    image: '/images/film-fatti-a-sorrento-hero.webp',
    imageAlt: 'Películas rodadas en Sorrento',
    path: '/es-es/blog/peliculas-rodadas-en-sorrento/'
  }
];

const imageCredit = {
  author: 'Berthold Werner / Wikimedia Commons',
  sourceUrl: 'https://commons.wikimedia.org/wiki/File:Piazza_Tasso_-_Sorrento_BW_2013-05-12.jpg',
  license: 'CC BY-SA 3.0',
  licenseUrl: 'https://creativecommons.org/licenses/by-sa/3.0/',
};

const keyTakeaways = [
  'La scuola primaria italiana dura cinco años, empieza en septiembre del año en que el niño cumple seis y es gratuita en los centros públicos.',
  'Sorrento tiene cuatro escuelas primarias, dos públicas y dos concertadas, agrupadas en dos istituti comprensivi con sede en Via Vittorio Veneto y Via Marziale.',
  'La matrícula se hace online en enero en la plataforma Unica del Ministerio, y un progenitor necesita una identidad digital italiana como SPID o CIE.',
  'La decisión que más pesa sobre el terreno es tempo normale frente a tempo pieno, porque las plazas de jornada completa con comedor son limitadas y no existen en todos los edificios.',
  'Se enseña en italiano. En la península no hay primaria en inglés y el colegio internacional más cercano está en Nápoles, demasiado lejos para ir a diario.',
];
---

<BlogPostLayout
  lang={lang}
  post={post}
  metaTitle={metaTitle}
  metaDescription={metaDescription}
  breadcrumbs={breadcrumbs}
  quickInfo={quickInfo}
  faq={faq}
  sidebarLinks={sidebarLinks}
  authorRole={authorRole}
  relatedArticles={relatedArticles}
  imageCredit={imageCredit}
  pageKey="sorrento-primary-school"
>

  <!-- Key Takeaways -->
  <div class="bg-slate-900 text-white p-8 rounded-[2rem]">
    <div class="flex items-center gap-3 mb-6">
      <svg class="w-5 h-5 text-med-gold flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
      <h2 class="font-serif text-lg font-bold text-med-gold uppercase tracking-[0.15em]">Key Takeaways</h2>
    </div>
    <ul class="space-y-4">
      {keyTakeaways.map((point) => (
        <li class="flex items-start gap-3">
          <span class="w-1.5 h-1.5 rounded-full bg-med-gold flex-shrink-0 mt-2"></span>
          <span class="text-white/80 text-xs sm:text-sm leading-relaxed">{point}</span>
        </li>
      ))}
    </ul>
  </div>

  <!-- Intro -->
  <div>
    <p class="text-slate-600 text-xl leading-relaxed mb-6 font-light">
      Casi todo el mundo llega a <a href="/es-es/peninsula-sorrentina/sorrento/" class="text-med-blue hover:underline">Sorrento</a> para una semana. Una minoría llega para un año o más, normalmente por un trabajo en el turismo, por un empleo en remoto que podría hacerse en cualquier parte o por el regreso a una casa familiar, y descubre entonces que la pregunta de a qué colegio irá un niño de seis años no aparece en ninguna guía de viaje. Esta página cuenta qué ofrece realmente la ciudad, cómo funciona el sistema italiano para un niño que entra desde fuera y cuáles son las pocas fechas que lo deciden todo.
    </p>
  </div>

  <!-- Cómo funciona -->
  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">Cómo funciona la scuola primaria italiana</h2>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      La escuela primaria en Italia dura cinco años, de la <em>classe prima</em> a la <em>classe quinta</em>, y cubre aproximadamente de los seis a los once años. Es obligatoria y, en los centros públicos, gratuita: las familias pagan material, excursiones y comedor, no la enseñanza. Antes está la <em>scuola dell'infanzia</em>, voluntaria, desde los tres años; después llegan los tres cursos de <em>scuola secondaria di primo grado</em>, lo que todos llaman escuela media.
    </p>
    <p class="text-slate-600 text-lg leading-relaxed mb-8">
      En Campania el curso suele ir de mediados de septiembre a los primeros días de junio, con los cierres de Navidad, Semana Santa y las fiestas nacionales y locales. La única decisión estructural que toma una familia al matricular tiene que ver con el horario.
    </p>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div class="bg-white p-6 rounded-[2rem] border border-slate-100 shadow-sm">
        <h4 class="font-bold text-slate-900 mb-2">Tempo normale</h4>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Solo mañanas, normalmente entre 27 y 30 horas semanales, con salida a primera hora de la tarde y sin comedor. Es lo habitual en el sur y la opción más barata, pero da por hecho que a mediodía hay alguien en casa.</p>
      </div>
      <div class="bg-white p-6 rounded-[2rem] border border-slate-100 shadow-sm">
        <h4 class="font-bold text-slate-900 mb-2">Tempo pieno</h4>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Jornada completa, unas 40 horas semanales con comida en el comedor y clases por la tarde. Las plazas son limitadas, no existen en todos los edificios y se asignan según la demanda: es la primera pregunta al llamar a un colegio.</p>
      </div>
    </div>
  </div>

  <!-- Los colegios -->
  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">Las escuelas primarias de Sorrento</h2>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      Sorrento es una ciudad pequeña y la lista es corta. En el municipio funcionan cuatro escuelas primarias, dos públicas y dos concertadas vinculadas a instituciones religiosas. Las públicas están dentro de los <em>istituti comprensivi</em>, la unidad italiana que agrupa infantil, primaria y secundaria de primer grado bajo una misma dirección.
    </p>

    <div class="overflow-x-auto rounded-[2rem] border border-slate-100 shadow-sm">
      <table class="w-full text-xs sm:text-sm">
        <thead class="bg-slate-900 text-white">
          <tr>
            <th class="text-left p-5 font-serif font-bold text-med-gold">Colegio</th>
            <th class="text-left p-5 font-serif font-bold text-med-gold">Tipo</th>
            <th class="text-left p-5 font-serif font-bold text-med-gold">Dirección</th>
          </tr>
        </thead>
        <tbody class="bg-white">
          <tr class="border-b border-slate-100">
            <td class="p-5 font-bold">Sorrento Capoluogo</td>
            <td class="p-5 text-slate-600">Pública, I.C. Sorrento</td>
            <td class="p-5 text-slate-600">Via Vittorio Veneto, Sorrento</td>
          </tr>
          <tr class="border-b border-slate-100">
            <td class="p-5 font-bold">Angelina Lauro</td>
            <td class="p-5 text-slate-600">Pública</td>
            <td class="p-5 text-slate-600">Via Capasso, Sorrento</td>
          </tr>
          <tr class="border-b border-slate-100">
            <td class="p-5 font-bold">Conservatorio Santa Maria della Pietà</td>
            <td class="p-5 text-slate-600">Concertada, institución religiosa</td>
            <td class="p-5 text-slate-600">Via Pietà 24, Sorrento</td>
          </tr>
          <tr>
            <td class="p-5 font-bold">Santa Maria delle Grazie</td>
            <td class="p-5 text-slate-600">Concertada</td>
            <td class="p-5 text-slate-600">Piazza Sant'Antonino 14, Sorrento</td>
          </tr>
        </tbody>
      </table>
    </div>

    <p class="text-slate-600 text-lg leading-relaxed mt-6">
      Dentro del sistema público, las clases de primaria se reparten en dos edificios: la sede principal de Via Vittorio Veneto 16 y una segunda sede en Via Marziale 18, que es además la dirección del istituto comprensivo Tasso y donde se han situado las secciones de jornada completa. El edificio al que irá su hijo depende de la sección en la que lo coloquen, y no solo del colegio solicitado: conviene preguntarlo al matricular en lugar de darlo por hecho.
    </p>
  </div>

  <!-- Matrícula -->
  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">Cómo matricular, paso a paso</h2>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      La matrícula en classe prima es un trámite nacional online con una ventana fija, y perderla significa negociar directamente con un colegio por lo que quede. La secuencia de abajo vale para una familia ya residente, o a punto de serlo, en Sorrento.
    </p>

    <div class="bg-white p-8 rounded-[2rem] border border-slate-100 shadow-sm">
      <h3 class="font-serif text-xl font-bold text-slate-900 mb-5">Los cinco pasos</h3>
      <div class="space-y-3">
        <div class="flex items-start gap-3">
          <div class="w-6 h-6 rounded-full bg-med-gold/15 flex-shrink-0 flex items-center justify-center text-med-gold font-bold text-xs">1</div>
          <p class="text-slate-600 text-xs sm:text-sm leading-relaxed"><strong>Poner los papeles en orden.</strong> El niño necesita el <em>codice fiscale</em> italiano, y al menos un progenitor una identidad digital, SPID, CIE o un acceso europeo eIDAS equivalente. Ambos llevan tiempo: empiece en otoño, no en enero.</p>
        </div>
        <div class="flex items-start gap-3">
          <div class="w-6 h-6 rounded-full bg-med-gold/15 flex-shrink-0 flex items-center justify-center text-med-gold font-bold text-xs">2</div>
          <p class="text-slate-600 text-xs sm:text-sm leading-relaxed"><strong>Estar atento a la circular ministerial.</strong> Sale en diciembre y fija la ventana. Para 2026/2027 las solicitudes fueron del 13 de enero al 14 de febrero de 2026, y en los últimos años la apertura ha sido siempre en enero.</p>
        </div>
        <div class="flex items-start gap-3">
          <div class="w-6 h-6 rounded-full bg-med-gold/15 flex-shrink-0 flex items-center justify-center text-med-gold font-bold text-xs">3</div>
          <p class="text-slate-600 text-xs sm:text-sm leading-relaxed"><strong>Ir a las jornadas de puertas abiertas.</strong> Los colegios las organizan en las semanas previas a la apertura. Allí se ven los edificios, se conoce a los maestros y se averigua si habrá jornada completa el curso siguiente.</p>
        </div>
        <div class="flex items-start gap-3">
          <div class="w-6 h-6 rounded-full bg-med-gold/15 flex-shrink-0 flex items-center justify-center text-med-gold font-bold text-xs">4</div>
          <p class="text-slate-600 text-xs sm:text-sm leading-relaxed"><strong>Solicitar en Unica.</strong> Un colegio como primera opción, hasta dos alternativas. Si hay más solicitudes que plazas, el criterio principal suele ser la residencia en la zona del centro, seguido de las demás circunstancias familiares que fija el reglamento de cada colegio.</p>
        </div>
        <div class="flex items-start gap-3">
          <div class="w-6 h-6 rounded-full bg-med-gold/15 flex-shrink-0 flex items-center justify-center text-med-gold font-bold text-xs">5</div>
          <p class="text-slate-600 text-xs sm:text-sm leading-relaxed"><strong>Resolver los servicios con el ayuntamiento.</strong> Comedor, acogida de mañana y de tarde y transporte escolar son servicios municipales con solicitudes propias, no forman parte de la matrícula escolar.</p>
        </div>
      </div>
    </div>
  </div>

  <!-- Sin italiano -->
  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">Si en casa no se habla italiano</h2>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      La respuesta honesta es que un niño en una escuela primaria de Sorrento recibirá clase en italiano, de maestros que en la mayoría de los casos solo trabajan en italiano, junto a compañeros que lo hablan todos en casa. La escuela pública italiana admite niños en cualquier momento del curso, con independencia del idioma y de la situación documental, lo que es una virtud real del sistema, y existe apoyo de italiano como segunda lengua; cuánto puede ofrecer cada colegio concreto varía muchísimo.
    </p>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      Para la mayoría de los niños de seis o siete años resulta llevadero, y a menudo sorprendentemente rápido. A partir de los nueve o diez, entrar sin una palabra de italiano en un programa ya exigente en historia, geografía y gramática es bastante más duro y conviene pensarlo bien.
    </p>
    <p class="text-slate-600 text-lg leading-relaxed mb-8">
      En la península no hay primaria en lengua inglesa. La alternativa más cercana es la <strong>International School of Naples</strong> en Bagnoli, en el extremo occidental de la ciudad, que enseña un currículo estadounidense en inglés desde infantil hasta el grado doce, tiene unos 300 alumnos de muchas nacionalidades y comunica sus tarifas solo a través de la oficina de admisiones. Desde Sorrento hablamos de hora y media por trayecto, cruzando toda Nápoles: en la práctica, las familias que lo necesitan se acercan a la ciudad en vez de ir y venir.
    </p>

    <blockquote class="border-l-4 border-med-gold pl-6 my-8">
      <p class="text-slate-700 text-xl font-serif italic leading-relaxed">
        "En Sorrento la pregunta no es qué currículo internacional elegir. Es cuánto tarda un niño en aprender italiano, y la respuesta suele ser: menos que sus padres."
      </p>
    </blockquote>
  </div>

  <!-- Consejos -->
  <div class="bg-white p-8 rounded-[2rem] shadow-xl border border-slate-100">
    <div class="flex items-center gap-4 mb-6">
      <svg class="w-6 h-6 text-med-gold flex-shrink-0" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M9 18h6"/><path d="M10 22h4"/><path d="M15.09 14c.18-.98.65-1.74 1.41-2.5A4.65 4.65 0 0 0 18 8 6 6 0 0 0 6 8c0 1 .23 2.23 1.5 3.5A4.61 4.61 0 0 1 8.91 14"/></svg>
      <h3 class="text-xl font-bold">Consejos de Experto</h3>
    </div>
    <div class="space-y-6">
      <div>
        <p class="font-bold text-slate-900 mb-1">Pregunte por el edificio, no solo por el colegio</p>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Las clases públicas de primaria en Sorrento se reparten en varias sedes, y la distancia entre Via Vittorio Veneto y Via Marziale pesa cuando se recorre dos veces al día con un niño de seis años. Confirme la sede antes de aceptar la plaza.</p>
      </div>
      <div>
        <p class="font-bold text-slate-900 mb-1">Trate la residencia como el factor decisivo</p>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Si un colegio tiene más solicitudes que plazas, suele ganar la zona. Si todavía está eligiendo dónde alquilar en la ciudad, compruebe a qué colegio pertenece la dirección antes de firmar: es mucho más fácil elegir el piso alrededor del colegio que al revés.</p>
      </div>
      <div>
        <p class="font-bold text-slate-900 mb-1">No cuente con la entrada anticipada</p>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">La vía de la anticipataria existe para quienes cumplen seis años antes del 30 de abril del año siguiente, pero los colegios la valoran según la madurez y el número de clases que pueden formar. Solicítela si la quiere, y tenga preparado un plan con otro año de scuola dell'infanzia.</p>
      </div>
      <div>
        <p class="font-bold text-slate-900 mb-1">La península es más grande que Sorrento</p>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Sant'Agnello, Piano di Sorrento, Meta y Massa Lubrense tienen sus propios istituti comprensivi, a pocos minutos en Circumvesuviana o en <a href="/es-es/guia/bus-sita/" class="text-med-blue hover:underline">bus SITA</a>. Si necesita la jornada completa y en Sorrento no la hay, el municipio vecino suele ofrecerla.</p>
      </div>
    </div>
  </div>

</BlogPostLayout>
