---
import BlogPostLayout from '../../../../layouts/BlogPostLayout.astro';

const lang = 'es-es';
const post = {
  title: 'Fiordo de Crapolla',
  subtitle: 'El tesoro escondido entre los 700 escalones',
  category: 'DESCUBRIMIENTOS',
  date: '15 de mayo de 2026',
  readTime: '12 min',
  image: '/images/fiordo-crapolla-hero.jpg',
  imageAlt: 'Fiordo de Crapolla - Massa Lubrense, Península Sorrentina',
  path: '/es-es/blog/fiordo-di-crapolla/',
};

const metaTitle = 'Fiordo de Crapolla: El tesoro escondido de la Península Sorrentina 2026';
const metaDescription = 'Guía completa del Fiordo de Crapolla: 700 escalones, capilla medieval, restos romanos, historia arqueológica y consejos prácticos para visitar este lugar secreto en Massa Lubrense.';

const breadcrumbs = [
  { name: 'Inicio', url: '/es-es/' },
  { name: 'Blog', url: '/es-es/blog/' },
  { name: 'Fiordo de Crapolla', url: '/es-es/blog/fiordo-di-crapolla/' },
];

const quickInfo = [
  { label: 'Punto de partida', value: 'Via Casal di Torca (Massa Lubrense)' },
  { label: 'Número de escalones', value: '~700 (piedra natural)' },
  { label: 'Desnivel', value: 'Aprox. 160 metros' },
  { label: 'Dificultad', value: 'Media/Alta (por el esfuerzo físico)' },
  { label: 'Agua', value: 'No hay en el sitio (llevar al menos 2 litros)' },
  { label: 'Tiempo bajada', value: 'Aprox. 45-60 minutos' },
  { label: 'Qué ver', value: 'Capilla de San Pietro, restos romanos, monazeni' },
  { label: 'Mejor época', value: 'Abril-junio, septiembre-octubre' },
];

const faq = [
  {
    q: '¿Cuál es el número exacto de escalones?',
    a: 'No existe un número preciso: el conteo varía entre 680 y 700 según el punto de inicio y cómo se cuenten los últimos escalones. La mayoría de visitantes reportan aproximadamente 700 escalones.',
  },
  {
    q: '¿Cuánto tiempo lleva la subida?',
    a: 'La subida generalmente requiere 60-90 minutos. Depende de tu nivel de fitness y la hora del día (en meses calurosos, el calor de la piedra ralentiza significativamente el ritmo).',
  },
  {
    q: '¿Es obligatorio llevar agua?',
    a: 'Absolutamente sí. No hay fuentes ni puestos de refresco en el camino. Lleva al menos 2 litros por persona, más en verano.',
  },
  {
    q: '¿Hay peligros en el sendero?',
    a: 'La ruta no es técnicamente difícil, pero la piedra caliza puede ser resbaladiza, especialmente con calzado inadecuado. Usa siempre botas de senderismo con buen agarre.',
  },
  {
    q: '¿Puedo bañarme?',
    a: 'Sí, el agua es cristalina y la playa es maravillosa. El área es parte de la Reserva Marina de Punta Campanella, así que el ecosistema está protegido.',
  },
  {
    q: '¿Necesito reservar o pedir permiso?',
    a: 'No es necesaria reservación. Es un área pública, pero recuerda llevar tu basura contigo y respetar el medio ambiente.',
  },
];

const sidebarLinks = [
  { label: 'Massa Lubrense', href: '/es-es/playas/peninsula-sorrentina/' },
  { label: 'Punta Campanella', href: '/es-es/blog/punta-campanella/' },
  { label: 'Cuándo visitar', href: '/es-es/cuando-visitar/' },
  { label: 'Cómo llegar', href: '/es-es/como-llegar/' },
];

const relatedArticles = [
  {
    title: 'Punta Campanella',
    category: 'DESCUBRIMIENTOS',
    date: '10 de mayo de 2026',
    image: '/images/punta-campanella-hero.jpg',
    imageAlt: 'Punta Campanella - Massa Lubrense, Península Sorrentina',
    path: '/es-es/blog/punta-campanella/'
  },
  {
    title: 'Valle de las Herrerías: Senderismo en el Corazón Verde de Amalfi',
    category: 'DESCUBRIMIENTOS',
    date: '22 de abril de 2026',
    image: '/images/valle-ferriere-hero.jpg',
    imageAlt: 'Cascada en Valle de las Herrerías, Amalfi - Costa Amalfitana',
    path: '/es-es/blog/valle-herrerias/'
  }
];

const authorRole = 'Guía de Arqueología & Senderismo · Península Sorrentina';

const keyTakeaways = [
  'El Fiordo de Crapolla no es solo una playa secreta, sino un monumento natural y arqueológico con raíces que se remontan a la antigüedad clásica, dedicado al dios Apolo.',
  'Los ~700 escalones de piedra caliza fueron construidos con sabiduría antigua para superar un desnivel vertiginoso de aproximadamente 160 metros, y siguen siendo el rasgo distintivo del lugar.',
  'La Capilla de San Pietro se alza sobre los restos de un templo pagano dedicado a Apolo; en la Edad Media, aquí floreció una importante abadía benedictina.',
  'Los monazeni (cavidades excavadas en la roca por los romanos) testimonian cómo fue utilizado el lugar durante siglos como refugio natural y almacenamiento de barcas.',
  'El horario ideal para visitar es entre las 6:00 AM y las 12:00 PM en verano, evitando el calor abrasador de la piedra caliza durante las horas centrales del día.',
];

const videoSchema = {
  "@context": "https://schema.org",
  "@type": "VideoObject",
  "name": "Fiordo de Crapolla: El tesoro escondido entre los 700 escalones",
  "description": "Video del Fiordo de Crapolla - uno de los lugares más fascinantes de la Península Sorrentina con sus 700 escalones de piedra, la Capilla de San Pietro e historia arqueológica antigua.",
  "thumbnailUrl": "/images/fiordo-crapolla-hero.jpg",
  "uploadDate": "2026-05-15",
  "duration": "PT1M30S",
  "contentUrl": "/videos/fiordo-crapolla-video.mp4",
  "videoDetails": {
    "width": "1280",
    "height": "720"
  }
};
---

<BlogPostLayout
  lang={lang}
  post={post}
  metaTitle={metaTitle}
  metaDescription={metaDescription}
  breadcrumbs={breadcrumbs}
  quickInfo={quickInfo}
  faq={faq}
  sidebarLinks={sidebarLinks}
  authorRole={authorRole}
  relatedArticles={relatedArticles}
  schema={[videoSchema]}
>

  <!-- Key Takeaways -->
  <div class="bg-slate-900 text-white p-8 rounded-[2rem]">
    <div class="flex items-center gap-3 mb-6">
      <svg class="w-5 h-5 text-med-gold flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
      <h2 class="font-serif text-lg font-bold text-med-gold uppercase tracking-[0.15em]">Puntos Clave</h2>
    </div>
    <ul class="space-y-4">
      {keyTakeaways.map((point) => (
        <li class="flex items-start gap-3">
          <span class="w-1.5 h-1.5 rounded-full bg-med-gold flex-shrink-0 mt-2"></span>
          <span class="text-white/80 text-xs sm:text-sm leading-relaxed">{point}</span>
        </li>
      ))}
    </ul>
  </div>

  <!-- Intro -->
  <div>
    <p class="text-slate-600 text-xl leading-relaxed mb-6 font-light">
      Mientras la mayoría de los turistas se agolpan en Positano o Sorrento, existe una ensenada excavada en la roca que conserva el encanto intacto de una Italia perdida. El Fiordo de Crapolla, en Massa Lubrense, es un monumento natural y arqueológico protegido por muros de roca altísimos, accesible solo para quienes están dispuestos a "ganárselo" con una buena caminata.
    </p>
  </div>

  <!-- Video Section -->
  <div class="rounded-[2rem] shadow-xl mb-8 flex justify-center bg-slate-900 py-4">
    <video
      controls
      poster="/images/fiordo-crapolla-hero.jpg"
      class="max-w-full max-h-[500px]"
      width="1280"
      height="720"
    >
      <source src="/videos/fiordo-crapolla-video.mp4" type="video/mp4" />
      Tu navegador no soporta el elemento video. Por favor descarga el video para verlo.
    </video>
  </div>

  <!-- El Sendero -->
  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">El Sendero: Entre matorral mediterráneo y mitos</h2>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      El viaje comienza en el pueblo de Torca. El sendero serpentea entre antiguos muros de piedra seca y el aroma del mirto y la retama. El recorrido ofrece vistas privilegiadas del archipiélago de Li Galli y de la isla de Isca, el refugio amado por el dramaturgo Eduardo De Filippo.
    </p>

    <div class="bg-white p-8 rounded-[2rem] border border-slate-100 shadow-sm my-6">
      <h3 class="font-serif text-xl font-bold text-slate-900 mb-4">El Desafío de los 700 Escalones</h3>
      <p class="text-slate-600 leading-relaxed mb-4">
        Lo más característico de Crapolla es su increíble escalera de unos 700 peldaños de piedra caliza. Cada escalón fue colocado con sabiduría antigua para superar el desnivel vertiginoso del acantilado.
      </p>
      <p class="text-slate-600 leading-relaxed">
        Durante el descenso, verás pequeñas baldosas de cerámica que indican el número de escalones recorridos, un detalle psicológicamente vital para la subida de regreso.
      </p>
    </div>
  </div>

  <!-- La Iglesia -->
  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">La Iglesia: San Pedro y el Templo de Apolo</h2>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      Casi al final, se encuentra la Capilla de San Pedro. Esta pequeña iglesia blanca tiene una importancia histórica fascinante:
    </p>

    <div class="space-y-6 mb-8">
      <div class="bg-white p-6 rounded-[2rem] border border-slate-100 shadow-sm">
        <h4 class="font-bold text-slate-900 mb-2">Raíces clásicas</h4>
        <p class="text-slate-600 text-sm leading-relaxed">El nombre "Crapolla" deriva de Acra-Apollo. La iglesia se alza sobre los restos de un templo pagano dedicado al dios del sol.</p>
      </div>
      <div class="bg-white p-6 rounded-[2rem] border border-slate-100 shadow-sm">
        <h4 class="font-bold text-slate-900 mb-2">La Abadía</h4>
        <p class="text-slate-600 text-sm leading-relaxed">En la Edad Media hubo aquí una abadía benedictina; hoy aún se ven columnas de mármol romanas reutilizadas en la capilla.</p>
      </div>
      <div class="bg-white p-6 rounded-[2rem] border border-slate-100 shadow-sm">
        <h4 class="font-bold text-slate-900 mb-2">La leyenda</h4>
        <p class="text-slate-600 text-sm leading-relaxed">Se dice que el Apóstol San Pedro desembarcó aquí en su viaje hacia Roma para evangelizar el Occidente.</p>
      </div>
    </div>

    <blockquote class="border-l-4 border-med-gold pl-6 my-8">
      <p class="text-slate-700 text-xl font-serif italic leading-relaxed">
        "Crapolla es donde la historia clásica, la medieval y la naturaleza salvaje se encuentran en un espacio increíblemente pequeño e intacto."
      </p>
    </blockquote>
  </div>

  <!-- El Pueblo -->
  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">El Pueblo Marinero y la Playa</h2>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      En el fondo encontramos los restos de un antiguo pueblo de pescadores. Aquí se encuentran los monazeni: cavidades excavadas en la roca por los romanos y utilizadas durante siglos para el almacenamiento de barcas. La playa es un pequeño retazo de guijarros blancos donde el agua es de una pureza cristalina.
    </p>

    <div class="overflow-hidden rounded-[2rem] border border-slate-100 shadow-sm">
      <table class="w-full text-xs sm:text-sm">
        <thead class="bg-slate-900 text-white">
          <tr>
            <th class="text-left p-5 font-serif font-bold text-med-gold">Característica</th>
            <th class="text-left p-5 font-serif font-bold text-med-gold">Detalle</th>
          </tr>
        </thead>
        <tbody class="bg-white">
          <tr class="border-b border-slate-100">
            <td class="p-5 font-bold text-slate-900">Punto de partida</td>
            <td class="p-5 text-slate-600">Via Casal di Torca (Massa Lubrense)</td>
          </tr>
          <tr class="border-b border-slate-100">
            <td class="p-5 font-bold text-slate-900">Número de escalones</td>
            <td class="p-5 text-slate-600">~700 (de piedra)</td>
          </tr>
          <tr class="border-b border-slate-100">
            <td class="p-5 font-bold text-slate-900">Desnivel</td>
            <td class="p-5 text-slate-600">Aproximadamente 160 metros</td>
          </tr>
          <tr class="border-b border-slate-100">
            <td class="p-5 font-bold text-slate-900">Dificultad</td>
            <td class="p-5 text-slate-600">Media/Alta (por el esfuerzo físico)</td>
          </tr>
          <tr>
            <td class="p-5 font-bold text-slate-900">Agua</td>
            <td class="p-5 text-slate-600">No hay (llevar al menos 2 litros por persona)</td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>

  <!-- Consejos -->
  <div class="bg-white p-8 rounded-[2rem] shadow-xl border border-slate-100">
    <div class="flex items-center gap-4 mb-6">
      <svg class="w-6 h-6 text-med-gold flex-shrink-0" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M9 18h6"/><path d="M10 22h4"/><path d="M15.09 14c.18-.98.65-1.74 1.41-2.5A4.65 4.65 0 0 0 18 8 6 6 0 0 0 6 8c0 1 .23 2.23 1.5 3.5A4.61 4.61 0 0 1 8.91 14"/></svg>
      <h3 class="text-xl font-bold text-slate-900">Consejos del Experto</h3>
    </div>
    <div class="space-y-6">
      <div>
        <p class="font-bold text-slate-900 mb-1">La Mejor Hora</p>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Evita la subida entre las 12:00 y las 16:00 en verano. La escalera mira al sur y el calor de la piedra puede ser agotador.</p>
      </div>
      <div>
        <p class="font-bold text-slate-900 mb-1">Calzado</p>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">No cometas el error de bajar en sandalias. La piedra es resbaladiza y los escalones son irregulares. Usa botas de senderismo con buen agarre.</p>
      </div>
      <div>
        <p class="font-bold text-slate-900 mb-1">Respeto</p>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Crapolla es un sitio arqueológico y natural. Lleva tu basura contigo: aquí no pasan servicios de limpieza y la belleza del lugar depende del respeto de quien lo visita.</p>
      </div>
    </div>
  </div>

</BlogPostLayout>
