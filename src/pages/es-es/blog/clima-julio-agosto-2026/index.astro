---
import BlogPostLayout from '../../../../layouts/BlogPostLayout.astro';

const lang = 'es-es';
const post = {
  title: 'Clima Costa Amalfitana Julio y Agosto 2026',
  subtitle: 'Positano y Amalfi en verano: temperaturas, relieve, kit de supervivencia y los tres meteo hacks para no perder la cabeza',
  category: 'GUIDE',
  date: '29 de julio de 2026',
  readTime: '8 min',
  image: '/images/meteo-costiera-luglio-agosto-hero.webp',
  imageAlt: 'Vista panorámica de Positano en la Costa Amalfitana en verano',
  path: '/es-es/blog/clima-julio-agosto-2026/',
};

const metaTitle = 'Clima Costa Amalfitana Julio Agosto 2026 | Positano y Amalfi';
const metaDescription = "Julio 31°C, agosto 32°C con 66% de humedad. Cómo funciona el microclima de la Costa, qué playas se quedan a la sombra a partir de las 15:30, qué llevar en la maleta y 3 meteo hacks para Positano y Amalfi.";

const breadcrumbs = [
  { name: 'Inicio', url: '/es-es/' },
  { name: 'Blog', url: '/es-es/blog/' },
  { name: 'Clima Julio y Agosto 2026', url: '/es-es/blog/clima-julio-agosto-2026/' },
];

const quickInfo = [
  { label: 'Máxima media julio', value: '31°C (picos 34°C)' },
  { label: 'Máxima media agosto', value: '32°C (humedad 66%)' },
  { label: 'Mínima nocturna', value: '22-23°C' },
  { label: 'Temperatura del mar', value: '25°C jul, 27°C ago' },
  { label: 'Horas de sol', value: '10-11 al día' },
  { label: 'Índice UV', value: '9-10 (muy alto)' },
  { label: 'Riesgo de lluvia', value: 'Raras tormentas de calor a finales de agosto' },
  { label: 'Viento local', value: '"Faugn", brisa cálida nocturna' },
];

const faq = [
  {
    q: '¿Hace más calor en julio o en agosto en la Costa Amalfitana?',
    a: "En agosto. Julio tiene una media de 31°C con aire más seco, mientras que agosto se estabiliza en 32-33°C con 66-70% de humedad y la roca caliza que ha acumulado calor durante semanas. La sensación de calor, sobre todo en los callejones estrechos de Amalfi y Atrani, es notablemente mayor en agosto.",
  },
  {
    q: '¿A qué hora la playa de Amalfi se queda a la sombra?',
    a: "Las playas de Amalfi, Atrani y Minori están orientadas al sureste: el sol desaparece detrás de la montaña hacia las 15:30-16:00 en pleno verano. Ideal si buscas frescor por la tarde, menos si quieres quedarte al sol hasta el atardecer. En ese caso conviene moverse a Positano o Praiano (Gavitella), que se mantienen iluminadas hasta las 19:30-20:00.",
  },
  {
    q: '¿Necesito protector solar SPF 50 aunque me broncee fácilmente?',
    a: "Sí, siempre. El índice UV toca 9-10 entre julio y agosto, y los acantilados calizos blancos reflejan la luz como un espejo. El reflejo es más agresivo que en una playa italiana media: SPF 50, sombrero de ala ancha y gafas polarizadas son los tres aliados que salvarán tu primer día.",
  },
  {
    q: '¿Cuándo está más caliente el mar, en julio o en agosto?',
    a: "En agosto. En julio el agua oscila alrededor de los 25°C, perfecta para largos baños. En agosto alcanza su pico anual en 27°C, prácticamente una piscina climatizada, con visibilidad submarina excepcional en los días de calma.",
  },
  {
    q: '¿Llueve en agosto en la Costa Amalfitana?',
    a: "Muy raramente. En agosto se cuentan de media 3 días con precipitaciones, casi siempre tormentas de calor por la tarde que duran 20-30 minutos, refrescan el aire y dejan cielos espectaculares después. Raramente arruinan un día entero, pero conviene vigilar el radar a partir de las 17:00.",
  },
  {
    q: '¿Cómo debo vestirme en la Costa en pleno verano?',
    a: "Tejidos naturales y ligeros: lino, algodón, seda. Evita los sintéticos que aumentan la sudoración. Para caminar, usa sandalias con suela de goma o zapatillas de lona con buen agarre: los escalones de piedra caliza y los pavimentos de Positano se vuelven resbaladizos con la mezcla de calor y salitre. Deja los tacones en el hotel.",
  },
  {
    q: '¿Es mejor moverse en autobús o en ferry entre julio y agosto?',
    a: "Ferry, sin dudarlo. El autobús SITA entre las 11:00 y las 15:00 en pleno verano significa esperas bajo el sol abrasador y tráfico bloqueado. Los ferris Travelmar cuestan más, pero la brisa marina convierte el trayecto en un crucero panorámico ventilado. El tramo Salerno-Amalfi-Positano se recorre en unos 60-70 minutos.",
  },
  {
    q: "¿Qué es el 'Faugn' de la Costa Amalfitana?",
    a: "Es el nombre local de una brisa cálida y seca que baja de las montañas por la noche, típica de las tardes de verano. A veces, a las 23:00, llega una ráfaga de aire tibio, especialmente en excursiones en barco a la luz de la luna o en las terrazas más altas. Lleva siempre una camisa ligera de manga larga para las salidas nocturnas por mar.",
  },
  {
    q: '¿De verdad Ravello es más fresca que la costa?',
    a: "Sí. Situada a 365 metros de altitud, Ravello registra constantemente 3-4°C menos que Amalfi o Positano, con una ventilación seca que regenera. Es la escapada perfecta del calor de las playas, sobre todo en los días más bochornosos de finales de agosto.",
  },
  {
    q: '¿Cuál es la playa con más sol de la Costa Amalfitana?',
    a: "La Gavitella en Praiano. Orientada al oeste, recibe luz directa hasta las 19:30-20:00 y ve el sol ponerse directamente en el mar frente a Capri: es la única playa de la Costa donde se puede tomar el aperitivo en bañador mientras el sol cae sobre el horizonte marino.",
  },
];

const sidebarLinks = [
  { label: 'Positano', href: '/es-es/costa-amalfitana/positano/' },
  { label: 'Amalfi', href: '/es-es/costa-amalfitana/amalfi/' },
  { label: 'Praiano', href: '/es-es/costa-amalfitana/praiano/' },
  { label: 'Ravello', href: '/es-es/costa-amalfitana/ravello/' },
  { label: 'Playas de la Costa Amalfitana', href: '/es-es/playas/' },
];

const authorRole = 'Redacción local · Costa Amalfitana';

const relatedArticles = [
  {
    title: 'Puestas de Sol Hora Dorada',
    category: 'DESCUBRIMIENTOS',
    date: '2 de mayo de 2026',
    image: '/images/tramonto-costiera.webp',
    imageAlt: 'Puesta de sol en la playa de la Costa Amalfitana',
    path: '/es-es/blog/puesta-de-sol-playas/'
  },
  {
    title: 'Playas Cómodas y Equipadas',
    category: 'GUIDE',
    date: '18 de abril de 2026',
    image: '/images/spiagge-bambini.webp',
    imageAlt: 'Playas cómodas y equipadas de la Costa Amalfitana',
    path: '/es-es/blog/playas-comodas-equipadas/'
  }
];

const keyTakeaways = [
  "Julio marca 31°C de media con aire seco y mar a 25°C: el mes perfecto para broncearse. Agosto sube a 32-33°C con 66-70% de humedad y mar a 27°C.",
  "Las playas de Amalfi, Atrani y Minori se quedan a la sombra entre las 15:30 y las 16:00; Positano, Praiano y la Gavitella permanecen al sol hasta la tarde.",
  "Ravello, a 365 metros de altitud, tiene siempre 3-4°C menos que la costa: la escapada regeneradora de los días bochornosos.",
  "Finales de agosto trae raras tormentas de calor por la tarde: 20-30 minutos que refrescan el aire y dejan cielos espectaculares.",
  "En temporada alta los ferris Travelmar ganan a los autobuses SITA en todos los frentes: más rápidos, ventilados y sin riesgo de esperas bajo el sol.",
];
---

<BlogPostLayout
  lang={lang}
  post={post}
  metaTitle={metaTitle}
  metaDescription={metaDescription}
  breadcrumbs={breadcrumbs}
  quickInfo={quickInfo}
  faq={faq}
  sidebarLinks={sidebarLinks}
  authorRole={authorRole}
  relatedArticles={relatedArticles}
  pageKey="clima-julio-agosto-2026"
>

  <!-- Key Takeaways -->
  <div class="bg-slate-900 text-white p-8 rounded-[2rem]">
    <h2 class="font-serif text-lg font-bold text-med-gold uppercase tracking-[0.15em] mb-6">Key Takeaways</h2>
    <ul class="space-y-4">
      {keyTakeaways.map((point) => (
        <li class="flex items-start gap-3">
          <span class="w-1.5 h-1.5 rounded-full bg-med-gold flex-shrink-0 mt-2"></span>
          <span class="text-white/80 text-xs sm:text-sm leading-relaxed">{point}</span>
        </li>
      ))}
    </ul>
  </div>

  <!-- Intro -->
  <div>
    <p class="text-slate-600 text-xl leading-relaxed mb-6 font-light">
      Justo en este momento, el verano de 2026 está en su apogeo y <a href="/es-es/costa-amalfitana/positano/" class="text-med-blue hover:underline">Positano</a> y <a href="/es-es/costa-amalfitana/amalfi/" class="text-med-blue hover:underline">Amalfi</a> son literalmente el centro del mundo. Julio y agosto son sinónimos de aguas cristalinas, atardeceres infinitos y la icónica Dolce Vita. Sin embargo, también significan temperaturas altas, un sol abrasador y una logística bastante intensa.
    </p>
    <p class="text-slate-600 text-lg leading-relaxed">
      La <a href="/es-es/costa-amalfitana/" class="text-med-blue hover:underline">Costa</a> tiene un microclima único: los Montes Lattari bloquean los vientos del norte creando una barrera térmica, mientras que el mar se transforma en una enorme piscina climatizada. Aquí te contamos cómo leer el clima y organizar tus días para evitar los peores picos de calor y disfrutar del viaje de tu vida.
    </p>
  </div>

  <!-- Informe Térmico -->
  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">El Informe Térmico: Lo Que de Verdad Marca el Termómetro</h2>
    <p class="text-slate-600 text-lg leading-relaxed mb-8">
      Seamos realistas: hace calor durante estos dos meses. Pero no todo el calor es igual, y los dos meses tienen personalidades muy distintas.
    </p>

    <div class="bg-white p-8 rounded-[2rem] border border-slate-100 shadow-sm mb-6">
      <p class="text-med-gold text-xs font-medium uppercase tracking-[0.25em] mb-3">Julio</p>
      <h3 class="font-serif text-2xl font-bold text-slate-900 mb-4">Sol Radiante y Calor Seco</h3>
      <p class="text-slate-600 text-lg leading-relaxed mb-5">
        El mes perfecto para los amantes del bronceado. Los días ofrecen hasta 15 horas de luz y la humedad se mantiene contenida.
      </p>
      <ul class="space-y-4">
        <li class="flex items-start gap-3">
          <span class="w-1.5 h-1.5 rounded-full bg-med-gold flex-shrink-0 mt-2"></span>
          <span class="text-slate-600 text-xs sm:text-sm leading-relaxed"><strong>Las temperaturas.</strong> De día la media es de 31°C, pero si llega el anticiclón africano se alcanzan fácilmente los 34°C.</span>
        </li>
        <li class="flex items-start gap-3">
          <span class="w-1.5 h-1.5 rounded-full bg-med-gold flex-shrink-0 mt-2"></span>
          <span class="text-slate-600 text-xs sm:text-sm leading-relaxed"><strong>Las noches.</strong> Bajan a unos agradables 22°C. La brisa marina refresca el aire lo justo para disfrutar de cenas al aire libre.</span>
        </li>
        <li class="flex items-start gap-3">
          <span class="w-1.5 h-1.5 rounded-full bg-med-gold flex-shrink-0 mt-2"></span>
          <span class="text-slate-600 text-xs sm:text-sm leading-relaxed"><strong>El mar.</strong> Agua espectacular a 25°C. Ideal para quedarse flotando durante horas sin sentir frío al salir.</span>
        </li>
      </ul>
    </div>

    <div class="bg-white p-8 rounded-[2rem] border border-slate-100 shadow-sm">
      <p class="text-med-gold text-xs font-medium uppercase tracking-[0.25em] mb-3">Agosto</p>
      <h3 class="font-serif text-2xl font-bold text-slate-900 mb-4">El Pico de Calor (y de Humedad)</h3>
      <p class="text-slate-600 text-lg leading-relaxed mb-5">
        En agosto, el calor acumulado por los acantilados calizos se hace notar y la humedad sube al 65-70%.
      </p>
      <ul class="space-y-4">
        <li class="flex items-start gap-3">
          <span class="w-1.5 h-1.5 rounded-full bg-med-gold flex-shrink-0 mt-2"></span>
          <span class="text-slate-600 text-xs sm:text-sm leading-relaxed"><strong>Las temperaturas.</strong> El termómetro se estabiliza en los 32-33°C, pero la sensación de bochorno es mayor que en julio, sobre todo en los callejones estrechos.</span>
        </li>
        <li class="flex items-start gap-3">
          <span class="w-1.5 h-1.5 rounded-full bg-med-gold flex-shrink-0 mt-2"></span>
          <span class="text-slate-600 text-xs sm:text-sm leading-relaxed"><strong>Tormentas de verano.</strong> A finales de agosto, el aire ardiente choca con el mar caliente. ¿El resultado? Breves pero intensas tormentas de calor por la tarde. Duran 20 minutos, refrescan el ambiente y dejan unos cielos brutales después.</span>
        </li>
        <li class="flex items-start gap-3">
          <span class="w-1.5 h-1.5 rounded-full bg-med-gold flex-shrink-0 mt-2"></span>
          <span class="text-slate-600 text-xs sm:text-sm leading-relaxed"><strong>El mar.</strong> Llega a su máximo anual con 27°C. Básicamente un baño termal donde se pierde la noción del tiempo.</span>
        </li>
      </ul>
    </div>
  </div>

  <!-- Engaño de la Sombra -->
  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">El Engaño de la Sombra: Por Qué el Relieve Cambia Tus Planes</h2>
    <p class="text-slate-600 text-lg leading-relaxed mb-8">
      Este es el clásico error de principiante que arruina los días de playa. Las montañas de la Costa caen en picado sobre el mar y bloquean la luz solar antes de lo que crees. Cada tramo de costa tiene su propio horario de sombra.
    </p>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
      <div class="bg-white p-6 rounded-[2rem] border border-slate-100 shadow-sm">
        <p class="text-med-gold text-xs font-medium uppercase tracking-[0.2em] mb-2">Amalfi · Atrani · Minori</p>
        <h4 class="font-bold text-slate-900 mb-2 text-lg">Sol por la mañana, sombra desde las 15:30</h4>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Estas playas están orientadas al sureste. Un sol increíble por la mañana, pero hacia las 15:30-16:00 el sol desaparece detrás de la montaña y la playa se queda en sombra. Excelente si odias el calor abrasador, pésimo si quieres tomar el aperitivo al sol.</p>
      </div>
      <div class="bg-white p-6 rounded-[2rem] border border-slate-100 shadow-sm">
        <p class="text-med-gold text-xs font-medium uppercase tracking-[0.2em] mb-2">Positano · Praiano</p>
        <h4 class="font-bold text-slate-900 mb-2 text-lg">Sol hasta la tarde, el paraíso Gavitella</h4>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Aquí estamos en el lado opuesto. El sol besa esta costa hasta tarde. En Praiano, concretamente en la playa de la Gavitella, se disfruta del sol más largo de la Costa: puedes estar en bañador hasta las 20:00 y ver el sol esconderse directamente en el mar frente a Capri.</p>
      </div>
      <div class="bg-white p-6 rounded-[2rem] border border-slate-100 shadow-sm">
        <p class="text-med-gold text-xs font-medium uppercase tracking-[0.2em] mb-2">Ravello</p>
        <h4 class="font-bold text-slate-900 mb-2 text-lg">Si te ahogas del calor, sube</h4>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Situada a 365 metros de altura, <a href="/es-es/costa-amalfitana/ravello/" class="text-med-blue hover:underline">Ravello</a> siempre tiene 3 o 4 grados menos que la playa, con una brisa seca que te devuelve la vida. La escapada regeneradora de los días bochornosos.</p>
      </div>
    </div>
  </div>

  <!-- Maleta & Kit -->
  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">Maleta y Kit de Supervivencia para la Costa</h2>
    <p class="text-slate-600 text-lg leading-relaxed mb-8">
      Caminar por la Costa en agosto no tiene nada que ver con un paseo llano por Miami. Es un entrenamiento vertical, y cada elección del armario cuenta.
    </p>

    <div class="bg-white p-8 rounded-[2rem] border border-slate-100 shadow-sm">
      <div class="space-y-6">
        <div>
          <p class="font-bold text-slate-900 mb-2 text-lg">El drama de los zapatos</p>
          <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Deja los tacones en el hotel y olvídate de las chanclas de plástico baratas para caminar. Los escalones de piedra caliza y los pavimentos de piedra volcánica (sobre todo en Positano) se vuelven resbaladizos por la mezcla de calor y salitre. Usa sandalias planas con suela de goma o zapatillas de lona con buen agarre.</p>
        </div>
        <div class="border-t border-slate-100 pt-6">
          <p class="font-bold text-slate-900 mb-2 text-lg">Lino, lino y más lino</p>
          <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Los tejidos sintéticos te harán sudar el doble. Elige camisas, vestidos y pantalones sueltos de lino o algodón ligero. La seda es excelente para la tarde. Evita jeans ajustados y polos ceñidos: la Costa vive de elegancia relajada, no de ropa restrictiva.</p>
        </div>
        <div class="border-t border-slate-100 pt-6">
          <p class="font-bold text-slate-900 mb-2 text-lg">El reflejo asesino</p>
          <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Las rocas blancas de la Costa reflejan la luz como un espejo. El índice UV llega a un peligroso 9/10. Gafas de sol polarizadas, sombrero de ala ancha y protector solar SPF 50 son innegociables si no quieres terminar como un cangrejo el primer día.</p>
        </div>
      </div>
    </div>
  </div>

  <!-- 3 Meteo Hacks -->
  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">Los 3 Meteo Hacks del Experto para No Perder la Cabeza</h2>
    <p class="text-slate-600 text-lg leading-relaxed mb-8">
      Tres trucos de local que marcan la diferencia entre unas vacaciones sobrevividas y unas vacaciones realmente vividas.
    </p>

    <div class="space-y-4">
      <div class="bg-white p-6 rounded-[2rem] border border-slate-100 shadow-sm">
        <div class="flex items-start gap-4">
          <div class="w-8 h-8 rounded-full bg-med-gold/15 flex-shrink-0 flex items-center justify-center text-med-gold font-serif font-bold">1</div>
          <div>
            <h4 class="font-bold text-slate-900 mb-2 text-lg">Prohíbe los autobuses en las horas punta</h4>
            <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Tomar el <a href="/es-es/guia/bus-sita/" class="text-med-blue hover:underline">autobús SITA</a> entre las 11:00 y las 15:00 en agosto es un deporte de riesgo. Esperas a pleno sol y atascos monumentales. Usa los <a href="/es-es/guia/ferries/" class="text-med-blue hover:underline">ferris Travelmar</a>. Cuestan más, pero la brisa marina convierte el trayecto en un refrescante crucero panorámico.</p>
          </div>
        </div>
      </div>
      <div class="bg-white p-6 rounded-[2rem] border border-slate-100 shadow-sm">
        <div class="flex items-start gap-4">
          <div class="w-8 h-8 rounded-full bg-med-gold/15 flex-shrink-0 flex items-center justify-center text-med-gold font-serif font-bold">2</div>
          <div>
            <h4 class="font-bold text-slate-900 mb-2 text-lg">El "Faugn" nocturno</h4>
            <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Es el nombre local de la brisa cálida que baja de las montañas por la noche. A veces, a las 23:00, se levanta una ráfaga repentina de aire caliente y seco. Tenlo en cuenta si haces una excursión en barco a la luz de la luna: lleva siempre una camisa ligera de manga larga.</p>
          </div>
        </div>
      </div>
      <div class="bg-white p-6 rounded-[2rem] border border-slate-100 shadow-sm">
        <div class="flex items-start gap-4">
          <div class="w-8 h-8 rounded-full bg-med-gold/15 flex-shrink-0 flex items-center justify-center text-med-gold font-serif font-bold">3</div>
          <div>
            <h4 class="font-bold text-slate-900 mb-2 text-lg">Granizada táctica</h4>
            <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Cuando el calor te aplaste, busca los puestos callejeros que venden granizados caseros hechos al momento con auténticos limones Sfusati de Amalfi IGP. No es un cliché de Instagram, es el único remedio local real para reanimar la tensión y combatir la deshidratación de las escaleras.</p>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- El Verano en Cifras -->
  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">El Verano en Cifras</h2>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      Para los amantes de los datos limpios, aquí la síntesis de julio y agosto de 2026 en la Costa Amalfitana.
    </p>

    <div class="overflow-hidden rounded-[2rem] border border-slate-100 shadow-sm">
      <table class="w-full text-xs sm:text-sm">
        <thead class="bg-slate-900 text-white">
          <tr>
            <th class="text-left p-5 font-serif font-bold text-med-gold">Indicador climático</th>
            <th class="text-left p-5 font-serif font-bold text-med-gold">Julio</th>
            <th class="text-left p-5 font-serif font-bold text-med-gold">Agosto</th>
          </tr>
        </thead>
        <tbody class="bg-white">
          <tr class="border-b border-slate-100">
            <td class="p-5 font-bold">Máxima media diurna</td>
            <td class="p-5 text-slate-600">31°C</td>
            <td class="p-5 text-slate-600">32°C</td>
          </tr>
          <tr class="border-b border-slate-100">
            <td class="p-5 font-bold">Mínima media nocturna</td>
            <td class="p-5 text-slate-600">22°C</td>
            <td class="p-5 text-slate-600">23°C</td>
          </tr>
          <tr class="border-b border-slate-100">
            <td class="p-5 font-bold">Temperatura del mar</td>
            <td class="p-5 text-slate-600">25°C (fresca)</td>
            <td class="p-5 text-slate-600">27°C (cálida)</td>
          </tr>
          <tr class="border-b border-slate-100">
            <td class="p-5 font-bold">Días de lluvia</td>
            <td class="p-5 text-slate-600">Casi ninguno (1 día)</td>
            <td class="p-5 text-slate-600">Raras tormentas (3 días)</td>
          </tr>
          <tr class="border-b border-slate-100">
            <td class="p-5 font-bold">Humedad media</td>
