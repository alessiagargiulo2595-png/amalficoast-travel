---
import BaseLayout from '../../../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../../../components/Breadcrumbs.astro';
import LocalitySlider from '../../../../../components/LocalitySlider.astro';

const lang = 'es-es';

const breadcrumbs = [
  { name: 'Inicio', url: '/es-es/' },
  { name: 'Eventos', url: '/es-es/eventos/' },
  { name: 'Sorrento Meeting', url: '/es-es/eventos/peninsula-sorrentina/sorrento-meeting-cultura/' },
];

const eventSchema = {
  "@context": "https://schema.org",
  "@type": "EventSeries",
  "name": "Sorrento Meeting",
  "description": "El Sorrento Meeting de junio a julio de 2026. Encuentros vespertinos con autores de renombre internacional en el claustro gótico-árabe del siglo XIV de San Francesco.",
  "image": "https://amalficoast-travel.com/images/sorrento-hero.jpg",
  "url": "https://amalficoast-travel.com/es-es/eventos/peninsula-sorrentina/sorrento-meeting-cultura/",
  "location": {
      "@type": "Place",
      "name": "Claustro de San Francesco, Sorrento",
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Sorrento",
        "addressRegion": "NA",
        "addressCountry": "IT"
      }
    },
  "eventStatus": "https://schema.org/EventScheduled",
  "eventAttendanceMode": "https://schema.org/OfflineEventAttendanceMode",
  "startDate": "2026-06-01",
  "endDate": "2026-07-31",
  "subEvent": [
    {
      "@type": "Event",
      "name": "Sorrento Meeting 2026",
      "startDate": "2026-06-01",
      "endDate": "2026-07-31",
      "eventStatus": "https://schema.org/EventScheduled",
      "eventAttendanceMode": "https://schema.org/OfflineEventAttendanceMode",
      "location": {
          "@type": "Place",
          "name": "Claustro de San Francesco, Sorrento",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Sorrento",
            "addressRegion": "NA",
            "addressCountry": "IT"
          }
        },
      "url": "https://amalficoast-travel.com/es-es/eventos/peninsula-sorrentina/sorrento-meeting-cultura/",
      "image": "https://amalficoast-travel.com/images/sorrento-hero.jpg",
      "description": "El Sorrento Meeting de junio a julio de 2026. Encuentros vespertinos con autores de renombre internacional en el claustro gótico-árabe del siglo XIV de San Francesco."
    }
  ]
};

const facts = [
  { dt: 'Período', dd: 'Jun–Jul 2026' },
  { dt: 'Lugar', dd: 'Claustro de San Francesco' },
  { dt: 'Tipo', dd: 'Ciclo literario' },
  { dt: 'Acceso', dd: 'Reserva recomendada' },
  { dt: 'Desde Nápoles', dd: 'Circumvesuviana 70 min' },
];
---

<BaseLayout
  title="Sorrento Meeting 2026 – Literatura y Periodismo en el Claustro Gótico-Árabe"
  description="El Sorrento Meeting de junio a julio de 2026. Encuentros vespertinos con autores de renombre internacional en el claustro gótico-árabe del siglo XIV de San Francesco."
  lang={lang}
  breadcrumbs={breadcrumbs}
  schema={[eventSchema]}
 pageKey="sorrento-meeting-cultura"
  heroImage="/images/sorrento-hero.jpg"
>

  <!-- Hero -->
  <section class="relative h-[65vh] sm:h-[70vh] overflow-hidden flex items-center justify-center">
    <img
      src="/images/sorrento-hero.jpg"
      alt="Sorrento Meeting, Claustro de San Francesco"
      class="absolute inset-0 w-full h-full object-cover"
      loading="eager" fetchpriority="high" decoding="sync" referrerpolicy="no-referrer"
    />
    <div class="absolute inset-0 bg-gradient-to-b from-black/20 via-black/50 to-black/70"></div>
    <div class="relative z-10 text-center px-6 max-w-5xl text-white">
      <div class="flex flex-wrap justify-center items-center gap-4 mb-6">
        <span class="bg-med-gold text-white px-4 py-1 rounded-full text-[10px] font-bold uppercase tracking-widest">Evento 2026</span>
        <span class="text-white/70 text-xs sm:text-sm">Jun–Jul 2026</span>
        <span class="text-white/70 text-xs sm:text-sm">Sorrento, NA</span>
      </div>
      <h1 class="font-serif text-5xl md:text-7xl font-bold text-white leading-tight mb-6">Sorrento Meeting</h1>
      <p class="text-white/85 text-lg md:text-xl font-light max-w-2xl mx-auto leading-relaxed">
        Literatura y periodismo internacional en el claustro del siglo XIV.
      </p>
    </div>
    <Breadcrumbs breadcrumbs={breadcrumbs} isEvent={true} />
  </section>

  <!-- Content 70/30 -->
  <section class="py-12 sm:py-24 px-6 max-w-7xl mx-auto">
    <div class="grid grid-cols-1 lg:grid-cols-10 gap-16">

      <!-- Main Content (70%) -->
      <div class="lg:col-span-7 space-y-12">
        <div>
          <h2 class="font-serif text-4xl font-bold text-slate-900 mb-8">Sobre el Evento</h2>
          <div class="space-y-4 text-slate-600 text-lg leading-relaxed">
            <p>Una serie de encuentros literarios y periodísticos en el Claustro de San Francesco. Reuniones vespertinas con autores de renombre internacional. El claustro gótico-árabe del siglo XIV ofrece un escenario único para los encuentros culturales de este ciclo de verano.</p>
            <p>Los encuentros suelen tener lugar al atardecer, aprovechando la mágica luz vespertina del claustro. Los participantes pueden continuar la velada en los restaurantes y terrazas panorámicas del centro de Sorrento.</p>
          </div>
        </div>

        <!-- El Ciclo Cultural -->
        <div>
          <h3 class="font-serif text-2xl font-bold text-slate-900 mb-6">El Ciclo Cultural</h3>
          <div class="grid sm:grid-cols-2 gap-6">
            <div class="bg-white p-8 rounded-[2rem] border border-slate-100 shadow-sm">
              <span class="text-med-gold text-[10px] font-bold uppercase tracking-widest mb-2 block">Encuentros con autores</span>
              <h4 class="text-xl font-serif font-bold text-slate-900 mb-3">Literatura internacional</h4>
              <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Escritores, periodistas e intelectuales de renombre internacional se turnan en el claustro para presentar sus obras y dialogar con el público en un formato abierto e informal.</p>
            </div>
            <div class="bg-white p-8 rounded-[2rem] border border-slate-100 shadow-sm">
              <span class="text-med-gold text-[10px] font-bold uppercase tracking-widest mb-2 block">El Claustro</span>
              <h4 class="text-xl font-serif font-bold text-slate-900 mb-3">Un escenario único</h4>
              <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">El Claustro de San Francesco, con sus arcos gótico-árabes del siglo XIV, es uno de los lugares más evocadores de Sorrento y un activo centro cultural durante todo el verano.</p>
            </div>
          </div>
        </div>

        <!-- Cómo llegar -->
        <div>
          <h3 class="font-serif text-2xl font-bold text-slate-900 mb-6">Cómo llegar</h3>
          <div class="bg-white rounded-[2rem] border border-slate-100 overflow-hidden shadow-sm">
            <table class="w-full text-xs sm:text-xs sm:text-sm">
              <thead>
                <tr class="bg-slate-900 text-white">
                  <th class="text-left px-6 py-4 font-semibold">Transporte</th>
                  <th class="text-left px-6 py-4 font-semibold">Servicio</th>
                  <th class="text-left px-6 py-4 font-semibold">Notas</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-slate-100">
                <tr class="hover:bg-slate-50 transition-colors">
                  <td class="px-6 py-4 font-medium">Circumvesuviana</td>
                  <td class="px-6 py-4 text-slate-600">Desde Nápoles Garibaldi</td>
                  <td class="px-6 py-4 text-slate-500 text-xs">70 minutos, parada Sorrento</td>
                </tr>
                <tr class="hover:bg-slate-50 transition-colors">
                  <td class="px-6 py-4 font-medium">Ferry</td>
                  <td class="px-6 py-4 text-slate-600">Desde la costa o Nápoles</td>
                  <td class="px-6 py-4 text-slate-500 text-xs">Puerto de Sorrento, conexiones con las islas</td>
                </tr>
                <tr class="hover:bg-slate-50 transition-colors">
                  <td class="px-6 py-4 font-medium">A pie</td>
                  <td class="px-6 py-4 text-slate-600">Desde el centro de Sorrento</td>
                  <td class="px-6 py-4 text-slate-500 text-xs">5 minutos desde la Piazza Tasso</td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>
      </div>

      <!-- Sidebar (30%) -->
      <aside class="lg:col-span-3">
        <div class="bg-slate-900 text-white p-10 rounded-[3rem] sticky top-32 shadow-2xl">
          <p class="text-[10px] uppercase tracking-[0.3em] text-med-gold font-medium mb-6">Detalles del Evento</p>
          <dl class="space-y-4">
            {facts.map(({ dt, dd }, i) => (
              <>
                <div>
                  <dt class="text-white/40 text-[10px] uppercase tracking-widest font-bold mb-1">{dt}</dt>
                  <dd class="text-white font-medium">{dd}</dd>
                </div>
                {i < facts.length - 1 && <div class="border-t border-white/5"></div>}
              </>
            ))}
          </dl>
          <div class="mt-10 pt-8 border-t border-white/5">
            <p class="text-white/50 text-xs leading-relaxed">Recomendamos llegar con antelación. Consulta el programa actualizado en los canales oficiales.</p>
          </div>
        </div>
      </aside>

    </div>
  </section>

  <LocalitySlider
    heading="Descubre Sorrento"
    lang={lang}
    items={[
      { name: "Sorrento", href: '/es-es/peninsula-sorrentina/sorrento/', image: '/images/sorrento-hero.jpg', tag: "Sede del evento" },
      { name: "Sant'Agnello", href: '/es-es/peninsula-sorrentina/sant-agnello/', image: '/images/sorrento-hero.jpg', tag: "Cercana" },
      { name: "Meta", href: '/es-es/peninsula-sorrentina/meta/', image: '/images/meta-hero.webp', tag: "Cercana" },
      { name: "Massa Lubrense", href: '/es-es/peninsula-sorrentina/massa-lubrense/', image: '/images/massa-lubrense-hero.jpg', tag: "Naturaleza" },
    ]}
  />

    <!-- BANNER: Itinerary Planner -->
  <section class="py-10 md:py-14 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6">
      <div class="relative overflow-hidden rounded-[2.5rem] bg-gradient-to-br from-slate-900 via-slate-950 to-blue-950 px-6 sm:px-10 md:px-14 py-10 md:py-14 shadow-[0_20px_60px_rgba(0,0,0,0.35)]">
        <div class="absolute -top-20 -left-20 w-72 h-72 bg-blue-500/15 rounded-full blur-3xl pointer-events-none"></div>
        <div class="absolute -bottom-20 -right-20 w-72 h-72 bg-amber-500/10 rounded-full blur-3xl pointer-events-none"></div>
        <div class="relative z-10 grid md:grid-cols-[3fr_2fr] md:items-center gap-8">
          <div>
            <span class="inline-block px-4 py-1.5 rounded-full text-xs font-semibold tracking-wide uppercase bg-med-gold/15 text-med-gold border border-med-gold/25 mb-6">Novedad: Viaje a Medida</span>
            <h2 class="text-3xl md:text-4xl font-bold text-white leading-tight mb-2">Diseña tu</h2>
            <p class="font-serif text-3xl md:text-4xl italic text-med-blue mb-5">itinerario ideal</p>
            <p class="text-white/60 text-base md:text-lg leading-relaxed max-w-xl mb-8">
              Responde a unas sencillas preguntas - punto de partida, días e intereses - y recibe un itinerario personalizado con transporte, costos y horarios.
            </p>
            <div class="flex flex-wrap gap-6">
              <div class="flex items-center gap-2.5">
                <div class="w-9 h-9 rounded-xl bg-white/5 border border-white/10 flex items-center justify-center">
                  <svg class="w-4 h-4 text-med-gold" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                </div>
                <span class="text-white/50 text-sm">30 segundos para configurar</span>
              </div>
              <div class="flex items-center gap-2.5">
                <div class="w-9 h-9 rounded-xl bg-white/5 border border-white/10 flex items-center justify-center">
                  <svg class="w-4 h-4 text-med-gold" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 6.75V15m6-6v8.25m.503 3.498l4.875-2.437c.381-.19.622-.58.622-1.006V4.82c0-.836-.88-1.38-1.628-1.006l-3.869 1.934c-.317.159-.69.159-1.006 0L9.503 3.252a1.125 1.125 0 00-1.006 0L3.622 5.689C3.24 5.88 3 6.27 3 6.695V19.18c0 .836.88 1.38 1.628 1.006l3.869-1.934c.317-.159.69-.159 1.006 0l4.994 2.497c.317.158.69.158 1.006 0z"/></svg>
                </div>
                <span class="text-white/50 text-sm">Consejos anti-multitud incluidos</span>
              </div>
            </div>
          </div>
          <div class="mt-8 md:mt-0 md:flex md:justify-center">
            <a href="/es-es/planificador-itinerario/" class="inline-flex items-center gap-2.5 px-7 py-3.5 bg-gradient-to-r from-med-gold to-yellow-600 text-slate-900 font-bold rounded-xl hover:shadow-[0_0_30px_rgba(212,175,55,0.4)] hover:scale-105 transition-all duration-300">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 2L2 12l4 0 0 6 4 0 0-4 4 0 0 4 4 0 0-6 4 0L12 2z"/></svg>
              Configurar Ahora
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Eventos Relacionados -->
  <section class="py-4 sm:py-12 px-6 max-w-7xl mx-auto">
    <h2 class="font-serif text-3xl sm:text-4xl font-bold text-slate-900 mb-12">Eventos Relacionados</h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
      <a href="/es-es/eventos/peninsula-sorrentina/festa-sant-antonino/" class="block bg-white rounded-[2rem] border border-slate-100 overflow-hidden shadow-sm hover:shadow-md transition-shadow">
        <img src="/images/sorrento-hero.jpg" alt="Antonino" class="h-40 w-full object-cover" />
        <div class="p-6">
          <span class="text-med-gold text-[10px] font-bold uppercase tracking-widest mb-2 block">Febrero 2026</span>
          <h3 class="font-serif text-lg font-bold text-slate-900 mb-2">Festa Sant'Antonino</h3>
          <p class="text-slate-600 text-sm mb-4">Celebración del patrón con procesiones y festividades.</p>
          <p class="text-slate-500 text-xs font-medium">📍 Sorrento, NA</p>
        </div>
      </a>
      <a href="/es-es/eventos/peninsula-sorrentina/gustamincanto-vico-equense/" class="block bg-white rounded-[2rem] border border-slate-100 overflow-hidden shadow-sm hover:shadow-md transition-shadow">
        <img src="/images/vico-equense-hero.jpg" alt="Gustamincanto" class="h-40 w-full object-cover" />
        <div class="p-6">
          <span class="text-med-gold text-[10px] font-bold uppercase tracking-widest mb-2 block">Septiembre 2026</span>
          <h3 class="font-serif text-lg font-bold text-slate-900 mb-2">Gustamincanto</h3>
          <p class="text-slate-600 text-sm mb-4">Festival de gastronomía local y tradiciones culinarias.</p>
          <p class="text-slate-500 text-xs font-medium">📍 Vico Equense, NA</p>
        </div>
      </a>
      <a href="/es-es/eventos/peninsula-sorrentina/sagra-limone-massa-lubrense/" class="block bg-white rounded-[2rem] border border-slate-100 overflow-hidden shadow-sm hover:shadow-md transition-shadow">
        <img src="/images/massa-lubrense-hero.jpg" alt="Limón" class="h-40 w-full object-cover" />
        <div class="p-6">
          <span class="text-med-gold text-[10px] font-bold uppercase tracking-widest mb-2 block">Junio 2026</span>
          <h3 class="font-serif text-lg font-bold text-slate-900 mb-2">Sagra del Limón</h3>
          <p class="text-slate-600 text-sm mb-4">Celebración de los famosos limones de Sorrento.</p>
          <p class="text-slate-500 text-xs font-medium">📍 Massa Lubrense, NA</p>
        </div>
      </a>
    </div>
  </section>

  <!-- Destinazione CTA -->
  <section class="bg-med-blue text-white py-12 sm:py-16 px-6">
    <div class="max-w-7xl mx-auto">
      <div class="flex flex-col sm:flex-row items-center justify-between gap-8">
        <div>
          <h3 class="font-serif text-2xl sm:text-3xl font-bold mb-3">Explora Sorrento</h3>
          <p class="text-white/70 text-sm sm:text-base max-w-md">Ciudad con vistas en los acantilados, jardines y vinos dulces.</p>
        </div>
        <a href="/es-es/peninsula-sorrentina/sorrento/" class="bg-med-gold text-white px-8 py-3 rounded-full font-medium hover:bg-yellow-500 transition-colors whitespace-nowrap">
          View Destination →
        </a>
      </div>
    </div>
  </section>


