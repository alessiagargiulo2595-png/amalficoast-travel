---
import BaseLayout from '../../../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../../../components/Breadcrumbs.astro';
import LocalitySlider from '../../../../../components/LocalitySlider.astro';

const lang = 'es-es';

const breadcrumbs = [
  { name: 'Inicio', url: '/es-es/' },
  { name: 'Eventos', url: '/es-es/eventos/' },
  { name: 'Fiesta del Limón – Massa Lubrense', url: '/es-es/eventos/peninsula-sorrentina/sagra-limone-massa-lubrense/' },
];

const eventSchema = {
  "@context": "https://schema.org",
  "@type": "EventSeries",
  "name": "Fiesta del Limón Massa Lubrense",
  "description": "La Fiesta del Limón en Massa Lubrense los días 11 y 12 de julio de 2026. Rutas de degustación por los portales históricos del pueblo celebrando el limón Femminiello IGP.",
  "image": "https://amalficoast-travel.com/images/massa-lubrense-hero.jpg",
  "url": "https://amalficoast-travel.com/es-es/eventos/peninsula-sorrentina/sagra-limone-massa-lubrense/",
  "location": {
      "@type": "Place",
      "name": "Centro histórico, Massa Lubrense",
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Massa Lubrense",
        "addressRegion": "NA",
        "addressCountry": "IT"
      }
    },
  "eventStatus": "https://schema.org/EventScheduled",
  "eventAttendanceMode": "https://schema.org/OfflineEventAttendanceMode",
  "subEvent": [
    {
      "@type": "Event",
      "name": "Fiesta del Limón Massa Lubrense 2026",
      "startDate": "2026-07-11",
      "endDate": "2026-07-12",
      "eventStatus": "https://schema.org/EventScheduled",
      "eventAttendanceMode": "https://schema.org/OfflineEventAttendanceMode",
      "location": {
          "@type": "Place",
          "name": "Centro histórico, Massa Lubrense",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Massa Lubrense",
            "addressRegion": "NA",
            "addressCountry": "IT"
          }
        },
      "url": "https://amalficoast-travel.com/es-es/eventos/peninsula-sorrentina/sagra-limone-massa-lubrense/",
      "image": "https://amalficoast-travel.com/images/massa-lubrense-hero.jpg",
      "description": "La Fiesta del Limón en Massa Lubrense los días 11 y 12 de julio de 2026. Rutas de degustación por los portales históricos del pueblo celebrando el limón Femminiello IGP."
    }
  ]
};

const facts = [
  { dt: 'Fecha', dd: '11–12 julio 2026' },
  { dt: 'Producto', dd: 'Limón Femminiello IGP' },
  { dt: 'Lugar', dd: 'Centro histórico, Massa Lubrense' },
  { dt: 'Acceso', dd: 'Autobús EAV desde Sorrento cada 20 min' },
  { dt: 'Entrada', dd: 'Gratuita' },
];
---

<BaseLayout
  title="Fiesta del Limón Massa Lubrense 2026 – Degustaciones y Mercados"
  description="La Fiesta del Limón en Massa Lubrense los días 11 y 12 de julio de 2026. Rutas de degustación por los portales históricos del pueblo celebrando el limón Femminiello IGP."
  lang={lang}
  breadcrumbs={breadcrumbs}
  schema={[eventSchema]}
 pageKey="sagra-limone-massa-lubrense"
  heroImage="/images/massa-lubrense-hero.jpg"
>

  <!-- Hero -->
  <section class="relative h-[65vh] sm:h-[70vh] overflow-hidden flex items-center justify-center">
    <img
      src="/images/massa-lubrense-hero.jpg"
      alt="Fiesta del Limón, Massa Lubrense"
      class="absolute inset-0 w-full h-full object-cover"
      loading="eager" fetchpriority="high" decoding="sync" referrerpolicy="no-referrer"
    />
    <div class="absolute inset-0 bg-gradient-to-b from-black/20 via-black/50 to-black/70"></div>
    <div class="relative z-10 text-center px-6 max-w-5xl text-white">
      <div class="flex flex-wrap justify-center items-center gap-4 mb-6">
        <span class="bg-med-gold text-white px-4 py-1 rounded-full text-[10px] font-bold uppercase tracking-widest">Evento 2026</span>
        <span class="text-white/70 text-xs sm:text-sm">11–12 julio 2026</span>
        <span class="text-white/70 text-xs sm:text-sm">Massa Lubrense, NA</span>
      </div>
      <h1 class="font-serif text-5xl md:text-7xl font-bold text-white leading-tight mb-6">Fiesta del Limón</h1>
      <p class="text-white/85 text-lg md:text-xl font-light max-w-2xl mx-auto leading-relaxed">
        El limón Femminiello IGP como protagonista entre los portales históricos de Massa Lubrense.
      </p>
    </div>
    <Breadcrumbs breadcrumbs={breadcrumbs} isEvent={true} />
  </section>

  <!-- Content 70/30 -->
  <section class="py-12 sm:py-24 px-6 max-w-7xl mx-auto">
    <div class="grid grid-cols-1 lg:grid-cols-10 gap-16">

      <!-- Main Content (70%) -->
      <div class="lg:col-span-7 space-y-12">
        <div>
          <h2 class="font-serif text-4xl font-bold text-slate-900 mb-8">Sobre el Evento</h2>
          <div class="space-y-4 text-slate-600 text-lg leading-relaxed">
            <p>Un evento gastronómico dedicado a celebrar el limón local. Incluye rutas de degustación por los portales históricos del pueblo y mercados de artesanía. Transporte en autobús EAV desde la Piazza Tasso de Sorrento cada 20 minutos.</p>
            <p>El limón Femminiello de la Península Sorrentina es uno de los símbolos de la agricultura local, protegido por una indicación geográfica. La fiesta es una oportunidad para conocer a los productores locales y degustar limoncello, granita y especialidades elaboradas con limón.</p>
          </div>
        </div>

        <!-- Rutas de Degustación -->
        <div>
          <h3 class="font-serif text-2xl font-bold text-slate-900 mb-6">Rutas de Degustación</h3>
          <div class="grid sm:grid-cols-2 gap-6">
            <div class="bg-white p-8 rounded-[2rem] border border-slate-100 shadow-sm">
              <span class="text-med-gold text-[10px] font-bold uppercase tracking-widest mb-2 block">Limoncello artesanal</span>
              <h4 class="text-xl font-serif font-bold text-slate-900 mb-3">Del huerto a la botella</h4>
              <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Los productores locales abren sus talleres para mostrar el proceso de elaboración del limoncello tradicional con cáscara de Femminiello ecológico.</p>
            </div>
            <div class="bg-white p-8 rounded-[2rem] border border-slate-100 shadow-sm">
              <span class="text-med-gold text-[10px] font-bold uppercase tracking-widest mb-2 block">Cocina al limón</span>
              <h4 class="text-xl font-serif font-bold text-slate-900 mb-3">Gastronomía local</h4>
              <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Tartas de limón, granita, pasta al limón y dulces tradicionales animan los puestos gastronómicos a lo largo del recorrido por los portales históricos del pueblo.</p>
            </div>
          </div>
        </div>

        <!-- Cómo llegar -->
        <div>
          <h3 class="font-serif text-2xl font-bold text-slate-900 mb-6">Cómo llegar</h3>
          <div class="bg-white rounded-[2rem] border border-slate-100 overflow-hidden shadow-sm">
            <table class="w-full text-xs sm:text-xs sm:text-sm">
              <thead>
                <tr class="bg-slate-900 text-white">
                  <th class="text-left px-6 py-4 font-semibold">Transporte</th>
                  <th class="text-left px-6 py-4 font-semibold">Servicio</th>
                  <th class="text-left px-6 py-4 font-semibold">Notas</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-slate-100">
                <tr class="hover:bg-slate-50 transition-colors">
                  <td class="px-6 py-4 font-medium">Autobús EAV</td>
                  <td class="px-6 py-4 text-slate-600">Desde Sorrento Piazza Tasso</td>
                  <td class="px-6 py-4 text-slate-500 text-xs">Cada 20 minutos</td>
                </tr>
                <tr class="hover:bg-slate-50 transition-colors">
                  <td class="px-6 py-4 font-medium">Coche</td>
                  <td class="px-6 py-4 text-slate-600">SS145 Sorrentina</td>
                  <td class="px-6 py-4 text-slate-500 text-xs">Aparcamiento junto a la carretera principal</td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>
      </div>

      <!-- Sidebar (30%) -->
      <aside class="lg:col-span-3">
        <div class="bg-slate-900 text-white p-10 rounded-[3rem] sticky top-32 shadow-2xl">
          <p class="text-[10px] uppercase tracking-[0.3em] text-med-gold font-medium mb-6">Detalles del Evento</p>
          <dl class="space-y-4">
            {facts.map(({ dt, dd }, i) => (
              <>
                <div>
                  <dt class="text-white/40 text-[10px] uppercase tracking-widest font-bold mb-1">{dt}</dt>
                  <dd class="text-white font-medium">{dd}</dd>
                </div>
                {i < facts.length - 1 && <div class="border-t border-white/5"></div>}
              </>
            ))}
          </dl>
          <div class="mt-10 pt-8 border-t border-white/5">
            <p class="text-white/50 text-xs leading-relaxed">Recomendamos llegar con antelación. Consulta el programa actualizado en los canales oficiales.</p>
          </div>
        </div>
      </aside>

    </div>
  </section>

  <LocalitySlider
    heading="Descubre Massa Lubrense"
    lang={lang}
    items={[
      { name: "Massa Lubrense", href: '/es-es/peninsula-sorrentina/massa-lubrense/', image: '/images/massa-lubrense-hero.jpg', tag: "Sede del evento" },
      { name: "Sorrento", href: '/es-es/peninsula-sorrentina/sorrento/', image: '/images/sorrento-hero.jpg', tag: "Icónica" },
      { name: "Sant'Agnello", href: '/es-es/peninsula-sorrentina/sant-agnello/', image: '/images/sorrento-hero.jpg', tag: "Cercana" },
      { name: "Vico Equense", href: '/es-es/peninsula-sorrentina/vico-equense/', image: '/images/vico-equense-hero.jpg', tag: "Gastronomía" },
    ]}
  />

  <!-- Eventos Relacionados -->
  <section class="py-4 sm:py-12 px-6 max-w-7xl mx-auto">
    <h2 class="font-serif text-3xl sm:text-4xl font-bold text-slate-900 mb-12">Eventos Relacionados</h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
      <a href="/es-es/eventos/peninsula-sorrentina/gustamincanto-vico-equense/" class="block bg-white rounded-[2rem] border border-slate-100 overflow-hidden shadow-sm hover:shadow-md transition-shadow">
        <img src="/images/sorrento-hero.jpg" alt="Gustamincanto" class="h-40 w-full object-cover" />
        <div class="p-6">
          <span class="text-med-gold text-[10px] font-bold uppercase tracking-widest mb-2 block">Septiembre 2026</span>
          <h3 class="font-serif text-lg font-bold text-slate-900 mb-2">Gustamincanto</h3>
          <p class="text-slate-600 text-sm mb-4">Festival de gastronomía local y tradiciones culinarias.</p>
          <p class="text-slate-500 text-xs font-medium">📍 Vico Equense, NA</p>
        </div>
      </a>
      <a href="/es-es/eventos/peninsula-sorrentina/madonna-della-libera/" class="block bg-white rounded-[2rem] border border-slate-100 overflow-hidden shadow-sm hover:shadow-md transition-shadow">
        <img src="/images/sorrento-hero.jpg" alt="Madonna" class="h-40 w-full object-cover" />
        <div class="p-6">
          <span class="text-med-gold text-[10px] font-bold uppercase tracking-widest mb-2 block">Agosto 2026</span>
          <h3 class="font-serif text-lg font-bold text-slate-900 mb-2">Madonna della Libera</h3>
          <p class="text-slate-600 text-sm mb-4">Celebración religiosa en honor a la Virgen María.</p>
          <p class="text-slate-500 text-xs font-medium">📍 Massa Lubrense, NA</p>
        </div>
      </a>
      <a href="/es-es/eventos/peninsula-sorrentina/sagra-melanzana-preazzano/" class="block bg-white rounded-[2rem] border border-slate-100 overflow-hidden shadow-sm hover:shadow-md transition-shadow">
        <img src="/images/sorrento-hero.jpg" alt="Berenjena" class="h-40 w-full object-cover" />
        <div class="p-6">
          <span class="text-med-gold text-[10px] font-bold uppercase tracking-widest mb-2 block">Septiembre 2026</span>
          <h3 class="font-serif text-lg font-bold text-slate-900 mb-2">Sagra Berenjena</h3>
          <p class="text-slate-600 text-sm mb-4">Celebración de la berenjena local con demostraciones.</p>
          <p class="text-slate-500 text-xs font-medium">📍 Preazzano, NA</p>
        </div>
      </a>
    </div>
  </section>

  <!-- Destinazione CTA -->
  <section class="bg-med-blue text-white py-12 sm:py-16 px-6">
    <div class="max-w-7xl mx-auto">
      <div class="flex flex-col sm:flex-row items-center justify-between gap-8">
        <div>
          <h3 class="font-serif text-2xl sm:text-3xl font-bold mb-3">Explora Massa Lubrense</h3>
          <p class="text-white/70 text-sm sm:text-base max-w-md">Pueblo tranquilo con senderismo, playas y vista al mar.</p>
        </div>
        <a href="/es-es/peninsula-sorrentina/massa-lubrense/" class="bg-med-gold text-white px-8 py-3 rounded-full font-medium hover:bg-yellow-500 transition-colors whitespace-nowrap">
          View Destination →
        </a>
      </div>
    </div>
  </section>


