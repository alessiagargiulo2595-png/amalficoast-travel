---
import BaseLayout from '../../../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../../../components/Breadcrumbs.astro';
import LocalitySlider from '../../../../../components/LocalitySlider.astro';

const lang = 'es-es';

const breadcrumbs = [
  { name: 'Inicio', url: '/es-es/' },
  { name: 'Eventos', url: '/es-es/eventos/' },
  { name: 'Regata Histórica Marítima', url: '/es-es/eventos/costa-amalfi/regata-storica-amalfi/' },
];

const eventSchema = {
  "@context": "https://schema.org",
  "@type": "EventSeries",
  "name": "Regata Histórica Marítima Amalfi",
  "description": "La Regata Histórica de las Antiguas Repúblicas Marítimas 2026 en Amalfi. Desfiles de trajes medievales y la carrera de remos entre Amalfi, Venecia, Génova y Pisa en el puerto.",
  "image": "https://amalficoast-travel.com/images/amalfi-hero.jpg",
  "url": "https://amalficoast-travel.com/es-es/eventos/costa-amalfi/regata-storica-amalfi/",
  "location": {
      "@type": "Place",
      "name": "Puerto de Amalfi",
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Amalfi",
        "addressRegion": "SA",
        "addressCountry": "IT"
      }
    },
  "eventStatus": "https://schema.org/EventScheduled",
  "eventAttendanceMode": "https://schema.org/OfflineEventAttendanceMode",
  "subEvent": [
    {
      "@type": "Event",
      "name": "Regata Histórica Marítima Amalfi 2026",
      "startDate": "2026-06-01",
      "endDate": "2026-06-30",
      "eventStatus": "https://schema.org/EventScheduled",
      "eventAttendanceMode": "https://schema.org/OfflineEventAttendanceMode",
      "location": {
          "@type": "Place",
          "name": "Puerto de Amalfi",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Amalfi",
            "addressRegion": "SA",
            "addressCountry": "IT"
          }
        },
      "url": "https://amalficoast-travel.com/es-es/eventos/costa-amalfi/regata-storica-amalfi/",
      "image": "https://amalficoast-travel.com/images/amalfi-hero.jpg",
      "description": "La Regata Histórica de las Antiguas Repúblicas Marítimas 2026 en Amalfi. Desfiles de trajes medievales y la carrera de remos entre Amalfi, Venecia, Génova y Pisa en el puerto."
    }
  ]
};

const facts = [
  { dt: 'Período', dd: 'Junio 2026' },
  { dt: 'Sede', dd: 'Puerto de Amalfi' },
  { dt: 'Tipo', dd: 'Regata histórica y desfile' },
  { dt: 'Trajes', dd: 'Medievales, espectaculares' },
  { dt: 'Desde Nápoles', dd: 'Ferry 1h30' },
];
---

<BaseLayout
  title="Regata Histórica Marítima Amalfi 2026 – Desfile Medieval y Carrera de Remos"
  description="La Regata Histórica de las Antiguas Repúblicas Marítimas 2026 en Amalfi. Desfiles de trajes medievales y la carrera de remos entre Amalfi, Venecia, Génova y Pisa en el puerto."
  lang={lang}
  breadcrumbs={breadcrumbs}
  schema={[eventSchema]}
 pageKey="regata-storica-amalfi"
  heroImage="/images/amalfi-hero.jpg"
>

  <!-- Hero -->
  <section class="relative h-[65vh] sm:h-[70vh] overflow-hidden flex items-center justify-center">
    <img
      src="/images/amalfi-hero.jpg"
      alt="Regata Histórica Marítima, Amalfi"
      class="absolute inset-0 w-full h-full object-cover"
      loading="eager" fetchpriority="high" decoding="sync" referrerpolicy="no-referrer"
    />
    <div class="absolute inset-0 bg-gradient-to-b from-black/20 via-black/50 to-black/70"></div>
    <div class="relative z-10 text-center px-6 max-w-5xl text-white">
      <div class="flex flex-wrap justify-center items-center gap-4 mb-6">
        <span class="bg-med-gold text-white px-4 py-1 rounded-full text-[10px] font-bold uppercase tracking-widest">Evento 2026</span>
        <span class="text-white/70 text-xs sm:text-sm">Junio 2026</span>
        <span class="text-white/70 text-xs sm:text-sm">Amalfi, SA</span>
      </div>
      <h1 class="font-serif text-5xl md:text-7xl font-bold text-white leading-tight mb-6">Regata Histórica Marítima</h1>
      <p class="text-white/85 text-lg md:text-xl font-light max-w-2xl mx-auto leading-relaxed">
        Amalfi, Venecia, Génova y Pisa compiten en el mar con desfiles de trajes medievales.
      </p>
    </div>
    <Breadcrumbs breadcrumbs={breadcrumbs} isEvent={true} />
  </section>

  <!-- Contenido 70/30 -->
  <section class="py-12 sm:py-24 px-6 max-w-7xl mx-auto">
    <div class="grid grid-cols-1 lg:grid-cols-10 gap-16">

      <!-- Contenido Principal (70%) -->
      <div class="lg:col-span-7 space-y-12">
        <div>
          <h2 class="font-serif text-4xl font-bold text-slate-900 mb-8">Sobre el Evento</h2>
          <div class="space-y-4 text-slate-600 text-lg leading-relaxed">
            <p>La Regata de las Antiguas Repúblicas Marítimas es uno de los espectáculos históricos más impresionantes de Italia. Cuatro ciudades que fueron potencias marítimas medievales - Amalfi, Venecia, Génova y Pisa - compiten en una carrera de remos a bordo de galeras históricas, precedida por un desfile de más de trescientos participantes en traje de época.</p>
            <p>Cuando la regata se celebra en Amalfi, el puerto se transforma en un extraordinario escenario medieval: las coloridas casas en los acantilados, la catedral al fondo y las galeras con sus velas de colores ofrecen un espectáculo inolvidable. Los trajes, armaduras y estandartes de las cuatro repúblicas transportan la ciudad a su glorioso pasado marítimo.</p>
          </div>
        </div>

        <!-- El Programa -->
        <div>
          <h3 class="font-serif text-2xl font-bold text-slate-900 mb-6">El Programa</h3>
          <div class="grid sm:grid-cols-2 gap-6">
            <div class="bg-white p-8 rounded-[2rem] border border-slate-100 shadow-sm">
              <span class="text-med-gold text-[10px] font-bold uppercase tracking-widest mb-2 block">El Desfile Histórico</span>
              <h4 class="text-xl font-serif font-bold text-slate-900 mb-3">Trescientos participantes en traje</h4>
              <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">La procesión histórica recorre las calles del casco antiguo de Amalfi con más de trescientos participantes en traje medieval representando las cuatro repúblicas, sus dux, capitanes y marineros.</p>
            </div>
            <div class="bg-white p-8 rounded-[2rem] border border-slate-100 shadow-sm">
              <span class="text-med-gold text-[10px] font-bold uppercase tracking-widest mb-2 block">La Carrera de Remos</span>
              <h4 class="text-xl font-serif font-bold text-slate-900 mb-3">Galeras históricas en el mar</h4>
              <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Cuatro tripulaciones de ocho remeros compiten en galeras históricas en el puerto de Amalfi. La ciudad ganadora conserva el trofeo hasta la próxima edición en una de las otras cuatro ciudades.</p>
            </div>
          </div>
        </div>

        <!-- Cómo llegar -->
        <div>
          <h3 class="font-serif text-2xl font-bold text-slate-900 mb-6">Cómo Llegar</h3>
          <div class="bg-white rounded-[2rem] border border-slate-100 overflow-hidden shadow-sm">
            <table class="w-full text-xs sm:text-xs sm:text-sm">
              <thead>
                <tr class="bg-slate-900 text-white">
                  <th class="text-left px-6 py-4 font-semibold">Transporte</th>
                  <th class="text-left px-6 py-4 font-semibold">Servicio</th>
                  <th class="text-left px-6 py-4 font-semibold">Notas</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-slate-100">
                <tr class="hover:bg-slate-50 transition-colors">
                  <td class="px-6 py-4 font-medium">Ferry</td>
                  <td class="px-6 py-4 text-slate-600">Desde Nápoles</td>
                  <td class="px-6 py-4 text-slate-500 text-xs">1h30, directo al puerto de Amalfi</td>
                </tr>
                <tr class="hover:bg-slate-50 transition-colors">
                  <td class="px-6 py-4 font-medium">Bus SITA</td>
                  <td class="px-6 py-4 text-slate-600">Desde Sorrento o Salerno</td>
                  <td class="px-6 py-4 text-slate-500 text-xs">SS163, parada Amalfi centro</td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>
      </div>

      <!-- Sidebar (30%) -->
      <aside class="lg:col-span-3">
        <div class="bg-slate-900 text-white p-10 rounded-[3rem] sticky top-32 shadow-2xl">
          <p class="text-[10px] uppercase tracking-[0.3em] text-med-gold font-medium mb-6">Detalles del Evento</p>
          <dl class="space-y-4">
            {facts.map(({ dt, dd }, i) => (
              <>
                <div>
                  <dt class="text-white/40 text-[10px] uppercase tracking-widest font-bold mb-1">{dt}</dt>
                  <dd class="text-white font-medium">{dd}</dd>
                </div>
                {i < facts.length - 1 && <div class="border-t border-white/5"></div>}
              </>
            ))}
          </dl>
          <div class="mt-10 pt-8 border-t border-white/5">
            <p class="text-white/50 text-xs leading-relaxed">Recomendamos llegar con antelación. Consulte el programa actualizado en los canales oficiales.</p>
          </div>
        </div>
      </aside>

    </div>
  </section>

  <LocalitySlider
    heading="Localidades de la Costa Amalfitana"
    lang={lang}
    items={[
      { name: "Amalfi", href: '/es-es/costa-amalfitana/amalfi/', image: '/images/amalfi-hero.jpg', tag: "Sede del evento" },
      { name: "Ravello", href: '/es-es/costa-amalfitana/ravello/', image: '/images/ravello-hero.jpg', tag: "Cultura" },
      { name: "Positano", href: '/es-es/costa-amalfitana/positano/', image: '/images/positano-hero.jpg', tag: "Icónica" },
      { name: "Praiano", href: '/es-es/costa-amalfitana/praiano/', image: '/images/praiano-hero.jpg', tag: "Auténtica" },
    ]}
  />

    <!-- BANNER: Itinerary Planner -->
  <section class="py-10 md:py-14 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6">
      <div class="relative overflow-hidden rounded-[2.5rem] bg-gradient-to-br from-slate-900 via-slate-950 to-blue-950 px-6 sm:px-10 md:px-14 py-10 md:py-14 shadow-[0_20px_60px_rgba(0,0,0,0.35)]">
        <div class="absolute -top-20 -left-20 w-72 h-72 bg-blue-500/15 rounded-full blur-3xl pointer-events-none"></div>
        <div class="absolute -bottom-20 -right-20 w-72 h-72 bg-amber-500/10 rounded-full blur-3xl pointer-events-none"></div>
        <div class="relative z-10 grid md:grid-cols-[3fr_2fr] md:items-center gap-8">
          <div>
            <span class="inline-block px-4 py-1.5 rounded-full text-xs font-semibold tracking-wide uppercase bg-med-gold/15 text-med-gold border border-med-gold/25 mb-6">Novedad: Viaje a Medida</span>
            <h2 class="text-3xl md:text-4xl font-bold text-white leading-tight mb-2">Diseña tu</h2>
            <p class="font-serif text-3xl md:text-4xl italic text-med-blue mb-5">itinerario ideal</p>
            <p class="text-white/60 text-base md:text-lg leading-relaxed max-w-xl mb-8">
              Responde a unas sencillas preguntas - punto de partida, días e intereses - y recibe un itinerario personalizado con transporte, costos y horarios.
            </p>
            <div class="flex flex-wrap gap-6">
              <div class="flex items-center gap-2.5">
                <div class="w-9 h-9 rounded-xl bg-white/5 border border-white/10 flex items-center justify-center">
                  <svg class="w-4 h-4 text-med-gold" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                </div>
                <span class="text-white/50 text-sm">30 segundos para configurar</span>
              </div>
              <div class="flex items-center gap-2.5">
                <div class="w-9 h-9 rounded-xl bg-white/5 border border-white/10 flex items-center justify-center">
                  <svg class="w-4 h-4 text-med-gold" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 6.75V15m6-6v8.25m.503 3.498l4.875-2.437c.381-.19.622-.58.622-1.006V4.82c0-.836-.88-1.38-1.628-1.006l-3.869 1.934c-.317.159-.69.159-1.006 0L9.503 3.252a1.125 1.125 0 00-1.006 0L3.622 5.689C3.24 5.88 3 6.27 3 6.695V19.18c0 .836.88 1.38 1.628 1.006l3.869-1.934c.317-.159.69-.159 1.006 0l4.994 2.497c.317.158.69.158 1.006 0z"/></svg>
                </div>
                <span class="text-white/50 text-sm">Consejos anti-multitud incluidos</span>
              </div>
            </div>
          </div>
          <div class="mt-8 md:mt-0 md:flex md:justify-center">
            <a href="/es-es/planificador-itinerario/" class="inline-flex items-center gap-2.5 px-7 py-3.5 bg-gradient-to-r from-med-gold to-yellow-600 text-slate-900 font-bold rounded-xl hover:shadow-[0_0_30px_rgba(212,175,55,0.4)] hover:scale-105 transition-all duration-300">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 2L2 12l4 0 0 6 4 0 0-4 4 0 0 4 4 0 0-6 4 0L12 2z"/></svg>
              Configurar Ahora
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Eventos Correlados -->
  <section class="py-4 sm:py-12 px-6 max-w-7xl mx-auto">
    <h2 class="font-serif text-3xl sm:text-4xl font-bold text-slate-900 mb-12">Eventos Relacionados</h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
      <!-- Card 1 -->
      <a href="/es-es/eventos/costa-amalfitana/festa-sant-andrea-amalfi/" class="block bg-white rounded-[2rem] border border-slate-100 overflow-hidden shadow-sm hover:shadow-md transition-shadow">
        <img src="/images/amalfi-hero.jpg" alt="Festa di Sant'Andrea" class="h-40 w-full object-cover" />
        <div class="p-6">
          <span class="text-med-gold text-[10px] font-bold uppercase tracking-widest mb-2 block">Junio 2026</span>
          <h3 class="font-serif text-lg font-bold text-slate-900 mb-2">Festa di Sant'Andrea</h3>
          <p class="text-slate-600 text-sm mb-4">Carrera de portadores y fuegos en el puerto.</p>
          <p class="text-slate-500 text-xs font-medium">📍 Amalfi, SA</p>
        </div>
      </a>

      <!-- Card 2 -->
      <a href="/es-es/eventos/costa-amalfitana/fuochi-ferragosto-positano-maiori/" class="block bg-white rounded-[2rem] border border-slate-100 overflow-hidden shadow-sm hover:shadow-md transition-shadow">
        <img src="/images/positano-hero.jpg" alt="Fuegos Ferragosto" class="h-40 w-full object-cover" />
        <div class="p-6">
          <span class="text-med-gold text-[10px] font-bold uppercase tracking-widest mb-2 block">Agosto 2026</span>
          <h3 class="font-serif text-lg font-bold text-slate-900 mb-2">Fuegos Ferragosto</h3>
          <p class="text-slate-600 text-sm mb-4">Espectáculo pirotécnico sobre el mar en la costa.</p>
          <p class="text-slate-500 text-xs font-medium">📍 Positano & Maiori, SA</p>
        </div>
      </a>

      <!-- Card 3 -->
      <a href="/es-es/eventos/costa-amalfitana/ravello-festival/" class="block bg-white rounded-[2rem] border border-slate-100 overflow-hidden shadow-sm hover:shadow-md transition-shadow">
        <img src="/images/ravello-hero.jpg" alt="Festival de Ravello" class="h-40 w-full object-cover" />
        <div class="p-6">
          <span class="text-med-gold text-[10px] font-bold uppercase tracking-widest mb-2 block">Julio - Septiembre 2026</span>
          <h3 class="font-serif text-lg font-bold text-slate-900 mb-2">Festival de Ravello</h3>
          <p class="text-slate-600 text-sm mb-4">Música clásica y contemporánea en Villa Rufolo.</p>
          <p class="text-slate-500 text-xs font-medium">📍 Ravello, SA</p>
        </div>
      </a>
    </div>
  </section>

  <!-- Destinación CTA -->
  <section class="bg-med-blue text-white py-12 sm:py-16 px-6">
    <div class="max-w-7xl mx-auto">
      <div class="flex flex-col sm:flex-row items-center justify-between gap-8">
        <div>
          <h3 class="font-serif text-2xl sm:text-3xl font-bold mb-3">Explorar Amalfi</h3>
          <p class="text-white/70 text-sm sm:text-base max-w-md">Descubre las playas, monumentos, restaurantes y experiencias de la perla de la Costa Amalfitana.</p>
        </div>
        <a href="/es-es/costa-amalfitana/amalfi/" class="bg-med-gold text-white px-8 py-3 rounded-full font-medium hover:bg-yellow-500 transition-colors whitespace-nowrap">
          Ver Destino →
        </a>
      </div>
    </div>
  </section>

</BaseLayout>