---
import BaseLayout from '../../../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../../../components/Breadcrumbs.astro';
import LocalitySlider from '../../../../../components/LocalitySlider.astro';

const lang = 'es-es';

const breadcrumbs = [
  { name: 'Inicio', url: '/es-es/' },
  { name: 'Eventos', url: '/es-es/eventos/' },
  { name: 'Luminaria di San Domenico', url: '/es-es/eventos/costa-amalfi/luminaria-san-domenico-praiano/' },
];

const eventSchema = {
  "@context": "https://schema.org",
  "@type": "EventSeries",
  "name": "Luminaria di San Domenico Praiano",
  "description": "La Luminaria di San Domenico en Praiano, 1–4 agosto 2026. Miles de velas, pirotecnia artística y proyecciones de luz transforman el pueblo pesquero de Praiano en un mar de luz.",
  "image": "https://amalficoast-travel.com/images/praiano-hero.jpg",
  "url": "https://amalficoast-travel.com/es-es/eventos/costa-amalfi/luminaria-san-domenico-praiano/",
  "location": {
      "@type": "Place",
      "name": "Piazza San Gennaro, Praiano",
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Praiano",
        "addressRegion": "SA",
        "addressCountry": "IT"
      }
    },
  "eventStatus": "https://schema.org/EventScheduled",
  "eventAttendanceMode": "https://schema.org/OfflineEventAttendanceMode",
  "subEvent": [
    {
      "@type": "Event",
      "name": "Luminaria di San Domenico Praiano 2026",
      "startDate": "2026-08-01",
      "endDate": "2026-08-04",
      "eventStatus": "https://schema.org/EventScheduled",
      "eventAttendanceMode": "https://schema.org/OfflineEventAttendanceMode",
      "location": {
          "@type": "Place",
          "name": "Piazza San Gennaro, Praiano",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Praiano",
            "addressRegion": "SA",
            "addressCountry": "IT"
          }
        },
      "url": "https://amalficoast-travel.com/es-es/eventos/costa-amalfi/luminaria-san-domenico-praiano/",
      "image": "https://amalficoast-travel.com/images/praiano-hero.jpg",
      "description": "La Luminaria di San Domenico en Praiano, 1–4 agosto 2026. Miles de velas, pirotecnia artística y proyecciones de luz transforman el pueblo pesquero de Praiano en un mar de luz."
    }
  ]
};

const facts = [
  { dt: 'Fecha', dd: '1–4 agosto 2026' },
  { dt: 'Lugar', dd: 'Piazza San Gennaro, Praiano' },
  { dt: 'Tipo', dd: 'Instalación de luz y fuegos' },
  { dt: 'Entrada', dd: 'Gratuita' },
  { dt: 'Desde Amalfi', dd: 'Autobús SITA, 20 min' },
];
---

<BaseLayout
  title="Luminaria di San Domenico Praiano 2026 – Miles de Velas en el Pueblo Pesquero"
  description="La Luminaria di San Domenico en Praiano, 1–4 agosto 2026. Miles de velas, pirotecnia artística y proyecciones de luz transforman el pueblo pesquero de Praiano en un mar de luz."
  lang={lang}
  breadcrumbs={breadcrumbs}
  schema={[eventSchema]}
 pageKey="luminaria-san-domenico-praiano"
  heroImage="/images/praiano-hero.jpg"
>

  <!-- Hero -->
  <section class="relative h-[65vh] sm:h-[70vh] overflow-hidden flex items-center justify-center">
    <img
      src="/images/praiano-hero.jpg"
      alt="Luminaria di San Domenico, Praiano"
      class="absolute inset-0 w-full h-full object-cover"
      loading="eager" fetchpriority="high" decoding="sync" referrerpolicy="no-referrer"
    />
    <div class="absolute inset-0 bg-gradient-to-b from-black/20 via-black/50 to-black/70"></div>
    <div class="relative z-10 text-center px-6 max-w-5xl text-white">
      <div class="flex flex-wrap justify-center items-center gap-4 mb-6">
        <span class="bg-med-gold text-white px-4 py-1 rounded-full text-[10px] font-bold uppercase tracking-widest">Evento 2026</span>
        <span class="text-white/70 text-xs sm:text-sm">1–4 agosto 2026</span>
        <span class="text-white/70 text-xs sm:text-sm">Praiano, SA</span>
      </div>
      <h1 class="font-serif text-5xl md:text-7xl font-bold text-white leading-tight mb-6">Luminaria di San Domenico</h1>
      <p class="text-white/85 text-lg md:text-xl font-light max-w-2xl mx-auto leading-relaxed">
        Miles de velas transforman Praiano en un pueblo de luz durante cuatro noches mágicas.
      </p>
    </div>
    <Breadcrumbs breadcrumbs={breadcrumbs} isEvent={true} />
  </section>

  <!-- Content 70/30 -->
  <section class="py-12 sm:py-24 px-6 max-w-7xl mx-auto">
    <div class="grid grid-cols-1 lg:grid-cols-10 gap-16">

      <!-- Main Content (70%) -->
      <div class="lg:col-span-7 space-y-12">
        <div>
          <h2 class="font-serif text-4xl font-bold text-slate-900 mb-8">Sobre el Evento</h2>
          <div class="space-y-4 text-slate-600 text-lg leading-relaxed">
            <p>Durante cuatro noches, el pueblo pesquero de Praiano se convierte en un mar de velas. Miles de velas artesanales se colocan a lo largo de los callejones, escaleras y fachadas de las casas – uno de los eventos más evocadores de toda la Costa Amalfi.</p>
            <p>Proyecciones de luz, pirotecnia artística y actuaciones musicales acompañan las noches de velas. Praiano sigue siendo en agosto un pueblo más tranquilo que sus vecinos más conocidos – la Luminaria es la ocasión ideal para descubrirlo.</p>
          </div>
        </div>

        <!-- Las Noches de Luz -->
        <div>
          <h3 class="font-serif text-2xl font-bold text-slate-900 mb-6">Las Noches de Luz</h3>
          <div class="grid sm:grid-cols-2 gap-6">
            <div class="bg-white p-8 rounded-[2rem] border border-slate-100 shadow-sm">
              <span class="text-med-gold text-[10px] font-bold uppercase tracking-widest mb-2 block">Miles de velas</span>
              <h4 class="text-xl font-serif font-bold text-slate-900 mb-3">El mar de luz</h4>
              <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Voluntarios del pueblo colocan cada año miles de velas en fundas de papel pintadas a mano – a lo largo de las escaleras, en los alféizares y en el muro costero. El resultado es mágico.</p>
            </div>
            <div class="bg-white p-8 rounded-[2rem] border border-slate-100 shadow-sm">
              <span class="text-med-gold text-[10px] font-bold uppercase tracking-widest mb-2 block">Fuegos y arte de luz</span>
              <h4 class="text-xl font-serif font-bold text-slate-900 mb-3">Espectáculo sobre el mar</h4>
              <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Proyecciones de luz sobre las fachadas de las iglesias, pirotecnia artística sobre el mar y música tradicional completan la fiesta en un espectáculo completo.</p>
            </div>
          </div>
        </div>

        <!-- Cómo llegar -->
        <div>
          <h3 class="font-serif text-2xl font-bold text-slate-900 mb-6">Cómo llegar</h3>
          <div class="bg-white rounded-[2rem] border border-slate-100 overflow-hidden shadow-sm">
            <table class="w-full text-xs sm:text-xs sm:text-sm">
              <thead>
                <tr class="bg-slate-900 text-white">
                  <th class="text-left px-6 py-4 font-semibold">Transporte</th>
                  <th class="text-left px-6 py-4 font-semibold">Servicio</th>
                  <th class="text-left px-6 py-4 font-semibold">Notas</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-slate-100">
                <tr class="hover:bg-slate-50 transition-colors">
                  <td class="px-6 py-4 font-medium">Autobús SITA</td>
                  <td class="px-6 py-4 text-slate-600">Desde Amalfi o Positano</td>
                  <td class="px-6 py-4 text-slate-500 text-xs">Aprox. 20 min desde Amalfi</td>
                </tr>
                <tr class="hover:bg-slate-50 transition-colors">
                  <td class="px-6 py-4 font-medium">Ferry</td>
                  <td class="px-6 py-4 text-slate-600">Desde Positano o Amalfi</td>
                  <td class="px-6 py-4 text-slate-500 text-xs">Muelle Praiano Marina di Praia</td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>
      </div>

      <!-- Sidebar (30%) -->
      <aside class="lg:col-span-3">
        <div class="bg-slate-900 text-white p-10 rounded-[3rem] sticky top-32 shadow-2xl">
          <p class="text-[10px] uppercase tracking-[0.3em] text-med-gold font-medium mb-6">Detalles del Evento</p>
          <dl class="space-y-4">
            {facts.map(({ dt, dd }, i) => (
              <>
                <div>
                  <dt class="text-white/40 text-[10px] uppercase tracking-widest font-bold mb-1">{dt}</dt>
                  <dd class="text-white font-medium">{dd}</dd>
                </div>
                {i < facts.length - 1 && <div class="border-t border-white/5"></div>}
              </>
            ))}
          </dl>
          <div class="mt-10 pt-8 border-t border-white/5">
            <p class="text-white/50 text-xs leading-relaxed">Recomendamos llegar con antelación. Consulta el programa actualizado en los canales oficiales.</p>
          </div>
        </div>
      </aside>

    </div>
  </section>

  <LocalitySlider
    heading="Pueblos Cercanos a Praiano"
    lang={lang}
    items={[
      { name: "Praiano", href: '/es-es/costa-amalfitana/praiano/', image: '/images/praiano-hero.jpg', tag: "Sede del evento" },
      { name: "Positano", href: '/es-es/costa-amalfitana/positano/', image: '/images/positano-hero.jpg', tag: "Icónica" },
      { name: "Furore", href: '/es-es/costa-amalfitana/furore/', image: '/images/costiera-hero.jpg', tag: "Pueblo" },
      { name: "Amalfi", href: '/es-es/costa-amalfitana/amalfi/', image: '/images/amalfi-hero.jpg', tag: "Histórica" },
    ]}
  />

  <!-- Eventos Relacionados -->
  <section class="py-4 sm:py-12 px-6 max-w-7xl mx-auto">
    <h2 class="font-serif text-3xl sm:text-4xl font-bold text-slate-900 mb-12">Eventos Relacionados</h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
      <a href="/es-es/eventos/costa-amalfitana/festa-san-gennaro-praiano/" class="block bg-white rounded-[2rem] border border-slate-100 overflow-hidden shadow-sm hover:shadow-md transition-shadow">
        <img src="/images/praiano-hero.jpg" alt="Fiesta de San Jenaro" class="h-40 w-full object-cover" />
        <div class="p-6">
          <span class="text-med-gold text-[10px] font-bold uppercase tracking-widest mb-2 block">Septiembre 2026</span>
          <h3 class="font-serif text-lg font-bold text-slate-900 mb-2">Fiesta de San Jenaro</h3>
          <p class="text-slate-600 text-sm mb-4">Procesión con vistas panorámicas a Capri.</p>
          <p class="text-slate-500 text-xs font-medium">📍 Praiano, SA</p>
        </div>
      </a>
      <a href="/es-es/eventos/costa-amalfitana/notte-blu-vietri/" class="block bg-white rounded-[2rem] border border-slate-100 overflow-hidden shadow-sm hover:shadow-md transition-shadow">
        <img src="/images/vietri-hero.jpg" alt="Notte Blu" class="h-40 w-full object-cover" />
        <div class="p-6">
          <span class="text-med-gold text-[10px] font-bold uppercase tracking-widest mb-2 block">Julio 2026</span>
          <h3 class="font-serif text-lg font-bold text-slate-900 mb-2">Notte Blu</h3>
          <p class="text-slate-600 text-sm mb-4">Celebración de la cerámica con luces y performances.</p>
          <p class="text-slate-500 text-xs font-medium">📍 Vietri sul Mare, SA</p>
        </div>
      </a>
      <a href="/es-es/eventos/costa-amalfitana/positano-mare-sole-cultura/" class="block bg-white rounded-[2rem] border border-slate-100 overflow-hidden shadow-sm hover:shadow-md transition-shadow">
        <img src="/images/positano-hero.jpg" alt="Positano Mar Sol Cultura" class="h-40 w-full object-cover" />
        <div class="p-6">
          <span class="text-med-gold text-[10px] font-bold uppercase tracking-widest mb-2 block">Julio - Agosto 2026</span>
          <h3 class="font-serif text-lg font-bold text-slate-900 mb-2">Positano Mar Sol Cultura</h3>
          <p class="text-slate-600 text-sm mb-4">Festival de artes con música, teatro y tradiciones.</p>
          <p class="text-slate-500 text-xs font-medium">📍 Positano, SA</p>
        </div>
      </a>
    </div>
  </section>

  <!-- Destinazione CTA -->
  <section class="bg-med-blue text-white py-12 sm:py-16 px-6">
    <div class="max-w-7xl mx-auto">
      <div class="flex flex-col sm:flex-row items-center justify-between gap-8">
        <div>
          <h3 class="font-serif text-2xl sm:text-3xl font-bold mb-3">Explora Praiano</h3>
          <p class="text-white/70 text-sm sm:text-base max-w-md">Pueblo de pescadores con playas vírgenes y aguas tranquilas.</p>
        </div>
        <a href="/es-es/costa-amalfitana/praiano/" class="bg-med-gold text-white px-8 py-3 rounded-full font-medium hover:bg-yellow-500 transition-colors whitespace-nowrap">
          View Destination →
        </a>
      </div>
    </div>
  </section>


