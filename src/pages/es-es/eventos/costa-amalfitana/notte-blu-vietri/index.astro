---
import BaseLayout from '../../../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../../../components/Breadcrumbs.astro';
import LocalitySlider from '../../../../../components/LocalitySlider.astro';

const lang = 'es-es';

const breadcrumbs = [
  { name: 'Inicio', url: '/es-es/' },
  { name: 'Eventos', url: '/es-es/eventos/' },
  { name: 'Notte Blu Vietri', url: '/es-es/eventos/costa-amalfi/notte-blu-vietri/' },
];

const eventSchema = {
  "@context": "https://schema.org",
  "@type": "EventSeries",
  "name": "Notte Blu Vietri sul Mare",
  "description": "La Notte Blu en Vietri sul Mare en julio de 2026. Talleres de cerámica abiertos hasta medianoche, conciertos en vivo e instalaciones artísticas en el casco histórico.",
  "image": "https://amalficoast-travel.com/images/costiera-hero.jpg",
  "url": "https://amalficoast-travel.com/es-es/eventos/costa-amalfi/notte-blu-vietri/",
  "location": {
      "@type": "Place",
      "name": "Centro histórico, Vietri sul Mare",
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Vietri sul Mare",
        "addressRegion": "SA",
        "addressCountry": "IT"
      }
    },
  "eventStatus": "https://schema.org/EventScheduled",
  "eventAttendanceMode": "https://schema.org/OfflineEventAttendanceMode",
  "subEvent": [
    {
      "@type": "Event",
      "name": "Notte Blu Vietri sul Mare 2026",
      "startDate": "2026-07-01",
      "endDate": "2026-07-31",
      "eventStatus": "https://schema.org/EventScheduled",
      "eventAttendanceMode": "https://schema.org/OfflineEventAttendanceMode",
      "location": {
          "@type": "Place",
          "name": "Centro histórico, Vietri sul Mare",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Vietri sul Mare",
            "addressRegion": "SA",
            "addressCountry": "IT"
          }
        },
      "url": "https://amalficoast-travel.com/es-es/eventos/costa-amalfi/notte-blu-vietri/",
      "image": "https://amalficoast-travel.com/images/costiera-hero.jpg",
      "description": "La Notte Blu en Vietri sul Mare en julio de 2026. Talleres de cerámica abiertos hasta medianoche, conciertos en vivo e instalaciones artísticas en el casco histórico."
    }
  ]
};

const facts = [
  { dt: 'Período', dd: 'Julio 2026' },
  { dt: 'Lugar', dd: 'Centro histórico, Vietri' },
  { dt: 'Tipo', dd: 'Arte, cerámica y música' },
  { dt: 'Horario', dd: 'Hasta medianoche' },
  { dt: 'Desde Salerno', dd: '15 min en autobús' },
];
---

<BaseLayout
  title="Notte Blu Vietri sul Mare 2026 – Arte, Cerámica y Música"
  description="La Notte Blu en Vietri sul Mare en julio de 2026. Talleres de cerámica abiertos hasta medianoche, conciertos en vivo e instalaciones artísticas en el casco histórico."
  lang={lang}
  breadcrumbs={breadcrumbs}
  schema={[eventSchema]}
 pageKey="notte-blu-vietri"
  heroImage="/images/costiera-hero.jpg"
>

  <!-- Hero -->
  <section class="relative h-[65vh] sm:h-[70vh] overflow-hidden flex items-center justify-center">
    <img
      src="/images/costiera-hero.jpg"
      alt="Notte Blu, Vietri sul Mare"
      class="absolute inset-0 w-full h-full object-cover"
      loading="eager" fetchpriority="high" decoding="sync" referrerpolicy="no-referrer"
    />
    <div class="absolute inset-0 bg-gradient-to-b from-black/20 via-black/50 to-black/70"></div>
    <div class="relative z-10 text-center px-6 max-w-5xl text-white">
      <div class="flex flex-wrap justify-center items-center gap-4 mb-6">
        <span class="bg-med-gold text-white px-4 py-1 rounded-full text-[10px] font-bold uppercase tracking-widest">Evento 2026</span>
        <span class="text-white/70 text-xs sm:text-sm">Julio 2026</span>
        <span class="text-white/70 text-xs sm:text-sm">Vietri sul Mare, SA</span>
      </div>
      <h1 class="font-serif text-5xl md:text-7xl font-bold text-white leading-tight mb-6">Notte Blu</h1>
      <p class="text-white/85 text-lg md:text-xl font-light max-w-2xl mx-auto leading-relaxed">
        Arte, cerámica y música hasta tarde en la noche en el centro histórico de Vietri sul Mare.
      </p>
    </div>
    <Breadcrumbs breadcrumbs={breadcrumbs} isEvent={true} />
  </section>

  <!-- Content 70/30 -->
  <section class="py-12 sm:py-24 px-6 max-w-7xl mx-auto">
    <div class="grid grid-cols-1 lg:grid-cols-10 gap-16">

      <!-- Main Content (70%) -->
      <div class="lg:col-span-7 space-y-12">
        <div>
          <h2 class="font-serif text-4xl font-bold text-slate-900 mb-8">Sobre el Evento</h2>
          <div class="space-y-4 text-slate-600 text-lg leading-relaxed">
            <p>En la Notte Blu los famosos talleres de cerámica de Vietri sul Mare abren sus puertas hasta medianoche. Los visitantes pueden ver a los artesanos trabajar, comprar cerámica y disfrutar de conciertos en vivo e instalaciones artísticas en el centro histórico.</p>
            <p>Vietri sul Mare es la capital de la cerámica de la Costa Amalfi – sus coloridas baldosas de mayólica adornan iglesias, villas y cafés desde Sorrento hasta Salerno. La Notte Blu es la mejor oportunidad para conocer los talleres entre bambalinas.</p>
          </div>
        </div>

        <!-- La noche azul -->
        <div>
          <h3 class="font-serif text-2xl font-bold text-slate-900 mb-6">La noche azul</h3>
          <div class="grid sm:grid-cols-2 gap-6">
            <div class="bg-white p-8 rounded-[2rem] border border-slate-100 shadow-sm">
              <span class="text-med-gold text-[10px] font-bold uppercase tracking-widest mb-2 block">Talleres de cerámica</span>
              <h4 class="text-xl font-serif font-bold text-slate-900 mb-3">Ateliers abiertos</h4>
              <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Los tradicionales talleres de cerámica de Vietri abren sus puertas y ofrecen una mirada al arte milenario de la mayólica – desde el torno hasta el esmalte pintado.</p>
            </div>
            <div class="bg-white p-8 rounded-[2rem] border border-slate-100 shadow-sm">
              <span class="text-med-gold text-[10px] font-bold uppercase tracking-widest mb-2 block">Música en vivo y arte</span>
              <h4 class="text-xl font-serif font-bold text-slate-900 mb-3">Cultura hasta medianoche</h4>
              <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Bandas locales, instalaciones artísticas y proyecciones de luz transforman el centro histórico en un escenario abierto – toda la ciudad celebra junta hasta bien entrada la noche.</p>
            </div>
          </div>
        </div>

        <!-- Cómo llegar -->
        <div>
          <h3 class="font-serif text-2xl font-bold text-slate-900 mb-6">Cómo llegar</h3>
          <div class="bg-white rounded-[2rem] border border-slate-100 overflow-hidden shadow-sm">
            <table class="w-full text-xs sm:text-xs sm:text-sm">
              <thead>
                <tr class="bg-slate-900 text-white">
                  <th class="text-left px-6 py-4 font-semibold">Transporte</th>
                  <th class="text-left px-6 py-4 font-semibold">Servicio</th>
                  <th class="text-left px-6 py-4 font-semibold">Notas</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-slate-100">
                <tr class="hover:bg-slate-50 transition-colors">
                  <td class="px-6 py-4 font-medium">Autobús</td>
                  <td class="px-6 py-4 text-slate-600">Desde Salerno</td>
                  <td class="px-6 py-4 text-slate-500 text-xs">Aprox. 15 min, conexiones muy frecuentes</td>
                </tr>
                <tr class="hover:bg-slate-50 transition-colors">
                  <td class="px-6 py-4 font-medium">Autobús SITA</td>
                  <td class="px-6 py-4 text-slate-600">Por la Costa Amalfi</td>
                  <td class="px-6 py-4 text-slate-500 text-xs">Vietri es la puerta oriental de la costa</td>
                </tr>
                <tr class="hover:bg-slate-50 transition-colors">
                  <td class="px-6 py-4 font-medium">Tren</td>
                  <td class="px-6 py-4 text-slate-600">Desde la estación de Salerno</td>
                  <td class="px-6 py-4 text-slate-500 text-xs">Parada Vietri sul Mare</td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>
      </div>

      <!-- Sidebar (30%) -->
      <aside class="lg:col-span-3">
        <div class="bg-slate-900 text-white p-10 rounded-[3rem] sticky top-32 shadow-2xl">
          <p class="text-[10px] uppercase tracking-[0.3em] text-med-gold font-medium mb-6">Detalles del Evento</p>
          <dl class="space-y-4">
            {facts.map(({ dt, dd }, i) => (
              <>
                <div>
                  <dt class="text-white/40 text-[10px] uppercase tracking-widest font-bold mb-1">{dt}</dt>
                  <dd class="text-white font-medium">{dd}</dd>
                </div>
                {i < facts.length - 1 && <div class="border-t border-white/5"></div>}
              </>
            ))}
          </dl>
          <div class="mt-10 pt-8 border-t border-white/5">
            <p class="text-white/50 text-xs leading-relaxed">Recomendamos llegar con antelación. Consulta el programa actualizado en los canales oficiales.</p>
          </div>
        </div>
      </aside>

    </div>
  </section>

  <LocalitySlider
    heading="Localidades Cercanas a Vietri"
    lang={lang}
    items={[
      { name: "Vietri sul Mare", href: '/es-es/costa-amalfitana/vietri-sul-mare/', image: '/images/costiera-hero.jpg', tag: "Sede del evento" },
      { name: "Cetara", href: '/es-es/costa-amalfitana/cetara/', image: '/images/costiera-hero.jpg', tag: "Gastronomía" },
      { name: "Maiori", href: '/es-es/costa-amalfitana/maiori/', image: '/images/costiera-hero.jpg', tag: "Costa" },
      { name: "Salerno", href: '/es-es/costa-amalfitana/salerno/', image: '/images/costiera-hero.jpg', tag: "Histórica" },
    ]}
  />

    <!-- BANNER: Itinerary Planner -->
  <section class="py-10 md:py-14 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6">
      <div class="relative overflow-hidden rounded-[2.5rem] bg-gradient-to-br from-slate-900 via-slate-950 to-blue-950 px-6 sm:px-10 md:px-14 py-10 md:py-14 shadow-[0_20px_60px_rgba(0,0,0,0.35)]">
        <div class="absolute -top-20 -left-20 w-72 h-72 bg-blue-500/15 rounded-full blur-3xl pointer-events-none"></div>
        <div class="absolute -bottom-20 -right-20 w-72 h-72 bg-amber-500/10 rounded-full blur-3xl pointer-events-none"></div>
        <div class="relative z-10 grid md:grid-cols-[3fr_2fr] md:items-center gap-8">
          <div>
            <span class="inline-block px-4 py-1.5 rounded-full text-xs font-semibold tracking-wide uppercase bg-med-gold/15 text-med-gold border border-med-gold/25 mb-6">Novedad: Viaje a Medida</span>
            <h2 class="text-3xl md:text-4xl font-bold text-white leading-tight mb-2">Diseña tu</h2>
            <p class="font-serif text-3xl md:text-4xl italic text-med-blue mb-5">itinerario ideal</p>
            <p class="text-white/60 text-base md:text-lg leading-relaxed max-w-xl mb-8">
              Responde a unas sencillas preguntas - punto de partida, días e intereses - y recibe un itinerario personalizado con transporte, costos y horarios.
            </p>
            <div class="flex flex-wrap gap-6">
              <div class="flex items-center gap-2.5">
                <div class="w-9 h-9 rounded-xl bg-white/5 border border-white/10 flex items-center justify-center">
                  <svg class="w-4 h-4 text-med-gold" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                </div>
                <span class="text-white/50 text-sm">30 segundos para configurar</span>
              </div>
              <div class="flex items-center gap-2.5">
                <div class="w-9 h-9 rounded-xl bg-white/5 border border-white/10 flex items-center justify-center">
                  <svg class="w-4 h-4 text-med-gold" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 6.75V15m6-6v8.25m.503 3.498l4.875-2.437c.381-.19.622-.58.622-1.006V4.82c0-.836-.88-1.38-1.628-1.006l-3.869 1.934c-.317.159-.69.159-1.006 0L9.503 3.252a1.125 1.125 0 00-1.006 0L3.622 5.689C3.24 5.88 3 6.27 3 6.695V19.18c0 .836.88 1.38 1.628 1.006l3.869-1.934c.317-.159.69-.159 1.006 0l4.994 2.497c.317.158.69.158 1.006 0z"/></svg>
                </div>
                <span class="text-white/50 text-sm">Consejos anti-multitud incluidos</span>
              </div>
            </div>
          </div>
          <div class="mt-8 md:mt-0 md:flex md:justify-center">
            <a href="/es-es/planificador-itinerario/" class="inline-flex items-center gap-2.5 px-7 py-3.5 bg-gradient-to-r from-med-gold to-yellow-600 text-slate-900 font-bold rounded-xl hover:shadow-[0_0_30px_rgba(212,175,55,0.4)] hover:scale-105 transition-all duration-300">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 2L2 12l4 0 0 6 4 0 0-4 4 0 0 4 4 0 0-6 4 0L12 2z"/></svg>
              Configurar Ahora
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Eventos Relacionados -->
  <section class="py-4 sm:py-12 px-6 max-w-7xl mx-auto">
    <h2 class="font-serif text-3xl sm:text-4xl font-bold text-slate-900 mb-12">Eventos Relacionados</h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
      <a href="/es-es/eventos/costa-amalfitana/luminaria-san-domenico-praiano/" class="block bg-white rounded-[2rem] border border-slate-100 overflow-hidden shadow-sm hover:shadow-md transition-shadow">
        <img src="/images/praiano-hero.jpg" alt="Luminaria" class="h-40 w-full object-cover" />
        <div class="p-6">
          <span class="text-med-gold text-[10px] font-bold uppercase tracking-widest mb-2 block">Agosto 2026</span>
          <h3 class="font-serif text-lg font-bold text-slate-900 mb-2">Luminaria de San Domingo</h3>
          <p class="text-slate-600 text-sm mb-4">Procesión nocturna con antorchas en la playa.</p>
          <p class="text-slate-500 text-xs font-medium">📍 Praiano, SA</p>
        </div>
      </a>
      <a href="/es-es/eventos/costa-amalfitana/positano-mare-sole-cultura/" class="block bg-white rounded-[2rem] border border-slate-100 overflow-hidden shadow-sm hover:shadow-md transition-shadow">
        <img src="/images/positano-hero.jpg" alt="Positano" class="h-40 w-full object-cover" />
        <div class="p-6">
          <span class="text-med-gold text-[10px] font-bold uppercase tracking-widest mb-2 block">Julio - Agosto 2026</span>
          <h3 class="font-serif text-lg font-bold text-slate-900 mb-2">Positano Mar Sol Cultura</h3>
          <p class="text-slate-600 text-sm mb-4">Festival de artes con música, teatro y tradiciones.</p>
          <p class="text-slate-500 text-xs font-medium">📍 Positano, SA</p>
        </div>
      </a>
      <a href="/es-es/eventos/costa-amalfitana/sagra-del-pesce-positano/" class="block bg-white rounded-[2rem] border border-slate-100 overflow-hidden shadow-sm hover:shadow-md transition-shadow">
        <img src="/images/positano-hero.jpg" alt="Sagra" class="h-40 w-full object-cover" />
        <div class="p-6">
          <span class="text-med-gold text-[10px] font-bold uppercase tracking-widest mb-2 block">Octubre 2026</span>
          <h3 class="font-serif text-lg font-bold text-slate-900 mb-2">Sagra del Pesce</h3>
          <p class="text-slate-600 text-sm mb-4">Celebración de mariscos locales con cocina tradicional.</p>
          <p class="text-slate-500 text-xs font-medium">📍 Positano, SA</p>
        </div>
      </a>
    </div>
  </section>

  <!-- Destinazione CTA -->
  <section class="bg-med-blue text-white py-12 sm:py-16 px-6">
    <div class="max-w-7xl mx-auto">
      <div class="flex flex-col sm:flex-row items-center justify-between gap-8">
        <div>
          <h3 class="font-serif text-2xl sm:text-3xl font-bold mb-3">Explora Vietri sul Mare</h3>
          <p class="text-white/70 text-sm sm:text-base max-w-md">Famosa por sus cerámica colorida y encanto costero.</p>
        </div>
        <a href="/es-es/costa-amalfitana/vietri-sul-mare/" class="bg-med-gold text-white px-8 py-3 rounded-full font-medium hover:bg-yellow-500 transition-colors whitespace-nowrap">
          View Destination →
        </a>
      </div>
    </div>
  </section>


