---
import BaseLayout from '../../../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../../../components/Breadcrumbs.astro';
import LocalitySlider from '../../../../../components/LocalitySlider.astro';

const lang = 'es-es';

const breadcrumbs = [
  { name: 'Inicio', url: '/es-es/' },
  { name: 'Eventos', url: '/es-es/eventos/' },
  { name: 'Festival de Ravello', url: '/es-es/eventos/costa-amalfi/ravello-festival/' },
];

const eventSchema = {
  "@context": "https://schema.org",
  "@type": "EventSeries",
  "name": "Festival de Ravello",
  "description": "El Festival de Ravello 2026, del 4 de julio al 5 de septiembre. La 74.ª edición del festival cultural más prestigioso de la Costa Amalfi en el legendario escenario de la Villa Rufolo.",
  "image": "https://amalficoast-travel.com/images/ravello-hero.jpg",
  "url": "https://amalficoast-travel.com/es-es/eventos/costa-amalfi/ravello-festival/",
  "location": {
      "@type": "Place",
      "name": "Villa Rufolo, Ravello",
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Ravello",
        "addressRegion": "SA",
        "addressCountry": "IT"
      }
    },
  "eventStatus": "https://schema.org/EventScheduled",
  "eventAttendanceMode": "https://schema.org/OfflineEventAttendanceMode",
  "startDate": "2026-07-04",
  "endDate": "2026-09-05",
  "subEvent": [
    {
      "@type": "Event",
      "name": "Festival de Ravello 2026",
      "startDate": "2026-07-04",
      "endDate": "2026-09-05",
      "eventStatus": "https://schema.org/EventScheduled",
      "eventAttendanceMode": "https://schema.org/OfflineEventAttendanceMode",
      "location": {
          "@type": "Place",
          "name": "Villa Rufolo, Ravello",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Ravello",
            "addressRegion": "SA",
            "addressCountry": "IT"
          }
        },
      "url": "https://amalficoast-travel.com/es-es/eventos/costa-amalfi/ravello-festival/",
      "image": "https://amalficoast-travel.com/images/ravello-hero.jpg",
      "description": "El Festival de Ravello 2026, del 4 de julio al 5 de septiembre. La 74.ª edición del festival cultural más prestigioso de la Costa Amalfi en el legendario escenario de la Villa Rufolo."
    }
  ]
};

const facts = [
  { dt: 'Período', dd: '4 jul – 5 sep 2026' },
  { dt: 'Lugar', dd: 'Villa Rufolo, Ravello' },
  { dt: 'Tipo', dd: 'Música clásica y contemporánea' },
  { dt: 'Entradas', dd: 'Reserva recomendada' },
  { dt: 'Desde Amalfi', dd: 'Autobús + 5 min a pie' },
];
---

<BaseLayout
  title="Festival de Ravello 2026 – Música entre el Cielo y el Mar"
  description="El Festival de Ravello 2026, del 4 de julio al 5 de septiembre. La 74.ª edición del festival cultural más prestigioso de la Costa Amalfi en el legendario escenario de la Villa Rufolo."
  lang={lang}
  breadcrumbs={breadcrumbs}
  schema={[eventSchema]}
 pageKey="ravello-festival"
  heroImage="/images/ravello-hero.jpg"
>

  <!-- Hero -->
  <section class="relative h-[65vh] sm:h-[70vh] overflow-hidden flex items-center justify-center">
    <img
      src="/images/ravello-hero.jpg"
      alt="Festival de Ravello, Villa Rufolo"
      class="absolute inset-0 w-full h-full object-cover"
      loading="eager" fetchpriority="high" decoding="sync" referrerpolicy="no-referrer"
    />
    <div class="absolute inset-0 bg-gradient-to-b from-black/20 via-black/50 to-black/70"></div>
    <div class="relative z-10 text-center px-6 max-w-5xl text-white">
      <div class="flex flex-wrap justify-center items-center gap-4 mb-6">
        <span class="bg-med-gold text-white px-4 py-1 rounded-full text-[10px] font-bold uppercase tracking-widest">Evento 2026</span>
        <span class="text-white/70 text-xs sm:text-sm">4 jul – 5 sep 2026</span>
        <span class="text-white/70 text-xs sm:text-sm">Ravello, SA</span>
      </div>
      <h1 class="font-serif text-5xl md:text-7xl font-bold text-white leading-tight mb-6">Festival de Ravello</h1>
      <p class="text-white/85 text-lg md:text-xl font-light max-w-2xl mx-auto leading-relaxed">
        Música entre el cielo y el mar en el legendario escenario de la Villa Rufolo.
      </p>
    </div>
    <Breadcrumbs breadcrumbs={breadcrumbs} isEvent={true} />
  </section>

  <!-- Content 70/30 -->
  <section class="py-12 sm:py-24 px-6 max-w-7xl mx-auto">
    <div class="grid grid-cols-1 lg:grid-cols-10 gap-16">

      <!-- Main Content (70%) -->
      <div class="lg:col-span-7 space-y-12">
        <div>
          <h2 class="font-serif text-4xl font-bold text-slate-900 mb-8">Sobre el Evento</h2>
          <div class="space-y-4 text-slate-600 text-lg leading-relaxed">
            <p>La 74.ª edición del festival cultural más prestigioso de la Costa Amalfi. Conciertos en el legendario escenario de la Villa Rufolo con vistas al mar: una experiencia única donde la música y el paisaje se fusionan en una obra de arte total.</p>
            <p>El Festival de Ravello es uno de los festivales de música más importantes de Italia. Cada año atrae a orquestas de clase mundial, directores y solistas al teatro de la Villa Rufolo, cuyo escenario se alza directamente sobre el mar Tirreno.</p>
          </div>
        </div>

        <!-- El Programa -->
        <div>
          <h3 class="font-serif text-2xl font-bold text-slate-900 mb-6">El Programa</h3>
          <div class="grid sm:grid-cols-2 gap-6">
            <div class="bg-white p-8 rounded-[2rem] border border-slate-100 shadow-sm">
              <span class="text-med-gold text-[10px] font-bold uppercase tracking-widest mb-2 block">Conciertos orquestales</span>
              <h4 class="text-xl font-serif font-bold text-slate-900 mb-3">Orquestas de clase mundial</h4>
              <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Orquestas de renombre internacional actúan en la terraza de la Villa Rufolo. El mar forma el telón de fondo natural para conciertos nocturnos inolvidables.</p>
            </div>
            <div class="bg-white p-8 rounded-[2rem] border border-slate-100 shadow-sm">
              <span class="text-med-gold text-[10px] font-bold uppercase tracking-widest mb-2 block">El escenario</span>
              <h4 class="text-xl font-serif font-bold text-slate-900 mb-3">Villa Rufolo</h4>
              <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">La villa medieval del siglo XIII con sus jardines moriscos y su terraza sobre el mar es considerada uno de los escenarios de concierto más hermosos del mundo.</p>
            </div>
          </div>
        </div>

        <!-- Cómo llegar -->
        <div>
          <h3 class="font-serif text-2xl font-bold text-slate-900 mb-6">Cómo llegar</h3>
          <div class="bg-white rounded-[2rem] border border-slate-100 overflow-hidden shadow-sm">
            <table class="w-full text-xs sm:text-xs sm:text-sm">
              <thead>
                <tr class="bg-slate-900 text-white">
                  <th class="text-left px-6 py-4 font-semibold">Transporte</th>
                  <th class="text-left px-6 py-4 font-semibold">Servicio</th>
                  <th class="text-left px-6 py-4 font-semibold">Notas</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-slate-100">
                <tr class="hover:bg-slate-50 transition-colors">
                  <td class="px-6 py-4 font-medium">Autobús SITA</td>
                  <td class="px-6 py-4 text-slate-600">Desde Amalfi o Salerno</td>
                  <td class="px-6 py-4 text-slate-500 text-xs">Parada Ravello, 5 min a pie hasta la Villa</td>
                </tr>
                <tr class="hover:bg-slate-50 transition-colors">
                  <td class="px-6 py-4 font-medium">Ferry + autobús</td>
                  <td class="px-6 py-4 text-slate-600">Desde Nápoles o Positano</td>
                  <td class="px-6 py-4 text-slate-500 text-xs">Ferry a Amalfi, luego autobús a Ravello</td>
                </tr>
                <tr class="hover:bg-slate-50 transition-colors">
                  <td class="px-6 py-4 font-medium">Taxi/Transfer</td>
                  <td class="px-6 py-4 text-slate-600">Desde cualquier pueblo costero</td>
                  <td class="px-6 py-4 text-slate-500 text-xs">Recomendado para eventos nocturnos</td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>
      </div>

      <!-- Sidebar (30%) -->
      <aside class="lg:col-span-3">
        <div class="bg-slate-900 text-white p-10 rounded-[3rem] sticky top-32 shadow-2xl">
          <p class="text-[10px] uppercase tracking-[0.3em] text-med-gold font-medium mb-6">Detalles del Evento</p>
          <dl class="space-y-4">
            {facts.map(({ dt, dd }, i) => (
              <>
                <div>
                  <dt class="text-white/40 text-[10px] uppercase tracking-widest font-bold mb-1">{dt}</dt>
                  <dd class="text-white font-medium">{dd}</dd>
                </div>
                {i < facts.length - 1 && <div class="border-t border-white/5"></div>}
              </>
            ))}
          </dl>
          <div class="mt-10 pt-8 border-t border-white/5">
            <p class="text-white/50 text-xs leading-relaxed">Recomendamos reservar las entradas con antelación. Consulta el programa actualizado en los canales oficiales.</p>
          </div>
        </div>
      </aside>

    </div>
  </section>

  <LocalitySlider
    heading="Localidades Cercanas al Festival"
    lang={lang}
    items={[
      { name: "Ravello", href: '/es-es/costa-amalfitana/ravello/', image: '/images/ravello-hero.jpg', tag: "Sede del evento" },
      { name: "Amalfi", href: '/es-es/costa-amalfitana/amalfi/', image: '/images/amalfi-hero.jpg', tag: "Costa" },
      { name: "Positano", href: '/es-es/costa-amalfitana/positano/', image: '/images/positano-hero.jpg', tag: "Icónica" },
      { name: "Praiano", href: '/es-es/costa-amalfitana/praiano/', image: '/images/praiano-hero.jpg', tag: "Auténtica" },
    ]}
  />

    <!-- BANNER: Itinerary Planner -->
  <section class="py-10 md:py-14 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6">
      <div class="relative overflow-hidden rounded-[2.5rem] bg-gradient-to-br from-slate-900 via-slate-950 to-blue-950 px-6 sm:px-10 md:px-14 py-10 md:py-14 shadow-[0_20px_60px_rgba(0,0,0,0.35)]">
        <div class="absolute -top-20 -left-20 w-72 h-72 bg-blue-500/15 rounded-full blur-3xl pointer-events-none"></div>
        <div class="absolute -bottom-20 -right-20 w-72 h-72 bg-amber-500/10 rounded-full blur-3xl pointer-events-none"></div>
        <div class="relative z-10 grid md:grid-cols-[3fr_2fr] md:items-center gap-8">
          <div>
            <span class="inline-block px-4 py-1.5 rounded-full text-xs font-semibold tracking-wide uppercase bg-med-gold/15 text-med-gold border border-med-gold/25 mb-6">Novedad: Viaje a Medida</span>
            <h2 class="text-3xl md:text-4xl font-bold text-white leading-tight mb-2">Diseña tu</h2>
            <p class="font-serif text-3xl md:text-4xl italic text-med-blue mb-5">itinerario ideal</p>
            <p class="text-white/60 text-base md:text-lg leading-relaxed max-w-xl mb-8">
              Responde a unas sencillas preguntas - punto de partida, días e intereses - y recibe un itinerario personalizado con transporte, costos y horarios.
            </p>
            <div class="flex flex-wrap gap-6">
              <div class="flex items-center gap-2.5">
                <div class="w-9 h-9 rounded-xl bg-white/5 border border-white/10 flex items-center justify-center">
                  <svg class="w-4 h-4 text-med-gold" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                </div>
                <span class="text-white/50 text-sm">30 segundos para configurar</span>
              </div>
              <div class="flex items-center gap-2.5">
                <div class="w-9 h-9 rounded-xl bg-white/5 border border-white/10 flex items-center justify-center">
                  <svg class="w-4 h-4 text-med-gold" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 6.75V15m6-6v8.25m.503 3.498l4.875-2.437c.381-.19.622-.58.622-1.006V4.82c0-.836-.88-1.38-1.628-1.006l-3.869 1.934c-.317.159-.69.159-1.006 0L9.503 3.252a1.125 1.125 0 00-1.006 0L3.622 5.689C3.24 5.88 3 6.27 3 6.695V19.18c0 .836.88 1.38 1.628 1.006l3.869-1.934c.317-.159.69-.159 1.006 0l4.994 2.497c.317.158.69.158 1.006 0z"/></svg>
                </div>
                <span class="text-white/50 text-sm">Consejos anti-multitud incluidos</span>
              </div>
            </div>
          </div>
          <div class="mt-8 md:mt-0 md:flex md:justify-center">
            <a href="/es-es/planificador-itinerario/" class="inline-flex items-center gap-2.5 px-7 py-3.5 bg-gradient-to-r from-med-gold to-yellow-600 text-slate-900 font-bold rounded-xl hover:shadow-[0_0_30px_rgba(212,175,55,0.4)] hover:scale-105 transition-all duration-300">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 2L2 12l4 0 0 6 4 0 0-4 4 0 0 4 4 0 0-6 4 0L12 2z"/></svg>
              Configurar Ahora
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Eventos Relacionados -->
  <section class="py-4 sm:py-12 px-6 max-w-7xl mx-auto">
    <h2 class="font-serif text-3xl sm:text-4xl font-bold text-slate-900 mb-12">Eventos Relacionados</h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
      <a href="/es-es/eventos/costa-amalfitana/regata-storica-amalfi/" class="block bg-white rounded-[2rem] border border-slate-100 overflow-hidden shadow-sm hover:shadow-md transition-shadow">
        <img src="/images/amalfi-hero.jpg" alt="Regata" class="h-40 w-full object-cover" />
        <div class="p-6">
          <span class="text-med-gold text-[10px] font-bold uppercase tracking-widest mb-2 block">Junio 2026</span>
          <h3 class="font-serif text-lg font-bold text-slate-900 mb-2">Regata Histórica</h3>
          <p class="text-slate-600 text-sm mb-4">Las antiguas repúblicas marítimas compiten en carreras.</p>
          <p class="text-slate-500 text-xs font-medium">📍 Amalfi, SA</p>
        </div>
      </a>
      <a href="/es-es/eventos/costa-amalfitana/festa-sant-andrea-amalfi/" class="block bg-white rounded-[2rem] border border-slate-100 overflow-hidden shadow-sm hover:shadow-md transition-shadow">
        <img src="/images/amalfi-hero.jpg" alt="Sant'Andrea" class="h-40 w-full object-cover" />
        <div class="p-6">
          <span class="text-med-gold text-[10px] font-bold uppercase tracking-widest mb-2 block">Junio 2026</span>
          <h3 class="font-serif text-lg font-bold text-slate-900 mb-2">Festa di Sant'Andrea</h3>
          <p class="text-slate-600 text-sm mb-4">Carrera de portadores y fuegos en el puerto.</p>
          <p class="text-slate-500 text-xs font-medium">📍 Amalfi, SA</p>
        </div>
      </a>
      <a href="/es-es/eventos/costa-amalfitana/positano-mare-sole-cultura/" class="block bg-white rounded-[2rem] border border-slate-100 overflow-hidden shadow-sm hover:shadow-md transition-shadow">
        <img src="/images/positano-hero.jpg" alt="Positano" class="h-40 w-full object-cover" />
        <div class="p-6">
          <span class="text-med-gold text-[10px] font-bold uppercase tracking-widest mb-2 block">Julio - Agosto 2026</span>
          <h3 class="font-serif text-lg font-bold text-slate-900 mb-2">Positano Mar Sol Cultura</h3>
          <p class="text-slate-600 text-sm mb-4">Festival de artes con música, teatro y tradiciones.</p>
          <p class="text-slate-500 text-xs font-medium">📍 Positano, SA</p>
        </div>
      </a>
    </div>
  </section>

  <!-- Destinazione CTA -->
  <section class="bg-med-blue text-white py-12 sm:py-16 px-6">
    <div class="max-w-7xl mx-auto">
      <div class="flex flex-col sm:flex-row items-center justify-between gap-8">
        <div>
          <h3 class="font-serif text-2xl sm:text-3xl font-bold mb-3">Explora Ravello</h3>
          <p class="text-white/70 text-sm sm:text-base max-w-md">Suspendido sobre la costa con vistas espectaculares y cultura.</p>
        </div>
        <a href="/es-es/costa-amalfitana/ravello/" class="bg-med-gold text-white px-8 py-3 rounded-full font-medium hover:bg-yellow-500 transition-colors whitespace-nowrap">
          View Destination →
        </a>
      </div>
    </div>
  </section>


