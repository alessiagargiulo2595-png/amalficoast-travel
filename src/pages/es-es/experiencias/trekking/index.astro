---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../../components/Breadcrumbs.astro';
import CorrelationSlider from '../../../../components/CorrelationSlider.astro';

const lang = 'es-es';

const breadcrumbs = [
  { name: 'Inicio', url: '/es-es/' },
  { name: 'Experiencias', url: '/es-es/experiencias/' },
  { name: 'Senderismo & Sendero de los Dioses', url: '/es-es/experiencias/trekking/' },
];

const trails = [
  { name: 'Sendero de los Dioses', difficulty: 'EE', km: '8 km', time: '3–4h', start: 'Agerola (S. Lazzaro)', end: 'Nocelle (Positano)', highlights: 'Vistas costeras impresionantes, flora mediterránea, sin asfalto', cta: { href: '/es-es/itinerarios/1-dia/sendero-de-los-dioses-trek/' } },
  { name: 'Valle delle Ferriere', difficulty: 'E', km: '7 km RT', time: '2.5–3h', start: 'Centro de Amalfi', end: 'Amalfi (regreso)', highlights: 'Cascadas, helechos tropicales, papiro silvestre, sombra natural', cta: { href: '/es-es/blog/valle-ferriere/' } },
  { name: "Via dell'Infinito (Ravello)", difficulty: 'E', km: '5 km RT', time: '2h', start: 'Ravello', end: 'Ravello', highlights: 'Vistas panorámicas de la costa, olivos, silencio absoluto' },
  { name: 'Punta Campanella', difficulty: 'E', km: '6 km RT', time: '2.5h', start: 'Termini (Massa Lubrense)', end: 'Termini', highlights: 'Punta más al sur, ruinas romanas, vistas a Capri, reserva marina', cta: { href: '/es-es/blog/punta-campanella/' } },
  { name: 'Fiordo di Furore', difficulty: 'E', km: '3 km RT', time: '1.5–2h', start: 'Furore', end: 'Furore', highlights: 'Fiordo oculto, cascada, piscina natural, manantial de agua dulce', cta: { href: '/es-es/playas/costa-amalfitana/fiordo-di-furore/' } },
  { name: 'Ieranto Bay', difficulty: 'E', km: '4 km RT', time: '1.5–2h', start: 'Termini (Massa Lubrense)', end: 'Termini', highlights: 'Playa salvaje aislada, caleta cristalina, área protegida, vistas al mar', cta: { href: '/es-es/playas/peninsula-sorrentina/spiaggia-di-ieranto/' } },
  { name: 'Monte Solaro (Capri)', difficulty: 'E', km: '4 km', time: '2h (ascenso)', start: 'Anacapri', end: 'Anacapri (regreso en teleférico)', highlights: '589 m, panorama 360°, santuario, silencio' },
  { name: 'Fiordo de Crapolla', difficulty: 'E', km: '6 km RT', time: '2.5h', start: 'Via Casal di Torca (Massa Lubrense)', end: 'Via Casal di Torca', highlights: '700 escalones, escalera de piedra antigua, capilla medieval, ruinas romanas, reserva marina', cta: { href: '/es-es/blog/fiordo-di-crapolla/' } },
  { name: 'Reccumone', difficulty: 'E', km: '0.5 km RT', time: '15–20 min', start: 'Marina del Cantone (Nerano)', end: 'Marina del Cantone', highlights: 'Playa salvaje y equipada, aguas cristalinas, acceso a pie o por mar, restaurante', cta: { href: '/es-es/blog/baia-recommone/' } },
];
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    { "@type": "Question", "name": "¿Es difícil hacer senderismo en la Costa Amalfitana?",
      "acceptedAnswer": { "@type": "Answer", "text": "Depende de la ruta. Casi todos los itinerarios están clasificados como E (medio): unas horas de marcha por caminos de piedra y escalones, sin exigencia técnica. Solo el Sendero de los Dioses lleva la clasificación EE, más exigente, por tramos expuestos sin barandilla. La verdadera dificultad aquí no es el desnivel sino los escalones: casi todas las rutas empiezan o terminan con varios cientos." } },
    { "@type": "Question", "name": "¿Cuál es la mejor ruta de senderismo de la Costa Amalfitana?",
      "acceptedAnswer": { "@type": "Answer", "text": "El Sendero de los Dioses es la ruta emblema: 8 km de Agerola a Nocelle, 3 o 4 horas caminando muy por encima del mar, con Positano y Capri a la vista casi todo el rato. Si prefieres algo más suave y con sombra, el Valle delle Ferriere sobre Amalfi es un recorrido de ida y vuelta de 7 km entre cascadas y helechos." } },
    { "@type": "Question", "name": "¿Cuál es la mejor época para caminar por la Costa Amalfitana?",
      "acceptedAnswer": { "@type": "Answer", "text": "De abril a principios de junio y de septiembre a octubre. Las temperaturas se mueven entre 16 y 24°C, la luz es limpia y los senderos están secos. Julio y agosto son realmente duros: casi ninguna ruta tiene sombra ni puntos de agua, y al mediodía se alcanzan 32°C. En invierno se puede caminar, pero los caminos se embarran y la piedra se vuelve resbaladiza." } },
    { "@type": "Question", "name": "¿En qué dirección hay que hacer el Sendero de los Dioses?",
      "acceptedAnswer": { "@type": "Answer", "text": "De Agerola hacia Nocelle, en bajada. Al revés supone subir unos 500 metros de desnivel a pleno sol, y los 1.500 escalones hacia Positano quedarían todavía por delante. Toma el autobús SITA de Amalfi a Agerola por la mañana y camina hacia el mar." } },
    { "@type": "Question", "name": "¿Hace falta guía para caminar por la Costa Amalfitana?",
      "acceptedAnswer": { "@type": "Answer", "text": "No. El Sendero de los Dioses y las demás rutas principales están señalizadas con las marcas blancas y rojas del CAI y tienen bastante tránsito, así que rara vez estarás solo. Un guía compensa si quieres entender la historia y la vegetación, si caminas en temporada baja cuando los senderos se vacían, o para rutas menos evidentes como el fiordo de Crapolla." } },
    { "@type": "Question", "name": "¿Qué calzado necesito para caminar por la Costa Amalfitana?",
      "acceptedAnswer": { "@type": "Answer", "text": "Botas o zapatillas de trail con suela de goma bien tallada. La caliza aquí está pulida por siglos de paso y se vuelve traicionera con el mínimo polvo o humedad. Las sandalias y las zapatillas de suela lisa causan cada verano la mayoría de los esguinces en el Sendero de los Dioses." } },
    { "@type": "Question", "name": "¿Cómo se llega al inicio del Sendero de los Dioses?",
      "acceptedAnswer": { "@type": "Answer", "text": "Desde Amalfi en autobús SITA hasta Agerola, unos 45 minutos, bajando en Bomerano (San Lazzaro). Hay pocas salidas, así que conviene salir de Amalfi sobre las 8:30 para tomar la de las 9:15. Desde Positano hay que llegar antes a Amalfi, lo que alarga mucho la mañana: quien camina a menudo duerme en Agerola la víspera." } },
    { "@type": "Question", "name": "¿Se puede ir andando de un pueblo a otro de la Costa Amalfitana?",
      "acceptedAnswer": { "@type": "Answer", "text": "Sí. La costa está recorrida por una antigua red de caminos de herradura y escalinatas que unía los pueblos antes de que existiera la SS163. El Sendero de los Limones entre Maiori y Minori es el ejemplo más sencillo, unos 2 km. Nocelle-Positano y Ravello-Atrani también convierten un traslado en un paseo." } },
  ]
};

---

<BaseLayout
  title="Senderismo en la Costa Amalfitana 2026 | Sendero de los Dioses y 9 rutas"
  description="Senderismo en la Costa Amalfitana: 9 rutas comparadas por dificultad, distancia y duración, del Sendero de los Dioses (Agerola-Nocelle) al Valle delle Ferriere. Cuándo caminar, qué llevar y cómo llegar a cada inicio."
  lang={lang}
  breadcrumbs={breadcrumbs}
  pageKey="trekking"
  schema={[faqSchema]}

  heroImage="/images/trekking-hero.jpg"
>

  <section class="relative min-h-[75vh] flex items-end bg-charcoal overflow-hidden">
    <img src="/images/trekking-hero.jpg" alt="Sendero de los Dioses, Amalfi Coast" class="absolute inset-0 w-full h-full object-cover" loading="eager" fetchpriority="high" decoding="sync" referrerpolicy="no-referrer"/>

    <div class="absolute inset-0 bg-gradient-to-b from-black/75 via-black/40 to-black/70"></div>
    <div class="relative z-10 max-w-7xl mx-auto px-6 pb-16 pt-32">
      <div class="max-w-3xl">
        <p class="text-med-gold text-xs sm:text-sm font-medium uppercase tracking-[0.3em] mb-3">Experiencias</p>
        <h1 class="font-serif text-display text-white mb-4">Senderismo en la Costa Amalfitana</h1>
        <p class="text-xl text-white/80 leading-relaxed max-w-2xl">
          La Costa Amalfitana no es solo playas y ferries: también es uno de los paisajes más espectaculares de Europa para explorar a pie. Desde el legendario Sendero de los Dioses hasta las cascadas del Valle de las Ferreras.
        </p>
      </div>
    </div>
    <Breadcrumbs breadcrumbs={breadcrumbs} />
  </section>

  <div class="max-w-editorial mx-auto px-4 sm:px-6 lg:px-8 py-16 space-y-12">

    <section>
      <h2 class="font-serif text-3xl font-bold text-slate-900 mb-3 text-center">Senderos imprescindibles</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {trails.map((t, i) => {
          const isGold = i % 2 === 0;
          return (
          <div class={`border rounded-[2rem] p-7 hover:shadow-lg transition-all w-full sm:w-auto ${isGold ? 'bg-med-gold border-med-gold' : 'bg-med-blue border-med-blue'}`}>
            <div class="mb-5">
              <h3 class={`font-bold text-lg mb-3 ${isGold ? 'text-charcoal' : 'text-white'}`}>{t.name}</h3>
              <span class={`text-[10px] uppercase tracking-wide px-3 py-1.5 rounded-full font-medium flex-shrink-0 w-fit ${t.difficulty === 'EE' ? 'bg-red-50 text-red-600' : isGold ? 'bg-white/40 text-charcoal' : 'bg-white/20 text-white'}`}>
                {t.difficulty === 'EE' ? 'EE - Muy Difícil' : 'E - Moderado'}
              </span>
            </div>
            <div class="space-y-3 mb-5">
              <div><span class={`text-xs font-semibold ${isGold ? 'text-charcoal/70' : 'text-white/70'}`}>DISTANCIA</span><br /><span class={`font-semibold ${isGold ? 'text-charcoal' : 'text-white'}`}>{t.km}</span></div>
              <div><span class={`text-xs font-semibold ${isGold ? 'text-charcoal/70' : 'text-white/70'}`}>DURACIÓN</span><br /><span class={`font-semibold ${isGold ? 'text-charcoal' : 'text-white'}`}>{t.time}</span></div>
              <div><span class={`text-xs font-semibold ${isGold ? 'text-charcoal/70' : 'text-white/70'}`}>SALIDA</span><br /><span class={`font-semibold text-sm ${isGold ? 'text-charcoal' : 'text-white'}`}>{t.start}</span></div>
              <div><span class={`text-xs font-semibold ${isGold ? 'text-charcoal/70' : 'text-white/70'}`}>LLEGADA</span><br /><span class={`font-semibold text-sm ${isGold ? 'text-charcoal' : 'text-white'}`}>{t.end}</span></div>
            </div>
            <p class={`text-xs sm:text-sm leading-relaxed font-medium mb-4 ${isGold ? 'text-charcoal' : 'text-white'}`}>{t.highlights}</p>
            {t.cta && (
              <a href={t.cta.href} class={`inline-flex items-center gap-2 font-semibold text-xs px-4 py-2 rounded-lg transition-all ${isGold ? 'bg-med-blue text-white hover:bg-med-blue/90' : 'bg-med-gold text-white hover:bg-med-gold/90'}`}>
                Mas informacion →
              </a>
            )}
          </div>
        );
        })}
      </div>
    </section>

    <section class="bg-charcoal text-white rounded-[2rem] p-8">
      <h2 class="font-serif text-2xl font-bold text-med-gold mb-8">Guía rápida de senderos costeros</h2>
      <div class="grid sm:grid-cols-2 gap-6">
        <div>
          <p class="text-white/60 text-xs sm:text-sm mb-1">Cómo llegar al inicio</p>
          <p class="text-xs sm:text-sm leading-relaxed">Desde Amalfi: autobús SITA a Agerola (servicios limitados, ~45 min). Recomendado: salir de Amalfi a las 8:30 para coger el autobús de las 9:15 a Agerola.</p>
        </div>
        <div>
          <p class="text-white/60 text-xs sm:text-sm mb-1">Cómo regresar</p>
          <p class="text-xs sm:text-sm leading-relaxed">Desde Nocelle: autobús local a Positano (~15 min) o caminar hacia abajo (~1.000 escalones, 45 min). Desde Positano: autobús SITA o ferry a Amalfi/Sorrento/Nápoles.</p>
        </div>
        <div>
          <p class="text-white/60 text-xs sm:text-sm mb-1">Qué llevar</p>
          <p class="text-xs sm:text-sm leading-relaxed">Botas de senderismo (no sandalias), 1,5L de agua, gorro, protector solar, snacks, chaqueta ligera. El sendero no tiene puntos de agua ni tiendas.</p>
        </div>
        <div>
          <p class="text-white/60 text-xs sm:text-sm mb-1">Mejor época</p>
          <p class="text-xs sm:text-sm leading-relaxed">Abril-junio y septiembre-octubre. En julio y agosto el calor lo hace agotador y concurrido. Invierno es posible pero embarrado y resbaladizo.</p>
        </div>
      </div>
    </section>


    <!-- Quale sentiero scegliere -->
    <section>
      <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">Qué ruta elegir</h2>
      <p class="text-slate-600 text-lg leading-relaxed mb-8">Nueve opciones son demasiadas para un solo viaje. En la práctica la elección se reduce al tiempo que tengas y a qué quieres encontrar al final.</p>
      <ul class="space-y-4 text-slate-600">
        <li class="flex items-start gap-3">
          <span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span>
          <span class="text-slate-700"><strong>Una sola caminata, y que sea la famosa.</strong> El <a href="/es-es/itinerarios/1-dia/sendero-de-los-dioses-trek/" class="text-med-blue hover:underline">Sendero de los Dioses</a>. Nada más en esta costa ofrece esa relación entre esfuerzo y panorama, y se termina en <a href="/es-es/costa-amalfitana/positano/" class="text-med-blue hover:underline">Positano</a> con un baño esperando.</span>
        </li>
        <li class="flex items-start gap-3">
          <span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span>
          <span class="text-slate-700"><strong>Estás aquí en julio o agosto.</strong> El <a href="/es-es/blog/valle-ferriere/" class="text-med-blue hover:underline">Valle delle Ferriere</a>, la única ruta importante con sombra de verdad y agua corriente. Un desfiladero húmedo sobre <a href="/es-es/costa-amalfitana/amalfi/" class="text-med-blue hover:underline">Amalfi</a> lleno de helechos que crecen allí desde la última glaciación.</span>
        </li>
        <li class="flex items-start gap-3">
          <span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span>
          <span class="text-slate-700"><strong>Caminas con niños o después de una comida larga.</strong> El <a href="/es-es/blog/sendero-de-los-limones/" class="text-med-blue hover:underline">Sendero de los Limones</a> entre Maiori y Minori, unos 2 km bajo las pérgolas de limoneros, o el circuito de la Via dell’Infinito en <a href="/es-es/costa-amalfitana/ravello/" class="text-med-blue hover:underline">Ravello</a>.</span>
        </li>
        <li class="flex items-start gap-3">
          <span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span>
          <span class="text-slate-700"><strong>Quieres que la caminata acabe en la playa.</strong> La <a href="/es-es/playas/peninsula-sorrentina/spiaggia-di-ieranto/" class="text-med-blue hover:underline">bahía de Ieranto</a> o el <a href="/es-es/blog/fiordo-di-crapolla/" class="text-med-blue hover:underline">fiordo de Crapolla</a>, ambos en la península sorrentina y accesibles solo a pie o por mar, que es justo por lo que siguen tranquilos.</span>
        </li>
        <li class="flex items-start gap-3">
          <span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span>
          <span class="text-slate-700"><strong>Tienes media jornada en las islas.</strong> El Monte Solaro en <a href="/es-es/islas/capri/" class="text-med-blue hover:underline">Capri</a>: se sube desde Anacapri en dos horas y se vuelve en telesilla, o al revés si tus rodillas lo prefieren.</span>
        </li>
      </ul>
    </section>

    <!-- Difficolta -->
    <section>
      <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">Qué significan los grados de dificultad</h2>
      <p class="text-slate-600 text-lg leading-relaxed mb-8">Las fichas de arriba usan la escala del Club Alpino Italiano, la misma que verás en las marcas blancas y rojas a lo largo de los senderos. Dos grados cubren todo lo que hay en esta costa.</p>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div class="bg-white p-6 rounded-[2rem] border border-slate-100 shadow-sm">
          <p class="text-med-gold text-xs font-medium uppercase tracking-[0.2em] mb-2">Grado E</p>
          <h3 class="font-bold text-slate-900 mb-2 text-lg">Medio, no hace falta experiencia</h3>
          <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Un sendero señalizado con firme claro. Necesitas una forma física razonable y calzado decente, nada más. Ocho de las nueve rutas están en este grado, incluidos el Valle delle Ferriere y todo lo de la península sorrentina.</p>
        </div>
        <div class="bg-white p-6 rounded-[2rem] border border-slate-100 shadow-sm">
          <p class="text-med-gold text-xs font-medium uppercase tracking-[0.2em] mb-2">Grado EE</p>
          <h3 class="font-bold text-slate-900 mb-2 text-lg">Exigente, requiere pisada segura</h3>
          <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Solo el Sendero de los Dioses. El grado viene de tramos cortos y expuestos donde el sendero se estrecha sobre una caída considerable sin barandilla. No hay escalada ni material, pero no es el lugar para descubrir que el vacío te incomoda.</p>
        </div>
      </div>
      <p class="text-slate-600 text-lg leading-relaxed mt-8">Ninguno de los dos grados te prepara, sin embargo, para la verdadera firma de esta costa: las escaleras. La bajada de Nocelle a Positano son unos 1.500 escalones, Crapolla ronda los 700, y el acceso a casi todas las playas se mide en tramos más que en metros. Es la bajada la que deja las piernas doloridas al día siguiente, así que aquí los bastones valen más de lo que el desnivel sugiere.</p>
    </section>

    <!-- Stagione -->
    <section>
      <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">Cuándo caminar y cuándo no</h2>
      <p class="text-slate-600 text-lg leading-relaxed mb-8">La estación pesa aquí más que en la mayoría de destinos de senderismo, porque estos senderos son caliza orientada al sur, casi sin arbolado y sin puntos de agua por el camino.</p>
      <div class="overflow-hidden rounded-[2rem] border border-slate-100 shadow-sm">
        <table class="w-full text-xs sm:text-sm">
          <thead class="bg-slate-900 text-white">
            <tr>
              <th class="text-left p-5 font-serif font-bold text-med-gold">Periodo</th>
              <th class="text-left p-5 font-serif font-bold text-med-gold">Condiciones</th>
              <th class="text-left p-5 font-serif font-bold text-med-gold">Veredicto</th>
            </tr>
          </thead>
          <tbody class="bg-white">
            <tr class="border-b border-slate-100">
              <td class="p-5 font-bold">De abril a principios de junio</td>
              <td class="p-5 text-slate-600">13-24°C, laderas en flor, senderos secos</td>
              <td class="p-5 text-slate-600">La mejor ventana del año</td>
            </tr>
            <tr class="border-b border-slate-100">
              <td class="p-5 font-bold">Finales de junio</td>
              <td class="p-5 text-slate-600">Calor en aumento, más horas de luz</td>
              <td class="p-5 text-slate-600">Bien si sales al amanecer</td>
            </tr>
            <tr class="border-b border-slate-100">
              <td class="p-5 font-bold">Julio y agosto</td>
              <td class="p-5 text-slate-600">Hasta 32°C, sin sombra, índice UV 9-10</td>
              <td class="p-5 text-slate-600">Antes de las 8:00 o nada</td>
            </tr>
            <tr class="border-b border-slate-100">
              <td class="p-5 font-bold">Septiembre y octubre</td>
              <td class="p-5 text-slate-600">16-27°C, aire limpio, menos gente</td>
              <td class="p-5 text-slate-600">A la altura de la primavera, con mar más cálido</td>
            </tr>
            <tr class="border-b border-slate-100">
              <td class="p-5 font-bold">De noviembre a marzo</td>
              <td class="p-5 text-slate-600">Lluvia, barro, piedra pulida</td>
              <td class="p-5 text-slate-600">Posible, y a menudo desierto</td>
            </tr>
          </tbody>
        </table>
      </div>
      <p class="text-slate-600 text-lg leading-relaxed mt-8">Si tus fechas caen por fuerza en pleno verano, la solución es el reloj más que el calendario. Sal con la primera luz, baja de la cresta antes de las once y pasa la tarde a nivel del mar. Para el cuadro completo de temperaturas y mar a lo largo del año, consulta la guía sobre <a href="/es-es/guia/cuando-visitar/" class="text-med-blue hover:underline">cuándo visitar la costa</a>.</p>
    </section>

    <!-- FAQ -->
    <section>
      <h2 class="font-serif text-3xl font-bold text-slate-900 mb-8">Preguntas frecuentes</h2>
      <div class="space-y-4">
        {faqSchema.mainEntity.map((item) => (
          <details class="bg-white rounded-[2rem] border border-slate-100 shadow-sm p-6 group">
            <summary class="font-bold text-slate-900 cursor-pointer list-none flex items-start justify-between gap-4">
              <span>{item.name}</span>
              <span class="text-med-gold flex-shrink-0 transition-transform group-open:rotate-45">+</span>
            </summary>
            <p class="text-slate-600 text-xs sm:text-sm leading-relaxed mt-4">{item.acceptedAnswer.text}</p>
          </details>
        ))}
      </div>
    </section>

  </div>

  <CorrelationSlider lang="es-es"
    heading="Explorar destinos de senderismo"
    items={[
      { name: 'Positano',       href: '/es-es/costa-amalfitana/positano/',             tag: 'Fin del sendero',      desc: 'El pintoresco pueblo donde termina el Sendero de los Dioses.' },
      { name: 'Amalfi',         href: '/es-es/costa-amalfitana/amalfi/',               tag: 'Inicio del valle',    desc: 'Punto de partida para el Valle de las Ferreras.' },
      { name: 'Masa Lubrense', href: '/es-es/peninsula-sorrentina/massa-lubrense/', tag: 'Punta Campanella', desc: 'Reserva marina con el sendero a Punta Campanella.' },
      { name: 'Capri',          href: '/es-es/islas/capri/',                        tag: 'Monte Solaro',   desc: 'Teleférico o senderismo a la cumbre de 589 m del Monte Solaro.' },
    ]}
  />

</BaseLayout>
