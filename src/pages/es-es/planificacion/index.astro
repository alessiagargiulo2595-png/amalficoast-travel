---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getTranslations, getLocalePath } from '../../../i18n/translations';

const lang = 'es-es';
const t = getTranslations(lang);

const breadcrumbs = [
  { name: 'Home', url: '/es-es/' },
  { name: 'Planificación', url: '/es-es/planificacion/' },
];

// Guide articles data
const guides = [
  {
    title: 'Cómo llegar',
    desc: 'Tren, avión, ferry o coche: todas las opciones para llegar a la Costa Amalfitana.',
    img: '/images/come-arrivare-hero.jpg',
    href: '/es-es/guia/como-llegar/',
    tag: 'Transporte'
  },
  {
    title: 'Bus SITA',
    desc: 'La guía completa de los autobuses locales: horarios, tarifas, billetes e itinerarios a lo largo de la costa.',
    img: '/images/bus-sita-hero.jpg',
    href: '/es-es/guia/bus-sita/',
    tag: 'Transporte'
  },
  {
    title: 'Ferris',
    desc: 'Desde ferris locales a rutas estivales desde Nápoles y Salerno: cómo llegar a cada pueblo por mar.',
    img: '/images/traghetti-hero.jpg',
    href: '/es-es/guia/ferries/',
    tag: 'Transporte'
  },
  {
    title: 'Aparcamiento y zonas ZTL',
    desc: 'Dónde aparcar, horarios y tarifas. Cómo evitar zonas de tráfico limitado y multas.',
    img: '/images/parcheggi-hero.jpg',
    href: '/es-es/guia/aparcamiento-ztl/',
    tag: 'Práctico'
  },
  {
    title: 'Matrículas Alternas 2026',
    desc: 'Ordenanza ANAS 340/2019 SS163 Costa Amalfitana y SS145 península sorrentina: calendario par/impar, horarios, exenciones y multas.',
    img: '/images/targhe-alterne-hero.webp',
    href: '/es-es/guia/matriculas-alternas/',
    tag: 'Práctico'
  },
  {
    title: 'Cuándo visitar',
    desc: 'Estaciones, clima, vacaciones y aglomeraciones. Cuándo es el mejor momento para su visita.',
    img: '/images/quando-visitare-hero.jpg',
    href: '/es-es/guia/cuando-visitar/',
    tag: 'Planificación'
  },
];
---

<BaseLayout
  title="Planificación - Costa Amalfitana"
  description="Guías prácticas para la Costa Amalfitana: cómo llegar, aparcamiento, Bus SITA, ferris y cuándo visitar."
  lang={lang}
  pageKey="planning"

  heroImage="/images/itinerari-hero.jpg"
>
  <!-- Hero -->
  <section class="relative h-[45vh] sm:h-[60vh] flex items-center bg-charcoal overflow-hidden">
    <img src="/images/itinerari-hero.jpg" alt="Planificación Costa Amalfitana" class="absolute inset-0 w-full h-full object-cover" loading="eager" fetchpriority="high" decoding="sync" referrerpolicy="no-referrer"/>
    <div class="absolute inset-0 bg-gradient-to-b from-black/25 via-black/40 to-black/75"></div>
    <div class="relative z-10 max-w-7xl mx-auto px-6 py-16">
      <nav class="flex items-center gap-2 text-white/60 text-xs mb-6">
        <a href="/es-es/" class="hover:text-white transition-colors">Home</a>
        <span>/</span>
        <span class="text-white">Planificación</span>
      </nav>
      <div class="max-w-3xl">
        <p class="text-med-gold text-xs sm:text-sm font-medium uppercase tracking-[0.3em] mb-3">Planifica tu viaje</p>
        <h1 class="font-serif text-display text-white mb-4">Guías Prácticas</h1>
        <p class="text-xl text-white/80 leading-relaxed">Cómo llegar, cómo moverse, cuándo visitar y dónde aparcar en la Costa Amalfitana. Todo lo que necesitas para un viaje perfecto.</p>
      </div>
    </div>
  </section>

  <!-- Intro -->
  <section class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <p class="text-lg text-slate-600 leading-relaxed">
      La Costa Amalfitana es fácil de explorar una vez que sabes cómo llegar, cómo moverte y la mejor época para visitarla. Aquí encontrarás toda la información práctica que necesitas: desde opciones de transporte hasta tarifas de aparcamiento, desde autobuses locales hasta ferries de verano.
    </p>
  </section>

  <!-- Guides Grid -->
  <section class="py-12 border-t border-slate-100">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {guides.map((guide) => (
          <a href={guide.href} class="group block bg-white rounded-2xl border border-slate-100 overflow-hidden hover:shadow-lg hover:border-med-blue/20 transition-all duration-300">
            <!-- Image with overlay -->
            <div class="relative h-44 overflow-hidden">
              <img src={guide.img} alt={guide.title} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
              <div class="absolute inset-0 bg-gradient-to-t from-black/50 to-transparent" />
              <!-- Category badge -->
              <span class="absolute bottom-3 left-3 text-[10px] font-bold uppercase tracking-wider text-white bg-med-blue/80 backdrop-blur-sm px-2.5 py-1 rounded-full">
                {guide.tag}
              </span>
            </div>
            <!-- Text section -->
            <div class="p-5">
              <h3 class="font-semibold text-charcoal text-sm mb-1.5 group-hover:text-med-blue transition-colors">{guide.title}</h3>
              <p class="text-xs text-slate-500 leading-relaxed">{guide.desc}</p>
              <span class="mt-3 inline-flex items-center text-xs font-semibold text-med-blue gap-1 group-hover:gap-2 transition-all">
                Leer guía →
              </span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Itineraries CTA -->
  <section class="bg-med-blue py-16 text-center">
    <div class="max-w-2xl mx-auto px-4">
      <h2 class="text-2xl font-bold text-white mb-4">¿Listo para explorar la costa?</h2>
      <p class="text-white mb-6">Elige entre 1 día, 3 días o 1 semana de itinerarios recomendados.</p>
      <a href={getLocalePath(lang, 'itineraries')}
        class="inline-block bg-white text-med-blue font-semibold px-8 py-3 rounded-full hover:bg-slate-100 transition-colors">
        Ver itinerarios
      </a>
    </div>
  </section>
</BaseLayout>
