---
import BaseLayout from '../../../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../../../components/Breadcrumbs.astro';
import CorrelationSlider from '../../../../../components/CorrelationSlider.astro';

const lang = 'es-es';

const breadcrumbs = [
  { name: 'Inicio', url: '/es-es/' },
  { name: 'Planificacion', url: '/es-es/planificacion/' },
  { name: 'Costa Completa - 4 dias', url: '/es-es/itinerarios/4-dias/costa-amalfitana-completa/' },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Donde alojarse para visitar la Costa Amalfitana en 4 dias?",
      "acceptedAnswer": { "@type": "Answer", "text": "La mejor base es Amalfi: ubicacion central, bien conectada por buses SITA y ferries, buena seleccion de B&Bs y hoteles. Alternativamente, Praiano ofrece tranquilidad y precios mas bajos, o Maiori si prefieres la playa. Con 4 dias conviene quedarse en una sola base para evitar mover el equipaje." }
    },
    {
      "@type": "Question",
      "name": "Cuanto cuesta un viaje de 4 dias a la Costa Amalfitana?",
      "acceptedAnswer": { "@type": "Answer", "text": "Presupuesto medio por persona (4 noches): alojamiento €60-120/noche (B&B/hotel 3*), transporte €30-50 total (bus+ferries), comidas €25-40/dia, entradas €20-30 total. Total estimado: €400-700 por persona en temporada media, sin incluir el viaje para llegar a la Costa." }
    },
    {
      "@type": "Question",
      "name": "4 dias en la Costa: mejor en temporada alta o baja?",
      "acceptedAnswer": { "@type": "Answer", "text": "Mayo-junio y septiembre-octubre son los meses ideales: clima perfecto para el trekking, menos aglomeraciones en los buses, precios mas bajos. Julio-agosto es posible pero los buses estan llenos, los aparcamientos completos y las playas abarrotadas. Con 4 dias, la temporada media permite disfrutar de todo con calma." }
    },
    {
      "@type": "Question",
      "name": "Se puede hacer el Sendero de los Dioses en este itinerario?",
      "acceptedAnswer": { "@type": "Answer", "text": "Si, el Dia 3 esta dedicado al Sendero de los Dioses (Bomerano-Nocelle, 7,8 km, 2-3 horas). Se llega a Bomerano en bus SITA desde Amalfi (45 min). Se necesitan zapatillas de trekking, agua y proteccion solar. El sendero esta clasificado como E (senderismo) y no presenta dificultades tecnicas." }
    }
  ]
};

const days = [
  {
    day: 'Dia 1',
    title: 'Llegada, Amalfi y Atrani',
    highlight: 'Catedral, Museo del Papel, pueblo de Atrani',
    items: [
      'Llegada a Salerno en tren (desde Napoles: 30 min, €4,80). Ferry Travelmar a Amalfi (35 min) o bus SITA (75 min).',
      'Check-in y primera exploracion de Amalfi: Catedral de Sant\'Andrea, Claustro del Paraiso, paseo por el puerto.',
      'Tarde: Museo del Papel (papel amalfitano, siglo XIII, entrada €4,50).',
      'Paseo a Atrani (10 min a pie): placita junto al mar, Colegiata de San Salvatore de\' Birecto, aperitivo.',
      'Cena en Atrani: sarchiapone y pescado fresco en la placita (precios mas honestos que Amalfi).',
    ],
  },
  {
    day: 'Dia 2',
    title: 'Ravello y Minori',
    highlight: 'Villa Rufolo, Villa Cimbrone, villa romana',
    items: [
      'Bus SITA Amalfi-Ravello (25 min, salida a las 8:30). Llegar pronto para evitar las multitudes.',
      'Villa Rufolo (€10): jardines colgantes, terraza panoramica sobre el mar. Si hay Festival, conciertos al atardecer.',
      'Villa Cimbrone (€10): la famosa Terraza del Infinito, una de las vistas mas bellas de Italia.',
      'Almuerzo en Ravello: cocina local con vistas al Valle del Dragon.',
      'Tarde: bus a Minori (10 min). Villa Romana del siglo I (gratis). Paseo por el paseo maritimo.',
      'Consejo local: en Minori prueba los ndunderi (noquis de ricotta, plato medieval) y los dulces de la pasteleria De Riso.',
    ],
  },
  {
    day: 'Dia 3',
    title: 'Sendero de los Dioses y Positano',
    highlight: 'Trekking Bomerano-Nocelle, descenso a Positano',
    items: [
      'Salida temprana: bus SITA Amalfi-Agerola/Bomerano (45 min, 7:30 h). Inicio del sendero en la placita de Bomerano.',
      'Sendero de los Dioses: 7,8 km, desnivel -630 m, 2-3 horas. Vistas de la costa, Capri y los Faraglioni. Clasificacion E.',
      'Llegada a Nocelle (450 m). Escalera de 1.700 escalones hasta Arienzo o bus lanzadera a Positano.',
      'Almuerzo en Positano: restaurante con vistas a la Spiaggia Grande.',
      'Tarde: Playa de Fornillo (mas tranquila), compras en Via dei Mulini, iglesia de Santa Maria Assunta.',
      'Regreso a Amalfi: bus SITA (25-40 min) o ferry (25 min, estacional).',
    ],
  },
  {
    day: 'Dia 4',
    title: 'Praiano, Gruta Esmeralda y partida',
    highlight: 'Playa Gavitella, gruta, pueblos orientales',
    items: [
      'Manana: bus SITA a Praiano (15 min desde Amalfi). Paseo al mirador de San Gennaro.',
      'Descenso a la playa de Gavitella: aguas cristalinas y vistas de Positano y Capri.',
      'Gruta Esmeralda (Conca dei Marini): entrada ~€5, espectacular luz verde. Accesible en bus o barco desde Amalfi.',
      'Regreso a Amalfi para almorzar. Ultimo paseo por las callejuelas.',
      'Partida: ferry Amalfi-Salerno (35 min) para tomar el tren, o bus SITA a Sorrento si se continua hacia Napoles.',
      'Consejo local: con tiempo extra, parada en Cetara (20 min desde Amalfi) para espaguetis alla colatura di alici.',
    ],
  },
];
---

<BaseLayout
  title="Costa Amalfitana 4 Dias 2026: Itinerario Completo con Sendero de los Dioses"
  description="Itinerario de 4 dias en la Costa Amalfitana: Amalfi, Ravello, Positano, Sendero de los Dioses, Atrani y Praiano. Programa dia a dia con transporte y consejos."
  lang={lang}
  breadcrumbs={breadcrumbs}
  schema={[faqSchema]}
  pageKey="costiera-amalfitana-4-giorni">

  <section class="relative bg-charcoal overflow-hidden min-h-[70vh] sm:min-h-[75vh] flex items-center justify-center">
    <img src="/images/costiera-hero.jpg" alt="Panorama de la Costa Amalfitana" class="absolute inset-0 w-full h-full object-cover opacity-30" loading="eager" referrerpolicy="no-referrer"/>
    <div class="absolute inset-0 bg-gradient-to-b from-black/75 via-black/40 to-black/70"></div>
    <div class="relative max-w-editorial mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <div class="max-w-3xl mx-auto">
        <p class="text-med-gold text-xs sm:text-sm font-medium uppercase tracking-[0.3em] mb-3">Itinerario · 4 dias</p>
        <h1 class="font-serif text-display text-white mb-4">Costa Amalfitana Completa</h1>
        <p class="text-xl text-white/80 leading-relaxed max-w-2xl mx-auto">
          Cuatro dias para vivir lo mejor de la Costa: <strong>Amalfi</strong>, <strong>Ravello</strong>, el <strong>Sendero de los Dioses</strong>, <strong>Positano</strong> y pueblos autenticos como <strong>Atrani</strong> y <strong>Praiano</strong>.
        </p>
      </div>
    </div>
    <Breadcrumbs breadcrumbs={breadcrumbs} />
  </section>

  <div class="max-w-editorial mx-auto px-4 sm:px-6 lg:px-8 pt-6 pb-10 space-y-10">

    <section class="text-center mb-2">
      <p class="text-lg text-slate-700 leading-relaxed">
        Un <strong>itinerario de 4 dias en la Costa Amalfitana</strong> que combina cultura, trekking, playas y gastronomia. Todo accesible en transporte publico, sin coche. Base recomendada: <strong>Amalfi</strong>.
      </p>
    </section>

    <section class="grid grid-cols-2 sm:grid-cols-4 gap-3">
      {[
        { label: 'Duracion', value: '4 dias / 3 noches' },
        { label: 'Base', value: 'Amalfi' },
        { label: 'Transporte', value: 'Bus SITA + Ferries' },
        { label: 'Presupuesto', value: '€400-700 p.p.' },
      ].map(card => (
        <div class="bg-slate-900 rounded-2xl p-4 text-center">
          <p class="text-[10px] uppercase tracking-wider text-med-gold font-medium mb-1">{card.label}</p>
          <p class="text-white font-semibold text-sm">{card.value}</p>
        </div>
      ))}
    </section>

    <section>
      <h2 class="font-serif text-2xl font-semibold text-slate-900 mb-8">Programa dia a dia</h2>
      <div class="space-y-6">
        {days.map((d) => (
          <div class="bg-white border border-slate-200 rounded-2xl overflow-hidden hover:shadow-md transition-shadow">
            <div class="bg-slate-900 px-6 py-6 flex items-start gap-4 sm:items-center sm:gap-3">
              <span class="text-[10px] uppercase tracking-wide bg-white/15 text-white px-3 py-1.5 rounded-full font-bold flex-shrink-0">{d.day}</span>
              <div class="flex-1 min-w-0">
                <h3 class="font-serif font-semibold text-white text-lg">{d.title}</h3>
                <p class="text-xs text-med-gold mt-1 font-medium">{d.highlight}</p>
              </div>
            </div>
            <ul class="px-6 py-5 space-y-3">
              {d.items.map((item, itemIdx) => {
                const isLocalTip = item.includes('Consejo local:');
                const displayText = item.replace('Consejo local: ', '');
                const isLastItem = itemIdx === d.items.length - 1;
                return (
                  <li class={`flex gap-3 text-sm relative ${isLocalTip ? 'bg-med-gold/10 p-3 rounded-lg border border-med-gold/20' : ''}`}>
                    <div class="flex flex-col items-center">
                      {isLocalTip ? (
                        <svg class="w-5 h-5 text-med-gold flex-shrink-0 self-center" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
                          <circle cx="12" cy="8" r="5"/>
                          <path d="M12 13v2"/>
                          <rect x="10" y="15" width="4" height="3" rx="0.5"/>
                        </svg>
                      ) : (
                        <span class="w-2 h-2 rounded-full bg-med-blue flex-shrink-0"></span>
                      )}
                      {!isLastItem && <div class="w-0.5 h-6 bg-med-blue/30 mt-1"></div>}
                    </div>
                    <span class={`leading-relaxed ${isLocalTip ? 'font-semibold text-slate-800' : 'text-slate-700'}`}>
                      {isLocalTip && <strong>Consejo local: </strong>}
                      {displayText}
                    </span>
                  </li>
                );
              })}
            </ul>
          </div>
        ))}
      </div>
    </section>

    <section class="bg-med-cream border border-med-gold/20 rounded-[2rem] p-6">
      <h2 class="font-serif text-xl font-semibold text-charcoal mb-6">Consejos practicos</h2>
      <ul class="space-y-4">
        {[
          { num: '1', text: 'Billete bus SITA: €2,40 trayecto simple o pase 24h (verificar disponibilidad). Compralo en un estanco.' },
          { num: '2', text: 'Sendero de los Dioses: zapatillas de trekking obligatorias, 1,5 litros de agua por persona, crema solar. Salir antes de las 8:30.' },
          { num: '3', text: 'Ferries Travelmar (abr-oct): Amalfi-Positano €10, Amalfi-Salerno €8. Mas rapido y panoramico que el bus.' },
          { num: '4', text: 'Reserva alojamiento con 2-3 meses de antelacion para mayo-octubre. Los B&B centricos en Amalfi se agotan rapido.' },
          { num: '5', text: 'Come en los pueblos pequenos (Atrani, Minori, Cetara): misma calidad que Amalfi/Positano a mitad de precio.' },
        ].map(({ num, text }) => (
          <li class="flex items-start gap-4 text-sm text-charcoal">
            <span class="text-lg font-bold text-white flex-shrink-0 leading-none bg-[#E2725B] w-9 h-9 flex items-center justify-center rounded-full">{num}</span>
            <span class="leading-relaxed" set:html={text}></span>
          </li>
        ))}
      </ul>
    </section>

    <section id="faq">
      <h2 class="font-serif text-2xl font-semibold text-slate-900 mb-6">Preguntas frecuentes</h2>
      <div class="space-y-4">
        {faqSchema.mainEntity.map((q) => (
          <details class="group border border-slate-200 rounded-2xl overflow-hidden">
            <summary class="flex items-center justify-between px-6 py-4 cursor-pointer select-none text-charcoal font-medium hover:bg-slate-50 transition-colors">
              {q.name}
              <svg class="w-4 h-4 text-slate-400 group-open:rotate-180 transition-transform flex-shrink-0 ml-3" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
            </summary>
            <div class="px-6 pb-5 text-slate-600 leading-relaxed text-sm border-t border-slate-100 pt-4">{q.acceptedAnswer.text}</div>
          </details>
        ))}
      </div>
    </section>

    <section class="bg-gradient-to-r from-med-blue to-med-blue/80 rounded-2xl p-10 text-center text-white">
      <h2 class="font-serif text-3xl font-bold mb-3">Listo para partir?</h2>
      <p class="text-white/90 mb-6 max-w-2xl mx-auto">Consulta la guia completa de transporte para llegar y moverte por la Costa Amalfitana.</p>
      <div class="flex flex-wrap justify-center gap-4">
        <a href="/es-es/guia/como-llegar/" class="inline-block bg-white text-med-blue font-semibold px-8 py-3 rounded-full hover:bg-slate-100 transition-colors">Como llegar →</a>
        <a href="/es-es/guia/mapa/" class="inline-block bg-white/10 border border-white/30 text-white font-semibold px-8 py-3 rounded-full hover:bg-white/20 transition-colors">Mapa de la Costa →</a>
      </div>
    </section>

  </div>

  <CorrelationSlider
    heading="Explora los destinos del itinerario"
    items={[
      { name: 'Amalfi', href: '/es-es/costa-amalfitana/amalfi/', tag: 'Republica Marinera', desc: 'La capital historica con la Catedral y el Museo del Papel.' },
      { name: 'Positano', href: '/es-es/costa-amalfitana/positano/', tag: 'Moda & Vistas', desc: 'Las casas coloridas sobre el mar y la playa Fornillo.' },
      { name: 'Ravello', href: '/es-es/costa-amalfitana/ravello/', tag: 'Musica & Jardines', desc: 'Villa Rufolo, Villa Cimbrone y el Festival a 350 m.' },
      { name: 'Praiano', href: '/es-es/costa-amalfitana/praiano/', tag: 'Atardecer & Calma', desc: 'El atardecer desde San Gennaro y la silenciosa Marina di Praia.' },
    ]}
    lang="es-es"
  />

</BaseLayout>
