---
import BaseLayout from '../../../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../../../components/Breadcrumbs.astro';

const lang = 'es-es';

const breadcrumbs = [
  { name: 'Inicio', url: '/es-es/' },
  { name: 'Planificación', url: '/es-es/planificacion/' },
  { name: 'Islas: Ischia y Procida - 3 días', url: '/es-es/itinerarios/3-dias/islas-ischia-procida/' },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "¿Cuál es mejor para un fin de semana, Ischia o Procida?",
      "acceptedAnswer": { "@type": "Answer", "text": "Depende de lo que busques: Ischia es grande (46 km²), con termas, playas variadas, castillos y vida nocturna - necesita al menos 2 días. Procida es pequeña (4 km²), auténtica, con colores pastel icónicos, pescadores y poca masificación. Con 3 días puedes pasar 2 noches en Ischia y hacer una excursión a Procida." }
    },
    {
      "@type": "Question",
      "name": "¿Cómo llegar a Ischia y Procida desde Nápoles?",
      "acceptedAnswer": { "@type": "Answer", "text": "Desde Nápoles Beverello: hidrofoil a Ischia Porto (~50 min, €20–24) o ferry (~75 min, €12–14). Para Procida: hidrofoil desde Nápoles (~35 min, €15–18). Desde Pozzuoli: ferry Medmar/Caremar a Ischia y Procida, más económico (~€10–13). Reservar online en verano." }
    }
  ]
};

const days = [
  {
    day: 'Día 1',
    title: 'Llegada a Ischia',
    highlight: 'Castillo Aragonés y primer baño',
    items: [
      'Ferry o hidrofoil desde Nápoles Beverello a Ischia Porto (50–75 min, €12–24 según medio).',
      'Check-in hotel. Descanso del viaje.',
      'Tarde: Ischia Ponte y el Castillo Aragonés (entrada ~€10, vistas 360° del Golfo). Alquila una hamaca en la pequeña playa de Ischia Ponte.',
      'Aperitivo en Forio (noroeste) o Lacco Ameno (norte): bar en el puerto, primer sabor de la costa.',
      'Cena en Ischia Porto: restaurante en el puerto, especialidades isquianas (conejo a la ischiana, pasta con gambas).',
      'Consejo local: el aparcamiento es caótico en agosto. Usa aparcamientos públicos de pago, no intentes las callejuelas.',
    ],
  },
  {
    day: 'Día 2',
    title: 'Termas y Playas',
    highlight: 'Parques termales y atardecer en Sant\'Angelo',
    items: [
      'Mañana: Parque termal Poseidón o Negombo (~€35–40 entrada). Piscinas termales a diferentes temperaturas, saunas naturales, hidromásajes en mar abierto.',
      'Almuerzo ligero en el parque (caro pero panorámico) o bajada a Citara para playa libre con fuentes termales en el fondo (busca los "sfizzi" = burbujas termales).',
      'Tarde: Playa de Citara en Forio (una de las mejores, arena fina, mar transparente). Hamaca ~€15.',
      'Atardecer desde el mirador de Sant\'Angelo (el pueblo más pintoresco de Ischia: casas blancas apiladas en el mar, bar minúsculo en el puerto, pescadores).',
      'Cena en Sant\'Angelo en una de las 3 trattorias del puerto (cara, turística, pero experiencia única) o vuelta a Forio.',
      'Consejo local: las termas naturales libres (sin parque) están en Citara y bajo las rocas de Sant\'Angelo. Lleva una tabla para flotar en la fuente caliente.',
    ],
  },
  {
    day: 'Día 3',
    title: 'Excursión a Procida',
    highlight: 'Marina Corricella y la playa de El Cartero',
    items: [
      'Madrugada. Hidrofoil de Ischia Porto a Procida (20 min, ~€9). Primer servicio 08:00–08:30.',
      'Marina Corricella: el puerto de los pescadores, casas de colores pastel (amarillas, azules, rosas), barcas coloreadas, bar minúsculo en el muelle con limoncello fresco. La vista más fotografiada del Golfo.',
      'Terra Murata: el pueblo medieval aferrado al acantilado, vicos estrechísimos, vistas a 360° del Golfo y de las otras islas. Iglesia de Santa Maria Assunta (azulejos de mayólica, vista interior bellísima).',
      'Playa del Pozzo Vecchio (famosa por la película "El Cartero"): calita pequeña pero bellísima, arena y guijarros. Baño de mediodía con vistas a la costa.',
      'Almuerzo en el puerto en una trattoria sencilla: pasta con anchoas, ensalada de mar, vino blanco local.',
      'Regreso a Nápoles en hidrofoil desde Procida (35 min, 16:00–17:00 últimos servicios).',
      'Consejo local: Procida es minúscula. No alquiles coche. A pie o patinete eléctrico. Marina Corricella es el corazón: dedícale al menos 2–3 horas.',
    ],
  },
];
const touristTripSchema = {
  "@context": "https://schema.org",
  "@type": "TouristTrip",
  "name": "Islas: Ischia y Procida - 3 días",
  "description": "Itinerario de 3 días por Ischia y Procida: termas, playas volcánicas, Marina Corricella y Castillo Aragonés. Cómo llegar, dónde dormir y qué ver.",
  "image": "https://amalficoast-travel.com/images/isole-hero.jpg",
  "url": "https://amalficoast-travel.com/es-es/itinerarios/3-dias/islas-ischia-procida/",
  "itinerary": {
    "@type": "ItemList",
    "numberOfItems": days.length,
    "itemListElement": days.map((d, i) => ({
      "@type": "ListItem",
      "position": i + 1,
      "name": `${d.day}: ${d.title}`,
      "description": d.items.join(' \u00b7 ')
    }))
  },
  "touristType": "Sightseeing"
};

const destinationHighlights = [];
const planningTips = [];
---

<BaseLayout
  title="Ischia y Procida en 3 Días 2026 | Itinerario Islas del Golfo de Nápoles"
  description="Itinerario de 3 días por Ischia y Procida: termas, playas volcánicas, Marina Corricella y Castillo Aragonés. Cómo llegar, dónde dormir y qué ver."
  lang={lang}
  breadcrumbs={breadcrumbs}
  schema={[faqSchema, touristTripSchema]}
 pageKey="islas-ischia-procida"
  heroImage="/images/isole-hero.jpg"
>

  <!-- Hero Section -->
  <section class="relative bg-charcoal overflow-hidden min-h-[70vh] sm:min-h-[75vh] flex items-center justify-center">
    <img src="/images/isole-hero.jpg" alt="Ischia y Procida, Golfo de Nápoles" class="absolute inset-0 w-full h-full object-cover opacity-30" loading="eager" fetchpriority="high" decoding="sync" referrerpolicy="no-referrer"/>
    <div class="absolute inset-0 bg-gradient-to-b from-black/75 via-black/40 to-black/70"></div>
    <div class="relative max-w-editorial mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <div class="max-w-3xl mx-auto">
        <p class="text-med-gold text-xs sm:text-sm font-medium uppercase tracking-[0.3em] mb-3">Itinerario · 3 días</p>
        <h1 class="font-serif text-display text-white mb-4">Islas: Ischia y Procida</h1>
        <p class="text-xl text-white/80 leading-relaxed max-w-2xl mx-auto">
          Ischia y Procida en 3 días: termas, playas volcánicas y Marina Corricella en el Golfo de Nápoles.
        </p>
      </div>
    </div>
    <Breadcrumbs breadcrumbs={breadcrumbs} />
  </section>

  <div class="max-w-editorial mx-auto px-4 sm:px-6 lg:px-8 pt-6 pb-10 space-y-10">

    <!-- Day by Day Itinerary -->
    <section>
      <h2 class="font-serif text-2xl font-semibold text-slate-900 mb-8">Programa día a día</h2>
      <div class="space-y-6">
        {days.map((d) => (
          <div class="bg-white border border-slate-200 rounded-2xl overflow-hidden hover:shadow-md transition-shadow">
            <div class="bg-slate-900 px-6 py-6 flex items-start gap-4 sm:items-center sm:gap-3">
              <span class="text-[10px] uppercase tracking-wide bg-white/15 text-white px-3 py-1.5 rounded-full font-bold flex-shrink-0">{d.day}</span>
              <div class="flex-1 min-w-0">
                <h3 class="font-serif font-semibold text-white text-lg">{d.title}</h3>
                {d.highlight && <p class="text-xs text-med-gold mt-1 font-medium">{d.highlight}</p>}
              </div>
            </div>
            <ul class="px-6 py-5 space-y-3">
              {d.items.map((item, itemIdx) => {
                const isLocalTip = item.includes('Local tip:');
                const displayText = item.replace('Local tip: ', '');
                const isLastItem = itemIdx === d.items.length - 1;
                return (
                  <li class={`flex gap-3 text-sm relative ${isLocalTip ? 'bg-med-gold/10 p-3 rounded-lg border border-med-gold/20' : ''}`}>
                    <div class="flex flex-col items-center">
                      {isLocalTip ? (
                        <svg class="w-5 h-5 text-med-gold flex-shrink-0 self-center" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
                          <circle cx="12" cy="8" r="5"/>
                          <path d="M12 13v2"/>
                          <rect x="10" y="15" width="4" height="3" rx="0.5"/>
                        </svg>
                      ) : (
                        <span class="w-2 h-2 rounded-full bg-med-blue flex-shrink-0"></span>
                      )}
                      {!isLastItem && <div class="w-0.5 h-6 bg-med-blue/30 mt-1"></div>}
                    </div>
                    <span class={`leading-relaxed ${isLocalTip ? 'font-semibold text-slate-800' : 'text-slate-700'}`}>
                      {isLocalTip && <strong>Local tip: </strong>}
                      {displayText}
                    </span>
                  </li>
                );
              })}
            </ul>
          </div>
        ))}
      </div>
    </section>

    {destinationHighlights.length > 0 && (
      <section>
        <h2 class="font-serif text-2xl font-semibold text-slate-900 mb-8">Destinos del itinerario</h2>
        <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4">
          {destinationHighlights.map((dest) => (
            <a href={dest.url} class="group block bg-white border border-slate-200 rounded-2xl p-5 hover:shadow-lg hover:border-med-blue/30 transition-all">
              <h3 class="font-semibold text-charcoal mb-2 group-hover:text-med-blue transition-colors">{dest.name}</h3>
              <p class="text-xs text-slate-500 leading-relaxed mb-3">{dest.desc}</p>
              <span class="text-xs font-semibold text-med-blue inline-flex items-center gap-1 group-hover:gap-2 transition-all">
                Descubrir →
              </span>
            </a>
          ))}
        </div>
      </section>
    )}

    {planningTips.length > 0 && (
      <section class="bg-med-cream border border-med-gold/20 rounded-[2rem] p-6">
        <h2 class="font-serif text-xl font-semibold text-charcoal mb-6">Consejos prácticos</h2>
        <ul class="space-y-4">
          {planningTips.map(({ num, text }) => (
            <li class="flex items-start gap-4 text-sm text-charcoal">
              <span class="text-2xl font-bold text-white flex-shrink-0 leading-none mt-0.5 bg-[#E2725B] w-9 h-9 flex items-center justify-center rounded-full">{num}</span>
              <span class="leading-relaxed">{text}</span>
            </li>
          ))}
        </ul>
      </section>
    )}

    <!-- FAQ -->
    <section id="faq">
      <h2 class="font-serif text-2xl font-semibold text-slate-900 mb-6">Preguntas frecuentes</h2>
      <div class="space-y-4">
        {faqSchema.mainEntity.map((q) => (
          <details class="group border border-slate-200 rounded-2xl overflow-hidden">
            <summary class="flex items-center justify-between px-6 py-4 cursor-pointer select-none text-charcoal font-medium hover:bg-slate-50 transition-colors">
              {q.name}
              <svg class="w-4 h-4 text-slate-400 group-open:rotate-180 transition-transform flex-shrink-0 ml-3" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
            </summary>
            <div class="px-6 pb-5 text-slate-600 leading-relaxed text-sm border-t border-slate-100 pt-4">
              {q.acceptedAnswer.text}
            </div>
          </details>
        ))}
      </div>
    </section>

    <!-- Banner: Itinerary Planner -->
    <section class="relative overflow-hidden rounded-[2.5rem] bg-gradient-to-br from-slate-900 via-slate-950 to-blue-950 px-6 sm:px-10 md:px-14 py-10 md:py-14 shadow-[0_20px_60px_rgba(0,0,0,0.35)]">
      <div class="absolute -top-20 -left-20 w-72 h-72 bg-blue-500/15 rounded-full blur-3xl pointer-events-none"></div>
      <div class="absolute -bottom-20 -right-20 w-72 h-72 bg-amber-500/10 rounded-full blur-3xl pointer-events-none"></div>
      <div class="relative z-10 grid md:grid-cols-[3fr_2fr] md:items-center gap-8">
        <div>
          <span class="inline-block px-4 py-1.5 rounded-full text-xs font-semibold tracking-wide uppercase bg-med-gold/15 text-med-gold border border-med-gold/25 mb-6">Novedad: Viaje a Medida</span>
          <h2 class="text-3xl md:text-4xl font-bold text-white leading-tight mb-2">Diseña tu</h2>
          <p class="font-serif text-3xl md:text-4xl italic text-med-blue mb-5">itinerario ideal</p>
          <p class="text-white/60 text-base md:text-lg leading-relaxed max-w-xl mb-8">Responde a unas sencillas preguntas - punto de partida, días e intereses - y recibe un itinerario personalizado con transporte, costos y horarios.</p>
          <div class="flex flex-wrap gap-6">
            <div class="flex items-center gap-2.5">
              <div class="w-9 h-9 rounded-xl bg-white/5 border border-white/10 flex items-center justify-center">
                <svg class="w-4 h-4 text-med-gold" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
              </div>
              <span class="text-white/50 text-sm">30 segundos para configurar</span>
            </div>
            <div class="flex items-center gap-2.5">
              <div class="w-9 h-9 rounded-xl bg-white/5 border border-white/10 flex items-center justify-center">
                <svg class="w-4 h-4 text-med-gold" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 6.75V15m6-6v8.25m.503 3.498l4.875-2.437c.381-.19.622-.58.622-1.006V4.82c0-.836-.88-1.38-1.628-1.006l-3.869 1.934c-.317.159-.69.159-1.006 0L9.503 3.252a1.125 1.125 0 00-1.006 0L3.622 5.689C3.24 5.88 3 6.27 3 6.695V19.18c0 .836.88 1.38 1.628 1.006l3.869-1.934c.317-.159.69-.159 1.006 0l4.994 2.497c.317.158.69.158 1.006 0z"/></svg>
              </div>
              <span class="text-white/50 text-sm">Consejos anti-multitud incluidos</span>
            </div>
          </div>
        </div>
        <div class="mt-8 md:mt-0 md:flex md:justify-center">
          <a href="/es-es/planificador-itinerario/" class="inline-flex items-center gap-2.5 px-7 py-3.5 bg-gradient-to-r from-med-gold to-yellow-600 text-slate-900 font-bold rounded-xl hover:shadow-[0_0_30px_rgba(212,175,55,0.4)] hover:scale-105 transition-all duration-300">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 2L2 12l4 0 0 6 4 0 0-4 4 0 0 4 4 0 0-6 4 0L12 2z"/></svg>
            Configurar Ahora
          </a>
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="bg-gradient-to-r from-med-blue to-med-blue/80 rounded-2xl p-10 text-center text-white">
      <h2 class="font-serif text-3xl font-bold mb-3">¿Listo para partir?</h2>
      <p class="text-white/90 mb-6 max-w-2xl mx-auto">
        Lee la guía completa del transporte público en la Costa Amalfitana: cómo llegar, horarios, billetes y estrategias para ahorrar.
      </p>
      <a href="/es-es/guia/como-llegar/" class="inline-block bg-white text-med-blue font-semibold px-8 py-3 rounded-full hover:bg-slate-100 transition-colors">
        Guía de transporte →
      </a>
    </section>

  </div>

</BaseLayout>
