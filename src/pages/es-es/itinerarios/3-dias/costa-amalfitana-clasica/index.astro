---
import BaseLayout from '../../../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../../../components/Breadcrumbs.astro';

const lang = 'es-es';

const breadcrumbs = [
  { name: 'Inicio', url: '/es-es/' },
  { name: 'Itinerarios', url: '/es-es/itinerarios/' },
  { name: 'Costa Amalfitana clásica - 3 días', url: '/es-es/itinerarios/3-dias/costa-amalfitana-clasica/' },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "¿Dónde dormir para visitar la Costa Amalfitana en 3 días?",
      "acceptedAnswer": { "@type": "Answer", "text": "Las mejores bases son Amalfi (posición central, buena oferta de hoteles y B&B, bien comunicada por autobús y ferry) o Positano (más romántica pero más cara). Sorrento es ideal para quienes buscan una ciudad más práctica con más servicios y precios más bajos, haciendo excursiones a la Costa." }
    },
    {
      "@type": "Question",
      "name": "¿3 días en la Costa: mejor en temporada alta o baja?",
      "acceptedAnswer": { "@type": "Answer", "text": "Mayo–junio y septiembre–octubre son los mejores meses: clima perfecto, menos turistas que en julio–agosto, precios más bajos. En julio–agosto los autobuses van llenos, los aparcamientos saturados y las playas masificadas. En invierno muchos establecimientos cierran pero los pueblos son tranquilos y auténticos." }
    }
  ]
};

const destinationHighlights = [
  { name: 'Positano', desc: 'Pueblo colorido en la costa', url: '/es-es/costa-amalfitana/positano/' },
  { name: 'Amalfi', desc: 'Catedral y centro histórico', url: '/es-es/costa-amalfitana/amalfi/' },
  { name: 'Ravello', desc: 'Pueblos y panoramas', url: '/es-es/costa-amalfitana/ravello/' },
  { name: 'Praiano', desc: 'Playas y grutas', url: '/es-es/costa-amalfitana/praiano/' },
];

const days = [
  {
    day: 'Día 1',
    title: 'Llegada y Positano',
    items: [
      'Llegada a Sorrento o Amalfi. Check-in.',
      'Tarde en Positano: Spiaggia Grande, via Cristoforo Colombo, iglesia Santa Maria Assunta.',
      'Aperitivo con vistas desde el mirador sobre el pueblo.',
      'Cena en Positano o regreso en autobús a Amalfi.',
    ],
  },
  {
    day: 'Día 2',
    title: 'Amalfi y Ravello',
    items: [
      'Mañana: Catedral de Amalfi, Claustro del Paraíso, Museo del Papel (papel amalfitano, s. XIII).',
      'Autobús SITA a Ravello (25 min). Villa Rufolo, Villa Cimbrone, panoramas sobre la Costa.',
      'Almuerzo en Ravello, regreso a Amalfi por la tarde.',
      'Cena en el puerto de Amalfi: pescado del día, mozzarella de búfala.',
    ],
  },
  {
    day: 'Día 3',
    title: 'Praiano y Gruta Esmeralda',
    items: [
      'Mañana: autobús SITA hacia Positano, parada en Praiano (paseo tranquilo, playa Gavitella).',
      'Gruta Esmeralda cerca de Conca dei Marini: entrada ~€5, espectacular luz verde.',
      'Tarde libre en Amalfi o excursión en barco (vuelta a la costa desde Amalfi, ~€40–70 p.p.).',
      'Salida a última hora de la tarde hacia Nápoles/Salerno.',
    ],
  },
];
---

<BaseLayout
  title="Costa Amalfitana en 3 Días 2026 | Itinerario Clásico Completo"
  description="Itinerario clásico de 3 días por la Costa Amalfitana: Positano, Amalfi, Ravello y Gruta Esmeralda. Dónde dormir, qué ver y cómo moverse."
  lang={lang}
  breadcrumbs={breadcrumbs}
  schema={[faqSchema]}
>

  <!-- Hero Section -->
  <section class="relative bg-charcoal overflow-hidden min-h-[70vh] sm:min-h-[75vh] flex items-center justify-center">
    <img src="/images/costiera-hero.jpg" alt="Costa Amalfitana clásica" class="absolute inset-0 w-full h-full object-cover opacity-30" loading="eager" referrerpolicy="no-referrer"/>
    <div class="absolute inset-0 bg-gradient-to-b from-black/20 via-black/40 to-black/80"></div>
    <div class="relative max-w-editorial mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <div class="max-w-3xl mx-auto">
        <p class="text-med-gold text-xs sm:text-sm font-medium uppercase tracking-[0.3em] mb-3">Itinerario · 3 días</p>
        <h1 class="font-serif text-display text-white mb-4">Costa Amalfitana Clásica</h1>
        <p class="text-xl text-white/80 leading-relaxed max-w-2xl mx-auto">
          Tres días en la Costa Amalfitana: Positano, Amalfi, Ravello y Gruta Esmeralda sin coche.
        </p>
      </div>
    </div>
    <Breadcrumbs breadcrumbs={breadcrumbs} />
  </section>

  <div class="max-w-editorial mx-auto px-4 sm:px-6 lg:px-8 pt-6 pb-10 space-y-10">

    <!-- Intro Section -->
    <section class="text-center mb-2 -mt-3">
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-2 sm:gap-4 mb-6 overflow-x-auto snap-x snap-mandatory sm:overflow-visible pb-2 sm:pb-0">
        <!-- Box 1: Duration -->
        <div class="w-full bg-slate-900 rounded-2xl p-4 sm:p-6 hover:shadow-md transition-shadow flex flex-col items-center justify-center aspect-square snap-start">
          <svg class="w-8 h-8 text-med-gold mb-3" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg>
          <p class="text-xs text-white/60 font-semibold uppercase tracking-wide mb-2">Duración</p>
          <p class="font-serif text-lg font-semibold text-med-gold">3 días</p>
        </div>
        <!-- Box 2: Bases -->
        <div class="w-full bg-slate-900 rounded-2xl p-4 sm:p-6 hover:shadow-md transition-shadow flex flex-col items-center justify-center aspect-square snap-start">
          <svg class="w-8 h-8 text-med-gold mb-3" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
          <p class="text-xs text-white/60 font-semibold uppercase tracking-wide mb-2">Bases</p>
          <p class="font-serif text-lg font-semibold text-med-gold">Amalfi<br/>Positano</p>
        </div>
        <!-- Box 3: Transport -->
        <div class="w-full bg-slate-900 rounded-2xl p-4 sm:p-6 hover:shadow-md transition-shadow flex flex-col items-center justify-center aspect-square snap-start">
          <svg class="w-8 h-8 text-med-gold mb-3" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M6 9l6-6 6 6M5 9v9a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V9M9 14h6"/></svg>
          <p class="text-xs text-white/60 font-semibold uppercase tracking-wide mb-2">Transporte</p>
          <p class="font-serif text-lg font-semibold text-med-gold">Autobús SITA<br/>Ferry</p>
        </div>
        <!-- Box 4: Budget -->
        <div class="w-full bg-slate-900 rounded-2xl p-4 sm:p-6 hover:shadow-md transition-shadow flex flex-col items-center justify-center aspect-square snap-start">
          <svg class="w-8 h-8 text-med-gold mb-3" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><circle cx="12" cy="12" r="1"/><path d="M12 1v6M12 17v6M4.22 4.22l4.24 4.24M15.54 15.54l4.24 4.24M1 12h6M17 12h6M4.22 19.78l4.24-4.24M15.54 8.46l4.24-4.24"/></svg>
          <p class="text-xs text-white/60 font-semibold uppercase tracking-wide mb-2">Presupuesto</p>
          <p class="font-serif text-lg font-semibold text-med-gold">€50–100<br/><span class="text-xs">p.p.</span></p>
        </div>
      </div>

      <!-- SEO paragraph -->
      <div>
        <p class="text-lg text-slate-700 leading-relaxed">
          Un <strong>itinerario clásico perfecto de 3 días</strong> en la <strong>Costa Amalfitana</strong>: explore <strong>Positano</strong> con sus casas coloridas, <strong>Amalfi</strong> con su catedral histórica, <strong>Ravello</strong> con sus villas y puntos de vista panorámicos, y la espectacular <strong>Gruta Esmeralda</strong>. Todo accesible por transporte público.
        </p>
      </div>
    </section>

    <!-- Day by Day Itinerary -->
    <section>
      <h2 class="font-serif text-2xl font-semibold text-slate-900 mb-8">Programa día a día</h2>
      <div class="space-y-6">
        {days.map((d, idx) => (
          <div class="bg-white border border-slate-200 rounded-2xl overflow-hidden hover:shadow-md transition-shadow">
            <div class="bg-slate-900 px-6 py-6 flex items-start gap-4 sm:items-center sm:gap-3">
              <span class="text-[10px] uppercase tracking-wide bg-white/15 text-white px-3 py-1.5 rounded-full font-bold flex-shrink-0">{d.day}</span>
              <h3 class="font-serif font-semibold text-white text-lg">{d.title}</h3>
            </div>
            <ul class="px-6 py-5 space-y-3">
              {d.items.map((item, itemIdx) => {
                const isLocalTip = item.includes('Local tip:');
                const displayText = item.replace('Local tip: ', '');
                const isLastItem = itemIdx === d.items.length - 1;
                return (
                  <li key={itemIdx} class={`flex gap-3 text-sm relative ${isLocalTip ? 'bg-med-gold/10 p-3 rounded-lg border border-med-gold/20' : ''}`}>
                    <div class="flex flex-col items-center">
                      {isLocalTip ? (
                        <svg class="w-5 h-5 text-med-gold flex-shrink-0 self-center" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
                          <circle cx="12" cy="8" r="5"/>
                          <path d="M12 13v2"/>
                          <rect x="10" y="15" width="4" height="3" rx="0.5"/>
                        </svg>
                      ) : (
                        <span class="w-2 h-2 rounded-full bg-med-blue flex-shrink-0"></span>
                      )}
                      {!isLastItem && <div class="w-0.5 h-6 bg-med-blue/30 mt-1"></div>}
                    </div>
                    <span class={`leading-relaxed ${isLocalTip ? 'font-semibold text-slate-800' : 'text-slate-700'}`}>
                      {isLocalTip && <strong>Local tip: </strong>}
                      {displayText}
                    </span>
                  </li>
                );
              })}
            </ul>
          </div>
        ))}
      </div>
    </section>

    <!-- Destinations Highlighted -->
    <section>
      <h2 class="font-serif text-2xl font-semibold text-slate-900 mb-8">Puntos destacados del itinerario</h2>
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4">
        {destinationHighlights.map((dest) => (
          <a href={dest.url} class="group block bg-white border border-slate-200 rounded-2xl p-5 hover:shadow-lg hover:border-med-blue/30 transition-all">
            <h3 class="font-semibold text-charcoal mb-2 group-hover:text-med-blue transition-colors">{dest.name}</h3>
            <p class="text-xs text-slate-500 leading-relaxed mb-3">{dest.desc}</p>
            <span class="text-xs font-semibold text-med-blue inline-flex items-center gap-1 group-hover:gap-2 transition-all">
              Descubrir →
            </span>
          </a>
        ))}
      </div>
    </section>

    <!-- Planning Tips -->
    <section class="bg-med-cream border border-med-gold/20 rounded-[2rem] p-6">
      <h2 class="font-serif text-xl font-semibold text-charcoal mb-6">Consejos prácticos</h2>
      <ul class="space-y-4">
        {[
          { num: '❶', text: 'Base en Amalfi: posición central, más barata que Positano, excelentes conexiones en autobús y ferry.' },
          { num: '❷', text: 'Comprar los billetes SITA en lote (estanco) a la llegada: ahorra tiempo cada mañana.' },
          { num: '❸', text: 'Ravello no tiene playas pero ofrece el mejor mirador de la Costa: prever al menos medio día.' },
          { num: '❹', text: 'El tour en barco del día 3 es opcional pero transforma la jornada: reservar la víspera.' },
          { num: '❺', text: 'En verano: desplazarse antes de las 9h para evitar los autobuses llenos y las colas.' },
        ].map(({ num, text }) => (
          <li class="flex items-start gap-4 text-sm text-charcoal">
            <span class="text-2xl font-bold text-white flex-shrink-0 leading-none mt-0.5 bg-[#E2725B] w-9 h-9 flex items-center justify-center rounded-full">{num}</span>
            <span class="leading-relaxed">{text}</span>
          </li>
        ))}
      </ul>
    </section>

    <!-- FAQ -->
    <section id="faq">
      <h2 class="font-serif text-2xl font-semibold text-slate-900 mb-6">Preguntas frecuentes</h2>
      <div class="space-y-4">
        {faqSchema.mainEntity.map((q) => (
          <details class="group border border-slate-200 rounded-2xl overflow-hidden">
            <summary class="flex items-center justify-between px-6 py-4 cursor-pointer select-none text-charcoal font-medium hover:bg-slate-50 transition-colors">
              {q.name}
              <svg class="w-4 h-4 text-slate-400 group-open:rotate-180 transition-transform flex-shrink-0 ml-3" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
            </summary>
            <div class="px-6 pb-5 text-slate-600 leading-relaxed text-sm border-t border-slate-100 pt-4">
              {q.acceptedAnswer.text}
            </div>
          </details>
        ))}
      </div>
    </section>

    <!-- CTA -->
    <section class="bg-gradient-to-r from-med-blue to-med-blue/80 rounded-2xl p-10 text-center text-white">
      <h2 class="font-serif text-3xl font-bold mb-3">¿Listo para partir?</h2>
      <p class="text-white/90 mb-6 max-w-2xl mx-auto">
        Lee la guía completa de transporte público en la Costa: cómo llegar, horarios, billetes y estrategias para ahorrar.
      </p>
      <a href="/es-es/guia/como-llegar/" class="inline-block bg-white text-med-blue font-semibold px-8 py-3 rounded-full hover:bg-slate-100 transition-colors">
        Guía de transporte →
      </a>
    </section>

  </div>

</BaseLayout>
