---
import BaseLayout from '../../../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../../../components/Breadcrumbs.astro';

const lang = 'es-es';

const breadcrumbs = [
  { name: 'Inicio', url: '/es-es/' },
  { name: 'Planificación', url: '/es-es/planificacion/' },
  { name: 'Slow Travel - 7 días', url: '/es-es/itinerarios/7-dias/slow-travel-pueblos-gastronomia/' },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "¿Qué es el slow travel en la Costa Amalfitana?",
      "acceptedAnswer": { "@type": "Answer", "text": "El slow travel en la Costa significa quedarse más días en el mismo pueblo en lugar de moverse cada día, comer en restaurantes locales (no turísticos), caminar por senderos poco conocidos, ir al mercado, comprar productos locales (limones, anchoas, vino tinto de Ravello). Es lo contrario del itinerario todo incluido." }
    },
    {
      "@type": "Question",
      "name": "¿Cuáles son los pueblos menos turísticos de la Costa Amalfitana?",
      "acceptedAnswer": { "@type": "Answer", "text": "Los pueblos menos visitados son: Praiano (entre Positano y Amalfi, sin ZTL, playa tranquila), Cetara (famoso por la colatura de anchoas, auténtico), Furore (el pueblo que no existe, construido en el desfiladero), Conca dei Marini (300 habitantes, cerca de la Gruta Esmeralda). Todos accesibles en autobús SITA por la SS163." }
    }
  ]
};

const days = [
  { day: 'Día 1', title: 'Llegada a Praiano', highlight: 'Playa Gavitella y trattoria local', items: ['Praiano: el pueblo central sin ZTL. Menos turistas que Positano, precios más bajos. Base aquí o en Amalfi.', 'Playa Gavitella: pequeña, bonita, accesible a pie. Toma el sol y relájate después del viaje.', 'Cena en una trattoria del puerto: pescado del día, vino blanco local.', 'Consejo local: Praiano tiene aparcamiento limitado. Llega temprano o usa aparcamientos públicos en las afueras del pueblo.'] },
  { day: 'Día 2', title: 'Sendero de los Dioses', highlight: 'Caminata legendaria Agerola a Nocelle', items: ['Madrugada. Autobús SITA a Amalfi, luego a Agerola (inicio del sendero, 45 min, ~€1.50).', 'Sendero de los Dioses (Agerola→Nocelle, 8 km, 3–4h, grado EE exigente). Viñedos en terrazas, vistas impresionantes, descenso de 500 m.', 'Almuerzo en un rifugio en Nocelle con panorama sobre el golfo.', 'Bajada a Positano en autobús local (15 min) o a pie (45 min, 1.000 escalones).', 'Regreso a Praiano en autobús SITA.', 'Consejo local: Reserva el Sendero de los Dioses en julio–agosto (reserva obligatoria, ~€5). Lleva 1,5+ litros de agua, botas de senderismo, sin tiendas en el sendero.'] },
  { day: 'Día 3', title: 'Amalfi y Furore', highlight: 'Mercado, Museo del Papel, Fiordo', items: ['Autobús SITA a Amalfi. Mañana: mercado jueves o sábado (productos locales, mozzarella, limones, miel).', 'Museo del Papel de Amalfi: papel artesanal fabricado desde el siglo XIII (entrada ~€5).', 'Furore: el Fiordo di Furore, parada a demanda en autobús SITA. El pueblo construido dentro del desfiladero, escondido del mar.', 'Aperitivo en el puerto. Pasta fresca y anchoas.', 'Consejo local: El mercado de Amalfi (martes y jueves temprano) es el mejor para productos locales. Ve temprano, cierra antes del mediodía.'] },
  { day: 'Día 4', title: 'Ravello y Scala', highlight: 'Caminata entre viñedos y cata de vinos', items: ['Madrugada. Autobús a Ravello (25 min desde Amalfi). Mañana tranquila sin masas a las 9:00.', 'Sendero Ravello→Scala: 4 km entre olivares y viñedos, vistas panorámicas sobre el golfo (1.5h).', 'Almuerzo en Scala (pueblo minúsculo, antipasti tradicionales, pasta, vino).', 'Tarde: visita a un productor local de vinos. Cata de vino tinto de Ravello (tintos ligeros y fragantes de viñedos de altitud).', 'Regreso a base en autobús o a pie (bajada empinada, 1.5h, 800 escalones).', 'Consejo local: Ravello no tiene playas pero es el mirador más fino de la Costa. Pregunta por productores de vino que ofrecen catas (muchos lo hacen).'] },
  { day: 'Día 5', title: 'Cetara y Vietri', highlight: 'Cata de colatura de anchoas y tour de cerámica', items: ['Autobús SITA hacia el este hasta Cetara (famoso por su colatura de anchoas DOP). Mercado de pescado en el puerto.', 'Visita al Museo de la Colatura. Cata de colatura di alici. Compra directa a productores locales.', 'Almuerzo en una trattoria sencilla: pasta con salsa de anchoa, pescado a la plancha, vino blanco local.', 'Vietri sul Mare: capital de la cerámica de Campania. Recorre talleres de cerámica y el Museo de la Cerámica (entrada ~€4).', 'Paseo por el frente marítimo. Cena con vistas.', 'Consejo local: La cerámica de Vietri está pintada a mano y es única. Los talleres pequeños son más baratos que las tiendas turísticas. Pregunta a los locales.'] },
  { day: 'Día 6', title: 'Valle delle Ferriere', highlight: 'Senderismo de cascadas y calas escondidas', items: ['Mañana: senderismo Valle delle Ferriere desde Amalfi (7 km ida y vuelta, 3h, fácil–moderado). Helechos subtropicales, cascadas, cañón de río.', 'Baño en los estanques de esmeralda (lleva bañador y toalla).', 'Tarde: tour en kayak desde el puerto de Amalfi (opcional, ~€60 por persona) a lo largo de calas escondidas, cuevas, acantilados.', 'Cena de pescado fresco en Amalfi: captura del día, pasta ai frutti di mare.', 'Consejo local: Valle delle Ferriere: lleva zapatillas de agua (rocas resbaladizas), trae una chaqueta impermeable ligera (spray de cascadas).'] },
  { day: 'Día 7', title: 'Mercado y partida', highlight: 'Productos locales y almuerzo de despedida', items: ['Mañana libre en el mercado local. Compra productos típicos: limoncello artesanal, anchoas en tarros de vidrio, cerámica de Vietri, miel.', 'Almuerzo en una trattoria familiar con el dueño. Despedidas.', 'Empacar y prepararse para la partida.', 'Autobús SITA a Salerno (60 min desde Amalfi) o Sorrento (90 min) para trenes o aeropuerto.', 'Consejo local: Limoncello y salsa de anchoa viajan bien. Cerámica es frágil: pide al vendedor un embalaje adecuado o cómprala en el aeropuerto.'] },
];
const touristTripSchema = {
  "@context": "https://schema.org",
  "@type": "TouristTrip",
  "name": "Slow Travel - 7 días",
  "description": "Itinerario slow travel de 7 días por la Costa Amalfitana: Praiano, Furore, Cetara, Valle delle Ferriere y Sendero de los Dioses. Pueblos auténticos, mercados locales y gastronomía.",
  "image": "https://amalficoast-travel.com/images/costiera-hero.jpg",
  "url": "https://amalficoast-travel.com/es-es/itinerarios/7-dias/slow-travel-pueblos-gastronomia/",
  "itinerary": {
    "@type": "ItemList",
    "numberOfItems": days.length,
    "itemListElement": days.map((d, i) => ({
      "@type": "ListItem",
      "position": i + 1,
      "name": `${d.day}: ${d.title}`,
      "description": d.items.join(' \u00b7 ')
    }))
  },
  "touristType": "Sightseeing"
};
---

<BaseLayout
  title="Slow Travel Costa Amalfitana 7 Días 2026 | Pueblos, Gastronomía y Senderos"
  description="Itinerario slow travel de 7 días por la Costa Amalfitana: Praiano, Furore, Cetara, Valle delle Ferriere y Sendero de los Dioses. Pueblos auténticos, mercados locales y gastronomía."
  lang={lang}
  breadcrumbs={breadcrumbs}
  schema={[faqSchema, touristTripSchema]}
 pageKey="slow-travel-pueblos-gastronomia"
  heroImage="/images/costiera-hero.jpg"
>

  <section class="relative bg-charcoal overflow-hidden">
    <img src="/images/costiera-hero.jpg" alt="Slow travel Costa Amalfitana" class="absolute inset-0 w-full h-full object-cover" loading="eager" fetchpriority="high" decoding="sync" referrerpolicy="no-referrer"/>

    <div class="absolute inset-0 bg-gradient-to-b from-black/75 via-black/40 to-black/70"></div>
    <div class="relative z-10 max-w-7xl mx-auto px-6">
      <div class="max-w-3xl">
        <p class="text-med-gold text-xs sm:text-sm font-medium uppercase tracking-[0.3em] mb-3">Itinerario · 7 días</p>
        <h1 class="font-serif text-display text-white mb-4">Slow Travel: Pueblos y Gastronomía</h1>
        <p class="text-xl text-white/80 leading-relaxed max-w-2xl">
          Una semana lenta: pueblos auténticos, mercados locales, senderos secretos y gastronomía de la Costa.
        </p>
      </div>
    </div>
    <Breadcrumbs breadcrumbs={breadcrumbs} />
  </section>

  <div class="max-w-editorial mx-auto px-4 sm:px-6 lg:px-8 pt-6 pb-10 space-y-10">

    <!-- Intro & Stats Section -->
    <section class="text-center mb-2 -mt-3">
      <!-- Quick Stats Grid -->
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-2 sm:gap-4 mb-6 overflow-x-auto snap-x snap-mandatory sm:overflow-visible pb-2 sm:pb-0">
        <div class="bg-slate-900 rounded-2xl p-6 hover:shadow-md transition-shadow flex flex-col items-center justify-center aspect-square snap-start">
          <svg class="w-8 h-8 text-med-gold mb-3" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
            <rect x="3" y="4" width="18" height="18" rx="2"/>
            <path d="M16 2v4M8 2v4M3 10h18"/>
          </svg>
          <p class="text-xs text-white/60 font-semibold uppercase tracking-wide mb-2">Duración</p>
          <p class="font-serif text-lg font-semibold text-med-gold">7 días<br/>6 noches</p>
        </div>
        <div class="bg-slate-900 rounded-2xl p-6 hover:shadow-md transition-shadow flex flex-col items-center justify-center aspect-square snap-start">
          <svg class="w-8 h-8 text-med-gold mb-3" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
            <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/>
            <circle cx="12" cy="10" r="3"/>
          </svg>
          <p class="text-xs text-white/60 font-semibold uppercase tracking-wide mb-2">Bases</p>
          <p class="font-serif text-lg font-semibold text-med-gold">Nápoles +<br/>Amalfi/Sorrento</p>
        </div>
        <div class="bg-slate-900 rounded-2xl p-6 hover:shadow-md transition-shadow flex flex-col items-center justify-center aspect-square snap-start">
          <svg class="w-8 h-8 text-med-gold mb-3" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
            <path d="M6 9l6-6 6 6M5 9v9a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V9M9 14h6"/>
          </svg>
          <p class="text-xs text-white/60 font-semibold uppercase tracking-wide mb-2">Transporte</p>
          <p class="font-serif text-lg font-semibold text-med-gold">Tren + autobús<br/>+ ferries</p>
        </div>
        <div class="bg-slate-900 rounded-2xl p-6 hover:shadow-md transition-shadow flex flex-col items-center justify-center aspect-square snap-start">
          <svg class="w-8 h-8 text-med-gold mb-3" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
            <circle cx="12" cy="12" r="1"/>
            <path d="M12 1v6M12 17v6M4.22 4.22l4.24 4.24M15.54 15.54l4.24 4.24M1 12h6M17 12h6M4.22 19.78l4.24-4.24M15.54 8.46l4.24-4.24"/>
          </svg>
          <p class="text-xs text-white/60 font-semibold uppercase tracking-wide mb-2">Presupuesto transporte</p>
          <p class="font-serif text-lg font-semibold text-med-gold">€80–120<br/><span class="text-xs">p.p.</span></p>
        </div>
      </div>

      <!-- SEO Text -->
      <div>
        <p class="text-lg text-slate-700 leading-relaxed">
          El <strong>Gran Tour de 7 días</strong> es la ruta clásica del sur de Italia: combinando dos días en <strong>Nápoles</strong>, la extraordinaria <strong>Costa Amalfitana</strong> con Positano, Amalfi y Ravello, la <strong>Península de Sorrento</strong>, <strong>Capri</strong> con la Grotta Azzurra y las <strong>islas del Golfo</strong>. Todo con transporte público.
        </p>
      </div>
    </section>

    <section class="max-w-text">
      <div class="grid sm:grid-cols-4 gap-4">
        <div class="bg-med-cream rounded-2xl p-4 text-center border border-slate-100">
          <p class="text-xs text-slate-400 mb-1">Duración</p>
          <p class="font-semibold text-charcoal">7 días / 6 noches</p>
        </div>
        <div class="bg-med-cream rounded-2xl p-4 text-center border border-slate-100">
          <p class="text-xs text-slate-400 mb-1">Base</p>
          <p class="font-semibold text-charcoal">Praiano o Amalfi</p>
        </div>
        <div class="bg-med-cream rounded-2xl p-4 text-center border border-slate-100">
          <p class="text-xs text-slate-400 mb-1">Mejor temporada</p>
          <p class="font-semibold text-charcoal">May–Jun / Sep–Oct</p>
        </div>
        <div class="bg-med-cream rounded-2xl p-4 text-center border border-slate-100">
          <p class="text-xs text-slate-400 mb-1">Ritmo</p>
          <p class="font-semibold text-charcoal">Lento</p>
        </div>
      </div>
    </section>

    <section>
      <h2 class="font-serif text-2xl font-semibold text-slate-900 mb-8">Programa día a día</h2>
      <div class="space-y-6">
        {days.map(d => (
          <div class="bg-white border border-slate-200 rounded-2xl overflow-hidden hover:shadow-md transition-shadow">
            <div class="bg-slate-900 px-6 py-6 flex items-start gap-4 sm:items-center sm:gap-3">
              <span class="text-[10px] uppercase tracking-wide bg-white/15 text-white px-3 py-1.5 rounded-full font-bold flex-shrink-0">{d.day}</span>
              <div class="flex-1 min-w-0">
                <h3 class="font-serif font-semibold text-white text-lg">{d.title}</h3>
                <p class="text-xs text-med-gold mt-1 font-medium">{d.highlight}</p>
              </div>
            </div>
            <ul class="px-6 py-5 space-y-3">
              {d.items.map((item, itemIdx) => {
                const isLocalTip = item.includes('Consejo local:');
                const displayText = item.replace('Consejo local: ', '');
                const isLastItem = itemIdx === d.items.length - 1;
                return (
                  <li key={itemIdx} class={`flex gap-3 text-sm relative ${isLocalTip ? 'bg-med-gold/10 p-3 rounded-lg border border-med-gold/20' : ''}`}>
                    <div class="flex flex-col items-center">
                      {isLocalTip ? (
                        <svg class="w-5 h-5 text-med-gold flex-shrink-0 self-center" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
                          <circle cx="12" cy="8" r="5"/>
                          <path d="M12 13v2"/>
                          <rect x="10" y="15" width="4" height="3" rx="0.5"/>
                        </svg>
                      ) : (
                        <span class="w-2 h-2 rounded-full bg-med-blue flex-shrink-0"></span>
                      )}
                      {!isLastItem && <div class="w-0.5 h-6 bg-med-blue/30 mt-1"></div>}
                    </div>
                    <span class={`leading-relaxed ${isLocalTip ? 'font-semibold text-slate-800' : 'text-slate-700'}`}>
                      {isLocalTip && <strong>Consejo local: </strong>}
                      {displayText}
                    </span>
                  </li>
                );
              })}
            </ul>
          </div>
        ))}
      </div>
    </section>

    <section class="bg-charcoal text-white rounded-[2rem] p-8">
      <p class="text-[10px] uppercase tracking-[0.3em] text-med-gold font-medium mb-4">Productos que no hay que perderse</p>
      <div class="grid sm:grid-cols-2 gap-6 text-xs sm:text-sm">
        <div>
          <p class="font-semibold mb-1">Limón sfusato amalfitano IGP</p>
          <p class="text-white/70">Los enormes limones de la Costa: aroma único, piel gruesa. Comprarlos directamente a los productores de Amalfi o Minori.</p>
        </div>
        <div>
          <p class="font-semibold mb-1">Colatura de anchoas de Cetara DOP</p>
          <p class="text-white/70">Garum moderno: un líquido ámbar de anchoas fermentadas. Cetara produce la mejor versión DOP de Italia.</p>
        </div>
        <div>
          <p class="font-semibold mb-1">Vino de Ravello</p>
          <p class="text-white/70">Los viñedos en altitud producen un tinto ligero y aromático. Cata en las bodegas de Ravello.</p>
        </div>
        <div>
          <p class="font-semibold mb-1">Cerámica de Vietri sul Mare</p>
          <p class="text-white/70">La capital italiana de la cerámica: azulejos, platos y obras pintadas a mano. Elegir los talleres artesanales locales.</p>
        </div>
      </div>
    </section>

    <section id="faq">
      <h2 class="font-serif text-2xl font-semibold text-slate-900 mb-6">Preguntas frecuentes</h2>
      <div class="space-y-4">
        {faqSchema.mainEntity.map((q) => (
          <details class="group border border-slate-200 rounded-2xl overflow-hidden">
            <summary class="flex items-center justify-between px-6 py-4 cursor-pointer select-none text-charcoal font-medium hover:bg-slate-50 transition-colors">
              {q.name}
              <svg class="w-4 h-4 text-slate-400 group-open:rotate-180 transition-transform flex-shrink-0 ml-3" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
            </summary>
            <div class="px-6 pb-5 text-slate-600 leading-relaxed text-xs sm:text-sm border-t border-slate-100 pt-4">
              {q.acceptedAnswer.text}
            </div>
          </details>
        ))}
      </div>
    </section>

    <!-- BANNER: Planificador de Itinerario -->
    <section class="relative overflow-hidden rounded-[2rem] bg-gradient-to-br from-slate-900 via-slate-950 to-blue-950 px-6 sm:px-10 py-8 md:py-10 shadow-[0_20px_60px_rgba(0,0,0,0.35)]">
      <div class="absolute -top-20 -left-20 w-72 h-72 bg-blue-500/15 rounded-full blur-3xl pointer-events-none"></div>
      <div class="absolute -bottom-20 -right-20 w-72 h-72 bg-amber-500/10 rounded-full blur-3xl pointer-events-none"></div>
      <div class="relative z-10 md:flex md:items-center md:justify-between gap-8">
        <div>
          <span class="inline-block px-3 py-1 rounded-full text-[10px] font-semibold tracking-wide uppercase bg-med-gold/15 text-med-gold border border-med-gold/25 mb-4">Nuevo: Planificador de Viaje</span>
          <h2 class="text-2xl md:text-3xl font-bold text-white leading-tight mb-2">Diseña tu <span class="font-serif italic text-med-blue">itinerario perfecto</span></h2>
          <p class="text-white/60 text-sm md:text-base leading-relaxed max-w-xl">Responde unas sencillas preguntas y obtén un itinerario personalizado con transporte, costes y horarios.</p>
        </div>
        <div class="mt-6 md:mt-0 flex-shrink-0">
          <a href="/es-es/planificador-itinerario/" class="inline-flex items-center gap-2.5 px-7 py-3.5 bg-gradient-to-r from-med-gold to-yellow-600 text-slate-900 font-bold rounded-xl hover:shadow-[0_0_30px_rgba(212,175,55,0.4)] hover:scale-105 transition-all duration-300">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 2L2 12l4 0 0 6 4 0 0-4 4 0 0 4 4 0 0-6 4 0L12 2z"/></svg>
            Planifica Ahora
          </a>
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="bg-gradient-to-r from-med-blue to-med-blue/80 rounded-2xl p-10 text-center text-white">
      <h2 class="font-serif text-3xl font-bold mb-3">¿Listo para viajar lentamente?</h2>
      <p class="text-white/90 mb-6 max-w-2xl mx-auto">
        Descubre más sobre slow travel en la Costa Amalfitana: pueblos auténticos, mercados locales, senderos de senderismo y experiencias gastronómicas.
      </p>
      <a href="/es-es/guia/como-llegar/" class="inline-block bg-white text-med-blue font-semibold px-8 py-3 rounded-full hover:bg-slate-100 transition-colors">
        Guía de viajes →
      </a>
    </section>

  </div>

</BaseLayout>
