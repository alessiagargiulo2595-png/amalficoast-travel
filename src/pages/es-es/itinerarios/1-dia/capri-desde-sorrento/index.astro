---
import BaseLayout from '../../../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../../../components/Breadcrumbs.astro';

const lang = 'es-es';

const breadcrumbs = [
  { name: 'Home', url: '/es-es/' },
  { name: 'Planificación', url: '/es-es/planificacion/' },
  { name: 'Capri desde Sorrento', url: '/es-es/itinerarios/1-dia/capri-desde-sorrento/' },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "¿Cuánto tiempo se tarda de Sorrento a Capri en hidrofoil?",
      "acceptedAnswer": { "@type": "Answer", "text": "El hidrofoil desde Sorrento (Marina Piccola) a Capri (Marina Grande) tarda aproximadamente 20-25 minutos. Las principales compañías son NLG y Alilauro. En verano los viajes salen cada 30-60 min desde las 7:00 hasta las 20:00. El billete de ida y vuelta cuesta ~€18-22." }
    },
    {
      "@type": "Question",
      "name": "¿Es posible ver la Grotta Azzurra en un día desde Sorrento?",
      "acceptedAnswer": { "@type": "Answer", "text": "Sí, pero requiere una organización precisa. Toma el primer hidrofoil desde Sorrento (7:30-8:00), llega a Capri y ve directamente a la Grotta Azzurra antes de la multitud (idealmente antes de las 10:00). Luego explora Capri y Anacapri por la tarde. Regreso a Sorrento con el último hidrofoil (alrededor de las 18:30-19:00)." }
    },
    {
      "@type": "Question",
      "name": "Capri vs. Anacapri: ¿cuál visitar en un día?",
      "acceptedAnswer": { "@type": "Answer", "text": "Ambas merecen la pena, pero con un solo día elige según tus intereses: Capri ciudad es más elegante, llena de tiendas y con los Faraglioni. Anacapri es más tranquila, con Villa San Michele y el teleférico a Monte Solaro (589 m). Un buen día incluye la Grotta Azzurra por la mañana, almuerzo en Anacapri, tarde en Capri y Faraglioni." }
    }
  ]
};

const schedule = [
  { time: '07:30', place: 'Sorrento, Marina Piccola', action: 'Hidrofoil NLG/Alilauro a Capri (20-25 min, ~€9-11)', transport: 'ferry' },
  { time: '08:00', place: 'Capri, Marina Grande', action: 'Autobús a la Grotta Azzurra (20 min, ~€2). Llega antes de las 10 para evitar colas.', transport: 'bus' },
  { time: '08:30', place: 'Grotta Azzurra', action: 'Bote de remos en la grotta (€15 + entrada €14). Espera variable.', transport: 'ferry' },
  { time: '10:00', place: 'Anacapri', action: 'Autobús desde Capri a Anacapri (15 min). Villa San Michele (~€7). Teleférico Monte Solaro (589 m, ~€13 ida/vuelta).', transport: 'bus' },
  { time: '12:30', place: 'Anacapri', action: 'Almuerzo en una trattoria local (más barato que el centro de Capri)', transport: 'visit' },
  { time: '14:00', place: 'Centro de Capri', action: 'Autobús a Capri. Piazzetta, Via Camerelle, Jardines de Augusto, vista de los Faraglioni.', transport: 'bus' },
  { time: '16:00', place: 'Marina Grande', action: 'Tour en bote alrededor de los Faraglioni (~€18-25 p.p., 1-2h)', transport: 'ferry' },
  { time: '18:00', place: 'Capri → Sorrento', action: 'Hidrofoil de regreso a Sorrento (20-25 min)', transport: 'ferry' },
];

const tips = [
  'Grotta Azzurra: antes de las 10:00 casi sin colas. Después de las 11 la espera puede ser de 1-2 horas.',
  'En julio-agosto, reserva el hidrofoil online el día anterior: los primeros viajes se agotan rápido.',
  'Capri es cara: almorzar en Anacapri cuesta 30-40% menos que en la Piazzetta.',
  'El teleférico a Monte Solaro desde Anacapri es imprescindible: 589 m, vista 360° a la Costa y Nápoles.',
  'El hidrofoil no sale con mar agitado: comprueba el pronóstico marino y ten un plan B.',
];

const transportBadge: Record<string, { label: string; cls: string }> = {
  train: { label: 'TREN', cls: 'bg-orange-100 text-orange-700' },
  ferry: { label: 'FERRY', cls: 'bg-blue-100 text-blue-700' },
  bus:   { label: 'BUS', cls: 'bg-green-100 text-green-700' },
  walk:  { label: 'A PIE', cls: 'bg-gray-100 text-slate-500' },
  visit: { label: '', cls: '' },
};

const destinationHighlights = [
  { name: 'Capri', desc: 'Isla con Grotta Azzurra, Anacapri, Faraglioni, Monte Solaro', url: '/es-es/islas/capri/' },
  { name: 'Marina Piccola Capri', desc: 'Bahía exclusiva con vista a los Faraglioni', url: '/es-es/spiagge/islas/marina-piccola-capri/' },
];
---

<BaseLayout
  title="Capri desde Sorrento en 1 Día 2026 | Grotta Azzurra, Faraglioni, Anacapri"
  description="Excursión de un día a Capri desde Sorrento: Grotta Azzurra, Anacapri, Monte Solaro y Faraglioni. Hidrofoiles, horarios y consejos para evitar colas."
  lang={lang}
  breadcrumbs={breadcrumbs}
  schema={[faqSchema]}
 pageKey="capri-desde-sorrento">

  <!-- Hero Section -->
  <section class="relative bg-charcoal overflow-hidden min-h-[70vh] sm:min-h-[75vh] flex items-center justify-center">
    <img src="/images/capri-hero.jpg" alt="Capri desde Sorrento" class="absolute inset-0 w-full h-full object-cover opacity-30" loading="eager" referrerpolicy="no-referrer"/>
    <div class="absolute inset-0 bg-gradient-to-b from-black/75 via-black/40 to-black/70"></div>
    <div class="relative max-w-editorial mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <div class="max-w-3xl mx-auto">
        <p class="text-med-gold text-xs sm:text-sm font-medium uppercase tracking-[0.3em] mb-3">Itinerario · 1 día</p>
        <h1 class="font-serif text-display text-white mb-4">Capri desde Sorrento</h1>
        <p class="text-xl text-white/80 leading-relaxed max-w-2xl mx-auto">
          Capri desde Sorrento en hidrofoil: Grotta Azzurra, Anacapri y Faraglioni.
        </p>
      </div>
    </div>
    <Breadcrumbs breadcrumbs={breadcrumbs} />
  </section>

  <div class="max-w-editorial mx-auto px-4 sm:px-6 lg:px-8 pt-6 pb-10 space-y-10">

    <!-- Intro & Stats Section - Featured -->
    <section class="text-center mb-2">
      <!-- Quick Stats Grid - Scrollable on Mobile -->
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-2 sm:gap-4 mb-6 overflow-x-auto snap-x snap-mandatory sm:overflow-visible pb-2 sm:pb-0">
        <div class="w-full bg-slate-900 rounded-2xl p-4 sm:p-6 hover:shadow-md transition-shadow flex flex-col items-center justify-center aspect-square snap-start">
          <svg class="w-8 h-8 text-med-gold mb-3" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
            <rect x="3" y="4" width="18" height="18" rx="2"/>
            <path d="M16 2v4M8 2v4M3 10h18"/>
          </svg>
          <p class="text-xs text-white/60 font-semibold uppercase tracking-wide mb-2">Duración</p>
          <p class="font-serif text-lg font-semibold text-med-gold">1 día</p>
        </div>
        <div class="w-full bg-slate-900 rounded-2xl p-4 sm:p-6 hover:shadow-md transition-shadow flex flex-col items-center justify-center aspect-square snap-start">
          <svg class="w-8 h-8 text-med-gold mb-3" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
            <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/>
            <circle cx="12" cy="10" r="3"/>
          </svg>
          <p class="text-xs text-white/60 font-semibold uppercase tracking-wide mb-2">Punto de partida</p>
          <p class="font-serif text-lg font-semibold text-med-gold">Sorrento</p>
        </div>
        <div class="w-full bg-slate-900 rounded-2xl p-4 sm:p-6 hover:shadow-md transition-shadow flex flex-col items-center justify-center aspect-square snap-start">
          <svg class="w-8 h-8 text-med-gold mb-3" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
            <path d="M6 9l6-6 6 6M5 9v9a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V9M9 14h6"/>
          </svg>
          <p class="text-xs text-white/60 font-semibold uppercase tracking-wide mb-2">Transporte</p>
          <p class="font-serif text-lg font-semibold text-med-gold">Hidrofoil<br/>+ Autobús</p>
        </div>
        <div class="w-full bg-slate-900 rounded-2xl p-4 sm:p-6 hover:shadow-md transition-shadow flex flex-col items-center justify-center aspect-square snap-start">
          <svg class="w-8 h-8 text-med-gold mb-3" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
            <circle cx="12" cy="12" r="1"/>
            <path d="M12 1v6M12 17v6M4.22 4.22l4.24 4.24M15.54 15.54l4.24 4.24M1 12h6M17 12h6M4.22 19.78l4.24-4.24M15.54 8.46l4.24-4.24"/>
          </svg>
          <p class="text-xs text-white/60 font-semibold uppercase tracking-wide mb-2">Presupuesto transporte</p>
          <p class="font-serif text-lg font-semibold text-med-gold">€40–50<br/><span class="text-xs">p.p.</span></p>
        </div>
      </div>

      <!-- SEO Text Below -->
      <div>
        <p class="text-lg text-slate-700 leading-relaxed">
          Un <strong>día perfecto en Capri</strong> desde <strong>Sorrento</strong> : toma el primer <strong>hidrofoil</strong> (20-25 min) e ve directamente a la <strong>Grotta Azzurra</strong>, la icónica caverna marina. Por la tarde, explora <strong>Anacapri</strong> con Villa San Michele y Monte Solaro, luego vuelve a <strong>Capri</strong> para los <strong>Faraglioni</strong> y un paseo en bote. Regreso al atardecer. <strong>Presupuesto: €40–50</strong>.
        </p>
      </div>
    </section>


    <!-- Day by Day Itinerary -->
    <section>
      <h2 class="font-serif text-2xl font-semibold text-slate-900 mb-8">Programa del día</h2>
      <div class="bg-white border border-slate-200 rounded-2xl overflow-hidden">
        <div class="px-6 py-8 space-y-6">
          {schedule.map((item, idx) => {
            const badge = transportBadge[item.transport];
            const isLastItem = idx === schedule.length - 1;
            return (
              <div class="flex gap-4">
                <div class="flex flex-col items-center flex-shrink-0">
                  <div class="w-16 bg-slate-900 text-med-gold rounded-full px-2 py-1 text-center text-sm font-semibold flex items-center justify-center">
                    {item.time}
                  </div>
                  {!isLastItem && <div class="w-0.5 h-12 bg-med-blue/30 mt-2"></div>}
                </div>
                <div class="pb-4 flex-1">
                  <p class="font-semibold text-slate-900 mb-1">{item.place}</p>
                  <p class="text-slate-700 text-sm mb-2">{item.action}</p>
                  {badge.label && (
                    <span class={`text-xs font-semibold px-2 py-1 rounded-full ${badge.cls}`}>
                      {badge.label}
                    </span>
                  )}
                </div>
              </div>
            );
          })}
        </div>
      </div>
    </section>

    <!-- Destinations Highlighted -->
    <section>
      <h2 class="font-serif text-2xl font-semibold text-slate-900 mb-8">Destinos del itinerario</h2>
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4">
        {destinationHighlights.map((dest) => (
          <a href={dest.url} class="group block bg-white border border-slate-200 rounded-2xl p-5 hover:shadow-lg hover:border-med-blue/30 transition-all">
            <h3 class="font-semibold text-charcoal mb-2 group-hover:text-med-blue transition-colors">{dest.name}</h3>
            <p class="text-xs text-slate-500 leading-relaxed mb-3">{dest.desc}</p>
            <span class="text-xs font-semibold text-med-blue inline-flex items-center gap-1 group-hover:gap-2 transition-all">
              Descubra →
            </span>
          </a>
        ))}
      </div>
    </section>

    <!-- Planning Tips -->
    <section class="bg-med-cream border border-med-gold/20 rounded-[2rem] p-6">
      <h2 class="font-serif text-xl font-semibold text-charcoal mb-6">Consejos prácticos</h2>
      <ul class="space-y-4">
        {tips.map((text, idx) => {
          const nums = ['❶', '❷', '❸', '❹', '❺'];
          return (
            <li class="flex items-start gap-4 text-sm text-charcoal">
              <span class="text-2xl font-bold text-white flex-shrink-0 leading-none mt-0.5 bg-[#E2725B] w-9 h-9 flex items-center justify-center rounded-full">{nums[idx] || '•'}</span>
              <span class="leading-relaxed">{text}</span>
            </li>
          );
        })}
      </ul>
    </section>

    <!-- FAQ -->
    <section id="faq">
      <h2 class="font-serif text-2xl font-semibold text-slate-900 mb-6">Preguntas frecuentes</h2>
      <div class="space-y-4">
        {faqSchema.mainEntity.map((q) => (
          <details class="group border border-slate-200 rounded-2xl overflow-hidden">
            <summary class="flex items-center justify-between px-6 py-4 cursor-pointer select-none text-charcoal font-medium hover:bg-slate-50 transition-colors">
              {q.name}
              <svg class="w-4 h-4 text-slate-400 group-open:rotate-180 transition-transform flex-shrink-0 ml-3" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
            </summary>
            <div class="px-6 pb-5 text-slate-600 leading-relaxed text-sm border-t border-slate-100 pt-4">
              {q.acceptedAnswer.text}
            </div>
          </details>
        ))}
      </div>
    </section>

    <!-- CTA -->
    <section class="bg-gradient-to-r from-med-blue to-med-blue/80 rounded-2xl p-10 text-center text-white">
      <h2 class="font-serif text-3xl font-bold mb-3">Explore todos los medios de transporte</h2>
      <p class="text-white/90 mb-6 max-w-2xl mx-auto">
        Guía completa de hidrofoiles y ferries: cómo ir desde Sorrento a Capri, horarios y reservas.
      </p>
      <a href="/es-es/guida/traghetti/" class="inline-block bg-white text-med-blue font-semibold px-8 py-3 rounded-full hover:bg-slate-100 transition-colors">
        Guía de ferries →
      </a>
    </section>

  </div>

</BaseLayout>
