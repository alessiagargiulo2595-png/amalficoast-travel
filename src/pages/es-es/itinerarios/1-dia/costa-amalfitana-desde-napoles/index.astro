---
import BaseLayout from '../../../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../../../components/Breadcrumbs.astro';

const lang = 'es-es';

const breadcrumbs = [
  { name: 'Home', url: '/es-es/' },
  { name: 'Planificación', url: '/es-es/planificacion/' },
  { name: 'Costa Amalfitana desde Nápoles', url: '/es-es/itinerarios/1-dia/costa-amalfitana-desde-napoles/' },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "¿Cómo llegar a la Costa Amalfitana desde Nápoles en un día?",
      "acceptedAnswer": { "@type": "Answer", "text": "El recorrido más práctico es: tren Nápoles→Salerno (40 min, Trenitalia/Italo), luego ferry Travelmar Salerno→Amalfi (45 min, temporada abr-oct) o bus SITA desde Salerno. Alternativamente, tren Nápoles→Sorrento (Circumvesuviana, 70 min) y bus SITA Sorrento→Amalfi (90 min)." }
    },
    {
      "@type": "Question",
      "name": "¿Qué ver en un día en la Costa Amalfitana saliendo desde Nápoles?",
      "acceptedAnswer": { "@type": "Answer", "text": "Con una jornada: llega a Amalfi (Duomo, centro histórico, 2h), luego Ravello en bus (25 min, Villa Rufolo y panoramas, 1.5h), luego vuelve a Amalfi y toma el bus para Positano (45 min, paseo y playa, 1.5h). El regreso desde Positano en bus o ferry." }
    },
    {
      "@type": "Question",
      "name": "¿A qué hora salir de Nápoles hacia la Costa Amalfitana?",
      "acceptedAnswer": { "@type": "Answer", "text": "Sal de Nápoles antes de las 7:30-8:00. El tren de las 7:45 llega a Salerno a las 8:25; el ferry Travelmar sale alrededor de las 9:00 y llega a Amalfi antes de las 10:00. Esto te da 8-9 horas de visita antes del regreso." }
    }
  ]
};

const schedule = [
  { time: '07:45', place: 'Nápoles Central', action: 'Tren a Salerno (Trenitalia/Italo, 40 min, ~€5-12)', transport: 'train' },
  { time: '09:00', place: 'Salerno', action: 'Ferry Travelmar a Amalfi (45 min, ~€8, temporada abr-oct)', transport: 'ferry' },
  { time: '09:45', place: 'Amalfi', action: 'Duomo de Sant\'Andrea, Claustro del Paraíso, corso y centro histórico (2h)', transport: 'visit' },
  { time: '12:00', place: 'Amalfi → Ravello', action: 'Bus SITA local a Ravello (25 min, ~€1,50). Almuerzo en la plaza.', transport: 'bus' },
  { time: '13:30', place: 'Ravello', action: 'Villa Rufolo, mirador, Villa Cimbrone (1,5h)', transport: 'visit' },
  { time: '15:15', place: 'Ravello → Amalfi → Positano', action: 'Bus a Amalfi (25 min), luego bus SITA a Positano (45 min)', transport: 'bus' },
  { time: '16:30', place: 'Positano', action: 'Paseo por Via Cristoforo Colombo, Spiaggia Grande, aperitivo (1,5h)', transport: 'visit' },
  { time: '18:30', place: 'Positano → Nápoles', action: 'Bus SITA a Sorrento (50 min), luego Circumvesuviana a Nápoles (70 min)', transport: 'bus' },
];

const tips = [
  'El ferry Travelmar desde Salerno es estacional (abr-oct): en invierno usa el bus SITA desde Salerno.',
  'Compra el billete de bus SITA en un estanco antes de subir - no se vende a bordo.',
  'En julio-agosto el bus Amalfi→Positano puede tardar 1,5h en lugar de 45 min: calcula margen.',
  'Ravello merece el desvío: Villa Rufolo (€7) es uno de los miradores más bellos de la Costa.',
  'El regreso desde Positano en bus SITA es más lento (curvas + tráfico) - calcula al menos 1h hasta Sorrento.',
];

const transportBadge: Record<string, { label: string; cls: string }> = {
  train: { label: 'TREN', cls: 'bg-orange-100 text-orange-700' },
  ferry: { label: 'FERRY', cls: 'bg-blue-100 text-blue-700' },
  bus:   { label: 'BUS', cls: 'bg-green-100 text-green-700' },
  walk:  { label: 'A PIE', cls: 'bg-gray-100 text-slate-500' },
  visit: { label: '', cls: '' },
};

const destinationHighlights = [
  { name: 'Amalfi', desc: 'Puerto histórico con Duomo, Claustro del Paraíso, museo del Papel', url: '/es-es/costa-amalfitana/amalfi/' },
  { name: 'Positano', desc: 'Pueblo encaramado con casas de colores, playa y galerías de arte', url: '/es-es/costa-amalfitana/positano/' },
];
---

<BaseLayout
  title="Costa Amalfitana en 1 Día desde Nápoles 2026 | Itinerario Completo"
  description="Itinerario de 1 día por la Costa Amalfitana saliendo desde Nápoles: Amalfi, Ravello y Positano en tren, ferry y bus SITA. Horarios, precios y consejos prácticos."
  lang={lang}
  breadcrumbs={breadcrumbs}
  schema={[faqSchema]}
 pageKey="costa-amalfitana-desde-napoles">

  <!-- Hero Section -->
  <section class="relative bg-charcoal overflow-hidden min-h-[70vh] sm:min-h-[75vh] flex items-center justify-center">
    <img src="/images/costiera-hero.jpg" alt="Costa Amalfitana desde Nápoles" class="absolute inset-0 w-full h-full object-cover opacity-30" loading="eager" referrerpolicy="no-referrer"/>
    <div class="absolute inset-0 bg-gradient-to-b from-black/60 via-black/40 to-black/70"></div>
    <div class="relative max-w-editorial mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <div class="max-w-3xl mx-auto">
        <p class="text-med-gold text-xs sm:text-sm font-medium uppercase tracking-[0.3em] mb-3">Itinerario · 1 día</p>
        <h1 class="font-serif text-display text-white mb-4">Costa Amalfitana desde Nápoles</h1>
        <p class="text-xl text-white/80 leading-relaxed max-w-2xl mx-auto">
          Costa Amalfitana desde Nápoles sin coche: tren, ferry y bus por Amalfi, Ravello, Positano.
        </p>
      </div>
    </div>
    <Breadcrumbs breadcrumbs={breadcrumbs} />
  </section>

  <div class="max-w-editorial mx-auto px-4 sm:px-6 lg:px-8 pt-6 pb-10 space-y-10">

    <!-- Intro & Stats Section - Featured -->
    <section class="text-center mb-2">
      <!-- Quick Stats Grid - Scrollable on Mobile -->
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-2 sm:gap-4 mb-6 overflow-x-auto snap-x snap-mandatory sm:overflow-visible pb-2 sm:pb-0">
        <div class="w-full bg-slate-900 rounded-2xl p-4 sm:p-6 hover:shadow-md transition-shadow flex flex-col items-center justify-center aspect-square snap-start">
          <svg class="w-8 h-8 text-med-gold mb-3" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
            <rect x="3" y="4" width="18" height="18" rx="2"/>
            <path d="M16 2v4M8 2v4M3 10h18"/>
          </svg>
          <p class="text-xs text-white/60 font-semibold uppercase tracking-wide mb-2">Duración</p>
          <p class="font-serif text-lg font-semibold text-med-gold">1 día</p>
        </div>
        <div class="w-full bg-slate-900 rounded-2xl p-4 sm:p-6 hover:shadow-md transition-shadow flex flex-col items-center justify-center aspect-square snap-start">
          <svg class="w-8 h-8 text-med-gold mb-3" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
            <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/>
            <circle cx="12" cy="10" r="3"/>
          </svg>
          <p class="text-xs text-white/60 font-semibold uppercase tracking-wide mb-2">Punto de partida</p>
          <p class="font-serif text-lg font-semibold text-med-gold">Nápoles</p>
        </div>
        <div class="w-full bg-slate-900 rounded-2xl p-4 sm:p-6 hover:shadow-md transition-shadow flex flex-col items-center justify-center aspect-square snap-start">
          <svg class="w-8 h-8 text-med-gold mb-3" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
            <path d="M6 9l6-6 6 6M5 9v9a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V9M9 14h6"/>
          </svg>
          <p class="text-xs text-white/60 font-semibold uppercase tracking-wide mb-2">Transporte</p>
          <p class="font-serif text-lg font-semibold text-med-gold">Tren<br/>+ Ferry</p>
        </div>
        <div class="w-full bg-slate-900 rounded-2xl p-4 sm:p-6 hover:shadow-md transition-shadow flex flex-col items-center justify-center aspect-square snap-start">
          <svg class="w-8 h-8 text-med-gold mb-3" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
            <circle cx="12" cy="12" r="1"/>
            <path d="M12 1v6M12 17v6M4.22 4.22l4.24 4.24M15.54 15.54l4.24 4.24M1 12h6M17 12h6M4.22 19.78l4.24-4.24M15.54 8.46l4.24-4.24"/>
          </svg>
          <p class="text-xs text-white/60 font-semibold uppercase tracking-wide mb-2">Presupuesto transporte</p>
          <p class="font-serif text-lg font-semibold text-med-gold">€25–40<br/><span class="text-xs">p.p.</span></p>
        </div>
      </div>

      <!-- SEO Text Below -->
      <div>
        <p class="text-lg text-slate-700 leading-relaxed">
          Un <strong>día perfecto</strong> en la <strong>Costa Amalfitana</strong> desde <strong>Nápoles</strong> : tomar el <strong>tren</strong> (€5-12) hasta <strong>Salerno</strong>, luego el <strong>ferry Travelmar</strong> (€8) a <strong>Amalfi</strong>, visita de la catedral. Luego bus local a <strong>Ravello</strong> con la magnífica Villa Rufolo. Finalmente <strong>Positano</strong> con sus casas de colores y playa. Regreso en bus y tren. <strong>Presupuesto: €25–40</strong>.
        </p>
      </div>
    </section>


    <!-- Day by Day Itinerary -->
    <section>
      <h2 class="font-serif text-2xl font-semibold text-slate-900 mb-8">Programa del día</h2>
      <div class="bg-white border border-slate-200 rounded-2xl overflow-hidden">
        <div class="px-6 py-8 space-y-6">
          {schedule.map((item, idx) => {
            const badge = transportBadge[item.transport];
            const isLastItem = idx === schedule.length - 1;
            return (
              <div class="flex gap-4">
                <div class="flex flex-col items-center flex-shrink-0">
                  <div class="w-16 bg-slate-900 text-med-gold rounded-full px-2 py-1 text-center text-sm font-semibold flex items-center justify-center">
                    {item.time}
                  </div>
                  {!isLastItem && <div class="w-0.5 h-12 bg-med-blue/30 mt-2"></div>}
                </div>
                <div class="pb-4 flex-1">
                  <p class="font-semibold text-slate-900 mb-1">{item.place}</p>
                  <p class="text-slate-700 text-sm mb-2">{item.action}</p>
                  {badge.label && (
                    <span class={`text-xs font-semibold px-2 py-1 rounded-full ${badge.cls}`}>
                      {badge.label}
                    </span>
                  )}
                </div>
              </div>
            );
          })}
        </div>
      </div>
    </section>

    <!-- Itinerary Map -->
    <section>
      <img src="/images/costa-amalfitana-desde-napoles-map.png" alt="Mapa Costa Amalfitana desde Nápoles - viaje de 1 día completo" class="w-full rounded-2xl shadow-lg" loading="lazy" referrerpolicy="no-referrer"/>
    </section>

    <!-- Destinations Highlighted -->
    <section>
      <h2 class="font-serif text-2xl font-semibold text-slate-900 mb-8">Destinos del itinerario</h2>
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4">
        {destinationHighlights.map((dest) => (
          <a href={dest.url} class="group block bg-white border border-slate-200 rounded-2xl p-5 hover:shadow-lg hover:border-med-blue/30 transition-all">
            <h3 class="font-semibold text-charcoal mb-2 group-hover:text-med-blue transition-colors">{dest.name}</h3>
            <p class="text-xs text-slate-500 leading-relaxed mb-3">{dest.desc}</p>
            <span class="text-xs font-semibold text-med-blue inline-flex items-center gap-1 group-hover:gap-2 transition-all">
              Descubra →
            </span>
          </a>
        ))}
      </div>
    </section>

    <!-- Planning Tips -->
    <section class="bg-med-cream border border-med-gold/20 rounded-[2rem] p-6">
      <h2 class="font-serif text-xl font-semibold text-charcoal mb-6">Consejos prácticos</h2>
      <ul class="space-y-4">
        {tips.map((text, idx) => {
          const nums = ['❶', '❷', '❸', '❹', '❺'];
          return (
            <li class="flex items-start gap-4 text-sm text-charcoal">
              <span class="text-2xl font-bold text-white flex-shrink-0 leading-none mt-0.5 bg-[#E2725B] w-9 h-9 flex items-center justify-center rounded-full">{nums[idx] || '•'}</span>
              <span class="leading-relaxed">{text}</span>
            </li>
          );
        })}
      </ul>
    </section>

    <!-- FAQ -->
    <section id="faq">
      <h2 class="font-serif text-2xl font-semibold text-slate-900 mb-6">Preguntas frecuentes</h2>
      <div class="space-y-4">
        {faqSchema.mainEntity.map((q) => (
          <details class="group border border-slate-200 rounded-2xl overflow-hidden">
            <summary class="flex items-center justify-between px-6 py-4 cursor-pointer select-none text-charcoal font-medium hover:bg-slate-50 transition-colors">
              {q.name}
              <svg class="w-4 h-4 text-slate-400 group-open:rotate-180 transition-transform flex-shrink-0 ml-3" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
            </summary>
            <div class="px-6 pb-5 text-slate-600 leading-relaxed text-sm border-t border-slate-100 pt-4">
              {q.acceptedAnswer.text}
            </div>
          </details>
        ))}
      </div>
    </section>

    <!-- CTA -->
    <section class="bg-gradient-to-r from-med-blue to-med-blue/80 rounded-2xl p-10 text-center text-white">
      <h2 class="font-serif text-3xl font-bold mb-3">Explore todos los medios de transporte</h2>
      <p class="text-white/90 mb-6 max-w-2xl mx-auto">
        Guía completa de ferries, trenes y horarios: cómo ir desde Nápoles a la Costa Amalfitana, billetes y reservas.
      </p>
      <a href="/es-es/guida/traghetti/" class="inline-block bg-white text-med-blue font-semibold px-8 py-3 rounded-full hover:bg-slate-100 transition-colors">
        Guía de ferries →
      </a>
    </section>

  </div>

</BaseLayout>
