---
import BaseLayout from '../../../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../../../components/Breadcrumbs.astro';

const lang = 'es-es';

const breadcrumbs = [
  { name: 'Home', url: '/es-es/' },
  { name: 'Planificación', url: '/es-es/planificacion/' },
  { name: 'Costa Amalfitana desde Salerno', url: '/es-es/itinerarios/1-dia/costa-amalfitana-desde-salerno/' },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "¿Cómo llegar a la Costa Amalfitana desde Salerno?",
      "acceptedAnswer": { "@type": "Answer", "text": "Desde Salerno tienes dos opciones: ferry Travelmar a Amalfi (45 min, ~€8, estacional abr-oct) o bus SITA desde la estación de Salerno (dirección Amalfi vía SS163, ~60 min, ~€2,80). El ferry es más panorámico y rápido; el bus funciona todo el año." }
    },
    {
      "@type": "Question",
      "name": "¿Vale la pena partir desde la puerta este de la Costa (Vietri, Maiori)?",
      "acceptedAnswer": { "@type": "Answer", "text": "Sí, especialmente en temporada baja cuando los pueblos están menos abarrotados. Vietri sul Mare es famosa por sus cerámicas, Maiori tiene el paseo marítimo más largo de la Costa y un ambiente relajado. Minori merece una parada por las ruinas de la Villa Romana." }
    }
  ]
};

const schedule = [
  { time: '08:30', place: 'Salerno', action: 'Ferry Travelmar a Amalfi (abr-oct, 45 min, ~€8) o bus SITA (60 min, ~€2,80)', transport: 'ferry' },
  { time: '09:30', place: 'Amalfi', action: 'Catedral Sant\'Andrea, Claustro del Paraíso, Museo del Papel (2,5h)', transport: 'visit' },
  { time: '12:00', place: 'Amalfi', action: 'Almuerzo en el centro (trattorie en el corso o en el puerto)', transport: 'visit' },
  { time: '13:30', place: 'Amalfi → Maiori', action: 'Bus SITA este a Maiori (20 min, ~€1,50). Paseo marítimo y playa.', transport: 'bus' },
  { time: '15:00', place: 'Maiori → Minori', action: 'A pie por el paseo (20 min) o en bus. Villa Romana de Minori (gratis).', transport: 'walk' },
  { time: '16:00', place: 'Minori → Vietri sul Mare', action: 'Bus SITA a Vietri (~30 min). Cerámica, Museo de la Cerámica, paseo.', transport: 'bus' },
  { time: '17:30', place: 'Vietri → Salerno', action: 'Bus a Salerno (15 min) o a pie por la costa (45 min panorámicos)', transport: 'bus' },
];

const tips = [
  'Salerno está conectada a Nápoles y Roma por tren de alta velocidad: excelente punto de partida.',
  'El ferry Travelmar desde Salerno es panorámico y llega a Amalfi sin usar la SS163.',
  'La parte este de la Costa (Maiori, Minori, Vietri) tiene mucho menos turismo que Positano.',
  'Vietri sul Mare es la capital italiana de la cerámica: ideal para souvenirs de calidad.',
  'En temporada baja, el bus SITA es la única opción (ferry suspendido): sale de Piazza della Concordia.',
];

const transportBadge: Record<string, { label: string; cls: string }> = {
  train: { label: 'TREN', cls: 'bg-orange-100 text-orange-700' },
  ferry: { label: 'FERRY', cls: 'bg-blue-100 text-blue-700' },
  bus:   { label: 'BUS', cls: 'bg-green-100 text-green-700' },
  walk:  { label: 'A PIE', cls: 'bg-gray-100 text-slate-500' },
  visit: { label: '', cls: '' },
};

const destinationHighlights = [
  { name: 'Amalfi', desc: 'Puerto histórico con Catedral, Claustro del Paraíso, museo del Papel', url: '/es-es/costa-amalfitana/amalfi/' },
  { name: 'Vietri sul Mare', desc: 'Centro de la cerámica italiana con museo y tiendas artesanales', url: '/es-es/costa-amalfitana/vietri-sul-mare/' },
];
---

<BaseLayout
  title="Costa Amalfitana desde Salerno en 1 Día 2026 | Itinerario Este"
  description="Itinerario de 1 día por la puerta este de la Costa Amalfitana: Amalfi, Maiori, Minori y Vietri sul Mare desde Salerno. Horarios de ferries y bus SITA."
  lang={lang}
  breadcrumbs={breadcrumbs}
  schema={[faqSchema]}
 pageKey="costa-amalfitana-desde-salerno">

  <!-- Hero Section -->
  <section class="relative bg-charcoal overflow-hidden min-h-[70vh] sm:min-h-[75vh] flex items-center justify-center">
    <img src="/images/costiera-hero.jpg" alt="Costa Amalfitana desde Salerno" class="absolute inset-0 w-full h-full object-cover opacity-30" loading="eager" fetchpriority="high" decoding="sync" referrerpolicy="no-referrer"/>
    <div class="absolute inset-0 bg-gradient-to-b from-black/75 via-black/40 to-black/70"></div>
    <div class="relative max-w-editorial mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <div class="max-w-3xl mx-auto">
        <p class="text-med-gold text-xs sm:text-sm font-medium uppercase tracking-[0.3em] mb-3">Itinerario · 1 día</p>
        <h1 class="font-serif text-display text-white mb-4">Costa Amalfitana desde Salerno</h1>
        <p class="text-xl text-white/80 leading-relaxed max-w-2xl mx-auto">
          Costa Amalfitana desde Salerno: menos aglomeración, mismas vistas, salida más tarde.
        </p>
      </div>
    </div>
    <Breadcrumbs breadcrumbs={breadcrumbs} />
  </section>

  <div class="max-w-editorial mx-auto px-4 sm:px-6 lg:px-8 pt-6 pb-10 space-y-10">

    <!-- Intro Section -->
    <section class="text-center mb-2">
      <div>
        <p class="text-lg text-slate-700 leading-relaxed">
          Un <strong>excelente itinerario</strong> en la <strong>Costa Amalfitana desde Salerno</strong> : ferry o bus hasta <strong>Amalfi</strong> con su catedral histórica. Luego hacia el <strong>este de la costa</strong> - <strong>Vietri sul Mare</strong>, <strong>Minori</strong> y <strong>Maiori</strong> son mucho menos frecuentados. <strong>Presupuesto: €12–18 para transporte</strong>.
        </p>
      </div>
    </section>


    <!-- Day by Day Itinerary -->
    <section>
      <h2 class="font-serif text-2xl font-semibold text-slate-900 mb-8">Programa del día</h2>
      <div class="bg-white border border-slate-200 rounded-2xl overflow-hidden">
        <div class="px-6 py-8 space-y-6">
          {schedule.map((item, idx) => {
            const badge = transportBadge[item.transport];
            const isLastItem = idx === schedule.length - 1;
            return (
              <div class="flex gap-4">
                <div class="flex flex-col items-center flex-shrink-0">
                  <div class="w-16 bg-slate-900 text-med-gold rounded-full px-2 py-1 text-center text-sm font-semibold flex items-center justify-center">
                    {item.time}
                  </div>
                  {!isLastItem && <div class="w-0.5 h-12 bg-med-blue/30 mt-2"></div>}
                </div>
                <div class="pb-4 flex-1">
                  <p class="font-semibold text-slate-900 mb-1">{item.place}</p>
                  <p class="text-slate-700 text-sm mb-2">{item.action}</p>
                  {badge.label && (
                    <span class={`text-xs font-semibold px-2 py-1 rounded-full ${badge.cls}`}>
                      {badge.label}
                    </span>
                  )}
                </div>
              </div>
            );
          })}
        </div>
      </div>
    </section>

    <!-- Destinations Highlighted -->
    <section>
      <h2 class="font-serif text-2xl font-semibold text-slate-900 mb-8">Destinos del itinerario</h2>
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4">
        {destinationHighlights.map((dest) => (
          <a href={dest.url} class="group block bg-white border border-slate-200 rounded-2xl p-5 hover:shadow-lg hover:border-med-blue/30 transition-all">
            <h3 class="font-semibold text-charcoal mb-2 group-hover:text-med-blue transition-colors">{dest.name}</h3>
            <p class="text-xs text-slate-500 leading-relaxed mb-3">{dest.desc}</p>
            <span class="text-xs font-semibold text-med-blue inline-flex items-center gap-1 group-hover:gap-2 transition-all">
              Descubra →
            </span>
          </a>
        ))}
      </div>
    </section>

    <!-- Planning Tips -->
    <section class="bg-med-cream border border-med-gold/20 rounded-[2rem] p-6">
      <h2 class="font-serif text-xl font-semibold text-charcoal mb-6">Consejos prácticos</h2>
      <ul class="space-y-4">
        {tips.map((text, idx) => {
          const nums = ['❶', '❷', '❸', '❹', '❺'];
          return (
            <li class="flex items-start gap-4 text-sm text-charcoal">
              <span class="text-2xl font-bold text-white flex-shrink-0 leading-none mt-0.5 bg-[#E2725B] w-9 h-9 flex items-center justify-center rounded-full">{nums[idx] || '•'}</span>
              <span class="leading-relaxed">{text}</span>
            </li>
          );
        })}
      </ul>
    </section>

    <!-- FAQ -->
    <section id="faq">
      <h2 class="font-serif text-2xl font-semibold text-slate-900 mb-6">Preguntas frecuentes</h2>
      <div class="space-y-4">
        {faqSchema.mainEntity.map((q) => (
          <details class="group border border-slate-200 rounded-2xl overflow-hidden">
            <summary class="flex items-center justify-between px-6 py-4 cursor-pointer select-none text-charcoal font-medium hover:bg-slate-50 transition-colors">
              {q.name}
              <svg class="w-4 h-4 text-slate-400 group-open:rotate-180 transition-transform flex-shrink-0 ml-3" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
            </summary>
            <div class="px-6 pb-5 text-slate-600 leading-relaxed text-sm border-t border-slate-100 pt-4">
              {q.acceptedAnswer.text}
            </div>
          </details>
        ))}
      </div>
    </section>

    <!-- BANNER: Planificador de Itinerario -->
    <section class="relative overflow-hidden rounded-[2rem] bg-gradient-to-br from-slate-900 via-slate-950 to-blue-950 px-6 sm:px-10 py-8 md:py-10 shadow-[0_20px_60px_rgba(0,0,0,0.35)]">
      <div class="absolute -top-20 -left-20 w-72 h-72 bg-blue-500/15 rounded-full blur-3xl pointer-events-none"></div>
      <div class="absolute -bottom-20 -right-20 w-72 h-72 bg-amber-500/10 rounded-full blur-3xl pointer-events-none"></div>
      <div class="relative z-10 md:flex md:items-center md:justify-between gap-8">
        <div>
          <span class="inline-block px-3 py-1 rounded-full text-[10px] font-semibold tracking-wide uppercase bg-med-gold/15 text-med-gold border border-med-gold/25 mb-4">Nuevo: Planificador de Viaje</span>
          <h2 class="text-2xl md:text-3xl font-bold text-white leading-tight mb-2">Diseña tu <span class="font-serif italic text-med-blue">itinerario perfecto</span></h2>
          <p class="text-white/60 text-sm md:text-base leading-relaxed max-w-xl">Responde unas sencillas preguntas y obtén un itinerario personalizado con transporte, costes y horarios.</p>
        </div>
        <div class="mt-6 md:mt-0 flex-shrink-0">
          <a href="/es-es/planificador-itinerario/" class="inline-flex items-center gap-2.5 px-7 py-3.5 bg-gradient-to-r from-med-gold to-yellow-600 text-slate-900 font-bold rounded-xl hover:shadow-[0_0_30px_rgba(212,175,55,0.4)] hover:scale-105 transition-all duration-300">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 2L2 12l4 0 0 6 4 0 0-4 4 0 0 4 4 0 0-6 4 0L12 2z"/></svg>
            Planifica Ahora
          </a>
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="bg-gradient-to-r from-med-blue to-med-blue/80 rounded-2xl p-10 text-center text-white">
      <h2 class="font-serif text-3xl font-bold mb-3">Explora todos los medios de transporte</h2>
      <p class="text-white/90 mb-6 max-w-2xl mx-auto">
        Guía completa de ferries y bus SITA: cómo ir desde Salerno a la Costa Amalfitana, horarios y reservas.
      </p>
      <a href="/es-es/guia/ferries/" class="inline-block bg-white text-med-blue font-semibold px-8 py-3 rounded-full hover:bg-slate-100 transition-colors">
        Guía de transportes →
      </a>
    </section>

  </div>

</BaseLayout>
