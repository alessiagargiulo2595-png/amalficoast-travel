---
import BaseLayout from '../../../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../../../components/Breadcrumbs.astro';

const lang = 'es-es';

const breadcrumbs = [
  { name: 'Home', url: '/es-es/' },
  { name: 'Planificación', url: '/es-es/planificacion/' },
  { name: 'Península Sorrentina desde Nápoles', url: '/es-es/itinerarios/1-dia/peninsula-sorrentina-desde-napoles/' },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "¿Cómo llegar a Sorrento desde Nápoles?",
      "acceptedAnswer": { "@type": "Answer", "text": "La forma más sencilla es la Circumvesuviana: tren desde Nápoles Porta Nolana o Piazza Garibaldi hasta Sorrento (70 min, ~€3.90). Salidas cada 30-40 min. Alternativamente, hidrofoil desde Nápoles Beverello (Alilauro/NLG, ~60 min, ~€15) aunque el precio es más elevado." }
    },
    {
      "@type": "Question",
      "name": "¿Qué ver en la Península Sorrentina en un día?",
      "acceptedAnswer": { "@type": "Answer", "text": "Desde Sorrento: el centro histórico y el Vallone dei Mulini (30 min), luego bus a Massa Lubrense (20 min) con vista sobre Capri y el Golfo. Sant'Agata sui Due Golfi ofrece uno de los panoramas más bellos de la zona. Punta Campanella se puede alcanzar a pie (sendero 6 km ida y vuelta, 2.5h)." }
    }
  ]
};

const schedule = [
  { time: '08:00', place: 'Nápoles Porta Nolana', action: 'Circumvesuviana a Sorrento (70 min, ~€3.90)', transport: 'train' },
  { time: '09:15', place: 'Sorrento', action: 'Centro histórico, Piazza Tasso, Vallone dei Mulini, tiendas de limoncello (1.5h)', transport: 'visit' },
  { time: '11:00', place: 'Sorrento → Massa Lubrense', action: 'Bus SITA a Massa Lubrense (20 min, ~€1.50). Panorama sobre Capri.', transport: 'bus' },
  { time: '12:00', place: 'Massa Lubrense', action: 'Almuerzo en trattoria local. Vista del doble golfo desde Punta Campanella.', transport: 'visit' },
  { time: '13:30', place: 'Sant\'Agata sui Due Golfi', action: 'Bus o taxi (15 min). Mirador del Desierto (panorama Golfo de Nápoles + Salerno).', transport: 'bus' },
  { time: '15:00', place: 'Sant\'Agata → Sorrento', action: 'Bus de regreso a Sorrento (30 min). Tiempo libre en el puerto.', transport: 'bus' },
  { time: '16:30', place: 'Sorrento', action: 'Marina Piccola, paseo, aperitivo con vista al Vesubio', transport: 'visit' },
  { time: '18:00', place: 'Sorrento → Nápoles', action: 'Circumvesuviana a Nápoles (70 min)', transport: 'train' },
];

const tips = [
  'La Circumvesuviana es económica pero lenta y a menudo muy llena en verano: vigila el equipaje.',
  'Sant\'Agata sui Due Golfi: desde el mirador se ven tanto el Golfo de Nápoles como el de Salerno.',
  'Massa Lubrense es ideal para un almuerzo económico con pescado del día: menos turística que Sorrento.',
  'Si quieres hacer el sendero de Punta Campanella (6 km ida y vuelta), sal desde Massa Lubrense antes de las 10:00.',
  'El limoncello de Sorrento se elabora con limones IGP de la zona: cómpralo en tiendas locales.',
];

const transportBadge: Record<string, { label: string; cls: string }> = {
  train: { label: 'TREN', cls: 'bg-orange-100 text-orange-700' },
  ferry: { label: 'FERRY', cls: 'bg-blue-100 text-blue-700' },
  bus:   { label: 'BUS', cls: 'bg-green-100 text-green-700' },
  walk:  { label: 'A PIE', cls: 'bg-gray-100 text-slate-500' },
  visit: { label: '', cls: '' },
};

const destinationHighlights = [
  { name: 'Sorrento', desc: '', url: '/es-es/peninsula-sorrentina/sorrento/' },
  { name: 'Massa Lubrense', desc: '', url: '/es-es/peninsula-sorrentina/massa-lubrense/' },
  { name: 'Sant\'Agnello', desc: '', url: '/es-es/peninsula-sorrentina/sant-agnello/' },
];
---

<BaseLayout
  title="Península Sorrentina en 1 Día desde Nápoles 2026 | Sorrento, Massa Lubrense"
  description="Itinerario de 1 día por la Península Sorrentina desde Nápoles: Sorrento, Massa Lubrense, Sant'Agata sui Due Golfi. Circumvesuviana, bus SITA y panoramas sobre el Golfo."
  lang={lang}
  breadcrumbs={breadcrumbs}
  schema={[faqSchema]}
 pageKey="peninsula-sorrentina-desde-napoles">

  <!-- Hero Section -->
  <section class="relative bg-charcoal overflow-hidden min-h-[70vh] sm:min-h-[75vh] flex items-center justify-center">
    <img src="/images/sorrento-hero.jpg" alt="Península Sorrentina desde Nápoles" class="absolute inset-0 w-full h-full object-cover opacity-30" loading="eager" fetchpriority="high" decoding="sync" referrerpolicy="no-referrer"/>
    <div class="absolute inset-0 bg-gradient-to-b from-black/20 via-black/40 to-black/80"></div>
    <div class="relative max-w-editorial mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <div class="max-w-3xl mx-auto">
        <p class="text-med-gold text-xs sm:text-sm font-medium uppercase tracking-[0.3em] mb-3">Itinerario · 1 día</p>
        <h1 class="font-serif text-display text-white mb-4">Península Sorrentina desde Nápoles</h1>
        <p class="text-xl text-white/80 leading-relaxed max-w-2xl mx-auto">
          Sorrento, Massa Lubrense y Sant'Agata sui Due Golfi en una jornada. El doble golfo, limoncello y una Circumvesuviana económica.
        </p>
      </div>
    </div>
    <Breadcrumbs breadcrumbs={breadcrumbs} />
  </section>

  <div class="max-w-editorial mx-auto px-4 sm:px-6 lg:px-8 pt-6 pb-10 space-y-10">

    <!-- Intro & Stats Section - Featured -->
    <section class="text-center mb-2">
      <!-- Quick Stats Grid - Scrollable on Mobile -->
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-2 sm:gap-4 mb-6 overflow-x-auto snap-x snap-mandatory sm:overflow-visible pb-2 sm:pb-0">
        <div class="w-full bg-slate-900 rounded-2xl p-4 sm:p-6 hover:shadow-md transition-shadow flex flex-col items-center justify-center aspect-square snap-start">
          <svg class="w-8 h-8 text-med-gold mb-3" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
            <rect x="3" y="4" width="18" height="18" rx="2"/>
            <path d="M16 2v4M8 2v4M3 10h18"/>
          </svg>
          <p class="text-xs text-white/60 font-semibold uppercase tracking-wide mb-2">Duración</p>
          <p class="font-serif text-lg font-semibold text-med-gold">1 día</p>
        </div>
        <div class="w-full bg-slate-900 rounded-2xl p-4 sm:p-6 hover:shadow-md transition-shadow flex flex-col items-center justify-center aspect-square snap-start">
          <svg class="w-8 h-8 text-med-gold mb-3" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
            <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/>
            <circle cx="12" cy="10" r="3"/>
          </svg>
          <p class="text-xs text-white/60 font-semibold uppercase tracking-wide mb-2">Base</p>
          <p class="font-serif text-lg font-semibold text-med-gold">Nápoles</p>
        </div>
        <div class="w-full bg-slate-900 rounded-2xl p-4 sm:p-6 hover:shadow-md transition-shadow flex flex-col items-center justify-center aspect-square snap-start">
          <svg class="w-8 h-8 text-med-gold mb-3" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
            <path d="M6 9l6-6 6 6M5 9v9a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V9M9 14h6"/>
          </svg>
          <p class="text-xs text-white/60 font-semibold uppercase tracking-wide mb-2">Transporte</p>
          <p class="font-serif text-lg font-semibold text-med-gold">Circumvesuviana<br/>+ bus local</p>
        </div>
        <div class="w-full bg-slate-900 rounded-2xl p-4 sm:p-6 hover:shadow-md transition-shadow flex flex-col items-center justify-center aspect-square snap-start">
          <svg class="w-8 h-8 text-med-gold mb-3" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
            <circle cx="12" cy="12" r="1"/>
            <path d="M12 1v6M12 17v6M4.22 4.22l4.24 4.24M15.54 15.54l4.24 4.24M1 12h6M17 12h6M4.22 19.78l4.24-4.24M15.54 8.46l4.24-4.24"/>
          </svg>
          <p class="text-xs text-white/60 font-semibold uppercase tracking-wide mb-2">Coste transporte</p>
          <p class="font-serif text-lg font-semibold text-med-gold">€7–9<br/><span class="text-xs">p.p.</span></p>
        </div>
      </div>

      <!-- SEO Text Below -->
      <div>
        <p class="text-lg text-slate-700 leading-relaxed">
          Una jornada en la <strong>Península Sorrentina</strong> desde Nápoles: toma la <strong>Circumvesuviana</strong> económica (€3.90) hasta <strong>Sorrento</strong>, luego bus hacia el corazón de la península. Visita <strong>Massa Lubrense</strong> con vista sobre <strong>Capri</strong>, <strong>Sant'Agata sui Due Golfi</strong> con el panorama de los dos golfos, y regresa con el limoncello IGP de Sorrento. <strong>Coste transporte: €7–9</strong>.
        </p>
      </div>
    </section>


    <!-- Day by Day Itinerary -->
    <section>
      <h2 class="font-serif text-2xl font-semibold text-slate-900 mb-8">Programa del día</h2>
      <div class="bg-white border border-slate-200 rounded-2xl overflow-hidden">
        <div class="px-6 py-8 space-y-6">
          {schedule.map((item, idx) => {
            const badge = transportBadge[item.transport];
            const isLastItem = idx === schedule.length - 1;
            return (
              <div class="flex gap-4">
                <div class="flex flex-col items-center flex-shrink-0">
                  <div class="w-16 bg-slate-900 text-med-gold rounded-full px-2 py-1 text-center text-sm font-semibold flex items-center justify-center">
                    {item.time}
                  </div>
                  {!isLastItem && <div class="w-0.5 h-12 bg-med-blue/30 mt-2"></div>}
                </div>
                <div class="pb-4 flex-1">
                  <p class="font-semibold text-slate-900 mb-1">{item.place}</p>
                  <p class="text-slate-700 text-sm mb-2">{item.action}</p>
                  {badge.label && (
                    <span class={`text-xs font-semibold px-2 py-1 rounded-full ${badge.cls}`}>
                      {badge.label}
                    </span>
                  )}
                </div>
              </div>
            );
          })}
        </div>
      </div>
    </section>

    <!-- Destinations Highlighted -->
    <section>
      <h2 class="font-serif text-2xl font-semibold text-slate-900 mb-8">Destinos del itinerario</h2>
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4">
        {destinationHighlights.map((dest) => (
          <a href={dest.url} class="group block bg-white border border-slate-200 rounded-2xl p-5 hover:shadow-lg hover:border-med-blue/30 transition-all">
            <h3 class="font-semibold text-charcoal mb-2 group-hover:text-med-blue transition-colors">{dest.name}</h3>
            <p class="text-xs text-slate-500 leading-relaxed mb-3">{dest.desc}</p>
            <span class="text-xs font-semibold text-med-blue inline-flex items-center gap-1 group-hover:gap-2 transition-all">
              Descubre →
            </span>
          </a>
        ))}
      </div>
    </section>

    <!-- Planning Tips -->
    <section class="bg-med-cream border border-med-gold/20 rounded-[2rem] p-6">
      <h2 class="font-serif text-xl font-semibold text-charcoal mb-6">Consejos prácticos</h2>
      <ul class="space-y-4">
        {tips.map((text, idx) => {
          const nums = ['❶', '❷', '❸', '❹', '❺'];
          return (
            <li class="flex items-start gap-4 text-sm text-charcoal">
              <span class="text-2xl font-bold text-white flex-shrink-0 leading-none mt-0.5 bg-[#E2725B] w-9 h-9 flex items-center justify-center rounded-full">{nums[idx] || '•'}</span>
              <span class="leading-relaxed">{text}</span>
            </li>
          );
        })}
      </ul>
    </section>

    <!-- FAQ -->
    <section id="faq">
      <h2 class="font-serif text-2xl font-semibold text-slate-900 mb-6">Preguntas frecuentes</h2>
      <div class="space-y-4">
        {faqSchema.mainEntity.map((q) => (
          <details class="group border border-slate-200 rounded-2xl overflow-hidden">
            <summary class="flex items-center justify-between px-6 py-4 cursor-pointer select-none text-charcoal font-medium hover:bg-slate-50 transition-colors">
              {q.name}
              <svg class="w-4 h-4 text-slate-400 group-open:rotate-180 transition-transform flex-shrink-0 ml-3" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
            </summary>
            <div class="px-6 pb-5 text-slate-600 leading-relaxed text-sm border-t border-slate-100 pt-4">
              {q.acceptedAnswer.text}
            </div>
          </details>
        ))}
      </div>
    </section>

    <!-- BANNER: Planificador de Itinerario -->
    <section class="relative overflow-hidden rounded-[2rem] bg-gradient-to-br from-slate-900 via-slate-950 to-blue-950 px-6 sm:px-10 py-8 md:py-10 shadow-[0_20px_60px_rgba(0,0,0,0.35)]">
      <div class="absolute -top-20 -left-20 w-72 h-72 bg-blue-500/15 rounded-full blur-3xl pointer-events-none"></div>
      <div class="absolute -bottom-20 -right-20 w-72 h-72 bg-amber-500/10 rounded-full blur-3xl pointer-events-none"></div>
      <div class="relative z-10 md:flex md:items-center md:justify-between gap-8">
        <div>
          <span class="inline-block px-3 py-1 rounded-full text-[10px] font-semibold tracking-wide uppercase bg-med-gold/15 text-med-gold border border-med-gold/25 mb-4">Nuevo: Planificador de Viaje</span>
          <h2 class="text-2xl md:text-3xl font-bold text-white leading-tight mb-2">Diseña tu <span class="font-serif italic text-med-blue">itinerario perfecto</span></h2>
          <p class="text-white/60 text-sm md:text-base leading-relaxed max-w-xl">Responde unas sencillas preguntas y obtén un itinerario personalizado con transporte, costes y horarios.</p>
        </div>
        <div class="mt-6 md:mt-0 flex-shrink-0">
          <a href="/es-es/planificador-itinerario/" class="inline-flex items-center gap-2.5 px-7 py-3.5 bg-gradient-to-r from-med-gold to-yellow-600 text-slate-900 font-bold rounded-xl hover:shadow-[0_0_30px_rgba(212,175,55,0.4)] hover:scale-105 transition-all duration-300">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 2L2 12l4 0 0 6 4 0 0-4 4 0 0 4 4 0 0-6 4 0L12 2z"/></svg>
            Planifica Ahora
          </a>
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="bg-gradient-to-r from-med-blue to-med-blue/80 rounded-2xl p-10 text-center text-white">
      <h2 class="font-serif text-3xl font-bold mb-3">Descubre la Península Sorrentina</h2>
      <p class="text-white/90 mb-6 max-w-2xl mx-auto">
        Guía completa de la Circumvesuviana: costes, horarios y cómo llegar a los pueblos de la península desde Nápoles.
      </p>
      <a href="/es-es/guia/bus-sita/" class="inline-block bg-white text-med-blue font-semibold px-8 py-3 rounded-full hover:bg-slate-100 transition-colors">
        Guía de transportes →
      </a>
    </section>

  </div>

</BaseLayout>
