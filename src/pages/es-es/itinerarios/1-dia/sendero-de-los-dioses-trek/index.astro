---
import BaseLayout from '../../../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../../../components/Breadcrumbs.astro';

const lang = 'es-es';

const breadcrumbs = [
  { name: 'Home', url: '/es-es/' },
  { name: 'Planificación', url: '/es-es/planificacion/' },
  { name: 'Trekking Sendero de los Dioses', url: '/es-es/itinerarios/1-dia/sendero-de-los-dioses-trek/' },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "¿Cómo organizar el Sendero de los Dioses en un día desde Nápoles?",
      "acceptedAnswer": { "@type": "Answer", "text": "Sal de Nápoles con la Circumvesuviana hasta Sorrento (70 min), luego bus SITA a Amalfi (90 min), luego bus local a Agerola (45 min). El sendero Agerola→Nocelle son 8 km, 3-4h. Desde Nocelle bus local a Positano (15 min), luego bus SITA o ferry a Sorrento y Circumvesuviana a Nápoles." }
    },
    {
      "@type": "Question",
      "name": "¿Es necesario reservar para el Sendero de los Dioses?",
      "acceptedAnswer": { "@type": "Answer", "text": "En temporada alta (julio-agosto) el Sendero de los Dioses requiere reserva obligatoria en el portal del Parque de los Monti Lattari. El coste es simbólico (~€5). Fuera de temporada no es necesaria. Verifica siempre las condiciones en el sitio oficial antes de salir." }
    },
    {
      "@type": "Question",
      "name": "¿Qué llevar para el Sendero de los Dioses?",
      "acceptedAnswer": { "@type": "Answer", "text": "Obligatorio: calzado de trekking (no sandalias ni zapatillas lisas), al menos 1.5L de agua, protección solar, sombrero. El sendero no tiene fuentes ni tiendas. Llevar un tentempié. En primavera/otoño una chaqueta ligera es aconsejable por el viento en altura." }
    }
  ]
};

const schedule = [
  { time: '07:00', place: 'Nápoles', action: 'Circumvesuviana a Sorrento (70 min, ~€3.90)', transport: 'train' },
  { time: '08:15', place: 'Sorrento', action: 'Bus SITA a Amalfi (90 min, ~€3.50) - salida de las 8:30', transport: 'bus' },
  { time: '10:00', place: 'Amalfi', action: 'Bus local a Agerola, frac. San Lazzaro (45 min, ~€1.50). Inicio del sendero.', transport: 'bus' },
  { time: '11:00', place: 'Agerola (618 m)', action: 'Salida Sendero de los Dioses. 8 km, ~500 m descenso, EE. Paisajes impresionantes.', transport: 'walk' },
  { time: '14:30', place: 'Nocelle', action: 'Llegada a Nocelle. Pausa y almuerzo en uno de los refugios/bares locales.', transport: 'visit' },
  { time: '15:15', place: 'Nocelle → Positano', action: 'Bus local a Positano centro (15 min, ~€1.50) o a pie (~1.000 escalones, 45 min)', transport: 'bus' },
  { time: '16:00', place: 'Positano', action: 'Paseo, helado, playa (1h libre)', transport: 'visit' },
  { time: '17:15', place: 'Positano → Nápoles', action: 'Bus SITA a Sorrento (~50 min), luego Circumvesuviana a Nápoles (70 min)', transport: 'bus' },
];

const tips = [
  'Temporada ideal: abril-junio y septiembre-octubre. Julio-agosto es muy caluroso y concurrido.',
  'El bus de Amalfi a Agerola tiene pocas salidas: consulta los horarios en eavsrl.it la noche anterior.',
  'Sal siempre en dirección Agerola→Nocelle: casi todo en bajada, señalización pensada para este sentido.',
  'El sendero no tiene puntos de agua: lleva al menos 1.5L. El último bar está en Agerola antes de la salida.',
  'Desde Nocelle se baja a Positano a pie (~1.000 escalones, 45 min) o en bus (15 min, ~€1.50).',
];

const transportBadge: Record<string, { label: string; cls: string }> = {
  train: { label: 'TREN', cls: 'bg-orange-100 text-orange-700' },
  ferry: { label: 'FERRY', cls: 'bg-blue-100 text-blue-700' },
  bus:   { label: 'BUS', cls: 'bg-green-100 text-green-700' },
  walk:  { label: 'A PIE', cls: 'bg-gray-100 text-slate-500' },
  visit: { label: '', cls: '' },
};

const destinationHighlights = [
  { name: 'Positano', desc: '', url: '/es-es/costa-amalfitana/positano/' },
  { name: 'Praiano', desc: '', url: '/es-es/costa-amalfitana/praiano/' },
  { name: 'Amalfi', desc: '', url: '/es-es/costa-amalfitana/amalfi/' },
];
---

<BaseLayout
  title="Sendero de los Dioses en 1 Día desde Nápoles 2026 | Itinerario Trekking"
  description="Cómo hacer el Sendero de los Dioses (Agerola-Nocelle) en un día desde Nápoles: horarios, transportes, reserva y consejos. 8 km de trekking con vista sobre la Costa Amalfitana."
  lang={lang}
  breadcrumbs={breadcrumbs}
  schema={[faqSchema]}
  pageKey="sendero-de-los-dioses-trek">

  <!-- Hero Section -->
  <section class="relative bg-charcoal overflow-hidden min-h-[70vh] sm:min-h-[75vh] flex items-center justify-center">
    <img src="/images/trekking-hero.jpg" alt="Sendero de los Dioses, Costa Amalfitana" class="absolute inset-0 w-full h-full object-cover opacity-30" loading="eager" referrerpolicy="no-referrer"/>
    <div class="absolute inset-0 bg-gradient-to-b from-black/20 via-black/40 to-black/80"></div>
    <div class="relative max-w-editorial mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <div class="max-w-3xl mx-auto">
        <p class="text-med-gold text-xs sm:text-sm font-medium uppercase tracking-[0.3em] mb-3">Itinerario · Trekking · 1 día</p>
        <h1 class="font-serif text-display text-white mb-4">Sendero de los Dioses Trek</h1>
        <p class="text-xl text-white/80 leading-relaxed max-w-2xl mx-auto">
          Sendero de los Dioses: tres horas de trekking entre Positano y Praiano en la Costa Amalfitana.
        </p>
      </div>
    </div>
    <Breadcrumbs breadcrumbs={breadcrumbs} />
  </section>

  <div class="max-w-editorial mx-auto px-4 sm:px-6 lg:px-8 pt-6 pb-10 space-y-10">

    <!-- Intro & Stats Section - Featured -->
    <section class="text-center mb-2">
      <!-- Quick Stats Grid - Scrollable on Mobile -->
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-2 sm:gap-4 mb-6 overflow-x-auto snap-x snap-mandatory sm:overflow-visible pb-2 sm:pb-0">
        <div class="w-full bg-slate-900 rounded-2xl p-4 sm:p-6 hover:shadow-md transition-shadow flex flex-col items-center justify-center aspect-square snap-start">
          <svg class="w-8 h-8 text-med-gold mb-3" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
            <rect x="3" y="4" width="18" height="18" rx="2"/>
            <path d="M16 2v4M8 2v4M3 10h18"/>
          </svg>
          <p class="text-xs text-white/60 font-semibold uppercase tracking-wide mb-2">Duración</p>
          <p class="font-serif text-lg font-semibold text-med-gold">1 día</p>
        </div>
        <div class="w-full bg-slate-900 rounded-2xl p-4 sm:p-6 hover:shadow-md transition-shadow flex flex-col items-center justify-center aspect-square snap-start">
          <svg class="w-8 h-8 text-med-gold mb-3" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
            <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/>
            <circle cx="12" cy="10" r="3"/>
          </svg>
          <p class="text-xs text-white/60 font-semibold uppercase tracking-wide mb-2">Base</p>
          <p class="font-serif text-lg font-semibold text-med-gold">Nápoles</p>
        </div>
        <div class="w-full bg-slate-900 rounded-2xl p-4 sm:p-6 hover:shadow-md transition-shadow flex flex-col items-center justify-center aspect-square snap-start">
          <svg class="w-8 h-8 text-med-gold mb-3" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
            <path d="M6 9l6-6 6 6M5 9v9a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V9M9 14h6"/>
          </svg>
          <p class="text-xs text-white/60 font-semibold uppercase tracking-wide mb-2">Transporte</p>
          <p class="font-serif text-lg font-semibold text-med-gold">Circumvesuviana<br/>+ bus SITA</p>
        </div>
        <div class="w-full bg-slate-900 rounded-2xl p-4 sm:p-6 hover:shadow-md transition-shadow flex flex-col items-center justify-center aspect-square snap-start">
          <svg class="w-8 h-8 text-med-gold mb-3" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
            <circle cx="12" cy="12" r="1"/>
            <path d="M12 1v6M12 17v6M4.22 4.22l4.24 4.24M15.54 15.54l4.24 4.24M1 12h6M17 12h6M4.22 19.78l4.24-4.24M15.54 8.46l4.24-4.24"/>
          </svg>
          <p class="text-xs text-white/60 font-semibold uppercase tracking-wide mb-2">Coste transporte</p>
          <p class="font-serif text-lg font-semibold text-med-gold">~€12–18<br/><span class="text-xs">p.p.</span></p>
        </div>
      </div>

      <!-- SEO Text Below -->
      <div>
        <p class="text-lg text-slate-700 leading-relaxed">
          El <strong>Sendero de los Dioses</strong> (Sentiero degli Dei) en un día desde <strong>Nápoles</strong>: Circumvesuviana hasta Sorrento (€3.90), bus SITA a <strong>Amalfi</strong>, bus local a <strong>Agerola</strong>. El trekking de 8 km desciende ~500 m hasta <strong>Nocelle</strong> con vistas impresionantes sobre la Costa Amalfitana. Después, bus a <strong>Positano</strong> y regreso. <strong>Reserva obligatoria julio-agosto</strong> (~€5, Parque de los Monti Lattari). <strong>Coste transporte: ~€12–18</strong>.
        </p>
      </div>
    </section>


    <!-- Day by Day Itinerary -->
    <section>
      <h2 class="font-serif text-2xl font-semibold text-slate-900 mb-8">Programa del día</h2>
      <div class="bg-white border border-slate-200 rounded-2xl overflow-hidden">
        <div class="px-6 py-8 space-y-6">
          {schedule.map((item, idx) => {
            const badge = transportBadge[item.transport];
            const isLastItem = idx === schedule.length - 1;
            return (
              <div class="flex gap-4">
                <div class="flex flex-col items-center flex-shrink-0">
                  <div class="w-16 bg-slate-900 text-med-gold rounded-full px-2 py-1 text-center text-sm font-semibold flex items-center justify-center">
                    {item.time}
                  </div>
                  {!isLastItem && <div class="w-0.5 h-12 bg-med-blue/30 mt-2"></div>}
                </div>
                <div class="pb-4 flex-1">
                  <p class="font-semibold text-slate-900 mb-1">{item.place}</p>
                  <p class="text-slate-700 text-sm mb-2">{item.action}</p>
                  {badge.label && (
                    <span class={`text-xs font-semibold px-2 py-1 rounded-full ${badge.cls}`}>
                      {badge.label}
                    </span>
                  )}
                </div>
              </div>
            );
          })}
        </div>
      </div>
    </section>

    <!-- Destinations Highlighted -->
    <section>
      <h2 class="font-serif text-2xl font-semibold text-slate-900 mb-8">Destinos del itinerario</h2>
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4">
        {destinationHighlights.map((dest) => (
          <a href={dest.url} class="group block bg-white border border-slate-200 rounded-2xl p-5 hover:shadow-lg hover:border-med-blue/30 transition-all">
            <h3 class="font-semibold text-charcoal mb-2 group-hover:text-med-blue transition-colors">{dest.name}</h3>
            <p class="text-xs text-slate-500 leading-relaxed mb-3">{dest.desc}</p>
            <span class="text-xs font-semibold text-med-blue inline-flex items-center gap-1 group-hover:gap-2 transition-all">
              Descubre →
            </span>
          </a>
        ))}
      </div>
    </section>

    <!-- Planning Tips -->
    <section class="bg-med-cream border border-med-gold/20 rounded-[2rem] p-6">
      <h2 class="font-serif text-xl font-semibold text-charcoal mb-6">Consejos prácticos</h2>
      <ul class="space-y-4">
        {tips.map((text, idx) => {
          const nums = ['❶', '❷', '❸', '❹', '❺'];
          return (
            <li class="flex items-start gap-4 text-sm text-charcoal">
              <span class="text-2xl font-bold text-white flex-shrink-0 leading-none mt-0.5 bg-[#E2725B] w-9 h-9 flex items-center justify-center rounded-full">{nums[idx] || '•'}</span>
              <span class="leading-relaxed">{text}</span>
            </li>
          );
        })}
      </ul>
    </section>

    <!-- FAQ -->
    <section id="faq">
      <h2 class="font-serif text-2xl font-semibold text-slate-900 mb-6">Preguntas frecuentes</h2>
      <div class="space-y-4">
        {faqSchema.mainEntity.map((q) => (
          <details class="group border border-slate-200 rounded-2xl overflow-hidden">
            <summary class="flex items-center justify-between px-6 py-4 cursor-pointer select-none text-charcoal font-medium hover:bg-slate-50 transition-colors">
              {q.name}
              <svg class="w-4 h-4 text-slate-400 group-open:rotate-180 transition-transform flex-shrink-0 ml-3" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
            </summary>
            <div class="px-6 pb-5 text-slate-600 leading-relaxed text-sm border-t border-slate-100 pt-4">
              {q.acceptedAnswer.text}
            </div>
          </details>
        ))}
      </div>
    </section>

    <!-- CTA -->
    <section class="bg-gradient-to-r from-med-blue to-med-blue/80 rounded-2xl p-10 text-center text-white">
      <h2 class="font-serif text-3xl font-bold mb-3">Descubre la Costa Amalfitana</h2>
      <p class="text-white/90 mb-6 max-w-2xl mx-auto">
        Guía completa de la Costa Amalfitana: pueblos, playas, transportes y todo lo que necesitas para planificar tu viaje.
      </p>
      <a href="/es-es/costa-amalfitana/" class="inline-block bg-white text-med-blue font-semibold px-8 py-3 rounded-full hover:bg-slate-100 transition-colors">
        Explorar la Costa Amalfitana →
      </a>
    </section>

  </div>

</BaseLayout>
