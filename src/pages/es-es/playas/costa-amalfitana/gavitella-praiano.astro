---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../../components/Breadcrumbs.astro';
import CorrelationSlider from '../../../../components/CorrelationSlider.astro';

const lang = 'es-es';

const breadcrumbs = [
  { name: 'Inicio', url: '/es-es/' },
  { name: 'Playas', url: '/es-es/playas/' },
  { name: 'Playa de Gavitella', url: '/es-es/playas/costa-amalfitana/gavitella-praiano/' },
];

const facts = [
  { label: 'Composición', value: 'Guijarros' },
  { label: 'Acceso', value: '400 escalones O taxi boat' },
  { label: 'Exposición', value: 'Oeste – sol todo el día' },
  { label: 'Servicios', value: 'Club de playa Gavitella + restaurantes' },
  { label: 'Ideal para', value: 'Sol vespertino, atardecer, vista de Positano' },
  { label: 'Vista', value: 'Faraglioni de Capri + costa hasta Punta Campanella' },
  { label: 'Hamaca + sombrilla', value: '€30–€45 por persona' },
  { label: 'Característica única', value: 'Única playa sur-Costa al sol todo el día' },
  { label: 'Mejor temporada', value: 'Mayo–junio, septiembre' },
];

const faqSchema = {
  "@context": "https://schema.org", "@type": "FAQPage",
  "mainEntity": [
    { "@type": "Question", "name": "¿Cómo se llega a la Playa de Gavitella?", "acceptedAnswer": { "@type": "Answer", "text": "Hay dos maneras: (1) A pie desde el centro de Praiano bajando una escalera panorámica de unos 400 escalones tallados en el acantilado (15–20 minutos). (2) En taxi boat desde Praiano, Positano o el puerto de Conca dei Marini (€10–20 por persona). Los clubs de playa de Gavitella también ofrecen servicio de lanzadera desde el centro de Praiano en temporada alta. La subida a pie es exigente: muchos eligen subir en taxi boat." } },
    { "@type": "Question", "name": "¿Por qué Gavitella es la única playa de Praiano al sol todo el día?", "acceptedAnswer": { "@type": "Answer", "text": "La Costa Amalfitana está orientada al sur, y la mayoría de las playas pierden el sol al final de la tarde por los altos acantilados detrás. Gavitella tiene una orientación excepcional: mira al oeste, por lo que recibe el sol desde la mañana hasta el atardecer. Es la única playa del lado sur de la Costa donde puedes tomar el sol a las 18 en verano. Esta característica, junto con la vista frontal de Positano, la convierte en una excepción única." } },
    { "@type": "Question", "name": "¿Se puede ver el atardecer desde la Playa de Gavitella?", "acceptedAnswer": { "@type": "Answer", "text": "Sí, y el atardecer de Gavitella se considera uno de los más espectaculares de toda la Costa Amalfitana. La orientación oeste permite ver el sol descender directamente sobre el mar, con la silueta de Positano y los Faraglioni de Capri al fondo. Mejor período: de mayo a septiembre, con pico hacia las 20:30 en junio-julio. Muchos clubs de playa ofrecen aperitivo al atardecer — reserva la noche anterior." } },
    { "@type": "Question", "name": "¿Cuánto cuestan las hamacas en la Playa de Gavitella?", "acceptedAnswer": { "@type": "Answer", "text": "Los clubs de playa de Gavitella (Gavitella Beach Club, La Gavitella Restaurant) ofrecen hamaca + sombrilla desde €30–45 por persona. Hay una zona libre limitada, pero el taxi boat para llegar y el esfuerzo de la escalera hacen que la mayoría opte por el club de playa. El precio incluye baños, duchas, bar/restaurante. Almuerzo: €40–60 por persona con hamaca incluida en algunos restaurantes." } },
    { "@type": "Question", "name": "¿Es la Playa de Gavitella adecuada para familias con niños?", "acceptedAnswer": { "@type": "Answer", "text": "Sí, con precaución. El mar es calmo y poco profundo en los primeros metros, ideal para niños. Sin embargo, el acceso por 400 escalones no se aconseja con carritos o niños muy pequeños: mejor llegar en taxi boat. Los clubs de playa ofrecen hamacas, sombrillas y los niños pueden encontrar sombra durante el día. Socorrista presente en temporada alta." } },
    { "@type": "Question", "name": "¿Qué se ve desde la Playa de Gavitella?", "acceptedAnswer": { "@type": "Answer", "text": "La vista desde Gavitella es única: enfrente, en el horizonte, los Faraglioni de Capri y la silueta de la isla que cambia color durante el día. A la derecha, la bahía de Positano con la cúpula mayólica de Santa Maria Assunta perfectamente enmarcada. A la izquierda, la costa hasta Punta Campanella. Las islas Li Galli (las \"islas de las Sirenas\" de Homero) son visibles al fondo. Es una de las vistas panorámicas más completas de toda la Costa Amalfitana." } }
  ]
};

const beachSchema = {
  "@context": "https://schema.org", "@type": "Beach",
  "name": "Playa de Gavitella",
  "description": "La única playa de la Costa Amalfitana orientada al oeste, al sol todo el día. Vista frontal de Positano, Capri y atardecer legendario.",
  "geo": { "@type": "GeoCoordinates", "latitude": "40.6101", "longitude": "14.5273" },
  "address": { "@type": "PostalAddress", "addressLocality": "Praiano", "addressRegion": "SA", "addressCountry": "IT" },
  "amenityFeature": [
    { "@type": "LocationFeatureSpecification", "name": "Beach Club", "value": "Sí" },
    { "@type": "LocationFeatureSpecification", "name": "Restaurantes", "value": "Sí" },
    { "@type": "LocationFeatureSpecification", "name": "Sol todo el día", "value": "Sí" }
  ]
};

const nearbyBeaches = [
  { name: 'Marina di Praia', href: '/es-es/playas/costa-amalfitana/marina-di-praia/', tag: 'Praiano', desc: 'La otra playa de Praiano, salvaje e íntima.' },
  { name: 'Spiaggia Grande', href: '/es-es/playas/costa-amalfitana/spiaggia-grande-positano/', tag: 'Positano', desc: 'El corazón mundano de la Costa Amalfitana.' },
  { name: 'Playa de Fornillo', href: '/es-es/playas/costa-amalfitana/fornillo-positano/', tag: 'Positano', desc: 'La segunda playa de Positano, más tranquila.' },
  { name: 'Fiordo di Furore', href: '/es-es/playas/costa-amalfitana/fiordo-di-furore/', tag: 'Furore', desc: 'El fiordo entre acantilados.' },
];
---

<BaseLayout title="Playa de Gavitella, Praiano: la Playa al Sol todo el Día" description="La Gavitella de Praiano: la única playa de la Costa al sol desde la mañana hasta el atardecer. Cómo llegar, precios 2026, vista de Positano y Capri." lang={lang} breadcrumbs={breadcrumbs} schema={[beachSchema, faqSchema]} pageKey="gavitella-praiano"
  heroImage="/images/gavitella-hero.jpg"
>

  <section class="relative h-[52.5vh] sm:h-[70vh] overflow-hidden flex items-center justify-center">
    <img src="/images/gavitella-hero.jpg" alt="Playa de Gavitella, Praiano" class="absolute inset-0 w-full h-full object-cover" loading="eager" fetchpriority="high" decoding="sync" referrerpolicy="no-referrer" />
    <div class="absolute inset-0 hidden sm:block bg-gradient-to-b from-black/20 via-black/35 to-black/70"></div>
    <div class="relative z-10 text-center px-6 max-w-4xl text-white">
      <p class="text-med-gold text-xs sm:text-sm font-medium uppercase tracking-[0.3em] mb-3"><a href="/es-es/costa-amalfitana/praiano/" class="text-med-gold hover:underline">Praiano</a> · La playa del sol</p>
      <h1 class="font-serif text-display text-white mb-6">Playa de Gavitella</h1>
      <p class="text-lg md:text-xl font-light text-white/80">La única playa de la Costa Amalfitana al sol desde la mañana hasta el atardecer, con vista frontal de Positano y Capri.</p>
    </div>
    <Breadcrumbs breadcrumbs={breadcrumbs} />
  </section>

  <section class="bg-med-cream py-24 px-6">
    <div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-3 gap-16">
      <div class="lg:col-span-2 space-y-12">
        <div>
          <h2 class="font-serif text-4xl font-bold text-slate-900 mb-6">La Excepción de la Costa</h2>
          <p class="text-slate-600 text-lg leading-relaxed mb-6">La Playa de Gavitella — o simplemente <strong>"La Gavitella"</strong> para quien la conoce — es la playa que rompe todas las reglas de la <a href="/es-es/costa-amalfitana/" class="text-med-blue hover:underline">Costa Amalfitana</a>. Mientras todas las demás playas de la costa pierden el sol hacia las 16-17 de la tarde — ensombrecidas por los altos acantilados detrás — Gavitella, orientada al oeste, goza de sol pleno desde la mañana hasta el atardecer.</p>
          <p class="text-slate-600 text-lg leading-relaxed">Esta singularidad, combinada con una <strong>vista frontal espectacular</strong> de <a href="/es-es/costa-amalfitana/positano/" class="text-med-blue hover:underline">Positano</a>, los Faraglioni de <a href="/es-es/islas/capri/" class="text-med-blue hover:underline">Capri</a> en el horizonte y las islas Li Galli al fondo, la convierten en una de las playas más buscadas por los conocedores de la costa.</p>
        </div>

        <div class="bg-white p-8 rounded-[2rem] shadow-xl border border-slate-100">
          <div class="flex items-center gap-4 mb-4">
            <svg class="w-6 h-6 text-med-gold flex-shrink-0" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="3"/></svg>
            <h3 class="text-xl font-bold">La Vista Panorámica</h3>
          </div>
          <p class="text-slate-600 leading-relaxed">Enfrente, en el horizonte, los <strong>Faraglioni de Capri</strong>. A la derecha, la bahía de Positano con la cúpula mayólica de <strong>Santa Maria Assunta</strong> enmarcada entre casas color pastel. A la izquierda, la <strong>Punta Campanella</strong> en el extremo de la <a href="/es-es/peninsula-sorrentina/" class="text-med-blue hover:underline">Península Sorrentina</a>. Al fondo, las tres rocas de las <strong>islas Li Galli</strong>, las "islas de las Sirenas" citadas por Homero en la Odisea. Es una de las vistas más completas de toda la Costa.</p>
        </div>

        <div>
          <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">El Atardecer de Gavitella</h2>
          <p class="text-slate-600 text-lg leading-relaxed mb-6">Cuando el sol empieza a descender hacia el oeste, la Playa de Gavitella se transforma. La luz dorada ilumina los acantilados calcáreos detrás, el agua atraviesa una paleta de colores — del turquesa al rosa antiguo — y la silueta de los Faraglioni de Capri se vuelve el sujeto perfecto para cualquier fotografía. En verano, el sol se pone hacia las <strong>20:30</strong>; en primavera y otoño, hacia las 19:00.</p>
          <p class="text-slate-600 text-lg leading-relaxed">Los clubs de playa de Gavitella — en particular el restaurante La Gavitella Beach Restaurant — organizan aperitivos al atardecer con vista. Cócteles, entrantes de mar y el sol sumergiéndose en el Tirreno: difícil encontrar mejor combinación en toda la Campania.</p>
        </div>

        <div>
          <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">De Cala de Pescadores a Playa de Culto</h2>
          <p class="text-slate-600 text-lg leading-relaxed mb-6">El nombre <em>Gavitella</em> deriva del dialecto local para indicar un pequeño abrigo. Hasta el siglo XX, la playa era utilizada exclusivamente por los pescadores de Praiano para varar las barcas y para la pesca al palangre (el pescado típico estival de la Costa). El acceso era tan difícil que la playa permaneció prácticamente desconocida al turismo hasta los años 70.</p>
          <p class="text-slate-600 text-lg leading-relaxed mb-6">El cambio llegó cuando el <strong>atardecer de Gavitella</strong> empezó a ser fotografiado por los primeros fotógrafos turísticos. La fama creció lentamente, alimentada por el boca a boca y la revelación de las cualidades "únicas" de la playa: sol todo el día, vista incomparable, lejanía de la multitud. En los años 2000 nacieron los primeros clubs de playa organizados, pero el carácter auténtico de la playa permanece intacto.</p>
          <p class="text-slate-600 text-lg leading-relaxed">Hoy Gavitella es considerada por muchos la "playa secreta" más conocida de la Costa — una paradoja que es ella misma parte del encanto.</p>
        </div>

        <div class="bg-slate-900 text-white p-8 rounded-[2rem] grid grid-cols-2 sm:grid-cols-4 gap-6 text-center">
          <div><p class="text-med-gold text-3xl font-bold">400</p><p class="text-white/60 text-sm mt-1">escalones de acceso</p></div>
          <div><p class="text-med-gold text-3xl font-bold">100%</p><p class="text-white/60 text-sm mt-1">sol todo el día</p></div>
          <div><p class="text-med-gold text-3xl font-bold">3</p><p class="text-white/60 text-sm mt-1">islas Li Galli visibles</p></div>
          <div><p class="text-med-gold text-3xl font-bold">€30</p><p class="text-white/60 text-sm mt-1">hamaca (desde)</p></div>
        </div>

        <div class="bg-med-cream p-8 rounded-[2rem] border border-med-gold/20">
          <h3 class="font-serif text-2xl font-bold text-slate-900 mb-6">Consejos de los Locales</h3>
          <ul class="space-y-4">
            <li class="flex items-start gap-3"><span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span><span class="text-slate-600">Baja a pie por la mañana cuando hace fresco (15-20 minutos, 400 escalones), luego sube en taxi boat para evitar la subida bajo el sol vespertino.</span></li>
            <li class="flex items-start gap-3"><span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span><span class="text-slate-600">Para el atardecer: reserva una mesa en La Gavitella Restaurant la noche anterior. El aperitivo al atardecer es una experiencia imperdible.</span></li>
            <li class="flex items-start gap-3"><span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span><span class="text-slate-600">Crema solar extra: el sol pega fuerte y no hay acantilados que creen sombra natural. Sombrero obligatorio.</span></li>
            <li class="flex items-start gap-3"><span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span><span class="text-slate-600">Los clubs de playa tienen menos plazas que en Positano: reserva al menos 2-3 días antes los fines de semana de julio y agosto.</span></li>
            <li class="flex items-start gap-3"><span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span><span class="text-slate-600">Mejor temporada: junio o septiembre. Sol fuerte pero soportable, agua caliente, sin multitudes.</span></li>
          </ul>
        </div>

        <div>
          <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">Cómo Llegar</h2>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div class="bg-white p-6 rounded-[2rem] border border-slate-100 shadow-sm"><p class="text-med-gold text-xs font-bold uppercase tracking-wider mb-2">Taxi Boat ⭐</p><p class="text-slate-700 font-medium mb-1">Desde Praiano o Positano</p><p class="text-slate-500 text-xs sm:text-sm">€10–20 por persona. Solución recomendada para la subida de vuelta y para familias con niños.</p></div>
            <div class="bg-white p-6 rounded-[2rem] border border-slate-100 shadow-sm"><p class="text-med-gold text-xs font-bold uppercase tracking-wider mb-2">A pie</p><p class="text-slate-700 font-medium mb-1">Desde el centro de Praiano</p><p class="text-slate-500 text-xs sm:text-sm">400 escalones de bajada (15-20 min), subida de 25-30 min. Calzado deportivo, agua suficiente.</p></div>
            <div class="bg-white p-6 rounded-[2rem] border border-slate-100 shadow-sm"><p class="text-med-gold text-xs font-bold uppercase tracking-wider mb-2">Bus SITA</p><p class="text-slate-700 font-medium mb-1">Parada Praiano centro</p><p class="text-slate-500 text-xs sm:text-sm">Desde allí las escaleras para la playa. Ver <a href="/es-es/guia/bus-sita/" class="text-med-blue hover:underline">horarios SITA</a>.</p></div>
            <div class="bg-white p-6 rounded-[2rem] border border-slate-100 shadow-sm"><p class="text-med-gold text-xs font-bold uppercase tracking-wider mb-2">En coche</p><p class="text-slate-700 font-medium mb-1">Aparcamiento Praiano</p><p class="text-slate-500 text-xs sm:text-sm">Aparcamientos de pago limitados en el centro de Praiano. <a href="/es-es/guia/aparcamiento-ztl/" class="text-med-blue hover:underline">Guía aparcamiento</a>.</p></div>
          </div>
        </div>

        <div>
          <h2 class="font-serif text-3xl font-bold text-slate-900 mb-8">Preguntas Frecuentes</h2>
          <div class="space-y-4">
            {faqSchema.mainEntity.map((q) => (
              <details class="group border border-slate-200 rounded-2xl overflow-hidden bg-white">
                <summary class="flex items-center justify-between px-6 py-4 cursor-pointer select-none text-charcoal font-medium hover:bg-slate-50 transition-colors">
                  {q.name}
                  <svg class="w-4 h-4 text-slate-400 group-open:rotate-180 transition-transform flex-shrink-0 ml-3" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
                </summary>
                <div class="px-6 pb-5 text-slate-600 leading-relaxed text-xs sm:text-sm border-t border-slate-100 pt-4">{q.acceptedAnswer.text}</div>
              </details>
            ))}
          </div>
        </div>
      </div>

      <aside class="lg:col-span-1">
        <div class="bg-slate-900 text-white p-10 rounded-[3rem] sticky top-32">
          <h3 class="font-serif text-2xl font-bold mb-8 flex items-center gap-3">
            <svg class="w-6 h-6 text-med-gold" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M2 12c.6.5 1.2 1 2.5 1 2.5 0 2.5-2 5-2 2.6 0 2.4 2 5 2 2.5 0 2.5-2 5-2 1.3 0 1.9.5 2.5 1"/><path d="M2 18c.6.5 1.2 1 2.5 1 2.5 0 2.5-2 5-2 2.6 0 2.4 2 5 2 2.5 0 2.5-2 5-2 1.3 0 1.9.5 2.5 1"/></svg> Datos Rápidos
          </h3>
          <div class="space-y-6">{facts.map((item) => (<div class="border-b border-white/5 pb-4 last:border-0"><span class="text-white/40 text-xs sm:text-sm font-light block mb-1">{item.label}</span><span class="text-white font-medium text-xs sm:text-sm">{item.value}</span></div>))}</div>
          <div class="mt-10 pt-8 border-t border-white/10"><a href="/es-es/playas/" class="inline-flex items-center gap-2 text-med-gold text-xs sm:text-sm font-medium hover:text-white transition-colors">← Todas las playas</a></div>
        </div>
      </aside>
    </div>
  </section>

  <CorrelationSlider lang="es-es" items={nearbyBeaches} title="Playas Cercanas para Explorar" />

  <section class="bg-med-blue py-16 text-center">
    <div class="max-w-2xl mx-auto px-6">
      <h2 class="font-serif text-2xl font-bold text-white mb-4">Descubre más playas de la Costa</h2>
      <a href="/es-es/playas/" class="inline-block bg-white text-med-blue font-semibold px-8 py-3 rounded-full hover:bg-med-cream transition-colors">Guía completa de playas</a>
    </div>
  </section>

</BaseLayout>
