---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../../components/Breadcrumbs.astro';
import CorrelationSlider from '../../../../components/CorrelationSlider.astro';

const lang = 'es-es';

const breadcrumbs = [
  { name: 'Inicio', url: '/es-es/' },
  { name: 'Playas', url: '/es-es/playas/' },
  { name: 'Cala del Pozzo Vecchio', url: '/es-es/playas/islas/cala-del-pozzo-vecchio/' },
];

const facts = [
  { label: 'Composicion', value: 'Arena negra volcanica' },
  { label: 'Ambiente', value: 'Poetico y tranquilo' },
  { label: 'Acceso', value: '10 min a pie desde el bus' },
  { label: 'Sombra', value: 'A partir de las 17:30' },
  { label: 'Ideal para', value: 'Cinefilos, poesia, relax autentico' },
  { label: 'Isla', value: 'Procida (4 km2)' },
  { label: 'Geologia', value: 'Toba amarilla napolitana' },
  { label: 'Pelicula', value: 'Il Postino (1994)' },
  { label: 'Oscar', value: '5 nominaciones, 1 victoria' },
  { label: 'Fortaleza', value: 'Terra Murata (medieval)' },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Como se llega a la Cala del Pozzo Vecchio desde Napoles?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Desde Napoles se toma el ferry o el hidroala hacia Procida desde el puerto de Pozzuoli o desde Molo Beverello (unos 35-80 minutos segun el medio). Desde el puerto de Procida se toma el bus linea C1 hasta la parada Pozzo Vecchio, luego 10 minutos a pie cuesta abajo. Tambien se puede llegar a pie desde el centro en unos 20-25 minutos por las callejuelas de la isla."
      }
    },
    {
      "@type": "Question",
      "name": "La Cala del Pozzo Vecchio es realmente la playa de Il Postino?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Si. La Cala del Pozzo Vecchio es la playa principal utilizada como escenario en la pelicula Il Postino (1994), dirigida por Michael Radford con Massimo Troisi y Philippe Noiret. Algunas escenas se rodaron tambien en otras zonas de Procida y en la isla de Salina (para las tomas de Neruda). La playa es facilmente reconocible por los fans de la pelicula."
      }
    },
    {
      "@type": "Question",
      "name": "Hay servicios en la Cala del Pozzo Vecchio?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "La playa cuenta con servicios basicos: algunas sombrillas y tumbonas de alquiler, un pequeno quiosco de bebidas. No es una playa equipada con un lido completo, lo que contribuye a su encanto autentico. Es mejor llevar agua y comida si se planea pasar el dia entero. El cercano pueblo de Procida ofrece bares y restaurantes a pocos minutos a pie."
      }
    },
    {
      "@type": "Question",
      "name": "Cual es la mejor epoca para visitar Procida y la Cala del Pozzo Vecchio?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Mayo, junio y septiembre son los meses ideales: el mar ya esta calido (22-26 grados), hay pocos turistas en comparacion con agosto y la atmosfera es la mas autentica. En julio y agosto la playa se llena, pero nunca alcanza los niveles de masificacion de Capri o Ischia. La isla es agradable tambien en primavera para pasear."
      }
    },
    {
      "@type": "Question",
      "name": "Se puede hacer snorkel en la Cala del Pozzo Vecchio?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Si, las aguas de la Cala del Pozzo Vecchio son cristalinas y aptas para el snorkel. Los fondos arenosos descienden suavemente, con buena visibilidad sobre todo por la manana antes de que el viento de la tarde mueva la arena. En la zona rocosa a los lados de la cala se encuentran erizos de mar, pulpos y pequenos bancos de peces. Hay que llevar equipo propio ya que no hay alquiler en el lugar."
      }
    }
  ]
};

const beachSchema = {
  "@context": "https://schema.org",
  "@type": "Beach",
  "name": "Cala del Pozzo Vecchio",
  "description": "La playa de Procida inmortalizada por la pelicula Il Postino de Massimo Troisi. Arena negra volcanica y aguas esmeralda.",
  "address": {
    "@type": "PostalAddress",
    "addressLocality": "Procida",
    "addressRegion": "NA",
    "addressCountry": "IT"
  }
};
---

<BaseLayout
  title="Playa del Cartero Procida 2026: Cala del Pozzo Vecchio"
  description="La playa inmortalizada por la pelicula Il Postino. Arena negra volcanica, agua esmeralda y el lado mas autentico de Procida. Guia 2026."
  lang={lang}
  breadcrumbs={breadcrumbs}
  schema={[beachSchema, faqSchema]}
 pageKey="cala-del-pozzo-vecchio">

  <!-- Hero -->
  <section class="relative h-[52.5vh] sm:h-[70vh] overflow-hidden flex items-center justify-center">
    <img
      src="/images/cala-pozzo-vecchio-procida.jpg"
      alt="Cala del Pozzo Vecchio, Procida - la playa del Cartero"
      class="absolute inset-0 w-full h-full object-cover"
      loading="eager" fetchpriority="high" decoding="sync" referrerpolicy="no-referrer"
    />
    <div class="absolute inset-0 bg-gradient-to-b from-black/20 via-black/35 to-black/70"></div>
    <div class="relative z-10 text-center px-6 max-w-4xl text-white">
      <p class="text-med-gold text-xs sm:text-sm font-medium uppercase tracking-[0.3em] mb-3">Procida · Islas del Golfo</p>
      <h1 class="font-serif text-display text-white mb-6">Cala del Pozzo Vecchio</h1>
      <p class="text-lg md:text-xl font-light text-white/80">La playa inmortalizada por Massimo Troisi.</p>
    </div>
    <Breadcrumbs breadcrumbs={breadcrumbs} />
  </section>

  <!-- Contenido + Sidebar -->
  <section class="bg-med-cream py-24 px-6">
    <div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-3 gap-16">

      <!-- Texto principal -->
      <div class="lg:col-span-2 space-y-12">
        <div>
          <h2 class="font-serif text-4xl font-bold text-slate-900 mb-6">El Cine Hecho Playa</h2>
          <p class="text-slate-600 text-lg leading-relaxed mb-6">
            La playa inmortalizada por Massimo Troisi en <em>Il Postino</em> (1994). Un arco de arena negra volcanica y agua color esmeralda que parece sacado directamente de la pelicula. En cuanto llegas, entiendes de inmediato por que Troisi y el director Michael Radford la eligieron como escenario principal.
          </p>
          <p class="text-slate-600 text-lg leading-relaxed">
            Es el lado mas autentico y menos turistico de las islas campanas. <a href="/es-es/islas/procida/" class="text-med-blue hover:underline">Procida</a> nunca ha conocido el turismo masivo de <a href="/es-es/islas/capri/" class="text-med-blue hover:underline">Capri</a> o <a href="/es-es/islas/ischia/" class="text-med-blue hover:underline">Ischia</a>, y esta playa conserva esa alma: pocos visitantes, mucha poesia, un agua impecablemente limpia. Perfecta para el relax total y para quienes disfrutan de las atmosferas cinematograficas.
          </p>
        </div>

        <!-- Il Postino -->
        <div class="bg-white p-8 rounded-[2rem] shadow-xl border border-slate-100">
          <div class="flex items-center gap-4 mb-4">
            <svg class="w-6 h-6 text-med-gold flex-shrink-0" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><rect x="2" y="2" width="20" height="20" rx="2.18" ry="2.18"/><line x1="7" y1="2" x2="7" y2="22"/><line x1="17" y1="2" x2="17" y2="22"/><line x1="2" y1="12" x2="22" y2="12"/><line x1="2" y1="7" x2="7" y2="7"/><line x1="2" y1="17" x2="7" y2="17"/><line x1="17" y1="17" x2="22" y2="17"/><line x1="17" y1="7" x2="22" y2="7"/></svg>
            <h3 class="text-xl font-bold">Il Postino (1994)</h3>
          </div>
          <p class="text-slate-600 leading-relaxed mb-4">
            La pelicula de Michael Radford con Massimo Troisi y Philippe Noiret gano el Oscar a la mejor banda sonora. Esta playa es el corazon del film. Muchos visitantes vienen aqui para revivir las escenas iconicas - el cartero caminando por la orilla, la poesia del mar.
          </p>
          <p class="text-slate-600 leading-relaxed italic">
            "Il mondo e bello e tu sei un po' curioso" - Il Postino, 1994
          </p>
        </div>

        <!-- La historia del film -->
        <div>
          <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">La Historia Detras de la Pelicula</h2>
          <p class="text-slate-600 text-lg leading-relaxed mb-6">
            Massimo Troisi interpretaba a Mario Ruoppolo, el cartero de la isla que se hace amigo del poeta chileno Pablo Neruda (Philippe Noiret), exiliado en su villa. La pelicula fue rodada en 1994 en esta playa y en los callejones de Procida. La verdadera tragedia es que Troisi sufria una grave enfermedad cardiaca y pospuso la operacion quirurgica para completar el rodaje. Fallecio apenas <strong>12 horas despues del fin del rodaje</strong>, el 4 de junio de 1994, con tan solo 41 anos.
          </p>
          <p class="text-slate-600 text-lg leading-relaxed">
            Il Postino fue nominada a 5 Oscar, ganando el de la <strong>mejor banda sonora</strong> (Luis Bacalov). Fue la pelicula en lengua extranjera con mayor numero de candidaturas a los Oscar en la historia hasta ese momento. El legado de Troisi y de esta playa sigue mas vivo que nunca.
          </p>
        </div>

        <!-- Geologia e historia -->
        <div>
          <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">El Pozzo Vecchio y la Geologia de la Isla</h2>
          <p class="text-slate-600 text-lg leading-relaxed mb-6">
            El nombre de la cala proviene de un antiguo pozo - el <strong>Pozzo Vecchio</strong> - que en su tiempo se encontraba cerca y servia a pescadores y campesinos para obtener agua dulce. El pozo ya no es visible, pero su nombre ha perdurado durante siglos. La arena negra es <strong>toba amarilla napolitana</strong>: roca volcanica de los Campos Flegreos erosionada por el mar en granulos oscuros y pesados. Los acantilados que bordean la cala muestran claramente las capas de depositos piroclasticos de las antiguas erupciones.
          </p>
          <p class="text-slate-600 text-lg leading-relaxed">
            Procida es la mas pequena de las Islas Flegreas (solo 4 km2). Desde la playa se puede ver en lo alto la silueta de la <strong>Terra Murata</strong>, la ciudadela medieval con la abadia de San Michele Arcangelo. Durante siglos, esa fortaleza protegio a los procidanos de las incursiones de los piratas sarracenos.
          </p>
        </div>

        <!-- Tradicion pesquera -->
        <div class="bg-white p-8 rounded-[2rem] shadow-xl border border-slate-100">
          <div class="flex items-center gap-4 mb-4">
            <svg class="w-6 h-6 text-med-gold flex-shrink-0" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M18 16.5a9 9 0 1 1-9-9"/><path d="M22 2L11 13"/><path d="M22 2h-5.5M22 2v5.5"/></svg>
            <h3 class="text-xl font-bold">La Tradicion Pesquera</h3>
          </div>
          <p class="text-slate-600 leading-relaxed">
            Procida presume de la tradicion pesquera mas fuerte de todas las islas del Golfo. Los pescadores procidanos siguen usando metodos tradicionales y cada ano la fiesta de la <strong>Graziella</strong> celebra esta identidad marinera. El personaje literario de Graziella, creado por Alphonse de Lamartine en 1852, era precisamente una joven pescadora de Procida. El pescado local - almejas, pulpos, calamares - es de lo mas fresco del Golfo de Napoles.
          </p>
        </div>

        <!-- Stats box -->
        <div class="bg-slate-900 text-white p-8 rounded-[2rem] grid grid-cols-2 sm:grid-cols-4 gap-6 text-center">
          <div>
            <p class="text-med-gold text-3xl font-bold">4</p>
            <p class="text-white/60 text-sm mt-1">km2 Procida</p>
          </div>
          <div>
            <p class="text-med-gold text-3xl font-bold">5</p>
            <p class="text-white/60 text-sm mt-1">nominaciones Oscar</p>
          </div>
          <div>
            <p class="text-med-gold text-3xl font-bold">12h</p>
            <p class="text-white/60 text-sm mt-1">tras el rodaje</p>
          </div>
          <div>
            <p class="text-med-gold text-3xl font-bold">1994</p>
            <p class="text-white/60 text-sm mt-1">ano de la pelicula</p>
          </div>
        </div>

        <!-- Consejos locales -->
        <div class="bg-med-cream p-8 rounded-[2rem] border border-med-gold/20">
          <h3 class="font-serif text-2xl font-bold text-slate-900 mb-6">Consejos de los Locales</h3>
          <ul class="space-y-4">
            <li class="flex items-start gap-3">
              <span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span>
              <span class="text-slate-600">Toma el hidroala desde Pozzuoli en vez de Napoles: cuesta menos y tarda casi lo mismo.</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span>
              <span class="text-slate-600">Visita la playa a primera hora de la manana para encontrar la atmosfera silenciosa y poetica de la pelicula.</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span>
              <span class="text-slate-600">Sube a pie hasta Terra Murata despues de la playa: la vista sobre el Golfo compensa completamente la subida.</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span>
              <span class="text-slate-600">Lleva tus escarpines: la arena volcanica negra se calienta mas que la arena normal bajo el sol de agosto.</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span>
              <span class="text-slate-600">Para comer, busca las trattorie en el pueblo viejo: son mas baratas y mas autenticas que las del paseo maritimo.</span>
            </li>
          </ul>
        </div>

        <!-- Como llegar -->
        <div>
          <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">Como Llegar</h2>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div class="bg-white p-6 rounded-[2rem] border border-slate-100 shadow-sm">
              <p class="text-med-gold text-xs font-bold uppercase tracking-wider mb-2">Bus Linea C1 ⭐</p>
              <p class="text-slate-700 font-medium mb-1">Desde el puerto de Procida</p>
              <p class="text-slate-500 text-xs sm:text-sm">Parada Pozzo Vecchio. Luego 10 min a pie en bajada hacia la playa.</p>
            </div>
            <div class="bg-white p-6 rounded-[2rem] border border-slate-100 shadow-sm">
              <p class="text-med-gold text-xs font-bold uppercase tracking-wider mb-2">A pie</p>
              <p class="text-slate-700 font-medium mb-1">Desde el centro de Procida</p>
              <p class="text-slate-500 text-xs sm:text-sm">20-25 minutos. Pintoresco y agradable por los callejones de la isla.</p>
            </div>
            <div class="bg-white p-6 rounded-[2rem] border border-slate-100 shadow-sm">
              <p class="text-med-gold text-xs font-bold uppercase tracking-wider mb-2">Ferry desde Napoles</p>
              <p class="text-slate-700 font-medium mb-1">Molo Beverello o Pozzuoli</p>
              <p class="text-slate-500 text-xs sm:text-sm">35-80 min segun el medio. Hidroala mas rapido, ferry mas economico.</p>
            </div>
            <div class="bg-white p-6 rounded-[2rem] border border-slate-100 shadow-sm">
              <p class="text-med-gold text-xs font-bold uppercase tracking-wider mb-2">Scooter de alquiler</p>
              <p class="text-slate-700 font-medium mb-1">Desde el puerto</p>
              <p class="text-slate-500 text-xs sm:text-sm">Comodo para explorar toda la isla. Aparcamiento cerca de la cala.</p>
            </div>
          </div>
        </div>

        <!-- FAQ -->
        <div>
          <h2 class="font-serif text-3xl font-bold text-slate-900 mb-8">Preguntas Frecuentes</h2>
          <div class="space-y-4">
            {faqSchema.mainEntity.map((q) => (
              <details class="group border border-slate-200 rounded-2xl overflow-hidden bg-white">
                <summary class="flex items-center justify-between px-6 py-4 cursor-pointer select-none text-charcoal font-medium hover:bg-slate-50 transition-colors">
                  {q.name}
                  <svg class="w-4 h-4 text-slate-400 group-open:rotate-180 transition-transform flex-shrink-0 ml-3" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
                </summary>
                <div class="px-6 pb-5 text-slate-600 leading-relaxed text-xs sm:text-sm border-t border-slate-100 pt-4">
                  {q.acceptedAnswer.text}
                </div>
              </details>
            ))}
          </div>
        </div>
      </div>

      <!-- Sidebar Datos Rapidos -->
      <aside class="lg:col-span-1">
        <div class="bg-slate-900 text-white p-10 rounded-[3rem] sticky top-32">
          <h3 class="font-serif text-2xl font-bold mb-8 flex items-center gap-3">
            <svg class="w-6 h-6 text-med-gold" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M2 12c.6.5 1.2 1 2.5 1 2.5 0 2.5-2 5-2 2.6 0 2.4 2 5 2 2.5 0 2.5-2 5-2 1.3 0 1.9.5 2.5 1"/><path d="M2 18c.6.5 1.2 1 2.5 1 2.5 0 2.5-2 5-2 2.6 0 2.4 2 5 2 2.5 0 2.5-2 5-2 1.3 0 1.9.5 2.5 1"/></svg> Datos Clave
          </h3>
          <div class="space-y-6">
            {facts.map((item) => (
              <div class="border-b border-white/5 pb-4 last:border-0">
                <span class="text-white/40 text-xs sm:text-sm font-light block mb-1">{item.label}</span>
                <span class="text-white font-medium text-xs sm:text-sm">{item.value}</span>
              </div>
            ))}
          </div>
          <div class="mt-10 pt-8 border-t border-white/10">
            <a
              href="/es-es/playas/"
              class="inline-flex items-center gap-2 text-med-gold text-xs sm:text-sm font-medium hover:text-white transition-colors"
            >
              ← Todas las playas
            </a>
          </div>
        </div>
      </aside>

    </div>
  </section>

  <!-- Playas cercanas -->
  <CorrelationSlider
    lang="es-es"
    title="Otras Playas de las Islas"
    items={[
      { name: 'Spiaggia Maronti', href: '/es-es/playas/islas/spiaggia-maronti/', tag: 'Ischia', desc: 'Tres km de arena caliente calentada por el volcan.' },
      { name: 'Marina Piccola', href: '/es-es/playas/islas/marina-piccola-capri/', tag: 'Capri', desc: 'La playa exclusiva con vistas a los Faraglioni.' },
      { name: 'Faraglioni', href: '/es-es/playas/islas/faraglioni-capri/', tag: 'Capri', desc: 'Las tres rocas legendarias simbolo de la isla.' },
      { name: 'Spiaggia Grande', href: '/es-es/playas/costa-amalfitana/spiaggia-grande-positano/', tag: 'Positano', desc: 'El corazon mundano de la Costa Amalfitana.' },
    ]}
  />

  <!-- CTA -->
  <section class="bg-med-blue py-16 text-center">
    <div class="max-w-2xl mx-auto px-6">
      <h2 class="font-serif text-2xl font-bold text-white mb-4">Descubre todo sobre Procida</h2>
      <a
        href="/es-es/islas/procida/"
        class="inline-block bg-white text-med-blue font-semibold px-8 py-3 rounded-full hover:bg-med-cream transition-colors"
      >
        Guia completa de Procida
      </a>
    </div>
  </section>

</BaseLayout>