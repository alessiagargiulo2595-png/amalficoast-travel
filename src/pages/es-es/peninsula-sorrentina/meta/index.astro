---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import CorrelationSlider from '../../../../components/CorrelationSlider.astro';
import Breadcrumbs from '../../../../components/Breadcrumbs.astro';

const lang = 'es-es';

const breadcrumbs = [
  { name: 'Inicio', url: '/es-es/' },
  { name: 'Peninsula Sorrentina', url: '/es-es/peninsula-sorrentina/' },
  { name: 'Meta', url: '/es-es/peninsula-sorrentina/meta/' },
];

const touristAttractionSchema = {
  "@context": "https://schema.org",
  "@type": "TouristAttraction",
  "name": "Meta di Sorrento",
  "description": "Meta di Sorrento es un pueblo autentico de la Peninsula Sorrentina, famoso por la playa de Alimuri, la Basilica de la Madonna del Lauro, los astilleros historicos y una atmosfera local alejada del turismo masivo.",
  "url": "https://amalficoast-travel.com/es-es/peninsula-sorrentina/meta/",
  "touristType": ["Playa", "Cultura", "Autenticidad", "Familias"],
  "address": { "@type": "PostalAddress", "addressLocality": "Meta", "addressRegion": "Napoli", "addressCountry": "IT", "postalCode": "80062" },
  "geo": { "@type": "GeoCoordinates", "latitude": 40.6412, "longitude": 14.4097 }
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "¿Cómo llegar a Meta di Sorrento?",
      "acceptedAnswer": { "@type": "Answer", "text": "En tren: la Circumvesuviana para en Meta (parada Meta, una antes de Sorrento). Desde Nápoles unos 65 minutos. En coche: SS145 Sorrentina. Meta está a solo 3 km de Sorrento y también se puede llegar a pie en 30 minutos por el Corso Italia." }
    },
    {
      "@type": "Question",
      "name": "¿Tiene playas Meta di Sorrento?",
      "acceptedAnswer": { "@type": "Answer", "text": "Sí, la playa de Alimuri es la más grande y famosa: una franja de arena oscura accesible en ascensor o por escalinata desde el acantilado. También está la playa dei Marinai, más pequeña y tranquila. Ambas tienen instalaciones equipadas." }
    },
    {
      "@type": "Question",
      "name": "¿Es Meta mejor que Sorrento para alojarse?",
      "acceptedAnswer": { "@type": "Answer", "text": "Para quien busca precios más bajos y una atmósfera menos turística, sí. Los hoteles y B&B en Meta cuestan un 20-30% menos que en Sorrento, y la Circumvesuviana te lleva a todos lados. También es más tranquila por las noches." }
    },
    {
      "@type": "Question",
      "name": "¿Qué ver en Meta di Sorrento?",
      "acceptedAnswer": { "@type": "Answer", "text": "La Basilica de la Madonna del Lauro (con la estatua milagrosa y los frescos), el centro histórico con los palacios nobiliarios, la playa de Alimuri, el Museo Naval (astilleros históricos). Desde Meta también parte el sendero hacia Positano a través de los Colli di San Pietro." }
    },
    {
      "@type": "Question",
      "name": "¿Por qué es famosa Meta por la marinería?",
      "acceptedAnswer": { "@type": "Answer", "text": "Meta era el principal centro de construcción naval de la Peninsula Sorrentina. Los astilleros de Meta construían veleros y bergantines que navegaban por el Mediterráneo y el Atlántico. La tradición marítima sigue siendo visible en los palacios de los capitanes de mar y en el Museo Naval." }
    }
  ]
};

const schemas = [touristAttractionSchema, faqSchema];

const fastFacts = [
  { dt: 'Ubicación', dd: 'Peninsula Sorrentina, NA' },
  { dt: 'Altitud', dd: '~100 m s.n.m.' },
  { dt: 'Población', dd: '~8.000 habitantes' },
  { dt: 'Desde Sorrento', dd: '3 km / 5 min' },
  { dt: 'Desde Nápoles', dd: '65 min (Circumvesuviana)' },
  { dt: 'Playa', dd: 'Alimuri (arena oscura)' },
  { dt: 'Especialidad', dd: 'Limoncello, pescado, pasta' },
  { dt: 'Mejor época', dd: 'Abr-Oct' },
  { dt: 'Ideal para', dd: 'Base económica, familias' },
];

const tips = [
  'Meta es una base perfecta y más económica que Sorrento: misma parada de Circumvesuviana, hoteles un 20-30% más baratos.',
  'La playa de Alimuri es accesible en ascensor desde el acantilado: evita la escalinata si viajas con niños o carritos.',
  'El helado artesanal de Meta es célebre en la zona: busca las heladerías en el centro histórico por la via Municipio.',
  'Desde Meta parte el sendero de los Colli di San Pietro hacia Positano: un trekking panorámico alternativo a la SS163.',
];
---

<BaseLayout
  title="Meta di Sorrento 2026: Playa de Alimuri, Basílica del Lauro y Astilleros"
  description="Guía de Meta di Sorrento: la playa de Alimuri, la Basílica de la Madonna del Lauro, la tradición marinera. Base económica y auténtica para explorar la Peninsula Sorrentina."
  lang={lang}
  breadcrumbs={breadcrumbs}
  schema={schemas}
  pageKey="meta"
>

  <!-- Hero -->
  <section class="relative h-[75vh] sm:h-[90vh] flex items-center bg-charcoal overflow-hidden">
    <img src="/images/meta-hero.webp" alt="Meta di Sorrento, Peninsula Sorrentina" class="absolute inset-0 w-full h-full object-cover" loading="eager" fetchpriority="high" decoding="sync" referrerpolicy="no-referrer"/>
    <div class="absolute inset-0 bg-gradient-to-b from-black/10 via-black/40 to-black/80 z-10"></div>
    <div class="relative z-20 max-w-editorial mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <p class="text-med-gold text-xs sm:text-sm font-medium uppercase tracking-[0.3em] mb-3">Peninsula Sorrentina - Tierra de Marineros</p>
        <h1 class="font-serif text-display text-white mb-4">Meta di Sorrento</h1>
        <p class="text-xl text-white/80 leading-relaxed max-w-2xl">
          Pueblo de capitanes de mar y astilleros históricos. La playa de Alimuri, la Basílica del Lauro y una atmósfera auténtica a 3 km de Sorrento.
        </p>
        <div class="flex flex-wrap gap-3 mt-8">
          <a href="#fast-facts" class="px-5 py-2.5 bg-med-gold text-white text-xs sm:text-sm font-semibold rounded-full hover:scale-105 hover:shadow-[0_8px_25px_rgba(212,175,55,0.4)] transition-all duration-300">Fast Facts</a>
          <a href="#como-llegar" class="px-5 py-2.5 bg-white/10 backdrop-blur text-white text-xs sm:text-sm font-medium rounded-full border border-white/20 hover:bg-white/20 transition-colors">Cómo llegar</a>
          <a href="#faq" class="px-5 py-2.5 bg-white/10 backdrop-blur text-white text-xs sm:text-sm font-medium rounded-full border border-white/20 hover:bg-white/20 transition-colors">FAQ</a>
        </div>
      </div>
    </div>
    <Breadcrumbs breadcrumbs={breadcrumbs} />
  </section>

  <section class="max-w-editorial mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="grid lg:grid-cols-[1fr_320px] gap-12">

      <div class="space-y-16">

        <div class="prose-editorial">
          <p class="text-xl leading-relaxed text-charcoal">
            Meta di Sorrento es el pueblo que los turistas atraviesan en Circumvesuviana sin bajar, una parada antes de <a href="/es-es/peninsula-sorrentina/sorrento/" class="text-med-blue hover:underline">Sorrento</a>. Sin embargo, Meta tiene todo lo necesario para unas vacaciones perfectas: una playa de arena, una basílica espectacular, un centro histórico tranquilo y precios más accesibles que la vecina Sorrento.
          </p>
          <p class="mt-4 text-slate-600 leading-relaxed">
            La historia de Meta está escrita en el mar: durante siglos fue el principal centro de construcción naval de la Peninsula Sorrentina. Los astilleros de Meta construían veleros que navegaban por el Mediterráneo y el Atlántico. Todavía hoy, los palacios de los capitanes de mar en el centro histórico testimonian la riqueza que trajo el comercio marítimo.
          </p>
        </div>

        <!-- ¿Lo sabías? -->
        <div class="bg-slate-900 border border-white/10 rounded-[3rem] p-8">
          <p class="text-[10px] uppercase tracking-[0.3em] text-med-gold font-medium mb-4">¿Lo sabías?</p>
          <div class="grid sm:grid-cols-3 gap-6">
            <div class="text-center">
              <p class="font-serif text-5xl font-bold text-med-gold">3 km</p>
              <p class="text-white/60 text-xs italic mt-1">desde Sorrento, accesible a pie</p>
            </div>
            <div class="text-center">
              <p class="font-serif text-5xl font-bold text-med-gold">S. XVIII</p>
              <p class="text-white/60 text-xs italic mt-1">apogeo de los astilleros de Meta</p>
            </div>
            <div class="text-center">
              <p class="font-serif text-5xl font-bold text-med-gold">-30%</p>
              <p class="text-white/60 text-xs italic mt-1">coste de hotel respecto a Sorrento</p>
            </div>
          </div>
        </div>

        <!-- Qué ver -->
        <div>
          <h2 class="font-serif text-3xl font-semibold text-slate-900 mb-8">Qué ver en Meta</h2>
          <div class="space-y-8">
            {[
              { n: 1, title: 'Basílica de la Madonna del Lauro', text: 'La iglesia más importante de Meta, dedicada a la Madonna del Lauro venerada en toda la Peninsula. Interior barroco con frescos, mármoles policromos y la estatua milagrosa de la Virgen. La fachada domina la plaza principal del pueblo.' },
              { n: 2, title: 'Playa de Alimuri', text: 'La playa principal de Meta: una franja de arena oscura volcánica bajo el acantilado, accesible en ascensor o por escalinata. Instalaciones equipadas y tramo libre. Aguas cristalinas y vistas a la costa. Menos concurrida que las playas de Sorrento.' },
              { n: 3, title: 'Centro histórico y palacios de los capitanes', text: 'La via Municipio y las callejuelas de alrededor conservan los palacios nobiliarios de los capitanes de mar del siglo XVIII-XIX. Portales de piperno, patios interiores y balcones de hierro forjado narran la riqueza de la marinería metesa.' },
              { n: 4, title: 'Museo Naval', text: 'El pequeño museo que cuenta la tradición astillera de Meta: maquetas de veleros, instrumentos de navegación, cartas náuticas y fotografías de época de los astilleros. Entrada gratuita o a precio libre.' },
              { n: 5, title: 'Sendero de los Colli di San Pietro', text: 'Un trekking panorámico que parte de Meta y atraviesa las colinas hasta Positano. Unas 4 horas de camino entre limoneros, olivares y vistas sobre el Golfo. Alternativa espectacular a la SS163.' },
            ].map(({ n, title, text }) => (
              <div class="grid sm:grid-cols-[auto_1fr] gap-4">
                <div class="w-14 h-14 rounded-[1rem] bg-med-gold/10 flex items-center justify-center flex-shrink-0 text-med-gold font-serif font-bold text-xl">{n}</div>
                <div>
                  <h3 class="font-semibold text-charcoal text-lg mb-1">{title}</h3>
                  <p class="text-slate-600 leading-relaxed">{text}</p>
                </div>
              </div>
            ))}
          </div>
        </div>

        <!-- Cómo llegar -->
        <div id="como-llegar">
          <h2 class="font-serif text-3xl font-semibold text-slate-900 mb-6">Cómo llegar a Meta</h2>
          <div class="space-y-6">
            <div class="bg-white rounded-[3rem] p-8 border border-slate-100 hover:shadow-xl transition-all duration-300">
              <h3 class="font-semibold text-charcoal mb-3">Circumvesuviana</h3>
              <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">Parada "Meta" en la línea Nápoles-Sorrento. Desde Nápoles Centrale unos 65 minutos (~3,90 euros). Una parada antes de Sorrento. Frecuencia: cada 30-40 min.</p>
            </div>
            <div class="bg-white rounded-[3rem] p-8 border border-slate-100 hover:shadow-xl transition-all duration-300">
              <h3 class="font-semibold text-charcoal mb-3">Desde Sorrento</h3>
              <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">A pie por el Corso Italia en unos 30 minutos. En Circumvesuviana 3 minutos. En coche 5 minutos por la SS145. Meta es prácticamente contigua a Sorrento.</p>
            </div>
          </div>
        </div>

        <!-- Consejo local -->
        <div class="relative overflow-hidden rounded-[3rem] bg-med-blue p-10 md:p-14 text-white shadow-2xl">
          <div class="relative z-10 flex flex-col md:flex-row items-start md:items-center gap-8">
            <div class="w-20 h-20 rounded-2xl bg-white/10 flex items-center justify-center flex-shrink-0 border border-white/20"><svg class="w-10 h-10 text-med-gold" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 3v2.25m6.364.386-1.591 1.591M21 12h-2.25m-.386 6.364-1.591-1.591M12 18.75V21m-4.773-4.227-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0Z"/></svg></div>
            <div>
              <p class="text-med-gold text-xs font-bold uppercase tracking-[0.3em] mb-2">Consejo local</p>
              <h3 class="font-serif text-2xl font-bold text-white mb-3 tracking-tight">La base secreta de la Peninsula</h3>
              <p class="text-white/70 leading-relaxed">Alójate en Meta en lugar de Sorrento: misma Circumvesuviana, mismas conexiones hacia Capri, la Costa Amalfitana y Nápoles, pero hoteles y restaurantes cuestan un 20-30% menos. Por la noche, el centro de Meta es tranquilo y auténtico.</p>
            </div>
          </div>
          <div class="absolute bottom-0 left-0 translate-y-1/2 -translate-x-1/2 w-80 h-80 bg-med-gold/10 rounded-full blur-3xl pointer-events-none"></div>
        </div>

        <!-- FAQ -->
        <div id="faq">
          <h2 class="font-serif text-3xl font-semibold text-slate-900 mb-8">Preguntas frecuentes sobre Meta</h2>
          <div class="space-y-4">
            {faqSchema.mainEntity.map((q) => (
              <details class="group border border-slate-200 rounded-2xl overflow-hidden">
                <summary class="flex items-center justify-between px-6 py-4 cursor-pointer select-none text-charcoal font-medium hover:bg-slate-50 transition-colors">
                  {q.name}
                  <svg class="w-4 h-4 text-slate-400 group-open:rotate-180 transition-transform flex-shrink-0 ml-3" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
                </summary>
                <div class="px-6 pb-5 text-slate-600 leading-relaxed text-xs sm:text-sm border-t border-slate-100 pt-4">
                  {q.acceptedAnswer.text}
                </div>
              </details>
            ))}
          </div>
        </div>

      </div>

      <aside class="space-y-6 lg:sticky lg:top-24 self-start">
        <div id="fast-facts" class="bg-slate-900 text-white rounded-[3rem] p-6">
          <p class="text-[10px] uppercase tracking-[0.3em] text-med-gold font-medium mb-4">Fast Facts - Meta</p>
          <dl class="space-y-3">
            {fastFacts.map(({ dt, dd }, i) => (
              <>
                <div class="flex justify-between items-start gap-3">
                  <dt class="text-white/40 text-xs sm:text-sm font-light flex-shrink-0">{dt}</dt>
                  <dd class="text-white font-medium text-xs sm:text-sm text-right">{dd}</dd>
                </div>
                {i < fastFacts.length - 1 && <div class="border-t border-white/5"></div>}
              </>
            ))}
          </dl>
        </div>

        <div class="bg-med-cream border border-med-gold/30 rounded-[2rem] p-6">
          <p class="text-[10px] uppercase tracking-[0.3em] text-med-gold font-medium mb-3">Consejos de expertos</p>
          <ul class="space-y-3">
            {tips.map(tip => (
              <li class="flex items-start gap-2 text-xs sm:text-sm text-charcoal">
                <span class="w-1.5 h-1.5 rounded-full bg-med-gold mt-1.5 flex-shrink-0"></span>
                <span>{tip}</span>
              </li>
            ))}
          </ul>
        </div>

        <div class="bg-white border border-slate-100 rounded-[2rem] p-6 shadow-sm">
          <p class="text-[10px] uppercase tracking-[0.3em] text-slate-400 font-medium mb-3">Peninsula Sorrentina</p>
          <nav class="space-y-1">
            {[
              { href: '/es-es/peninsula-sorrentina/sorrento/', label: 'Sorrento' },
              { href: '/es-es/peninsula-sorrentina/vico-equense/', label: 'Vico Equense' },
              { href: '/es-es/peninsula-sorrentina/massa-lubrense/', label: 'Massa Lubrense' },
              { href: '/es-es/peninsula-sorrentina/sant-agnello/', label: 'Sant\'Agnello' },
            ].map(({ href, label }) => (
              <a href={href} class="flex items-center gap-2 px-3 py-2 rounded-xl text-xs sm:text-sm text-charcoal hover:bg-med-blue/5 hover:text-med-blue transition-colors">
                <span class="w-1.5 h-1.5 rounded-full bg-med-blue/30"></span> {label}
              </a>
            ))}
          </nav>
        </div>
      </aside>

    </div>
  </section>

  <CorrelationSlider
    heading="Explora también"
    items={[
      { name: 'Sorrento',       href: '/es-es/peninsula-sorrentina/sorrento/',       tag: 'Hub & Limoncello', desc: 'La Piazza Tasso, el Claustro y el punto de partida hacia Capri.' },
      { name: 'Vico Equense',   href: '/es-es/peninsula-sorrentina/vico-equense/',   tag: 'Pizza al Metro',   desc: 'La pizza al metro de Da Gigino y el Castello Giusso.' },
      { name: 'Massa Lubrense', href: '/es-es/peninsula-sorrentina/massa-lubrense/', tag: 'Naturaleza & Cocina', desc: 'Punta Campanella y los espaguetis alla Nerano.' },
      { name: 'Positano',       href: '/es-es/costa-amalfitana/positano/',           tag: 'Moda & Vistas',    desc: 'Las casas de colores a pico sobre el mar de la Costa.' },
      { name: 'Capri',          href: '/es-es/islas/capri/',                         tag: 'La más icónica',   desc: 'Grotta Azzurra, los Faraglioni y la Piazzetta.' },
    ]}
    lang="es-es"
  />

</BaseLayout>
