---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import CorrelationSlider from '../../../../components/CorrelationSlider.astro';
import Breadcrumbs from '../../../../components/Breadcrumbs.astro';

const lang = 'es-es';

const breadcrumbs = [
  { name: 'Inicio', url: '/es-es/' },
  { name: 'Costa Amalfitana', url: '/es-es/costa-amalfitana/' },
  { name: 'Tramonti', url: '/es-es/costa-amalfitana/tramonti/' },
];

const touristAttractionSchema = {
  "@context": "https://schema.org",
  "@type": "TouristAttraction",
  "name": "Tramonti",
  "description": "Tramonti es el pulmón verde de la Costa Amalfitana, un municipio disperso de 13 aldeas entre viñedos, limoneros e iglesias antiguas. Tierra de vinos Costa d'Amalfi DOC, pizza y tradiciones rurales.",
  "url": "https://amalficoast-travel.com/es-es/costa-amalfitana/tramonti/",
  "touristType": ["Enogastronomía", "Naturaleza", "Autenticidad", "Tradiciones"],
  "address": { "@type": "PostalAddress", "addressLocality": "Tramonti", "addressRegion": "Salerno", "addressCountry": "IT", "postalCode": "84010" },
  "geo": { "@type": "GeoCoordinates", "latitude": 40.6933, "longitude": 14.6333 }
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "¿Cómo llegar a Tramonti?",
      "acceptedAnswer": { "@type": "Answer", "text": "En coche: por el Puerto de Chiunzi (SS373) desde Angri/Nocera, unos 20 min desde la autopista A3. En autobús SITA: desde Amalfi o Maiori (unos 30 min). No hay estación de tren. El coche es el medio más cómodo porque las 13 aldeas están dispersas." }
    },
    {
      "@type": "Question",
      "name": "¿Por qué Tramonti es famosa por la pizza?",
      "acceptedAnswer": { "@type": "Answer", "text": "Tramonti se considera una de las cunas de la pizza napolitana. Muchos pizzeros emigrados de Tramonti han abierto pizzerías en todo el mundo. La tradición local prevé el uso de ingredientes de km cero: tomate local, Fior di Latte de las queserías del territorio y aceite de oliva de las colinas." }
    },
    {
      "@type": "Question",
      "name": "¿Qué vinos se producen en Tramonti?",
      "acceptedAnswer": { "@type": "Answer", "text": "Tramonti es la zona principal de la DOC Costa d'Amalfi subzona Tramonti. Se producen blancos con uvas Falanghina, Biancolella y Pepella, y tintos con Tintore di Tramonti (Piedirosso). Bodegas como Apicella, Reale y Monte di Grazia ofrecen catas con reserva previa." }
    },
    {
      "@type": "Question",
      "name": "¿Merece la pena visitar Tramonti?",
      "acceptedAnswer": { "@type": "Answer", "text": "Absolutamente sí, sobre todo para quienes buscan autenticidad. Sin turismo de masas, precios muy bajos, naturaleza intacta y una gastronomía excepcional. Es la antítesis de la Costa superficial: aquí se vive como hace 50 años." }
    },
    {
      "@type": "Question",
      "name": "¿Qué ver en Tramonti?",
      "acceptedAnswer": { "@type": "Answer", "text": "El Conservatorio de San José (frescos del siglo XVII), las 13 aldeas dispersas con sus iglesias, los viñedos en terrazas donde se produce el vino Costa d'Amalfi DOC, el Puerto de Chiunzi con su vista panorámica y los senderos naturalistas hacia los Monti Lattari." }
    }
  ]
};

const schemas = [touristAttractionSchema, faqSchema];

const fastFacts = [
  { dt: 'Ubicación', dd: 'Interior Costa, SA' },
  { dt: 'Altitud', dd: '300-800 m s.n.m.' },
  { dt: 'Población', dd: '~4.000 habitantes' },
  { dt: 'Aldeas', dd: '13 aldeas dispersas' },
  { dt: 'Desde Amalfi', dd: '30 min (bus/coche)' },
  { dt: 'Acceso coche', dd: 'Puerto de Chiunzi' },
  { dt: 'Especialidades', dd: 'Vino DOC, pizza, Fior di Latte' },
  { dt: 'Mejor época', dd: 'Abr-Oct' },
  { dt: 'Ideal para', dd: 'Enogastronomía, naturaleza' },
];

const tips = [
  'Reserva una cata en bodega: Apicella (la más antigua de la Costa, desde 1870) o Monte di Grazia para el Tintore.',
  'El Puerto de Chiunzi es el punto más alto accesible en coche: la vista sobre el Valle del Sarno y el Vesubio es extraordinaria.',
  'Las pizzerías de Tramonti son las favoritas de los locales de la Costa, no de los turistas: precios bajos y calidad altísima.',
  'En otoño (octubre) se celebra la Sagra della Castagna: productos locales, vino y ambiente auténtico en las aldeas.',
];
---

<BaseLayout
  title="Tramonti 2026: El Pulmon Verde de la Costa Amalfitana"
  description="Guía de Tramonti: vinos Costa d'Amalfi DOC, 13 aldeas auténticas, pizza tradicional, senderos en los Monti Lattari. El interior secreto de la Costa Amalfitana."
  lang={lang}
  breadcrumbs={breadcrumbs}
  schema={schemas}
  pageKey="tramonti"
>

  <!-- Hero -->
  <section class="relative h-[75vh] sm:h-[90vh] flex items-center bg-charcoal overflow-hidden">
    <img src="/images/tramonti-hero.webp" alt="Tramonti, el pulmón verde de la Costa Amalfitana" class="absolute inset-0 w-full h-full object-cover" loading="eager" fetchpriority="high" decoding="sync" referrerpolicy="no-referrer"/>
    <div class="absolute inset-0 bg-gradient-to-b from-black/10 via-black/40 to-black/80 z-10"></div>
    <div class="relative z-20 max-w-editorial mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <p class="text-med-gold text-xs sm:text-sm font-medium uppercase tracking-[0.3em] mb-3">Interior de la Costa Amalfitana</p>
        <h1 class="font-serif text-display text-white mb-4">Tramonti</h1>
        <p class="text-xl text-white/80 leading-relaxed max-w-2xl">
          El pulmón verde de la Costa. Vinos DOC, pizza auténtica y 13 aldeas donde el tiempo se ha detenido.
        </p>
        <div class="flex flex-wrap gap-3 mt-8">
          <a href="#fast-facts" class="px-5 py-2.5 bg-med-gold text-white text-xs sm:text-sm font-semibold rounded-full hover:scale-105 hover:shadow-[0_8px_25px_rgba(212,175,55,0.4)] transition-all duration-300">Datos Rápidos</a>
          <a href="#vinos" class="px-5 py-2.5 bg-white/10 backdrop-blur text-white text-xs sm:text-sm font-medium rounded-full border border-white/20 hover:bg-white/20 transition-colors">Vinos DOC</a>
          <a href="#faq" class="px-5 py-2.5 bg-white/10 backdrop-blur text-white text-xs sm:text-sm font-medium rounded-full border border-white/20 hover:bg-white/20 transition-colors">FAQ</a>
        </div>
      </div>
    </div>
    <Breadcrumbs breadcrumbs={breadcrumbs} />
  </section>

  <section class="max-w-editorial mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="grid lg:grid-cols-[1fr_320px] gap-12">

      <div class="space-y-16">

        <div class="prose-editorial">
          <p class="text-xl leading-relaxed text-charcoal">
            Tramonti es la Costa Amalfitana que no te esperas. Sin mar, sin turistas, sin colas: solo colinas en terrazas, viñedos que desafían la gravedad, 13 aldeas dispersas conectadas por carreteras estrechas y una tradición enogastronómica que rivaliza con cualquier destino gourmet de Italia.
          </p>
          <p class="mt-4 text-slate-600 leading-relaxed">
            El propio nombre cuenta su naturaleza: <em>entre los montes</em>. Accesible desde el <strong>Puerto de Chiunzi</strong> (uno de los pasos más escénicos de Campania), Tramonti es la cuna del vino <strong>Costa d'Amalfi DOC</strong> y de la tradición pizzera que ha conquistado el mundo.
          </p>
        </div>

        <!-- Sabias que -->
        <div class="bg-slate-900 border border-white/10 rounded-[3rem] p-8">
          <p class="text-[10px] uppercase tracking-[0.3em] text-med-gold font-medium mb-4">¿Sabías que?</p>
          <div class="grid sm:grid-cols-3 gap-6">
            <div class="text-center">
              <p class="font-serif text-5xl font-bold text-med-gold">13</p>
              <p class="text-white/60 text-xs italic mt-1">aldeas dispersas, cada una con su iglesia</p>
            </div>
            <div class="text-center">
              <p class="font-serif text-5xl font-bold text-med-gold">1870</p>
              <p class="text-white/60 text-xs italic mt-1">año de fundación de la Cantina Apicella</p>
            </div>
            <div class="text-center">
              <p class="font-serif text-5xl font-bold text-med-gold">DOC</p>
              <p class="text-white/60 text-xs italic mt-1">Costa d'Amalfi subzona Tramonti</p>
            </div>
          </div>
        </div>

        <!-- Vinos -->
        <div id="vinos">
          <h2 class="font-serif text-3xl font-semibold text-slate-900 mb-6">Los Vinos de Tramonti</h2>
          <p class="text-slate-600 text-lg leading-relaxed mb-6">
            Tramonti es el corazón de la producción vinícola de la Costa Amalfitana. Los viñedos en terrazas, orientados al sur entre los 200 y los 600 m de altitud, producen uvas únicas.
          </p>
          <div class="space-y-6">
            <div class="bg-med-gold/10 p-6 rounded-2xl border border-med-gold/20">
              <h3 class="font-bold text-slate-900 mb-2 text-lg">Tintore di Tramonti</h3>
              <p class="text-slate-600 leading-relaxed">La variedad autóctona tinta más importante: produce vinos intensos, tánicos, de color profundo casi negro. Es un clon local del Piedirosso, pero con características únicas debidas a la altitud y al suelo volcánico.</p>
            </div>
            <div class="bg-med-gold/10 p-6 rounded-2xl border border-med-gold/20">
              <h3 class="font-bold text-slate-900 mb-2 text-lg">Blancos y Rosados</h3>
              <p class="text-slate-600 leading-relaxed">Falanghina, Biancolella y la rara Pepella producen blancos frescos y minerales. Los rosados de Piedirosso son perfectos con el pescado. Bodegas a visitar: Apicella, Reale, Monte di Grazia, Tenuta San Francesco.</p>
            </div>
          </div>
        </div>

        <!-- Que ver -->
        <div>
          <h2 class="font-serif text-3xl font-semibold text-slate-900 mb-8">Qué ver en Tramonti</h2>
          <div class="space-y-8">
            {[
              { n: 1, title: 'Conservatorio de San José y Teresa', text: 'El monumento más importante de Tramonti, con frescos del siglo XVII y un órgano histórico. Se encuentra en la aldea de Polvica y es visitable con solicitud previa. Una joya olvidada.' },
              { n: 2, title: 'Las 13 aldeas', text: 'Cada aldea tiene su iglesia, su identidad y sus tradiciones. Las más características: Gete (panorámica), Corsano (con el castillo), Campinola (con la iglesia de San Michele), Polvica (con el Conservatorio).' },
              { n: 3, title: 'Puerto de Chiunzi', text: 'El paso de montaña a 656 m que separa la Costa del Agro Nocerino. La vista sobre el Valle del Sarno, el Vesubio y la llanura campana es espectacular, sobre todo al atardecer.' },
              { n: 4, title: 'Senderos y naturaleza', text: 'Tramonti está atravesada por senderos CAI que conectan las aldeas y llevan hacia los Monti Lattari. Bosques de castaño, avellanos y terrazas: un paisaje agrícola intacto.' },
            ].map(({ n, title, text }) => (
              <div class="grid sm:grid-cols-[auto_1fr] gap-4">
                <div class="w-14 h-14 rounded-[1rem] bg-med-gold/10 flex items-center justify-center flex-shrink-0 text-med-gold font-serif font-bold text-xl">{n}</div>
                <div>
                  <h3 class="font-semibold text-charcoal text-lg mb-1">{title}</h3>
                  <p class="text-slate-600 leading-relaxed">{text}</p>
                </div>
              </div>
            ))}
          </div>
        </div>

        <!-- Consejo Local -->
        <div class="relative overflow-hidden rounded-[3rem] bg-med-blue p-10 md:p-14 text-white shadow-2xl">
          <div class="relative z-10 flex flex-col md:flex-row items-start md:items-center gap-8">
            <div class="w-20 h-20 rounded-2xl bg-white/10 flex items-center justify-center flex-shrink-0 border border-white/20"><svg class="w-10 h-10 text-med-gold" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 3v2.25m6.364.386-1.591 1.591M21 12h-2.25m-.386 6.364-1.591-1.591M12 18.75V21m-4.773-4.227-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0Z"/></svg></div>
            <div>
              <p class="text-med-gold text-xs font-bold uppercase tracking-[0.3em] mb-2">Consejo Local</p>
              <h3 class="font-serif text-2xl font-bold text-white mb-3 tracking-tight">La pizza de Tramonti</h3>
              <p class="text-white/70 leading-relaxed">Tramonti es la patria de los pizzeros: cientos de familias tramontanas gestionan pizzerías en todo el mundo. Las pizzerías locales usan Fior di Latte fresco y tomate del huerto: calidad altísima a precios que en la costa ya no existen.</p>
            </div>
          </div>
          <div class="absolute bottom-0 left-0 translate-y-1/2 -translate-x-1/2 w-80 h-80 bg-med-gold/10 rounded-full blur-3xl pointer-events-none"></div>
        </div>

        <!-- FAQ -->
        <div id="faq">
          <h2 class="font-serif text-3xl font-semibold text-slate-900 mb-8">Preguntas frecuentes sobre Tramonti</h2>
          <div class="space-y-4">
            {faqSchema.mainEntity.map((q) => (
              <details class="group border border-slate-200 rounded-2xl overflow-hidden">
                <summary class="flex items-center justify-between px-6 py-4 cursor-pointer select-none text-charcoal font-medium hover:bg-slate-50 transition-colors">
                  {q.name}
                  <svg class="w-4 h-4 text-slate-400 group-open:rotate-180 transition-transform flex-shrink-0 ml-3" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
                </summary>
                <div class="px-6 pb-5 text-slate-600 leading-relaxed text-xs sm:text-sm border-t border-slate-100 pt-4">
                  {q.acceptedAnswer.text}
                </div>
              </details>
            ))}
          </div>
        </div>

      </div>

      <aside class="space-y-6 lg:sticky lg:top-24 self-start">
        <div id="fast-facts" class="bg-slate-900 text-white rounded-[3rem] p-6">
          <p class="text-[10px] uppercase tracking-[0.3em] text-med-gold font-medium mb-4">Datos Rápidos - Tramonti</p>
          <dl class="space-y-3">
            {fastFacts.map(({ dt, dd }, i) => (
              <>
                <div class="flex justify-between items-start gap-3">
                  <dt class="text-white/40 text-xs sm:text-sm font-light flex-shrink-0">{dt}</dt>
                  <dd class="text-white font-medium text-xs sm:text-sm text-right">{dd}</dd>
                </div>
                {i < fastFacts.length - 1 && <div class="border-t border-white/5"></div>}
              </>
            ))}
          </dl>
        </div>

        <div class="bg-med-cream border border-med-gold/30 rounded-[2rem] p-6">
          <p class="text-[10px] uppercase tracking-[0.3em] text-med-gold font-medium mb-3">Consejos de los expertos</p>
          <ul class="space-y-3">
            {tips.map(tip => (
              <li class="flex items-start gap-2 text-xs sm:text-sm text-charcoal">
                <span class="w-1.5 h-1.5 rounded-full bg-med-gold mt-1.5 flex-shrink-0"></span>
                <span>{tip}</span>
              </li>
            ))}
          </ul>
        </div>

        <div class="bg-white border border-slate-100 rounded-[2rem] p-6 shadow-sm">
          <p class="text-[10px] uppercase tracking-[0.3em] text-slate-400 font-medium mb-3">Explorar la Costa</p>
          <nav class="space-y-1">
            {[
              { href: '/es-es/costa-amalfitana/agerola/', label: 'Agerola' },
              { href: '/es-es/costa-amalfitana/ravello/', label: 'Ravello' },
              { href: '/es-es/costa-amalfitana/maiori/', label: 'Maiori' },
              { href: '/es-es/costa-amalfitana/minori/', label: 'Minori' },
              { href: '/es-es/costa-amalfitana/amalfi/', label: 'Amalfi' },
            ].map(({ href, label }) => (
              <a href={href} class="flex items-center gap-2 px-3 py-2 rounded-xl text-xs sm:text-sm text-charcoal hover:bg-med-blue/5 hover:text-med-blue transition-colors">
                <span class="w-1.5 h-1.5 rounded-full bg-med-blue/30"></span> {label}
              </a>
            ))}
          </nav>
        </div>
      </aside>

    </div>
  </section>

  <CorrelationSlider
    lang="es-es"
    heading="Explora también en la Costa"
    items={[
      { name: 'Agerola',  href: '/es-es/costa-amalfitana/agerola/',  tag: 'Senderismo & Naturaleza', desc: 'Sendero de los Dioses, Fior di Latte y panoramas a 600 m.' },
      { name: 'Ravello',  href: '/es-es/costa-amalfitana/ravello/',  tag: 'Música & Jardines',        desc: 'Villa Rufolo, Villa Cimbrone y el Festival Musical.' },
      { name: 'Maiori',   href: '/es-es/costa-amalfitana/maiori/',   tag: 'Playa & Relax',            desc: 'La playa de arena más larga de la costa: 300 m.' },
      { name: 'Minori',   href: '/es-es/costa-amalfitana/minori/',   tag: 'Sabores & Cultura',        desc: 'Villa romana y scialatielli frescos.' },
      { name: 'Furore',   href: '/es-es/costa-amalfitana/furore/',   tag: 'El pueblo que no existe',  desc: 'El espectacular Fiordo y el pueblo pintado.' },
    ]}
  />

</BaseLayout>
