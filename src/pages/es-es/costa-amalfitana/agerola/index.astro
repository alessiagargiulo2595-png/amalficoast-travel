---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import CorrelationSlider from '../../../../components/CorrelationSlider.astro';
import Breadcrumbs from '../../../../components/Breadcrumbs.astro';

const lang = 'es-es';

const breadcrumbs = [
  { name: 'Inicio', url: '/es-es/' },
  { name: 'Costa Amalfitana', url: '/es-es/costa-amalfitana/' },
  { name: 'Agerola', url: '/es-es/costa-amalfitana/agerola/' },
];

const touristAttractionSchema = {
  "@context": "https://schema.org",
  "@type": "TouristAttraction",
  "name": "Agerola",
  "description": "Agerola es el balcón verde de la Costa Amalfitana, punto de partida del Sendero de los Dioses y tierra natal del Fior di Latte. A 600 m de altitud, ofrece senderismo, aire fresco y panoramas de vértigo.",
  "url": "https://amalficoast-travel.com/es-es/costa-amalfitana/agerola/",
  "touristType": ["Senderismo", "Naturaleza", "Gastronomía", "Panoramas"],
  "address": { "@type": "PostalAddress", "addressLocality": "Agerola", "addressRegion": "Napoli", "addressCountry": "IT", "postalCode": "80051" },
  "geo": { "@type": "GeoCoordinates", "latitude": 40.6383, "longitude": 14.5417 }
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "¿Cómo llegar a Agerola?",
      "acceptedAnswer": { "@type": "Answer", "text": "En autobús SITA desde Amalfi (unos 40 min) o desde Castellammare di Stabia/Gragnano (unos 30 min). En coche desde Nápoles: autopista A3, salida Castellammare di Stabia, luego SS366 hacia Agerola. Aparcamiento disponible en Bomerano y San Lazzaro." }
    },
    {
      "@type": "Question",
      "name": "¿El Sendero de los Dioses parte desde Agerola?",
      "acceptedAnswer": { "@type": "Answer", "text": "Sí, el recorrido clásico parte desde Bomerano (pedanía de Agerola) y llega a Nocelle sobre Positano, unos 7,8 km, 3-4 horas de caminata. El sendero tiene dificultad media. Evitar en días de lluvia o niebla densa." }
    },
    {
      "@type": "Question",
      "name": "¿Qué es el Fior di Latte de Agerola?",
      "acceptedAnswer": { "@type": "Answer", "text": "Es una mozzarella fresca de pasta hilada elaborada con leche de las vacas de Agerola criadas en altura. Tiene un sabor delicado y una textura suave única. Cada quesería de Agerola tiene su propia versión: la mejor manera de probarla es comprarla directamente al productor." }
    },
    {
      "@type": "Question",
      "name": "¿Es Agerola adecuada para familias?",
      "acceptedAnswer": { "@type": "Answer", "text": "Sí, la altitud (600 m) hace el clima fresco incluso en verano. Hay senderos sencillos, parques infantiles, agroturismos con animales y queserías visitables. Es una alternativa perfecta al calor de la costa para pasar un día diferente." }
    },
    {
      "@type": "Question",
      "name": "¿Qué comer en Agerola?",
      "acceptedAnswer": { "@type": "Answer", "text": "El Fior di Latte y los productos lácteos son la especialidad estrella. También hay que probar los fusilli al ragú de conejo, la pizza con Fior di Latte local, los dulces de ricotta y los quesos curados. Los agroturismos ofrecen menús completos a precios contenidos." }
    }
  ]
};

const schemas = [touristAttractionSchema, faqSchema];

const fastFacts = [
  { dt: 'Ubicación', dd: 'Monti Lattari, NA' },
  { dt: 'Altitud', dd: '~600 m s.n.m.' },
  { dt: 'Población', dd: '~7.500 habitantes' },
  { dt: 'Pedanías', dd: 'Bomerano, San Lazzaro, Pianillo' },
  { dt: 'Desde Amalfi', dd: '40 min (bus SITA)' },
  { dt: 'Sendero de los Dioses', dd: 'Salida desde Bomerano' },
  { dt: 'Especialidades', dd: 'Fior di Latte, quesos' },
  { dt: 'Mejor época', dd: 'Abr-Oct (senderismo)' },
  { dt: 'Ideal para', dd: 'Senderismo, familias, foodies' },
];

const tips = [
  'Parte pronto para el Sendero de los Dioses (antes de las 8:00): tendrás el sendero casi para ti solo y la mejor luz para las fotos.',
  'Compra el Fior di Latte directamente en las queserías de San Lazzaro: cuesta menos y lo comes recién hecho, aún tibio.',
  'Si el Sendero de los Dioses te parece demasiado concurrido, prueba el Sendero dei Tre Calli o la ruta hacia la Grotta di Santa Barbara.',
  'En verano Agerola está entre 8 y 10 grados más fresca que la costa: lleva una sudadera ligera incluso en agosto.',
];
---

<BaseLayout
  title="Agerola 2026: Sendero de los Dioses, Fior di Latte y Senderismo"
  description="Guía completa de Agerola: punto de partida del Sendero de los Dioses, tierra del Fior di Latte, senderismo en los Monti Lattari y panoramas sobre la Costa Amalfitana a 600 m de altitud."
  lang={lang}
  breadcrumbs={breadcrumbs}
  schema={schemas}
  pageKey="agerola"
>

  <!-- Hero -->
  <section class="relative h-[75vh] sm:h-[90vh] flex items-center bg-charcoal overflow-hidden">
    <img src="/images/agerola-hero.webp" alt="Agerola, el balcón de la Costa Amalfitana" class="absolute inset-0 w-full h-full object-cover" loading="eager" referrerpolicy="no-referrer"/>
    <div class="absolute inset-0 bg-gradient-to-b from-black/10 via-black/40 to-black/80 z-10"></div>
    <div class="relative z-20 max-w-editorial mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <p class="text-med-gold text-xs sm:text-sm font-medium uppercase tracking-[0.3em] mb-3">Monti Lattari - 600 m s.n.m.</p>
        <h1 class="font-serif text-display text-white mb-4">Agerola</h1>
        <p class="text-xl text-white/80 leading-relaxed max-w-2xl">
          El balcón verde de la Costa. Salida del Sendero de los Dioses, tierra del Fior di Latte y los panoramas más vertiginosos de la región.
        </p>
        <div class="flex flex-wrap gap-3 mt-8">
          <a href="#fast-facts" class="px-5 py-2.5 bg-med-gold text-white text-xs sm:text-sm font-semibold rounded-full hover:scale-105 hover:shadow-[0_8px_25px_rgba(212,175,55,0.4)] transition-all duration-300">Datos Rápidos</a>
          <a href="#sendero-dioses" class="px-5 py-2.5 bg-white/10 backdrop-blur text-white text-xs sm:text-sm font-medium rounded-full border border-white/20 hover:bg-white/20 transition-colors">Sendero de los Dioses</a>
          <a href="#faq" class="px-5 py-2.5 bg-white/10 backdrop-blur text-white text-xs sm:text-sm font-medium rounded-full border border-white/20 hover:bg-white/20 transition-colors">FAQ</a>
        </div>
      </div>
    </div>
    <Breadcrumbs breadcrumbs={breadcrumbs} />
  </section>

  <section class="max-w-editorial mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="grid lg:grid-cols-[1fr_320px] gap-12">

      <div class="space-y-16">

        <div class="prose-editorial">
          <p class="text-xl leading-relaxed text-charcoal">
            Agerola es el secreto mejor guardado de la Costa Amalfitana. A 600 metros de altitud, escondida entre los Monti Lattari, esta comunidad de pastores y agricultores ofrece lo que la costa no puede dar: aire fresco, silencio, senderos espectaculares y una tradición quesera que se remonta a la Edad Media.
          </p>
          <p class="mt-4 text-slate-600 leading-relaxed">
            Desde aquí parte el célebre <strong>Sendero de los Dioses</strong>, uno de los trekking más bellos de Europa. Pero Agerola no es solo el punto de partida de un sendero: es un mundo aparte, hecho de pedanías dispersas (Bomerano, San Lazzaro, Pianillo), queserías artesanales y trattorias donde se come aún con productos del huerto.
          </p>
        </div>

        <!-- Sabias que -->
        <div class="bg-slate-900 border border-white/10 rounded-[3rem] p-8">
          <p class="text-[10px] uppercase tracking-[0.3em] text-med-gold font-medium mb-4">¿Sabías que?</p>
          <div class="grid sm:grid-cols-3 gap-6">
            <div class="text-center">
              <p class="font-serif text-5xl font-bold text-med-gold">7,8 km</p>
              <p class="text-white/60 text-xs italic mt-1">el Sendero de los Dioses, de Bomerano a Nocelle</p>
            </div>
            <div class="text-center">
              <p class="font-serif text-5xl font-bold text-med-gold">600 m</p>
              <p class="text-white/60 text-xs italic mt-1">altitud media, 8-10 grados más fresco que la costa</p>
            </div>
            <div class="text-center">
              <p class="font-serif text-5xl font-bold text-med-gold">S. XII</p>
              <p class="text-white/60 text-xs italic mt-1">tradición quesera documentada</p>
            </div>
          </div>
        </div>

        <!-- Sendero de los Dioses -->
        <div id="sendero-dioses">
          <h2 class="font-serif text-3xl font-semibold text-slate-900 mb-6">El Sendero de los Dioses</h2>
          <p class="text-slate-600 text-lg leading-relaxed mb-6">
            El trekking más famoso de la Costa Amalfitana, un sendero panorámico excavado en la roca de los Monti Lattari a pico sobre el mar.
          </p>
          <div class="bg-white p-6 rounded-2xl border border-slate-100 space-y-4">
            <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
              <div>
                <p class="text-xs text-slate-400 uppercase tracking-wider">Salida</p>
                <p class="font-medium text-charcoal">Bomerano (Agerola)</p>
              </div>
              <div>
                <p class="text-xs text-slate-400 uppercase tracking-wider">Llegada</p>
                <p class="font-medium text-charcoal">Nocelle (Positano)</p>
              </div>
              <div>
                <p class="text-xs text-slate-400 uppercase tracking-wider">Distancia</p>
                <p class="font-medium text-charcoal">~7,8 km</p>
              </div>
              <div>
                <p class="text-xs text-slate-400 uppercase tracking-wider">Duración</p>
                <p class="font-medium text-charcoal">3-4 horas</p>
              </div>
            </div>
            <p class="text-slate-600 text-sm leading-relaxed">
              <strong>Dificultad:</strong> Media. Desnivel en descenso de unos 600 m. Calzado de senderismo obligatorio, bastones recomendados. Llevar al menos 1,5 litros de agua. <strong>No transitable en caso de lluvia o niebla.</strong> Desde Nocelle se baja a Positano con 1.500 escalones o con el autobús local.
            </p>
          </div>
        </div>

        <!-- Que ver -->
        <div>
          <h2 class="font-serif text-3xl font-semibold text-slate-900 mb-8">Qué ver en Agerola</h2>
          <div class="space-y-8">
            {[
              { n: 1, title: 'Bomerano y la salida del Sendero', text: 'La pedanía más conocida, con la pequeña plaza desde donde parte el Sendero de los Dioses. Bar, tiendas de alimentación y el punto de información del Parco dei Monti Lattari. Desde aquí el panorama sobre Capri y la costa es ya espectacular.' },
              { n: 2, title: 'Queserías y Fior di Latte', text: 'El Fior di Latte de Agerola es una mozzarella fresca elaborada con leche de las vacas de Agerola criadas en altura. Varias queserías acogen visitantes para degustaciones. También hay que probar la provola ahumada y la ricotta fresca.' },
              { n: 3, title: 'Sendero dei Tre Calli', text: 'Alternativa menos concurrida al Sendero de los Dioses. Conecta Agerola con Positano a través de un recorrido que atraviesa bosques de castaño y terrazas de limoneros. Más largo (5-6 horas) pero igualmente panorámico.' },
              { n: 4, title: 'Parco Regionale dei Monti Lattari', text: 'Agerola está en el corazón del parque: senderos señalizados, bosques de encina y castaño, cuevas kársticas y una biodiversidad única. El Centro de Visitantes en San Lazzaro facilita mapas e información.' },
              { n: 5, title: 'Grotta di Santa Barbara', text: 'Una cueva kárstica accesible con una excursión de unas 2 horas desde San Lazzaro. En su interior, estalactitas y un ambiente sugestivo. Visita libre, pero se recomienda guía local.' },
            ].map(({ n, title, text }) => (
              <div class="grid sm:grid-cols-[auto_1fr] gap-4">
                <div class="w-14 h-14 rounded-[1rem] bg-med-gold/10 flex items-center justify-center flex-shrink-0 text-med-gold font-serif font-bold text-xl">{n}</div>
                <div>
                  <h3 class="font-semibold text-charcoal text-lg mb-1">{title}</h3>
                  <p class="text-slate-600 leading-relaxed">{text}</p>
                </div>
              </div>
            ))}
          </div>
        </div>

        <!-- Consejo Local -->
        <div class="relative overflow-hidden rounded-[3rem] bg-med-blue p-10 md:p-14 text-white shadow-2xl">
          <div class="relative z-10 flex flex-col md:flex-row items-start md:items-center gap-8">
            <div class="w-20 h-20 rounded-2xl bg-white/10 flex items-center justify-center flex-shrink-0 border border-white/20"><svg class="w-10 h-10 text-med-gold" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 3v2.25m6.364.386-1.591 1.591M21 12h-2.25m-.386 6.364-1.591-1.591M12 18.75V21m-4.773-4.227-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0Z"/></svg></div>
            <div>
              <p class="text-med-gold text-xs font-bold uppercase tracking-[0.3em] mb-2">Consejo Local</p>
              <h3 class="font-serif text-2xl font-bold text-white mb-3 tracking-tight">Fior di Latte de la quesería</h3>
              <p class="text-white/70 leading-relaxed">Para en una quesería de San Lazzaro hacia las 10:00 de la mañana, cuando el Fior di Latte sale aún tibio. Cómpralo, añade un poco de pan local y un tomate: el almuerzo perfecto antes del sendero.</p>
            </div>
          </div>
          <div class="absolute bottom-0 left-0 translate-y-1/2 -translate-x-1/2 w-80 h-80 bg-med-gold/10 rounded-full blur-3xl pointer-events-none"></div>
        </div>

        <!-- FAQ -->
        <div id="faq">
          <h2 class="font-serif text-3xl font-semibold text-slate-900 mb-8">Preguntas frecuentes sobre Agerola</h2>
          <div class="space-y-4">
            {faqSchema.mainEntity.map((q) => (
              <details class="group border border-slate-200 rounded-2xl overflow-hidden">
                <summary class="flex items-center justify-between px-6 py-4 cursor-pointer select-none text-charcoal font-medium hover:bg-slate-50 transition-colors">
                  {q.name}
                  <svg class="w-4 h-4 text-slate-400 group-open:rotate-180 transition-transform flex-shrink-0 ml-3" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
                </summary>
                <div class="px-6 pb-5 text-slate-600 leading-relaxed text-xs sm:text-sm border-t border-slate-100 pt-4">
                  {q.acceptedAnswer.text}
                </div>
              </details>
            ))}
          </div>
        </div>

      </div>

      <aside class="space-y-6 lg:sticky lg:top-24 self-start">
        <div id="fast-facts" class="bg-slate-900 text-white rounded-[3rem] p-6">
          <p class="text-[10px] uppercase tracking-[0.3em] text-med-gold font-medium mb-4">Datos Rápidos - Agerola</p>
          <dl class="space-y-3">
            {fastFacts.map(({ dt, dd }, i) => (
              <>
                <div class="flex justify-between items-start gap-3">
                  <dt class="text-white/40 text-xs sm:text-sm font-light flex-shrink-0">{dt}</dt>
                  <dd class="text-white font-medium text-xs sm:text-sm text-right">{dd}</dd>
                </div>
                {i < fastFacts.length - 1 && <div class="border-t border-white/5"></div>}
              </>
            ))}
          </dl>
        </div>

        <div class="bg-med-cream border border-med-gold/30 rounded-[2rem] p-6">
          <p class="text-[10px] uppercase tracking-[0.3em] text-med-gold font-medium mb-3">Consejos de los expertos</p>
          <ul class="space-y-3">
            {tips.map(tip => (
              <li class="flex items-start gap-2 text-xs sm:text-sm text-charcoal">
                <span class="w-1.5 h-1.5 rounded-full bg-med-gold mt-1.5 flex-shrink-0"></span>
                <span>{tip}</span>
              </li>
            ))}
          </ul>
        </div>

        <div class="bg-white border border-slate-100 rounded-[2rem] p-6 shadow-sm">
          <p class="text-[10px] uppercase tracking-[0.3em] text-slate-400 font-medium mb-3">Explorar la Costa</p>
          <nav class="space-y-1">
            {[
              { href: '/es-es/costa-amalfitana/furore/', label: 'Furore' },
              { href: '/es-es/costa-amalfitana/praiano/', label: 'Praiano' },
              { href: '/es-es/costa-amalfitana/positano/', label: 'Positano' },
              { href: '/es-es/costa-amalfitana/amalfi/', label: 'Amalfi' },
              { href: '/es-es/costa-amalfitana/tramonti/', label: 'Tramonti' },
            ].map(({ href, label }) => (
              <a href={href} class="flex items-center gap-2 px-3 py-2 rounded-xl text-xs sm:text-sm text-charcoal hover:bg-med-blue/5 hover:text-med-blue transition-colors">
                <span class="w-1.5 h-1.5 rounded-full bg-med-blue/30"></span> {label}
              </a>
            ))}
          </nav>
        </div>
      </aside>

    </div>
  </section>

  <CorrelationSlider
    lang="es-es"
    heading="Explora también en la Costa"
    items={[
      { name: 'Furore',   href: '/es-es/costa-amalfitana/furore/',   tag: 'El pueblo que no existe', desc: 'El espectacular Fiordo y el pueblo pintado sin centro.' },
      { name: 'Praiano',  href: '/es-es/costa-amalfitana/praiano/',  tag: 'Atardecer & Calma',       desc: 'El atardecer desde San Gennaro y la tranquila Marina di Praia.' },
      { name: 'Positano', href: '/es-es/costa-amalfitana/positano/', tag: 'Moda & Vistas',            desc: 'Las casas de colores encaramadas en el mar y la playa de Fornillo.' },
      { name: 'Tramonti', href: '/es-es/costa-amalfitana/tramonti/', tag: 'Interior & Vino',          desc: 'El pulmón verde de la Costa, tierra de vinos y tradiciones.' },
      { name: 'Amalfi',   href: '/es-es/costa-amalfitana/amalfi/',   tag: 'República Marítima',       desc: 'La capital histórica con la Catedral y el Museo del Papel.' },
    ]}
  />

</BaseLayout>
