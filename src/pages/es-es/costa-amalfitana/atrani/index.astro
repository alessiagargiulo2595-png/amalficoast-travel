---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../../components/Breadcrumbs.astro';
import CorrelationSlider from '../../../../components/CorrelationSlider.astro';

const lang = 'es-es';

const breadcrumbs = [
  { name: 'Inicio', url: '/es-es/' },
  { name: 'Costa Amalfitana', url: '/es-es/costa-amalfitana/' },
  { name: 'Atrani', url: '/es-es/costa-amalfitana/atrani/' },
];

const touristAttractionSchema = {
  "@context": "https://schema.org",
  "@type": "TouristAttraction",
  "name": "Atrani",
  "description": "Atrani es el municipio mas pequeno de Italia por superficie (0,12 km2), una joya medieval enclavada entre acantilados a solo 700 metros de Amalfi.",
  "url": "https://amalficoast-travel.com/es-es/costa-amalfitana/atrani/",
  "image": "https://amalficoast-travel.com/images/atrani-hero.webp",
  "touristType": ["Autenticidad", "Historia", "Mar", "Fotografia"],
  "address": { "@type": "PostalAddress", "addressLocality": "Atrani", "addressRegion": "Salerno", "addressCountry": "IT", "postalCode": "84010" },
  "geo": { "@type": "GeoCoordinates", "latitude": 40.6364, "longitude": 14.6083 }
};

const placeSchema = {
  "@context": "https://schema.org",
  "@type": "Place",
  "name": "Atrani, Costa Amalfitana",
  "description": "El municipio mas pequeno de Italia, pueblo medieval autentico a 700 m de Amalfi.",
  "geo": { "@type": "GeoCoordinates", "latitude": 40.6364, "longitude": 14.6083 }
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Que distancia hay entre Atrani y Amalfi?",
      "acceptedAnswer": { "@type": "Answer", "text": "Atrani esta a solo 700 metros de Amalfi. Se llega a pie en 10-15 minutos por un tunel peatonal o siguiendo la carretera costera. Son los dos municipios mas cercanos de toda la Costa Amalfitana." }
    },
    {
      "@type": "Question",
      "name": "Como se llega a Atrani?",
      "acceptedAnswer": { "@type": "Answer", "text": "La mejor forma es a pie desde Amalfi (10-15 min). En bus: linea SITA Salerno-Amalfi, parada Atrani. En coche: aparcamiento extremadamente limitado, se recomienda aparcar en Amalfi (parking Luna Rossa) y caminar." }
    },
    {
      "@type": "Question",
      "name": "Por que es famoso Atrani?",
      "acceptedAnswer": { "@type": "Answer", "text": "Atrani es el municipio mas pequeno de Italia por superficie (0,12 km2). Era el lugar donde se coronaban y enterraban los Dogos de la Republica Marinera de Amalfi. Recientemente se hizo famoso como escenario de la serie de Netflix Ripley (2024)." }
    },
    {
      "@type": "Question",
      "name": "Que comer en Atrani?",
      "acceptedAnswer": { "@type": "Answer", "text": "El plato tipico es el sarchiapone: calabacines largos rellenos de carne picada, provola ahumada, huevos y pan duro, cocinados en salsa de tomate. Tambien hay que probar el pescado fresco en los restaurantes de la plaza." }
    },
    {
      "@type": "Question",
      "name": "Se puede nadar en Atrani?",
      "acceptedAnswer": { "@type": "Answer", "text": "Si, Atrani tiene una pequena playa de arena y guijarros directamente en la plaza del pueblo. Es una de las pocas playas libres de la Costa. Mar limpio y ambiente autentico, mucho menos concurrida que Amalfi." }
    }
  ]
};
---

<BaseLayout
  title="Atrani: El Pueblo Mas Pequeno de Italia en la Costa Amalfitana"
  description="Guia de Atrani, el municipio mas pequeno de Italia a 700 m de Amalfi. Plaza junto al mar, historia de los Dogos, escenario de Ripley Netflix, playa y sarchiapone."
  lang={lang}
  breadcrumbs={breadcrumbs}
  schema={[touristAttractionSchema, placeSchema, faqSchema]}
  pageKey="atrani"

  heroImage="/images/atrani-hero.webp"
>

  <section class="relative h-[52.5vh] sm:h-[70vh] flex items-end bg-charcoal overflow-hidden">
    <img src="/images/atrani-hero.webp" alt="Atrani, el pueblo mas pequeno de Italia en la Costa Amalfitana" class="absolute inset-0 w-full h-full object-cover" loading="eager" fetchpriority="high" decoding="sync" referrerpolicy="no-referrer"/>
    <div class="absolute inset-0 bg-gradient-to-b from-black/75 via-black/40 to-black/70"></div>
    <div class="relative z-10 max-w-7xl mx-auto px-6 pb-16 pt-32 w-full">
      <div class="max-w-3xl">
        <p class="text-med-gold text-xs sm:text-sm font-medium uppercase tracking-[0.3em] mb-3">Costa Amalfitana</p>
        <h1 class="font-serif text-display text-white mb-4">Atrani</h1>
        <p class="text-xl text-white/80 leading-relaxed">El pueblo mas pequeno de Italia. A 700 metros de Amalfi, otro mundo.</p>
        <div class="flex flex-wrap gap-3 mt-8">
          <a href="#fast-facts" class="px-5 py-2.5 bg-med-gold text-white text-xs sm:text-sm font-semibold rounded-full hover:scale-105 hover:shadow-[0_8px_25px_rgba(212,175,55,0.4)] transition-all duration-300">Datos Rapidos</a>
          <a href="#que-ver" class="px-5 py-2.5 bg-white/10 backdrop-blur text-white text-xs sm:text-sm font-medium rounded-full border border-white/20 hover:bg-white/20 transition-colors">Que Ver</a>
          <a href="#faq" class="px-5 py-2.5 bg-white/10 backdrop-blur text-white text-xs sm:text-sm font-medium rounded-full border border-white/20 hover:bg-white/20 transition-colors">FAQ</a>
        </div>
      </div>
    </div>
    <Breadcrumbs breadcrumbs={breadcrumbs} />
  </section>

  <section class="bg-med-cream py-24 px-6">
    <div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-3 gap-16">
      <div class="lg:col-span-2 space-y-12">

        <div>
          <h2 class="font-serif text-4xl font-bold text-slate-900 mb-6">El Secreto Mejor Guardado de la Costa</h2>
          <p class="text-slate-600 text-lg leading-relaxed mb-4">
            <strong>Atrani</strong> es el <strong>municipio mas pequeno de Italia</strong> por superficie: apenas 0,12 km&sup2; de callejuelas, escaleras y arcos medievales enclavados entre dos acantilados sobre el mar. A solo 700 metros de Amalfi, pero un mundo completamente diferente.
          </p>
          <p class="text-slate-600 text-lg leading-relaxed">
            Aqui no hay boutiques de lujo ni restaurantes para turistas. Hay una placita donde los ninos juegan al futbol, una pequena playa libre y el sonido del agua entre las casas. Quien llega a Atrani descubre la Costa Amalfitana como era antes del turismo de masas.
          </p>
        </div>

        <div class="bg-slate-900 border border-white/10 rounded-[3rem] p-8">
          <p class="text-[10px] uppercase tracking-[0.3em] text-med-gold font-medium mb-4">Sabias que?</p>
          <div class="grid sm:grid-cols-3 gap-6">
            <div class="text-center">
              <p class="font-serif text-5xl font-bold text-med-gold">0,12</p>
              <p class="text-white/60 text-xs italic mt-1">km&sup2; de superficie total</p>
            </div>
            <div class="text-center">
              <p class="font-serif text-5xl font-bold text-med-gold">839</p>
              <p class="text-white/60 text-xs italic mt-1">habitantes (un pueblo vivo)</p>
            </div>
            <div class="text-center">
              <p class="font-serif text-5xl font-bold text-med-gold">700</p>
              <p class="text-white/60 text-xs italic mt-1">metros a pie desde Amalfi</p>
            </div>
          </div>
          <p class="text-white/40 text-xs mt-6 italic">En la Edad Media, Atrani era el lugar donde se coronaban los Dogos de la Republica Marinera de Amalfi. La Colegiata de San Salvatore de' Birecto conserva todavia la losa de porfido donde se celebraba la ceremonia.</p>
        </div>

        <div id="que-ver">
          <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">Que Ver en Atrani</h2>
          <div class="space-y-8">
            <div>
              <h3 class="text-xl font-bold text-slate-900 mb-3">Piazza Umberto I</h3>
              <p class="text-slate-600 leading-relaxed">El corazon del pueblo. Una de las pocas plazas de la Costa que da directamente al mar, con bares, restaurantes y la vida cotidiana de los habitantes. Aqui se celebra la Fiesta de Santa Maria Magdalena (22 de julio).</p>
            </div>
            <div>
              <h3 class="text-xl font-bold text-slate-900 mb-3">Colegiata de San Salvatore de' Birecto</h3>
              <p class="text-slate-600 leading-relaxed">Fundada en el siglo X, custodia la <strong>losa de porfido</strong> sobre la que se coronaban los Dogos de Amalfi. La puerta de bronce es una copia de la de Constantinopla. Un pedazo de historia de la Republica Marinera.</p>
            </div>
            <div>
              <h3 class="text-xl font-bold text-slate-900 mb-3">Iglesia de Santa Maria Magdalena</h3>
              <p class="text-slate-600 leading-relaxed">La cupula de mayolica y el campanario dominan el perfil de Atrani desde la costa. El interior barroco alberga un crucifijo de madera del siglo XIII. La fiesta del 22 de julio es una de las mas sentidas de la Costa.</p>
            </div>
            <div>
              <h3 class="text-xl font-bold text-slate-900 mb-3">Gruta de Masaniello</h3>
              <p class="text-slate-600 leading-relaxed">La leyenda cuenta que Masaniello, el celebre revolucionario napolitano, se escondio en una cueva sobre Atrani durante la revuelta de 1647. El sendero que lleva a la gruta ofrece vistas espectaculares de la costa.</p>
            </div>
          </div>
        </div>

        <div>
          <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">La Playa de Atrani</h2>
          <p class="text-slate-600 text-lg leading-relaxed mb-6">La pequena playa de Atrani es uno de los secretos mejor guardados de la Costa. Arena y guijarros, mar limpio y un ambiente que recuerda mas a un pueblo de pescadores que a un destino turistico.</p>
          <div class="bg-white p-6 rounded-2xl border border-slate-100">
            <h3 class="font-bold text-slate-900 mb-2">Playa de la Piazzetta</h3>
            <p class="text-slate-600 text-sm">Directamente bajo la Piazza Umberto I. Playa libre, sin chiringuitos. Aguas profundas y limpias. Mucho menos concurrida que la Spiaggia Grande de Amalfi, que esta a solo 15 minutos a pie.</p>
          </div>
        </div>

        <div>
          <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">Atrani y Ripley: El Escenario de Netflix</h2>
          <p class="text-slate-600 text-lg leading-relaxed">En 2024 la serie de Netflix <strong>Ripley</strong>, con Andrew Scott, utilizo Atrani como escenario principal para las escenas ambientadas en la ficticia ciudad costera. La plaza, las escaleras y los callejones del pueblo fueron filmados en blanco y negro, devolviendo la atmosfera suspendida y misteriosa de la novela de Patricia Highsmith.</p>
        </div>

        <div>
          <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">Que Comer en Atrani</h2>
          <div class="space-y-6">
            <div class="bg-med-gold/10 p-6 rounded-2xl border border-med-gold/20">
              <h3 class="font-bold text-slate-900 mb-2 text-lg">Sarchiapone</h3>
              <p class="text-slate-600 leading-relaxed">El plato tipico de Atrani: calabacines largos rellenos de carne picada, provola ahumada, huevos y pan duro, cocinados en salsa de tomate. Un comfort food de la tradicion amalfitana.</p>
            </div>
            <div class="bg-med-gold/10 p-6 rounded-2xl border border-med-gold/20">
              <h3 class="font-bold text-slate-900 mb-2 text-lg">Pescado Fresco en la Piazzetta</h3>
              <p class="text-slate-600 leading-relaxed">Los restaurantes de la plaza ofrecen pescado del dia a precios mas honestos que Amalfi. Fritura mixta, espaguetis con mariscos y anchoas marinadas son las especialidades.</p>
            </div>
          </div>
        </div>

        <div id="faq">
          <h2 class="font-serif text-3xl font-semibold text-slate-900 mb-8">Preguntas frecuentes sobre Atrani</h2>
          <div class="space-y-4">
            {faqSchema.mainEntity.map((q) => (
              <details class="group border border-slate-200 rounded-2xl overflow-hidden">
                <summary class="flex items-center justify-between px-6 py-4 cursor-pointer select-none text-charcoal font-medium hover:bg-slate-50 transition-colors">
                  {q.name}
                  <svg class="w-4 h-4 text-slate-400 group-open:rotate-180 transition-transform flex-shrink-0 ml-3" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
                </summary>
                <div class="px-6 pb-5 text-slate-600 leading-relaxed text-xs sm:text-sm border-t border-slate-100 pt-4">{q.acceptedAnswer.text}</div>
              </details>
            ))}
          </div>
        </div>

        <div>
          <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">Como Llegar</h2>
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
            <div class="bg-white p-6 rounded-[2rem] border border-slate-100 shadow-sm">
              <p class="text-med-gold text-xs font-bold uppercase tracking-wider mb-2">A Pie desde Amalfi</p>
              <p class="text-slate-700 font-medium mb-1">10-15 minutos</p>
              <p class="text-slate-500 text-xs sm:text-sm">Tunel peatonal o paseo por la costa. La forma mas comoda y bonita.</p>
            </div>
            <div class="bg-white p-6 rounded-[2rem] border border-slate-100 shadow-sm">
              <p class="text-med-gold text-xs font-bold uppercase tracking-wider mb-2">Bus SITA</p>
              <p class="text-slate-700 font-medium mb-1">Parada Atrani</p>
              <p class="text-slate-500 text-xs sm:text-sm">Linea Salerno-Amalfi. Parada dedicada en la SS163.</p>
            </div>
            <div class="bg-white p-6 rounded-[2rem] border border-slate-100 shadow-sm">
              <p class="text-med-gold text-xs font-bold uppercase tracking-wider mb-2">En Coche</p>
              <p class="text-slate-700 font-medium mb-1">Aparcamiento limitado</p>
              <p class="text-slate-500 text-xs sm:text-sm">Poquisimas plazas. Mejor aparcar en Amalfi (Luna Rossa) y caminar.</p>
            </div>
          </div>
        </div>

      </div>

      <aside class="space-y-6 lg:sticky lg:top-24 self-start">
        <div id="fast-facts" class="bg-slate-900 text-white rounded-[3rem] p-6">
          <p class="text-[10px] uppercase tracking-[0.3em] text-med-gold font-medium mb-4">Datos Rapidos - Atrani</p>
          <dl class="space-y-3">
            <div class="flex justify-between items-start gap-3"><dt class="text-white/40 text-xs sm:text-sm font-light flex-shrink-0">Ubicacion</dt><dd class="text-white font-medium text-xs sm:text-sm text-right">700 m de Amalfi<br/>25 km de Salerno</dd></div>
            <div class="border-t border-white/5"></div>
            <div class="flex justify-between items-start gap-3"><dt class="text-white/40 text-xs sm:text-sm font-light flex-shrink-0">Superficie</dt><dd class="text-white font-medium text-xs sm:text-sm text-right">0,12 km&sup2;<br/>El mas pequeno de Italia</dd></div>
            <div class="border-t border-white/5"></div>
            <div class="flex justify-between items-start gap-3"><dt class="text-white/40 text-xs sm:text-sm font-light flex-shrink-0">Habitantes</dt><dd class="text-white font-medium text-xs sm:text-sm text-right">Aprox. 839</dd></div>
            <div class="border-t border-white/5"></div>
            <div class="flex justify-between items-start gap-3"><dt class="text-white/40 text-xs sm:text-sm font-light flex-shrink-0">Plato Tipico</dt><dd class="text-white font-medium text-xs sm:text-sm text-right">Sarchiapone</dd></div>
            <div class="border-t border-white/5"></div>
            <div class="flex justify-between items-start gap-3"><dt class="text-white/40 text-xs sm:text-sm font-light flex-shrink-0">Fiesta Patronal</dt><dd class="text-white font-medium text-xs sm:text-sm text-right">22 Julio<br/>S. Maria Magdalena</dd></div>
            <div class="border-t border-white/5"></div>
            <div class="flex justify-between items-start gap-3"><dt class="text-white/40 text-xs sm:text-sm font-light flex-shrink-0">Curiosidad</dt><dd class="text-white font-medium text-xs sm:text-sm text-right">Escenario de Ripley<br/>(Netflix, 2024)</dd></div>
            <div class="border-t border-white/5"></div>
            <div class="flex justify-between items-start gap-3"><dt class="text-white/40 text-xs sm:text-sm font-light flex-shrink-0">Ideal Para</dt><dd class="text-white font-medium text-xs sm:text-sm text-right">Autenticidad<br/>Fotografia<br/>Tranquilidad</dd></div>
          </dl>
          <div class="mt-10 pt-8 border-t border-white/10">
            <a href="/es-es/costa-amalfitana/" class="inline-flex items-center gap-2 text-med-gold text-xs sm:text-sm font-medium hover:text-white transition-colors">← Volver a Costa Amalfitana</a>
          </div>
        </div>
      </aside>

    </div>
  </section>

  <CorrelationSlider
    heading="Explora la Costa"
    items={[
      { name: 'Amalfi', href: '/es-es/costa-amalfitana/amalfi/', tag: 'Republica Marinera', desc: 'A solo 700 m de Atrani: la Catedral, el Museo del Papel y el puerto.' },
      { name: 'Ravello', href: '/es-es/costa-amalfitana/ravello/', tag: 'Musica & Jardines', desc: 'Villa Rufolo, Villa Cimbrone y el Festival Musical a 350 m.' },
      { name: 'Positano', href: '/es-es/costa-amalfitana/positano/', tag: 'Moda & Vistas', desc: 'Las casas coloridas sobre el mar y la playa Fornillo.' },
      { name: 'Minori', href: '/es-es/costa-amalfitana/minori/', tag: 'Sabores & Cultura', desc: 'Villa romana del siglo I, scialatielli frescos y pastelerias.' },
      { name: 'Cetara', href: '/es-es/costa-amalfitana/cetara/', tag: 'Gastronomia', desc: 'El pueblo de pescadores y la colatura di alici DOP.' },
      { name: 'Praiano', href: '/es-es/costa-amalfitana/praiano/', tag: 'Atardecer & Calma', desc: 'El atardecer desde San Gennaro y la silenciosa Marina di Praia.' },
    ]}
    lang="es-es"
  />

</BaseLayout>
