---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { getTranslations, getLocalePath } from '../../i18n/translations';

const lang = 'en-us';
const breadcrumbs = [
  { name: 'Home', url: '/en-us/' },
  { name: 'Planning', url: '/en-us/planning/' },
  { name: 'Itineraries', url: '/en-us/itineraries/' },
];
const t = getTranslations(lang);

// Card data organized by duration
const itineraries = {
  d1: [
    { title: 'Amalfi Coast from Naples', desc: 'Ferry from Naples: Amalfi, Ravello and Positano with sunset at sea.', img: '/images/costiera-hero.jpg', href: '/en-us/itineraries/1-day/amalfi-coast-from-naples/', tag: '1 day' },
    { title: 'Amalfi Coast from Salerno', desc: 'Depart from Salerno: fewer crowds, more peace. Perfect in summer with evening return.', img: '/images/costiera-hero.jpg', href: '/en-us/itineraries/1-day/amalfi-coast-from-salerno/', tag: '1 day' },
    { title: 'Sorrentine Peninsula', desc: 'Sorrento, Massa Lubrense and Marina del Cantone in one day from Naples.', img: '/images/sorrento-hero.jpg', href: '/en-us/itineraries/1-day/sorrentine-peninsula-from-naples/', tag: '1 day' },
    { title: 'Path of the Gods Trek', desc: '7.8 km of breathtaking views from Bomerano to Nocelle above Positano.', img: '/images/trekking-hero.jpg', href: '/en-us/itineraries/1-day/path-of-the-gods-trek/', tag: '1 day' },
    { title: 'Capri from Sorrento', desc: 'Blue Grotto, Faraglioni, Villa Jovis: essential Capri in one day.', img: '/images/capri-hero.jpg', href: '/en-us/itineraries/1-day/capri-from-sorrento/', tag: '1 day' },
  ],
  d3: [
    { title: 'Classic Amalfi Coast', desc: 'Amalfi, Positano, Ravello and Cetara: the best of the coast in 3 days.', img: '/images/costiera-hero.jpg', href: '/en-us/itineraries/3-days/classic-amalfi-coast/', tag: '3 days' },
    { title: 'Islands: Ischia & Procida', desc: 'Two islands in the Bay of Naples with beaches, thermal springs and pastel colours.', img: '/images/ischia-hero.jpg', href: '/en-us/itineraries/3-days/islands-ischia-procida/', tag: '3 days' },
    { title: 'Sorrento, Pompeii & History', desc: 'Art, history and sea: Sorrento, Pompeii and the Peninsula in 3 days.', img: '/images/sorrento-hero.jpg', href: '/en-us/itineraries/3-days/sorrento-pompeii-history/', tag: '3 days' },
  ],
  d7: [
    { title: 'Grand Tour Coast & Peninsula', desc: 'One complete week: coast, peninsula, islands and hidden villages.', img: '/images/costiera-hero.jpg', href: '/en-us/itineraries/7-days/grand-tour-coast-peninsula/', tag: '7 days' },
    { title: 'Slow Travel: Villages & Food', desc: 'No rush. Markets, trattorias, trails and sunsets in slow travel.', img: '/images/atrani-hero.jpg', href: '/en-us/itineraries/7-days/slow-travel-villages-food/', tag: '7 days' },
  ],
};
---

<BaseLayout
  title={t.meta.itineraries_title}
  description={t.meta.itineraries_description}
  lang={lang}
  pageKey="itineraries"
>
  <!-- Hero -->
  <section class="relative bg-charcoal text-white py-20 overflow-hidden">
    <img src="/images/itinerari-hero.jpg" alt="Amalfi Coast itineraries" class="absolute inset-0 w-full h-full object-cover opacity-20" loading="eager" referrerpolicy="no-referrer"/>
    <div class="absolute inset-0 bg-charcoal/80"></div>
    <div class="relative z-10 max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <p class="text-white/80 text-xs sm:text-sm uppercase tracking-[0.3em] mb-3">Plan your trip</p>
      <h1 class="text-4xl md:text-5xl font-bold font-serif mb-4">Amalfi Coast Itineraries</h1>
      <p class="text-white/80 text-lg max-w-2xl mx-auto">1 day, 3 days or 1 week: detailed itineraries to make the most of the Amalfi Coast however much time you have.</p>
    </div>
    <Breadcrumbs breadcrumbs={breadcrumbs} />
  </section>

  <!-- Intro -->
  <section class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <p class="text-lg text-slate-600 leading-relaxed">
      The Amalfi Coast offers different experiences depending on how much time you have. One day for the highlights, three days to discover villages and local rhythms, a week to go beyond the postcard. Choose the itinerary that suits you.
    </p>
  </section>

  <!-- 1 Day -->
  <section class="py-12 border-t border-slate-100">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center gap-4 mb-10">
        <span class="inline-block bg-med-blue/80 text-white text-xs font-bold uppercase tracking-wider px-3 py-1.5 rounded-full">1 day</span>
        <h2 class="text-3xl font-bold font-serif text-charcoal">The best of the coast</h2>
        <div class="flex-1 h-px bg-slate-100"></div>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {itineraries.d1.map((it) => (
          <a href={it.href} class="group block bg-white rounded-2xl border border-slate-100 overflow-hidden hover:shadow-lg hover:border-med-blue/20 transition-all duration-300">
            <!-- Image with overlay -->
            <div class="relative h-44 overflow-hidden">
              <img src={it.img} alt={it.title} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
              <div class="absolute inset-0 bg-gradient-to-t from-black/50 to-transparent" />
              <!-- Duration badge -->
              <span class="absolute bottom-3 left-3 text-[10px] font-bold uppercase tracking-wider text-white bg-med-blue/80 backdrop-blur-sm px-2.5 py-1 rounded-full">
                {it.tag}
              </span>
            </div>
            <!-- Text section -->
            <div class="p-5">
              <h3 class="font-semibold text-charcoal text-sm mb-1.5 group-hover:text-med-blue transition-colors">{it.title}</h3>
              <p class="text-xs text-slate-500 leading-relaxed">{it.desc}</p>
              <span class="mt-3 inline-flex items-center text-xs font-semibold text-med-blue gap-1 group-hover:gap-2 transition-all">
                Explore itinerary →
              </span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- 3 Days -->
  <section class="py-12 border-t border-slate-100">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center gap-4 mb-10">
        <span class="inline-block bg-med-gold/90 text-white text-xs font-bold uppercase tracking-wider px-3 py-1.5 rounded-full">3 days</span>
        <h2 class="text-3xl font-bold font-serif text-charcoal">Perfect pace between discoveries</h2>
        <div class="flex-1 h-px bg-slate-100"></div>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {itineraries.d3.map((it) => (
          <a href={it.href} class="group block bg-white rounded-2xl border border-slate-100 overflow-hidden hover:shadow-lg hover:border-med-gold/20 transition-all duration-300">
            <!-- Image with overlay -->
            <div class="relative h-44 overflow-hidden">
              <img src={it.img} alt={it.title} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
              <div class="absolute inset-0 bg-gradient-to-t from-black/50 to-transparent" />
              <!-- Duration badge -->
              <span class="absolute bottom-3 left-3 text-[10px] font-bold uppercase tracking-wider text-white bg-med-gold/90 backdrop-blur-sm px-2.5 py-1 rounded-full">
                {it.tag}
              </span>
            </div>
            <!-- Text section -->
            <div class="p-5">
              <h3 class="font-semibold text-charcoal text-sm mb-1.5 group-hover:text-med-gold transition-colors">{it.title}</h3>
              <p class="text-xs text-slate-500 leading-relaxed">{it.desc}</p>
              <span class="mt-3 inline-flex items-center text-xs font-semibold text-med-gold gap-1 group-hover:gap-2 transition-all">
                Explore itinerary →
              </span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- 7 Days -->
  <section class="py-12 border-t border-slate-100">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center gap-4 mb-10">
        <span class="inline-block bg-med-terracotta/80 text-white text-xs font-bold uppercase tracking-wider px-3 py-1.5 rounded-full">7 days</span>
        <h2 class="text-3xl font-bold font-serif text-charcoal">Slow travel without rush</h2>
        <div class="flex-1 h-px bg-slate-100"></div>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 max-w-2xl">
        {itineraries.d7.map((it) => (
          <a href={it.href} class="group block bg-white rounded-2xl border border-slate-100 overflow-hidden hover:shadow-lg hover:border-med-terracotta/20 transition-all duration-300">
            <!-- Image with overlay -->
            <div class="relative h-44 overflow-hidden">
              <img src={it.img} alt={it.title} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
              <div class="absolute inset-0 bg-gradient-to-t from-black/50 to-transparent" />
              <!-- Duration badge -->
              <span class="absolute bottom-3 left-3 text-[10px] font-bold uppercase tracking-wider text-white bg-med-terracotta/80 backdrop-blur-sm px-2.5 py-1 rounded-full">
                {it.tag}
              </span>
            </div>
            <!-- Text section -->
            <div class="p-5">
              <h3 class="font-semibold text-charcoal text-sm mb-1.5 group-hover:text-med-terracotta transition-colors">{it.title}</h3>
              <p class="text-xs text-slate-500 leading-relaxed">{it.desc}</p>
              <span class="mt-3 inline-flex items-center text-xs font-semibold text-med-terracotta gap-1 group-hover:gap-2 transition-all">
                Explore itinerary →
              </span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="bg-med-blue py-16 text-center">
    <div class="max-w-2xl mx-auto px-4">
      <h2 class="text-2xl font-bold text-white mb-4">How do I get to the coast?</h2>
      <p class="text-white mb-6">All the options: train, ferry, bus and private transfers.</p>
      <a href={getLocalePath(lang, 'getting-here')}
        class="inline-block bg-med-blue text-white font-semibold px-8 py-3 rounded-full hover:bg-med-blue transition-colors">
        Transport guide
      </a>
    </div>
  </section>
</BaseLayout>
