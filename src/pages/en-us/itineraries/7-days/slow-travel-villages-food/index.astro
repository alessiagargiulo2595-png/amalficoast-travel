---
import BaseLayout from '../../../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../../../components/Breadcrumbs.astro';

const lang = 'en-us';

const breadcrumbs = [
  { name: 'Home', url: '/en-us/' },
  { name: 'Planning', url: '/en-us/planning/' },
  { name: 'Slow Travel - 7 days', url: '/en-us/itineraries/7-days/slow-travel-villages-food/' },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What is slow travel on the Amalfi Coast?",
      "acceptedAnswer": { "@type": "Answer", "text": "Slow travel on the Coast means staying more days in the same village instead of moving every day, eating in local restaurants (not tourist ones), walking lesser-known trails, going to the market, buying local products (lemons, anchovies, Ravello red wine). It is the opposite of the all-inclusive itinerary." }
    },
    {
      "@type": "Question",
      "name": "Which are the least touristy villages on the Amalfi Coast?",
      "acceptedAnswer": { "@type": "Answer", "text": "The least visited villages are: Praiano (between Positano and Amalfi, no ZTL, quiet beach), Cetara (famous for anchovy sauce, authentic), Furore (the village that doesn't exist, built in the gorge), Conca dei Marini (300 inhabitants, near the Emerald Grotto). All reachable by SITA bus on the SS163." }
    }
  ]
};

const days = [
  { day: 'Day 1', title: 'Arrival in Praiano', highlight: 'Gavitella Beach and local trattoria', items: ['Praiano: the central village with no ZTL. Fewer tourists than Positano, lower prices. Base here or in Amalfi.', 'Gavitella Beach: small, beautiful, accessible on foot. Sunbathe and relax after travel.', 'Dinner in one of the harbour trattorias: fish of the day, local white wine.', 'Local tip: Praiano has limited parking. Arrive early or use public car parks at the edge of the village.'] },
  { day: 'Day 2', title: 'Path of the Gods Trek', highlight: 'Legendary Agerola to Nocelle hike', items: ['Early start. SITA bus to Amalfi, then to Agerola (trail start, 45 min, ~€1.50).', 'Path of the Gods (Agerola→Nocelle, 8 km, 3–4h, demanding EE grade). Terraced vineyards, breathtaking views, 500 m descent.', 'Lunch at a rifugio in Nocelle with panorama over the gulf.', 'Descent to Positano by local bus (15 min) or on foot (45 min, 1,000 steps).', 'Return to Praiano via SITA bus.', 'Local tip: Book the Path of the Gods in July–August (mandatory booking, ~€5). Bring 1.5+ litres of water, hiking boots, no shops on the trail.'] },
  { day: 'Day 3', title: 'Amalfi and Furore', highlight: 'Market, Paper Museum, Fiordo', items: ['SITA bus to Amalfi. Morning: Thursday or Saturday market (local produce, mozzarella, lemons, honey).', 'Amalfi Paper Museum: handmade paper produced since the 13th century (entry ~€5).', 'Furore: the Fiordo di Furore, request stop on the SITA bus. The village built inside the gorge, hidden from the sea.', 'Aperitivo at the harbour. Fresh pasta and anchovies.', 'Local tip: Amalfi market (Tues & Thurs early morning) is the best for local products. Go early, it closes by noon.'] },
  { day: 'Day 4', title: 'Ravello and Scala', highlight: 'Vineyard trek and red wine tasting', items: ['Early start. Bus to Ravello (25 min from Amalfi). Quiet morning with no crowds at 09:00.', 'Ravello→Scala trail: 4 km through olive groves and vineyards, panoramic views over the gulf (1.5h).', 'Lunch in Scala (tiny village, traditional antipasti, pasta, wine).', 'Afternoon: visit to a local wine producer. Ravello red wine tasting (light, fragrant reds from altitude vineyards).', 'Return to base by bus or on foot (steep descent, 1.5h, 800 steps).', 'Local tip: Ravello has no beaches but is the finest viewpoint on the Coast. Ask for wine producers who offer tastings (many do).'] },
  { day: 'Day 5', title: 'Cetara and Vietri', highlight: 'Anchovy tasting and ceramics tour', items: ['SITA bus east to Cetara (famous for its DOP anchovy sauce, colatura). Fish market by the harbour.', 'Visit the Anchovy Sauce Museum. Tasting of colatura di alici. Buy directly from local producers.', 'Lunch in a simple trattoria: pasta with anchovy sauce, grilled fish, local white wine.', 'Vietri sul Mare: ceramics capital of Campania. Browse ceramic workshops and the Ceramics Museum (entry ~€4).', 'Walk along the seafront. Dinner with a view.', 'Local tip: Vietri ceramics are handpainted and unique. Small workshops are cheaper than tourist shops. Ask locals.'] },
  { day: 'Day 6', title: 'Valle delle Ferriere', highlight: 'Waterfall hike and hidden coves', items: ['Morning: Valle delle Ferriere hike from Amalfi (7 km return, 3h, easy–moderate). Subtropical ferns, waterfalls, river canyon.', 'Swim in the emerald pools (bring a swimsuit and towel).', 'Afternoon: kayak tour from Amalfi harbour (optional, ~€60 p.p.) along hidden coves, caves, sea stacks.', 'Fresh fish dinner in Amalfi: catch of the day, pasta ai frutti di mare.', 'Local tip: Valle delle Ferriere: wear water shoes (slippery rocks), bring a light waterproof jacket (spray from waterfalls).'] },
  { day: 'Day 7', title: 'Market and Departure', highlight: 'Local products and farewell lunch', items: ['Free morning at the local market. Buy typical products: artisan limoncello, anchovies in glass jars, Vietri ceramics, honey.', 'Lunch in a family-run trattoria with the owner. Farewells.', 'Pack and prepare for departure.', 'SITA bus to Salerno (60 min from Amalfi) or Sorrento (90 min) to reach trains or airport.', 'Local tip: Limoncello and anchovy sauce travel well. Ceramics are fragile: ask the seller for proper packing or buy them at the airport.'] },
];
---

<BaseLayout
  title="Slow Travel Amalfi Coast 7 Days 2026 | Villages, Food and Trails"
  description="7-day slow travel itinerary on the Amalfi Coast: Praiano, Furore, Cetara, Valle delle Ferriere and Path of the Gods. Authentic villages, local markets and food."
  lang={lang}
  breadcrumbs={breadcrumbs}
  schema={[faqSchema]}
 pageKey="slow-travel-villages-food">

  <section class="relative bg-charcoal overflow-hidden">
    <img src="/images/costiera-hero.jpg" alt="Slow travel Amalfi Coast" class="absolute inset-0 w-full h-full object-cover" loading="eager" referrerpolicy="no-referrer"/>

    <div class="absolute inset-0 bg-gradient-to-b from-black/75 via-black/40 to-black/70"></div>
    <div class="relative z-10 max-w-7xl mx-auto px-6">
      <div class="max-w-3xl">
        <p class="text-med-gold text-xs sm:text-sm font-medium uppercase tracking-[0.3em] mb-3">Itinerary · 7 days</p>
        <h1 class="font-serif text-display text-white mb-4">Slow Travel: Villages & Food</h1>
        <p class="text-xl text-white/80 leading-relaxed max-w-2xl">
          Seven days of slow travel: villages, local food, Amalfi wines and peaceful nights.
        </p>
      </div>
    </div>
    <Breadcrumbs breadcrumbs={breadcrumbs} />
  </section>

  <div class="max-w-editorial mx-auto px-4 sm:px-6 lg:px-8 pt-6 pb-10 space-y-10">

    <!-- Intro Section -->
    <section class="text-center mb-2">
      <!-- Quick Stats Grid -->
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 mb-6">
        <div class="bg-slate-900 rounded-2xl p-6 hover:shadow-md transition-shadow flex flex-col items-center justify-center aspect-square">
          <svg class="w-8 h-8 text-med-gold mb-3" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
            <rect x="3" y="4" width="18" height="18" rx="2"/>
            <path d="M16 2v4M8 2v4M3 10h18"/>
          </svg>
          <p class="text-xs text-white/60 font-semibold uppercase tracking-wide mb-2">Duration</p>
          <p class="font-serif text-lg font-semibold text-med-gold">7 days<br/>6 nights</p>
        </div>
        <div class="bg-slate-900 rounded-2xl p-6 hover:shadow-md transition-shadow flex flex-col items-center justify-center aspect-square">
          <svg class="w-8 h-8 text-med-gold mb-3" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
            <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/>
            <circle cx="12" cy="10" r="3"/>
          </svg>
          <p class="text-xs text-white/60 font-semibold uppercase tracking-wide mb-2">Base</p>
          <p class="font-serif text-lg font-semibold text-med-gold">Praiano or<br/>Amalfi</p>
        </div>
        <div class="bg-slate-900 rounded-2xl p-6 hover:shadow-md transition-shadow flex flex-col items-center justify-center aspect-square">
          <svg class="w-8 h-8 text-med-gold mb-3" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
            <path d="M12 1v6M12 17v6M4.22 4.22l4.24 4.24M15.54 15.54l4.24 4.24M1 12h6M17 12h6M4.22 19.78l4.24-4.24M15.54 8.46l4.24-4.24"/>
          </svg>
          <p class="text-xs text-white/60 font-semibold uppercase tracking-wide mb-2">Best Season</p>
          <p class="font-serif text-lg font-semibold text-med-gold">May–Oct<br/>(Low: Nov–Apr)</p>
        </div>
        <div class="bg-slate-900 rounded-2xl p-6 hover:shadow-md transition-shadow flex flex-col items-center justify-center aspect-square">
          <svg class="w-8 h-8 text-med-gold mb-3" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
            <path d="M9 12l2 2 4-4"/>
            <circle cx="12" cy="12" r="9"/>
          </svg>
          <p class="text-xs text-white/60 font-semibold uppercase tracking-wide mb-2">Pace</p>
          <p class="font-serif text-lg font-semibold text-med-gold">Slow &<br/>Authentic</p>
        </div>
      </div>

      <!-- SEO Text Below -->
      <div>
        <p class="text-lg text-slate-700 leading-relaxed">
          The <strong>7-day Slow Travel itinerary</strong> is perfect for escaping mass tourism on the Amalfi Coast. Base in quiet <strong>Praiano</strong> (no ZTL) or central <strong>Amalfi</strong>, with daily trips to authentic villages, local markets, minor trails and tastings of wines and local products. No car, no rush: just SITA buses, good food and real people.
        </p>
      </div>
    </section>

    <section>
      <h2 class="font-serif text-2xl font-semibold text-slate-900 mb-8">Day-by-Day Schedule</h2>
      <div class="space-y-6">
        {days.map(d => (
          <div class="bg-white border border-slate-200 rounded-2xl overflow-hidden hover:shadow-md transition-shadow">
            <div class="bg-slate-900 px-6 py-6 flex items-start gap-4 sm:items-center sm:gap-3">
              <span class="text-[10px] uppercase tracking-wide bg-white/15 text-white px-3 py-1.5 rounded-full font-bold flex-shrink-0">{d.day}</span>
              <div class="flex-1 min-w-0">
                <h3 class="font-serif font-semibold text-white text-lg">{d.title}</h3>
                <p class="text-xs text-med-gold mt-1 font-medium">{d.highlight}</p>
              </div>
            </div>
            <ul class="px-6 py-5 space-y-3">
              {d.items.map((item, itemIdx) => {
                const isLocalTip = item.includes('Local tip:');
                const displayText = item.replace('Local tip: ', '');
                const isLastItem = itemIdx === d.items.length - 1;
                return (
                  <li key={itemIdx} class={`flex gap-3 text-sm relative ${isLocalTip ? 'bg-med-gold/10 p-3 rounded-lg border border-med-gold/20' : ''}`}>
                    <div class="flex flex-col items-center">
                      {isLocalTip ? (
                        <svg class="w-5 h-5 text-med-gold flex-shrink-0 self-center" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
                          <circle cx="12" cy="8" r="5"/>
                          <path d="M12 13v2"/>
                          <rect x="10" y="15" width="4" height="3" rx="0.5"/>
                        </svg>
                      ) : (
                        <span class="w-2 h-2 rounded-full bg-med-blue flex-shrink-0"></span>
                      )}
                      {!isLastItem && <div class="w-0.5 h-6 bg-med-blue/30 mt-1"></div>}
                    </div>
                    <span class={`leading-relaxed ${isLocalTip ? 'font-semibold text-slate-800' : 'text-slate-700'}`}>
                      {isLocalTip && <strong>Local tip: </strong>}
                      {displayText}
                    </span>
                  </li>
                );
              })}
            </ul>
          </div>
        ))}
      </div>
    </section>

    <section class="bg-charcoal text-white rounded-[2rem] p-8">
      <p class="text-[10px] uppercase tracking-[0.3em] text-med-gold font-medium mb-4">Products not to miss</p>
      <div class="grid sm:grid-cols-2 gap-6 text-xs sm:text-sm">
        <div>
          <p class="font-semibold mb-1">Sfusato amalfitano lemon PGI</p>
          <p class="text-white/70">The Coast's enormous lemons: unique aroma, thick peel. Buy them directly from growers in Amalfi or Minori.</p>
        </div>
        <div>
          <p class="font-semibold mb-1">Cetara anchovy sauce (colatura) DOP</p>
          <p class="text-white/70">Modern garum: an amber liquid of fermented anchovies. Cetara produces Italy's finest DOP version.</p>
        </div>
        <div>
          <p class="font-semibold mb-1">Ravello wine</p>
          <p class="text-white/70">High-altitude vineyards produce a light, fragrant red. Tasting in Ravello's cellars.</p>
        </div>
        <div>
          <p class="font-semibold mb-1">Vietri sul Mare ceramics</p>
          <p class="text-white/70">Italy's ceramics capital: tiles, plates and artworks painted by hand. Choose local craft workshops.</p>
        </div>
      </div>
    </section>

    <section id="faq">
      <h2 class="font-serif text-2xl font-semibold text-slate-900 mb-6">Frequently Asked Questions</h2>
      <div class="space-y-4">
        {faqSchema.mainEntity.map((q) => (
          <details class="group border border-slate-200 rounded-2xl overflow-hidden">
            <summary class="flex items-center justify-between px-6 py-4 cursor-pointer select-none text-charcoal font-medium hover:bg-slate-50 transition-colors">
              {q.name}
              <svg class="w-4 h-4 text-slate-400 group-open:rotate-180 transition-transform flex-shrink-0 ml-3" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
            </summary>
            <div class="px-6 pb-5 text-slate-600 leading-relaxed text-xs sm:text-sm border-t border-slate-100 pt-4">
              {q.acceptedAnswer.text}
            </div>
          </details>
        ))}
      </div>
    </section>

    <!-- CTA -->
    <section class="bg-gradient-to-r from-med-blue to-med-blue/80 rounded-2xl p-10 text-center text-white">
      <h2 class="font-serif text-3xl font-bold mb-3">Ready to travel slowly?</h2>
      <p class="text-white/90 mb-6 max-w-2xl mx-auto">
        Discover more about slow travel on the Amalfi Coast: authentic villages, local markets, hiking trails and food experiences.
      </p>
      <a href="/en-us/guide/getting-here/" class="inline-block bg-white text-med-blue font-semibold px-8 py-3 rounded-full hover:bg-slate-100 transition-colors">
        Travel guide →
      </a>
    </section>

  </div>

</BaseLayout>
