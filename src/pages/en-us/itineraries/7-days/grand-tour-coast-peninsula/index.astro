---
import BaseLayout from '../../../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../../../components/Breadcrumbs.astro';

const lang = 'en-us';

const breadcrumbs = [
  { name: 'Home', url: '/en-us/' },
  { name: 'Planning', url: '/en-us/planning/' },
  { name: 'Grand Tour - 7 days', url: '/en-us/itineraries/7-days/grand-tour-coast-peninsula/' },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What is the best way to organise 7 days between the Amalfi Coast and Sorrentine Peninsula?",
      "acceptedAnswer": { "@type": "Answer", "text": "The classic route is: 2 nights in Naples (days 1–2), then move to Sorrento or Amalfi as base for the Coast (days 3–5), with a Capri excursion (day 4 or 5), then islands at the end (days 6–7). Using SITA bus, Circumvesuviana and hydrofoils avoids a car entirely." }
    },
    {
      "@type": "Question",
      "name": "How many nights in Naples before the Coast is worth doing?",
      "acceptedAnswer": { "@type": "Answer", "text": "1–2 nights are enough for Naples: Spaccanapoli, National Archaeological Museum, authentic pizza, Certosa di San Martino. With 2 nights you can include Herculaneum or Pompeii as a day trip. Naples is the natural arrival and departure point for the whole area." }
    },
    {
      "@type": "Question",
      "name": "Is it better to stay in Sorrento or Amalfi?",
      "acceptedAnswer": { "@type": "Answer", "text": "Sorrento is more crowded but has better hydrofoil connections to Capri. Amalfi is more authentic and centrally positioned for the Coast. Ideal: 2 nights in Sorrento + 2 nights in Amalfi or Positano." }
    },
    {
      "@type": "Question",
      "name": "When is the best time to do this itinerary?",
      "acceptedAnswer": { "@type": "Answer", "text": "April–June and September–October offer ideal weather, fewer crowds and reasonable prices. July–August is crowded but has long days. November–March is low season: fewer tourists but some hydrofoils are reduced." }
    }
  ]
};

const destinationHighlights = [
  { name: 'Sorrento', desc: 'Terrace on the sea, ideal base for excursions', url: '/en-us/sorrentine-peninsula/sorrento/' },
  { name: 'Positano', desc: 'Coast jewel with beach and characteristic shops', url: '/en-us/amalfi-coast/positano/' },
  { name: 'Amalfi', desc: 'Cathedral, Cloister of Paradise, Paper Museum', url: '/en-us/amalfi-coast/amalfi/' },
  { name: 'Ravello', desc: 'Infinity terrace: Villa Rufolo and Villa Cimbrone', url: '/en-us/amalfi-coast/ravello/' },
  { name: 'Capri', desc: 'Blue Grotto, Faraglioni, Anacapri with Monte Solaro', url: '/en-us/islands/capri/' },
  { name: 'Ischia', desc: 'Thermal island with beaches and botanical gardens', url: '/en-us/islands/ischia/' },
  { name: 'Procida', desc: 'Colorful island with Marina Corricella and Terra Murata', url: '/en-us/islands/procida/' },
  { name: 'Guide', desc: 'Transport, parking, schedules and tips to get there', url: '/en-us/guide/getting-here/' },
];

const days = [
  {
    day: 'Day 1',
    title: 'Naples',
    highlight: 'UNESCO historic centre',
    items: ['Arrive in Naples. Spaccanapoli, UNESCO historic centre.', 'National Archaeological Museum: finds from Pompeii, mosaics, bronzes.', 'Authentic pizza in the historic quarter: Da Michele, Sorbillo or Brandi.']
  },
  {
    day: 'Day 2',
    title: 'Pompeii or Herculaneum',
    highlight: 'Underground archaeological masterpiece',
    items: ['Day trip by Circumvesuviana: Herculaneum excavations (morning, 2–3h) + Vesuvius (afternoon).', 'Alternative: all-day Pompeii (3–4h at the site).', 'Return to Naples for dinner.']
  },
  {
    day: 'Day 3',
    title: 'Sorrento and arrival on the Coast',
    highlight: 'First view of the sea',
    items: ['Circumvesuviana Naples→Sorrento (70 min). Check-in Sorrento or Amalfi.', 'Afternoon: Sorrento centre, Vallone dei Mulini, Marina Grande.', 'SITA bus to Positano (optional, 50 min): first taste of the Coast.']
  },
  {
    day: 'Day 4',
    title: 'Capri',
    highlight: 'Island of the Blue Grotto',
    items: ['Hydrofoil from Sorrento to Capri (20–25 min). First service 07:30.', 'Blue Grotto early in the morning. Anacapri and Monte Solaro by chairlift.', 'Faraglioni in the afternoon. Aperitivo in La Piazzetta. Return in the evening.']
  },
  {
    day: 'Day 5',
    title: 'Amalfi and Ravello',
    highlight: 'Cathedral and historic villas',
    items: ['SITA bus Sorrento→Amalfi (90 min) or ferry Sorrento→Amalfi.', 'Cathedral, Cloister of Paradise, Paper Museum.', 'Bus to Ravello (25 min): Villa Rufolo, Villa Cimbrone. Dinner in Amalfi.']
  },
  {
    day: 'Day 6',
    title: 'Positano and Boat Tour',
    highlight: 'Emerald Grotto by sea',
    items: ['SITA bus to Positano (45 min from Amalfi). Free morning on the beach.', 'Boat tour from Positano (Emerald Grotto, coves, ~€50–80, 4h).', 'Return to Amalfi or Positano. Dinner at the harbour.']
  },
  {
    day: 'Day 7',
    title: 'Ischia or Procida and Departure',
    highlight: 'Colorful Gulf islands',
    items: ['Ferry Amalfi/Naples→Ischia or Procida (half-day excursion).', 'Procida: Marina Corricella, Terra Murata, Pozzo Vecchio beach.', 'Return to Naples for departure.']
  },
];

const tripSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": "Grand Tour Amalfi Coast - 7 Days",
  "description": "A complete 7-day itinerary between Naples, Amalfi Coast, Sorrentine Peninsula, Capri and Gulf Islands. Combination of art, history, nature and sea with public transport.",
  "url": "https://amalficoast-travel.com/en-us/itineraries/7-days/grand-tour-coast-peninsula/",
  "image": "https://amalficoast-travel.com/images/costiera-hero.jpg",
  "author": {
    "@type": "Organization",
    "name": "Amalfi Coast Travel"
  },
  "publisher": {
    "@type": "Organization",
    "name": "Amalfi Coast Travel",
    "url": "https://amalficoast-travel.com"
  },
  "datePublished": "2026-01-01",
  "articleBody": "A complete 7-day itinerary between Naples, Amalfi Coast, Sorrentine Peninsula, Capri and Gulf Islands. Combination of art, history, nature and sea with public transport. Duration: 7 days and 6 nights."
};
---

<BaseLayout
  title="Grand Tour Amalfi Coast 7 Days 2026 | Naples, Capri, Positano, Amalfi"
  description="Complete 7-day itinerary: Naples, Amalfi Coast, Capri and the Gulf Islands. Pompeii, Sorrento, Positano, Amalfi, Ravello - the Grand Tour of Southern Italy."
  lang={lang}
  breadcrumbs={breadcrumbs}
  schema={[tripSchema, faqSchema]}
 pageKey="grand-tour-coast-peninsula">

  <!-- Hero Section -->
  <section class="relative bg-charcoal overflow-hidden min-h-[70vh] sm:min-h-[75vh] flex items-center justify-center">
    <img src="/images/costiera-hero.jpg" alt="Grand Tour Amalfi Coast" class="absolute inset-0 w-full h-full object-cover opacity-30" loading="eager" referrerpolicy="no-referrer"/>
    <div class="absolute inset-0 bg-gradient-to-b from-black/75 via-black/40 to-black/70"></div>
    <div class="relative max-w-editorial mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <div class="max-w-3xl mx-auto">
        <p class="text-med-gold text-xs sm:text-sm font-medium uppercase tracking-[0.3em] mb-3">Itinerary · 7 days</p>
        <h1 class="font-serif text-display text-white mb-4">Grand Tour: Coast & Peninsula</h1>
        <p class="text-xl text-white/80 leading-relaxed max-w-2xl mx-auto">
          Seven days: Coast, Peninsula, Capri and the Grand Tour. Do it all slowly.
        </p>
      </div>
    </div>
    <Breadcrumbs breadcrumbs={breadcrumbs} />
  </section>

  <div class="max-w-editorial mx-auto px-4 sm:px-6 lg:px-8 pt-6 pb-10 space-y-10">

    <!-- Intro & Stats Section - Featured -->
    <section class="text-center mb-2">
      <div>
        <p class="text-lg text-slate-700 leading-relaxed">
          The <strong>7-day Grand Tour</strong> is the classic route of Southern Italy: combining two days in <strong>Naples</strong>, the extraordinary <strong>Amalfi Coast</strong> with Positano, Amalfi and Ravello, the <strong>Sorrentine Peninsula</strong>, <strong>Capri</strong> with the Blue Grotto, and the <strong>Gulf Islands</strong>. All with public transport. <strong>Transport budget: €80–120</strong>.
        </p>
      </div>
    </section>

    <!-- Day by Day Itinerary -->
    <section>
      <h2 class="font-serif text-2xl font-semibold text-slate-900 mb-8">Day-by-Day Schedule</h2>
      <div class="space-y-6">
        {days.map((d, idx) => (
          <div class="bg-white border border-slate-200 rounded-2xl overflow-hidden hover:shadow-md transition-shadow">
            <div class="bg-slate-900 px-6 py-6 flex items-start gap-4 sm:items-center sm:gap-3">
              <span class="text-[10px] uppercase tracking-wide bg-white/15 text-white px-3 py-1.5 rounded-full font-bold flex-shrink-0">{d.day}</span>
              <div class="flex-1 min-w-0">
                <h3 class="font-serif font-semibold text-white text-lg">{d.title}</h3>
                <p class="text-xs text-med-gold mt-1 font-medium">{d.highlight}</p>
              </div>
            </div>
            <ul class="px-6 py-5 space-y-3">
              {d.items.map((item, itemIdx) => {
                const isLocalTip = item.includes('Local tip:');
                const displayText = item.replace('Local tip: ', '');
                const isLastItem = itemIdx === d.items.length - 1;
                return (
                  <li key={itemIdx} class={`flex gap-3 text-sm relative ${isLocalTip ? 'bg-med-gold/10 p-3 rounded-lg border border-med-gold/20' : ''}`}>
                    <div class="flex flex-col items-center">
                      {isLocalTip ? (
                        <svg class="w-5 h-5 text-med-gold flex-shrink-0 self-center" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
                          <circle cx="12" cy="8" r="5"/>
                          <path d="M12 13v2"/>
                          <rect x="10" y="15" width="4" height="3" rx="0.5"/>
                        </svg>
                      ) : (
                        <span class="w-2 h-2 rounded-full bg-med-blue flex-shrink-0"></span>
                      )}
                      {!isLastItem && <div class="w-0.5 h-6 bg-med-blue/30 mt-1"></div>}
                    </div>
                    <span class={`leading-relaxed ${isLocalTip ? 'font-semibold text-slate-800' : 'text-slate-700'}`}>
                      {isLocalTip && <strong>Local tip: </strong>}
                      {displayText}
                    </span>
                  </li>
                );
              })}
            </ul>
          </div>
        ))}
      </div>
    </section>

    <!-- Destinations Highlighted -->
    <section>
      <h2 class="font-serif text-2xl font-semibold text-slate-900 mb-8">Itinerary highlights</h2>
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4">
        {destinationHighlights.map((dest) => (
          <a href={dest.url} class="group block bg-white border border-slate-200 rounded-2xl p-5 hover:shadow-lg hover:border-med-blue/30 transition-all">
            <h3 class="font-semibold text-charcoal mb-2 group-hover:text-med-blue transition-colors">{dest.name}</h3>
            <p class="text-xs text-slate-500 leading-relaxed mb-3">{dest.desc}</p>
            <span class="text-xs font-semibold text-med-blue inline-flex items-center gap-1 group-hover:gap-2 transition-all">
              Discover →
            </span>
          </a>
        ))}
      </div>
    </section>

    <!-- Planning Tips -->
    <section class="bg-med-cream border border-med-gold/20 rounded-[2rem] p-6">
      <h2 class="font-serif text-xl font-semibold text-charcoal mb-6">Practical tips</h2>
      <ul class="space-y-4">
        {[
          { num: '❶', text: 'Campania Express: day ticket on the Circumvesuviana (valid Naples–Sorrento–Pompeii–Herculaneum) ~€10.' },
          { num: '❷', text: 'Book Capri and the Blue Grotto 1–2 days in advance in July–August.' },
          { num: '❸', text: 'Change base mid-trip: 2 nights Naples + 3 nights Amalfi/Sorrento + optional 1 night island.' },
          { num: '❹', text: 'The boat tour day is flexible: reschedule it depending on sea conditions.' },
          { num: '❺', text: 'Bring comfortable shoes for Naples\' cobblestones and Positano\'s staircases.' },
        ].map(({ num, text }) => (
          <li class="flex items-start gap-4 text-sm text-charcoal">
            <span class="text-2xl font-bold text-white flex-shrink-0 leading-none mt-0.5 bg-[#E2725B] w-9 h-9 flex items-center justify-center rounded-full">{num}</span>
            <span class="leading-relaxed">{text}</span>
          </li>
        ))}
      </ul>
    </section>

    <!-- FAQ -->
    <section id="faq">
      <h2 class="font-serif text-2xl font-semibold text-slate-900 mb-6">Frequently Asked Questions</h2>
      <div class="space-y-4">
        {faqSchema.mainEntity.map((q) => (
          <details class="group border border-slate-200 rounded-2xl overflow-hidden">
            <summary class="flex items-center justify-between px-6 py-4 cursor-pointer select-none text-charcoal font-medium hover:bg-slate-50 transition-colors">
              {q.name}
              <svg class="w-4 h-4 text-slate-400 group-open:rotate-180 transition-transform flex-shrink-0 ml-3" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
            </summary>
            <div class="px-6 pb-5 text-slate-600 leading-relaxed text-sm border-t border-slate-100 pt-4">
              {q.acceptedAnswer.text}
            </div>
          </details>
        ))}
      </div>
    </section>

    <!-- CTA -->
    <section class="bg-gradient-to-r from-med-blue to-med-blue/80 rounded-2xl p-10 text-center text-white">
      <h2 class="font-serif text-3xl font-bold mb-3">Ready to go?</h2>
      <p class="text-white/90 mb-6 max-w-2xl mx-auto">
        Read the complete guide to public transport on the Coast: how to get there, schedules, tickets and money-saving strategies.
      </p>
      <a href="/en-us/guide/getting-here/" class="inline-block bg-white text-med-blue font-semibold px-8 py-3 rounded-full hover:bg-slate-100 transition-colors">
        Transport guide →
      </a>
    </section>

  </div>

</BaseLayout>
