---
import BaseLayout from '../../../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../../../components/Breadcrumbs.astro';

const lang = 'en-us';

const breadcrumbs = [
  { name: 'Home', url: '/en-us/' },
  { name: 'Planning', url: '/en-us/planning/' },
  { name: 'Sorrento, Pompeii & History - 3 days', url: '/en-us/itineraries/3-days/sorrento-pompeii-history/' },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "How long do you need to visit Pompeii?",
      "acceptedAnswer": { "@type": "Answer", "text": "For a thorough visit you need at least 3–4 hours. An essential visit (Forum, Via dell'Abbondanza, Casa del Fauno, amphitheatre) can be done in 2–2.5 hours. Arrive at opening time (09:00) to avoid afternoon heat and queues. Ticket ~€18–20, free for under-18s." }
    },
    {
      "@type": "Question",
      "name": "Is Herculaneum worth visiting as well as Pompeii?",
      "acceptedAnswer": { "@type": "Answer", "text": "Yes, Herculaneum is often preferred by experienced visitors: smaller than Pompeii (2h is enough) but with better-preserved remains because it was buried in mud rather than ash. A combined Pompeii + Herculaneum ticket exists. With 3 days, visit Herculaneum in the afternoon of day 2 and Pompeii on the morning of day 3." }
    }
  ]
};

const days = [
  {
    day: 'Day 1',
    title: 'Sorrento',
    highlight: 'Cathedral and harbour views',
    items: [
      'Arrive in Sorrento by Circumvesuviana from Naples (70 min, ~€3.90).',
      'Old town: Piazza Tasso (the heart), Cathedral (16th-century majolica floors), Vallone dei Mulini (volcanic gorge in the city centre).',
      'Museo Correale: Roman artefacts, 18th-century paintings, views of Sorrento from the belvederes.',
      'Marina Grande: the fishermen\'s harbour (300 stairs), dinner on the water with views.',
      'Local tip: the old town is a maze. Get a map or ask locals. Parking: use paid public car parks (~€10/day), the city is very congested.',
    ],
  },
  {
    day: 'Day 2',
    title: 'Herculaneum and Vesuvius',
    highlight: 'Volcano crater and preserved villas',
    items: [
      'Circumvesuviana to Herculaneum Scavi (20 min from Naples, 50 min from Sorrento).',
      'Herculaneum archaeological site: smaller than Pompeii but extraordinarily preserved (buried in mud, not ash). 2–3 hours. Entry ~€13.',
      'Lunch in modern Ercolano (the town above Herculaneum).',
      'Afternoon: bus/shuttle to Vesuvius summit (crater at 1,281 m, €12 entry + mandatory guide €6–8). Views over the Gulf of Naples, the crater, and Pompeii plains.',
      'Return to Sorrento on Circumvesuviana.',
      'Local tip: Vesuvius: wear sturdy hiking boots (loose volcanic rock), bring water. The crater walk is 30 min up, 30 min around, 30 min down.',
    ],
  },
  {
    day: 'Day 3',
    title: 'Pompeii',
    highlight: 'Forum, villas and amphitheatre',
    items: [
      'Early start. Circumvesuviana to Pompei Scavi – Villa dei Misteri (35 min from Naples, 45 min from Sorrento).',
      'Pompeii excavations: arrive at opening time (09:00) to beat heat and queues. Essential: Forum, Baths, amphitheatre, Casa del Fauno, Casa dei Misteri. At least 3–4 hours. Entry ~€18.',
      'Lunch in modern Pompeii (near the site): pizza, pasta con le verdure.',
      'Optional afternoon: National Archaeological Museum of Naples (on the Circumvesuviana back to Naples) - the finest treasures from Pompeii and Herculaneum.',
      'Return towards Naples or Sorrento in the afternoon/evening.',
      'Local tip: Pompeii is enormous (66 hectares). Rent a guidebook or hire a guide. Without guidance, easy to get lost and miss key sites.',
    ],
  },
];
---

<BaseLayout
  title="Sorrento, Pompeii and Herculaneum in 3 Days 2026 | Historic Itinerary"
  description="3-day itinerary combining history and the sea: Sorrento, Herculaneum, Vesuvius and Pompeii. Circumvesuviana timetables, ticket prices and practical tips."
  lang={lang}
  breadcrumbs={breadcrumbs}
  schema={[faqSchema]}
 pageKey="sorrento-pompeii-history">

  <section class="relative bg-charcoal overflow-hidden">
    <img src="/images/sorrento-hero.jpg" alt="Sorrento and Pompeii" class="absolute inset-0 w-full h-full object-cover opacity-30" loading="eager" referrerpolicy="no-referrer"/>

    <div class="absolute inset-0 bg-gradient-to-b from-black/75 via-black/40 to-black/70"></div>
    <div class="relative max-w-editorial mx-auto px-4 sm:px-6 lg:px-8 py-20">
      <div class="max-w-3xl">
        <p class="text-med-gold text-xs sm:text-sm font-medium uppercase tracking-[0.3em] mb-3">Itinerary · 3 days</p>
        <h1 class="font-serif text-display text-white mb-4">Sorrento, Pompeii & History</h1>
        <p class="text-xl text-white/80 leading-relaxed max-w-2xl">
          Sorrento, Pompeii, Roman history. Three days immersed in Campania's past.
        </p>
      </div>
    </div>
    <Breadcrumbs breadcrumbs={breadcrumbs} />
  </section>

  <div class="max-w-editorial mx-auto px-4 sm:px-6 lg:px-8 py-16 space-y-16">

    <!-- Intro Section -->
    <section class="text-center mb-2">
      <div>
        <p class="text-lg text-slate-700 leading-relaxed">
          Discover <strong>Campania's Roman heritage</strong> in <strong>3 days</strong>: explore <strong>Sorrento</strong>'s charming clifftop town, visit the exceptionally preserved <strong>Herculaneum</strong>, hike the crater of <strong>Mount Vesuvius</strong>, and walk the ancient streets of <strong>Pompeii</strong>. All connected by the convenient Circumvesuviana railway.
        </p>
      </div>
    </section>

    <section>
      <h2 class="font-serif text-2xl font-semibold text-slate-900 mb-8">Day-by-Day Schedule</h2>
      <div class="space-y-6">
        {days.map(d => (
          <div class="bg-white border border-slate-200 rounded-2xl overflow-hidden hover:shadow-md transition-shadow">
            <div class="bg-slate-900 px-6 py-6 flex items-start gap-4 sm:items-center sm:gap-3">
              <span class="text-[10px] uppercase tracking-wide bg-white/15 text-white px-3 py-1.5 rounded-full font-bold flex-shrink-0">{d.day}</span>
              <div class="flex-1 min-w-0">
                <h3 class="font-serif font-semibold text-white text-lg">{d.title}</h3>
                <p class="text-xs text-med-gold mt-1 font-medium">{d.highlight}</p>
              </div>
            </div>
            <ul class="px-6 py-5 space-y-3">
              {d.items.map((item, itemIdx) => {
                const isLocalTip = item.includes('Local tip:');
                const displayText = item.replace('Local tip: ', '');
                const isLastItem = itemIdx === d.items.length - 1;
                return (
                  <li key={itemIdx} class={`flex gap-3 text-sm relative ${isLocalTip ? 'bg-med-gold/10 p-3 rounded-lg border border-med-gold/20' : ''}`}>
                    <div class="flex flex-col items-center">
                      {isLocalTip ? (
                        <svg class="w-5 h-5 text-med-gold flex-shrink-0 self-center" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
                          <circle cx="12" cy="8" r="5"/>
                          <path d="M12 13v2"/>
                          <rect x="10" y="15" width="4" height="3" rx="0.5"/>
                        </svg>
                      ) : (
                        <span class="w-2 h-2 rounded-full bg-med-blue flex-shrink-0"></span>
                      )}
                      {!isLastItem && <div class="w-0.5 h-6 bg-med-blue/30 mt-1"></div>}
                    </div>
                    <span class={`leading-relaxed ${isLocalTip ? 'font-semibold text-slate-800' : 'text-slate-700'}`}>
                      {isLocalTip && <strong>Local tip: </strong>}
                      {displayText}
                    </span>
                  </li>
                );
              })}
            </ul>
          </div>
        ))}
      </div>
    </section>

    <section class="bg-med-cream border border-med-gold/20 rounded-[2rem] p-8">
      <p class="font-semibold text-charcoal text-lg mb-3">Practical Tips</p>
      <ul class="space-y-2">
        {[
          'Pompeii and Herculaneum: arrive at opening (09:00). Afternoon heat and queues make visiting difficult.',
          'Combined Pompeii + Herculaneum ticket: worth it if you visit both on the same or consecutive days.',
          'The Circumvesuviana is frequent but slow: Sorrento to Pompei Scavi ~45 min, from Naples ~35 min.',
          'Vesuvius: the shuttle bus departs from Herculaneum and Pompeii (check seasonal timetables). A guide is legally required.',
          'Sorrento in the evening is magnificent: aperitivo at Marina Grande, dinner on the main corso.',
        ].map(tip => (
          <li class="flex items-start gap-2 text-xs sm:text-sm text-charcoal">
            <span class="w-1.5 h-1.5 rounded-full bg-med-cream0 mt-1.5 flex-shrink-0"></span>
            <span>{tip}</span>
          </li>
        ))}
      </ul>
    </section>

    <section id="faq">
      <h2 class="font-serif text-2xl font-semibold text-slate-900 mb-6">Frequently Asked Questions</h2>
      <div class="space-y-4">
        {faqSchema.mainEntity.map((q) => (
          <details class="group border border-slate-200 rounded-2xl overflow-hidden">
            <summary class="flex items-center justify-between px-6 py-4 cursor-pointer select-none text-charcoal font-medium hover:bg-slate-50 transition-colors">
              {q.name}
              <svg class="w-4 h-4 text-slate-400 group-open:rotate-180 transition-transform flex-shrink-0 ml-3" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
            </summary>
            <div class="px-6 pb-5 text-slate-600 leading-relaxed text-xs sm:text-sm border-t border-slate-100 pt-4">
              {q.acceptedAnswer.text}
            </div>
          </details>
        ))}
      </div>
    </section>

    <!-- CTA -->
    <section class="bg-gradient-to-r from-med-blue to-med-blue/80 rounded-2xl p-10 text-center text-white">
      <h2 class="font-serif text-3xl font-bold mb-3">Plan your Pompeii trip</h2>
      <p class="text-white/90 mb-6 max-w-2xl mx-auto">
        Learn more about Pompeii, Herculaneum and the Circumvesuviana: tickets, opening hours, guides and practical information.
      </p>
      <a href="/en-us/guide/getting-here/" class="inline-block bg-white text-med-blue font-semibold px-8 py-3 rounded-full hover:bg-slate-100 transition-colors">
        Transport guide →
      </a>
    </section>

  </div>

</BaseLayout>
