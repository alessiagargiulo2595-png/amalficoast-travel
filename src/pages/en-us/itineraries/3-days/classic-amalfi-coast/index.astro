---
import BaseLayout from '../../../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../../../components/Breadcrumbs.astro';

const lang = 'en-us';

const breadcrumbs = [
  { name: 'Home', url: '/en-us/' },
  { name: 'Planning', url: '/en-us/planning/' },
  { name: 'Classic Amalfi Coast - 3 days', url: '/en-us/itineraries/3-days/classic-amalfi-coast/' },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Where should you stay to visit the Amalfi Coast in 3 days?",
      "acceptedAnswer": { "@type": "Answer", "text": "The best bases are Amalfi (most central, good choice of hotels and B&Bs, well served by bus and ferry) or Positano (more romantic but more expensive). Sorrento is excellent for those who want a more convenient town with more amenities and lower prices, with day trips to the Coast." }
    },
    {
      "@type": "Question",
      "name": "3 days on the Coast: better in high or low season?",
      "acceptedAnswer": { "@type": "Answer", "text": "May–June and September–October are the best months: perfect weather, fewer crowds than July–August, lower prices. In July–August buses are packed, parking is gone and beaches are crowded. In winter many places close but the villages are peaceful and authentic." }
    }
  ]
};

const destinationHighlights = [
  { name: 'Positano', desc: 'Colorful village on the coast', url: '/en-us/amalfi-coast/positano/' },
  { name: 'Amalfi', desc: 'Cathedral and historic centre', url: '/en-us/amalfi-coast/amalfi/' },
  { name: 'Ravello', desc: 'Villages and panoramas', url: '/en-us/amalfi-coast/ravello/' },
  { name: 'Praiano', desc: 'Beaches and caves', url: '/en-us/amalfi-coast/praiano/' },
];

const days = [
  {
    day: 'Day 1',
    title: 'Arrival and Positano',
    items: [
      'Arrive in Sorrento or Amalfi. Check in.',
      'Afternoon in Positano: Spiaggia Grande, Via Cristoforo Colombo, Santa Maria Assunta church.',
      'Aperitivo with views from the belvedere above the village.',
      'Dinner in Positano or return by bus to Amalfi.',
    ],
  },
  {
    day: 'Day 2',
    title: 'Amalfi and Ravello',
    items: [
      'Morning: Amalfi Cathedral, Cloister of Paradise, Paper Museum (Amalfi paper, 13th century).',
      'SITA bus to Ravello (25 min). Villa Rufolo, Villa Cimbrone, panoramas over the Coast.',
      'Lunch in Ravello, then back to Amalfi in the afternoon.',
      'Dinner at Amalfi harbour: fresh fish, buffalo mozzarella.',
    ],
  },
  {
    day: 'Day 3',
    title: 'Praiano and Emerald Grotto',
    items: [
      'Morning: SITA bus towards Positano, stop at Praiano (peaceful stroll, Gavitella beach).',
      'Emerald Grotto near Conca dei Marini: entry ~€5, spectacular green light.',
      'Free afternoon in Amalfi or boat excursion (coastal tour from Amalfi, ~€40–70 p.p.).',
      'Departure in the late afternoon towards Naples/Salerno.',
    ],
  },
];
---

<BaseLayout
  title="Amalfi Coast in 3 Days 2026 | Classic Complete Itinerary"
  description="Classic 3-day itinerary on the Amalfi Coast: Positano, Amalfi, Ravello and the Emerald Grotto. Where to stay, what to see and how to get around."
  lang={lang}
  breadcrumbs={breadcrumbs}
  schema={[faqSchema]}
 pageKey="classic-amalfi-coast">

  <!-- Hero Section -->
  <section class="relative bg-charcoal overflow-hidden min-h-[70vh] sm:min-h-[75vh] flex items-center justify-center">
    <img src="/images/costiera-hero.jpg" alt="Classic Amalfi Coast" class="absolute inset-0 w-full h-full object-cover opacity-30" loading="eager" referrerpolicy="no-referrer"/>
    <div class="absolute inset-0 bg-gradient-to-b from-black/75 via-black/40 to-black/70"></div>
    <div class="relative max-w-editorial mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <div class="max-w-3xl mx-auto">
        <p class="text-med-gold text-xs sm:text-sm font-medium uppercase tracking-[0.3em] mb-3">Itinerary · 3 days</p>
        <h1 class="font-serif text-display text-white mb-4">Classic Amalfi Coast</h1>
        <p class="text-xl text-white/80 leading-relaxed max-w-2xl mx-auto">
          Three days: Positano, Amalfi, Ravello and Emerald Grotto. Pure Coast.
        </p>
      </div>
    </div>
    <Breadcrumbs breadcrumbs={breadcrumbs} />
  </section>

  <div class="max-w-editorial mx-auto px-4 sm:px-6 lg:px-8 pt-6 pb-10 space-y-10">

    <!-- Intro Section -->
    <section class="text-center mb-2 -mt-3">
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-2 sm:gap-4 mb-6 overflow-x-auto snap-x snap-mandatory sm:overflow-visible pb-2 sm:pb-0">
        <!-- Box 1: Duration -->
        <div class="w-full bg-slate-900 rounded-2xl p-4 sm:p-6 hover:shadow-md transition-shadow flex flex-col items-center justify-center aspect-square snap-start">
          <svg class="w-8 h-8 text-med-gold mb-3" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg>
          <p class="text-xs text-white/60 font-semibold uppercase tracking-wide mb-2">Duration</p>
          <p class="font-serif text-lg font-semibold text-med-gold">3 days</p>
        </div>
        <!-- Box 2: Bases -->
        <div class="w-full bg-slate-900 rounded-2xl p-4 sm:p-6 hover:shadow-md transition-shadow flex flex-col items-center justify-center aspect-square snap-start">
          <svg class="w-8 h-8 text-med-gold mb-3" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
          <p class="text-xs text-white/60 font-semibold uppercase tracking-wide mb-2">Bases</p>
          <p class="font-serif text-lg font-semibold text-med-gold">Amalfi<br/>Positano</p>
        </div>
        <!-- Box 3: Transport -->
        <div class="w-full bg-slate-900 rounded-2xl p-4 sm:p-6 hover:shadow-md transition-shadow flex flex-col items-center justify-center aspect-square snap-start">
          <svg class="w-8 h-8 text-med-gold mb-3" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M6 9l6-6 6 6M5 9v9a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V9M9 14h6"/></svg>
          <p class="text-xs text-white/60 font-semibold uppercase tracking-wide mb-2">Transport</p>
          <p class="font-serif text-lg font-semibold text-med-gold">SITA bus<br/>Ferry</p>
        </div>
        <!-- Box 4: Budget -->
        <div class="w-full bg-slate-900 rounded-2xl p-4 sm:p-6 hover:shadow-md transition-shadow flex flex-col items-center justify-center aspect-square snap-start">
          <svg class="w-8 h-8 text-med-gold mb-3" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><circle cx="12" cy="12" r="1"/><path d="M12 1v6M12 17v6M4.22 4.22l4.24 4.24M15.54 15.54l4.24 4.24M1 12h6M17 12h6M4.22 19.78l4.24-4.24M15.54 8.46l4.24-4.24"/></svg>
          <p class="text-xs text-white/60 font-semibold uppercase tracking-wide mb-2">Budget</p>
          <p class="font-serif text-lg font-semibold text-med-gold">€50–100<br/><span class="text-xs">p.p.</span></p>
        </div>
      </div>

      <!-- SEO paragraph -->
      <div>
        <p class="text-lg text-slate-700 leading-relaxed">
          A perfect <strong>3-day classic itinerary</strong> on the <strong>Amalfi Coast</strong>: explore <strong>Positano</strong> with its colorful houses, <strong>Amalfi</strong> with its historic cathedral, <strong>Ravello</strong> with its villas and panoramic viewpoints, and the spectacular <strong>Emerald Grotto</strong>. All accessible by public transport.
        </p>
      </div>
    </section>

    <!-- Day by Day Itinerary -->
    <section>
      <h2 class="font-serif text-2xl font-semibold text-slate-900 mb-8">Day-by-Day Schedule</h2>
      <div class="space-y-6">
        {days.map((d, idx) => (
          <div class="bg-white border border-slate-200 rounded-2xl overflow-hidden hover:shadow-md transition-shadow">
            <div class="bg-slate-900 px-6 py-6 flex items-start gap-4 sm:items-center sm:gap-3">
              <span class="text-[10px] uppercase tracking-wide bg-white/15 text-white px-3 py-1.5 rounded-full font-bold flex-shrink-0">{d.day}</span>
              <h3 class="font-serif font-semibold text-white text-lg">{d.title}</h3>
            </div>
            <ul class="px-6 py-5 space-y-3">
              {d.items.map((item, itemIdx) => {
                const isLocalTip = item.includes('Local tip:');
                const displayText = item.replace('Local tip: ', '');
                const isLastItem = itemIdx === d.items.length - 1;
                return (
                  <li key={itemIdx} class={`flex gap-3 text-sm relative ${isLocalTip ? 'bg-med-gold/10 p-3 rounded-lg border border-med-gold/20' : ''}`}>
                    <div class="flex flex-col items-center">
                      {isLocalTip ? (
                        <svg class="w-5 h-5 text-med-gold flex-shrink-0 self-center" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
                          <circle cx="12" cy="8" r="5"/>
                          <path d="M12 13v2"/>
                          <rect x="10" y="15" width="4" height="3" rx="0.5"/>
                        </svg>
                      ) : (
                        <span class="w-2 h-2 rounded-full bg-med-blue flex-shrink-0"></span>
                      )}
                      {!isLastItem && <div class="w-0.5 h-6 bg-med-blue/30 mt-1"></div>}
                    </div>
                    <span class={`leading-relaxed ${isLocalTip ? 'font-semibold text-slate-800' : 'text-slate-700'}`}>
                      {isLocalTip && <strong>Local tip: </strong>}
                      {displayText}
                    </span>
                  </li>
                );
              })}
            </ul>
          </div>
        ))}
      </div>
    </section>

    <!-- Destinations Highlighted -->
    <section>
      <h2 class="font-serif text-2xl font-semibold text-slate-900 mb-8">Highlights of the itinerary</h2>
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4">
        {destinationHighlights.map((dest) => (
          <a href={dest.url} class="group block bg-white border border-slate-200 rounded-2xl p-5 hover:shadow-lg hover:border-med-blue/30 transition-all">
            <h3 class="font-semibold text-charcoal mb-2 group-hover:text-med-blue transition-colors">{dest.name}</h3>
            <p class="text-xs text-slate-500 leading-relaxed mb-3">{dest.desc}</p>
            <span class="text-xs font-semibold text-med-blue inline-flex items-center gap-1 group-hover:gap-2 transition-all">
              Discover →
            </span>
          </a>
        ))}
      </div>
    </section>

    <!-- Planning Tips -->
    <section class="bg-med-cream border border-med-gold/20 rounded-[2rem] p-6">
      <h2 class="font-serif text-xl font-semibold text-charcoal mb-6">Practical tips</h2>
      <ul class="space-y-4">
        {[
          { num: '❶', text: 'Base in Amalfi: central location, cheaper than Positano, excellent bus and ferry connections.' },
          { num: '❷', text: 'Buy SITA bus tickets in bulk (at a tobacconist) on arrival: saves time every morning.' },
          { num: '❸', text: 'Ravello has no beaches but is the finest viewpoint on the Coast: give it at least half a day.' },
          { num: '❹', text: 'A boat tour on day 3 is optional but transforms the experience: book the day before.' },
          { num: '❺', text: 'In summer: move by 9:00 to avoid packed buses and queues at the sites.' },
        ].map(({ num, text }) => (
          <li class="flex items-start gap-4 text-sm text-charcoal">
            <span class="text-2xl font-bold text-white flex-shrink-0 leading-none mt-0.5 bg-[#E2725B] w-9 h-9 flex items-center justify-center rounded-full">{num}</span>
            <span class="leading-relaxed">{text}</span>
          </li>
        ))}
      </ul>
    </section>

    <!-- FAQ -->
    <section id="faq">
      <h2 class="font-serif text-2xl font-semibold text-slate-900 mb-6">Frequently Asked Questions</h2>
      <div class="space-y-4">
        {faqSchema.mainEntity.map((q) => (
          <details class="group border border-slate-200 rounded-2xl overflow-hidden">
            <summary class="flex items-center justify-between px-6 py-4 cursor-pointer select-none text-charcoal font-medium hover:bg-slate-50 transition-colors">
              {q.name}
              <svg class="w-4 h-4 text-slate-400 group-open:rotate-180 transition-transform flex-shrink-0 ml-3" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
            </summary>
            <div class="px-6 pb-5 text-slate-600 leading-relaxed text-sm border-t border-slate-100 pt-4">
              {q.acceptedAnswer.text}
            </div>
          </details>
        ))}
      </div>
    </section>

    <!-- CTA -->
    <section class="bg-gradient-to-r from-med-blue to-med-blue/80 rounded-2xl p-10 text-center text-white">
      <h2 class="font-serif text-3xl font-bold mb-3">Ready to go?</h2>
      <p class="text-white/90 mb-6 max-w-2xl mx-auto">
        Read the complete guide to public transport on the Coast: how to get there, schedules, tickets and money-saving strategies.
      </p>
      <a href="/en-us/guide/how-to-get-there/" class="inline-block bg-white text-med-blue font-semibold px-8 py-3 rounded-full hover:bg-slate-100 transition-colors">
        Transport guide →
      </a>
    </section>

  </div>

</BaseLayout>
