---
import BaseLayout from '../../../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../../../components/Breadcrumbs.astro';

const lang = 'en-us';

const breadcrumbs = [
  { name: 'Home', url: '/en-us/' },
  { name: 'Planning', url: '/en-us/planning/' },
  { name: 'Islands: Ischia & Procida - 3 days', url: '/en-us/itineraries/3-days/islands-ischia-procida/' },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Which is better for a weekend, Ischia or Procida?",
      "acceptedAnswer": { "@type": "Answer", "text": "It depends on what you're looking for: Ischia is large (46 km²), with thermal spas, varied beaches, castles and nightlife - it needs at least 2 days. Procida is small (4 km²), authentic, with iconic pastel colours, fishermen and few crowds. With 3 days you can spend 2 nights on Ischia and make a day trip to Procida." }
    },
    {
      "@type": "Question",
      "name": "How do you get to Ischia and Procida from Naples?",
      "acceptedAnswer": { "@type": "Answer", "text": "From Naples Beverello: hydrofoil to Ischia Porto (~50 min, €20–24) or ferry (~75 min, €12–14). For Procida: hydrofoil from Naples (~35 min, €15–18). From Pozzuoli: Medmar/Caremar ferry to Ischia and Procida, cheaper (~€10–13). Book online in summer." }
    }
  ]
};

const days = [
  {
    day: 'Day 1',
    title: 'Arrival in Ischia',
    items: [
      'Ferry or hydrofoil from Naples Beverello to Ischia Porto (50–75 min).',
      'Check-in. Afternoon: Ischia Ponte and the Aragonese Castle (entry ~€24, 2h).',
      'Maronti Beach (longest on the island, black volcanic sand) or aperitivo in Forio.',
      'Dinner in Lacco Ameno or Ischia Porto: Ischian cuisine, rabbit Ischian-style.',
    ],
  },
  {
    day: 'Day 2',
    title: 'Thermal Spas and Beaches',
    items: [
      'Morning: thermal gardens (Poseidon or Negombo, ~€35–40 entry). Thermal pools, saunas.',
      'Afternoon: Citara Beach (Forio), one of the island\'s finest.',
      'Sunset from the Sant\'Angelo belvedere, Ischia\'s most picturesque village.',
      'Dinner in Sant\'Angelo or return to Ischia Porto.',
    ],
  },
  {
    day: 'Day 3',
    title: 'Day Trip to Procida',
    items: [
      'Hydrofoil from Ischia to Procida (20 min, ~€9). First service 08:00.',
      'Marina Corricella: the fishermen\'s harbour, pastel-coloured houses, bar on the jetty.',
      'Terra Murata: the highest medieval village on the island, views over the Gulf.',
      'Pozzo Vecchio Beach (the beach from The Postman) for a midday swim.',
      'Return to Naples by hydrofoil from Procida (35 min).',
    ],
  },
];
---

<BaseLayout
  title="Ischia and Procida in 3 Days 2026 | Naples Gulf Islands Itinerary"
  description="3-day itinerary across Ischia and Procida: thermal spas, volcanic beaches, Marina Corricella and Aragonese Castle. How to get there, where to stay and what to see."
  lang={lang}
  breadcrumbs={breadcrumbs}
  schema={[faqSchema]}
 pageKey="islands-ischia-procida">

  <section class="relative bg-charcoal overflow-hidden">
    <img src="/images/isole-hero.jpg" alt="Ischia and Procida, Gulf of Naples" class="absolute inset-0 w-full h-full object-cover opacity-30" loading="eager" referrerpolicy="no-referrer"/>

    <div class="absolute inset-0 bg-gradient-to-b from-black/60 via-black/40 to-black/70"></div>
    <div class="relative max-w-editorial mx-auto px-4 sm:px-6 lg:px-8 py-20">
      <div class="max-w-3xl">
        <p class="text-med-gold text-xs sm:text-sm font-medium uppercase tracking-[0.3em] mb-3">Itinerary · 3 days</p>
        <h1 class="font-serif text-display text-white mb-4">Islands: Ischia & Procida</h1>
        <p class="text-xl text-white/80 leading-relaxed max-w-2xl">
          Capri, Ischia and Procida in three days. Wild archipelagos and cultural stories.
        </p>
      </div>
    </div>
    <Breadcrumbs breadcrumbs={breadcrumbs} />
  </section>

  <div class="max-w-editorial mx-auto px-4 sm:px-6 lg:px-8 py-16 space-y-16">

    <!-- Intro Section -->
    <section class="text-center mb-2 -mt-3">
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-2 sm:gap-4 mb-6 overflow-x-auto snap-x snap-mandatory sm:overflow-visible pb-2 sm:pb-0">
        <!-- Box 1: Duration -->
        <div class="w-full bg-slate-900 rounded-2xl p-4 sm:p-6 hover:shadow-md transition-shadow flex flex-col items-center justify-center aspect-square snap-start">
          <svg class="w-8 h-8 text-med-gold mb-3" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg>
          <p class="text-xs text-white/60 font-semibold uppercase tracking-wide mb-2">Duration</p>
          <p class="font-serif text-lg font-semibold text-med-gold">3 days</p>
        </div>
        <!-- Box 2: Bases -->
        <div class="w-full bg-slate-900 rounded-2xl p-4 sm:p-6 hover:shadow-md transition-shadow flex flex-col items-center justify-center aspect-square snap-start">
          <svg class="w-8 h-8 text-med-gold mb-3" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
          <p class="text-xs text-white/60 font-semibold uppercase tracking-wide mb-2">Bases</p>
          <p class="font-serif text-lg font-semibold text-med-gold">Ischia Porto<br/>Forio</p>
        </div>
        <!-- Box 3: Transport -->
        <div class="w-full bg-slate-900 rounded-2xl p-4 sm:p-6 hover:shadow-md transition-shadow flex flex-col items-center justify-center aspect-square snap-start">
          <svg class="w-8 h-8 text-med-gold mb-3" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M6 9l6-6 6 6M5 9v9a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V9M9 14h6"/></svg>
          <p class="text-xs text-white/60 font-semibold uppercase tracking-wide mb-2">Transport</p>
          <p class="font-serif text-lg font-semibold text-med-gold">Hydrofoils<br/>Island bus</p>
        </div>
        <!-- Box 4: Budget -->
        <div class="w-full bg-slate-900 rounded-2xl p-4 sm:p-6 hover:shadow-md transition-shadow flex flex-col items-center justify-center aspect-square snap-start">
          <svg class="w-8 h-8 text-med-gold mb-3" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><circle cx="12" cy="12" r="1"/><path d="M12 1v6M12 17v6M4.22 4.22l4.24 4.24M15.54 15.54l4.24 4.24M1 12h6M17 12h6M4.22 19.78l4.24-4.24M15.54 8.46l4.24-4.24"/></svg>
          <p class="text-xs text-white/60 font-semibold uppercase tracking-wide mb-2">Budget</p>
          <p class="font-serif text-lg font-semibold text-med-gold">€60–120<br/><span class="text-xs">p.p.</span></p>
        </div>
      </div>

      <!-- SEO paragraph -->
      <div>
        <p class="text-lg text-slate-700 leading-relaxed">
          Explore the <strong>Gulf of Naples islands</strong> in <strong>3 days</strong>: spend time on <strong>Ischia</strong> enjoying thermal spas, volcanic black sand beaches, and charming harbors, then take a day trip to <strong>Procida</strong> with its iconic pastel-colored houses and authentic fishermen's villages. All easily accessible by hydrofoil and island buses.
        </p>
      </div>
    </section>

    <section>
      <h2 class="font-serif text-2xl font-semibold text-slate-900 mb-8">Day-by-Day Schedule</h2>
      <div class="space-y-8">
        {days.map(d => (
          <div class="bg-white border border-slate-200 rounded-2xl overflow-hidden">
            <div class="bg-med-blue/5 px-6 py-4 flex items-center gap-3">
              <span class="text-[10px] uppercase tracking-wide bg-med-blue text-white px-2 py-1 rounded-full font-medium">{d.day}</span>
              <h3 class="font-semibold text-charcoal">{d.title}</h3>
            </div>
            <ul class="px-6 py-4 space-y-2">
              {d.items.map(item => (
                <li class="flex items-start gap-2 text-xs sm:text-sm text-charcoal">
                  <span class="w-1.5 h-1.5 rounded-full bg-med-blue/50 mt-1.5 flex-shrink-0"></span>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </section>

    <section class="bg-med-cream border border-med-gold/20 rounded-[2rem] p-8">
      <p class="font-semibold text-charcoal text-lg mb-3">Practical Tips</p>
      <ul class="space-y-2">
        {[
          'On Ischia the circular bus (CS/CD) runs all day: single ~€1.50, day pass ~€6.',
          'Book the thermal gardens online: Poseidon and Negombo sell out in summer.',
          'Procida as a day trip: take the first hydrofoil (08:00) to have time before the crowds arrive.',
          'Ischia off-season (October–November): spas open, few tourists, low prices.',
          'The hydrofoil doesn\'t run in rough seas: check the weather before booking.',
        ].map(tip => (
          <li class="flex items-start gap-2 text-xs sm:text-sm text-charcoal">
            <span class="w-1.5 h-1.5 rounded-full bg-med-cream0 mt-1.5 flex-shrink-0"></span>
            <span>{tip}</span>
          </li>
        ))}
      </ul>
    </section>

    <section id="faq">
      <h2 class="font-serif text-2xl font-semibold text-slate-900 mb-6">Frequently Asked Questions</h2>
      <div class="space-y-4">
        {faqSchema.mainEntity.map((q) => (
          <details class="group border border-slate-200 rounded-2xl overflow-hidden">
            <summary class="flex items-center justify-between px-6 py-4 cursor-pointer select-none text-charcoal font-medium hover:bg-slate-50 transition-colors">
              {q.name}
              <svg class="w-4 h-4 text-slate-400 group-open:rotate-180 transition-transform flex-shrink-0 ml-3" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
            </summary>
            <div class="px-6 pb-5 text-slate-600 leading-relaxed text-xs sm:text-sm border-t border-slate-100 pt-4">
              {q.acceptedAnswer.text}
            </div>
          </details>
        ))}
      </div>
    </section>

  </div>

</BaseLayout>
