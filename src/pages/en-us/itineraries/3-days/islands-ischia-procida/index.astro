---
import BaseLayout from '../../../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../../../components/Breadcrumbs.astro';

const lang = 'en-us';

const breadcrumbs = [
  { name: 'Home', url: '/en-us/' },
  { name: 'Planning', url: '/en-us/planning/' },
  { name: 'Islands: Ischia & Procida - 3 days', url: '/en-us/itineraries/3-days/islands-ischia-procida/' },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Which is better for a weekend, Ischia or Procida?",
      "acceptedAnswer": { "@type": "Answer", "text": "It depends on what you're looking for: Ischia is large (46 km²), with thermal spas, varied beaches, castles and nightlife - it needs at least 2 days. Procida is small (4 km²), authentic, with iconic pastel colours, fishermen and few crowds. With 3 days you can spend 2 nights on Ischia and make a day trip to Procida." }
    },
    {
      "@type": "Question",
      "name": "How do you get to Ischia and Procida from Naples?",
      "acceptedAnswer": { "@type": "Answer", "text": "From Naples Beverello: hydrofoil to Ischia Porto (~50 min, €20–24) or ferry (~75 min, €12–14). For Procida: hydrofoil from Naples (~35 min, €15–18). From Pozzuoli: Medmar/Caremar ferry to Ischia and Procida, cheaper (~€10–13). Book online in summer." }
    }
  ]
};

const days = [
  {
    day: 'Day 1',
    title: 'Arrival in Ischia',
    highlight: 'Aragonese Castle and first swim',
    items: [
      'Ferry or hydrofoil from Naples Beverello to Ischia Porto (50–75 min, €12–24).',
      'Check-in hotel. Rest from travel.',
      'Afternoon: Ischia Ponte and the Aragonese Castle (entry ~€10, 360° views of the Gulf). Rent a lounger on the small beach at Ischia Ponte.',
      'Aperitivo in Forio (northwest) or Lacco Ameno (north): harbourside bar, first taste of the coast.',
      'Dinner in Ischia Porto: restaurant on the harbour, Ischian specialities (rabbit Ischian-style, pasta with prawns).',
      'Local tip: parking is chaotic in August. Use paid public car parks, don\'t attempt the alleys.',
    ],
  },
  {
    day: 'Day 2',
    title: 'Thermal Spas and Beaches',
    highlight: 'Thermal parks and sunset at Sant\'Angelo',
    items: [
      'Morning: thermal park Poseidon or Negombo (~€35–40 entry). Thermal pools at different temperatures, natural saunas, open-sea hydromassages.',
      'Light lunch at the park (expensive but scenic) or descent to Citara for free beach with hot springs on the seabed (look for "sfizzi" = bubbles).',
      'Afternoon: Citara Beach in Forio (one of the finest, fine sand, clear sea). Lounger ~€15.',
      'Sunset from Sant\'Angelo belvedere (Ischia\'s most picturesque village: white houses stacked on the sea, tiny harbour bar, fishermen).',
      'Dinner at Sant\'Angelo in one of the 3 harbour trattorias (expensive, touristy, but unique) or return to Forio.',
      'Local tip: free natural hot springs (without park) are at Citara and under the rocks of Sant\'Angelo. Bring a float board to drift in the hot spring.',
    ],
  },
  {
    day: 'Day 3',
    title: 'Day Trip to Procida',
    highlight: 'Marina Corricella and The Postman beach',
    items: [
      'Early wake-up. Hydrofoil from Ischia Porto to Procida (20 min, ~€9). First service 08:00–08:30.',
      'Marina Corricella: the fishermen\'s harbour, pastel-coloured houses (yellow, blue, pink), coloured boats, tiny harbour bar with fresh limoncello. The most photogenic sight in the Gulf.',
      'Terra Murata: the medieval village clinging to the cliff, narrow alleys, 360° views of the Gulf and other islands. Church of Santa Maria Assunta (majolica tiles, beautiful interior).',
      'Pozzo Vecchio Beach (famous from "The Postman" film): small cove but beautiful, sand and pebbles. Midday swim with coast views.',
      'Lunch at the harbour in a simple trattoria: pasta with anchovies, seafood salad, local white wine.',
      'Return to Naples by hydrofoil from Procida (35 min, 16:00–17:00 last services).',
      'Local tip: Procida is tiny. Don\'t rent a car. Walk or e-scooter. Marina Corricella is the heart: spend at least 2–3 hours there.',
    ],
  },
];
---

<BaseLayout
  title="Ischia and Procida in 3 Days 2026 | Naples Gulf Islands Itinerary"
  description="3-day itinerary across Ischia and Procida: thermal spas, volcanic beaches, Marina Corricella and Aragonese Castle. How to get there, where to stay and what to see."
  lang={lang}
  breadcrumbs={breadcrumbs}
  schema={[faqSchema]}
 pageKey="islands-ischia-procida">

  <section class="relative bg-charcoal overflow-hidden">
    <img src="/images/isole-hero.jpg" alt="Ischia and Procida, Gulf of Naples" class="absolute inset-0 w-full h-full object-cover opacity-30" loading="eager" referrerpolicy="no-referrer"/>

    <div class="absolute inset-0 bg-gradient-to-b from-black/75 via-black/40 to-black/70"></div>
    <div class="relative max-w-editorial mx-auto px-4 sm:px-6 lg:px-8 py-20">
      <div class="max-w-3xl">
        <p class="text-med-gold text-xs sm:text-sm font-medium uppercase tracking-[0.3em] mb-3">Itinerary · 3 days</p>
        <h1 class="font-serif text-display text-white mb-4">Islands: Ischia & Procida</h1>
        <p class="text-xl text-white/80 leading-relaxed max-w-2xl">
          Capri, Ischia and Procida in three days. Wild archipelagos and cultural stories.
        </p>
      </div>
    </div>
    <Breadcrumbs breadcrumbs={breadcrumbs} />
  </section>

  <div class="max-w-editorial mx-auto px-4 sm:px-6 lg:px-8 py-16 space-y-16">

    <!-- Intro Section -->
    <section class="text-center mb-2">
      <div>
        <p class="text-lg text-slate-700 leading-relaxed">
          Explore the <strong>Gulf of Naples islands</strong> in <strong>3 days</strong>: spend time on <strong>Ischia</strong> enjoying thermal spas, volcanic black sand beaches, and charming harbors, then take a day trip to <strong>Procida</strong> with its iconic pastel-colored houses and authentic fishermen's villages. All easily accessible by hydrofoil and island buses.
        </p>
      </div>
    </section>

    <section>
      <h2 class="font-serif text-2xl font-semibold text-slate-900 mb-8">Day-by-Day Schedule</h2>
      <div class="space-y-6">
        {days.map(d => (
          <div class="bg-white border border-slate-200 rounded-2xl overflow-hidden hover:shadow-md transition-shadow">
            <div class="bg-slate-900 px-6 py-6 flex items-start gap-4 sm:items-center sm:gap-3">
              <span class="text-[10px] uppercase tracking-wide bg-white/15 text-white px-3 py-1.5 rounded-full font-bold flex-shrink-0">{d.day}</span>
              <div class="flex-1 min-w-0">
                <h3 class="font-serif font-semibold text-white text-lg">{d.title}</h3>
                <p class="text-xs text-med-gold mt-1 font-medium">{d.highlight}</p>
              </div>
            </div>
            <ul class="px-6 py-5 space-y-3">
              {d.items.map((item, itemIdx) => {
                const isLocalTip = item.includes('Local tip:');
                const displayText = item.replace('Local tip: ', '');
                const isLastItem = itemIdx === d.items.length - 1;
                return (
                  <li key={itemIdx} class={`flex gap-3 text-sm relative ${isLocalTip ? 'bg-med-gold/10 p-3 rounded-lg border border-med-gold/20' : ''}`}>
                    <div class="flex flex-col items-center">
                      {isLocalTip ? (
                        <svg class="w-5 h-5 text-med-gold flex-shrink-0 self-center" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
                          <circle cx="12" cy="8" r="5"/>
                          <path d="M12 13v2"/>
                          <rect x="10" y="15" width="4" height="3" rx="0.5"/>
                        </svg>
                      ) : (
                        <span class="w-2 h-2 rounded-full bg-med-blue flex-shrink-0"></span>
                      )}
                      {!isLastItem && <div class="w-0.5 h-6 bg-med-blue/30 mt-1"></div>}
                    </div>
                    <span class={`leading-relaxed ${isLocalTip ? 'font-semibold text-slate-800' : 'text-slate-700'}`}>
                      {isLocalTip && <strong>Local tip: </strong>}
                      {displayText}
                    </span>
                  </li>
                );
              })}
            </ul>
          </div>
        ))}
      </div>
    </section>

    <section class="bg-med-cream border border-med-gold/20 rounded-[2rem] p-8">
      <p class="font-semibold text-charcoal text-lg mb-3">Practical Tips</p>
      <ul class="space-y-2">
        {[
          'On Ischia the circular bus (CS/CD) runs all day: single ~€1.50, day pass ~€6.',
          'Book the thermal gardens online: Poseidon and Negombo sell out in summer.',
          'Procida as a day trip: take the first hydrofoil (08:00) to have time before the crowds arrive.',
          'Ischia off-season (October–November): spas open, few tourists, low prices.',
          'The hydrofoil doesn\'t run in rough seas: check the weather before booking.',
        ].map(tip => (
          <li class="flex items-start gap-2 text-xs sm:text-sm text-charcoal">
            <span class="w-1.5 h-1.5 rounded-full bg-med-cream0 mt-1.5 flex-shrink-0"></span>
            <span>{tip}</span>
          </li>
        ))}
      </ul>
    </section>

    <section id="faq">
      <h2 class="font-serif text-2xl font-semibold text-slate-900 mb-6">Frequently Asked Questions</h2>
      <div class="space-y-4">
        {faqSchema.mainEntity.map((q) => (
          <details class="group border border-slate-200 rounded-2xl overflow-hidden">
            <summary class="flex items-center justify-between px-6 py-4 cursor-pointer select-none text-charcoal font-medium hover:bg-slate-50 transition-colors">
              {q.name}
              <svg class="w-4 h-4 text-slate-400 group-open:rotate-180 transition-transform flex-shrink-0 ml-3" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
            </summary>
            <div class="px-6 pb-5 text-slate-600 leading-relaxed text-xs sm:text-sm border-t border-slate-100 pt-4">
              {q.acceptedAnswer.text}
            </div>
          </details>
        ))}
      </div>
    </section>

    <!-- CTA -->
    <section class="bg-gradient-to-r from-med-blue to-med-blue/80 rounded-2xl p-10 text-center text-white">
      <h2 class="font-serif text-3xl font-bold mb-3">Ready to explore the islands?</h2>
      <p class="text-white/90 mb-6 max-w-2xl mx-auto">
        Read the complete guide to ferries and hydrofoils: schedules, prices, companies and money-saving strategies from Naples.
      </p>
      <a href="/en-us/guide/ferries/" class="inline-block bg-white text-med-blue font-semibold px-8 py-3 rounded-full hover:bg-slate-100 transition-colors">
        Ferry guide →
      </a>
    </section>

  </div>

</BaseLayout>
