---
import BaseLayout from '../../../../../layouts/BaseLayout.astro';
import CorrelationSlider from '../../../../../components/CorrelationSlider.astro';
import Breadcrumbs from '../../../../../components/Breadcrumbs.astro';

const lang = 'en-us';

const breadcrumbs = [
  { name: 'Home', url: '/en-us/' },
  { name: 'Planning', url: '/en-us/planning/' },
  { name: 'Path of the Gods Trek', url: '/en-us/itineraries/1-day/path-of-the-gods-trek/' },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "How do you do the Path of the Gods in a day trip from Naples?",
      "acceptedAnswer": { "@type": "Answer", "text": "Leave Naples on the Circumvesuviana to Sorrento (70 min), then SITA bus to Amalfi (90 min), then local bus to Bomerano/Agerola (45 min). The Bomerano→Nocelle trail is 7.8 km, 3–4h. From Nocelle take the local bus to Positano (15 min), then SITA bus or ferry to Sorrento and Circumvesuviana back to Naples." }
    },
    {
      "@type": "Question",
      "name": "Do you need to book the Path of the Gods in advance?",
      "acceptedAnswer": { "@type": "Answer", "text": "In high season (July–August) the Path of the Gods requires mandatory booking on the Parco dei Monti Lattari portal. The fee is nominal (~€5). Outside peak season no booking is required. Always check conditions on the official website before setting out." }
    },
    {
      "@type": "Question",
      "name": "What should you bring for the Path of the Gods?",
      "acceptedAnswer": { "@type": "Answer", "text": "Essential: hiking boots (not sandals or smooth-soled trainers), at least 1.5L of water, sunscreen, a hat. The trail has no water sources or shops. Bring a snack. In spring/autumn a light jacket is advisable for the wind at altitude." }
    },
    {
      "@type": "Question",
      "name": "Is the Path of the Gods dangerous?",
      "acceptedAnswer": { "@type": "Answer", "text": "The Path of the Gods is not dangerous for reasonably fit hikers with proper footwear. It is graded E/EE (moderate hiking). Exposed sections have low walls or railings. Avoid hiking in rain (slippery surface). Not recommended for those with vertigo or children under 6." }
    },
    {
      "@type": "Question",
      "name": "How long does the Path of the Gods take?",
      "acceptedAnswer": { "@type": "Answer", "text": "The classic Bomerano→Nocelle route is 7.8 km and takes 3–4 hours at a moderate pace with photo stops. The high-level variant (Sentiero degli Dei Alto) adds about 2 km and 1 hour. From Nocelle to Positano add 45 minutes on foot (1,700 steps) or 15 minutes by bus." }
    },
    {
      "@type": "Question",
      "name": "Is the Path of the Gods free?",
      "acceptedAnswer": { "@type": "Answer", "text": "From July to August a mandatory booking (~€5) is required via the Parco dei Monti Lattari portal. The rest of the year access is free. The fee covers trail maintenance and rescue services." }
    }
  ]
};

const hikingTrailSchema = {
  "@context": "https://schema.org",
  "@type": "TouristAttraction",
  "name": "Path of the Gods (Sentiero degli Dei)",
  "description": "Stunning 7.8 km coastal hiking trail from Bomerano (Agerola) to Nocelle (Positano) on the Amalfi Coast, with breathtaking views of the sea and Capri.",
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": 40.6389,
    "longitude": 14.5472
  },
  "touristType": ["Hiking", "Nature", "Adventure"],
  "isAccessibleForFree": false,
  "address": {
    "@type": "PostalAddress",
    "addressLocality": "Agerola",
    "addressRegion": "Campania",
    "addressCountry": "IT"
  }
};

const schedule = [
  { time: '07:00', place: 'Naples', action: 'Circumvesuviana to Sorrento (70 min, ~€3.90)', transport: 'train' },
  { time: '08:15', place: 'Sorrento', action: 'SITA bus to Amalfi (90 min, ~€3.50) - the 8:30 service', transport: 'bus' },
  { time: '10:00', place: 'Amalfi', action: 'Local bus to Bomerano, Agerola hamlet (45 min, ~€1.50). Start of trail.', transport: 'bus' },
  { time: '11:00', place: 'Bomerano, Agerola (618 m)', action: 'Departure on the Path of the Gods. 7.8 km, ~500 m descent, E/EE grade. Breathtaking scenery.', transport: 'walk' },
  { time: '14:30', place: 'Nocelle', action: 'Arrival at Nocelle. Break and lunch at one of the local rifugios/bars.', transport: 'visit' },
  { time: '15:15', place: 'Nocelle → Positano', action: 'Local bus to Positano centre (15 min, ~€1.50) or on foot (~1,000 steps, 45 min)', transport: 'bus' },
  { time: '16:00', place: 'Positano', action: 'Stroll, gelato, beach (1h free time)', transport: 'visit' },
  { time: '17:15', place: 'Positano → Naples', action: 'SITA bus to Sorrento (~50 min), then Circumvesuviana to Naples (70 min)', transport: 'bus' },
];

const tips = [
  'Best season: April–June and September–October. July–August is very hot and crowded.',
  'The bus from Amalfi to Bomerano (Agerola) has limited services: check timetables on eavsrl.it the evening before.',
  'Always hike in the Bomerano→Nocelle direction: almost entirely downhill, signage designed for this way.',
  'The trail has no water points: bring at least 1.5L. The last bar is in Bomerano square before you set off.',
  'From Nocelle you can descend to Positano on foot (~1,000 steps, 45 min) or by bus (15 min, ~€1.50).',
];

const transportBadge: Record<string, { label: string; cls: string }> = {
  train: { label: 'TRAIN', cls: 'bg-orange-100 text-orange-700' },
  ferry: { label: 'FERRY', cls: 'bg-blue-100 text-blue-700' },
  bus:   { label: 'BUS', cls: 'bg-green-100 text-green-700' },
  walk:  { label: 'TREK', cls: 'bg-red-100 text-red-700' },
  visit: { label: '', cls: '' },
};

const destinationHighlights = [
  { name: 'Positano', desc: '', url: '/en-us/amalfi-coast/positano/' },
  { name: 'Praiano', desc: '', url: '/en-us/amalfi-coast/praiano/' },
  { name: 'Amalfi', desc: '', url: '/en-us/amalfi-coast/amalfi/' },
];
---

<BaseLayout
  title="Path of the Gods 2026: Map, Difficulty, Bomerano–Nocelle Trail Guide"
  description="Complete guide to the Path of the Gods (Sentiero degli Dei): trail map, difficulty level, is it dangerous?, booking, how to get there from Naples. 7.8 km Bomerano→Nocelle hike on the Amalfi Coast."
  lang={lang}
  breadcrumbs={breadcrumbs}
  schema={[faqSchema, hikingTrailSchema]}
 pageKey="path-of-the-gods-trek"
  heroImage="/images/trekking-hero.jpg"
>

  <!-- Hero Section -->
  <section class="relative bg-charcoal overflow-hidden min-h-[70vh] sm:min-h-[75vh] flex items-center justify-center">
    <img src="/images/trekking-hero.jpg" alt="Path of the Gods, Amalfi Coast" class="absolute inset-0 w-full h-full object-cover opacity-30" loading="eager" fetchpriority="high" decoding="sync" referrerpolicy="no-referrer"/>
    <div class="absolute inset-0 bg-gradient-to-b from-black/20 via-black/40 to-black/80"></div>
    <div class="relative max-w-editorial mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <div class="max-w-3xl mx-auto">
        <p class="text-med-gold text-xs sm:text-sm font-medium uppercase tracking-[0.3em] mb-3">Itinerary · Trek · 1 day</p>
        <h1 class="font-serif text-display text-white mb-4">Path of the Gods Trek</h1>
        <p class="text-xl text-white/80 leading-relaxed max-w-2xl mx-auto">
          Agerola to Nocelle: 8 km of breathtaking views over the Amalfi Coast. Train, bus and hiking from Naples in one day.
        </p>
      </div>
    </div>
    <Breadcrumbs breadcrumbs={breadcrumbs} />
  </section>

  <div class="max-w-editorial mx-auto px-4 sm:px-6 lg:px-8 pt-6 pb-10 space-y-10">

    <!-- Intro & Stats Section - Featured -->
    <section class="text-center mb-2">
      <!-- Quick Stats Grid - Scrollable on Mobile -->
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-2 sm:gap-4 mb-6 overflow-x-auto snap-x snap-mandatory sm:overflow-visible pb-2 sm:pb-0">
        <div class="w-full bg-slate-900 rounded-2xl p-4 sm:p-6 hover:shadow-md transition-shadow flex flex-col items-center justify-center aspect-square snap-start">
          <svg class="w-8 h-8 text-med-gold mb-3" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
            <rect x="3" y="4" width="18" height="18" rx="2"/>
            <path d="M16 2v4M8 2v4M3 10h18"/>
          </svg>
          <p class="text-xs text-white/60 font-semibold uppercase tracking-wide mb-2">Duration</p>
          <p class="font-serif text-lg font-semibold text-med-gold">1 day</p>
        </div>
        <div class="w-full bg-slate-900 rounded-2xl p-4 sm:p-6 hover:shadow-md transition-shadow flex flex-col items-center justify-center aspect-square snap-start">
          <svg class="w-8 h-8 text-med-gold mb-3" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
            <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/>
            <circle cx="12" cy="10" r="3"/>
          </svg>
          <p class="text-xs text-white/60 font-semibold uppercase tracking-wide mb-2">Base</p>
          <p class="font-serif text-lg font-semibold text-med-gold">Naples</p>
        </div>
        <div class="w-full bg-slate-900 rounded-2xl p-4 sm:p-6 hover:shadow-md transition-shadow flex flex-col items-center justify-center aspect-square snap-start">
          <svg class="w-8 h-8 text-med-gold mb-3" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
            <path d="M6 9l6-6 6 6M5 9v9a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V9M9 14h6"/>
          </svg>
          <p class="text-xs text-white/60 font-semibold uppercase tracking-wide mb-2">Transport</p>
          <p class="font-serif text-lg font-semibold text-med-gold">Train + Bus<br/>+ Trek</p>
        </div>
        <div class="w-full bg-slate-900 rounded-2xl p-4 sm:p-6 hover:shadow-md transition-shadow flex flex-col items-center justify-center aspect-square snap-start">
          <svg class="w-8 h-8 text-med-gold mb-3" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
            <circle cx="12" cy="12" r="1"/>
            <path d="M12 1v6M12 17v6M4.22 4.22l4.24 4.24M15.54 15.54l4.24 4.24M1 12h6M17 12h6M4.22 19.78l4.24-4.24M15.54 8.46l4.24-4.24"/>
          </svg>
          <p class="text-xs text-white/60 font-semibold uppercase tracking-wide mb-2">Transport budget</p>
          <p class="font-serif text-lg font-semibold text-med-gold">€12–18<br/><span class="text-xs">p.p.</span></p>
        </div>
      </div>

      <!-- SEO Text Below -->
      <div>
        <p class="text-lg text-slate-700 leading-relaxed">
          The <strong>Path of the Gods</strong> (Sentiero degli Dei) is the most famous hike on the <strong>Amalfi Coast</strong>: 7.8 km from <strong>Bomerano</strong> (Agerola) to <strong>Nocelle</strong>, mostly downhill, with jaw-dropping views of Capri and the coastline. Difficulty: E/EE, suitable for hikers with basic fitness. From Naples allow about 4 hours to reach the trailhead (Circumvesuviana + SITA bus + local bus). The hike takes 3–4 hours at a moderate pace. <strong>Mandatory booking in July–August</strong> (~€5). Transport budget: €12–18.
        </p>
      </div>
    </section>


    <!-- Day by Day Itinerary -->
    <section>
      <h2 class="font-serif text-2xl font-semibold text-slate-900 mb-8">Day schedule</h2>
      <div class="bg-white border border-slate-200 rounded-2xl overflow-hidden">
        <div class="px-6 py-8 space-y-6">
          {schedule.map((item, idx) => {
            const badge = transportBadge[item.transport];
            const isLastItem = idx === schedule.length - 1;
            return (
              <div class="flex gap-4">
                <div class="flex flex-col items-center flex-shrink-0">
                  <div class="w-16 bg-slate-900 text-med-gold rounded-full px-2 py-1 text-center text-sm font-semibold flex items-center justify-center">
                    {item.time}
                  </div>
                  {!isLastItem && <div class="w-0.5 h-12 bg-med-blue/30 mt-2"></div>}
                </div>
                <div class="pb-4 flex-1">
                  <p class="font-semibold text-slate-900 mb-1">{item.place}</p>
                  <p class="text-slate-700 text-sm mb-2">{item.action}</p>
                  {badge.label && (
                    <span class={`text-xs font-semibold px-2 py-1 rounded-full ${badge.cls}`}>
                      {badge.label}
                    </span>
                  )}
                </div>
              </div>
            );
          })}
        </div>
      </div>
    </section>

    <!-- Trail Map -->
    <section id="map">
      <h2 class="font-serif text-2xl font-semibold text-slate-900 mb-4">Path of the Gods trail map</h2>
      <p class="text-slate-600 mb-6 leading-relaxed">The trail starts at <strong>Piazza Paolo Capasso in Bomerano</strong> (a hamlet of Agerola, 618 m a.s.l.) and follows CAI trail n. 327 westward along the Lattari Mountains ridge, ending at <strong>Nocelle</strong> (420 m a.s.l.), the upper hamlet of Positano. The path is marked with red-and-white CAI blazes.</p>
      <div class="rounded-2xl overflow-hidden border border-slate-200">
        <iframe
          src="https://www.openstreetmap.org/export/embed.html?bbox=14.475%2C40.618%2C14.565%2C40.655&layer=mapnik&marker=40.638%2C14.547"
          width="100%"
          height="450"
          style="border:0;"
          allowfullscreen=""
          loading="lazy"
          title="Path of the Gods trail map: Bomerano to Nocelle route">
        </iframe>
      </div>
      <div class="mt-4 grid grid-cols-1 sm:grid-cols-3 gap-3">
        <div class="bg-slate-50 rounded-xl p-4 text-center">
          <p class="text-xs text-slate-500 uppercase tracking-wide mb-1">Start</p>
          <p class="font-semibold text-slate-900">Bomerano (618 m)</p>
          <p class="text-xs text-slate-500">Piazza Paolo Capasso</p>
        </div>
        <div class="bg-slate-50 rounded-xl p-4 text-center">
          <p class="text-xs text-slate-500 uppercase tracking-wide mb-1">End</p>
          <p class="font-semibold text-slate-900">Nocelle (420 m)</p>
          <p class="text-xs text-slate-500">Piazzetta di Nocelle</p>
        </div>
        <div class="bg-slate-50 rounded-xl p-4 text-center">
          <p class="text-xs text-slate-500 uppercase tracking-wide mb-1">Elevation</p>
          <p class="font-semibold text-slate-900">+200 m / −400 m</p>
          <p class="text-xs text-slate-500">Mostly downhill</p>
        </div>
      </div>
    </section>

    <!-- Difficulty & Safety -->
    <section id="difficulty">
      <h2 class="font-serif text-2xl font-semibold text-slate-900 mb-4">Difficulty and safety</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div class="bg-white border border-slate-200 rounded-2xl p-6">
          <h3 class="font-semibold text-slate-900 mb-3 flex items-center gap-2">
            <span class="w-8 h-8 bg-green-100 text-green-700 rounded-full flex items-center justify-center text-sm font-bold">E</span>
            Grade: E / EE (moderate)
          </h3>
          <p class="text-slate-600 text-sm leading-relaxed mb-3">
            The Path of the Gods is graded <strong>E</strong> (hiking) with some <strong>EE</strong> (experienced hiker) sections. No ropes, crampons or climbing gear required. The surface is dirt and rock with stone-cut steps in places.
          </p>
          <ul class="text-sm text-slate-600 space-y-1">
            <li class="flex items-start gap-2"><span class="text-green-600 mt-0.5">&#10003;</span> No via ferrata or scrambling sections</li>
            <li class="flex items-start gap-2"><span class="text-green-600 mt-0.5">&#10003;</span> Clear CAI red-and-white trail blazes</li>
            <li class="flex items-start gap-2"><span class="text-green-600 mt-0.5">&#10003;</span> Exposed sections have low walls or railings</li>
          </ul>
        </div>
        <div class="bg-white border border-slate-200 rounded-2xl p-6">
          <h3 class="font-semibold text-slate-900 mb-3 flex items-center gap-2">
            <span class="w-8 h-8 bg-amber-100 text-amber-700 rounded-full flex items-center justify-center text-sm font-bold">!</span>
            Is the Path of the Gods dangerous?
          </h3>
          <p class="text-slate-600 text-sm leading-relaxed mb-3">
            <strong>No, with the right gear and basic fitness.</strong> The trail is safe for anyone wearing hiking boots and in reasonable shape. However, some caution is needed:
          </p>
          <ul class="text-sm text-slate-600 space-y-1">
            <li class="flex items-start gap-2"><span class="text-amber-600 mt-0.5">&#9888;</span> Rain makes the surface slippery: avoid hiking in wet weather</li>
            <li class="flex items-start gap-2"><span class="text-amber-600 mt-0.5">&#9888;</span> Cliff-edge sections: not recommended for those with vertigo</li>
            <li class="flex items-start gap-2"><span class="text-amber-600 mt-0.5">&#9888;</span> Not suitable for children under 6</li>
            <li class="flex items-start gap-2"><span class="text-amber-600 mt-0.5">&#9888;</span> Bring at least 1.5L of water (no fountains on the trail)</li>
          </ul>
        </div>
      </div>
    </section>

  </div>

  <CorrelationSlider
    heading="Itinerary destinations"
    lang="en-us"
    items={[
      { name: 'Positano', href: '/en-us/amalfi-coast/positano/', tag: 'Village & Beaches', desc: 'The trek\'s final destination, the jewel of the Amalfi Coast.' },
      { name: 'Amalfi', href: '/en-us/amalfi-coast/amalfi/', tag: 'Art & History', desc: 'Your gateway to the trail via bus to Bomerano.' },
      { name: 'Ravello', href: '/en-us/amalfi-coast/ravello/', tag: 'Music & Gardens', desc: 'The Terrace of Infinity, Villa Rufolo and panoramic views 350 m above the sea.' },
      { name: 'Praiano', href: '/en-us/amalfi-coast/praiano/', tag: 'Sunset & Quiet', desc: 'Close to Nocelle, stunning sunsets and the Gavitella beach.' },
    ]}
  />

  <div class="max-w-editorial mx-auto px-4 sm:px-6 lg:px-8 pb-10 space-y-10">

    <!-- Planning Tips -->
    <section class="bg-med-cream border border-med-gold/20 rounded-[2rem] p-6">
      <h2 class="font-serif text-xl font-semibold text-charcoal mb-6">Practical tips</h2>
      <ul class="space-y-4">
        {tips.map((text, idx) => {
          const nums = ['❶', '❷', '❸', '❹', '❺'];
          return (
            <li class="flex items-start gap-4 text-sm text-charcoal">
              <span class="text-2xl font-bold text-white flex-shrink-0 leading-none mt-0.5 bg-[#E2725B] w-9 h-9 flex items-center justify-center rounded-full">{nums[idx] || '•'}</span>
              <span class="leading-relaxed">{text}</span>
            </li>
          );
        })}
      </ul>
    </section>

    <!-- FAQ -->
    <section id="faq">
      <h2 class="font-serif text-2xl font-semibold text-slate-900 mb-6">Frequently asked questions</h2>
      <div class="space-y-4">
        {faqSchema.mainEntity.map((q) => (
          <details class="group border border-slate-200 rounded-2xl overflow-hidden">
            <summary class="flex items-center justify-between px-6 py-4 cursor-pointer select-none text-charcoal font-medium hover:bg-slate-50 transition-colors">
              {q.name}
              <svg class="w-4 h-4 text-slate-400 group-open:rotate-180 transition-transform flex-shrink-0 ml-3" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
            </summary>
            <div class="px-6 pb-5 text-slate-600 leading-relaxed text-sm border-t border-slate-100 pt-4">
              {q.acceptedAnswer.text}
            </div>
          </details>
        ))}
      </div>
    </section>

    <!-- BANNER: Itinerary Planner -->
    <section class="relative overflow-hidden rounded-[2rem] bg-gradient-to-br from-slate-900 via-slate-950 to-blue-950 px-6 sm:px-10 py-8 md:py-10 shadow-[0_20px_60px_rgba(0,0,0,0.35)]">
      <div class="absolute -top-20 -left-20 w-72 h-72 bg-blue-500/15 rounded-full blur-3xl pointer-events-none"></div>
      <div class="absolute -bottom-20 -right-20 w-72 h-72 bg-amber-500/10 rounded-full blur-3xl pointer-events-none"></div>
      <div class="relative z-10 md:flex md:items-center md:justify-between gap-8">
        <div>
          <span class="inline-block px-3 py-1 rounded-full text-[10px] font-semibold tracking-wide uppercase bg-med-gold/15 text-med-gold border border-med-gold/25 mb-4">New: Custom Trip Planner</span>
          <h2 class="text-2xl md:text-3xl font-bold text-white leading-tight mb-2">Design your <span class="font-serif italic text-med-blue">perfect itinerary</span></h2>
          <p class="text-white/60 text-sm md:text-base leading-relaxed max-w-xl">Answer a few simple questions and get a personalised itinerary with transport, costs and times.</p>
        </div>
        <div class="mt-6 md:mt-0 flex-shrink-0">
          <a href="/en-us/itinerary-planner/" class="inline-flex items-center gap-2.5 px-7 py-3.5 bg-gradient-to-r from-med-gold to-yellow-600 text-slate-900 font-bold rounded-xl hover:shadow-[0_0_30px_rgba(212,175,55,0.4)] hover:scale-105 transition-all duration-300">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 2L2 12l4 0 0 6 4 0 0-4 4 0 0 4 4 0 0-6 4 0L12 2z"/></svg>
            Plan Now
          </a>
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="bg-gradient-to-r from-med-blue to-med-blue/80 rounded-2xl p-10 text-center text-white">
      <h2 class="font-serif text-3xl font-bold mb-3">Explore the Amalfi Coast</h2>
      <p class="text-white/90 mb-6 max-w-2xl mx-auto">
        Complete guide to the Amalfi Coast: ferries, SITA buses, hiking trails and transport tips.
      </p>
      <a href="/en-us/amalfi-coast/" class="inline-block bg-white text-med-blue font-semibold px-8 py-3 rounded-full hover:bg-slate-100 transition-colors">
        Amalfi Coast guide →
      </a>
    </section>

  </div>

</BaseLayout>
