---
import BaseLayout from '../../../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../../../components/Breadcrumbs.astro';

const lang = 'en-us';

const breadcrumbs = [
  { name: 'Home', url: '/en-us/' },
  { name: 'Itineraries', url: '/en-us/itineraries/' },
  { name: 'Capri from Sorrento', url: '/en-us/itineraries/1-day/capri-from-sorrento/' },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "How long does the hydrofoil from Sorrento to Capri take?",
      "acceptedAnswer": { "@type": "Answer", "text": "The hydrofoil from Sorrento (Marina Piccola) to Capri (Marina Grande) takes about 20–25 minutes. The main operators are NLG and Alilauro. In summer departures run every 30–60 min from 7:00 to 20:00. A return ticket costs ~€18–22." }
    },
    {
      "@type": "Question",
      "name": "Can you visit the Blue Grotto in a day trip from Sorrento?",
      "acceptedAnswer": { "@type": "Answer", "text": "Yes, but it requires careful planning. Take the first hydrofoil from Sorrento (7:30–8:00), arrive in Capri and head straight to the Blue Grotto before the crowds (ideally before 10:00). Then explore Capri and Anacapri in the afternoon. Return to Sorrento on the last hydrofoil (around 18:30–19:00)." }
    },
    {
      "@type": "Question",
      "name": "Capri vs Anacapri: which one to visit in a day?",
      "acceptedAnswer": { "@type": "Answer", "text": "Both are worth it, but with only one day choose based on your interests: Capri town is more chic, full of shops and with the Faraglioni rocks. Anacapri is quieter, with Villa San Michele and the chairlift to Monte Solaro (589 m). A good day includes morning at the Blue Grotto, lunch in Anacapri, afternoon in Capri and the Faraglioni." }
    }
  ]
};

const destinations = [
  { name: 'Capri', url: '/en-us/islands/capri/' },
  { name: 'Anacapri', url: '/en-us/islands/capri/' },
  { name: 'Blue Grotto', url: '/en-us/islands/capri/' },
  { name: 'Monte Solaro', url: '/en-us/islands/capri/' },
  { name: 'Faraglioni', url: '/en-us/islands/capri/' },
  { name: 'Sorrento', url: '/en-us/sorrento-peninsula/sorrento/' },
];

const destinationHighlights = destinations.map(d => ({ name: d.name, desc: '', url: d.url }));

const schedule = [
  { time: '07:30', place: 'Sorrento, Marina Piccola', action: 'NLG/Alilauro hydrofoil to Capri (20–25 min, ~€9–11)', transport: 'ferry' },
  { time: '08:00', place: 'Capri, Marina Grande', action: 'Bus to Blue Grotto (20 min, ~€2). Arrive before 10:00 to avoid queues.', transport: 'bus' },
  { time: '08:30', place: 'Blue Grotto', action: 'Rowing boat into the grotto (€15 + entry €14). Variable wait time.', transport: 'ferry' },
  { time: '10:00', place: 'Anacapri', action: 'Bus from Capri to Anacapri (15 min). Villa San Michele (~€7). Monte Solaro chairlift (589 m, ~€13 return).', transport: 'bus' },
  { time: '12:30', place: 'Anacapri', action: 'Lunch at a local trattoria (cheaper than central Capri)', transport: 'visit' },
  { time: '14:00', place: 'Capri centre', action: 'Bus to Capri. Piazzetta, Via Camerelle, Gardens of Augustus, Faraglioni view.', transport: 'bus' },
  { time: '16:00', place: 'Marina Grande', action: 'Boat trip around the Faraglioni (~€18–25 p.p., 1–2h)', transport: 'ferry' },
  { time: '18:00', place: 'Capri → Sorrento', action: 'Return hydrofoil to Sorrento (20–25 min)', transport: 'ferry' },
];

const tips = [
  'Blue Grotto: before 10:00 there is almost no queue. After 11:00 the wait can be 1–2 hours.',
  'In July–August book the hydrofoil online the day before: early crossings sell out.',
  'Capri is expensive: lunch in Anacapri costs 30–40% less than in the Piazzetta.',
  'The Monte Solaro chairlift from Anacapri is unmissable: 589 m, 360° view over the Coast and Naples.',
  'The hydrofoil does not run in rough seas: check the marine weather forecast and have a backup plan.',
];

const transportBadge: Record<string, { label: string; cls: string }> = {
  train: { label: 'TRAIN', cls: 'bg-orange-100 text-orange-700' },
  ferry: { label: 'FERRY', cls: 'bg-blue-100 text-blue-700' },
  bus:   { label: 'BUS', cls: 'bg-green-100 text-green-700' },
  walk:  { label: 'WALK', cls: 'bg-gray-100 text-slate-500' },
  visit: { label: '', cls: '' },
};
---

<BaseLayout
  title="Capri from Sorrento in 1 Day 2026 | Blue Grotto, Faraglioni, Anacapri"
  description="1-day itinerary to Capri from Sorrento: Blue Grotto, Anacapri, Monte Solaro and Faraglioni. Hydrofoil timetables and tips to avoid the queues."
  lang={lang}
  breadcrumbs={breadcrumbs}
  schema={[faqSchema]}
  pageKey="capri-from-sorrento">

  <!-- Hero Section -->
  <section class="relative bg-charcoal overflow-hidden min-h-[70vh] sm:min-h-[75vh] flex items-center justify-center">
    <img src="/images/capri-hero.jpg" alt="Capri from Sorrento" class="absolute inset-0 w-full h-full object-cover opacity-30" loading="eager" referrerpolicy="no-referrer"/>
    <div class="absolute inset-0 bg-gradient-to-b from-black/75 via-black/40 to-black/70"></div>
    <div class="relative max-w-editorial mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <div class="max-w-3xl mx-auto">
        <p class="text-med-gold text-xs sm:text-sm font-medium uppercase tracking-[0.3em] mb-3">Itinerary · 1 day</p>
        <h1 class="font-serif text-display text-white mb-4">Capri from Sorrento</h1>
        <p class="text-xl text-white/80 leading-relaxed max-w-2xl mx-auto">
          Capri by hydrofoil from Sorrento: Blue Grotto, Anacapri and Faraglioni in one day.
        </p>
      </div>
    </div>
    <Breadcrumbs breadcrumbs={breadcrumbs} />
  </section>

  <div class="max-w-editorial mx-auto px-4 sm:px-6 lg:px-8 pt-6 pb-10 space-y-10">

    <!-- Intro & Stats Section - Featured -->
    <section class="text-center mb-2">
      <!-- Quick Stats Grid - Scrollable on Mobile -->
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-2 sm:gap-4 mb-6 overflow-x-auto snap-x snap-mandatory sm:overflow-visible pb-2 sm:pb-0">
        <div class="bg-slate-900 rounded-2xl p-6 hover:shadow-md transition-shadow flex flex-col items-center justify-center aspect-square snap-start">
          <svg class="w-8 h-8 text-med-gold mb-3" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
            <rect x="3" y="4" width="18" height="18" rx="2"/>
            <path d="M16 2v4M8 2v4M3 10h18"/>
          </svg>
          <p class="text-xs text-white/60 font-semibold uppercase tracking-wide mb-2">Duration</p>
          <p class="font-serif text-lg font-semibold text-med-gold">1 day</p>
        </div>
        <div class="bg-slate-900 rounded-2xl p-6 hover:shadow-md transition-shadow flex flex-col items-center justify-center aspect-square snap-start">
          <svg class="w-8 h-8 text-med-gold mb-3" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
            <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/>
            <circle cx="12" cy="10" r="3"/>
          </svg>
          <p class="text-xs text-white/60 font-semibold uppercase tracking-wide mb-2">Base</p>
          <p class="font-serif text-lg font-semibold text-med-gold">Sorrento</p>
        </div>
        <div class="bg-slate-900 rounded-2xl p-6 hover:shadow-md transition-shadow flex flex-col items-center justify-center aspect-square snap-start">
          <svg class="w-8 h-8 text-med-gold mb-3" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
            <path d="M6 9l6-6 6 6M5 9v9a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V9M9 14h6"/>
          </svg>
          <p class="text-xs text-white/60 font-semibold uppercase tracking-wide mb-2">Transport</p>
          <p class="font-serif text-lg font-semibold text-med-gold">Ferry<br/>+ Funicular</p>
        </div>
        <div class="bg-slate-900 rounded-2xl p-6 hover:shadow-md transition-shadow flex flex-col items-center justify-center aspect-square snap-start">
          <svg class="w-8 h-8 text-med-gold mb-3" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
            <circle cx="12" cy="12" r="1"/>
            <path d="M12 1v6M12 17v6M4.22 4.22l4.24 4.24M15.54 15.54l4.24 4.24M1 12h6M17 12h6M4.22 19.78l4.24-4.24M15.54 8.46l4.24-4.24"/>
          </svg>
          <p class="text-xs text-white/60 font-semibold uppercase tracking-wide mb-2">Transport budget</p>
          <p class="font-serif text-lg font-semibold text-med-gold">~€40–60<br/><span class="text-xs">p.p.</span></p>
        </div>
      </div>

      <!-- SEO Text Below -->
      <div>
        <p class="text-lg text-slate-700 leading-relaxed">
          A day trip to <strong>Capri</strong> from <strong>Sorrento</strong>: take the <strong>NLG or Alilauro hydrofoil</strong> from Marina Piccola (20–25 min). Visit the <strong>Blue Grotto</strong> early morning, explore <strong>Anacapri</strong> with the <strong>Monte Solaro chairlift</strong> (589 m), then stroll through <strong>Capri</strong> town and admire the <strong>Faraglioni</strong> rocks from the sea. <strong>Transport budget: ~€40–60</strong>.
        </p>
      </div>
    </section>


    <!-- Day by Day Itinerary -->
    <section>
      <h2 class="font-serif text-2xl font-semibold text-slate-900 mb-8">Day schedule</h2>
      <div class="bg-white border border-slate-200 rounded-2xl overflow-hidden">
        <div class="px-6 py-8 space-y-6">
          {schedule.map((item, idx) => {
            const badge = transportBadge[item.transport];
            const isLastItem = idx === schedule.length - 1;
            return (
              <div class="flex gap-4">
                <div class="flex flex-col items-center flex-shrink-0">
                  <div class="w-16 bg-slate-900 text-med-gold rounded-full px-2 py-1 text-center text-sm font-semibold flex items-center justify-center">
                    {item.time}
                  </div>
                  {!isLastItem && <div class="w-0.5 h-12 bg-med-blue/30 mt-2"></div>}
                </div>
                <div class="pb-4 flex-1">
                  <p class="font-semibold text-slate-900 mb-1">{item.place}</p>
                  <p class="text-slate-700 text-sm mb-2" set:html={item.action} />
                  {badge.label && (
                    <span class={`text-xs font-semibold px-2 py-1 rounded-full ${badge.cls}`}>
                      {badge.label}
                    </span>
                  )}
                </div>
              </div>
            );
          })}
        </div>
      </div>
    </section>

    <!-- Destinations Highlighted -->
    <section>
      <h2 class="font-serif text-2xl font-semibold text-slate-900 mb-8">Itinerary destinations</h2>
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4">
        {destinationHighlights.map((dest) => (
          <a href={dest.url} class="group block bg-white border border-slate-200 rounded-2xl p-5 hover:shadow-lg hover:border-med-blue/30 transition-all">
            <h3 class="font-semibold text-charcoal mb-2 group-hover:text-med-blue transition-colors">{dest.name}</h3>
            <p class="text-xs text-slate-500 leading-relaxed mb-3">{dest.desc}</p>
            <span class="text-xs font-semibold text-med-blue inline-flex items-center gap-1 group-hover:gap-2 transition-all">
              Discover →
            </span>
          </a>
        ))}
      </div>
    </section>

    <!-- Planning Tips -->
    <section class="bg-med-cream border border-med-gold/20 rounded-[2rem] p-6">
      <h2 class="font-serif text-xl font-semibold text-charcoal mb-6">Practical tips</h2>
      <ul class="space-y-4">
        {tips.map((text, idx) => {
          const nums = ['❶', '❷', '❸', '❹', '❺'];
          return (
            <li class="flex items-start gap-4 text-sm text-charcoal">
              <span class="text-2xl font-bold text-white flex-shrink-0 leading-none mt-0.5 bg-[#E2725B] w-9 h-9 flex items-center justify-center rounded-full">{nums[idx] || '•'}</span>
              <span class="leading-relaxed" set:html={text} />
            </li>
          );
        })}
      </ul>
    </section>

    <!-- FAQ -->
    <section id="faq">
      <h2 class="font-serif text-2xl font-semibold text-slate-900 mb-6">Frequently asked questions</h2>
      <div class="space-y-4">
        {faqSchema.mainEntity.map((q) => (
          <details class="group border border-slate-200 rounded-2xl overflow-hidden">
            <summary class="flex items-center justify-between px-6 py-4 cursor-pointer select-none text-charcoal font-medium hover:bg-slate-50 transition-colors">
              {q.name}
              <svg class="w-4 h-4 text-slate-400 group-open:rotate-180 transition-transform flex-shrink-0 ml-3" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
            </summary>
            <div class="px-6 pb-5 text-slate-600 leading-relaxed text-sm border-t border-slate-100 pt-4">
              {q.acceptedAnswer.text}
            </div>
          </details>
        ))}
      </div>
    </section>

    <!-- BANNER: Itinerary Planner -->
    <section class="relative overflow-hidden rounded-[2rem] bg-gradient-to-br from-slate-900 via-slate-950 to-blue-950 px-6 sm:px-10 py-8 md:py-10 shadow-[0_20px_60px_rgba(0,0,0,0.35)]">
      <div class="absolute -top-20 -left-20 w-72 h-72 bg-blue-500/15 rounded-full blur-3xl pointer-events-none"></div>
      <div class="absolute -bottom-20 -right-20 w-72 h-72 bg-amber-500/10 rounded-full blur-3xl pointer-events-none"></div>
      <div class="relative z-10 md:flex md:items-center md:justify-between gap-8">
        <div>
          <span class="inline-block px-3 py-1 rounded-full text-[10px] font-semibold tracking-wide uppercase bg-med-gold/15 text-med-gold border border-med-gold/25 mb-4">New: Custom Trip Planner</span>
          <h2 class="text-2xl md:text-3xl font-bold text-white leading-tight mb-2">Design your <span class="font-serif italic text-med-blue">perfect itinerary</span></h2>
          <p class="text-white/60 text-sm md:text-base leading-relaxed max-w-xl">Answer a few simple questions and get a personalised itinerary with transport, costs and times.</p>
        </div>
        <div class="mt-6 md:mt-0 flex-shrink-0">
          <a href="/en-us/itinerary-planner/" class="inline-flex items-center gap-2.5 px-7 py-3.5 bg-gradient-to-r from-med-gold to-yellow-600 text-slate-900 font-bold rounded-xl hover:shadow-[0_0_30px_rgba(212,175,55,0.4)] hover:scale-105 transition-all duration-300">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 2L2 12l4 0 0 6 4 0 0-4 4 0 0 4 4 0 0-6 4 0L12 2z"/></svg>
            Plan Now
          </a>
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="bg-gradient-to-r from-med-blue to-med-blue/80 rounded-2xl p-10 text-center text-white">
      <h2 class="font-serif text-3xl font-bold mb-3">Discover the island of Capri</h2>
      <p class="text-white/90 mb-6 max-w-2xl mx-auto">
        Read our complete guide to Capri: beaches, Blue Grotto, Anacapri, Monte Solaro and the best ways to get there.
      </p>
      <a href="/en-us/islands/capri/" class="inline-block bg-white text-med-blue font-semibold px-8 py-3 rounded-full hover:bg-slate-100 transition-colors">
        Capri guide →
      </a>
    </section>

  </div>

</BaseLayout>
