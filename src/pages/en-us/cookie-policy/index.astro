---
import BaseLayout from '../../../layouts/BaseLayout.astro';
const lang = 'en-us';
const title = 'Cookie Policy | Amalfi Coast Travel Guide';
const description = 'Information about the cookies used on amalficoast-travel.com.';
const breadcrumbs = [
  { name: 'Home', url: '/en-us/' },
  { name: 'Cookie Policy', url: '/en-us/cookie-policy/' },
];
---
<BaseLayout {title} {description} {lang} {breadcrumbs}>
  <div class="max-w-3xl mx-auto px-4 sm:px-6 py-16 lg:py-24">
    <h1 class="font-serif text-4xl font-bold text-slate-900 mb-2">Cookie Policy</h1>
    <p class="text-slate-400 text-sm mb-12">Last updated: May 2026</p>

    <section class="mb-10">
      <h2 class="font-serif text-2xl font-bold text-slate-900 mb-4">1. What are cookies</h2>
      <p class="text-slate-600 leading-relaxed">Cookies are small text files stored on your device when you visit a website. They allow the site to collect anonymous statistical data about browsing behaviour.</p>
    </section>

    <section class="mb-10">
      <h2 class="font-serif text-2xl font-bold text-slate-900 mb-4">2. Cookies used</h2>

      <h3 class="font-semibold text-slate-900 mb-3 mt-6">Strictly necessary (always active)</h3>
      <p class="text-slate-600 mb-3 text-sm">Required for the site to function. No consent needed.</p>
      <div class="overflow-x-auto rounded-b-xl border border-slate-200">
        <table class="w-full text-sm border-collapse">
          <thead><tr class="bg-slate-900 text-white"><th class="text-left px-4 py-3 font-semibold">Cookie</th><th class="text-left px-4 py-3 font-semibold">Duration</th><th class="text-left px-4 py-3 font-semibold">Description</th></tr></thead>
          <tbody>
            <tr class="border-b border-slate-100"><td class="px-4 py-3 font-mono text-xs">cc_cookie</td><td class="px-4 py-3 text-slate-600">6 months</td><td class="px-4 py-3 text-slate-600">Stores cookie consent preferences</td></tr>
          </tbody>
        </table>
      </div>

      <h3 class="font-semibold text-slate-900 mb-3 mt-8">Analytics cookies (require consent)</h3>
      <p class="text-slate-600 mb-3 text-sm">Only activated after explicit consent.</p>

      <p class="font-medium text-slate-700 mb-2 mt-4 text-sm">Google Analytics 4</p>
      <div class="overflow-x-auto rounded-b-xl border border-slate-200 mb-6">
        <table class="w-full text-sm border-collapse">
          <thead><tr class="bg-slate-900 text-white"><th class="text-left px-4 py-3 font-semibold">Cookie</th><th class="text-left px-4 py-3 font-semibold">Duration</th><th class="text-left px-4 py-3 font-semibold">Description</th></tr></thead>
          <tbody>
            <tr class="border-b border-slate-100"><td class="px-4 py-3 font-mono text-xs">_ga</td><td class="px-4 py-3 text-slate-600">2 years</td><td class="px-4 py-3 text-slate-600">Distinguishes site users</td></tr>
            <tr class="border-b border-slate-100"><td class="px-4 py-3 font-mono text-xs">_ga_*</td><td class="px-4 py-3 text-slate-600">2 years</td><td class="px-4 py-3 text-slate-600">Maintains Analytics session state</td></tr>
            <tr class="border-b border-slate-100"><td class="px-4 py-3 font-mono text-xs">_gid</td><td class="px-4 py-3 text-slate-600">24 hours</td><td class="px-4 py-3 text-slate-600">Distinguishes users (daily session)</td></tr>
          </tbody>
        </table>
      </div>

      <p class="font-medium text-slate-700 mb-2 text-sm">Microsoft Clarity</p>
      <div class="overflow-x-auto rounded-b-xl border border-slate-200">
        <table class="w-full text-sm border-collapse">
          <thead><tr class="bg-slate-900 text-white"><th class="text-left px-4 py-3 font-semibold">Cookie</th><th class="text-left px-4 py-3 font-semibold">Duration</th><th class="text-left px-4 py-3 font-semibold">Description</th></tr></thead>
          <tbody>
            <tr class="border-b border-slate-100"><td class="px-4 py-3 font-mono text-xs">_clck</td><td class="px-4 py-3 text-slate-600">1 year</td><td class="px-4 py-3 text-slate-600">Persistent user identifier</td></tr>
            <tr class="border-b border-slate-100"><td class="px-4 py-3 font-mono text-xs">_clsk</td><td class="px-4 py-3 text-slate-600">24 hours</td><td class="px-4 py-3 text-slate-600">Consolidates page views into a session</td></tr>
          </tbody>
        </table>
      </div>
    </section>

    <section class="mb-10">
      <h2 class="font-serif text-2xl font-bold text-slate-900 mb-4">3. How to manage cookies</h2>
      <p class="text-slate-600 leading-relaxed mb-4">You can change your preferences at any time by clicking <strong>Manage preferences</strong> in the cookie banner. You can also disable cookies in your browser:</p>
      <ul class="list-disc pl-6 text-slate-600 space-y-1 text-sm">
        <li><a href="https://support.google.com/chrome/answer/95647" class="text-med-blue hover:underline" target="_blank" rel="noopener">Google Chrome</a></li>
        <li><a href="https://support.mozilla.org/en-US/kb/enable-and-disable-cookies-website-preferences" class="text-med-blue hover:underline" target="_blank" rel="noopener">Mozilla Firefox</a></li>
        <li><a href="https://support.apple.com/guide/safari/manage-cookies-sfri11471/mac" class="text-med-blue hover:underline" target="_blank" rel="noopener">Safari</a></li>
        <li><a href="https://support.microsoft.com/en-us/microsoft-edge/delete-cookies-in-microsoft-edge-63947406-40ac-c3b8-57b9-2a946a29ae09" class="text-med-blue hover:underline" target="_blank" rel="noopener">Microsoft Edge</a></li>
      </ul>
    </section>

    <section>
      <h2 class="font-serif text-2xl font-bold text-slate-900 mb-4">4. Controller</h2>
      <p class="text-slate-600 leading-relaxed">Amalfi Coast Travel · <a href="mailto:amalficoastravel@gmail.com" class="text-med-blue hover:underline">amalficoastravel@gmail.com</a><br/>
      For more information: <a href="/en-us/privacy-policy/" class="text-med-blue hover:underline">Privacy Policy</a>.</p>
    </section>
  </div>
</BaseLayout>
