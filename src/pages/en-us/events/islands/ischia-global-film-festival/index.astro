---
import BaseLayout from '../../../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../../../components/Breadcrumbs.astro';
import LocalitySlider from '../../../../../components/LocalitySlider.astro';

const lang = 'en-us';

const breadcrumbs = [
  { name: 'Home', url: '/en-us/' },
  { name: 'Events', url: '/en-us/events/' },
  { name: 'Ischia Global Film Festival', url: '/en-us/events/islands/ischia-global-film-festival/' },
];

const eventSchema = {
  "@context": "https://schema.org",
  "@type": "Event",
  "name": "Ischia Global Film & Music Fest 2026",
  "startDate": "2026-07-01",
  "location": {
    "@type": "Place",
    "name": "Lacco Ameno and Ischia Porto",
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Ischia",
      "addressRegion": "NA",
      "addressCountry": "IT"
    }
  },
  "url": "https://amalficoast-travel.com/en-us/events/islands/ischia-global-film-festival/"
};

const facts = [
  { dt: 'Period', dd: 'July 2026' },
  { dt: 'Venues', dd: 'Lacco Ameno & Ischia Porto' },
  { dt: 'Type', dd: 'International Cinema' },
  { dt: 'Access', dd: 'Ferry from Naples' },
  { dt: 'From Naples', dd: '75 min (ferry)' },
];
---

<BaseLayout
  title="Ischia Global Film & Music Fest 2026 – International Cinema"
  description="The Ischia Global Film & Music Fest in July 2026. World premieres and Hollywood stars at Lacco Ameno and Ischia Porto."
  lang={lang}
  breadcrumbs={breadcrumbs}
  schema={[eventSchema]}
 pageKey="ischia-global-film-festival"
  heroImage="/images/ischia-hero.jpg"
>

  <!-- Hero -->
  <section class="relative h-[65vh] sm:h-[70vh] overflow-hidden flex items-center justify-center">
    <img
      src="/images/ischia-hero.jpg"
      alt="Ischia Global Film Festival"
      class="absolute inset-0 w-full h-full object-cover"
      loading="eager" fetchpriority="high" decoding="sync" referrerpolicy="no-referrer"
    />
    <div class="absolute inset-0 bg-gradient-to-b from-black/20 via-black/50 to-black/70"></div>
    <div class="relative z-10 text-center px-6 max-w-5xl text-white">
      <div class="flex flex-wrap justify-center items-center gap-4 mb-6">
        <span class="bg-med-gold text-white px-4 py-1 rounded-full text-[10px] font-bold uppercase tracking-widest">Event 2026</span>
        <span class="text-white/70 text-xs sm:text-sm">July 2026</span>
        <span class="text-white/70 text-xs sm:text-sm">Ischia, NA</span>
      </div>
      <h1 class="font-serif text-5xl md:text-7xl font-bold text-white leading-tight mb-6">Ischia Global Film & Music Fest</h1>
      <p class="text-white/85 text-lg md:text-xl font-light max-w-2xl mx-auto leading-relaxed">
        Hollywood glamour under the Mediterranean sun.
      </p>
    </div>
    <Breadcrumbs breadcrumbs={breadcrumbs} isEvent={true} />
  </section>

  <!-- Content 70/30 -->
  <section class="py-12 sm:py-24 px-6 max-w-7xl mx-auto">
    <div class="grid grid-cols-1 lg:grid-cols-10 gap-16">

      <!-- Main Content (70%) -->
      <div class="lg:col-span-7 space-y-12">
        <div>
          <h2 class="font-serif text-4xl font-bold text-slate-900 mb-8">About the Event</h2>
          <div class="space-y-4 text-slate-600 text-lg leading-relaxed">
            <p>The festival hosts world premieres and award ceremonies with Hollywood stars. Events are distributed across the squares and historic hotels of the island. Ischia's unique atmosphere transforms every screening into an unforgettable experience.</p>
            <p>The Ischia Global Film & Music Fest has become over the years one of the most glamorous film events in the Mediterranean. Open-air screenings in Lacco Ameno's squares and awards at Ischia Porto's luxury hotels create a unique blend of cinema and natural beauty.</p>
          </div>
        </div>

        <!-- Festival Highlights -->
        <div>
          <h3 class="font-serif text-2xl font-bold text-slate-900 mb-6">Festival Highlights</h3>
          <div class="grid sm:grid-cols-2 gap-6">
            <div class="bg-white p-8 rounded-[2rem] border border-slate-100 shadow-sm">
              <span class="text-med-gold text-[10px] font-bold uppercase tracking-widest mb-2 block">Lacco Ameno</span>
              <h4 class="text-xl font-serif font-bold text-slate-900 mb-3">Open-air screenings</h4>
              <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">The main square of Lacco Ameno becomes an open-air cinema for world premieres, with the backdrop of the famous Fungo rock and the sparkling sea.</p>
            </div>
            <div class="bg-white p-8 rounded-[2rem] border border-slate-100 shadow-sm">
              <span class="text-med-gold text-[10px] font-bold uppercase tracking-widest mb-2 block">Award ceremonies</span>
              <h4 class="text-xl font-serif font-bold text-slate-900 mb-3">Stars on the island</h4>
              <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">International directors and actors receive their awards in the luxury hotels of Ischia Porto, in an intimate atmosphere that recalls the golden age of the Italian Riviera.</p>
            </div>
          </div>
        </div>

        <!-- Getting There -->
        <div>
          <h3 class="font-serif text-2xl font-bold text-slate-900 mb-6">Getting to Ischia</h3>
          <div class="bg-white rounded-[2rem] border border-slate-100 overflow-hidden shadow-sm">
            <table class="w-full text-xs sm:text-xs sm:text-sm">
              <thead>
                <tr class="bg-slate-900 text-white">
                  <th class="text-left px-6 py-4 font-semibold">Transport</th>
                  <th class="text-left px-6 py-4 font-semibold">Service</th>
                  <th class="text-left px-6 py-4 font-semibold">Notes</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-slate-100">
                <tr class="hover:bg-slate-50 transition-colors">
                  <td class="px-6 py-4 font-medium">Ferry</td>
                  <td class="px-6 py-4 text-slate-600">From Naples Calata Porta di Massa</td>
                  <td class="px-6 py-4 text-slate-500 text-xs">75 minutes to Ischia Porto</td>
                </tr>
                <tr class="hover:bg-slate-50 transition-colors">
                  <td class="px-6 py-4 font-medium">Hydrofoil</td>
                  <td class="px-6 py-4 text-slate-600">From Naples Molo Beverello</td>
                  <td class="px-6 py-4 text-slate-500 text-xs">35 minutes, more expensive</td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>
      </div>

      <!-- Sidebar (30%) -->
      <aside class="lg:col-span-3">
        <div class="bg-slate-900 text-white p-10 rounded-[3rem] sticky top-32 shadow-2xl">
          <p class="text-[10px] uppercase tracking-[0.3em] text-med-gold font-medium mb-6">Event Details</p>
          <dl class="space-y-4">
            {facts.map(({ dt, dd }, i) => (
              <>
                <div>
                  <dt class="text-white/40 text-[10px] uppercase tracking-widest font-bold mb-1">{dt}</dt>
                  <dd class="text-white font-medium">{dd}</dd>
                </div>
                {i < facts.length - 1 && <div class="border-t border-white/5"></div>}
              </>
            ))}
          </dl>
          <div class="mt-10 pt-8 border-t border-white/5">
            <p class="text-white/50 text-xs leading-relaxed">We recommend arriving well in advance. Check the updated programme on official channels.</p>
          </div>
        </div>
      </aside>

    </div>
  </section>

  <LocalitySlider
    heading="Discover Ischia and the Islands"
    lang={lang}
    items={[
      { name: "Ischia", href: '/en-us/islands/ischia/', image: '/images/capri-hero.jpg', tag: "Event venue" },
      { name: "Forio", href: '/en-us/islands/forio/', image: '/images/capri-hero.jpg', tag: "Nearby" },
      { name: "Capri", href: '/en-us/islands/capri/', image: '/images/capri-hero.jpg', tag: "Iconic" },
      { name: "Procida", href: '/en-us/islands/procida/', image: '/images/capri-hero.jpg', tag: "Village" },
    ]}
  />

  <!-- Related Events -->
  <section class="py-4 sm:py-12 px-6 max-w-7xl mx-auto">
    <h2 class="font-serif text-3xl sm:text-4xl font-bold text-slate-900 mb-12">Related Events</h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
      <a href="/en-us/events/islands/anacapri-settembre-borgo/" class="block bg-white rounded-[2rem] border border-slate-100 overflow-hidden shadow-sm hover:shadow-md transition-shadow">
        <img src="/images/capri-hero.jpg" alt="Anacapri Festival" class="h-40 w-full object-cover" />
        <div class="p-6">
          <span class="text-med-gold text-[10px] font-bold uppercase tracking-widest mb-2 block">September 2026</span>
          <h3 class="font-serif text-lg font-bold text-slate-900 mb-2">Anacapri September Fair</h3>
          <p class="text-slate-600 text-sm mb-4">Traditional fair celebrating island culture and local traditions.</p>
          <p class="text-slate-500 text-xs font-medium">📍 Anacapri, NA</p>
        </div>
      </a>
      <a href="/en-us/events/islands/sagra-del-mare-graziella-procida/" class="block bg-white rounded-[2rem] border border-slate-100 overflow-hidden shadow-sm hover:shadow-md transition-shadow">
        <img src="/images/capri-hero.jpg" alt="Procida Festival" class="h-40 w-full object-cover" />
        <div class="p-6">
          <span class="text-med-gold text-[10px] font-bold uppercase tracking-widest mb-2 block">September 2026</span>
          <h3 class="font-serif text-lg font-bold text-slate-900 mb-2">Procida Sea Festival</h3>
          <p class="text-slate-600 text-sm mb-4">Celebration of maritime traditions and seafood on the island.</p>
          <p class="text-slate-500 text-xs font-medium">📍 Procida, NA</p>
        </div>
      </a>
      <a href="/en-us/events/" class="block bg-white rounded-[2rem] border border-slate-100 overflow-hidden shadow-sm hover:shadow-md transition-shadow">
        <img src="/images/capri-hero.jpg" alt="Island Travel" class="h-40 w-full object-cover" />
        <div class="p-6">
          <span class="text-med-gold text-[10px] font-bold uppercase tracking-widest mb-2 block">Year-round</span>
          <h3 class="font-serif text-lg font-bold text-slate-900 mb-2">Explore the Islands</h3>
          <p class="text-slate-600 text-sm mb-4">Discover Capri, Ischia and Procida during your visit.</p>
          <p class="text-slate-500 text-xs font-medium">📍 Archipelago, NA</p>
        </div>
      </a>
    </div>
  </section>

  <!-- Destinazione CTA -->
  <section class="bg-med-blue text-white py-12 sm:py-16 px-6">
    <div class="max-w-7xl mx-auto">
      <div class="flex flex-col sm:flex-row items-center justify-between gap-8">
        <div>
          <h3 class="font-serif text-2xl sm:text-3xl font-bold mb-3">Explore Ischia</h3>
          <p class="text-white/70 text-sm sm:text-base max-w-md">Volcanic island with hot springs, beaches, and nature.</p>
        </div>
        <a href="/en-us/islands/ischia/" class="bg-med-gold text-white px-8 py-3 rounded-full font-medium hover:bg-yellow-500 transition-colors whitespace-nowrap">
          View Destination →
        </a>
      </div>
    </div>
  </section>


