---
import BaseLayout from '../../../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../../../components/Breadcrumbs.astro';
import LocalitySlider from '../../../../../components/LocalitySlider.astro';

const lang = 'en-us';

const breadcrumbs = [
  { name: 'Home', url: '/en-us/' },
  { name: 'Events', url: '/en-us/events/' },
  { name: 'Ravello Festival', url: '/en-us/events/amalfi-coast/ravello-festival/' },
];

const eventSchema = {
  "@context": "https://schema.org",
  "@type": "EventSeries",
  "name": "Ravello Festival",
  "description": "Complete guide to Ravello Festival 2026. Programme, tickets, how to reach Villa Rufolo by public transport from the Amalfi Coast.",
  "image": "https://amalficoast-travel.com/images/ravello-hero.jpg",
  "url": "https://amalficoast-travel.com/en-us/events/amalfi-coast/ravello-festival/",
  "location": {
      "@type": "Place",
      "name": "Villa Rufolo, Ravello",
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Ravello",
        "addressRegion": "SA",
        "addressCountry": "IT"
      }
    },
  "eventStatus": "https://schema.org/EventScheduled",
  "eventAttendanceMode": "https://schema.org/OfflineEventAttendanceMode",
  "startDate": "2026-07-04",
  "endDate": "2026-09-05",
  "subEvent": [
    {
      "@type": "Event",
      "name": "Ravello Festival 2026",
      "startDate": "2026-07-04",
      "endDate": "2026-09-05",
      "eventStatus": "https://schema.org/EventScheduled",
      "eventAttendanceMode": "https://schema.org/OfflineEventAttendanceMode",
      "location": {
          "@type": "Place",
          "name": "Villa Rufolo, Ravello",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Ravello",
            "addressRegion": "SA",
            "addressCountry": "IT"
          }
        },
      "url": "https://amalficoast-travel.com/en-us/events/amalfi-coast/ravello-festival/",
      "image": "https://amalficoast-travel.com/images/ravello-hero.jpg",
      "description": "Complete guide to Ravello Festival 2026. Programme, tickets, how to reach Villa Rufolo by public transport from the Amalfi Coast."
    }
  ]
};

const facts = [
  { dt: 'Period', dd: '4 Jul – 5 Sep 2026' },
  { dt: 'Venue', dd: 'Belvedere di Villa Rufolo' },
  { dt: 'Genre', dd: 'Symphony · Jazz · Dance' },
  { dt: 'Tickets', dd: 'Advance booking required' },
  { dt: 'Access', dd: 'SITA bus from Amalfi' },
];
---

<BaseLayout
  title="Ravello Festival 2026: Programme & Tickets – Villa Rufolo"
  description="Complete guide to Ravello Festival 2026. Programme, tickets, how to reach Villa Rufolo by public transport from the Amalfi Coast."
  lang={lang}
  breadcrumbs={breadcrumbs}
  schema={[eventSchema]}
 pageKey="ravello-festival"
  heroImage="/images/ravello-hero.jpg"
>

  <!-- Hero -->
  <section class="relative h-[65vh] sm:h-[70vh] overflow-hidden flex items-center justify-center">
    <img
      src="/images/ravello-hero.jpg"
      alt="Ravello Festival, Villa Rufolo"
      class="absolute inset-0 w-full h-full object-cover"
      loading="eager" fetchpriority="high" decoding="sync" referrerpolicy="no-referrer"
    />
    <div class="absolute inset-0 bg-gradient-to-b from-black/20 via-black/50 to-black/70"></div>
    <div class="relative z-10 text-center px-6 max-w-5xl text-white">
      <div class="flex flex-wrap justify-center items-center gap-4 mb-6">
        <span class="bg-med-gold text-white px-4 py-1 rounded-full text-[10px] font-bold uppercase tracking-widest">Event 2026</span>
        <span class="text-white/70 text-xs sm:text-sm">4 Jul – 5 Sep 2026</span>
        <span class="text-white/70 text-xs sm:text-sm">Ravello, SA</span>
      </div>
      <h1 class="font-serif text-5xl md:text-7xl font-bold text-white leading-tight mb-6">Ravello Festival</h1>
      <p class="text-white/85 text-lg md:text-xl font-light max-w-2xl mx-auto leading-relaxed">
        The magic of music suspended between sky and sea.
      </p>
    </div>
    <Breadcrumbs breadcrumbs={breadcrumbs} isEvent={true} />
  </section>

  <!-- Content 70/30 -->
  <section class="py-12 sm:py-24 px-6 max-w-7xl mx-auto">
    <div class="grid grid-cols-1 lg:grid-cols-10 gap-16">

      <!-- Main Content (70%) -->
      <div class="lg:col-span-7 space-y-12">
        <div>
          <h2 class="font-serif text-4xl font-bold text-slate-900 mb-8">About the Event</h2>
          <div class="space-y-4 text-slate-600 text-lg leading-relaxed">
            <p>The Ravello Festival reaches its 74th edition, confirming itself as the most prestigious cultural event in the region. The suspended stage of Villa Rufolo hosts international orchestras within a unique architectural setting.</p>
            <p>For the 2026 season, advance ticket booking through official channels is strongly recommended given the limited capacity of the venue.</p>
          </div>
        </div>

        <!-- Programme Highlights -->
        <div>
          <h3 class="font-serif text-2xl font-bold text-slate-900 mb-6">Programme Highlights</h3>
          <div class="grid sm:grid-cols-2 gap-6">
            <div class="bg-white p-8 rounded-[2rem] border border-slate-100 shadow-sm">
              <span class="text-med-gold text-[10px] font-bold uppercase tracking-widest mb-2 block">Dawn Concert</span>
              <h4 class="text-xl font-serif font-bold text-slate-900 mb-3">The most iconic event</h4>
              <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">A unique experience starting at 4:45 am. Music accompanies the sunrise over the mountains of the coast - an unforgettable sensory moment.</p>
            </div>
            <div class="bg-white p-8 rounded-[2rem] border border-slate-100 shadow-sm">
              <span class="text-med-gold text-[10px] font-bold uppercase tracking-widest mb-2 block">Wagnerian Days</span>
              <h4 class="text-xl font-serif font-bold text-slate-900 mb-3">Tribute to the Master</h4>
              <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">An entire week dedicated to Wagner's works, in the very places that inspired the Klingsor's Garden in Parsifal.</p>
            </div>
          </div>
        </div>

        <!-- Getting There -->
        <div>
          <h3 class="font-serif text-2xl font-bold text-slate-900 mb-6">Getting There</h3>
          <div class="bg-white rounded-[2rem] border border-slate-100 overflow-hidden shadow-sm">
            <table class="w-full text-xs sm:text-xs sm:text-sm">
              <thead>
                <tr class="bg-slate-900 text-white">
                  <th class="text-left px-6 py-4 font-semibold">Transport</th>
                  <th class="text-left px-6 py-4 font-semibold">Service</th>
                  <th class="text-left px-6 py-4 font-semibold">Notes</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-slate-100">
                <tr class="hover:bg-slate-50 transition-colors">
                  <td class="px-6 py-4 font-medium">SITA Bus</td>
                  <td class="px-6 py-4 text-slate-600">Amalfi–Ravello line</td>
                  <td class="px-6 py-4 text-slate-500 text-xs">Last evening service at 22:00</td>
                </tr>
                <tr class="hover:bg-slate-50 transition-colors">
                  <td class="px-6 py-4 font-medium">Private shuttle</td>
                  <td class="px-6 py-4 text-slate-600">From coastal hotels</td>
                  <td class="px-6 py-4 text-slate-500 text-xs">Available for evening concerts</td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>
      </div>

      <!-- Sidebar (30%) -->
      <aside class="lg:col-span-3">
        <div class="bg-slate-900 text-white p-10 rounded-[3rem] sticky top-32 shadow-2xl">
          <p class="text-[10px] uppercase tracking-[0.3em] text-med-gold font-medium mb-6">Event Details</p>
          <dl class="space-y-4">
            {facts.map(({ dt, dd }, i) => (
              <>
                <div>
                  <dt class="text-white/40 text-[10px] uppercase tracking-widest font-bold mb-1">{dt}</dt>
                  <dd class="text-white font-medium">{dd}</dd>
                </div>
                {i < facts.length - 1 && <div class="border-t border-white/5"></div>}
              </>
            ))}
          </dl>
          <div class="mt-10 pt-8 border-t border-white/5">
            <p class="text-white/50 text-xs leading-relaxed">We recommend arriving well in advance. Check the updated programme on official channels.</p>
          </div>
        </div>
      </aside>

    </div>
  </section>

  <LocalitySlider
    heading="Nearby Festival Locations"
    lang={lang}
    items={[
      { name: "Ravello", href: '/en-us/amalfi-coast/ravello/', image: '/images/ravello-hero.jpg', tag: "Event venue" },
      { name: "Amalfi", href: '/en-us/amalfi-coast/amalfi/', image: '/images/amalfi-hero.jpg', tag: "Coast" },
      { name: "Positano", href: '/en-us/amalfi-coast/positano/', image: '/images/positano-hero.jpg', tag: "Iconic" },
      { name: "Praiano", href: '/en-us/amalfi-coast/praiano/', image: '/images/praiano-hero.jpg', tag: "Authentic" },
    ]}
  />

    <!-- BANNER: Itinerary Planner -->
  <section class="py-10 md:py-14 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6">
      <div class="relative overflow-hidden rounded-[2.5rem] bg-gradient-to-br from-slate-900 via-slate-950 to-blue-950 px-6 sm:px-10 md:px-14 py-10 md:py-14 shadow-[0_20px_60px_rgba(0,0,0,0.35)]">
        <div class="absolute -top-20 -left-20 w-72 h-72 bg-blue-500/15 rounded-full blur-3xl pointer-events-none"></div>
        <div class="absolute -bottom-20 -right-20 w-72 h-72 bg-amber-500/10 rounded-full blur-3xl pointer-events-none"></div>
        <div class="relative z-10 grid md:grid-cols-[3fr_2fr] md:items-center gap-8">
          <div>
            <span class="inline-block px-4 py-1.5 rounded-full text-xs font-semibold tracking-wide uppercase bg-med-gold/15 text-med-gold border border-med-gold/25 mb-6">New: Custom Trip</span>
            <h2 class="text-3xl md:text-4xl font-bold text-white leading-tight mb-2">Design your</h2>
            <p class="font-serif text-3xl md:text-4xl italic text-med-blue mb-5">ideal itinerary</p>
            <p class="text-white/60 text-base md:text-lg leading-relaxed max-w-xl mb-8">
              Answer a few simple questions - starting point, days and interests - and get a personalized itinerary with transport, costs and times.
            </p>
            <div class="flex flex-wrap gap-6">
              <div class="flex items-center gap-2.5">
                <div class="w-9 h-9 rounded-xl bg-white/5 border border-white/10 flex items-center justify-center">
                  <svg class="w-4 h-4 text-med-gold" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                </div>
                <span class="text-white/50 text-sm">30 seconds to set up</span>
              </div>
              <div class="flex items-center gap-2.5">
                <div class="w-9 h-9 rounded-xl bg-white/5 border border-white/10 flex items-center justify-center">
                  <svg class="w-4 h-4 text-med-gold" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 6.75V15m6-6v8.25m.503 3.498l4.875-2.437c.381-.19.622-.58.622-1.006V4.82c0-.836-.88-1.38-1.628-1.006l-3.869 1.934c-.317.159-.69.159-1.006 0L9.503 3.252a1.125 1.125 0 00-1.006 0L3.622 5.689C3.24 5.88 3 6.27 3 6.695V19.18c0 .836.88 1.38 1.628 1.006l3.869-1.934c.317-.159.69-.159 1.006 0l4.994 2.497c.317.158.69.158 1.006 0z"/></svg>
                </div>
                <span class="text-white/50 text-sm">Anti-crowd tips included</span>
              </div>
            </div>
          </div>
          <div class="mt-8 md:mt-0 md:flex md:justify-center">
            <a href="/en-us/itinerary-planner/" class="inline-flex items-center gap-2.5 px-7 py-3.5 bg-gradient-to-r from-med-gold to-yellow-600 text-slate-900 font-bold rounded-xl hover:shadow-[0_0_30px_rgba(212,175,55,0.4)] hover:scale-105 transition-all duration-300">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 2L2 12l4 0 0 6 4 0 0-4 4 0 0 4 4 0 0-6 4 0L12 2z"/></svg>
              Configure Now
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Recommended Events -->
  <section class="py-4 sm:py-12 px-6 max-w-7xl mx-auto">
    <h2 class="font-serif text-3xl sm:text-4xl font-bold text-slate-900 mb-12">Recommended Events</h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
      <a href="/en-us/events/amalfi-coast/regata-storica-amalfi/" class="block bg-white rounded-[2rem] border border-slate-100 overflow-hidden shadow-sm hover:shadow-md transition-shadow">
        <img src="/images/amalfi-hero.jpg" alt="Historic Regatta" class="h-40 w-full object-cover" />
        <div class="p-6">
          <span class="text-med-gold text-[10px] font-bold uppercase tracking-widest mb-2 block">June 2026</span>
          <h3 class="font-serif text-lg font-bold text-slate-900 mb-2">Historic Regatta</h3>
          <p class="text-slate-600 text-sm mb-4">Ancient maritime republics compete in historic rowing races.</p>
          <p class="text-slate-500 text-xs font-medium">📍 Amalfi, SA</p>
        </div>
      </a>
      <a href="/en-us/events/amalfi-coast/fuochi-ferragosto-positano-maiori/" class="block bg-white rounded-[2rem] border border-slate-100 overflow-hidden shadow-sm hover:shadow-md transition-shadow">
        <img src="/images/positano-hero.jpg" alt="Ferragosto Fireworks" class="h-40 w-full object-cover" />
        <div class="p-6">
          <span class="text-med-gold text-[10px] font-bold uppercase tracking-widest mb-2 block">August 2026</span>
          <h3 class="font-serif text-lg font-bold text-slate-900 mb-2">Ferragosto Fireworks</h3>
          <p class="text-slate-600 text-sm mb-4">Spectacular pyrotechnics over the sea on the coast.</p>
          <p class="text-slate-500 text-xs font-medium">📍 Positano & Maiori, SA</p>
        </div>
      </a>
      <a href="/en-us/events/amalfi-coast/ravello-festival/" class="block bg-white rounded-[2rem] border border-slate-100 overflow-hidden shadow-sm hover:shadow-md transition-shadow">
        <img src="/images/ravello-hero.jpg" alt="Ravello Festival" class="h-40 w-full object-cover" />
        <div class="p-6">
          <span class="text-med-gold text-[10px] font-bold uppercase tracking-widest mb-2 block">July - September 2026</span>
          <h3 class="font-serif text-lg font-bold text-slate-900 mb-2">Ravello Festival</h3>
          <p class="text-slate-600 text-sm mb-4">Classical and contemporary music at Villa Rufolo.</p>
          <p class="text-slate-500 text-xs font-medium">📍 Ravello, SA</p>
        </div>
      </a>
    </div>
  </section>

  <!-- Destinazione CTA -->
  <section class="bg-med-blue text-white py-12 sm:py-16 px-6">
    <div class="max-w-7xl mx-auto">
      <div class="flex flex-col sm:flex-row items-center justify-between gap-8">
        <div>
          <h3 class="font-serif text-2xl sm:text-3xl font-bold mb-3">Explore Ravello</h3>
          <p class="text-white/70 text-sm sm:text-base max-w-md">Perched above the coast with stunning views and culture.</p>
        </div>
        <a href="/en-us/amalfi-coast/ravello/" class="bg-med-gold text-white px-8 py-3 rounded-full font-medium hover:bg-yellow-500 transition-colors whitespace-nowrap">
          View Destination →
        </a>
      </div>
    </div>
  </section>


