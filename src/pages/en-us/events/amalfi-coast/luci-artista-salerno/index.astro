<EventPageLayout
  lang={lang}
  pageKey="luci-artista-salerno"
  metaTitle={"Luci d'Artista Salerno 2026/2027: Dates, Map and Times"}
  metaDescription={"Luci d'Artista in Salerno from 14 November 2026 to 1 February 2027: where the installations are, how to move around in the evening by metro, and when to go to avoid the Villa Comunale queue."}
