---
import BaseLayout from '../../../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../../../components/Breadcrumbs.astro';

const lang = 'en-us';

const breadcrumbs = [
  { name: 'Home', url: '/en-us/' },
  { name: 'Events', url: '/en-us/events/' },
  { name: "Feast of Sant'Andrea Amalfi", url: '/en-us/events/amalfi-coast/festa-sant-andrea-amalfi/' },
];

const eventSchema = {
  "@context": "https://schema.org",
  "@type": "Event",
  "name": "Feast of Sant'Andrea Amalfi 2026",
  "startDate": "2026-06-27T18:00:00+02:00",
  "endDate": "2026-06-27T23:59:00+02:00",
  "location": {
    "@type": "Place",
    "name": "Duomo di Amalfi",
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Amalfi",
      "addressRegion": "SA",
      "addressCountry": "IT"
    }
  },
  "url": "https://amalficoast-travel.com/en-us/events/amalfi-coast/festa-sant-andrea-amalfi/"
};

const facts = [
  { dt: 'Date', dd: '27 June 2026' },
  { dt: 'Venue', dd: 'Duomo di Amalfi' },
  { dt: 'Type', dd: 'Religious & Historical Tradition' },
  { dt: 'Bearers\' race', dd: '8:00 pm' },
  { dt: 'Fireworks', dd: 'Harbour basin' },
];
---

<BaseLayout
  title="Feast of Sant'Andrea Amalfi 2026: Programme & Practical Tips"
  description="Complete guide to the Feast of Sant'Andrea in Amalfi on 27 June 2026. Bearers' race times, fireworks display and transport management by sea."
  lang={lang}
  breadcrumbs={breadcrumbs}
  schema={[eventSchema]}
 pageKey="festa-sant-andrea-amalfi">

  <!-- Hero -->
  <section class="relative h-[65vh] sm:h-[70vh] overflow-hidden flex items-center justify-center">
    <img
      src="/images/amalfi-hero.jpg"
      alt="Feast of Sant'Andrea, Amalfi Cathedral"
      class="absolute inset-0 w-full h-full object-cover"
      loading="eager" fetchpriority="high" decoding="sync" referrerpolicy="no-referrer"
    />
    <div class="absolute inset-0 bg-gradient-to-b from-black/20 via-black/50 to-black/70"></div>
    <div class="relative z-10 text-center px-6 max-w-5xl text-white">
      <div class="flex flex-wrap justify-center items-center gap-4 mb-6">
        <span class="bg-med-gold text-white px-4 py-1 rounded-full text-[10px] font-bold uppercase tracking-widest">Event 2026</span>
        <span class="text-white/70 text-xs sm:text-sm">27 June 2026</span>
        <span class="text-white/70 text-xs sm:text-sm">Amalfi, SA</span>
      </div>
      <h1 class="font-serif text-5xl md:text-7xl font-bold text-white leading-tight mb-6">Feast of Sant'Andrea</h1>
      <p class="text-white/85 text-lg md:text-xl font-light max-w-2xl mx-auto leading-relaxed">
        The bearers' race and fireworks over the harbour of Amalfi.
      </p>
    </div>
    <Breadcrumbs breadcrumbs={breadcrumbs} isEvent={true} />
  </section>

  <!-- Content 70/30 -->
  <section class="py-12 sm:py-24 px-6 max-w-7xl mx-auto">
    <div class="grid grid-cols-1 lg:grid-cols-10 gap-16">

      <!-- Main Content (70%) -->
      <div class="lg:col-span-7 space-y-12">
        <div>
          <h2 class="font-serif text-4xl font-bold text-slate-900 mb-8">About the Event</h2>
          <div class="space-y-4 text-slate-600 text-lg leading-relaxed">
            <p>The celebration of Patron Saint Sant'Andrea represents the moment of greatest community unity in Amalfi. The event culminates with the famous bearers' race up the majestic Cathedral steps, carrying the silver bust of the Saint.</p>
            <p>In 2026 the feast attracts thousands of visitors, making careful transport planning essential. The evening ends with a fireworks display in the harbour basin.</p>
          </div>
        </div>

        <!-- Highlights -->
        <div>
          <h3 class="font-serif text-2xl font-bold text-slate-900 mb-6">Celebration Highlights</h3>
          <div class="grid sm:grid-cols-2 gap-6">
            <div class="bg-white p-8 rounded-[2rem] border border-slate-100 shadow-sm">
              <span class="text-med-gold text-[10px] font-bold uppercase tracking-widest mb-2 block">Bearers' Race</span>
              <h4 class="text-xl font-serif font-bold text-slate-900 mb-3">The culminating moment</h4>
              <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">At 8:00 pm the bearers ascend the 62 steps of the Cathedral carrying the silver bust of the Patron Saint, amid the ovations and prayers of the crowd.</p>
            </div>
            <div class="bg-white p-8 rounded-[2rem] border border-slate-100 shadow-sm">
              <span class="text-med-gold text-[10px] font-bold uppercase tracking-widest mb-2 block">Fireworks</span>
              <h4 class="text-xl font-serif font-bold text-slate-900 mb-3">Spectacle over the sea</h4>
              <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">The final fireworks display illuminates Amalfi's harbour basin. Watching from the sea is recommended to experience the full atmosphere of the evening.</p>
            </div>
          </div>
        </div>

        <!-- Getting There -->
        <div>
          <h3 class="font-serif text-2xl font-bold text-slate-900 mb-6">Getting There</h3>
          <div class="bg-white rounded-[2rem] border border-slate-100 overflow-hidden shadow-sm">
            <table class="w-full text-xs sm:text-xs sm:text-sm">
              <thead>
                <tr class="bg-slate-900 text-white">
                  <th class="text-left px-6 py-4 font-semibold">Transport</th>
                  <th class="text-left px-6 py-4 font-semibold">Service</th>
                  <th class="text-left px-6 py-4 font-semibold">Notes</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-slate-100">
                <tr class="hover:bg-slate-50 transition-colors">
                  <td class="px-6 py-4 font-medium">Ferry</td>
                  <td class="px-6 py-4 text-slate-600">Travelmar</td>
                  <td class="px-6 py-4 text-slate-500 text-xs">Extra services after fireworks, Amalfi–Salerno</td>
                </tr>
                <tr class="hover:bg-slate-50 transition-colors">
                  <td class="px-6 py-4 font-medium">SITA Bus</td>
                  <td class="px-6 py-4 text-slate-600">Positano–Amalfi line</td>
                  <td class="px-6 py-4 text-slate-500 text-xs">Restrictions likely from 6:00 pm</td>
                </tr>
                <tr class="hover:bg-slate-50 transition-colors">
                  <td class="px-6 py-4 font-medium">Parking</td>
                  <td class="px-6 py-4 text-slate-600">Luna Rossa</td>
                  <td class="px-6 py-4 text-slate-500 text-xs">Usually full by midday</td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>
      </div>

      <!-- Sidebar (30%) -->
      <aside class="lg:col-span-3">
        <div class="bg-slate-900 text-white p-10 rounded-[3rem] sticky top-32 shadow-2xl">
          <p class="text-[10px] uppercase tracking-[0.3em] text-med-gold font-medium mb-6">Event Details</p>
          <dl class="space-y-4">
            {facts.map(({ dt, dd }, i) => (
              <>
                <div>
                  <dt class="text-white/40 text-[10px] uppercase tracking-widest font-bold mb-1">{dt}</dt>
                  <dd class="text-white font-medium">{dd}</dd>
                </div>
                {i < facts.length - 1 && <div class="border-t border-white/5"></div>}
              </>
            ))}
          </dl>
          <div class="mt-10 pt-8 border-t border-white/5">
            <p class="text-white/50 text-xs leading-relaxed">We recommend arriving well in advance. Check the updated programme on official channels.</p>
          </div>
        </div>
      </aside>

    </div>
  </section>

  <!-- Recommended Events -->
  <section class="py-4 sm:py-12 px-6 max-w-7xl mx-auto">
    <h2 class="font-serif text-3xl sm:text-4xl font-bold text-slate-900 mb-12">Recommended Events</h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
      <div class="bg-white rounded-[2rem] border border-slate-100 overflow-hidden shadow-sm hover:shadow-md transition-shadow">
        <img src="/images/amalfi-hero.jpg" alt="Historic Regatta" class="h-40 w-full object-cover" />
        <div class="p-6">
          <span class="text-med-gold text-[10px] font-bold uppercase tracking-widest mb-2 block">June 2026</span>
          <h3 class="font-serif text-lg font-bold text-slate-900 mb-2">Historic Regatta</h3>
          <p class="text-slate-600 text-sm mb-4">Ancient maritime republics compete in historic rowing races.</p>
          <p class="text-slate-500 text-xs font-medium">📍 Amalfi, SA</p>
        </div>
      </div>
      <div class="bg-white rounded-[2rem] border border-slate-100 overflow-hidden shadow-sm hover:shadow-md transition-shadow">
        <img src="/images/positano-hero.jpg" alt="Ferragosto Fireworks" class="h-40 w-full object-cover" />
        <div class="p-6">
          <span class="text-med-gold text-[10px] font-bold uppercase tracking-widest mb-2 block">August 2026</span>
          <h3 class="font-serif text-lg font-bold text-slate-900 mb-2">Ferragosto Fireworks</h3>
          <p class="text-slate-600 text-sm mb-4">Spectacular pyrotechnics over the sea on the coast.</p>
          <p class="text-slate-500 text-xs font-medium">📍 Positano & Maiori, SA</p>
        </div>
      </div>
      <div class="bg-white rounded-[2rem] border border-slate-100 overflow-hidden shadow-sm hover:shadow-md transition-shadow">
        <img src="/images/ravello-hero.jpg" alt="Ravello Festival" class="h-40 w-full object-cover" />
        <div class="p-6">
          <span class="text-med-gold text-[10px] font-bold uppercase tracking-widest mb-2 block">July - September 2026</span>
          <h3 class="font-serif text-lg font-bold text-slate-900 mb-2">Ravello Festival</h3>
          <p class="text-slate-600 text-sm mb-4">Classical and contemporary music at Villa Rufolo.</p>
          <p class="text-slate-500 text-xs font-medium">📍 Ravello, SA</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Destinazione CTA -->
  <section class="bg-med-blue text-white py-12 sm:py-16 px-6">
    <div class="max-w-7xl mx-auto">
      <div class="flex flex-col sm:flex-row items-center justify-between gap-8">
        <div>
          <h3 class="font-serif text-2xl sm:text-3xl font-bold mb-3">Explore Amalfi</h3>
          <p class="text-white/70 text-sm sm:text-base max-w-md">Discover the birthplace of Limoncello and medieval maritime power.</p>
        </div>
        <a href="/en-us/amalfi-coast/amalfi/" class="bg-med-gold text-white px-8 py-3 rounded-full font-medium hover:bg-yellow-500 transition-colors whitespace-nowrap">
          View Destination →
        </a>
      </div>
    </div>
  </section>


