---
import BaseLayout from '../../../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../../../components/Breadcrumbs.astro';
import LocalitySlider from '../../../../../components/LocalitySlider.astro';

const lang = 'en-us';

const breadcrumbs = [
  { name: 'Home', url: '/en-us/' },
  { name: 'Events', url: '/en-us/events/' },
  { name: 'Notte Blu Vietri sul Mare', url: '/en-us/events/amalfi-coast/notte-blu-vietri/' },
];

const eventSchema = {
  "@context": "https://schema.org",
  "@type": "Event",
  "name": "Notte Blu Vietri sul Mare 2026",
  "startDate": "2026-07-01",
  "location": {
    "@type": "Place",
    "name": "Historic centre, Vietri sul Mare",
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Vietri sul Mare",
      "addressRegion": "SA",
      "addressCountry": "IT"
    }
  },
  "url": "https://amalficoast-travel.com/en-us/events/amalfi-coast/notte-blu-vietri/"
};

const facts = [
  { dt: 'Period', dd: 'July 2026' },
  { dt: 'Venue', dd: 'Historic centre, Vietri sul Mare' },
  { dt: 'Type', dd: 'Art & Music' },
  { dt: 'Entry', dd: 'Free' },
  { dt: 'Speciality', dd: 'Vietri ceramics' },
];
---

<BaseLayout
  title="Notte Blu Vietri sul Mare 2026 – Ceramics & Music"
  description="The Notte Blu in Vietri sul Mare in July 2026. Ceramic workshops open until late at night amid concerts and art installations in the historic centre."
  lang={lang}
  breadcrumbs={breadcrumbs}
  schema={[eventSchema]}
 pageKey="notte-blu-vietri">

  <!-- Hero -->
  <section class="relative h-[65vh] sm:h-[70vh] overflow-hidden flex items-center justify-center">
    <img
      src="/images/costiera-hero.jpg"
      alt="Notte Blu, Vietri sul Mare"
      class="absolute inset-0 w-full h-full object-cover"
      loading="eager" fetchpriority="high" decoding="sync" referrerpolicy="no-referrer"
    />
    <div class="absolute inset-0 bg-gradient-to-b from-black/20 via-black/50 to-black/70"></div>
    <div class="relative z-10 text-center px-6 max-w-5xl text-white">
      <div class="flex flex-wrap justify-center items-center gap-4 mb-6">
        <span class="bg-med-gold text-white px-4 py-1 rounded-full text-[10px] font-bold uppercase tracking-widest">Event 2026</span>
        <span class="text-white/70 text-xs sm:text-sm">July 2026</span>
        <span class="text-white/70 text-xs sm:text-sm">Vietri sul Mare, SA</span>
      </div>
      <h1 class="font-serif text-5xl md:text-7xl font-bold text-white leading-tight mb-6">Notte Blu</h1>
      <p class="text-white/85 text-lg md:text-xl font-light max-w-2xl mx-auto leading-relaxed">
        Art, ceramics and music until late in the heart of Vietri.
      </p>
    </div>
    <Breadcrumbs breadcrumbs={breadcrumbs} isEvent={true} />
  </section>

  <!-- Content 70/30 -->
  <section class="py-12 sm:py-24 px-6 max-w-7xl mx-auto">
    <div class="grid grid-cols-1 lg:grid-cols-10 gap-16">

      <!-- Main Content (70%) -->
      <div class="lg:col-span-7 space-y-12">
        <div>
          <h2 class="font-serif text-4xl font-bold text-slate-900 mb-8">About the Event</h2>
          <div class="space-y-4 text-slate-600 text-lg leading-relaxed">
            <p>An evening dedicated to ceramics and music. Workshops stay open until late at night amid concerts and art installations. Vietri sul Mare, famous for its centuries-old ceramic tradition, opens its ateliers to the public for a unique evening.</p>
            <p>The Notte Blu is the opportunity to discover the Vietri ceramic-making process directly from master craftsmen, in a festive atmosphere that extends throughout the historic centre.</p>
          </div>
        </div>

        <!-- The Night's Route -->
        <div>
          <h3 class="font-serif text-2xl font-bold text-slate-900 mb-6">The Night's Route</h3>
          <div class="grid sm:grid-cols-2 gap-6">
            <div class="bg-white p-8 rounded-[2rem] border border-slate-100 shadow-sm">
              <span class="text-med-gold text-[10px] font-bold uppercase tracking-widest mb-2 block">Open ateliers</span>
              <h4 class="text-xl font-serif font-bold text-slate-900 mb-3">Vietri ceramics by night</h4>
              <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Dozens of workshops open their doors and show live pottery wheel work and the painting of ceramics with traditional lemon-leaf and fish motifs.</p>
            </div>
            <div class="bg-white p-8 rounded-[2rem] border border-slate-100 shadow-sm">
              <span class="text-med-gold text-[10px] font-bold uppercase tracking-widest mb-2 block">Music & installations</span>
              <h4 class="text-xl font-serif font-bold text-slate-900 mb-3">Contemporary art meets tradition</h4>
              <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Light installations and live concerts animate the alleys and squares of the historic centre, creating a dialogue between traditional craftsmanship and contemporary art.</p>
            </div>
          </div>
        </div>

        <!-- Getting There -->
        <div>
          <h3 class="font-serif text-2xl font-bold text-slate-900 mb-6">Getting There</h3>
          <div class="bg-white rounded-[2rem] border border-slate-100 overflow-hidden shadow-sm">
            <table class="w-full text-xs sm:text-xs sm:text-sm">
              <thead>
                <tr class="bg-slate-900 text-white">
                  <th class="text-left px-6 py-4 font-semibold">Transport</th>
                  <th class="text-left px-6 py-4 font-semibold">Service</th>
                  <th class="text-left px-6 py-4 font-semibold">Notes</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-slate-100">
                <tr class="hover:bg-slate-50 transition-colors">
                  <td class="px-6 py-4 font-medium">Train</td>
                  <td class="px-6 py-4 text-slate-600">Trenitalia from Salerno</td>
                  <td class="px-6 py-4 text-slate-500 text-xs">5 minutes from Salerno Centrale</td>
                </tr>
                <tr class="hover:bg-slate-50 transition-colors">
                  <td class="px-6 py-4 font-medium">SITA Bus</td>
                  <td class="px-6 py-4 text-slate-600">From Amalfi</td>
                  <td class="px-6 py-4 text-slate-500 text-xs">Check night timetables</td>
                </tr>
                <tr class="hover:bg-slate-50 transition-colors">
                  <td class="px-6 py-4 font-medium">Car</td>
                  <td class="px-6 py-4 text-slate-600">A3 motorway, Vietri exit</td>
                  <td class="px-6 py-4 text-slate-500 text-xs">Free parking on the outskirts</td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>
      </div>

      <!-- Sidebar (30%) -->
      <aside class="lg:col-span-3">
        <div class="bg-slate-900 text-white p-10 rounded-[3rem] sticky top-32 shadow-2xl">
          <p class="text-[10px] uppercase tracking-[0.3em] text-med-gold font-medium mb-6">Event Details</p>
          <dl class="space-y-4">
            {facts.map(({ dt, dd }, i) => (
              <>
                <div>
                  <dt class="text-white/40 text-[10px] uppercase tracking-widest font-bold mb-1">{dt}</dt>
                  <dd class="text-white font-medium">{dd}</dd>
                </div>
                {i < facts.length - 1 && <div class="border-t border-white/5"></div>}
              </>
            ))}
          </dl>
          <div class="mt-10 pt-8 border-t border-white/5">
            <p class="text-white/50 text-xs leading-relaxed">We recommend arriving well in advance. Check the updated programme on official channels.</p>
          </div>
        </div>
      </aside>

    </div>
  </section>

  <LocalitySlider
    heading="Locations Near Vietri"
    lang={lang}
    items={[
      { name: "Vietri sul Mare", href: '/en-us/amalfi-coast/vietri-sul-mare/', image: '/images/costiera-hero.jpg', tag: "Event venue" },
      { name: "Cetara", href: '/en-us/amalfi-coast/cetara/', image: '/images/costiera-hero.jpg', tag: "Gastronomy" },
      { name: "Maiori", href: '/en-us/amalfi-coast/maiori/', image: '/images/costiera-hero.jpg', tag: "Coast" },
      { name: "Salerno", href: '/en-us/amalfi-coast/salerno/', image: '/images/costiera-hero.jpg', tag: "Historic" },
    ]}
  />

  <!-- Recommended Events -->
  <section class="py-4 sm:py-12 px-6 max-w-7xl mx-auto">
    <h2 class="font-serif text-3xl sm:text-4xl font-bold text-slate-900 mb-12">Recommended Events</h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
      <a href="/en-us/events/amalfi-coast/regata-storica-amalfi/" class="block bg-white rounded-[2rem] border border-slate-100 overflow-hidden shadow-sm hover:shadow-md transition-shadow">
        <img src="/images/amalfi-hero.jpg" alt="Historic Regatta" class="h-40 w-full object-cover" />
        <div class="p-6">
          <span class="text-med-gold text-[10px] font-bold uppercase tracking-widest mb-2 block">June 2026</span>
          <h3 class="font-serif text-lg font-bold text-slate-900 mb-2">Historic Regatta</h3>
          <p class="text-slate-600 text-sm mb-4">Ancient maritime republics compete in historic rowing races.</p>
          <p class="text-slate-500 text-xs font-medium">📍 Amalfi, SA</p>
        </div>
      </a>
      <a href="/en-us/events/amalfi-coast/fuochi-ferragosto-positano-maiori/" class="block bg-white rounded-[2rem] border border-slate-100 overflow-hidden shadow-sm hover:shadow-md transition-shadow">
        <img src="/images/positano-hero.jpg" alt="Ferragosto Fireworks" class="h-40 w-full object-cover" />
        <div class="p-6">
          <span class="text-med-gold text-[10px] font-bold uppercase tracking-widest mb-2 block">August 2026</span>
          <h3 class="font-serif text-lg font-bold text-slate-900 mb-2">Ferragosto Fireworks</h3>
          <p class="text-slate-600 text-sm mb-4">Spectacular pyrotechnics over the sea on the coast.</p>
          <p class="text-slate-500 text-xs font-medium">📍 Positano & Maiori, SA</p>
        </div>
      </a>
      <a href="/en-us/events/amalfi-coast/ravello-festival/" class="block bg-white rounded-[2rem] border border-slate-100 overflow-hidden shadow-sm hover:shadow-md transition-shadow">
        <img src="/images/ravello-hero.jpg" alt="Ravello Festival" class="h-40 w-full object-cover" />
        <div class="p-6">
          <span class="text-med-gold text-[10px] font-bold uppercase tracking-widest mb-2 block">July - September 2026</span>
          <h3 class="font-serif text-lg font-bold text-slate-900 mb-2">Ravello Festival</h3>
          <p class="text-slate-600 text-sm mb-4">Classical and contemporary music at Villa Rufolo.</p>
          <p class="text-slate-500 text-xs font-medium">📍 Ravello, SA</p>
        </div>
      </a>
    </div>
  </section>

  <!-- Destinazione CTA -->
  <section class="bg-med-blue text-white py-12 sm:py-16 px-6">
    <div class="max-w-7xl mx-auto">
      <div class="flex flex-col sm:flex-row items-center justify-between gap-8">
        <div>
          <h3 class="font-serif text-2xl sm:text-3xl font-bold mb-3">Explore Vietri sul Mare</h3>
          <p class="text-white/70 text-sm sm:text-base max-w-md">Famous for colorful ceramics and seaside charm.</p>
        </div>
        <a href="/en-us/amalfi-coast/vietri-sul-mare/" class="bg-med-gold text-white px-8 py-3 rounded-full font-medium hover:bg-yellow-500 transition-colors whitespace-nowrap">
          View Destination →
        </a>
      </div>
    </div>
  </section>


