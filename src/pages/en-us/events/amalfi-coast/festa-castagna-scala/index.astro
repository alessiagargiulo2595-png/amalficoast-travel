<EventPageLayout
  lang={lang}
  pageKey="festa-castagna-scala"
  metaTitle={"Scala Chestnut Festival 2026: Dates and Programme"}
  metaDescription={"The 49th Festa della Castagna in Scala on 10-11 and 17-18 October 2026, with a closing day on 24 October at Parco Paradiso. Roasted chestnuts, stalls and music in the oldest village on the Amalfi Coast."}
