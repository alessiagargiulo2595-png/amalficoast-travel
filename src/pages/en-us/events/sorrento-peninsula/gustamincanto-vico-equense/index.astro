---
import BaseLayout from '../../../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../../../components/Breadcrumbs.astro';
import LocalitySlider from '../../../../../components/LocalitySlider.astro';

const lang = 'en-us';

const breadcrumbs = [
  { name: 'Home', url: '/en-us/' },
  { name: 'Events', url: '/en-us/events/' },
  { name: 'Gustamincanto Vico Equense', url: '/en-us/' },
];

const eventSchema = {
  "@context": "https://schema.org",
  "@type": "EventSeries",
  "name": "Gustamincanto Vico Equense",
  "description": "Gustamincanto in Vico Equense in September 2026. The gastronomic excellence of the Sorrentine Peninsula featuring Provolone del Monaco and Michelin-starred chefs.",
  "image": "https://amalficoast-travel.com/images/vico-equense-hero.jpg",
  "url": "https://amalficoast-travel.com/en-us/",
  "location": {
      "@type": "Place",
      "name": "Historic centre, Vico Equense",
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Vico Equense",
        "addressRegion": "NA",
        "addressCountry": "IT"
      }
    },
  "eventStatus": "https://schema.org/EventScheduled",
  "eventAttendanceMode": "https://schema.org/OfflineEventAttendanceMode",
  "startDate": "2026-09-01",
  "endDate": "2026-09-30",
  "subEvent": [
    {
      "@type": "Event",
      "name": "Gustamincanto Vico Equense 2026",
      "startDate": "2026-09-01",
      "endDate": "2026-09-30",
      "eventStatus": "https://schema.org/EventScheduled",
      "eventAttendanceMode": "https://schema.org/OfflineEventAttendanceMode",
      "location": {
          "@type": "Place",
          "name": "Historic centre, Vico Equense",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Vico Equense",
            "addressRegion": "NA",
            "addressCountry": "IT"
          }
        },
      "url": "https://amalficoast-travel.com/en-us/",
      "image": "https://amalficoast-travel.com/images/vico-equense-hero.jpg",
      "description": "Gustamincanto in Vico Equense in September 2026. The gastronomic excellence of the Sorrentine Peninsula featuring Provolone del Monaco and Michelin-starred chefs."
    }
  ]
};

const facts = [
  { dt: 'Period', dd: 'September 2026' },
  { dt: 'Venue', dd: 'Historic centre, Vico Equense' },
  { dt: 'Type', dd: 'Food festival' },
  { dt: 'Speciality', dd: 'Provolone del Monaco DOP' },
  { dt: 'From Naples', dd: 'Circumvesuviana 50 min' },
];
---

<BaseLayout
  title="Gustamincanto Vico Equense 2026 – Food Festival"
  description="Gustamincanto in Vico Equense in September 2026. The gastronomic excellence of the Sorrentine Peninsula featuring Provolone del Monaco and Michelin-starred chefs."
  lang={lang}
  breadcrumbs={breadcrumbs}
  schema={[eventSchema]}
 pageKey="gustamincanto-vico-equense"
  heroImage="/images/vico-equense-hero.jpg"
>

  <!-- Hero -->
  <section class="relative h-[65vh] sm:h-[70vh] overflow-hidden flex items-center justify-center">
    <img
      src="/images/vico-equense-hero.jpg"
      alt="Gustamincanto, Vico Equense"
      class="absolute inset-0 w-full h-full object-cover"
      loading="eager" fetchpriority="high" decoding="sync" referrerpolicy="no-referrer"
    />
    <div class="absolute inset-0 bg-gradient-to-b from-black/20 via-black/50 to-black/70"></div>
    <div class="relative z-10 text-center px-6 max-w-5xl text-white">
      <div class="flex flex-wrap justify-center items-center gap-4 mb-6">
        <span class="bg-med-gold text-white px-4 py-1 rounded-full text-[10px] font-bold uppercase tracking-widest">Event 2026</span>
        <span class="text-white/70 text-xs sm:text-sm">September 2026</span>
        <span class="text-white/70 text-xs sm:text-sm">Vico Equense, NA</span>
      </div>
      <h1 class="font-serif text-5xl md:text-7xl font-bold text-white leading-tight mb-6">Gustamincanto</h1>
      <p class="text-white/85 text-lg md:text-xl font-light max-w-2xl mx-auto leading-relaxed">
        The gastronomic excellence of the Sorrentine Peninsula in the medieval streets of Vico Equense.
      </p>
    </div>
    <Breadcrumbs breadcrumbs={breadcrumbs} isEvent={true} />
  </section>

  <!-- Content 70/30 -->
  <section class="py-12 sm:py-24 px-6 max-w-7xl mx-auto">
    <div class="grid grid-cols-1 lg:grid-cols-10 gap-16">

      <!-- Main Content (70%) -->
      <div class="lg:col-span-7 space-y-12">
        <div>
          <h2 class="font-serif text-4xl font-bold text-slate-900 mb-8">About the Event</h2>
          <div class="space-y-4 text-slate-600 text-lg leading-relaxed">
            <p>A food festival involving the territory's finest producers, from Provolone del Monaco makers to the city's Michelin-starred chefs. A food and wine trail through the medieval streets of Vico Equense's historic centre.</p>
            <p>Gustamincanto brings together local producers, restaurateurs and starred chefs in a single event celebrating the gastronomic biodiversity of the Sorrentine Peninsula. Provolone del Monaco DOP, IGP lemons and local wines are among the stars.</p>
          </div>
        </div>

        <!-- The Highlights -->
        <div>
          <h3 class="font-serif text-2xl font-bold text-slate-900 mb-6">Festival Highlights</h3>
          <div class="grid sm:grid-cols-2 gap-6">
            <div class="bg-white p-8 rounded-[2rem] border border-slate-100 shadow-sm">
              <span class="text-med-gold text-[10px] font-bold uppercase tracking-widest mb-2 block">Provolone del Monaco</span>
              <h4 class="text-xl font-serif font-bold text-slate-900 mb-3">The king of local cheeses</h4>
              <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Provolone del Monaco DOP, produced exclusively on the Sorrentine Peninsula, is presented in its various maturation stages paired with local wines and chestnut honey.</p>
            </div>
            <div class="bg-white p-8 rounded-[2rem] border border-slate-100 shadow-sm">
              <span class="text-med-gold text-[10px] font-bold uppercase tracking-widest mb-2 block">Starred chefs</span>
              <h4 class="text-xl font-serif font-bold text-slate-900 mb-3">Fine dining in the square</h4>
              <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">The Peninsula's best chefs bring their cuisine to the street with open-air cooking shows and accessible tastings along the gastronomic trail.</p>
            </div>
          </div>
        </div>

        <!-- Getting There -->
        <div>
          <h3 class="font-serif text-2xl font-bold text-slate-900 mb-6">Getting There</h3>
          <div class="bg-white rounded-[2rem] border border-slate-100 overflow-hidden shadow-sm">
            <table class="w-full text-xs sm:text-xs sm:text-sm">
              <thead>
                <tr class="bg-slate-900 text-white">
                  <th class="text-left px-6 py-4 font-semibold">Transport</th>
                  <th class="text-left px-6 py-4 font-semibold">Service</th>
                  <th class="text-left px-6 py-4 font-semibold">Notes</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-slate-100">
                <tr class="hover:bg-slate-50 transition-colors">
                  <td class="px-6 py-4 font-medium">Circumvesuviana</td>
                  <td class="px-6 py-4 text-slate-600">From Naples Garibaldi</td>
                  <td class="px-6 py-4 text-slate-500 text-xs">50 minutes, Vico Equense stop</td>
                </tr>
                <tr class="hover:bg-slate-50 transition-colors">
                  <td class="px-6 py-4 font-medium">Car</td>
                  <td class="px-6 py-4 text-slate-600">A3 motorway, Castellammare exit</td>
                  <td class="px-6 py-4 text-slate-500 text-xs">Parking on the outskirts of the historic centre</td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>
      </div>

      <!-- Sidebar (30%) -->
      <aside class="lg:col-span-3">
        <div class="bg-slate-900 text-white p-10 rounded-[3rem] sticky top-32 shadow-2xl">
          <p class="text-[10px] uppercase tracking-[0.3em] text-med-gold font-medium mb-6">Event Details</p>
          <dl class="space-y-4">
            {facts.map(({ dt, dd }, i) => (
              <>
                <div>
                  <dt class="text-white/40 text-[10px] uppercase tracking-widest font-bold mb-1">{dt}</dt>
                  <dd class="text-white font-medium">{dd}</dd>
                </div>
                {i < facts.length - 1 && <div class="border-t border-white/5"></div>}
              </>
            ))}
          </dl>
          <div class="mt-10 pt-8 border-t border-white/5">
            <p class="text-white/50 text-xs leading-relaxed">We recommend arriving well in advance. Check the updated programme on official channels.</p>
          </div>
        </div>
      </aside>

    </div>
  </section>

  <LocalitySlider
    heading="Discover Vico Equense and Surroundings"
    lang={lang}
    items={[
      { name: "Vico Equense", href: '/en-us/sorrento-peninsula/vico-equense/', image: '/images/vico-equense-hero.jpg', tag: "Event venue" },
      { name: "Meta", href: '/en-us/sorrento-peninsula/meta/', image: '/images/meta-hero.webp', tag: "Nearby" },
      { name: "Sorrento", href: '/en-us/sorrento-peninsula/sorrento/', image: '/images/sorrento-hero.jpg', tag: "Iconic" },
      { name: "Massa Lubrense", href: '/en-us/sorrento-peninsula/massa-lubrense/', image: '/images/massa-lubrense-hero.jpg', tag: "Nature" },
    ]}
  />

    <!-- BANNER: Itinerary Planner -->
  <section class="py-10 md:py-14 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6">
      <div class="relative overflow-hidden rounded-[2.5rem] bg-gradient-to-br from-slate-900 via-slate-950 to-blue-950 px-6 sm:px-10 md:px-14 py-10 md:py-14 shadow-[0_20px_60px_rgba(0,0,0,0.35)]">
        <div class="absolute -top-20 -left-20 w-72 h-72 bg-blue-500/15 rounded-full blur-3xl pointer-events-none"></div>
        <div class="absolute -bottom-20 -right-20 w-72 h-72 bg-amber-500/10 rounded-full blur-3xl pointer-events-none"></div>
        <div class="relative z-10 grid md:grid-cols-[3fr_2fr] md:items-center gap-8">
          <div>
            <span class="inline-block px-4 py-1.5 rounded-full text-xs font-semibold tracking-wide uppercase bg-med-gold/15 text-med-gold border border-med-gold/25 mb-6">New: Custom Trip</span>
            <h2 class="text-3xl md:text-4xl font-bold text-white leading-tight mb-2">Design your</h2>
            <p class="font-serif text-3xl md:text-4xl italic text-med-blue mb-5">ideal itinerary</p>
            <p class="text-white/60 text-base md:text-lg leading-relaxed max-w-xl mb-8">
              Answer a few simple questions - starting point, days and interests - and get a personalized itinerary with transport, costs and times.
            </p>
            <div class="flex flex-wrap gap-6">
              <div class="flex items-center gap-2.5">
                <div class="w-9 h-9 rounded-xl bg-white/5 border border-white/10 flex items-center justify-center">
                  <svg class="w-4 h-4 text-med-gold" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                </div>
                <span class="text-white/50 text-sm">30 seconds to set up</span>
              </div>
              <div class="flex items-center gap-2.5">
                <div class="w-9 h-9 rounded-xl bg-white/5 border border-white/10 flex items-center justify-center">
                  <svg class="w-4 h-4 text-med-gold" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 6.75V15m6-6v8.25m.503 3.498l4.875-2.437c.381-.19.622-.58.622-1.006V4.82c0-.836-.88-1.38-1.628-1.006l-3.869 1.934c-.317.159-.69.159-1.006 0L9.503 3.252a1.125 1.125 0 00-1.006 0L3.622 5.689C3.24 5.88 3 6.27 3 6.695V19.18c0 .836.88 1.38 1.628 1.006l3.869-1.934c.317-.159.69-.159 1.006 0l4.994 2.497c.317.158.69.158 1.006 0z"/></svg>
                </div>
                <span class="text-white/50 text-sm">Anti-crowd tips included</span>
              </div>
            </div>
          </div>
          <div class="mt-8 md:mt-0 md:flex md:justify-center">
            <a href="/en-us/itinerary-planner/" class="inline-flex items-center gap-2.5 px-7 py-3.5 bg-gradient-to-r from-med-gold to-yellow-600 text-slate-900 font-bold rounded-xl hover:shadow-[0_0_30px_rgba(212,175,55,0.4)] hover:scale-105 transition-all duration-300">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 2L2 12l4 0 0 6 4 0 0-4 4 0 0 4 4 0 0-6 4 0L12 2z"/></svg>
              Configure Now
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Related Events -->
  <section class="py-4 sm:py-12 px-6 max-w-7xl mx-auto">
    <h2 class="font-serif text-3xl sm:text-4xl font-bold text-slate-900 mb-12">Related Events</h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
      <a href="/en-us/events/sorrento-peninsula/festa-sant-antonino/" class="block bg-white rounded-[2rem] border border-slate-100 overflow-hidden shadow-sm hover:shadow-md transition-shadow">
        <img src="/images/sorrento-hero.jpg" alt="Saint Antonino" class="h-40 w-full object-cover" />
        <div class="p-6">
          <span class="text-med-gold text-[10px] font-bold uppercase tracking-widest mb-2 block">February 2026</span>
          <h3 class="font-serif text-lg font-bold text-slate-900 mb-2">Saint Antonino's Festival</h3>
          <p class="text-slate-600 text-sm mb-4">Celebration of the patron saint with processions and festivities.</p>
          <p class="text-slate-500 text-xs font-medium">📍 Sorrento, NA</p>
        </div>
      </a>
      <a href="/en-us/events/sorrento-peninsula/sagra-limone-massa-lubrense/" class="block bg-white rounded-[2rem] border border-slate-100 overflow-hidden shadow-sm hover:shadow-md transition-shadow">
        <img src="/images/massa-lubrense-hero.jpg" alt="Lemon Festival" class="h-40 w-full object-cover" />
        <div class="p-6">
          <span class="text-med-gold text-[10px] font-bold uppercase tracking-widest mb-2 block">June 2026</span>
          <h3 class="font-serif text-lg font-bold text-slate-900 mb-2">Lemon Festival</h3>
          <p class="text-slate-600 text-sm mb-4">Celebration of famous Sorrento lemons with tastings and exhibits.</p>
          <p class="text-slate-500 text-xs font-medium">📍 Massa Lubrense, NA</p>
        </div>
      </a>
      <a href="/en-us/events/sorrento-peninsula/sorrento-meeting-cultura/" class="block bg-white rounded-[2rem] border border-slate-100 overflow-hidden shadow-sm hover:shadow-md transition-shadow">
        <img src="/images/sorrento-hero.jpg" alt="Sorrento Meeting" class="h-40 w-full object-cover" />
        <div class="p-6">
          <span class="text-med-gold text-[10px] font-bold uppercase tracking-widest mb-2 block">April 2026</span>
          <h3 class="font-serif text-lg font-bold text-slate-900 mb-2">Sorrento Meeting Culture</h3>
          <p class="text-slate-600 text-sm mb-4">Cultural gathering featuring art, theatre, and intellectual discussions.</p>
          <p class="text-slate-500 text-xs font-medium">📍 Sorrento, NA</p>
        </div>
      </a>
    </div>
  </section>

  <!-- Destinazione CTA -->
  <section class="bg-med-blue text-white py-12 sm:py-16 px-6">
    <div class="max-w-7xl mx-auto">
      <div class="flex flex-col sm:flex-row items-center justify-between gap-8">
        <div>
          <h3 class="font-serif text-2xl sm:text-3xl font-bold mb-3">Explore Vico Equense</h3>
          <p class="text-white/70 text-sm sm:text-base max-w-md">Ancient Greek settlement with beaches and mountain scenery.</p>
        </div>
        <a href="/en-us/sorrento-peninsula/vico-equense/" class="bg-med-gold text-white px-8 py-3 rounded-full font-medium hover:bg-yellow-500 transition-colors whitespace-nowrap">
          View Destination →
        </a>
      </div>
    </div>
  </section>


