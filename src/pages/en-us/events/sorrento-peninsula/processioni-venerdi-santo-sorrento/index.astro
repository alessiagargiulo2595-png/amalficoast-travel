<EventPageLayout
  lang={lang}
  pageKey="processioni-venerdi-santo-sorrento"
  metaTitle={"Good Friday Processions Sorrento 2027: White and Black"}
  metaDescription={"Sorrento's two Good Friday processions on 26 March 2027: the White of the Addolorata at 3am and the Black of the Dead Christ at 8.30pm. Who the hooded brothers are and how to attend."}
