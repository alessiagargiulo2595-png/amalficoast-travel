---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../../components/Breadcrumbs.astro';
import CorrelationSlider from '../../../../components/CorrelationSlider.astro';

const lang = 'en-us';

const breadcrumbs = [
  { name: 'Home', url: '/en-us/' },
  { name: 'Experiences', url: '/en-us/experiences/' },
  { name: 'Boat Tours', url: '/en-us/experiences/boat-tours/' },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "How much does a boat tour on the Amalfi Coast cost?",
      "acceptedAnswer": { "@type": "Answer", "text": "A group boat tour on the Amalfi Coast (4-6 hours) costs €50-€80 per person. Private boat hire (without skipper) starts from €200/day for small vessels; with skipper from €400-800/day. In Capri, rowboat trips to the Blue Grotto cost ~€15." }
    },
    {
      "@type": "Question",
      "name": "Where do boat tours depart from?",
      "acceptedAnswer": { "@type": "Answer", "text": "Boat tours depart mainly from: Positano (for the Coast and Capri), Amalfi (for the Coast and grottos), Sorrento (for Capri and the Coast), Marina Grande di Capri (for Faraglioni and Blue Grotto). In summer, book 1-2 days in advance." }
    },
    {
      "@type": "Question",
      "name": "Are boat tours cancelled in bad weather?",
      "acceptedAnswer": { "@type": "Answer", "text": "Yes, all boat tours are cancelled in rough seas (waves above 0.8-1m) or strong winds. Cancellations are frequent in April, October and with tramontana wind. Always check sea conditions the day before at windguru.cz or windy.com." }
    }
  ]
};

const tours = [
  {
    name: 'Faraglioni Tour, Capri',
    from: 'Marina Grande, Capri',
    duration: '1-2 hours',
    price: '€18-25',
    highlights: 'Faraglioni, Grotta Verde, passage under Mezzo arch, snorkelling',
    type: 'Group',
    img: '/images/faraglioni-capri.webp',
  },
  {
    name: 'Blue Grotto by Rowboat',
    from: 'Marina Grande, Capri',
    duration: '30 min',
    price: '€15 + €14 entry',
    highlights: 'Unique blue light, rowing boats, unmissable experience',
    type: 'Individual',
    img: '/images/marina-piccola-capri.webp',
  },
  {
    name: 'Amalfi Coast from Positano',
    from: 'Positano, Spiaggia Grande',
    duration: '4-6 hours',
    price: '€50-80',
    highlights: 'Emerald Grotto, Praiano, Amalfi from the sea, snorkelling in hidden coves',
    type: 'Group',
    img: '/images/positano-hero.webp',
  },
  {
    name: 'Coast Tour from Amalfi',
    from: 'Amalfi harbour',
    duration: '3-5 hours',
    price: '€40-70',
    highlights: 'Emerald Grotto, Positano, inaccessible coves, lunch at sea',
    type: 'Group',
    img: '/images/amalfi-hero.webp',
  },
  {
    name: 'Private Boat Sorrento → Capri',
    from: 'Sorrento, Marina Piccola',
    duration: 'Full day',
    price: '€400-800',
    highlights: 'Custom itinerary, no crowds, snorkelling, on-board lunch',
    type: 'Private',
    img: '/images/sorrento-hero.webp',
  },
  {
    name: 'Sunset Cruise',
    from: 'Positano / Amalfi',
    duration: '2-3 hours',
    price: '€60-90',
    highlights: 'Golden hour, prosecco on board, the Coast lit by sunset light',
    type: 'Group',
    img: '/images/tramonto-costiera.webp',
  },
];

const tips = [
  'For the Blue Grotto in Capri: arrive before 10:00. The afternoon queue can be 2 hours.',
  'Group tours from Positano are great for solo travellers: meet people, see the Coast, spend less.',
  'With family (children): choose 3-4h max tours and avoid speedboats/RIBs (more rolling).',
  'The Emerald Grotto from Amalfi is also walkable (€5 entry): you don\'t need a tour if you have transport.',
  'Book online at least 1-2 days ahead in July-August: spots sell out fast.',
];
---

<BaseLayout
  title="Boat Tours Amalfi Coast 2026 | Capri, Positano, Blue Grotto"
  description="Best boat tours on the Amalfi Coast: Capri Faraglioni, Blue Grotto, tours from Positano and Amalfi. Prices, durations and tips for choosing the right tour."
  lang={lang}
  breadcrumbs={breadcrumbs}
  schema={[faqSchema]}
  pageKey="boat-tours"
  heroImage="/images/capri-hero.webp"
>

  <!-- HERO -->
  <section class="relative h-[90svh] sm:min-h-[90vh] md:h-screen flex flex-col items-center justify-center bg-charcoal overflow-hidden">
    <img src="/images/capri-hero.webp" alt="Boat tour, Amalfi Coast" referrerpolicy="no-referrer" class="absolute inset-0 w-full h-full object-cover object-center" loading="eager" fetchpriority="high" decoding="sync" />
    <div class="absolute inset-0 bg-gradient-to-b from-black/60 sm:from-black/55 via-black/40 sm:via-black/30 to-black/70 sm:to-black/65"></div>

    <div class="relative text-center px-6 max-w-4xl mx-auto md:flex md:flex-col md:justify-center">
      <p class="text-med-gold text-xs font-medium uppercase tracking-[0.3em] mb-6 mt-6">Experiences · Boat &amp; Sea</p>
      <h1 class="font-serif text-white leading-tight mb-6" style="font-size: clamp(2.5rem, 6vw, 5rem); letter-spacing: -0.02em;">
        Boat <em class="not-italic text-med-gold">Tours</em>
      </h1>
      <p class="text-blue-100 text-lg md:text-xl leading-relaxed max-w-2xl mx-auto mb-[4vh] md:mb-0 font-light">
        The Amalfi Coast from the sea is a different world: grottos unreachable by land, hidden coves and the <strong>Faraglioni of Capri</strong> rising above your head. From budget group tours to full private charters.
      </p>
      <div class="flex flex-row gap-3 justify-center md:mt-6">
        <a href="https://gyg.me/XJThZqw1" target="_blank" rel="sponsored noopener"
           class="inline-block bg-med-gold text-slate-900 font-semibold px-8 py-3.5 rounded-full hover:scale-105 hover:shadow-[0_8px_30px_rgba(212,175,55,0.4)] transition-all duration-300 text-xs sm:text-sm">
          Book on GetYourGuide
        </a>
        <a href="#tours"
           class="inline-block border-2 border-white/50 text-white font-medium px-8 py-3.5 rounded-full hover:bg-white/10 hover:border-white transition-all duration-300 text-xs sm:text-sm">
          Browse tours
        </a>
      </div>
    </div>

    <!-- Scroll indicator -->
    <div class="absolute bottom-[2vh] md:bottom-[4vh] left-1/2 -translate-x-1/2 flex flex-col items-center gap-2 text-white/40 z-20">
      <svg class="w-4 h-4 animate-bounce" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
      </svg>
    </div>

    <Breadcrumbs breadcrumbs={breadcrumbs} />
  </section>

  <!-- KEY FACTS -->
  <section class="bg-white py-16">
    <div class="max-w-7xl mx-auto px-6">
      <p class="text-med-gold text-xs uppercase tracking-[0.3em] font-medium text-center mb-3">At a glance</p>
      <div class="w-20 h-1 bg-med-gold mx-auto rounded-full mb-12"></div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 md:gap-8">
        <div class="group bg-slate-900 p-8 rounded-[2rem] border border-slate-800 hover:border-med-gold/40 transition-all duration-300">
          <div class="w-14 h-14 rounded-2xl bg-med-gold/15 text-med-gold flex items-center justify-center mb-6 group-hover:scale-110 transition-transform">
            <svg class="w-7 h-7" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6l4 2"/><circle cx="12" cy="12" r="9" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </div>
          <div class="font-serif text-5xl font-bold text-white mb-3 tracking-tight">4-6 h</div>
          <p class="text-white/80 font-medium mb-2">average tour duration</p>
          <p class="text-white/60 text-xs sm:text-sm leading-relaxed font-light">Full Coast and Capri tours; shorter options (1-2h) for the Faraglioni only.</p>
        </div>

        <div class="group bg-slate-900 p-8 rounded-[2rem] border border-slate-800 hover:border-med-gold/40 transition-all duration-300">
          <div class="w-14 h-14 rounded-2xl bg-med-gold/15 text-med-gold flex items-center justify-center mb-6 group-hover:scale-110 transition-transform">
            <svg class="w-7 h-7" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 1v22M5 8h14M5 16h14"/></svg>
          </div>
          <div class="font-serif text-5xl font-bold text-white mb-3 tracking-tight">€50-80</div>
          <p class="text-white/80 font-medium mb-2">group tour, per person</p>
          <p class="text-white/60 text-xs sm:text-sm leading-relaxed font-light">Private charters from €400/day. Blue Grotto rowboat ~€15 plus €14 entry.</p>
        </div>

        <div class="group bg-slate-900 p-8 rounded-[2rem] border border-slate-800 hover:border-med-gold/40 transition-all duration-300">
          <div class="w-14 h-14 rounded-2xl bg-med-gold/15 text-med-gold flex items-center justify-center mb-6 group-hover:scale-110 transition-transform">
            <svg class="w-7 h-7" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0Z"/><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0Z"/></svg>
          </div>
          <div class="font-serif text-5xl font-bold text-white mb-3 tracking-tight">4</div>
          <p class="text-white/80 font-medium mb-2">main departure ports</p>
          <p class="text-white/60 text-xs sm:text-sm leading-relaxed font-light">Positano, Amalfi, Sorrento and Marina Grande di Capri. Pick by location.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- TOURS GRID -->
  <section id="tours" class="py-16 bg-med-cream">
    <div class="max-w-7xl mx-auto px-6">
      <div class="flex flex-col md:flex-row justify-between items-end mb-12 gap-6">
        <div class="max-w-2xl">
          <p class="text-med-gold text-xs font-bold uppercase tracking-[0.3em] mb-3">Choose your tour</p>
          <h2 class="font-serif text-4xl md:text-5xl font-bold text-slate-900 tracking-tight mb-4">Most popular tours</h2>
          <div class="w-20 h-1 bg-med-gold rounded-full mb-4"></div>
          <p class="text-slate-500 text-lg font-light">Six tours covering every taste and budget, from the iconic Faraglioni to a sunset cruise with prosecco on board.</p>
        </div>
        <a href="https://gyg.me/XJThZqw1" target="_blank" rel="sponsored noopener" class="group flex items-center gap-2 text-med-blue font-semibold hover:text-med-gold transition-colors flex-shrink-0">
          See all on GetYourGuide
          <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {tours.map((t, i) => (
          <a href="https://gyg.me/XJThZqw1" target="_blank" rel="sponsored noopener" class="group cursor-pointer bg-transparent">
            <div class="relative aspect-square md:aspect-[4/5] overflow-hidden rounded-[3rem] mb-6 sm:shadow-none md:shadow-[0_20px_50px_rgba(0,0,0,0.3)]">
              <img
                src={t.img}
                alt={t.name}
                referrerpolicy="no-referrer"
                class="w-full h-full object-cover transition-transform duration-1000 group-hover:scale-110"
                loading={i < 3 ? "eager" : "lazy"}
                fetchpriority={i < 3 ? "high" : "auto"}
                decoding={i < 3 ? "sync" : "async"}
              />
              <div class="absolute inset-0 hidden xl:block bg-gradient-to-t from-black/90 via-black/20 to-transparent" />
              <div class="absolute top-6 right-6">
                <span class={`text-[10px] uppercase tracking-wider px-3 py-1 rounded-full font-bold backdrop-blur-sm ${t.type === 'Private' ? 'bg-med-gold/90 text-slate-900' : t.type === 'Individual' ? 'bg-white/90 text-med-blue' : 'bg-white/80 text-slate-700'}`}>
                  {t.type}
                </span>
              </div>
              <div class="absolute bottom-8 left-8 right-8">
                <span class="text-med-gold text-xs font-bold uppercase tracking-[0.3em] mb-2 block">{t.duration} · {t.price}</span>
                <h3 class="font-serif text-xl md:text-3xl font-bold text-white tracking-tight">{t.name}</h3>
              </div>
            </div>
            <p class="text-slate-500 text-xs sm:text-sm leading-relaxed font-light mb-4">{t.highlights}</p>
            <div class="flex items-center gap-2 text-[10px] uppercase tracking-wider font-bold text-med-blue">
              <svg class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0Z"/><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0Z"/></svg>
              {t.from}
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- BANNER: Itinerary Planner -->
  <section class="py-10 md:py-14 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6">
      <div class="relative overflow-hidden rounded-[2.5rem] bg-gradient-to-br from-slate-900 via-slate-950 to-blue-950 px-6 sm:px-10 md:px-14 py-10 md:py-14 shadow-[0_20px_60px_rgba(0,0,0,0.35)]">
        <!-- Ambient glow -->
        <div class="absolute -top-20 -left-20 w-72 h-72 bg-blue-500/15 rounded-full blur-3xl pointer-events-none"></div>
        <div class="absolute -bottom-20 -right-20 w-72 h-72 bg-amber-500/10 rounded-full blur-3xl pointer-events-none"></div>

        <div class="relative z-10 grid md:grid-cols-[3fr_2fr] md:items-center gap-8">
          <!-- Left: text content -->
          <div>
            <!-- Badge -->
            <span class="inline-block px-4 py-1.5 rounded-full text-xs font-semibold tracking-wide uppercase bg-med-gold/15 text-med-gold border border-med-gold/25 mb-6">New: Custom Trip Planner</span>

            <!-- Title -->
            <h2 class="text-3xl md:text-4xl font-bold text-white leading-tight mb-2">Design your</h2>
            <p class="font-serif text-3xl md:text-4xl italic text-med-blue mb-5">perfect itinerary</p>

            <!-- Description -->
            <p class="text-white/60 text-base md:text-lg leading-relaxed max-w-xl mb-8">
              Answer a few simple questions - starting point, days and interests - and get a personalised itinerary with transport, costs and times.
            </p>

            <!-- Quick indicators -->
            <div class="flex flex-wrap gap-6">
              <div class="flex items-center gap-2.5">
                <div class="w-9 h-9 rounded-xl bg-white/5 border border-white/10 flex items-center justify-center">
                  <svg class="w-4.5 h-4.5 text-med-gold" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                </div>
                <span class="text-white/50 text-sm">30 seconds to set up</span>
              </div>
              <div class="flex items-center gap-2.5">
                <div class="w-9 h-9 rounded-xl bg-white/5 border border-white/10 flex items-center justify-center">
                  <svg class="w-4.5 h-4.5 text-med-gold" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 6.75V15m6-6v8.25m.503 3.498l4.875-2.437c.381-.19.622-.58.622-1.006V4.82c0-.836-.88-1.38-1.628-1.006l-3.869 1.934c-.317.159-.69.159-1.006 0L9.503 3.252a1.125 1.125 0 00-1.006 0L3.622 5.689C3.24 5.88 3 6.27 3 6.695V19.18c0 .836.88 1.38 1.628 1.006l3.869-1.934c.317-.159.69-.159 1.006 0l4.994 2.497c.317.158.69.158 1.006 0z"/></svg>
                </div>
                <span class="text-white/50 text-sm">Anti-crowd tips included</span>
              </div>
            </div>
          </div>

          <!-- Right: CTA centered vertically -->
          <div class="mt-8 md:mt-0 md:flex md:justify-center">
            <a href="/en-us/itinerary-planner/" class="inline-flex items-center gap-2.5 px-7 py-3.5 bg-gradient-to-r from-med-gold to-yellow-600 text-slate-900 font-bold rounded-xl hover:shadow-[0_0_30px_rgba(212,175,55,0.4)] hover:scale-105 transition-all duration-300">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 2L2 12l4 0 0 6 4 0 0-4 4 0 0 4 4 0 0-6 4 0L12 2z"/></svg>
              Plan Now
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- TIPS -->
  <section class="py-16 bg-white">
    <div class="max-w-7xl mx-auto px-6">
      <div class="text-center mb-12">
        <p class="text-med-gold text-xs font-bold uppercase tracking-[0.3em] mb-3">Insider notes</p>
        <h2 class="font-serif text-4xl md:text-5xl font-bold text-slate-900 mb-4">Tips for choosing the right tour</h2>
        <div class="w-20 h-1 bg-med-gold mx-auto rounded-full"></div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 max-w-5xl mx-auto">
        {tips.map((tip, i) => (
          <div class="group bg-med-cream p-7 rounded-[2rem] border border-med-gold/20 hover:border-med-gold/50 transition-colors flex items-start gap-4">
            <div class="w-10 h-10 rounded-xl bg-med-gold/15 text-med-gold flex-shrink-0 flex items-center justify-center font-serif font-bold text-lg">
              {String(i + 1).padStart(2, '0')}
            </div>
            <p class="text-charcoal text-xs sm:text-sm leading-relaxed pt-1.5">{tip}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section id="faq" class="py-16 bg-med-cream">
    <div class="max-w-4xl mx-auto px-6">
      <div class="text-center mb-12">
        <p class="text-med-gold text-xs font-bold uppercase tracking-[0.3em] mb-3">Good to know</p>
        <h2 class="font-serif text-4xl md:text-5xl font-bold text-slate-900 mb-4">Frequently asked questions</h2>
        <div class="w-20 h-1 bg-med-gold mx-auto rounded-full"></div>
      </div>

      <div class="space-y-4">
        {faqSchema.mainEntity.map((q) => (
          <details class="group bg-white border border-slate-200 rounded-2xl overflow-hidden hover:border-med-gold/40 transition-colors">
            <summary class="flex items-center justify-between px-6 py-5 cursor-pointer select-none text-charcoal font-medium">
              <span class="text-sm sm:text-base">{q.name}</span>
              <svg class="w-4 h-4 text-med-gold group-open:rotate-180 transition-transform flex-shrink-0 ml-3" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
            </summary>
            <div class="px-6 pb-5 text-slate-600 leading-relaxed text-xs sm:text-sm border-t border-slate-100 pt-4">
              {q.acceptedAnswer.text}
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <CorrelationSlider
    heading="Explore tour destinations"
    items={[
      { name: 'Capri',    href: '/en-us/islands/capri/',                 tag: 'Faraglioni',     desc: 'Blue Grotto, Faraglioni tour and inaccessible coves.' },
      { name: 'Positano', href: '/en-us/amalfi-coast/positano/',         tag: 'Coast Tours',    desc: 'Departure point for Coast tours heading east.' },
      { name: 'Amalfi',   href: '/en-us/amalfi-coast/amalfi/',           tag: 'Emerald Grotto', desc: 'The Emerald Grotto and tours towards Positano.' },
      { name: 'Procida',  href: '/en-us/islands/procida/',               tag: 'Authentic Isle', desc: 'Boat trips around this small fisherman\'s island.' },
    ]}
  />

</BaseLayout>
