---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../../components/Breadcrumbs.astro';
import CorrelationSlider from '../../../../components/CorrelationSlider.astro';

const lang = 'en-us';

const breadcrumbs = [
  { name: 'Home', url: '/en-us/' },
  { name: 'Experiences', url: '/en-us/experiences/' },
  { name: 'Hiking & Path of the Gods', url: '/en-us/experiences/trekking/' },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Is hiking on the Amalfi Coast difficult?",
      "acceptedAnswer": { "@type": "Answer", "text": "It depends on the trail. Most routes here are graded E (moderate): a few hours of walking on stone paths and steps, no technical skill required. Only the Path of the Gods carries the harder EE grade, because of exposed stretches with no railing. The real difficulty on this coast is not gradient but steps: almost every trail begins or ends with several hundred of them." }
    },
    {
      "@type": "Question",
      "name": "What is the best hike on the Amalfi Coast?",
      "acceptedAnswer": { "@type": "Answer", "text": "The Path of the Gods (Sentiero degli Dei) is the signature route: 8 km from Agerola to Nocelle, 3 to 4 hours, walking high above the sea with Positano and Capri in view for most of it. If you want something gentler and shaded, Valle delle Ferriere above Amalfi is a 7 km round trip through waterfalls and ferns." }
    },
    {
      "@type": "Question",
      "name": "When is the best time of year to hike the Amalfi Coast?",
      "acceptedAnswer": { "@type": "Answer", "text": "April to early June and September to October. Temperatures sit between 16 and 24°C, the light is clear and the trails are dry. July and August are genuinely punishing: most routes have no shade and no water points, and midday temperatures reach 32°C. Winter walking is possible but paths get muddy and the stone steps turn slippery." }
    },
    {
      "@type": "Question",
      "name": "Which direction should I walk the Path of the Gods?",
      "acceptedAnswer": { "@type": "Answer", "text": "Agerola to Nocelle, downhill. Walking the other way means climbing roughly 500 metres in full sun, and you finish with the 1,500 steps down into Positano behind you rather than ahead. Take the SITA bus from Amalfi up to Agerola in the morning and walk back toward the sea." }
    },
    {
      "@type": "Question",
      "name": "Do I need a guide to hike on the Amalfi Coast?",
      "acceptedAnswer": { "@type": "Answer", "text": "No. The Path of the Gods and the other main trails are waymarked with the red and white CAI signs and busy enough that you are rarely alone. A guide is worth it if you want the history and botany, if you are walking in shoulder season when trails empty out, or for less obvious routes such as Crapolla Fjord." }
    },
    {
      "@type": "Question",
      "name": "What shoes do I need for hiking the Amalfi Coast?",
      "acceptedAnswer": { "@type": "Answer", "text": "Trail shoes or boots with a grippy rubber sole. The limestone here polishes smooth over centuries of use and becomes treacherous with the slightest dust or damp. Sandals and flat-soled sneakers cause most of the ankle injuries on the Path of the Gods every summer." }
    },
    {
      "@type": "Question",
      "name": "How do I get to the start of the Path of the Gods?",
      "acceptedAnswer": { "@type": "Answer", "text": "From Amalfi take the SITA bus to Agerola, about 45 minutes, and get off at Bomerano (San Lazzaro). Services are limited, so leave Amalfi around 8:30 for the 9:15 departure. From Positano you first travel to Amalfi, which makes for a long morning: staying in Agerola the night before is a trick regular hikers use." }
    },
    {
      "@type": "Question",
      "name": "Can you hike between Amalfi Coast towns?",
      "acceptedAnswer": { "@type": "Answer", "text": "Yes, the coast is laced with an old network of mule tracks and stepped paths that linked the villages before the SS163 road existed. The Lemon Path between Maiori and Minori is the easiest example, about 2 km. Nocelle to Positano and Ravello to Atrani are two more that turn a transfer into a walk." }
    },
  ]
};

const trails = [
  { name: 'Path of the Gods', difficulty: 'EE', km: '8 km', time: '3–4h', start: 'Agerola (S. Lazzaro)', end: 'Nocelle (Positano)', highlights: 'Breathtaking coastal views, Mediterranean flora, no asphalt', cta: { href: '/en-us/itineraries/1-day/path-of-the-gods-trek/' } },
  { name: 'Valle delle Ferriere', difficulty: 'E', km: '7 km RT', time: '2.5–3h', start: 'Amalfi centre', end: 'Amalfi (return)', highlights: 'Waterfalls, tropical ferns, wild papyrus, natural shade', cta: { href: '/en-us/blog/ferriere-valley/' } },
  { name: "Via dell'Infinito (Ravello)", difficulty: 'E', km: '5 km RT', time: '2h', start: 'Ravello', end: 'Ravello', highlights: 'Panoramic views of the coast, olive groves, total silence' },
  { name: 'Punta Campanella', difficulty: 'E', km: '6 km RT', time: '2.5h', start: 'Termini (Massa Lubrense)', end: 'Termini', highlights: 'Southernmost tip, Roman ruins, Capri views, marine reserve', cta: { href: '/en-us/blog/punta-campanella/' } },
  { name: 'Fiordo di Furore', difficulty: 'E', km: '3 km RT', time: '1.5–2h', start: 'Furore', end: 'Furore', highlights: 'Hidden fjord, waterfall, natural pool, freshwater spring', cta: { href: '/en-us/beaches/amalfi-coast/fiordo-di-furore/' } },
  { name: 'Ieranto Bay', difficulty: 'E', km: '4 km RT', time: '1.5–2h', start: 'Termini (Massa Lubrense)', end: 'Termini', highlights: 'Isolated wild beach, crystalline cove, protected area, sea views', cta: { href: '/en-us/beaches/sorrentine-peninsula/spiaggia-di-ieranto/' } },
  { name: 'Monte Solaro (Capri)', difficulty: 'E', km: '4 km', time: '2h (ascent)', start: 'Anacapri', end: 'Anacapri (chairlift return)', highlights: '589 m, 360° panorama, sanctuary, silence' },
  { name: 'Crapolla Fjord', difficulty: 'E', km: '6 km RT', time: '2.5h', start: 'Via Casal di Torca (Massa Lubrense)', end: 'Via Casal di Torca', highlights: '700 steps, ancient stone staircase, medieval chapel, Roman ruins, marine reserve', cta: { href: '/en-us/blog/fiordo-di-crapolla/' } },
  { name: 'Reccumone', difficulty: 'E', km: '0.5 km RT', time: '15–20 min', start: 'Marina del Cantone (Nerano)', end: 'Marina del Cantone', highlights: 'Wild and equipped beach, crystalline waters, land or sea access, beachfront restaurant', cta: { href: '/en-us/blog/baia-recommone/' } },
];
---

<BaseLayout
  title="Hiking the Amalfi Coast 2026 | Path of the Gods & 9 Best Trails"
  description="Hiking the Amalfi Coast: 9 trails compared on difficulty, distance and time, from the Path of the Gods (Agerola to Nocelle) to Valle delle Ferriere. When to walk, what to wear, how to reach each trailhead."
  lang={lang}
  breadcrumbs={breadcrumbs}
  pageKey="trekking"
  schema={[faqSchema]}

  heroImage="/images/trekking-hero.jpg"
>

  <section class="relative min-h-[75vh] flex items-end bg-charcoal overflow-hidden">
    <img src="/images/trekking-hero.jpg" alt="Path of the Gods, Amalfi Coast" class="absolute inset-0 w-full h-full object-cover" loading="eager" fetchpriority="high" decoding="sync" referrerpolicy="no-referrer"/>

    <div class="absolute inset-0 bg-gradient-to-b from-black/75 via-black/40 to-black/70"></div>
    <div class="relative z-10 max-w-7xl mx-auto px-6 pb-16 pt-32">
      <div class="max-w-3xl">
        <p class="text-med-gold text-xs sm:text-sm font-medium uppercase tracking-[0.3em] mb-3">Experiences</p>
        <h1 class="font-serif text-display text-white mb-4">Hiking the Amalfi Coast</h1>
        <p class="text-xl text-white/80 leading-relaxed max-w-2xl">
          Before the coast road existed, these villages were joined by stone steps and mule tracks. Most of them are still there, and walking them is the one way to see this landscape without traffic. From the Path of the Gods to the waterfalls of Valle delle Ferriere.
        </p>
      </div>
    </div>
    <Breadcrumbs breadcrumbs={breadcrumbs} />
  </section>

  <div class="max-w-editorial mx-auto px-4 sm:px-6 lg:px-8 py-16 space-y-12">

    <section>
      <p class="text-slate-600 text-xl leading-relaxed mb-6 font-light">
        The Amalfi Coast reads as a driving destination, and that is the misunderstanding. The SS163 was only cut into the cliffs in the 1850s. For the thousand years before that, everything moved on foot, along staircases and mule tracks that climbed from the harbours to the terraces and over the ridge to the next valley. That network survives, and it is the reason walking here feels less like a nature trail and more like using an old road.
      </p>
      <p class="text-slate-600 text-lg leading-relaxed mb-10">
        Nine routes are worth your time, listed below with the numbers that actually matter. Most are half-day walks that fit around a beach afternoon. Two things surprise first-timers: the trails are rockier and more exposed than the photographs suggest, and almost every one of them begins or ends with several hundred steps.
      </p>

      <h2 class="font-serif text-3xl font-bold text-slate-900 mb-3 text-center">Essential trails</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {trails.map((t, i) => {
          const isGold = i % 2 === 0;
          return (
          <div class={`border rounded-[2rem] p-7 hover:shadow-lg transition-all w-full sm:w-auto ${isGold ? 'bg-med-gold border-med-gold' : 'bg-med-blue border-med-blue'}`}>
            <div class="mb-5">
              <h3 class={`font-bold text-lg mb-3 ${isGold ? 'text-charcoal' : 'text-white'}`}>{t.name}</h3>
              <span class={`text-[10px] uppercase tracking-wide px-3 py-1.5 rounded-full font-medium flex-shrink-0 w-fit ${t.difficulty === 'EE' ? 'bg-red-50 text-red-600' : isGold ? 'bg-white/40 text-charcoal' : 'bg-white/20 text-white'}`}>
                {t.difficulty === 'EE' ? 'EE - Challenging' : 'E - Moderate'}
              </span>
            </div>
            <div class="space-y-3 mb-5">
              <div><span class={`text-xs font-semibold ${isGold ? 'text-charcoal/70' : 'text-white/70'}`}>DISTANCE</span><br /><span class={`font-semibold ${isGold ? 'text-charcoal' : 'text-white'}`}>{t.km}</span></div>
              <div><span class={`text-xs font-semibold ${isGold ? 'text-charcoal/70' : 'text-white/70'}`}>TIME</span><br /><span class={`font-semibold ${isGold ? 'text-charcoal' : 'text-white'}`}>{t.time}</span></div>
              <div><span class={`text-xs font-semibold ${isGold ? 'text-charcoal/70' : 'text-white/70'}`}>START</span><br /><span class={`font-semibold text-sm ${isGold ? 'text-charcoal' : 'text-white'}`}>{t.start}</span></div>
              <div><span class={`text-xs font-semibold ${isGold ? 'text-charcoal/70' : 'text-white/70'}`}>END</span><br /><span class={`font-semibold text-sm ${isGold ? 'text-charcoal' : 'text-white'}`}>{t.end}</span></div>
            </div>
            <p class={`text-xs sm:text-sm leading-relaxed font-medium mb-4 ${isGold ? 'text-charcoal' : 'text-white'}`}>{t.highlights}</p>
            {t.cta && (
              <a href={t.cta.href} class={`inline-flex items-center gap-2 font-semibold text-xs px-4 py-2 rounded-lg transition-all ${isGold ? 'bg-med-blue text-white hover:bg-med-blue/90' : 'bg-med-gold text-white hover:bg-med-gold/90'}`}>
                Learn more →
              </a>
            )}
          </div>
        );
        })}
      </div>
    </section>

    <section class="bg-charcoal text-white rounded-[2rem] p-8">
      <h2 class="font-serif text-2xl font-bold text-med-gold mb-8">Quick guide to Coast trails</h2>
      <div class="grid sm:grid-cols-2 gap-6">
        <div>
          <p class="text-white/60 text-xs sm:text-sm mb-1">Getting to the start</p>
          <p class="text-xs sm:text-sm leading-relaxed">From Amalfi: SITA bus to Agerola (limited services, ~45 min). Recommended: leave Amalfi at 8:30 to catch the 9:15 bus to Agerola.</p>
        </div>
        <div>
          <p class="text-white/60 text-xs sm:text-sm mb-1">Getting back from the end</p>
          <p class="text-xs sm:text-sm leading-relaxed">From Nocelle: local bus to Positano centre (~15 min) or walk down (~1,000 steps, 45 min). From Positano: SITA bus or ferry to Amalfi/Sorrento/Naples.</p>
        </div>
        <div>
          <p class="text-white/60 text-xs sm:text-sm mb-1">What to bring</p>
          <p class="text-xs sm:text-sm leading-relaxed">Hiking boots (not sandals), 1.5L water, hat, sunscreen, snacks, light jacket. The trail has no water points or shops.</p>
        </div>
        <div>
          <p class="text-white/60 text-xs sm:text-sm mb-1">Best season</p>
          <p class="text-xs sm:text-sm leading-relaxed">April-June and September-October. In July and August the heat makes it exhausting and crowded. Winter is possible but muddy and slippery.</p>
        </div>
      </div>
    </section>

    <!-- Choosing a trail -->
    <section>
      <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">Which trail should you pick</h2>
      <p class="text-slate-600 text-lg leading-relaxed mb-8">
        Nine options is too many for one trip. In practice the choice comes down to how much time you have and what you want at the end of it.
      </p>
      <ul class="space-y-4 text-slate-600">
        <li class="flex items-start gap-3">
          <span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span>
          <span class="text-slate-700"><strong>One walk, and it has to be the famous one.</strong> The <a href="/en-us/itineraries/1-day/path-of-the-gods-trek/" class="text-med-blue hover:underline">Path of the Gods</a>. Nothing else on the coast delivers that ratio of effort to view, and you finish in <a href="/en-us/amalfi-coast/positano/" class="text-med-blue hover:underline">Positano</a> with a swim waiting.</span>
        </li>
        <li class="flex items-start gap-3">
          <span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span>
          <span class="text-slate-700"><strong>You are here in July or August.</strong> <a href="/en-us/blog/ferriere-valley/" class="text-med-blue hover:underline">Valle delle Ferriere</a>, the only major route with real shade and running water. A humid gorge above <a href="/en-us/amalfi-coast/amalfi/" class="text-med-blue hover:underline">Amalfi</a> full of ferns that have grown there since the last ice age.</span>
        </li>
        <li class="flex items-start gap-3">
          <span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span>
          <span class="text-slate-700"><strong>Walking with children or after a big lunch.</strong> The <a href="/en-us/blog/lemon-path/" class="text-med-blue hover:underline">Lemon Path</a> between Maiori and Minori, about 2 km under lemon pergolas, or the Via dell'Infinito loop at <a href="/en-us/amalfi-coast/ravello/" class="text-med-blue hover:underline">Ravello</a>.</span>
        </li>
        <li class="flex items-start gap-3">
          <span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span>
          <span class="text-slate-700"><strong>You want the walk to end at a beach.</strong> <a href="/en-us/beaches/sorrentine-peninsula/spiaggia-di-ieranto/" class="text-med-blue hover:underline">Ieranto Bay</a> or <a href="/en-us/blog/fiordo-di-crapolla/" class="text-med-blue hover:underline">Crapolla Fjord</a>, both on the Sorrentine peninsula and both reachable only on foot or by sea, which is precisely why they stay quiet.</span>
        </li>
        <li class="flex items-start gap-3">
          <span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span>
          <span class="text-slate-700"><strong>You have half a day on the islands.</strong> Monte Solaro on <a href="/en-us/islands/capri/" class="text-med-blue hover:underline">Capri</a>: walk up from Anacapri in two hours and take the chairlift back down, or the reverse if your knees prefer it.</span>
        </li>
      </ul>
    </section>

    <!-- Difficulty -->
    <section>
      <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">What the difficulty grades mean</h2>
      <p class="text-slate-600 text-lg leading-relaxed mb-8">
        The cards above use the Italian Alpine Club scale, which you will also see on the red and white waymarks along the paths. Two grades cover everything on this coast.
      </p>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div class="bg-white p-6 rounded-[2rem] border border-slate-100 shadow-sm">
          <p class="text-med-gold text-xs font-medium uppercase tracking-[0.2em] mb-2">Grade E</p>
          <h3 class="font-bold text-slate-900 mb-2 text-lg">Moderate, no experience needed</h3>
          <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">A marked path with a clear surface. You need reasonable fitness and decent shoes, nothing more. Eight of the nine routes here sit at this grade, including Valle delle Ferriere and everything on the Sorrentine peninsula.</p>
        </div>
        <div class="bg-white p-6 rounded-[2rem] border border-slate-100 shadow-sm">
          <p class="text-med-gold text-xs font-medium uppercase tracking-[0.2em] mb-2">Grade EE</p>
          <h3 class="font-bold text-slate-900 mb-2 text-lg">Challenging, sure footing required</h3>
          <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Only the Path of the Gods. The grade comes from short exposed sections where the path narrows above a long drop with no railing. There is no climbing and no equipment involved, but it is not the place to discover you dislike heights.</p>
        </div>
      </div>
      <p class="text-slate-600 text-lg leading-relaxed mt-8">
        Neither grade prepares you for the coast's actual signature, which is stairs. The descent from Nocelle into Positano is roughly 1,500 steps, Crapolla is about 700, and the way down to most beaches is measured in flights rather than metres. Going down is what leaves you sore the next morning, so walking poles earn their place in the bag here more than the gradient suggests.
      </p>
    </section>

    <!-- Season -->
    <section>
      <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">When to walk, and when not to</h2>
      <p class="text-slate-600 text-lg leading-relaxed mb-8">
        Season matters more here than on most walking destinations, because the trails are south-facing limestone with almost no tree cover and no water along the way.
      </p>
      <div class="overflow-hidden rounded-[2rem] border border-slate-100 shadow-sm">
        <table class="w-full text-xs sm:text-sm">
          <thead class="bg-slate-900 text-white">
            <tr>
              <th class="text-left p-5 font-serif font-bold text-med-gold">Period</th>
              <th class="text-left p-5 font-serif font-bold text-med-gold">Conditions</th>
              <th class="text-left p-5 font-serif font-bold text-med-gold">Verdict</th>
            </tr>
          </thead>
          <tbody class="bg-white">
            <tr class="border-b border-slate-100">
              <td class="p-5 font-bold">April to early June</td>
              <td class="p-5 text-slate-600">13-24°C, hillsides in flower, dry paths</td>
              <td class="p-5 text-slate-600">The best window of the year</td>
            </tr>
            <tr class="border-b border-slate-100">
              <td class="p-5 font-bold">Late June</td>
              <td class="p-5 text-slate-600">Warming fast, longer light</td>
              <td class="p-5 text-slate-600">Fine if you start at dawn</td>
            </tr>
            <tr class="border-b border-slate-100">
              <td class="p-5 font-bold">July and August</td>
              <td class="p-5 text-slate-600">Up to 32°C, no shade, UV index 9-10</td>
              <td class="p-5 text-slate-600">Before 8:00 or not at all</td>
            </tr>
            <tr class="border-b border-slate-100">
              <td class="p-5 font-bold">September and October</td>
              <td class="p-5 text-slate-600">16-27°C, clear air, thinning crowds</td>
              <td class="p-5 text-slate-600">Equal to spring, warmer sea</td>
            </tr>
            <tr>
              <td class="p-5 font-bold">November to March</td>
              <td class="p-5 text-slate-600">Rain, mud, polished stone underfoot</td>
              <td class="p-5 text-slate-600">Possible, and often empty</td>
            </tr>
          </tbody>
        </table>
      </div>
      <p class="text-slate-600 text-lg leading-relaxed mt-8">
        If your dates are fixed in high summer, the fix is the clock rather than the calendar. Start at first light, be off the ridge by eleven, and spend the afternoon at sea level. For a fuller picture of temperatures and sea conditions across the year, see the guide on <a href="/en-us/guide/when-to-visit/" class="text-med-blue hover:underline">when to visit</a>.
      </p>
    </section>

    <!-- FAQ -->
    <section>
      <h2 class="font-serif text-3xl font-bold text-slate-900 mb-8">Common questions</h2>
      <div class="space-y-4">
        {faqSchema.mainEntity.map((item) => (
          <details class="bg-white rounded-[2rem] border border-slate-100 shadow-sm p-6 group">
            <summary class="font-bold text-slate-900 cursor-pointer list-none flex items-start justify-between gap-4">
              <span>{item.name}</span>
              <span class="text-med-gold flex-shrink-0 transition-transform group-open:rotate-45">+</span>
            </summary>
            <p class="text-slate-600 text-xs sm:text-sm leading-relaxed mt-4">{item.acceptedAnswer.text}</p>
          </details>
        ))}
      </div>
    </section>

  </div>

  <CorrelationSlider
    heading="Explore trekking destinations"
    items={[
      { name: 'Positano',       href: '/en-us/amalfi-coast/positano/',             tag: 'Trail end',      desc: 'The colourful village where the Path of the Gods ends.' },
      { name: 'Amalfi',         href: '/en-us/amalfi-coast/amalfi/',               tag: 'Valle start',    desc: 'Starting point for the Valle delle Ferriere.' },
      { name: 'Massa Lubrense', href: '/en-us/sorrento-peninsula/massa-lubrense/', tag: 'Punta Campanella', desc: 'Marine reserve with the trail to Punta Campanella.' },
      { name: 'Capri',          href: '/en-us/islands/capri/',                        tag: 'Monte Solaro',   desc: 'Chairlift or trek to the 589 m summit of Monte Solaro.' },
    ]}
  />

</BaseLayout>
