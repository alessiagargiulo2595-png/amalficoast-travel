---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../../components/Breadcrumbs.astro';
import CorrelationSlider from '../../../../components/CorrelationSlider.astro';

const lang = 'en-us';

const breadcrumbs = [
  { name: 'Home', url: '/en-us/' },
  { name: 'Experiences', url: '/en-us/experiences/' },
  { name: 'Trekking & Path of the Gods', url: '/en-us/experiences/trekking/' },
];

const trails = [
  { name: 'Path of the Gods', difficulty: 'EE', km: '8 km', time: '3–4h', start: 'Agerola (S. Lazzaro)', end: 'Nocelle (Positano)', highlights: 'Breathtaking coastal views, Mediterranean flora, no asphalt', cta: { href: '/en-us/itineraries/1-day/path-of-the-gods-trek/' } },
  { name: 'Valle delle Ferriere', difficulty: 'E', km: '7 km RT', time: '2.5–3h', start: 'Amalfi centre', end: 'Amalfi (return)', highlights: 'Waterfalls, tropical ferns, wild papyrus, natural shade', cta: { href: '/en-us/blog/ferriere-valley/' } },
  { name: "Via dell'Infinito (Ravello)", difficulty: 'E', km: '5 km RT', time: '2h', start: 'Ravello', end: 'Ravello', highlights: 'Panoramic views of the coast, olive groves, total silence' },
  { name: 'Punta Campanella', difficulty: 'E', km: '6 km RT', time: '2.5h', start: 'Termini (Massa Lubrense)', end: 'Termini', highlights: 'Southernmost tip, Roman ruins, Capri views, marine reserve', cta: { href: '/en-us/blog/punta-campanella/' } },
  { name: 'Fiordo di Furore', difficulty: 'E', km: '3 km RT', time: '1.5–2h', start: 'Furore', end: 'Furore', highlights: 'Hidden fjord, waterfall, natural pool, freshwater spring', cta: { href: '/en-us/beaches/amalfi-coast/fiordo-di-furore/' } },
  { name: 'Ieranto Bay', difficulty: 'E', km: '4 km RT', time: '1.5–2h', start: 'Termini (Massa Lubrense)', end: 'Termini', highlights: 'Isolated wild beach, crystalline cove, protected area, sea views', cta: { href: '/en-us/beaches/sorrentine-peninsula/spiaggia-di-ieranto/' } },
  { name: 'Monte Solaro (Capri)', difficulty: 'E', km: '4 km', time: '2h (ascent)', start: 'Anacapri', end: 'Anacapri (chairlift return)', highlights: '589 m, 360° panorama, sanctuary, silence' },
  { name: 'Crapolla Fjord', difficulty: 'E', km: '6 km RT', time: '2.5h', start: 'Via Casal di Torca (Massa Lubrense)', end: 'Via Casal di Torca', highlights: '700 steps, ancient stone staircase, medieval chapel, Roman ruins, marine reserve', cta: { href: '/en-us/blog/fiordo-di-crapolla/' } },
  { name: 'Reccumone', difficulty: 'E', km: '0.5 km RT', time: '15–20 min', start: 'Marina del Cantone (Nerano)', end: 'Marina del Cantone', highlights: 'Wild and equipped beach, crystalline waters, land or sea access, beachfront restaurant', cta: { href: '/en-us/blog/baia-recommone/' } },
];
---

<BaseLayout
  title="Trekking Amalfi Coast 2026 | Path of the Gods and Best Hikes"
  description="Best hiking trails on the Amalfi Coast: Path of the Gods (Agerola-Nocelle), Valle delle Ferriere, Punta Campanella. Difficulty, times and how to get there."
  lang={lang}
  breadcrumbs={breadcrumbs}
  pageKey="trekking"

  heroImage="/images/trekking-hero.jpg"
>

  <section class="relative min-h-[75vh] flex items-end bg-charcoal overflow-hidden">
    <img src="/images/trekking-hero.jpg" alt="Path of the Gods, Amalfi Coast" class="absolute inset-0 w-full h-full object-cover" loading="eager" fetchpriority="high" decoding="sync" referrerpolicy="no-referrer"/>

    <div class="absolute inset-0 bg-gradient-to-b from-black/75 via-black/40 to-black/70"></div>
    <div class="relative z-10 max-w-7xl mx-auto px-6 pb-16 pt-32">
      <div class="max-w-3xl">
        <p class="text-med-gold text-xs sm:text-sm font-medium uppercase tracking-[0.3em] mb-3">Experiences</p>
        <h1 class="font-serif text-display text-white mb-4">Trekking & Path of the Gods</h1>
        <p class="text-xl text-white/80 leading-relaxed max-w-2xl">
          The Amalfi Coast isn't just beaches and ferries: it's also one of Europe's most spectacular landscapes to explore on foot. From the legendary Path of the Gods to the waterfalls of Valle delle Ferriere.
        </p>
      </div>
    </div>
    <Breadcrumbs breadcrumbs={breadcrumbs} />
  </section>

  <div class="max-w-editorial mx-auto px-4 sm:px-6 lg:px-8 py-16 space-y-12">

    <section>
      <h2 class="font-serif text-3xl font-bold text-slate-900 mb-3 text-center">Essential trails</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {trails.map((t, i) => {
          const isGold = i % 2 === 0;
          return (
          <div class={`border rounded-[2rem] p-7 hover:shadow-lg transition-all w-full sm:w-auto ${isGold ? 'bg-med-gold border-med-gold' : 'bg-med-blue border-med-blue'}`}>
            <div class="mb-5">
              <h3 class={`font-bold text-lg mb-3 ${isGold ? 'text-charcoal' : 'text-white'}`}>{t.name}</h3>
              <span class={`text-[10px] uppercase tracking-wide px-3 py-1.5 rounded-full font-medium flex-shrink-0 w-fit ${t.difficulty === 'EE' ? 'bg-red-50 text-red-600' : isGold ? 'bg-white/40 text-charcoal' : 'bg-white/20 text-white'}`}>
                {t.difficulty === 'EE' ? 'EE - Challenging' : 'E - Moderate'}
              </span>
            </div>
            <div class="space-y-3 mb-5">
              <div><span class={`text-xs font-semibold ${isGold ? 'text-charcoal/70' : 'text-white/70'}`}>DISTANCE</span><br /><span class={`font-semibold ${isGold ? 'text-charcoal' : 'text-white'}`}>{t.km}</span></div>
              <div><span class={`text-xs font-semibold ${isGold ? 'text-charcoal/70' : 'text-white/70'}`}>TIME</span><br /><span class={`font-semibold ${isGold ? 'text-charcoal' : 'text-white'}`}>{t.time}</span></div>
              <div><span class={`text-xs font-semibold ${isGold ? 'text-charcoal/70' : 'text-white/70'}`}>START</span><br /><span class={`font-semibold text-sm ${isGold ? 'text-charcoal' : 'text-white'}`}>{t.start}</span></div>
              <div><span class={`text-xs font-semibold ${isGold ? 'text-charcoal/70' : 'text-white/70'}`}>END</span><br /><span class={`font-semibold text-sm ${isGold ? 'text-charcoal' : 'text-white'}`}>{t.end}</span></div>
            </div>
            <p class={`text-xs sm:text-sm leading-relaxed font-medium mb-4 ${isGold ? 'text-charcoal' : 'text-white'}`}>{t.highlights}</p>
            {t.cta && (
              <a href={t.cta.href} class={`inline-flex items-center gap-2 font-semibold text-xs px-4 py-2 rounded-lg transition-all ${isGold ? 'bg-med-blue text-white hover:bg-med-blue/90' : 'bg-med-gold text-white hover:bg-med-gold/90'}`}>
                Learn more →
              </a>
            )}
          </div>
        );
        })}
      </div>
    </section>

    <section class="bg-charcoal text-white rounded-[2rem] p-8">
      <h2 class="font-serif text-2xl font-bold text-med-gold mb-8">Quick guide to Coast trails</h2>
      <div class="grid sm:grid-cols-2 gap-6">
        <div>
          <p class="text-white/60 text-xs sm:text-sm mb-1">Getting to the start</p>
          <p class="text-xs sm:text-sm leading-relaxed">From Amalfi: SITA bus to Agerola (limited services, ~45 min). Recommended: leave Amalfi at 8:30 to catch the 9:15 bus to Agerola.</p>
        </div>
        <div>
          <p class="text-white/60 text-xs sm:text-sm mb-1">Getting back from the end</p>
          <p class="text-xs sm:text-sm leading-relaxed">From Nocelle: local bus to Positano centre (~15 min) or walk down (~1,000 steps, 45 min). From Positano: SITA bus or ferry to Amalfi/Sorrento/Naples.</p>
        </div>
        <div>
          <p class="text-white/60 text-xs sm:text-sm mb-1">What to bring</p>
          <p class="text-xs sm:text-sm leading-relaxed">Hiking boots (not sandals), 1.5L water, hat, sunscreen, snacks, light jacket. The trail has no water points or shops.</p>
        </div>
        <div>
          <p class="text-white/60 text-xs sm:text-sm mb-1">Best season</p>
          <p class="text-xs sm:text-sm leading-relaxed">April-June and September-October. In July and August the heat makes it exhausting and crowded. Winter is possible but muddy and slippery.</p>
        </div>
      </div>
    </section>

  </div>

  <CorrelationSlider
    heading="Explore trekking destinations"
    items={[
      { name: 'Positano',       href: '/en-us/amalfi-coast/positano/',             tag: 'Trail end',      desc: 'The colourful village where the Path of the Gods ends.' },
      { name: 'Amalfi',         href: '/en-us/amalfi-coast/amalfi/',               tag: 'Valle start',    desc: 'Starting point for the Valle delle Ferriere.' },
      { name: 'Massa Lubrense', href: '/en-us/sorrento-peninsula/massa-lubrense/', tag: 'Punta Campanella', desc: 'Marine reserve with the trail to Punta Campanella.' },
      { name: 'Capri',          href: '/en-us/islands/capri/',                        tag: 'Monte Solaro',   desc: 'Chairlift or trek to the 589 m summit of Monte Solaro.' },
    ]}
  />

</BaseLayout>
