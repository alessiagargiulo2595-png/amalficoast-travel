---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import CorrelationSlider from '../../../../components/CorrelationSlider.astro';
import Breadcrumbs from '../../../../components/Breadcrumbs.astro';

const lang = 'en-us';

const breadcrumbs = [
  { name: 'Home', url: '/en-us/' },
  { name: 'Amalfi Coast', url: '/en-us/amalfi-coast/' },
  { name: 'Salerno', url: '/en-us/amalfi-coast/salerno/' },
];

const touristAttractionSchema = {
  "@context": "https://schema.org",
  "@type": "TouristAttraction",
  "name": "Salerno",
  "description": "Salerno is the gateway to the Amalfi Coast, a vibrant university city with a Norman cathedral, the Minerva Garden, the Lungomare Trieste promenade, and the celebrated Luci d'Artista winter light festival.",
  "url": "https://amalficoast-travel.com/en-us/amalfi-coast/salerno/",
  "touristType": ["Culture", "History", "Gastronomy", "Travel Base"],
  "address": { "@type": "PostalAddress", "addressLocality": "Salerno", "addressRegion": "Salerno", "addressCountry": "IT", "postalCode": "84121" },
  "geo": { "@type": "GeoCoordinates", "latitude": 40.6824, "longitude": 14.7681 }
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "How do you get from Naples to Salerno?",
      "acceptedAnswer": { "@type": "Answer", "text": "Trenitalia Regional train from Naples Centrale to Salerno takes about 35-40 minutes (approx. €4-7). High-speed Frecce and Italo trains take about 25 minutes. By car, it is roughly 60 km via the A3 Naples-Salerno motorway (toll approx. €3)." }
    },
    {
      "@type": "Question",
      "name": "What to see in Salerno in one day?",
      "acceptedAnswer": { "@type": "Answer", "text": "The Cathedral and Crypt of San Matteo, the medieval old town with Via dei Mercanti, the Minerva Garden, the Lungomare Trieste promenade, and Castello Arechi for the panoramic view. In winter (November–January), the Luci d'Artista light festival is unmissable." }
    },
    {
      "@type": "Question",
      "name": "Is Salerno a good base for the Amalfi Coast?",
      "acceptedAnswer": { "@type": "Answer", "text": "Yes, it is the most practical and affordable base. Travelmar ferries depart from Salerno to Amalfi, Positano, Minori, and Maiori (April–October). SITA buses connect the entire coast. Hotels cost 40–50% less than in Amalfi or Positano." }
    },
    {
      "@type": "Question",
      "name": "When is the best time to visit Salerno?",
      "acceptedAnswer": { "@type": "Answer", "text": "April–June and September–October for good weather and proximity to the coast. November–January for the Luci d'Artista light installation, which attracts over 2 million visitors. July and August are hot but the city is far less crowded than the Amalfi Coast itself." }
    },
    {
      "@type": "Question",
      "name": "What should I eat in Salerno?",
      "acceptedAnswer": { "@type": "Answer", "text": "The milza imbottita (stuffed spleen sandwich), scazzetta del cardinale (a sponge cake with cream and strawberries), Salernitan pizza, and fresh fish from the Via Roma market. Via dei Mercanti is lined with authentic trattorias." }
    }
  ]
};

const schemas = [touristAttractionSchema, faqSchema];

const fastFacts = [
  { dt: 'Location', dd: 'Gulf of Salerno, SA' },
  { dt: 'Altitude', dd: '0–300 m' },
  { dt: 'Population', dd: '~130,000' },
  { dt: 'From Naples', dd: '35 min (regional train)' },
  { dt: 'Ferry port', dd: 'Piazza della Concordia' },
  { dt: 'To Amalfi', dd: '75 min (ferry)' },
  { dt: 'Best period', dd: 'Apr–Jun / Nov–Jan' },
  { dt: 'Specialties', dd: 'Milza, scazzetta, fish' },
  { dt: 'Top event', dd: 'Luci d\'Artista (Nov–Jan)' },
];

const tips = [
  'The Minerva Garden is Europe\'s first botanical garden (XIII century) and is rarely visited — a hidden gem in the heart of the old town.',
  'Via dei Mercanti is the true soul of Salerno: shops, trattorias and pastry bars at local, non-tourist prices.',
  'Take the early morning ferry to Amalfi: the panoramic view of the coast seen from the sea is unbeatable.',
  'Castello Arechi (reachable by bus or a 30-minute walk from the centre) offers the finest view over the Gulf and the city.',
];
---

<BaseLayout
  title="Salerno 2026: Complete Guide | Gateway to the Amalfi Coast"
  description="Complete guide to Salerno: Cathedral, Minerva Garden, Luci d'Artista, Lungomare Trieste. The gateway to the Amalfi Coast with ferries to Amalfi and Positano."
  lang={lang}
  breadcrumbs={breadcrumbs}
  schema={schemas}
  pageKey="salerno"
>

  <!-- Hero -->
  <section class="relative h-[75vh] sm:h-[90vh] flex items-center bg-charcoal overflow-hidden">
    <img src="/images/salerno-hero.webp" alt="Salerno, gateway to the Amalfi Coast" class="absolute inset-0 w-full h-full object-cover" loading="eager" referrerpolicy="no-referrer"/>
    <div class="absolute inset-0 bg-gradient-to-b from-black/10 via-black/40 to-black/80 z-10"></div>
    <div class="relative z-20 max-w-editorial mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <p class="text-med-gold text-xs sm:text-sm font-medium uppercase tracking-[0.3em] mb-3">Gateway to the Amalfi Coast</p>
        <h1 class="font-serif text-display text-white mb-4">Salerno</h1>
        <p class="text-xl text-white/80 leading-relaxed max-w-2xl">
          A millennial university city and the ideal base for the Amalfi Coast. Norman cathedral, Luci d'Artista, and the most beautiful promenade in Campania.
        </p>
        <div class="flex flex-wrap gap-3 mt-8">
          <a href="#fast-facts" class="px-5 py-2.5 bg-med-gold text-white text-xs sm:text-sm font-semibold rounded-full hover:scale-105 hover:shadow-[0_8px_25px_rgba(212,175,55,0.4)] transition-all duration-300">Fast Facts</a>
          <a href="#how-to-get-there" class="px-5 py-2.5 bg-white/10 backdrop-blur text-white text-xs sm:text-sm font-medium rounded-full border border-white/20 hover:bg-white/20 transition-colors">Getting There</a>
          <a href="#faq" class="px-5 py-2.5 bg-white/10 backdrop-blur text-white text-xs sm:text-sm font-medium rounded-full border border-white/20 hover:bg-white/20 transition-colors">FAQ</a>
        </div>
      </div>
    </div>
    <Breadcrumbs breadcrumbs={breadcrumbs} />
  </section>

  <section class="max-w-editorial mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="grid lg:grid-cols-[1fr_320px] gap-12">

      <div class="space-y-16">

        <div class="prose-editorial">
          <p class="text-xl leading-relaxed text-charcoal">
            Salerno is the city that everyone passes through but few take the time to explore. Yet with its medieval old town, the Norman cathedral housing the relics of St. Matthew, and one of the finest seafront promenades in Italy, it deserves at least a full day.
          </p>
          <p class="mt-4 text-slate-600 leading-relaxed">
            Founded as a Roman colony in 197 BC, Salerno reached its zenith with the <strong>Scuola Medica Salernitana</strong>, the first and most important medical institution in medieval Europe. Today it is a lively, human-scale city with a port connecting directly to <a href="/en-us/amalfi-coast/amalfi/" class="text-med-blue hover:underline">Amalfi</a>, <a href="/en-us/amalfi-coast/positano/" class="text-med-blue hover:underline">Positano</a>, and <a href="/en-us/amalfi-coast/minori/" class="text-med-blue hover:underline">Minori</a> by ferry.
          </p>
        </div>

        <!-- Did You Know -->
        <div class="bg-slate-900 border border-white/10 rounded-[3rem] p-8">
          <p class="text-[10px] uppercase tracking-[0.3em] text-med-gold font-medium mb-4">Did you know?</p>
          <div class="grid sm:grid-cols-3 gap-6">
            <div class="text-center">
              <p class="font-serif text-5xl font-bold text-med-gold">XI cent.</p>
              <p class="text-white/60 text-xs italic mt-1">Scuola Medica Salernitana, Europe's first medical school</p>
            </div>
            <div class="text-center">
              <p class="font-serif text-5xl font-bold text-med-gold">2M+</p>
              <p class="text-white/60 text-xs italic mt-1">visitors to Luci d'Artista every year</p>
            </div>
            <div class="text-center">
              <p class="font-serif text-5xl font-bold text-med-gold">1.5 km</p>
              <p class="text-white/60 text-xs italic mt-1">the pedestrian Lungomare Trieste promenade</p>
            </div>
          </div>
          <p class="text-white/40 text-xs mt-6 italic">
            Robert Guiscard, the Norman warlord, made Salerno the capital of his Duchy in 1077. The cathedral he commissioned still stands at the heart of the city today.
          </p>
        </div>

        <!-- What to See -->
        <div>
          <h2 class="font-serif text-3xl font-semibold text-slate-900 mb-8">What to See in Salerno</h2>
          <div class="space-y-8">
            {[
              { n: 1, title: 'Cathedral of San Matteo', text: 'The symbol of Salerno, founded in 1080 by Robert Guiscard. The Romanesque facade with its 11th-century bronze portal leads to a baroque interior housing the Crypt with the relics of the Apostle Matthew. The four-sided portico with its spoliated Roman columns is among the finest in southern Italy. Free entry.' },
              { n: 2, title: 'Minerva Garden', text: 'Europe\'s first botanical garden, founded in the 13th century by physician Matteo Silvatico of the Scuola Medica Salernitana. Terraced on the hillside above the old town, it features medicinal plants, fountains, and a spectacular view over the Gulf. Entry approx. €3. Not to be missed.' },
              { n: 3, title: 'Lungomare Trieste', text: '1.5 km of pedestrian promenade overlooking the Gulf of Salerno, regarded as one of the most beautiful seafront walks in Italy. Palm trees, benches, bars, and a view of Capri on clear days. Perfect for an aperitivo at sunset.' },
              { n: 4, title: 'Castello Arechi', text: 'The Lombard fortress at 300 m altitude dominates the city and the gulf. Reachable by bus (line 19) or on foot in 30 minutes from the centre. It houses a museum with medieval ceramics and offers the widest panoramic view in the area. Entry approx. €5.' },
              { n: 5, title: 'Via dei Mercanti & Old Town', text: 'The medieval commercial artery of Salerno, a continuous run of shops, trattorias, and churches. Walk it from Piazza Sedile del Campo to the Arch of Arechi. The side streets hide historic pastry shops and secret courtyards.' },
            ].map(({ n, title, text }) => (
              <div class="grid sm:grid-cols-[auto_1fr] gap-4">
                <div class="w-14 h-14 rounded-[1rem] bg-med-gold/10 flex items-center justify-center flex-shrink-0 text-med-gold font-serif font-bold text-xl">{n}</div>
                <div>
                  <h3 class="font-semibold text-charcoal text-lg mb-1">{title}</h3>
                  <p class="text-slate-600 leading-relaxed">{text}</p>
                </div>
              </div>
            ))}
          </div>
        </div>

        <!-- How to Get There -->
        <div id="how-to-get-there">
          <h2 class="font-serif text-3xl font-semibold text-slate-900 mb-6">How to Get to Salerno</h2>
          <div class="space-y-6">
            <div class="bg-white rounded-[3rem] p-8 border border-slate-100 hover:shadow-xl transition-all duration-300">
              <h3 class="font-semibold text-charcoal mb-3">Train (from Naples)</h3>
              <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">Trenitalia Regional from Naples Centrale: approx. 35–40 min, €4–7. Frecce and Italo high-speed trains: approx. 25 min. Salerno station is a 10-minute walk from the old town and the ferry port.</p>
            </div>
            <div class="bg-white rounded-[3rem] p-8 border border-slate-100 hover:shadow-xl transition-all duration-300">
              <h3 class="font-semibold text-charcoal mb-3">Ferries to the Amalfi Coast</h3>
              <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">From the port at Piazza della Concordia (5 min from the station), Travelmar connects Salerno to <a href="/en-us/amalfi-coast/cetara/" class="text-med-blue hover:underline">Cetara</a>, <a href="/en-us/amalfi-coast/maiori/" class="text-med-blue hover:underline">Maiori</a>, <a href="/en-us/amalfi-coast/minori/" class="text-med-blue hover:underline">Minori</a>, <a href="/en-us/amalfi-coast/amalfi/" class="text-med-blue hover:underline">Amalfi</a>, and <a href="/en-us/amalfi-coast/positano/" class="text-med-blue hover:underline">Positano</a> (April–October). Tickets approx. €8–10.</p>
            </div>
            <div class="bg-white rounded-[3rem] p-8 border border-slate-100 hover:shadow-xl transition-all duration-300">
              <h3 class="font-semibold text-charcoal mb-3">SITA Bus</h3>
              <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">SITA buses depart from the station and run the entire SS163 road to <a href="/en-us/amalfi-coast/amalfi/" class="text-med-blue hover:underline">Amalfi</a> (approx. 75 min, €2.50). Year-round service, frequency every 60–90 min.</p>
            </div>
          </div>
        </div>

        <!-- Hidden Gems -->
        <div>
          <h2 class="font-serif text-3xl font-semibold text-slate-900 mb-6">Salerno Off the Tourist Trail</h2>
          <div class="grid sm:grid-cols-2 gap-6">
            {[
              { title: 'San Pietro a Corte Complex', text: 'A unique archaeological site with overlapping Roman, early Christian, and Lombard remains. The 8th-century Palatine Chapel is a hidden jewel beneath street level. Free or nearly free entry.' },
              { title: 'Fornelle Quarter', text: 'The oldest neighbourhood in Salerno, clinging to the hillside below Castello Arechi. Narrow alleys, endless staircases, and contemporary street art. Almost unknown to tourists and full of local life.' },
              { title: 'Via Roma Market', text: 'Salerno\'s covered market, where locals shop for fresh fish, fruit, and vegetables every morning. Colours, smells, and local prices. Open mornings, closed Sundays.' },
              { title: 'Medieval Aqueduct', text: 'The remains of the aqueduct that supplied the Benedictine monasteries, visible along Via Arce in the old town. An impressive arched structure that is almost completely unknown.' },
            ].map(({ title, text }) => (
              <div class="bg-white rounded-[3rem] p-8 border border-slate-100 hover:shadow-xl transition-all duration-300">
                <h3 class="font-semibold text-charcoal mb-2">{title}</h3>
                <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">{text}</p>
              </div>
            ))}
          </div>
        </div>

        <!-- Local Tip -->
        <div class="relative overflow-hidden rounded-[3rem] bg-med-blue p-10 md:p-14 text-white shadow-2xl">
          <div class="relative z-10 flex flex-col md:flex-row items-start md:items-center gap-8">
            <div class="w-20 h-20 rounded-2xl bg-white/10 flex items-center justify-center flex-shrink-0 border border-white/20"><svg class="w-10 h-10 text-med-gold" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 3v2.25m6.364.386-1.591 1.591M21 12h-2.25m-.386 6.364-1.591-1.591M12 18.75V21m-4.773-4.227-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0Z"/></svg></div>
            <div>
              <p class="text-med-gold text-xs font-bold uppercase tracking-[0.3em] mb-2">Local Tip</p>
              <h3 class="font-serif text-2xl font-bold text-white mb-3 tracking-tight">The perfect base for the coast</h3>
              <p class="text-white/70 leading-relaxed">Stay in Salerno and take the morning ferry to Amalfi: you save 40–50% on hotel costs and enjoy the coastal scenery from the sea. In the evening, Salerno's old town offers authentic restaurants at local prices.</p>
            </div>
          </div>
          <div class="absolute bottom-0 left-0 translate-y-1/2 -translate-x-1/2 w-80 h-80 bg-med-gold/10 rounded-full blur-3xl pointer-events-none"></div>
        </div>

        <!-- FAQ -->
        <div id="faq">
          <h2 class="font-serif text-3xl font-semibold text-slate-900 mb-8">Frequently Asked Questions about Salerno</h2>
          <div class="space-y-4">
            {faqSchema.mainEntity.map((q) => (
              <details class="group border border-slate-200 rounded-2xl overflow-hidden">
                <summary class="flex items-center justify-between px-6 py-4 cursor-pointer select-none text-charcoal font-medium hover:bg-slate-50 transition-colors">
                  {q.name}
                  <svg class="w-4 h-4 text-slate-400 group-open:rotate-180 transition-transform flex-shrink-0 ml-3" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
                </summary>
                <div class="px-6 pb-5 text-slate-600 leading-relaxed text-xs sm:text-sm border-t border-slate-100 pt-4">
                  {q.acceptedAnswer.text}
                </div>
              </details>
            ))}
          </div>
        </div>

      </div>

      <aside class="space-y-6 lg:sticky lg:top-24 self-start">
        <div id="fast-facts" class="bg-slate-900 text-white rounded-[3rem] p-6">
          <p class="text-[10px] uppercase tracking-[0.3em] text-med-gold font-medium mb-4">Fast Facts - Salerno</p>
          <dl class="space-y-3">
            {fastFacts.map(({ dt, dd }, i) => (
              <>
                <div class="flex justify-between items-start gap-3">
                  <dt class="text-white/40 text-xs sm:text-sm font-light flex-shrink-0">{dt}</dt>
                  <dd class="text-white font-medium text-xs sm:text-sm text-right">{dd}</dd>
                </div>
                {i < fastFacts.length - 1 && <div class="border-t border-white/5"></div>}
              </>
            ))}
          </dl>
        </div>

        <div class="bg-med-cream border border-med-gold/30 rounded-[2rem] p-6">
          <p class="text-[10px] uppercase tracking-[0.3em] text-med-gold font-medium mb-3">Insider Tips</p>
          <ul class="space-y-3">
            {tips.map(tip => (
              <li class="flex items-start gap-2 text-xs sm:text-sm text-charcoal">
                <span class="w-1.5 h-1.5 rounded-full bg-med-gold mt-1.5 flex-shrink-0"></span>
                <span>{tip}</span>
              </li>
            ))}
          </ul>
        </div>

        <div class="bg-white border border-slate-100 rounded-[2rem] p-6 shadow-sm">
          <p class="text-[10px] uppercase tracking-[0.3em] text-slate-400 font-medium mb-3">Explore the Coast</p>
          <nav class="space-y-1">
            {[
              { href: '/en-us/amalfi-coast/amalfi/', label: 'Amalfi' },
              { href: '/en-us/amalfi-coast/positano/', label: 'Positano' },
              { href: '/en-us/amalfi-coast/ravello/', label: 'Ravello' },
              { href: '/en-us/amalfi-coast/cetara/', label: 'Cetara' },
              { href: '/en-us/amalfi-coast/vietri-sul-mare/', label: 'Vietri sul Mare' },
            ].map(({ href, label }) => (
              <a href={href} class="flex items-center gap-2 px-3 py-2 rounded-xl text-xs sm:text-sm text-charcoal hover:bg-med-blue/5 hover:text-med-blue transition-colors">
                <span class="w-1.5 h-1.5 rounded-full bg-med-blue/30"></span> {label}
              </a>
            ))}
          </nav>
        </div>
      </aside>

    </div>
  </section>

  <CorrelationSlider
    heading="Explore More on the Amalfi Coast"
    items={[
      { name: 'Amalfi',   href: '/en-us/amalfi-coast/amalfi/',   tag: 'Maritime Republic', desc: 'The historic capital with the Cathedral of Sant\'Andrea and the Paper Museum.' },
      { name: 'Cetara',   href: '/en-us/amalfi-coast/cetara/',   tag: 'Fishing Village',   desc: 'The fishermen\'s village and birthplace of colatura di alici DOP.' },
      { name: 'Vietri',   href: '/en-us/amalfi-coast/vietri-sul-mare/', tag: 'Ceramics', desc: 'The gateway to the coast, famous for its artistic ceramics.' },
      { name: 'Ravello',  href: '/en-us/amalfi-coast/ravello/',  tag: 'Music & Gardens',   desc: 'Villa Rufolo, Villa Cimbrone and the Music Festival at 350 m.' },
      { name: 'Positano', href: '/en-us/amalfi-coast/positano/', tag: 'Fashion & Views',   desc: 'Colourful houses perched on the sea and Fornillo beach.' },
    ]}
    lang="en-us"
  />

</BaseLayout>
