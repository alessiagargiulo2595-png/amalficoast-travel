---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import CorrelationSlider from '../../../../components/CorrelationSlider.astro';
import Breadcrumbs from '../../../../components/Breadcrumbs.astro';

const lang = 'en-us';

const breadcrumbs = [
  { name: 'Home', url: '/en-us/' },
  { name: 'Amalfi Coast', url: '/en-us/amalfi-coast/' },
  { name: 'Agerola', url: '/en-us/amalfi-coast/agerola/' },
];

const touristAttractionSchema = {
  "@context": "https://schema.org",
  "@type": "TouristAttraction",
  "name": "Agerola",
  "description": "Agerola is the green balcony of the Amalfi Coast, the starting point of the Path of the Gods and home of the famous Fior di Latte cheese. At 600 m altitude, it offers hiking, fresh air, and breathtaking panoramas.",
  "url": "https://amalficoast-travel.com/en-us/amalfi-coast/agerola/",
  "touristType": ["Hiking", "Nature", "Gastronomy", "Panoramas"],
  "address": { "@type": "PostalAddress", "addressLocality": "Agerola", "addressRegion": "Napoli", "addressCountry": "IT", "postalCode": "80051" },
  "geo": { "@type": "GeoCoordinates", "latitude": 40.6383, "longitude": 14.5417 }
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "How do you get to Agerola?",
      "acceptedAnswer": { "@type": "Answer", "text": "By SITA bus from Amalfi (about 40 min) or from Castellammare di Stabia/Gragnano (about 30 min). By car from Naples: A3 motorway, exit Castellammare di Stabia, then the SS366 towards Agerola. Parking is available in Bomerano and San Lazzaro." }
    },
    {
      "@type": "Question",
      "name": "Does the Path of the Gods start from Agerola?",
      "acceptedAnswer": { "@type": "Answer", "text": "Yes, the classic route starts from Bomerano (a hamlet of Agerola) and ends at Nocelle above Positano — about 7.8 km, 3–4 hours of walking. The trail is classified as medium difficulty. Avoid it in rainy or heavily foggy conditions." }
    },
    {
      "@type": "Question",
      "name": "What is Agerola's Fior di Latte?",
      "acceptedAnswer": { "@type": "Answer", "text": "It is a fresh pulled-curd mozzarella made from the milk of Agerolese cows raised at altitude. It has a delicate flavour and a uniquely soft texture. Each dairy farm in Agerola has its own version — the best way to taste it is to buy it directly from the producer." }
    },
    {
      "@type": "Question",
      "name": "Is Agerola suitable for families?",
      "acceptedAnswer": { "@type": "Answer", "text": "Yes, the altitude (600 m) keeps the climate cool even in summer. There are easy trails, playgrounds, farm stays with animals, and dairy farms open to visitors. It is a perfect alternative to the heat of the coast for a different day out." }
    },
    {
      "@type": "Question",
      "name": "What to eat in Agerola?",
      "acceptedAnswer": { "@type": "Answer", "text": "Fior di Latte and other dairy products are the highlight. Also worth trying: fusilli with rabbit ragu, pizza with local Fior di Latte, ricotta-based desserts, and aged cheeses. Farm-stay restaurants offer full menus at reasonable prices." }
    }
  ]
};

const schemas = [touristAttractionSchema, faqSchema];

const fastFacts = [
  { dt: 'Location', dd: 'Lattari Mountains, NA' },
  { dt: 'Altitude', dd: '~600 m' },
  { dt: 'Population', dd: '~7,500' },
  { dt: 'Hamlets', dd: 'Bomerano, San Lazzaro, Pianillo' },
  { dt: 'From Amalfi', dd: '40 min (SITA bus)' },
  { dt: 'Path of the Gods', dd: 'Starts from Bomerano' },
  { dt: 'Specialties', dd: 'Fior di Latte, cheeses' },
  { dt: 'Best period', dd: 'Apr–Oct (hiking)' },
  { dt: 'Ideal for', dd: 'Hiking, families, foodies' },
];

const tips = [
  'Start the Path of the Gods early (before 8:00 am): you\'ll have the trail almost to yourself and the best light for photos.',
  'Buy Fior di Latte directly from the dairies in San Lazzaro — it costs less and you eat it freshly made, still warm.',
  'If the Path of the Gods feels too busy, try the Sentiero dei Tre Calli or the trail to the Grotta di Santa Barbara.',
  'In summer, Agerola is 8–10°C cooler than the coast: bring a light layer even in August.',
];
---

<BaseLayout
  title="Agerola 2026: Path of the Gods, Fior di Latte & Hiking"
  description="Complete guide to Agerola: starting point of the Path of the Gods, home of Fior di Latte cheese, hiking in the Lattari Mountains and panoramas over the Amalfi Coast at 600 m altitude."
  lang={lang}
  breadcrumbs={breadcrumbs}
  schema={schemas}
  pageKey="agerola"
>

  <!-- Hero -->
  <section class="relative h-[75vh] sm:h-[90vh] flex items-center bg-charcoal overflow-hidden">
    <img src="/images/agerola-hero.webp" alt="Agerola, the green balcony of the Amalfi Coast" class="absolute inset-0 w-full h-full object-cover" loading="eager" fetchpriority="high" decoding="sync" referrerpolicy="no-referrer"/>
    <div class="absolute inset-0 bg-gradient-to-b from-black/10 via-black/40 to-black/80 z-10"></div>
    <div class="relative z-20 max-w-editorial mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <p class="text-med-gold text-xs sm:text-sm font-medium uppercase tracking-[0.3em] mb-3">Lattari Mountains - 600 m altitude</p>
        <h1 class="font-serif text-display text-white mb-4">Agerola</h1>
        <p class="text-xl text-white/80 leading-relaxed max-w-2xl">
          The green balcony of the Coast. Starting point of the Path of the Gods, home of Fior di Latte, and the most vertiginous panoramas in the region.
        </p>
        <div class="flex flex-wrap gap-3 mt-8">
          <a href="#fast-facts" class="px-5 py-2.5 bg-med-gold text-white text-xs sm:text-sm font-semibold rounded-full hover:scale-105 hover:shadow-[0_8px_25px_rgba(212,175,55,0.4)] transition-all duration-300">Fast Facts</a>
          <a href="#path-of-the-gods" class="px-5 py-2.5 bg-white/10 backdrop-blur text-white text-xs sm:text-sm font-medium rounded-full border border-white/20 hover:bg-white/20 transition-colors">Path of the Gods</a>
          <a href="#faq" class="px-5 py-2.5 bg-white/10 backdrop-blur text-white text-xs sm:text-sm font-medium rounded-full border border-white/20 hover:bg-white/20 transition-colors">FAQ</a>
        </div>
      </div>
    </div>
    <Breadcrumbs breadcrumbs={breadcrumbs} />
  </section>

  <section class="max-w-editorial mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="grid lg:grid-cols-[1fr_320px] gap-12">

      <div class="space-y-16">

        <div class="prose-editorial">
          <p class="text-xl leading-relaxed text-charcoal">
            Agerola is the Amalfi Coast's best-kept secret. At 600 metres altitude, tucked among the Lattari Mountains, this community of shepherds and farmers offers what the coast cannot: fresh air, silence, spectacular trails, and a dairy tradition stretching back to the Middle Ages.
          </p>
          <p class="mt-4 text-slate-600 leading-relaxed">
            This is where the celebrated <strong>Path of the Gods</strong> begins, one of the most beautiful trekking routes in Europe. But Agerola is more than just a trailhead: it is a world apart, made up of scattered hamlets (Bomerano, San Lazzaro, Pianillo), artisan dairies, and trattorias serving produce straight from the kitchen garden.
          </p>
        </div>

        <!-- Did You Know -->
        <div class="bg-slate-900 border border-white/10 rounded-[3rem] p-8">
          <p class="text-[10px] uppercase tracking-[0.3em] text-med-gold font-medium mb-4">Did you know?</p>
          <div class="grid sm:grid-cols-3 gap-6">
            <div class="text-center">
              <p class="font-serif text-5xl font-bold text-med-gold">7.8 km</p>
              <p class="text-white/60 text-xs italic mt-1">the Path of the Gods, from Bomerano to Nocelle</p>
            </div>
            <div class="text-center">
              <p class="font-serif text-5xl font-bold text-med-gold">600 m</p>
              <p class="text-white/60 text-xs italic mt-1">average altitude — 8–10°C cooler than the coast</p>
            </div>
            <div class="text-center">
              <p class="font-serif text-5xl font-bold text-med-gold">XII cent.</p>
              <p class="text-white/60 text-xs italic mt-1">documented dairy tradition</p>
            </div>
          </div>
        </div>

        <!-- Path of the Gods -->
        <div id="path-of-the-gods">
          <h2 class="font-serif text-3xl font-semibold text-slate-900 mb-6">The Path of the Gods</h2>
          <p class="text-slate-600 text-lg leading-relaxed mb-6">
            The most famous trek on the Amalfi Coast — a panoramic path carved into the rock of the Lattari Mountains, high above the sea.
          </p>
          <div class="bg-white p-6 rounded-2xl border border-slate-100 space-y-4">
            <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
              <div>
                <p class="text-xs text-slate-400 uppercase tracking-wider">Start</p>
                <p class="font-medium text-charcoal">Bomerano (Agerola)</p>
              </div>
              <div>
                <p class="text-xs text-slate-400 uppercase tracking-wider">Finish</p>
                <p class="font-medium text-charcoal">Nocelle (Positano)</p>
              </div>
              <div>
                <p class="text-xs text-slate-400 uppercase tracking-wider">Distance</p>
                <p class="font-medium text-charcoal">~7.8 km</p>
              </div>
              <div>
                <p class="text-xs text-slate-400 uppercase tracking-wider">Duration</p>
                <p class="font-medium text-charcoal">3–4 hours</p>
              </div>
            </div>
            <p class="text-slate-600 text-sm leading-relaxed">
              <strong>Difficulty:</strong> Medium. Around 600 m of descent. Hiking boots required, trekking poles recommended. Carry at least 1.5 litres of water. <strong>Do not attempt in rain or thick fog.</strong> From Nocelle you descend to Positano via 1,500 steps or the local bus.
            </p>
          </div>
        </div>

        <!-- What to See -->
        <div>
          <h2 class="font-serif text-3xl font-semibold text-slate-900 mb-8">What to See in Agerola</h2>
          <div class="space-y-8">
            {[
              { n: 1, title: 'Bomerano and the Trailhead', text: 'The best-known hamlet, with the small square from which the Path of the Gods departs. Bars, grocery shops, and the Lattari Mountains Park information point. The panorama over Capri and the coast is already spectacular from here.' },
              { n: 2, title: 'Dairies & Fior di Latte', text: 'Agerola\'s Fior di Latte is a fresh mozzarella made from the milk of Agerolese cows raised at altitude. Several dairies welcome visitors for tastings. Also worth trying: smoked provola and fresh ricotta.' },
              { n: 3, title: 'Sentiero dei Tre Calli', text: 'A less-crowded alternative to the Path of the Gods. It connects Agerola to Positano through chestnut woods and lemon terraces. Longer (5–6 hours) but equally spectacular.' },
              { n: 4, title: 'Lattari Mountains Regional Park', text: 'Agerola sits at the heart of the park: marked trails, holm oak and chestnut forests, karst caves, and unique biodiversity. The Visitor Centre in San Lazzaro provides maps and information.' },
              { n: 5, title: 'Grotta di Santa Barbara', text: 'A karst cave reachable on a roughly 2-hour excursion from San Lazzaro. Inside: stalactites and a striking atmosphere. Free entry, but a local guide is recommended.' },
            ].map(({ n, title, text }) => (
              <div class="grid sm:grid-cols-[auto_1fr] gap-4">
                <div class="w-14 h-14 rounded-[1rem] bg-med-gold/10 flex items-center justify-center flex-shrink-0 text-med-gold font-serif font-bold text-xl">{n}</div>
                <div>
                  <h3 class="font-semibold text-charcoal text-lg mb-1">{title}</h3>
                  <p class="text-slate-600 leading-relaxed">{text}</p>
                </div>
              </div>
            ))}
          </div>
        </div>

        <!-- Local Tip -->
        <div class="relative overflow-hidden rounded-[3rem] bg-med-blue p-10 md:p-14 text-white shadow-2xl">
          <div class="relative z-10 flex flex-col md:flex-row items-start md:items-center gap-8">
            <div class="w-20 h-20 rounded-2xl bg-white/10 flex items-center justify-center flex-shrink-0 border border-white/20"><svg class="w-10 h-10 text-med-gold" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 3v2.25m6.364.386-1.591 1.591M21 12h-2.25m-.386 6.364-1.591-1.591M12 18.75V21m-4.773-4.227-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0Z"/></svg></div>
            <div>
              <p class="text-med-gold text-xs font-bold uppercase tracking-[0.3em] mb-2">Local Tip</p>
              <h3 class="font-serif text-2xl font-bold text-white mb-3 tracking-tight">Fior di Latte from the dairy</h3>
              <p class="text-white/70 leading-relaxed">Stop at a dairy in San Lazzaro around 10:00 am, when the Fior di Latte comes out still warm. Buy some, add a slice of local bread and a tomato — the perfect lunch before the trail.</p>
            </div>
          </div>
          <div class="absolute bottom-0 left-0 translate-y-1/2 -translate-x-1/2 w-80 h-80 bg-med-gold/10 rounded-full blur-3xl pointer-events-none"></div>
        </div>

        <!-- FAQ -->
        <div id="faq">
          <h2 class="font-serif text-3xl font-semibold text-slate-900 mb-8">Frequently Asked Questions about Agerola</h2>
          <div class="space-y-4">
            {faqSchema.mainEntity.map((q) => (
              <details class="group border border-slate-200 rounded-2xl overflow-hidden">
                <summary class="flex items-center justify-between px-6 py-4 cursor-pointer select-none text-charcoal font-medium hover:bg-slate-50 transition-colors">
                  {q.name}
                  <svg class="w-4 h-4 text-slate-400 group-open:rotate-180 transition-transform flex-shrink-0 ml-3" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
                </summary>
                <div class="px-6 pb-5 text-slate-600 leading-relaxed text-xs sm:text-sm border-t border-slate-100 pt-4">
                  {q.acceptedAnswer.text}
                </div>
              </details>
            ))}
          </div>
        </div>

      </div>

      <aside class="space-y-6 lg:sticky lg:top-24 self-start">
        <div id="fast-facts" class="bg-slate-900 text-white rounded-[3rem] p-6">
          <p class="text-[10px] uppercase tracking-[0.3em] text-med-gold font-medium mb-4">Fast Facts - Agerola</p>
          <dl class="space-y-3">
            {fastFacts.map(({ dt, dd }, i) => (
              <>
                <div class="flex justify-between items-start gap-3">
                  <dt class="text-white/40 text-xs sm:text-sm font-light flex-shrink-0">{dt}</dt>
                  <dd class="text-white font-medium text-xs sm:text-sm text-right">{dd}</dd>
                </div>
                {i < fastFacts.length - 1 && <div class="border-t border-white/5"></div>}
              </>
            ))}
          </dl>
        </div>

        <div class="bg-med-cream border border-med-gold/30 rounded-[2rem] p-6">
          <p class="text-[10px] uppercase tracking-[0.3em] text-med-gold font-medium mb-3">Insider Tips</p>
          <ul class="space-y-3">
            {tips.map(tip => (
              <li class="flex items-start gap-2 text-xs sm:text-sm text-charcoal">
                <span class="w-1.5 h-1.5 rounded-full bg-med-gold mt-1.5 flex-shrink-0"></span>
                <span>{tip}</span>
              </li>
            ))}
          </ul>
        </div>

        <div class="bg-white border border-slate-100 rounded-[2rem] p-6 shadow-sm">
          <p class="text-[10px] uppercase tracking-[0.3em] text-slate-400 font-medium mb-3">Explore the Coast</p>
          <nav class="space-y-1">
            {[
              { href: '/en-us/amalfi-coast/furore/', label: 'Furore' },
              { href: '/en-us/amalfi-coast/praiano/', label: 'Praiano' },
              { href: '/en-us/amalfi-coast/positano/', label: 'Positano' },
              { href: '/en-us/amalfi-coast/amalfi/', label: 'Amalfi' },
              { href: '/en-us/amalfi-coast/tramonti/', label: 'Tramonti' },
            ].map(({ href, label }) => (
              <a href={href} class="flex items-center gap-2 px-3 py-2 rounded-xl text-xs sm:text-sm text-charcoal hover:bg-med-blue/5 hover:text-med-blue transition-colors">
                <span class="w-1.5 h-1.5 rounded-full bg-med-blue/30"></span> {label}
              </a>
            ))}
          </nav>
        </div>
      </aside>

    </div>
  </section>

  <CorrelationSlider
    heading="Explore More on the Amalfi Coast"
    items={[
      { name: 'Furore',   href: '/en-us/amalfi-coast/furore/',   tag: 'The Village That Doesn\'t Exist', desc: 'The spectacular Fjord and the mural-covered Painted Village.' },
      { name: 'Praiano',  href: '/en-us/amalfi-coast/praiano/',  tag: 'Sunset & Quiet',                  desc: 'The sunset from San Gennaro and the peaceful Marina di Praia.' },
      { name: 'Positano', href: '/en-us/amalfi-coast/positano/', tag: 'Fashion & Views',                  desc: 'Colourful houses perched on the sea and Fornillo beach.' },
      { name: 'Tramonti', href: '/en-us/amalfi-coast/tramonti/', tag: 'Hinterland & Wine',                desc: 'The green lung of the Coast — DOC wines and authentic traditions.' },
      { name: 'Amalfi',   href: '/en-us/amalfi-coast/amalfi/',   tag: 'Maritime Republic',                desc: 'The historic capital with the Cathedral and the Paper Museum.' },
    ]}
    lang="en-us"
  />

</BaseLayout>
