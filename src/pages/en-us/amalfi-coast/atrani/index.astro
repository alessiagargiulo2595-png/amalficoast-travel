---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../../components/Breadcrumbs.astro';
import CorrelationSlider from '../../../../components/CorrelationSlider.astro';

const lang = 'en-us';

const breadcrumbs = [
  { name: 'Home', url: '/en-us/' },
  { name: 'Amalfi Coast', url: '/en-us/amalfi-coast/' },
  { name: 'Atrani', url: '/en-us/amalfi-coast/atrani/' },
];

const touristAttractionSchema = {
  "@context": "https://schema.org",
  "@type": "TouristAttraction",
  "name": "Atrani",
  "description": "Atrani is the smallest municipality in Italy by area (0.12 km2), a medieval gem nestled between cliffs just 700 metres from Amalfi. A seaside piazzetta, staircases and authentic alleyways.",
  "url": "https://amalficoast-travel.com/en-us/amalfi-coast/atrani/",
  "image": "https://amalficoast-travel.com/images/atrani-hero.webp",
  "touristType": ["Authenticity", "History", "Sea", "Photography"],
  "address": {
    "@type": "PostalAddress",
    "addressLocality": "Atrani",
    "addressRegion": "Salerno",
    "addressCountry": "IT",
    "postalCode": "84010"
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": 40.6364,
    "longitude": 14.6083
  }
};

const placeSchema = {
  "@context": "https://schema.org",
  "@type": "Place",
  "name": "Atrani, Amalfi Coast",
  "description": "The smallest municipality in Italy, an authentic medieval village 700 m from Amalfi.",
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": 40.6364,
    "longitude": 14.6083
  }
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "How far is Atrani from Amalfi?",
      "acceptedAnswer": { "@type": "Answer", "text": "Atrani is just 700 metres from Amalfi. You can reach it on foot in 10-15 minutes through a pedestrian tunnel or along the coastal road. They are the two closest towns on the entire Amalfi Coast." }
    },
    {
      "@type": "Question",
      "name": "How do you get to Atrani?",
      "acceptedAnswer": { "@type": "Answer", "text": "The best way is on foot from Amalfi (10-15 min). By bus: SITA line Salerno-Amalfi, Atrani stop. By car: parking is extremely limited; it is best to park in Amalfi (Luna Rossa car park) and walk." }
    },
    {
      "@type": "Question",
      "name": "Why is Atrani famous?",
      "acceptedAnswer": { "@type": "Answer", "text": "Atrani is the smallest municipality in Italy by area (0.12 km2). It was the place where the Doges of the Maritime Republic of Amalfi were crowned and buried. More recently it became famous as the main filming location for the Netflix series Ripley (2024)." }
    },
    {
      "@type": "Question",
      "name": "What should you eat in Atrani?",
      "acceptedAnswer": { "@type": "Answer", "text": "The signature dish is sarchiapone: long courgettes stuffed with meat, provola cheese and eggs. Also try the fresh fish at the piazzetta restaurants and the traditional Amalfi-style pastries." }
    },
    {
      "@type": "Question",
      "name": "Can you swim in Atrani?",
      "acceptedAnswer": { "@type": "Answer", "text": "Yes, Atrani has a small sand-and-pebble beach right on the village piazzetta. It is one of the few free beaches on the coast. Crystal-clear water and an authentic atmosphere, far less crowded than Amalfi." }
    }
  ]
};
---

<BaseLayout
  title="Atrani: Italy's Smallest Town on the Amalfi Coast"
  description="Guide to Atrani, the smallest municipality in Italy, just 700 m from Amalfi. Seaside piazzetta, Doge history, Ripley Netflix set, beach and sarchiapone."
  lang={lang}
  breadcrumbs={breadcrumbs}
  schema={[touristAttractionSchema, placeSchema, faqSchema]}
  pageKey="atrani"

  heroImage="/images/atrani-hero.webp"
>

  <!-- Hero -->
  <section class="relative h-[52.5vh] sm:h-[70vh] flex items-end bg-charcoal overflow-hidden">
    <img
      src="/images/atrani-hero.webp"
      alt="Atrani, Italy's smallest town on the Amalfi Coast"
      class="absolute inset-0 w-full h-full object-cover"
      loading="eager" fetchpriority="high" decoding="sync" referrerpolicy="no-referrer"
    />
    <div class="absolute inset-0 bg-gradient-to-b from-black/75 via-black/40 to-black/70"></div>
    <div class="relative z-10 max-w-7xl mx-auto px-6 pb-16 pt-32 w-full">
      <div class="max-w-3xl">
        <p class="text-med-gold text-xs sm:text-sm font-medium uppercase tracking-[0.3em] mb-3">Amalfi Coast</p>
        <h1 class="font-serif text-display text-white mb-4">Atrani</h1>
        <p class="text-xl text-white/80 leading-relaxed">
          Italy's smallest town. Just 700 metres from Amalfi, a completely different world.
        </p>
        <div class="flex flex-wrap gap-3 mt-8">
          <a href="#fast-facts" class="px-5 py-2.5 bg-med-gold text-white text-xs sm:text-sm font-semibold rounded-full hover:scale-105 hover:shadow-[0_8px_25px_rgba(212,175,55,0.4)] transition-all duration-300">
            Fast Facts
          </a>
          <a href="#what-to-see" class="px-5 py-2.5 bg-white/10 backdrop-blur text-white text-xs sm:text-sm font-medium rounded-full border border-white/20 hover:bg-white/20 transition-colors">
            What to See
          </a>
          <a href="#faq" class="px-5 py-2.5 bg-white/10 backdrop-blur text-white text-xs sm:text-sm font-medium rounded-full border border-white/20 hover:bg-white/20 transition-colors">
            FAQ
          </a>
        </div>
      </div>
    </div>
    <Breadcrumbs breadcrumbs={breadcrumbs} />
  </section>

  <!-- Main Content + Sidebar -->
  <section class="bg-med-cream py-24 px-6">
    <div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-3 gap-16">

      <!-- Main Text -->
      <div class="lg:col-span-2 space-y-12">

        <!-- Intro -->
        <div>
          <h2 class="font-serif text-4xl font-bold text-slate-900 mb-6">The Best-Kept Secret of the Amalfi Coast</h2>
          <p class="text-slate-600 text-lg leading-relaxed mb-4">
            <strong>Atrani</strong> is the <strong>smallest municipality in Italy</strong> by area: just 0.12 km&sup2; of alleyways, staircases and medieval arches wedged between two cliffs plunging into the sea. Only 700 metres from Amalfi, yet a completely different world.
          </p>
          <p class="text-slate-600 text-lg leading-relaxed">
            There are no luxury boutiques or tourist restaurants here. There is a piazzetta where children play football, a small free beach, and the sound of water flowing between the houses. Those who arrive in Atrani discover the Amalfi Coast as it was before mass tourism.
          </p>
        </div>

        <!-- Did You Know -->
        <div class="bg-slate-900 border border-white/10 rounded-[3rem] p-8">
          <p class="text-[10px] uppercase tracking-[0.3em] text-med-gold font-medium mb-4">Did you know?</p>
          <div class="grid sm:grid-cols-3 gap-6">
            <div class="text-center">
              <p class="font-serif text-5xl font-bold text-med-gold">0.12</p>
              <p class="text-white/60 text-xs italic mt-1">km&sup2; total area</p>
            </div>
            <div class="text-center">
              <p class="font-serif text-5xl font-bold text-med-gold">839</p>
              <p class="text-white/60 text-xs italic mt-1">residents (a living village)</p>
            </div>
            <div class="text-center">
              <p class="font-serif text-5xl font-bold text-med-gold">700</p>
              <p class="text-white/60 text-xs italic mt-1">metres from Amalfi on foot</p>
            </div>
          </div>
          <p class="text-white/40 text-xs mt-6 italic">
            In the Middle Ages, Atrani was the place where the Doges of the Maritime Republic of Amalfi were crowned. The Collegiate Church of San Salvatore de' Birecto still preserves the porphyry slab on which the ceremony took place.
          </p>
        </div>

        <!-- What to See -->
        <div id="what-to-see">
          <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">What to See in Atrani</h2>

          <div class="space-y-8">
            <div>
              <h3 class="text-xl font-bold text-slate-900 mb-3">Piazza Umberto I</h3>
              <p class="text-slate-600 leading-relaxed">
                The beating heart of the village. One of the very few piazzas on the coast that opens directly onto the sea, with cafes, restaurants and the daily life of the locals. This is where the Feast of Santa Maria Maddalena takes place (22 July).
              </p>
            </div>

            <div>
              <h3 class="text-xl font-bold text-slate-900 mb-3">Collegiate Church of San Salvatore de' Birecto</h3>
              <p class="text-slate-600 leading-relaxed">
                Founded in the 10th century, it houses the <strong>porphyry slab</strong> on which the Doges of Amalfi were crowned. The bronze door is a copy of the one from Constantinople (the original is in the Diocesan Museum). A piece of Maritime Republic history.
              </p>
            </div>

            <div>
              <h3 class="text-xl font-bold text-slate-900 mb-3">Church of Santa Maria Maddalena</h3>
              <p class="text-slate-600 leading-relaxed">
                The majolica dome and bell tower dominate Atrani's profile from the coast. The Baroque interior houses a 13th-century wooden crucifix. The feast on 22 July is among the most heartfelt on the coast.
              </p>
            </div>

            <div>
              <h3 class="text-xl font-bold text-slate-900 mb-3">Masaniello's Cave</h3>
              <p class="text-slate-600 leading-relaxed">
                Legend has it that Masaniello, the famous Neapolitan revolutionary, hid in a cave above Atrani during the revolt of 1647. The path leading to the cave offers spectacular views of the coast.
              </p>
            </div>
          </div>
        </div>

        <!-- Beach -->
        <div>
          <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">Atrani Beach</h2>
          <p class="text-slate-600 text-lg leading-relaxed mb-6">
            Atrani's small beach is one of the best-kept secrets of the coast. Sand and pebbles, crystal-clear water, and an atmosphere that feels more like a fishing village than a tourist destination.
          </p>
          <div class="bg-white p-6 rounded-2xl border border-slate-100">
            <h3 class="font-bold text-slate-900 mb-2">Piazzetta Beach</h3>
            <p class="text-slate-600 text-sm">Directly below Piazza Umberto I. Free public beach, no beach clubs. Deep, clean water. Far less crowded than the Spiaggia Grande in Amalfi, which is only a 15-minute walk away.</p>
          </div>
        </div>

        <!-- Ripley -->
        <div>
          <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">Atrani and Ripley: The Netflix Set</h2>
          <p class="text-slate-600 text-lg leading-relaxed">
            In 2024, the Netflix series <strong>Ripley</strong>, starring Andrew Scott, used Atrani as the main filming location for scenes set in the fictional coastal town. The piazzetta, staircases and alleyways of the village were shot in black and white, capturing the suspended, mysterious atmosphere of Patricia Highsmith's novel.
          </p>
        </div>

        <!-- Food -->
        <div>
          <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">What to Eat in Atrani</h2>
          <div class="space-y-6">
            <div class="bg-med-gold/10 p-6 rounded-2xl border border-med-gold/20">
              <h3 class="font-bold text-slate-900 mb-2 text-lg">Sarchiapone</h3>
              <p class="text-slate-600 leading-relaxed">
                Atrani's signature dish: long courgettes stuffed with minced meat, smoked provola cheese, eggs and stale bread, cooked in tomato sauce. A comfort food from the Amalfi tradition.
              </p>
            </div>
            <div class="bg-med-gold/10 p-6 rounded-2xl border border-med-gold/20">
              <h3 class="font-bold text-slate-900 mb-2 text-lg">Fresh Fish on the Piazzetta</h3>
              <p class="text-slate-600 leading-relaxed">
                The restaurants overlooking the piazza serve the catch of the day at more honest prices than Amalfi. Mixed fried fish, spaghetti ai frutti di mare and marinated anchovies are the specialities.
              </p>
            </div>
          </div>
        </div>

        <!-- FAQ -->
        <div id="faq">
          <h2 class="font-serif text-3xl font-semibold text-slate-900 mb-8">Frequently Asked Questions about Atrani</h2>
          <div class="space-y-4">
            {faqSchema.mainEntity.map((q) => (
              <details class="group border border-slate-200 rounded-2xl overflow-hidden">
                <summary class="flex items-center justify-between px-6 py-4 cursor-pointer select-none text-charcoal font-medium hover:bg-slate-50 transition-colors">
                  {q.name}
                  <svg class="w-4 h-4 text-slate-400 group-open:rotate-180 transition-transform flex-shrink-0 ml-3" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
                </summary>
                <div class="px-6 pb-5 text-slate-600 leading-relaxed text-xs sm:text-sm border-t border-slate-100 pt-4">
                  {q.acceptedAnswer.text}
                </div>
              </details>
            ))}
          </div>
        </div>

        <!-- How to Get There -->
        <div>
          <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">How to Get There</h2>
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
            <div class="bg-white p-6 rounded-[2rem] border border-slate-100 shadow-sm">
              <p class="text-med-gold text-xs font-bold uppercase tracking-wider mb-2">On Foot from Amalfi</p>
              <p class="text-slate-700 font-medium mb-1">10-15 minutes</p>
              <p class="text-slate-500 text-xs sm:text-sm">Pedestrian tunnel or a walk along the coast. The most convenient and scenic way.</p>
            </div>
            <div class="bg-white p-6 rounded-[2rem] border border-slate-100 shadow-sm">
              <p class="text-med-gold text-xs font-bold uppercase tracking-wider mb-2">SITA Bus</p>
              <p class="text-slate-700 font-medium mb-1">Atrani Stop</p>
              <p class="text-slate-500 text-xs sm:text-sm">Salerno-Amalfi line. Dedicated stop on the SS163.</p>
            </div>
            <div class="bg-white p-6 rounded-[2rem] border border-slate-100 shadow-sm">
              <p class="text-med-gold text-xs font-bold uppercase tracking-wider mb-2">By Car</p>
              <p class="text-slate-700 font-medium mb-1">Limited Parking</p>
              <p class="text-slate-500 text-xs sm:text-sm">Very few spaces. Better to park in Amalfi (Luna Rossa) and walk.</p>
            </div>
          </div>
        </div>

      </div>

      <!-- Sidebar Fast-Facts -->
      <aside class="space-y-6 lg:sticky lg:top-24 self-start">
        <div id="fast-facts" class="bg-slate-900 text-white rounded-[3rem] p-6">
          <p class="text-[10px] uppercase tracking-[0.3em] text-med-gold font-medium mb-4">Fast Facts - Atrani</p>
          <dl class="space-y-3">
            <div class="flex justify-between items-start gap-3">
              <dt class="text-white/40 text-xs sm:text-sm font-light flex-shrink-0">Location</dt>
              <dd class="text-white font-medium text-xs sm:text-sm text-right">700 m from Amalfi<br/>25 km from Salerno</dd>
            </div>
            <div class="border-t border-white/5"></div>
            <div class="flex justify-between items-start gap-3">
              <dt class="text-white/40 text-xs sm:text-sm font-light flex-shrink-0">Area</dt>
              <dd class="text-white font-medium text-xs sm:text-sm text-right">0.12 km&sup2;<br/>Smallest in Italy</dd>
            </div>
            <div class="border-t border-white/5"></div>
            <div class="flex justify-between items-start gap-3">
              <dt class="text-white/40 text-xs sm:text-sm font-light flex-shrink-0">Population</dt>
              <dd class="text-white font-medium text-xs sm:text-sm text-right">Approx. 839</dd>
            </div>
            <div class="border-t border-white/5"></div>
            <div class="flex justify-between items-start gap-3">
              <dt class="text-white/40 text-xs sm:text-sm font-light flex-shrink-0">Signature Dish</dt>
              <dd class="text-white font-medium text-xs sm:text-sm text-right">Sarchiapone</dd>
            </div>
            <div class="border-t border-white/5"></div>
            <div class="flex justify-between items-start gap-3">
              <dt class="text-white/40 text-xs sm:text-sm font-light flex-shrink-0">Patron Feast</dt>
              <dd class="text-white font-medium text-xs sm:text-sm text-right">22 July<br/>S. Maria Maddalena</dd>
            </div>
            <div class="border-t border-white/5"></div>
            <div class="flex justify-between items-start gap-3">
              <dt class="text-white/40 text-xs sm:text-sm font-light flex-shrink-0">Fun Fact</dt>
              <dd class="text-white font-medium text-xs sm:text-sm text-right">Ripley filming set<br/>(Netflix, 2024)</dd>
            </div>
            <div class="border-t border-white/5"></div>
            <div class="flex justify-between items-start gap-3">
              <dt class="text-white/40 text-xs sm:text-sm font-light flex-shrink-0">Ideal For</dt>
              <dd class="text-white font-medium text-xs sm:text-sm text-right">Authenticity<br/>Photography<br/>Tranquillity</dd>
            </div>
          </dl>

          <div class="mt-10 pt-8 border-t border-white/10">
            <a
              href="/en-us/amalfi-coast/"
              class="inline-flex items-center gap-2 text-med-gold text-xs sm:text-sm font-medium hover:text-white transition-colors"
            >
              ← Back to Amalfi Coast
            </a>
          </div>
        </div>
      </aside>

    </div>
  </section>

  <CorrelationSlider
    heading="Explore more on the Coast"
    items={[
      { name: 'Amalfi', href: '/en-us/amalfi-coast/amalfi/', tag: 'Maritime Republic', desc: 'Just 700 m from Atrani: the Cathedral, the Paper Museum and the harbour.' },
      { name: 'Ravello', href: '/en-us/amalfi-coast/ravello/', tag: 'Music & Gardens', desc: 'Villa Rufolo, Villa Cimbrone and the Music Festival at 350 m altitude.' },
      { name: 'Positano', href: '/en-us/amalfi-coast/positano/', tag: 'Fashion & Views', desc: 'Colourful houses cascading to the sea and Fornillo beach.' },
      { name: 'Minori', href: '/en-us/amalfi-coast/minori/', tag: 'Flavours & Culture', desc: '1st-century Roman villa, fresh scialatielli pasta and pastry shops.' },
      { name: 'Cetara', href: '/en-us/amalfi-coast/cetara/', tag: 'Gastronomy', desc: 'The fishing village and home of colatura di alici DOP.' },
      { name: 'Praiano', href: '/en-us/amalfi-coast/praiano/', tag: 'Sunsets & Quiet', desc: 'The sunset from San Gennaro and the peaceful Marina di Praia.' },
    ]}
    lang="en-us"
  />

</BaseLayout>
