---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import CorrelationSlider from '../../../../components/CorrelationSlider.astro';
import Breadcrumbs from '../../../../components/Breadcrumbs.astro';

const lang = 'en-us';

const breadcrumbs = [
  { name: 'Home', url: '/en-us/' },
  { name: 'Amalfi Coast', url: '/en-us/amalfi-coast/' },
  { name: 'Tramonti', url: '/en-us/amalfi-coast/tramonti/' },
];

const touristAttractionSchema = {
  "@context": "https://schema.org",
  "@type": "TouristAttraction",
  "name": "Tramonti",
  "description": "Tramonti is the green lung of the Amalfi Coast, a scattered municipality of 13 hamlets among vineyards, lemon groves, and ancient churches. The heartland of Costa d'Amalfi DOC wines, authentic pizza, and rural traditions.",
  "url": "https://amalficoast-travel.com/en-us/amalfi-coast/tramonti/",
  "touristType": ["Food & Wine", "Nature", "Authenticity", "Traditions"],
  "address": { "@type": "PostalAddress", "addressLocality": "Tramonti", "addressRegion": "Salerno", "addressCountry": "IT", "postalCode": "84010" },
  "geo": { "@type": "GeoCoordinates", "latitude": 40.6933, "longitude": 14.6333 }
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "How do you get to Tramonti?",
      "acceptedAnswer": { "@type": "Answer", "text": "By car: via the Valico di Chiunzi mountain pass (SS373) from Angri/Nocera, about 20 minutes from the A3 motorway. By SITA bus: from Amalfi or Maiori (about 30 min). There is no railway station. A car is the most practical option since the 13 hamlets are spread out." }
    },
    {
      "@type": "Question",
      "name": "Why is Tramonti famous for pizza?",
      "acceptedAnswer": { "@type": "Answer", "text": "Tramonti is considered one of the cradles of Neapolitan pizza. Many pizzaioli who emigrated from Tramonti have opened pizzerias around the world. The local tradition calls for zero-kilometre ingredients: local tomatoes, Fior di Latte from the territory's dairies, and olive oil from the surrounding hills." }
    },
    {
      "@type": "Question",
      "name": "Which wines are produced in Tramonti?",
      "acceptedAnswer": { "@type": "Answer", "text": "Tramonti is the main production zone for the Costa d'Amalfi DOC sub-zone Tramonti. Whites are made from Falanghina, Biancolella, and Pepella grapes; reds from Tintore di Tramonti (a local Piedirosso clone). Wineries such as Apicella, Reale, and Monte di Grazia offer tastings by appointment." }
    },
    {
      "@type": "Question",
      "name": "Is Tramonti worth visiting?",
      "acceptedAnswer": { "@type": "Answer", "text": "Absolutely, especially for those seeking authenticity. No mass tourism, very low prices, unspoilt nature, and exceptional food and wine. It is the antithesis of the glitzy Amalfi Coast — life here feels like it did 50 years ago." }
    },
    {
      "@type": "Question",
      "name": "What is there to see in Tramonti?",
      "acceptedAnswer": { "@type": "Answer", "text": "The Conservatorio di San Giuseppe (17th-century frescoes), the 13 scattered hamlets with their churches, the terraced vineyards producing Costa d'Amalfi DOC wine, the Valico di Chiunzi with its panoramic view, and the nature trails into the Lattari Mountains." }
    }
  ]
};

const schemas = [touristAttractionSchema, faqSchema];

const fastFacts = [
  { dt: 'Location', dd: 'Amalfi Coast hinterland, SA' },
  { dt: 'Altitude', dd: '300–800 m' },
  { dt: 'Population', dd: '~4,000' },
  { dt: 'Hamlets', dd: '13 scattered villages' },
  { dt: 'From Amalfi', dd: '30 min (bus/car)' },
  { dt: 'Car access', dd: 'Valico di Chiunzi' },
  { dt: 'Specialties', dd: 'DOC wine, pizza, Fior di Latte' },
  { dt: 'Best period', dd: 'Apr–Oct' },
  { dt: 'Ideal for', dd: 'Food & wine, nature' },
];

const tips = [
  'Book a winery tasting: Apicella (the oldest on the coast, since 1870) or Monte di Grazia for the Tintore grape.',
  'The Valico di Chiunzi is the highest point reachable by car: the view over the Sarno Valley and Vesuvius is extraordinary.',
  'Tramonti\'s pizzerias are the locals\' favourite — not the tourists\' — with low prices and exceptional quality.',
  'In autumn (October) the Sagra della Castagna is held: local produce, wine, and an authentic atmosphere in the hamlets.',
];
---

<BaseLayout
  title="Tramonti 2026: The Green Lung of the Amalfi Coast"
  description="Guide to Tramonti: Costa d'Amalfi DOC wines, 13 authentic hamlets, traditional pizza, trails in the Lattari Mountains. The secret hinterland of the Amalfi Coast."
  lang={lang}
  breadcrumbs={breadcrumbs}
  schema={schemas}
  pageKey="tramonti"
>

  <!-- Hero -->
  <section class="relative h-[75vh] sm:h-[90vh] flex items-center bg-charcoal overflow-hidden">
    <img src="/images/tramonti-hero.webp" alt="Tramonti, the green lung of the Amalfi Coast" class="absolute inset-0 w-full h-full object-cover" loading="eager" referrerpolicy="no-referrer"/>
    <div class="absolute inset-0 bg-gradient-to-b from-black/10 via-black/40 to-black/80 z-10"></div>
    <div class="relative z-20 max-w-editorial mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <p class="text-med-gold text-xs sm:text-sm font-medium uppercase tracking-[0.3em] mb-3">Amalfi Coast Hinterland</p>
        <h1 class="font-serif text-display text-white mb-4">Tramonti</h1>
        <p class="text-xl text-white/80 leading-relaxed max-w-2xl">
          The green lung of the Coast. DOC wines, authentic pizza, and 13 hamlets where time has stood still.
        </p>
        <div class="flex flex-wrap gap-3 mt-8">
          <a href="#fast-facts" class="px-5 py-2.5 bg-med-gold text-white text-xs sm:text-sm font-semibold rounded-full hover:scale-105 hover:shadow-[0_8px_25px_rgba(212,175,55,0.4)] transition-all duration-300">Fast Facts</a>
          <a href="#wines" class="px-5 py-2.5 bg-white/10 backdrop-blur text-white text-xs sm:text-sm font-medium rounded-full border border-white/20 hover:bg-white/20 transition-colors">DOC Wines</a>
          <a href="#faq" class="px-5 py-2.5 bg-white/10 backdrop-blur text-white text-xs sm:text-sm font-medium rounded-full border border-white/20 hover:bg-white/20 transition-colors">FAQ</a>
        </div>
      </div>
    </div>
    <Breadcrumbs breadcrumbs={breadcrumbs} />
  </section>

  <section class="max-w-editorial mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="grid lg:grid-cols-[1fr_320px] gap-12">

      <div class="space-y-16">

        <div class="prose-editorial">
          <p class="text-xl leading-relaxed text-charcoal">
            Tramonti is the Amalfi Coast you don't expect. No sea, no tourists, no queues: just terraced hillsides, gravity-defying vineyards, 13 scattered hamlets connected by narrow roads, and a food and wine tradition that rivals any gourmet destination in Italy.
          </p>
          <p class="mt-4 text-slate-600 leading-relaxed">
            The name itself tells the story: <em>tra i monti</em> — among the mountains. Reachable via the <strong>Valico di Chiunzi</strong> (one of the most scenic mountain passes in Campania), Tramonti is the heartland of <strong>Costa d'Amalfi DOC</strong> wine and the pizza-making tradition that has conquered the world.
          </p>
        </div>

        <!-- Did You Know -->
        <div class="bg-slate-900 border border-white/10 rounded-[3rem] p-8">
          <p class="text-[10px] uppercase tracking-[0.3em] text-med-gold font-medium mb-4">Did you know?</p>
          <div class="grid sm:grid-cols-3 gap-6">
            <div class="text-center">
              <p class="font-serif text-5xl font-bold text-med-gold">13</p>
              <p class="text-white/60 text-xs italic mt-1">scattered hamlets, each with its own church</p>
            </div>
            <div class="text-center">
              <p class="font-serif text-5xl font-bold text-med-gold">1870</p>
              <p class="text-white/60 text-xs italic mt-1">founding year of Cantina Apicella winery</p>
            </div>
            <div class="text-center">
              <p class="font-serif text-5xl font-bold text-med-gold">DOC</p>
              <p class="text-white/60 text-xs italic mt-1">Costa d'Amalfi sub-zone Tramonti</p>
            </div>
          </div>
        </div>

        <!-- Wines -->
        <div id="wines">
          <h2 class="font-serif text-3xl font-semibold text-slate-900 mb-6">The Wines of Tramonti</h2>
          <p class="text-slate-600 text-lg leading-relaxed mb-6">
            Tramonti is the heart of wine production on the Amalfi Coast. The south-facing terraced vineyards, at 200–600 m altitude, produce grapes found nowhere else.
          </p>
          <div class="space-y-6">
            <div class="bg-med-gold/10 p-6 rounded-2xl border border-med-gold/20">
              <h3 class="font-bold text-slate-900 mb-2 text-lg">Tintore di Tramonti</h3>
              <p class="text-slate-600 leading-relaxed">The most important native red grape variety: it produces intense, tannic wines with a deep, almost black colour. It is a local clone of Piedirosso but with unique characteristics attributable to the altitude and volcanic soil.</p>
            </div>
            <div class="bg-med-gold/10 p-6 rounded-2xl border border-med-gold/20">
              <h3 class="font-bold text-slate-900 mb-2 text-lg">Whites & Rosés</h3>
              <p class="text-slate-600 leading-relaxed">Falanghina, Biancolella, and the rare Pepella produce fresh, mineral whites. Piedirosso rosés are perfect with fish. Wineries to visit: Apicella, Reale, Monte di Grazia, Tenuta San Francesco.</p>
            </div>
          </div>
        </div>

        <!-- What to See -->
        <div>
          <h2 class="font-serif text-3xl font-semibold text-slate-900 mb-8">What to See in Tramonti</h2>
          <div class="space-y-8">
            {[
              { n: 1, title: 'Conservatorio di San Giuseppe e Teresa', text: 'The most important monument in Tramonti, with 17th-century frescoes and a historic organ. Located in the hamlet of Polvica, it can be visited on request. A forgotten jewel.' },
              { n: 2, title: 'The 13 Hamlets', text: 'Each hamlet has its own church, identity, and traditions. The most characterful: Gete (panoramic), Corsano (with the castle), Campinola (with the church of San Michele), Polvica (with the Conservatorio).' },
              { n: 3, title: 'Valico di Chiunzi', text: 'The mountain pass at 656 m that divides the Amalfi Coast from the Agro Nocerino plain. The view over the Sarno Valley, Vesuvius, and the Campanian plain is spectacular, especially at sunset.' },
              { n: 4, title: 'Trails & Nature', text: 'Tramonti is crossed by marked CAI trails linking the hamlets and leading into the Lattari Mountains. Chestnut woods, hazelnut groves, and terracing: an intact agricultural landscape.' },
            ].map(({ n, title, text }) => (
              <div class="grid sm:grid-cols-[auto_1fr] gap-4">
                <div class="w-14 h-14 rounded-[1rem] bg-med-gold/10 flex items-center justify-center flex-shrink-0 text-med-gold font-serif font-bold text-xl">{n}</div>
                <div>
                  <h3 class="font-semibold text-charcoal text-lg mb-1">{title}</h3>
                  <p class="text-slate-600 leading-relaxed">{text}</p>
                </div>
              </div>
            ))}
          </div>
        </div>

        <!-- Local Tip -->
        <div class="relative overflow-hidden rounded-[3rem] bg-med-blue p-10 md:p-14 text-white shadow-2xl">
          <div class="relative z-10 flex flex-col md:flex-row items-start md:items-center gap-8">
            <div class="w-20 h-20 rounded-2xl bg-white/10 flex items-center justify-center flex-shrink-0 border border-white/20"><svg class="w-10 h-10 text-med-gold" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 3v2.25m6.364.386-1.591 1.591M21 12h-2.25m-.386 6.364-1.591-1.591M12 18.75V21m-4.773-4.227-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0Z"/></svg></div>
            <div>
              <p class="text-med-gold text-xs font-bold uppercase tracking-[0.3em] mb-2">Local Tip</p>
              <h3 class="font-serif text-2xl font-bold text-white mb-3 tracking-tight">Tramonti's pizza</h3>
              <p class="text-white/70 leading-relaxed">Tramonti is the homeland of pizza-makers: hundreds of Tramontane families run pizzerias around the world. The local pizzerias use fresh Fior di Latte and garden tomatoes — exceptional quality at prices that no longer exist on the coast itself.</p>
            </div>
          </div>
          <div class="absolute bottom-0 left-0 translate-y-1/2 -translate-x-1/2 w-80 h-80 bg-med-gold/10 rounded-full blur-3xl pointer-events-none"></div>
        </div>

        <!-- FAQ -->
        <div id="faq">
          <h2 class="font-serif text-3xl font-semibold text-slate-900 mb-8">Frequently Asked Questions about Tramonti</h2>
          <div class="space-y-4">
            {faqSchema.mainEntity.map((q) => (
              <details class="group border border-slate-200 rounded-2xl overflow-hidden">
                <summary class="flex items-center justify-between px-6 py-4 cursor-pointer select-none text-charcoal font-medium hover:bg-slate-50 transition-colors">
                  {q.name}
                  <svg class="w-4 h-4 text-slate-400 group-open:rotate-180 transition-transform flex-shrink-0 ml-3" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
                </summary>
                <div class="px-6 pb-5 text-slate-600 leading-relaxed text-xs sm:text-sm border-t border-slate-100 pt-4">
                  {q.acceptedAnswer.text}
                </div>
              </details>
            ))}
          </div>
        </div>

      </div>

      <aside class="space-y-6 lg:sticky lg:top-24 self-start">
        <div id="fast-facts" class="bg-slate-900 text-white rounded-[3rem] p-6">
          <p class="text-[10px] uppercase tracking-[0.3em] text-med-gold font-medium mb-4">Fast Facts - Tramonti</p>
          <dl class="space-y-3">
            {fastFacts.map(({ dt, dd }, i) => (
              <>
                <div class="flex justify-between items-start gap-3">
                  <dt class="text-white/40 text-xs sm:text-sm font-light flex-shrink-0">{dt}</dt>
                  <dd class="text-white font-medium text-xs sm:text-sm text-right">{dd}</dd>
                </div>
                {i < fastFacts.length - 1 && <div class="border-t border-white/5"></div>}
              </>
            ))}
          </dl>
        </div>

        <div class="bg-med-cream border border-med-gold/30 rounded-[2rem] p-6">
          <p class="text-[10px] uppercase tracking-[0.3em] text-med-gold font-medium mb-3">Insider Tips</p>
          <ul class="space-y-3">
            {tips.map(tip => (
              <li class="flex items-start gap-2 text-xs sm:text-sm text-charcoal">
                <span class="w-1.5 h-1.5 rounded-full bg-med-gold mt-1.5 flex-shrink-0"></span>
                <span>{tip}</span>
              </li>
            ))}
          </ul>
        </div>

        <div class="bg-white border border-slate-100 rounded-[2rem] p-6 shadow-sm">
          <p class="text-[10px] uppercase tracking-[0.3em] text-slate-400 font-medium mb-3">Explore the Coast</p>
          <nav class="space-y-1">
            {[
              { href: '/en-us/amalfi-coast/agerola/', label: 'Agerola' },
              { href: '/en-us/amalfi-coast/ravello/', label: 'Ravello' },
              { href: '/en-us/amalfi-coast/maiori/', label: 'Maiori' },
              { href: '/en-us/amalfi-coast/minori/', label: 'Minori' },
              { href: '/en-us/amalfi-coast/amalfi/', label: 'Amalfi' },
            ].map(({ href, label }) => (
              <a href={href} class="flex items-center gap-2 px-3 py-2 rounded-xl text-xs sm:text-sm text-charcoal hover:bg-med-blue/5 hover:text-med-blue transition-colors">
                <span class="w-1.5 h-1.5 rounded-full bg-med-blue/30"></span> {label}
              </a>
            ))}
          </nav>
        </div>
      </aside>

    </div>
  </section>

  <CorrelationSlider
    heading="Explore More on the Amalfi Coast"
    items={[
      { name: 'Agerola',  href: '/en-us/amalfi-coast/agerola/',  tag: 'Hiking & Nature',    desc: 'Path of the Gods, Fior di Latte, and panoramas at 600 m.' },
      { name: 'Ravello',  href: '/en-us/amalfi-coast/ravello/',  tag: 'Music & Gardens',    desc: 'Villa Rufolo, Villa Cimbrone, and the Music Festival.' },
      { name: 'Maiori',   href: '/en-us/amalfi-coast/maiori/',   tag: 'Beach & Relaxation', desc: 'The longest sandy beach on the coast.' },
      { name: 'Minori',   href: '/en-us/amalfi-coast/minori/',   tag: 'Flavours & Culture', desc: 'Roman villa and fresh scialatielli pasta.' },
      { name: 'Furore',   href: '/en-us/amalfi-coast/furore/',   tag: 'The Village That Doesn\'t Exist', desc: 'The spectacular Fjord and the mural-covered village.' },
    ]}
    lang="en-us"
  />

</BaseLayout>
