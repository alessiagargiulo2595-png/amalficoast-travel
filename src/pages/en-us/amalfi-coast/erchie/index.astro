---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import CorrelationSlider from '../../../../components/CorrelationSlider.astro';
import Breadcrumbs from '../../../../components/Breadcrumbs.astro';

const lang = 'en-us';

const breadcrumbs = [
  { name: 'Home', url: '/en-us/' },
  { name: 'Amalfi Coast', url: '/en-us/amalfi-coast/' },
  { name: 'Erchie', url: '/en-us/amalfi-coast/erchie/' },
];

const touristAttractionSchema = {
  "@context": "https://schema.org",
  "@type": "TouristAttraction",
  "name": "Erchie",
  "description": "Erchie is a small fishing village on the Amalfi Coast, a hamlet of Maiori, with a rare sandy beach sheltered by a Saracen tower and an authentic atmosphere far from mass tourism.",
  "url": "https://amalficoast-travel.com/en-us/amalfi-coast/erchie/",
  "touristType": ["Sea", "Relaxation", "Authenticity", "Families"],
  "address": { "@type": "PostalAddress", "addressLocality": "Erchie", "addressRegion": "Salerno", "addressCountry": "IT", "postalCode": "84010" },
  "geo": { "@type": "GeoCoordinates", "latitude": 40.6278, "longitude": 14.6792 }
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "How do you get to Erchie?",
      "acceptedAnswer": { "@type": "Answer", "text": "By car: on the SS163 between Cetara and Maiori, a turn-off leads down to the village (limited parking). By SITA bus: Erchie stop on the Salerno–Amalfi line. By boat: reachable by sea from Maiori or Cetara." }
    },
    {
      "@type": "Question",
      "name": "Is the beach at Erchie sandy?",
      "acceptedAnswer": { "@type": "Answer", "text": "Yes, Erchie has one of the very few sandy beaches on the Amalfi Coast. It is a sheltered bay with calm, shallow water near the shoreline — ideal for families with young children. There is a free section and an equipped section with sunbeds and umbrellas for hire." }
    },
    {
      "@type": "Question",
      "name": "Is Erchie crowded in summer?",
      "acceptedAnswer": { "@type": "Answer", "text": "Far less so than Positano or Amalfi. Erchie is known mainly to locals and Campanian visitors. In August it can be busy but never truly overcrowded. Arrive early in the morning to get the best spot." }
    },
    {
      "@type": "Question",
      "name": "Are there restaurants in Erchie?",
      "acceptedAnswer": { "@type": "Answer", "text": "Yes, there are several trattorias and seafood restaurants directly on the beach and in the village. Incredibly fresh seafood at lower prices than the main coast restaurants." }
    },
    {
      "@type": "Question",
      "name": "What is the Erchie Tower?",
      "acceptedAnswer": { "@type": "Answer", "text": "It is a 16th-century Saracen watchtower that dominates the bay. Built to defend the village from pirate raids, today it is one of the most photographed landmarks in the area. It cannot be entered, but it makes a stunning backdrop." }
    }
  ]
};

const schemas = [touristAttractionSchema, faqSchema];

const fastFacts = [
  { dt: 'Location', dd: 'Amalfi Coast, SA' },
  { dt: 'Municipality', dd: 'Hamlet of Maiori' },
  { dt: 'From Salerno', dd: '25 min (car/bus)' },
  { dt: 'From Amalfi', dd: '20 min (car/bus)' },
  { dt: 'Beach', dd: 'Sand (rare on the coast!)' },
  { dt: 'Tower', dd: 'Saracen tower, XVI century' },
  { dt: 'Services', dd: 'Restaurants, beach clubs, parking' },
  { dt: 'Best period', dd: 'May–Sep' },
  { dt: 'Ideal for', dd: 'Families, relaxation, swimming' },
];

const tips = [
  'Erchie has one of the very few sandy beaches on the Amalfi Coast — perfect for families with young children.',
  'Parking is extremely limited: arrive early or take the SITA bus from Salerno or Maiori.',
  'Have lunch at one of the beachside trattorias: fresh fish at half the price of Amalfi.',
  'The bay is sheltered from the wind — even when the sea is rough elsewhere, the water here is often calm.',
];
---

<BaseLayout
  title="Erchie 2026: The Secret Sandy Beach of the Amalfi Coast"
  description="Guide to Erchie: the hidden sandy beach of the Amalfi Coast, the Saracen tower, and fresh seafood restaurants. The authentic fishing village between Cetara and Maiori."
  lang={lang}
  breadcrumbs={breadcrumbs}
  schema={schemas}
  pageKey="erchie"
>

  <!-- Hero -->
  <section class="relative h-[75vh] sm:h-[90vh] flex items-center bg-charcoal overflow-hidden">
    <img src="/images/erchie-hero.webp" alt="Erchie, fishing village on the Amalfi Coast" class="absolute inset-0 w-full h-full object-cover" loading="eager" referrerpolicy="no-referrer"/>
    <div class="absolute inset-0 bg-gradient-to-b from-black/10 via-black/40 to-black/80 z-10"></div>
    <div class="relative z-20 max-w-editorial mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <p class="text-med-gold text-xs sm:text-sm font-medium uppercase tracking-[0.3em] mb-3">Fishing Village of the Coast</p>
        <h1 class="font-serif text-display text-white mb-4">Erchie</h1>
        <p class="text-xl text-white/80 leading-relaxed max-w-2xl">
          An amphitheatre of white houses around a sandy bay, guarded by a Saracen tower. The best-kept secret on the Amalfi Coast.
        </p>
        <div class="flex flex-wrap gap-3 mt-8">
          <a href="#fast-facts" class="px-5 py-2.5 bg-med-gold text-white text-xs sm:text-sm font-semibold rounded-full hover:scale-105 hover:shadow-[0_8px_25px_rgba(212,175,55,0.4)] transition-all duration-300">Fast Facts</a>
          <a href="#the-beach" class="px-5 py-2.5 bg-white/10 backdrop-blur text-white text-xs sm:text-sm font-medium rounded-full border border-white/20 hover:bg-white/20 transition-colors">The Beach</a>
          <a href="#faq" class="px-5 py-2.5 bg-white/10 backdrop-blur text-white text-xs sm:text-sm font-medium rounded-full border border-white/20 hover:bg-white/20 transition-colors">FAQ</a>
        </div>
      </div>
    </div>
    <Breadcrumbs breadcrumbs={breadcrumbs} />
  </section>

  <section class="max-w-editorial mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="grid lg:grid-cols-[1fr_320px] gap-12">

      <div class="space-y-16">

        <div class="prose-editorial">
          <p class="text-xl leading-relaxed text-charcoal">
            Erchie is the village that tourists don't find. Hidden in a bay between <a href="/en-us/amalfi-coast/cetara/" class="text-med-blue hover:underline">Cetara</a> and <a href="/en-us/amalfi-coast/maiori/" class="text-med-blue hover:underline">Maiori</a>, this small amphitheatre of white houses overlooking a sandy beach is where Campanian locals go to the beach when they want to escape the crowds.
          </p>
          <p class="mt-4 text-slate-600 leading-relaxed">
            A hamlet of Maiori, Erchie has preserved the atmosphere of a fishing village that the rest of the coast lost long ago. The 16th-century Saracen tower dominates the bay, colourful boats are pulled up on the sand, and the restaurants serve fish caught that very morning.
          </p>
        </div>

        <!-- Did You Know -->
        <div class="bg-slate-900 border border-white/10 rounded-[3rem] p-8">
          <p class="text-[10px] uppercase tracking-[0.3em] text-med-gold font-medium mb-4">Did you know?</p>
          <div class="grid sm:grid-cols-3 gap-6">
            <div class="text-center">
              <p class="font-serif text-5xl font-bold text-med-gold">XVI cent.</p>
              <p class="text-white/60 text-xs italic mt-1">the Saracen tower overlooking the bay</p>
            </div>
            <div class="text-center">
              <p class="font-serif text-5xl font-bold text-med-gold">Sandy</p>
              <p class="text-white/60 text-xs italic mt-1">a rare find on the Amalfi Coast</p>
            </div>
            <div class="text-center">
              <p class="font-serif text-5xl font-bold text-med-gold">~200</p>
              <p class="text-white/60 text-xs italic mt-1">residents in the village</p>
            </div>
          </div>
        </div>

        <!-- The Beach -->
        <div id="the-beach">
          <h2 class="font-serif text-3xl font-semibold text-slate-900 mb-6">The Beach at Erchie</h2>
          <p class="text-slate-600 text-lg leading-relaxed mb-6">
            Erchie's beach is one of the very few sandy beaches on the Amalfi Coast. A sheltered bay with calm water that is shallow near the shore — ideal for families.
          </p>
          <div class="space-y-6">
            <div class="bg-white p-6 rounded-2xl border border-slate-100">
              <h3 class="font-bold text-slate-900 mb-2">Main beach</h3>
              <p class="text-slate-600 text-sm">Fine sand with a free section and an equipped section (sunbeds and umbrellas for hire). The Saracen tower provides a scenic backdrop. Calm water thanks to the shape of the bay.</p>
            </div>
            <div class="bg-white p-6 rounded-2xl border border-slate-100">
              <h3 class="font-bold text-slate-900 mb-2">Eastern cove</h3>
              <p class="text-slate-600 text-sm">A small pebble cove reachable on foot from the village — wilder and more peaceful. Ideal for those seeking solitude and snorkelling in clear water.</p>
            </div>
          </div>
        </div>

        <!-- What to See -->
        <div>
          <h2 class="font-serif text-3xl font-semibold text-slate-900 mb-8">What to See in Erchie</h2>
          <div class="space-y-8">
            {[
              { n: 1, title: 'Saracen Tower', text: 'The symbol of Erchie: a 16th-century watchtower built to defend the coast from pirate incursions. It dominates the bay with its imposing mass. Not open to the public inside, but an unmissable photographic backdrop.' },
              { n: 2, title: 'Abbey of Santa Maria de Erchie', text: 'An ancient Benedictine abbey founded in the 11th century, perched above the village. The remains of the medieval structure are partly visitable and offer a panoramic view over the bay.' },
              { n: 3, title: 'The fishing village', text: 'Wander among the white houses, flower-lined staircases, and colourful boats pulled up on the sand. Erchie has maintained its fishing village character thanks to its secluded position away from the main road.' },
              { n: 4, title: 'Erchie–Cetara Coastal Path', text: 'A coastal path linking Erchie to Cetara through Mediterranean scrub. About 3 km, 1 hour of walking, with views of the coast and the sea. Easy difficulty.' },
            ].map(({ n, title, text }) => (
              <div class="grid sm:grid-cols-[auto_1fr] gap-4">
                <div class="w-14 h-14 rounded-[1rem] bg-med-gold/10 flex items-center justify-center flex-shrink-0 text-med-gold font-serif font-bold text-xl">{n}</div>
                <div>
                  <h3 class="font-semibold text-charcoal text-lg mb-1">{title}</h3>
                  <p class="text-slate-600 leading-relaxed">{text}</p>
                </div>
              </div>
            ))}
          </div>
        </div>

        <!-- Local Tip -->
        <div class="relative overflow-hidden rounded-[3rem] bg-med-blue p-10 md:p-14 text-white shadow-2xl">
          <div class="relative z-10 flex flex-col md:flex-row items-start md:items-center gap-8">
            <div class="w-20 h-20 rounded-2xl bg-white/10 flex items-center justify-center flex-shrink-0 border border-white/20"><svg class="w-10 h-10 text-med-gold" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 3v2.25m6.364.386-1.591 1.591M21 12h-2.25m-.386 6.364-1.591-1.591M12 18.75V21m-4.773-4.227-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0Z"/></svg></div>
            <div>
              <p class="text-med-gold text-xs font-bold uppercase tracking-[0.3em] mb-2">Local Tip</p>
              <h3 class="font-serif text-2xl font-bold text-white mb-3 tracking-tight">The Campanian secret</h3>
              <p class="text-white/70 leading-relaxed">Erchie is where Salernitans and Campanians go to the sea when they want the coast without the crowds. Real sand, calm water, fresh fish, and honest prices. On a weekday outside peak season, you could almost have the beach to yourself.</p>
            </div>
          </div>
          <div class="absolute bottom-0 left-0 translate-y-1/2 -translate-x-1/2 w-80 h-80 bg-med-gold/10 rounded-full blur-3xl pointer-events-none"></div>
        </div>

        <!-- FAQ -->
        <div id="faq">
          <h2 class="font-serif text-3xl font-semibold text-slate-900 mb-8">Frequently Asked Questions about Erchie</h2>
          <div class="space-y-4">
            {faqSchema.mainEntity.map((q) => (
              <details class="group border border-slate-200 rounded-2xl overflow-hidden">
                <summary class="flex items-center justify-between px-6 py-4 cursor-pointer select-none text-charcoal font-medium hover:bg-slate-50 transition-colors">
                  {q.name}
                  <svg class="w-4 h-4 text-slate-400 group-open:rotate-180 transition-transform flex-shrink-0 ml-3" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
                </summary>
                <div class="px-6 pb-5 text-slate-600 leading-relaxed text-xs sm:text-sm border-t border-slate-100 pt-4">
                  {q.acceptedAnswer.text}
                </div>
              </details>
            ))}
          </div>
        </div>

      </div>

      <aside class="space-y-6 lg:sticky lg:top-24 self-start">
        <div id="fast-facts" class="bg-slate-900 text-white rounded-[3rem] p-6">
          <p class="text-[10px] uppercase tracking-[0.3em] text-med-gold font-medium mb-4">Fast Facts - Erchie</p>
          <dl class="space-y-3">
            {fastFacts.map(({ dt, dd }, i) => (
              <>
                <div class="flex justify-between items-start gap-3">
                  <dt class="text-white/40 text-xs sm:text-sm font-light flex-shrink-0">{dt}</dt>
                  <dd class="text-white font-medium text-xs sm:text-sm text-right">{dd}</dd>
                </div>
                {i < fastFacts.length - 1 && <div class="border-t border-white/5"></div>}
              </>
            ))}
          </dl>
        </div>

        <div class="bg-med-cream border border-med-gold/30 rounded-[2rem] p-6">
          <p class="text-[10px] uppercase tracking-[0.3em] text-med-gold font-medium mb-3">Insider Tips</p>
          <ul class="space-y-3">
            {tips.map(tip => (
              <li class="flex items-start gap-2 text-xs sm:text-sm text-charcoal">
                <span class="w-1.5 h-1.5 rounded-full bg-med-gold mt-1.5 flex-shrink-0"></span>
                <span>{tip}</span>
              </li>
            ))}
          </ul>
        </div>

        <div class="bg-white border border-slate-100 rounded-[2rem] p-6 shadow-sm">
          <p class="text-[10px] uppercase tracking-[0.3em] text-slate-400 font-medium mb-3">Explore the Coast</p>
          <nav class="space-y-1">
            {[
              { href: '/en-us/amalfi-coast/cetara/', label: 'Cetara' },
              { href: '/en-us/amalfi-coast/maiori/', label: 'Maiori' },
              { href: '/en-us/amalfi-coast/vietri-sul-mare/', label: 'Vietri sul Mare' },
              { href: '/en-us/amalfi-coast/minori/', label: 'Minori' },
              { href: '/en-us/amalfi-coast/amalfi/', label: 'Amalfi' },
            ].map(({ href, label }) => (
              <a href={href} class="flex items-center gap-2 px-3 py-2 rounded-xl text-xs sm:text-sm text-charcoal hover:bg-med-blue/5 hover:text-med-blue transition-colors">
                <span class="w-1.5 h-1.5 rounded-full bg-med-blue/30"></span> {label}
              </a>
            ))}
          </nav>
        </div>
      </aside>

    </div>
  </section>

  <CorrelationSlider
    heading="Explore More on the Amalfi Coast"
    items={[
      { name: 'Cetara',   href: '/en-us/amalfi-coast/cetara/',   tag: 'Fishing Village',    desc: 'The fishermen\'s village and birthplace of colatura di alici DOP.' },
      { name: 'Maiori',   href: '/en-us/amalfi-coast/maiori/',   tag: 'Beach & Relaxation', desc: 'The longest sandy beach on the coast: 300 m.' },
      { name: 'Vietri',   href: '/en-us/amalfi-coast/vietri-sul-mare/', tag: 'Ceramics',    desc: 'The gateway to the coast, famous for its artistic ceramics.' },
      { name: 'Minori',   href: '/en-us/amalfi-coast/minori/',   tag: 'Flavours & Culture', desc: 'Roman villa and fresh scialatielli pasta.' },
      { name: 'Amalfi',   href: '/en-us/amalfi-coast/amalfi/',   tag: 'Maritime Republic',  desc: 'The historic capital with the Cathedral and the Paper Museum.' },
    ]}
    lang="en-us"
  />

</BaseLayout>
