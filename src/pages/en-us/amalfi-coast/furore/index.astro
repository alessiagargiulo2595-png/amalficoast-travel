---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import CorrelationSlider from '../../../../components/CorrelationSlider.astro';
import Breadcrumbs from '../../../../components/Breadcrumbs.astro';

const lang = 'en-us';

const breadcrumbs = [
  { name: 'Home', url: '/en-us/' },
  { name: 'Amalfi Coast', url: '/en-us/amalfi-coast/' },
  { name: 'Furore', url: '/en-us/amalfi-coast/furore/' },
];

const touristAttractionSchema = {
  "@context": "https://schema.org",
  "@type": "TouristAttraction",
  "name": "Furore",
  "description": "Furore is the village that doesn't exist on the Amalfi Coast: without a true centre, its houses cling to the mountainside around the celebrated Furore Fjord, a spectacular canyon plunging into the sea.",
  "url": "https://amalficoast-travel.com/en-us/amalfi-coast/furore/",
  "touristType": ["Nature", "Photography", "Art", "Sea"],
  "address": { "@type": "PostalAddress", "addressLocality": "Furore", "addressRegion": "Salerno", "addressCountry": "IT", "postalCode": "84010" },
  "geo": { "@type": "GeoCoordinates", "latitude": 40.6264, "longitude": 14.5525 }
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What is the Furore Fjord?",
      "acceptedAnswer": { "@type": "Answer", "text": "It is a deep natural inlet (a karst fjord) where the Schiato stream meets the sea through a 30-metre canyon. A small road bridge spans it overhead, creating one of the most iconic images on the Amalfi Coast. The small pebble beach at the foot of the fjord is reached by a staircase." }
    },
    {
      "@type": "Question",
      "name": "How do you get to the Furore Fjord?",
      "acceptedAnswer": { "@type": "Answer", "text": "By SITA bus on the Amalfi–Positano line (stop: Furore Fiordo). By car, the fjord is on the SS163 between Praiano and Conca dei Marini — there is a small car park before the bridge. On foot, a staircase of about 200 steps descends to the beach." }
    },
    {
      "@type": "Question",
      "name": "Why is Furore called the village that doesn't exist?",
      "acceptedAnswer": { "@type": "Answer", "text": "Because Furore has no traditional historic centre: the houses, churches, and shops are scattered along the road and clinging to the hillside without forming a compact nucleus. It is a dispersed municipality where every corner is a small village in its own right." }
    },
    {
      "@type": "Question",
      "name": "Can you swim at the Furore Fjord?",
      "acceptedAnswer": { "@type": "Answer", "text": "Yes, the small pebble beach at the foot of the fjord is open for swimming. The water is clear and cool thanks to the stream. Arrive early — space is very limited and in summer it fills up quickly. There are no services (no bar, no sunbed hire)." }
    },
    {
      "@type": "Question",
      "name": "What are the murals of Furore?",
      "acceptedAnswer": { "@type": "Answer", "text": "Furore is a Painted Village (Paese Dipinto). Since the 1980s, Italian and international artists have created murals on the walls of houses along the road. Today there are over 100, turning the village into an open-air art gallery." }
    }
  ]
};

const schemas = [touristAttractionSchema, faqSchema];

const fastFacts = [
  { dt: 'Location', dd: 'Amalfi Coast, SA' },
  { dt: 'Altitude', dd: '0–650 m' },
  { dt: 'Population', dd: '~800' },
  { dt: 'From Amalfi', dd: '15 min (car/bus)' },
  { dt: 'From Positano', dd: '10 min (car/bus)' },
  { dt: 'Beach', dd: 'Pebbles (at the Fjord)' },
  { dt: 'Specialties', dd: 'Murals, Fjord, wine' },
  { dt: 'Best period', dd: 'Apr–Oct' },
  { dt: 'Ideal for', dd: 'Photography, nature, art' },
];

const tips = [
  'The best shot of the Fjord is from the road bridge: arrive in the early morning when the sun illuminates the canyon.',
  'The Fjord beach is tiny — in summer get there before 9:00 am or you won\'t find a spot.',
  'Walk along the SS163 hunting for murals: there are over 100 and they tell the story of the village.',
  'Every July the Mediterranean Cup is held: professional cliff divers leap from the Fjord bridge (14 m).',
];
---

<BaseLayout
  title="Furore 2026: The Fjord, Murals & The Village That Doesn't Exist"
  description="Guide to Furore: the famous Fjord, the murals of the Painted Village, and the hidden beach. The most unusual village on the Amalfi Coast — no centre, but a unique soul."
  lang={lang}
  breadcrumbs={breadcrumbs}
  schema={schemas}
  pageKey="furore"
>

  <!-- Hero -->
  <section class="relative h-[75vh] sm:h-[90vh] flex items-center bg-charcoal overflow-hidden">
    <img src="/images/fiordo-furore-hero.webp" alt="The Furore Fjord, Amalfi Coast" class="absolute inset-0 w-full h-full object-cover" loading="eager" fetchpriority="high" decoding="sync" referrerpolicy="no-referrer"/>
    <div class="absolute inset-0 bg-gradient-to-b from-black/10 via-black/40 to-black/80 z-10"></div>
    <div class="relative z-20 max-w-editorial mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <p class="text-med-gold text-xs sm:text-sm font-medium uppercase tracking-[0.3em] mb-3">The Painted Village of the Coast</p>
        <h1 class="font-serif text-display text-white mb-4">Furore</h1>
        <p class="text-xl text-white/80 leading-relaxed max-w-2xl">
          The village that doesn't exist. A spectacular fjord, 100+ murals, and houses clinging to the mountain with no centre.
        </p>
        <div class="flex flex-wrap gap-3 mt-8">
          <a href="#fast-facts" class="px-5 py-2.5 bg-med-gold text-white text-xs sm:text-sm font-semibold rounded-full hover:scale-105 hover:shadow-[0_8px_25px_rgba(212,175,55,0.4)] transition-all duration-300">Fast Facts</a>
          <a href="#the-fjord" class="px-5 py-2.5 bg-white/10 backdrop-blur text-white text-xs sm:text-sm font-medium rounded-full border border-white/20 hover:bg-white/20 transition-colors">The Fjord</a>
          <a href="#faq" class="px-5 py-2.5 bg-white/10 backdrop-blur text-white text-xs sm:text-sm font-medium rounded-full border border-white/20 hover:bg-white/20 transition-colors">FAQ</a>
        </div>
      </div>
    </div>
    <Breadcrumbs breadcrumbs={breadcrumbs} />
  </section>

  <section class="max-w-editorial mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="grid lg:grid-cols-[1fr_320px] gap-12">

      <div class="space-y-16">

        <div class="prose-editorial">
          <p class="text-xl leading-relaxed text-charcoal">
            Furore is a paradox: an Amalfi Coast municipality with no centre, a village famous for a fjord that is technically a canyon, a settlement of 800 souls that draws photographers from around the world. It is the most unusual and surprising place on the entire coast.
          </p>
          <p class="mt-4 text-slate-600 leading-relaxed">
            Furore's houses are scattered along the SS163 and cling to the terracing that descends towards the sea. There is no piazza, no seafront: just rock, lemon trees, murals, and that fjord that looks like a film set. The name itself comes from the Latin <em>furor</em> — the roar of the sea crashing into the gorge.
          </p>
        </div>

        <!-- Did You Know -->
        <div class="bg-slate-900 border border-white/10 rounded-[3rem] p-8">
          <p class="text-[10px] uppercase tracking-[0.3em] text-med-gold font-medium mb-4">Did you know?</p>
          <div class="grid sm:grid-cols-3 gap-6">
            <div class="text-center">
              <p class="font-serif text-5xl font-bold text-med-gold">100+</p>
              <p class="text-white/60 text-xs italic mt-1">murals on the walls of the village</p>
            </div>
            <div class="text-center">
              <p class="font-serif text-5xl font-bold text-med-gold">30 m</p>
              <p class="text-white/60 text-xs italic mt-1">depth of the Fjord canyon</p>
            </div>
            <div class="text-center">
              <p class="font-serif text-5xl font-bold text-med-gold">~800</p>
              <p class="text-white/60 text-xs italic mt-1">residents — one of Italy's smallest municipalities</p>
            </div>
          </div>
        </div>

        <!-- The Fjord -->
        <div id="the-fjord">
          <h2 class="font-serif text-3xl font-semibold text-slate-900 mb-6">The Furore Fjord</h2>
          <p class="text-slate-600 text-lg leading-relaxed mb-6">
            The <strong>Furore Fjord</strong> is the most photographed natural attraction on the Amalfi Coast after Positano. A karst canyon where the Schiato stream meets the sea, carving a gorge 30 metres deep into the limestone rock.
          </p>
          <div class="space-y-6">
            <div class="bg-white p-6 rounded-2xl border border-slate-100">
              <h3 class="font-bold text-slate-900 mb-2">The Fjord beach</h3>
              <p class="text-slate-600 text-sm">A tiny strip of pebbles at the foot of the canyon, reached by a staircase of about 200 steps from the SS163. Crystal-clear, cool water, no services. Space is very limited — in summer arrive before 9:00 am.</p>
            </div>
            <div class="bg-white p-6 rounded-2xl border border-slate-100">
              <h3 class="font-bold text-slate-900 mb-2">The bridge & the view</h3>
              <p class="text-slate-600 text-sm">The road bridge over the fjord offers the most iconic top-down view. Early in the morning the light enters the canyon illuminating the boats pulled up on shore. Every July, during the Mediterranean Cup, professional divers leap from the bridge (14 m).</p>
            </div>
            <div class="bg-white p-6 rounded-2xl border border-slate-100">
              <h3 class="font-bold text-slate-900 mb-2">The old fishermen's cave-houses</h3>
              <p class="text-slate-600 text-sm">At the foot of the fjord you can still see the ancient cave-dwellings where Furore's fishermen lived, carved into the rock and connected by steep stairways. Some have been restored and now house artists' studios and private residences.</p>
            </div>
          </div>
        </div>

        <!-- What to See -->
        <div>
          <h2 class="font-serif text-3xl font-semibold text-slate-900 mb-8">What to See in Furore</h2>
          <div class="space-y-8">
            {[
              { n: 1, title: 'The Murals of the Painted Village', text: 'Since the 1980s, Italian and international artists have transformed Furore into an open-air gallery. Over 100 murals decorate walls, facades, and staircases along the entire road. A spontaneous, free art trail.' },
              { n: 2, title: 'Church of San Giacomo', text: 'Furore\'s main church, perched high with a panoramic view over the sea and the vineyards. Simple and evocative, it represents the spiritual heart of a village without a centre.' },
              { n: 3, title: 'Sentiero della Volpe Pescatrice', text: 'A trail connecting sea level to the upper village through ancient terracing. Spectacular views of the coast and the fjord from above. Duration about 1–2 hours.' },
              { n: 4, title: 'Furore\'s Vineyards', text: 'Furore wine is among the finest in the Costa d\'Amalfi DOC. The extreme vineyards, hanging on the cliffs above the sea, produce the celebrated Fiorduva by Marisa Cuomo — one of the most sought-after whites in Italy.' },
            ].map(({ n, title, text }) => (
              <div class="grid sm:grid-cols-[auto_1fr] gap-4">
                <div class="w-14 h-14 rounded-[1rem] bg-med-gold/10 flex items-center justify-center flex-shrink-0 text-med-gold font-serif font-bold text-xl">{n}</div>
                <div>
                  <h3 class="font-semibold text-charcoal text-lg mb-1">{title}</h3>
                  <p class="text-slate-600 leading-relaxed">{text}</p>
                </div>
              </div>
            ))}
          </div>
        </div>

        <!-- Local Tip -->
        <div class="relative overflow-hidden rounded-[3rem] bg-med-blue p-10 md:p-14 text-white shadow-2xl">
          <div class="relative z-10 flex flex-col md:flex-row items-start md:items-center gap-8">
            <div class="w-20 h-20 rounded-2xl bg-white/10 flex items-center justify-center flex-shrink-0 border border-white/20"><svg class="w-10 h-10 text-med-gold" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 3v2.25m6.364.386-1.591 1.591M21 12h-2.25m-.386 6.364-1.591-1.591M12 18.75V21m-4.773-4.227-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0Z"/></svg></div>
            <div>
              <p class="text-med-gold text-xs font-bold uppercase tracking-[0.3em] mb-2">Local Tip</p>
              <h3 class="font-serif text-2xl font-bold text-white mb-3 tracking-tight">The Fiorduva by Marisa Cuomo</h3>
              <p class="text-white/70 leading-relaxed">If you love wine, seek out the Fiorduva: a white produced from grapes hand-harvested on the terraces directly above the Fjord. It is among the most award-winning wines in Campania and is available only here and in a handful of select wine shops.</p>
            </div>
          </div>
          <div class="absolute bottom-0 left-0 translate-y-1/2 -translate-x-1/2 w-80 h-80 bg-med-gold/10 rounded-full blur-3xl pointer-events-none"></div>
        </div>

        <!-- FAQ -->
        <div id="faq">
          <h2 class="font-serif text-3xl font-semibold text-slate-900 mb-8">Frequently Asked Questions about Furore</h2>
          <div class="space-y-4">
            {faqSchema.mainEntity.map((q) => (
              <details class="group border border-slate-200 rounded-2xl overflow-hidden">
                <summary class="flex items-center justify-between px-6 py-4 cursor-pointer select-none text-charcoal font-medium hover:bg-slate-50 transition-colors">
                  {q.name}
                  <svg class="w-4 h-4 text-slate-400 group-open:rotate-180 transition-transform flex-shrink-0 ml-3" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
                </summary>
                <div class="px-6 pb-5 text-slate-600 leading-relaxed text-xs sm:text-sm border-t border-slate-100 pt-4">
                  {q.acceptedAnswer.text}
                </div>
              </details>
            ))}
          </div>
        </div>

      </div>

      <aside class="space-y-6 lg:sticky lg:top-24 self-start">
        <div id="fast-facts" class="bg-slate-900 text-white rounded-[3rem] p-6">
          <p class="text-[10px] uppercase tracking-[0.3em] text-med-gold font-medium mb-4">Fast Facts - Furore</p>
          <dl class="space-y-3">
            {fastFacts.map(({ dt, dd }, i) => (
              <>
                <div class="flex justify-between items-start gap-3">
                  <dt class="text-white/40 text-xs sm:text-sm font-light flex-shrink-0">{dt}</dt>
                  <dd class="text-white font-medium text-xs sm:text-sm text-right">{dd}</dd>
                </div>
                {i < fastFacts.length - 1 && <div class="border-t border-white/5"></div>}
              </>
            ))}
          </dl>
        </div>

        <div class="bg-med-cream border border-med-gold/30 rounded-[2rem] p-6">
          <p class="text-[10px] uppercase tracking-[0.3em] text-med-gold font-medium mb-3">Insider Tips</p>
          <ul class="space-y-3">
            {tips.map(tip => (
              <li class="flex items-start gap-2 text-xs sm:text-sm text-charcoal">
                <span class="w-1.5 h-1.5 rounded-full bg-med-gold mt-1.5 flex-shrink-0"></span>
                <span>{tip}</span>
              </li>
            ))}
          </ul>
        </div>

        <div class="bg-white border border-slate-100 rounded-[2rem] p-6 shadow-sm">
          <p class="text-[10px] uppercase tracking-[0.3em] text-slate-400 font-medium mb-3">Explore the Coast</p>
          <nav class="space-y-1">
            {[
              { href: '/en-us/amalfi-coast/conca-dei-marini/', label: 'Conca dei Marini' },
              { href: '/en-us/amalfi-coast/praiano/', label: 'Praiano' },
              { href: '/en-us/amalfi-coast/agerola/', label: 'Agerola' },
              { href: '/en-us/amalfi-coast/amalfi/', label: 'Amalfi' },
              { href: '/en-us/amalfi-coast/positano/', label: 'Positano' },
            ].map(({ href, label }) => (
              <a href={href} class="flex items-center gap-2 px-3 py-2 rounded-xl text-xs sm:text-sm text-charcoal hover:bg-med-blue/5 hover:text-med-blue transition-colors">
                <span class="w-1.5 h-1.5 rounded-full bg-med-blue/30"></span> {label}
              </a>
            ))}
          </nav>
        </div>
      </aside>

    </div>
  </section>

  <CorrelationSlider
    heading="Explore More on the Amalfi Coast"
    items={[
      { name: 'Conca dei Marini', href: '/en-us/amalfi-coast/conca-dei-marini/', tag: 'Grotto & Sfogliatella', desc: 'The Emerald Grotto and the birthplace of sfogliatella Santa Rosa.' },
      { name: 'Praiano',  href: '/en-us/amalfi-coast/praiano/',  tag: 'Sunset & Quiet',    desc: 'The sunset from San Gennaro and the peaceful Marina di Praia.' },
      { name: 'Agerola',  href: '/en-us/amalfi-coast/agerola/',  tag: 'Hiking & Nature',   desc: 'Path of the Gods, Fior di Latte, and panoramas at 600 m.' },
      { name: 'Positano', href: '/en-us/amalfi-coast/positano/', tag: 'Fashion & Views',   desc: 'Colourful houses perched on the sea of the Amalfi Coast.' },
      { name: 'Amalfi',   href: '/en-us/amalfi-coast/amalfi/',   tag: 'Maritime Republic', desc: 'The historic capital with the Cathedral and the Paper Museum.' },
    ]}
    lang="en-us"
  />

</BaseLayout>
