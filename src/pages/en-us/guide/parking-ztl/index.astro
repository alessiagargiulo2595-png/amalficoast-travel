---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../../components/Breadcrumbs.astro';
import Swiper from 'swiper';
import { Pagination } from 'swiper/modules';

const lang = 'en-us';

const breadcrumbs = [
  { name: 'Home', url: '/en-us/' },
  { name: 'Planning', url: '/en-us/planning/' },
  { name: 'Home', url: '/en-us/guide/parking-ztl/' },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Can I drive to Positano?",
      "acceptedAnswer": { "@type": "Answer", "text": "In summer Positano is closed to traffic from 9:00 to 18:00 (ZTL). Only residents and hotel guests can enter by car. Best advice: park in Sorrento or Praiano and come by SITA bus or ferry." }
    },
    {
      "@type": "Question",
      "name": "Where should I park to visit the Amalfi Coast?",
      "acceptedAnswer": { "@type": "Answer", "text": "Best options: 1) Leave the car in Salerno or Vietri sul Mare and take the bus/ferry. 2) Park in Sorrento (Garage Achille Lauro, ~€2/h) and take the SITA bus or hydrofoil. 3) Use Amalfi's paid car parks (Luna Rossa, Flavio Gioia, ~€4–5/h) as a base." }
    },
    {
      "@type": "Question",
      "name": "How much does parking in Amalfi cost?",
      "acceptedAnswer": { "@type": "Answer", "text": "Amalfi's main car parks (Luna Rossa and Flavio Gioia) cost ~€4–5/hour or ~€25–30/day. They are almost always full in July and August. It's recommended to arrive before 9:00 or use public transport." }
    }
  ]
};

const ztlData = [
  { location: 'Positano', ztl: 'Yes', period: 'Jun–Sep (9:00–18:00)', note: 'Access reserved for residents and hotel guests. SITA bus or ferry recommended.' },
  { location: 'Amalfi', ztl: 'Yes', period: 'Year-round (centre)', note: 'Permanent ZTL in the historic core. Paid car parks on the seafront (~€4/h).' },
  { location: 'Ravello', ztl: 'Yes', period: 'Summer (10:00–19:00)', note: 'SITA bus from Amalfi only (25 min, ~€1.50) or car with hotel permit.' },
  { location: 'Sorrento', ztl: 'Yes', period: 'Summer (centre)', note: 'Covered garages available. Piazza Lauro ~€2/h.' },
  { location: 'Praiano', ztl: 'No', period: '-', note: 'Free and paid parking along the SS163. A great stopping point.' },
  { location: 'Maiori', ztl: 'No', period: '-', note: 'Parking available along the seafront. Easier than villages further west.' },
  { location: 'Minori', ztl: 'No', period: '-', note: 'Seafront car parks, free or low-cost.' },
];
---

<BaseLayout
  title="Amalfi Coast Parking & ZTL 2026 | Where to Leave Your Car"
  description="Complete guide to parking and ZTL restricted zones on the Amalfi Coast: Positano, Amalfi, Ravello, Sorrento. Where to park and how to reach the villages stress-free."
  lang={lang}
  breadcrumbs={breadcrumbs}
  schema={[faqSchema]}
 pageKey="parking-ztl">

  <section class="relative h-[75vh] sm:h-[90vh] flex items-center bg-charcoal overflow-hidden">
    <img src="/images/parcheggi-hero.jpg" alt="Sorrento, Sorrentine Peninsula" class="absolute inset-0 w-full h-full object-cover" loading="eager" referrerpolicy="no-referrer"/>
    <div class="absolute inset-0 bg-gradient-to-b from-black/25 via-black/40 to-black/75"></div>
    <div class="relative z-10 max-w-7xl mx-auto px-6 py-20">
      <div class="max-w-3xl">
        <p class="text-med-gold text-xs sm:text-sm font-medium uppercase tracking-[0.3em] mb-3">Travel Guide</p>
        <h1 class="font-serif text-display text-white mb-4">Parking & ZTL Zones</h1>
        <p class="text-xl text-white/80 leading-relaxed">
          The Amalfi Coast in summer is a nightmare for drivers: ZTL restrictions everywhere, narrow roads and expensive parking. Main advice: leave the car and use public transport. Here's how.
        </p>
      </div>
    </div>
    <Breadcrumbs breadcrumbs={breadcrumbs} />
  </section>

  <div class="max-w-editorial mx-auto px-4 sm:px-6 lg:px-8 pt-0 pb-4 space-y-12">

    <section class="max-w-editorial">
      <div style="background-color: #E2725B; border-color: #E2725B; padding: 6px 12px 6px 12px;" class="border rounded-[2rem] mb-6 mt-8">
        <p class="font-semibold mb-0 mt-0 text-white text-sm leading-tight" style="margin-top: -2px;">⚠️ ZTL Warning</p>
        <p class="text-xs text-white/95 leading-tight">ZTL (Limited Traffic Zones) on the Amalfi Coast are monitored by cameras. Entering without authorisation results in a fine of €80–160 sent directly to your rental company or home address. This is enforced seriously.</p>
      </div>
      <p class="text-xl leading-relaxed text-charcoal text-justify">
        The best strategy for visiting the Coast by car is the "strategic parking" approach: leave the car at an accessible point (Salerno, Vietri, Sorrento or Praiano) and use buses, ferries or hydrofoils from there.
      </p>
    </section>

    <section>
      <h2 class="font-serif text-2xl font-semibold text-slate-900 mb-6">ZTL and parking for each village</h2>
      <div class="overflow-x-auto rounded-2xl border border-slate-200">
        <table class="w-full text-xs sm:text-sm">
          <thead>
            <tr class="bg-slate-900 text-white">
              <th class="text-left px-2 py-2 sm:px-4 sm:py-3 font-semibold text-xs sm:text-sm">Village</th>
              <th class="text-left px-2 py-2 sm:px-4 sm:py-3 font-semibold text-xs sm:text-sm">ZTL</th>
              <th class="hidden sm:table-cell px-4 py-3 font-semibold text-sm">Period</th>
              <th class="hidden sm:table-cell px-4 py-3 font-semibold text-sm">Advice</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100">
            {ztlData.map(r => (
              <tr class="hover:bg-slate-50 transition-colors">
                <td class="px-2 py-2 sm:px-4 sm:py-3 font-semibold text-charcoal text-xs sm:text-sm">{r.location}</td>
                <td class="px-2 py-2 sm:px-4 sm:py-3">
                  {r.ztl === 'Yes'
                    ? <span class="text-[10px] bg-red-50 text-red-600 px-2 py-0.5 rounded-full font-medium">Yes</span>
                    : <span class="text-[10px] bg-med-blue/5 text-med-blue px-2 py-0.5 rounded-full font-medium">No</span>
                  }
                </td>
                <td class="hidden sm:table-cell px-4 py-3 text-slate-500 text-sm">{r.period}</td>
                <td class="hidden sm:table-cell px-4 py-3 text-slate-600 text-sm">{r.note}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section class="bg-white">
      <h2 class="font-serif text-2xl font-semibold text-slate-900 mb-6">The 3 best strategies</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4 sm:gap-6">
        {[
          { title: 'Base in Salerno', desc: 'Free or low-cost parking in Salerno (Piazza della Concordia, ~€5/day). Then Travelmar ferry to Amalfi, Positano and Capri. Ideal from April to October.', badge: 'Budget-friendly' },
          { title: 'Base in Sorrento', desc: 'Garage Achille Lauro or EAV car park (~€2–3/h, ~€15/day). From Sorrento: hydrofoil to Capri (25 min), SITA bus to Positano (50 min), Circumvesuviana to Naples (70 min).', badge: 'Versatile' },
          { title: 'Base in Praiano', desc: 'Praiano has no ZTL and has available parking. Great central position on the SS163: 15 min from Positano and 25 min from Amalfi by bus. Fewer amenities but great value.', badge: 'Central' },
        ].map(s => (
          <div class="bg-med-cream rounded-[2rem] p-5 sm:p-6 border border-slate-100">
            <span class="text-[10px] uppercase tracking-wide bg-med-blue/5 text-med-blue px-2 py-1 rounded-full font-medium">{s.badge}</span>
            <h3 class="font-semibold text-charcoal text-sm mt-2 sm:mt-3 mb-2">{s.title}</h3>
            <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">{s.desc}</p>
          </div>
        ))}
      </div>
    </section>

    <section id="faq">
      <h2 class="font-serif text-2xl font-semibold text-slate-900 mb-6">Frequently asked questions</h2>
      <div class="space-y-4">
        {faqSchema.mainEntity.map((q) => (
          <details class="group border border-slate-200 rounded-2xl overflow-hidden">
            <summary class="flex items-center justify-between px-6 py-4 cursor-pointer select-none text-charcoal font-medium hover:bg-slate-50 transition-colors">
              {q.name}
              <svg class="w-4 h-4 text-slate-400 group-open:rotate-180 transition-transform flex-shrink-0 ml-3" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
            </summary>
            <div class="px-6 pb-5 text-slate-600 leading-relaxed text-xs sm:text-sm border-t border-slate-100 pt-4">
              {q.acceptedAnswer.text}
            </div>
          </details>
        ))}
      </div>
    </section>

    <!-- EVERYTHING YOU NEED -->
    <section class="py-16 bg-white">
      <div class="max-w-editorial mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-12">
          <h2 class="font-serif text-2xl font-semibold text-slate-900 mb-6">Everything you need</h2>
          <div class="w-20 h-1 bg-med-gold mx-auto rounded-full"></div>
        </div>

        <!-- MOBILE: Swiper slider -->
        <div class="swiper swiper-guides md:hidden">
          <div class="swiper-wrapper pb-12">
            <div class="swiper-slide">
              <a href="/en-us/guide/ferries/" class="block bg-slate-900 rounded-[2rem] p-6 border-0 hover:shadow-lg transition-all duration-300 h-full">
                <h3 class="font-serif text-xl font-bold text-med-gold mb-2">Ferries & Hydrofoils</h3>
                <p class="text-white text-sm mb-3">How to reach the coast by sea</p>
                <p class="text-white/70 text-xs leading-relaxed mb-4">Schedules, fares and main routes from Naples and Salerno</p>
                <span class="text-med-gold font-semibold text-sm">Read the guide →</span>
              </a>
            </div>
            <div class="swiper-slide">
              <a href="/en-us/guide/sita-bus/" class="block bg-slate-900 rounded-[2rem] p-6 border-0 hover:shadow-lg transition-all duration-300 h-full">
                <h3 class="font-serif text-xl font-bold text-med-gold mb-2">SITA Bus</h3>
                <p class="text-white text-sm mb-3">Schedules, fares and main routes</p>
                <p class="text-white/70 text-xs leading-relaxed mb-4">Moving along the coast by bus: all lines and stops</p>
                <span class="text-med-gold font-semibold text-sm">Read →</span>
              </a>
            </div>
            <div class="swiper-slide">
              <a href="/en-us/when-to-visit/" class="block bg-slate-900 rounded-[2rem] p-6 border-0 hover:shadow-lg transition-all duration-300 h-full">
                <h3 class="font-serif text-xl font-bold text-med-gold mb-2">When to Visit</h3>
                <p class="text-white text-sm mb-3">Month by month: weather and crowds</p>
                <p class="text-white/70 text-xs leading-relaxed mb-4">Choose the best time for your visit</p>
                <span class="text-med-gold font-semibold text-sm">Read →</span>
              </a>
            </div>
          </div>
          <div class="swiper-pagination"></div>
        </div>

        <!-- DESKTOP: Grid 3 colonne -->
        <div class="hidden md:grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          <a href="/en-us/guide/ferries/" class="block bg-slate-900 rounded-[2rem] p-6 border-0 hover:shadow-lg transition-all duration-300">
            <h3 class="font-serif text-xl font-bold text-med-gold mb-2">Ferries & Hydrofoils</h3>
            <p class="text-white text-sm mb-3">How to reach the coast by sea</p>
            <p class="text-white/70 text-xs leading-relaxed mb-4">Schedules, fares and main routes from Naples and Salerno</p>
            <span class="text-med-gold font-semibold text-sm">Read the guide →</span>
          </a>

          <a href="/en-us/guide/sita-bus/" class="block bg-slate-900 rounded-[2rem] p-6 border-0 hover:shadow-lg transition-all duration-300">
            <h3 class="font-serif text-xl font-bold text-med-gold mb-2">SITA Bus</h3>
            <p class="text-white text-sm mb-3">Schedules, fares and main routes</p>
            <p class="text-white/70 text-xs leading-relaxed mb-4">Moving along the coast by bus: all lines and stops</p>
            <span class="text-med-gold font-semibold text-sm">Read →</span>
          </a>

          <a href="/en-us/when-to-visit/" class="block bg-slate-900 rounded-[2rem] p-6 border-0 hover:shadow-lg transition-all duration-300">
            <h3 class="font-serif text-xl font-bold text-med-gold mb-2">When to Visit</h3>
            <p class="text-white text-sm mb-3">Month by month: weather and crowds</p>
            <p class="text-white/70 text-xs leading-relaxed mb-4">Choose the best time for your visit</p>
            <span class="text-med-gold font-semibold text-sm">Read →</span>
          </a>
        </div>
      </div>
    </section>

    <!-- AUTHENTIC EXPERIENCES -->
    <section class="py-16 bg-white overflow-hidden">
      <div class="max-w-editorial mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex flex-col md:flex-row justify-between items-end mb-12 gap-6">
          <div class="max-w-2xl">
            <span class="text-med-gold font-bold uppercase tracking-[0.3em] text-xs mb-4 block">Experience the Coast</span>
            <h2 class="font-serif text-2xl font-semibold text-slate-900 mb-6">Authentic Experiences</h2>
            <p class="text-slate-600 text-lg">From traditional cuisine to lemon groves, discover the true soul of the Coast.</p>
          </div>
          <a href="/en-us/experiences/" class="group flex items-center gap-2 text-med-blue font-semibold hover:text-med-gold transition-colors">
            All Experiences
            <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
          </a>
        </div>

        <!-- MOBILE: Swiper slider -->
        <div class="swiper swiper-experiences md:hidden">
          <div class="swiper-wrapper pb-12">
            <div class="swiper-slide">
              <a href="/en-us/experiences/cooking-class/" class="group block">
                <div class="relative aspect-[16/10] rounded-[2.5rem] overflow-hidden mb-6 shadow-lg">
                  <img
                    src="/images/cooking-class-hero.webp"
                    alt="Cooking Class"
                    class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
                    loading="lazy"
                    decoding="async"
                  />
                  <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent" />
                  <div class="absolute bottom-6 left-6">
                    <h3 class="text-2xl font-serif font-bold text-white">Cooking Class</h3>
                  </div>
                </div>
              </a>
            </div>
            <div class="swiper-slide">
              <a href="/en-us/experiences/limoncello-tour/" class="group block">
                <div class="relative aspect-[16/10] rounded-[2.5rem] overflow-hidden mb-6 shadow-lg">
                  <img
                    src="/images/limoncello-mercato-hero.webp"
                    alt="Limoncello Tour"
                    class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
                    loading="lazy"
                    decoding="async"
                  />
                  <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent" />
                  <div class="absolute bottom-6 left-6">
                    <h3 class="text-2xl font-serif font-bold text-white">Limoncello Tour</h3>
                  </div>
                </div>
              </a>
            </div>
            <div class="swiper-slide">
              <a href="/en-us/experiences/mozzarella-experience/" class="group block">
                <div class="relative aspect-[16/10] rounded-[2.5rem] overflow-hidden mb-6 shadow-lg">
                  <img
                    src="/images/mozzarella-provolone-hero.webp"
                    alt="Mozzarella Experience"
                    class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
                    loading="lazy"
                    decoding="async"
                  />
                  <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent" />
                  <div class="absolute bottom-6 left-6">
                    <h3 class="text-2xl font-serif font-bold text-white">Mozzarella Experience</h3>
                  </div>
                </div>
              </a>
            </div>
            <div class="swiper-slide">
              <a href="/en-us/experiences/starred-restaurants/" class="group block">
                <div class="relative aspect-[16/10] rounded-[2.5rem] overflow-hidden mb-6 shadow-lg">
                  <img
                    src="/images/ravello-hero.webp"
                    alt="Michelin Star Restaurants"
                    class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
                    loading="lazy"
                    decoding="async"
                  />
                  <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent" />
                  <div class="absolute bottom-6 left-6">
                    <h3 class="text-2xl font-serif font-bold text-white">Michelin Star Restaurants</h3>
                  </div>
                </div>
              </a>
            </div>
          </div>
          <div class="swiper-pagination"></div>
        </div>

        <!-- DESKTOP: Grid -->
        <div class="hidden md:grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
          <a href="/en-us/experiences/cooking-class/" class="group block">
            <div class="relative aspect-[16/10] rounded-[2.5rem] overflow-hidden mb-6 shadow-lg">
              <img
                src="/images/cooking-class-hero.webp"
                alt="Cooking Class"
                class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
                loading="lazy"
                decoding="async"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent" />
              <div class="absolute bottom-6 left-6">
                <h3 class="text-2xl font-serif font-bold text-white">Cooking Class</h3>
              </div>
            </div>
          </a>

          <a href="/en-us/experiences/limoncello-tour/" class="group block">
            <div class="relative aspect-[16/10] rounded-[2.5rem] overflow-hidden mb-6 shadow-lg">
              <img
                src="/images/limoncello-mercato-hero.webp"
                alt="Limoncello Tour"
                class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
                loading="lazy"
                decoding="async"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent" />
              <div class="absolute bottom-6 left-6">
                <h3 class="text-2xl font-serif font-bold text-white">Limoncello Tour</h3>
              </div>
            </div>
          </a>

          <a href="/en-us/experiences/mozzarella-experience/" class="group block">
            <div class="relative aspect-[16/10] rounded-[2.5rem] overflow-hidden mb-6 shadow-lg">
              <img
                src="/images/mozzarella-provolone-hero.webp"
                alt="Mozzarella Experience"
                class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
                loading="lazy"
                decoding="async"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent" />
              <div class="absolute bottom-6 left-6">
                <h3 class="text-2xl font-serif font-bold text-white">Mozzarella Experience</h3>
              </div>
            </div>
          </a>

          <a href="/en-us/experiences/starred-restaurants/" class="group block">
            <div class="relative aspect-[16/10] rounded-[2.5rem] overflow-hidden mb-6 shadow-lg">
              <img
                src="/images/ravello-hero.webp"
                alt="Michelin Star Restaurants"
                class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
                loading="lazy"
                decoding="async"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent" />
              <div class="absolute bottom-6 left-6">
                <h3 class="text-2xl font-serif font-bold text-white">Michelin Star Restaurants</h3>
              </div>
            </div>
          </a>
        </div>
      </div>
    </section>

  </div>

<script>
  import Swiper from 'swiper';
  import { Pagination } from 'swiper/modules';

  // Guides slider
  new Swiper('.swiper-guides', {
    modules: [Pagination],
    slidesPerView: 1.2,
    spaceBetween: 16,
    pagination: { el: '.swiper-guides .swiper-pagination', clickable: true },
  });
</script>

<style is:global>
  @import 'swiper/css';
  @import 'swiper/css/pagination';

  :root {
    --swiper-pagination-color: #D4AF37;
  }

  .swiper-pagination-bullet {
    background-color: var(--swiper-pagination-color);
    opacity: 0.5;
  }

  .swiper-pagination-bullet-active {
    opacity: 1;
  }

  /* Hide sliders on desktop */
  @media (min-width: 768px) {
    .swiper {
      display: none !important;
    }
  }
</style>

</BaseLayout>
