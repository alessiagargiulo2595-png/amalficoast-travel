---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../../components/Breadcrumbs.astro';

const lang = 'en-us';

const breadcrumbs = [
  { name: 'Home', url: '/en-us/' },
  { name: 'Planning', url: '/en-us/planning/' },
  { name: 'Home', url: '/en-us/guide/sita-bus/' },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "How does the SITA bus work on the Amalfi Coast?",
      "acceptedAnswer": { "@type": "Answer", "text": "The SITA bus (now SITA Sud, operated by EAV) runs along the SS163 between Sorrento and Salerno, stopping at Positano, Praiano, Amalfi, Maiori and Minori. Tickets must be purchased before boarding at a tobacconist or newsagent - they are not sold on the bus. Cost: ~€2.50–4 per journey." }
    },
    {
      "@type": "Question",
      "name": "How long does the bus take from Sorrento to Amalfi?",
      "acceptedAnswer": { "@type": "Answer", "text": "In normal conditions: 90–100 min. In summer (July–August) it can stretch to 2–2.5 hours due to traffic on the SS163. The Amalfi–Positano leg is about 45–50 min; Amalfi–Ravello ~25 min (different bus, SITA to Ravello)." }
    },
    {
      "@type": "Question",
      "name": "Can I bring large luggage on the SITA bus?",
      "acceptedAnswer": { "@type": "Answer", "text": "SITA buses on the SS163 are small (they need to navigate the tight bends). In summer they are packed. Large suitcases are difficult to manage: use a compact wheeled bag or backpack. Trolleys can go in the front luggage area if available." }
    }
  ]
};
---

<BaseLayout
  title="SITA Bus Amalfi Coast 2026 | Sorrento–Positano–Amalfi Timetable"
  description="How to use the Sorrento to Amalfi coast bus SITA: Sorrento–Positano–Amalfi–Salerno route along the SS163. Schedules, prices, where to buy tickets and practical tips."
  lang={lang}
  breadcrumbs={breadcrumbs}
  schema={[faqSchema]}
 pageKey="sita-bus">

  <section class="relative h-[75vh] sm:h-[90vh] flex items-center bg-charcoal overflow-hidden">
    <img src="/images/bus-sita-hero.jpg" alt="SITA bus on the coastal road" class="absolute inset-0 w-full h-full object-cover" loading="eager" referrerpolicy="no-referrer"/>
    <div class="absolute inset-0 bg-gradient-to-b from-black/25 via-black/40 to-black/75"></div>
    <div class="relative z-10 max-w-7xl mx-auto px-6 py-20">
      <div class="max-w-3xl">
        <p class="text-med-gold text-xs sm:text-sm font-medium uppercase tracking-[0.3em] mb-3">Travel Guide</p>
        <h1 class="font-serif text-display text-white mb-4">SITA Bus - SS163</h1>
        <p class="text-xl text-white/80 leading-relaxed">
          The most used (and slowest) transport on the Coast: the SITA bus runs along the SS163 between Sorrento and Salerno, stopping at every village. Cheap, scenic, often crowded. Here's everything you need to know.
        </p>
      </div>
    </div>
    <Breadcrumbs breadcrumbs={breadcrumbs} />
  </section>

  <div class="max-w-editorial mx-auto px-4 sm:px-6 lg:px-8 py-16 space-y-16">

    <section class="max-w-editorial">
      <p class="text-xl leading-relaxed text-charcoal text-justify">
        The <strong>Sorrento to Amalfi Coast bus</strong> - the SS163 Amalfitana is one of the most spectacular and challenging roads in Europe: 40 km of bends, tunnels and viaducts between Vietri sul Mare and Positano. The SITA bus runs it daily, year-round, with extra services in summer.
      </p>
      <p class="mt-4 text-slate-600 leading-relaxed text-justify">
        Tickets are not sold on the bus - buy them in advance at a tobacconist, newsagent or bar displaying the SITA/EAV sign. Without a ticket, the driver won't let you on. In summer, buses fill up fast: consider leaving early in the morning.
      </p>
    </section>

    <section class="bg-slate-900 border-l-4 border-med-gold p-6 rounded-lg mb-8">
      <h3 class="font-semibold text-white mb-4 flex items-center gap-2">
        <svg class="w-5 h-5 text-med-gold" fill="currentColor" viewBox="0 0 20 20"><path d="M8 16.5a1.5 1.5 0 11-3 0 1.5 1.5 0 013 0zM15 16.5a1.5 1.5 0 11-3 0 1.5 1.5 0 013 0z"/><path d="M3 4a1 1 0 00-1 1v10a1 1 0 001 1h1.05a2.5 2.5 0 014.9 0H10a1 1 0 001-1V5a1 1 0 00-1-1H3zM14 7a1 1 0 00-1 1v6.05A2.5 2.5 0 0115.95 16H17a1 1 0 001-1v-5a1 1 0 00-.293-.707l-2-2A1 1 0 0015 7h-1z"/></svg>
        Schedules updated April 1, 2026
      </h3>
      <p class="text-xs sm:text-sm text-white/80 mb-4">
        Check the official SITA/EAV updated PDF schedules:
      </p>
      <div class="flex flex-col sm:grid sm:grid-cols-2 gap-3">
        <a href="/pdf/orari-sita-5120-5110-5070.pdf" download class="inline-flex items-center justify-center gap-2 text-xs sm:text-sm font-medium text-med-gold underline hover:opacity-80 bg-slate-800 px-3 py-1.5 sm:px-4 sm:py-2 rounded border border-slate-700 hover:border-med-gold transition-all">
          <svg class="w-4 h-4 text-med-gold" fill="currentColor" viewBox="0 0 20 20"><path d="M8 16.5a1.5 1.5 0 11-3 0 1.5 1.5 0 013 0zM15 16.5a1.5 1.5 0 11-3 0 1.5 1.5 0 013 0z"/><path d="M3 4a1 1 0 00-1 1v10a1 1 0 001 1h1.05a2.5 2.5 0 014.9 0H10a1 1 0 001-1V5a1 1 0 00-1-1H3zM14 7a1 1 0 00-1 1v6.05A2.5 2.5 0 0115.95 16H17a1 1 0 001-1v-5a1 1 0 00-.293-.707l-2-2A1 1 0 0015 7h-1z"/></svg>
          Line 5120-5110-5070 (Amalfi - Positano - Sorrento)
        </a>
        <a href="/pdf/orari-sita-5080.pdf" download class="inline-flex items-center justify-center gap-2 text-xs sm:text-sm font-medium text-med-gold underline hover:opacity-80 bg-slate-800 px-3 py-1.5 sm:px-4 sm:py-2 rounded border border-slate-700 hover:border-med-gold transition-all">
          <svg class="w-4 h-4 text-med-gold" fill="currentColor" viewBox="0 0 20 20"><path d="M8 16.5a1.5 1.5 0 11-3 0 1.5 1.5 0 013 0zM15 16.5a1.5 1.5 0 11-3 0 1.5 1.5 0 013 0z"/><path d="M3 4a1 1 0 00-1 1v10a1 1 0 001 1h1.05a2.5 2.5 0 014.9 0H10a1 1 0 001-1V5a1 1 0 00-1-1H3zM14 7a1 1 0 00-1 1v6.05A2.5 2.5 0 0115.95 16H17a1 1 0 001-1v-5a1 1 0 00-.293-.707l-2-2A1 1 0 0015 7h-1z"/></svg>
          Line 5080 (Amalfi - Agerola - Castellammare - Naples)
        </a>
        <a href="/pdf/orari-sita-5070.pdf" download class="inline-flex items-center justify-center gap-2 text-xs sm:text-sm font-medium text-med-gold underline hover:opacity-80 bg-slate-800 px-3 py-1.5 sm:px-4 sm:py-2 rounded border border-slate-700 hover:border-med-gold transition-all">
          <svg class="w-4 h-4 text-med-gold" fill="currentColor" viewBox="0 0 20 20"><path d="M8 16.5a1.5 1.5 0 11-3 0 1.5 1.5 0 013 0zM15 16.5a1.5 1.5 0 11-3 0 1.5 1.5 0 013 0z"/><path d="M3 4a1 1 0 00-1 1v10a1 1 0 001 1h1.05a2.5 2.5 0 014.9 0H10a1 1 0 001-1V5a1 1 0 00-1-1H3zM14 7a1 1 0 00-1 1v6.05A2.5 2.5 0 0115.95 16H17a1 1 0 001-1v-5a1 1 0 00-.293-.707l-2-2A1 1 0 0015 7h-1z"/></svg>
          Line 5070 (Amalfi - Positano - Sorrento - Massa Lubrense)
        </a>
        <a href="/pdf/orari-sita-5020.pdf" download class="inline-flex items-center justify-center gap-2 text-xs sm:text-sm font-medium text-med-gold underline hover:opacity-80 bg-slate-800 px-3 py-1.5 sm:px-4 sm:py-2 rounded border border-slate-700 hover:border-med-gold transition-all">
          <svg class="w-4 h-4 text-med-gold" fill="currentColor" viewBox="0 0 20 20"><path d="M8 16.5a1.5 1.5 0 11-3 0 1.5 1.5 0 013 0zM15 16.5a1.5 1.5 0 11-3 0 1.5 1.5 0 013 0z"/><path d="M3 4a1 1 0 00-1 1v10a1 1 0 001 1h1.05a2.5 2.5 0 014.9 0H10a1 1 0 001-1V5a1 1 0 00-1-1H3zM14 7a1 1 0 00-1 1v6.05A2.5 2.5 0 0115.95 16H17a1 1 0 001-1v-5a1 1 0 00-.293-.707l-2-2A1 1 0 0015 7h-1z"/></svg>
          Line 5020 (Salerno - Amalfi - Ravello)
        </a>
      </div>
    </section>

    <section>
      <h2 class="font-serif text-2xl font-semibold text-white bg-slate-900 px-6 py-4 rounded-t-2xl mb-6">Main timetables (indicative)</h2>
      <div class="grid grid-cols-1 grid-cols-1 md:grid-cols-2 gap-6">
        <div class="overflow-x-auto rounded-2xl border border-slate-200">
          <table class="w-full text-xs sm:text-sm">
            <caption class="text-left text-xs text-white px-2 py-2 sm:px-4 sm:py-2 bg-slate-900 rounded-t-2xl border-b border-med-gold font-medium">Sorrento → Amalfi (via Positano, Praiano)</caption>
            <thead>
              <tr class="bg-slate-900 text-white">
                <th class="text-left px-2 py-2 sm:px-4 sm:py-3 font-semibold">Sorrento</th>
                <th class="text-left px-2 py-2 sm:px-4 sm:py-3 font-semibold">Positano</th>
                <th class="text-left px-2 py-2 sm:px-4 sm:py-3 font-semibold">Amalfi</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
              {[
                ['07:50', '08:05', '09:15'],
                ['08:00', '08:10', '09:25'],
                ['08:40', '08:55', '10:15'],
                ['09:45', '10:00', '11:10'],
                ['10:25', '10:40', '11:55'],
                ['11:10', '11:25', '12:40'],
                ['12:25', '12:40', '13:55'],
                ['14:40', '14:55', '16:10'],
                ['15:25', '15:40', '16:55'],
                ['17:45', '18:00', '19:15'],
              ].map(([s,p,a]) => (
                <tr class="hover:bg-slate-50 transition-colors">
                  <td class="px-2 py-1.5 sm:px-4 sm:py-2.5 font-mono">{s}</td>
                  <td class="px-2 py-1.5 sm:px-4 sm:py-2.5 font-mono">{p}</td>
                  <td class="px-2 py-1.5 sm:px-4 sm:py-2.5 font-mono">{a}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <div class="overflow-x-auto rounded-2xl border border-slate-200">
          <table class="w-full text-xs sm:text-sm">
            <caption class="text-left text-xs text-white px-2 py-2 sm:px-4 sm:py-2 bg-slate-900 rounded-t-2xl border-b border-med-gold font-medium">Amalfi → Sorrento (via Positano)</caption>
            <thead>
              <tr class="bg-slate-900 text-white">
                <th class="text-left px-2 py-2 sm:px-4 sm:py-3 font-semibold">Amalfi</th>
                <th class="text-left px-2 py-2 sm:px-4 sm:py-3 font-semibold">Positano</th>
                <th class="text-left px-2 py-2 sm:px-4 sm:py-3 font-semibold">Sorrento</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
              {[
                ['06:00', '06:40', '07:50'],
                ['06:45', '07:20', '08:30'],
                ['07:30', '08:05', '09:15'],
                ['08:00', '08:45', '10:00'],
                ['09:00', '09:35', '10:50'],
                ['10:00', '10:35', '11:50'],
                ['11:00', '11:35', '12:50'],
                ['13:00', '13:35', '14:50'],
                ['15:00', '15:35', '16:50'],
                ['17:00', '17:35', '18:50'],
                ['18:15', '18:50', '20:05'],
                ['19:45', '20:20', '21:35'],
              ].map(([a,p,s]) => (
                <tr class="hover:bg-slate-50 transition-colors">
                  <td class="px-2 py-1.5 sm:px-4 sm:py-2.5 font-mono">{a}</td>
                  <td class="px-2 py-1.5 sm:px-4 sm:py-2.5 font-mono">{p}</td>
                  <td class="px-2 py-1.5 sm:px-4 sm:py-2.5 font-mono">{s}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
      <p class="text-xs text-slate-400 mt-2">* Official schedule valid from April 1 to June 7, 2026 (Line 5120-5110-5070 SS163). Check sitasudtrasporti.it or eavsrl.it for seasonal changes and complete schedules.</p>
    </section>

    <section>
      <h2 class="font-serif text-2xl font-semibold text-slate-900 mb-6">Prices and how to buy tickets</h2>
      <div class="overflow-x-auto rounded-2xl border border-slate-200">
        <table class="w-full text-xs sm:text-sm">
          <thead>
            <tr class="bg-med-blue/5 text-charcoal">
              <th class="text-left px-2 py-2 sm:px-4 sm:py-3 font-semibold">Route</th>
              <th class="text-left px-2 py-2 sm:px-4 sm:py-3 font-semibold">Price</th>
              <th class="text-left px-2 py-2 sm:px-4 sm:py-3 font-semibold text-right sm:text-left">Duration</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100">
            {[
              ['Sorrento → Positano', '~€2.50', '~50 min'],
              ['Sorrento → Amalfi', '~€3.50', '~90 min'],
              ['Amalfi → Ravello (local bus)', '~€1.50', '~25 min'],
              ['Amalfi → Salerno (via SS163)', '~€2.80', '~60 min'],
              ['Day ticket (Amalfi Coast zone)', '~€7.50', 'Unlimited'],
            ].map(([t,p,d]) => (
              <tr class="hover:bg-slate-50 transition-colors">
                <td class="px-2 py-2 sm:px-4 sm:py-3">{t}</td>
                <td class="px-2 py-2 sm:px-4 sm:py-3 font-mono">{p}</td>
                <td class="px-2 py-2 sm:px-4 sm:py-3 text-slate-500 text-right sm:text-left">{d}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section class="bg-med-cream border border-med-gold/20 rounded-[2rem] p-8">
      <p class="font-semibold text-charcoal text-lg mb-3">Practical tips for the SITA bus</p>
      <ul class="space-y-2">
        {[
          'Buy your ticket BEFORE boarding: at a tobacconist, bar or newsagent. Not available on the bus.',
          'In summer the 9:00 bus from Sorrento to Positano is already full - take the 7:30 one or wait until 10:30.',
          'The bus stops at many points along the SS163: if you\'re unsure where to get off, ask the driver.',
          'The right side of the bus (coming from Sorrento) has the best sea views.',
          'Don\'t expect punctuality: traffic on the SS163 is unpredictable. Always allow 30 min buffer.',
        ].map(tip => (
          <li class="flex items-start gap-2 text-xs sm:text-sm text-charcoal">
            <span class="w-1.5 h-1.5 rounded-full bg-med-gold mt-1.5 flex-shrink-0"></span>
            <span>{tip}</span>
          </li>
        ))}
      </ul>
    </section>

    <section id="faq">
      <h2 class="font-serif text-2xl font-semibold text-slate-900 mb-6">Frequently asked questions</h2>
      <div class="space-y-4">
        {faqSchema.mainEntity.map((q) => (
          <details class="group border border-slate-200 rounded-2xl overflow-hidden">
            <summary class="flex items-center justify-between px-6 py-4 cursor-pointer select-none text-charcoal font-medium hover:bg-slate-50 transition-colors">
              {q.name}
              <svg class="w-4 h-4 text-slate-400 group-open:rotate-180 transition-transform flex-shrink-0 ml-3" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
            </summary>
            <div class="px-6 pb-5 text-slate-600 leading-relaxed text-xs sm:text-sm border-t border-slate-100 pt-4">
              {q.acceptedAnswer.text}
            </div>
          </details>
        ))}
      </div>
    </section>

    <!-- EVERYTHING YOU NEED -->
    <section class="py-16 bg-white">
      <div class="max-w-editorial mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-12">
          <h2 class="font-serif text-2xl font-semibold text-slate-900 mb-6">Everything you need</h2>
          <div class="w-20 h-1 bg-med-gold mx-auto rounded-full"></div>
        </div>

        <!-- MOBILE: Swiper slider -->
        <div class="swiper swiper-guides md:hidden">
          <div class="swiper-wrapper pb-12">
            <div class="swiper-slide">
              <a href="/en-us/guide/ferries/" class="block bg-slate-900 rounded-[2rem] p-6 border-0 hover:shadow-lg transition-all duration-300 h-full">
                <h3 class="font-serif text-xl font-bold text-med-gold mb-2">Ferries</h3>
                <p class="text-white text-sm mb-3">How to reach the coast by sea</p>
                <p class="text-white/70 text-xs leading-relaxed mb-4">Schedules, fares and main routes from Naples and Salerno</p>
                <span class="text-med-gold font-semibold text-sm">Read guide →</span>
              </a>
            </div>
            <div class="swiper-slide">
              <a href="/en-us/guide/sita-bus/" class="block bg-slate-900 rounded-[2rem] p-6 border-0 hover:shadow-lg transition-all duration-300 h-full">
                <h3 class="font-serif text-xl font-bold text-med-gold mb-2">SITA Bus</h3>
                <p class="text-white text-sm mb-3">Schedules, fares and main routes</p>
                <p class="text-white/70 text-xs leading-relaxed mb-4">How to get around the coast by bus: all lines and stops</p>
                <span class="text-med-gold font-semibold text-sm">Read →</span>
              </a>
            </div>
            <div class="swiper-slide">
              <a href="/en-us/guide/when-to-visit/" class="block bg-slate-900 rounded-[2rem] p-6 border-0 hover:shadow-lg transition-all duration-300 h-full">
                <h3 class="font-serif text-xl font-bold text-med-gold mb-2">When to Visit</h3>
                <p class="text-white text-sm mb-3">Month by month: weather and crowds</p>
                <p class="text-white/70 text-xs leading-relaxed mb-4">Choose the best time to visit</p>
                <span class="text-med-gold font-semibold text-sm">Read →</span>
              </a>
            </div>
          </div>
          <div class="swiper-pagination"></div>
        </div>

        <!-- DESKTOP: Grid 3 colonne -->
        <div class="hidden md:grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          <a href="/en-us/guide/ferries/" class="block bg-slate-900 rounded-[2rem] p-6 border-0 hover:shadow-lg transition-all duration-300">
            <h3 class="font-serif text-xl font-bold text-med-gold mb-2">Ferries</h3>
            <p class="text-white text-sm mb-3">How to reach the coast by sea</p>
            <p class="text-white/70 text-xs leading-relaxed mb-4">Schedules, fares and main routes from Naples and Salerno</p>
            <span class="text-med-gold font-semibold text-sm">Read guide →</span>
          </a>

          <a href="/en-us/guide/sita-bus/" class="block bg-slate-900 rounded-[2rem] p-6 border-0 hover:shadow-lg transition-all duration-300">
            <h3 class="font-serif text-xl font-bold text-med-gold mb-2">SITA Bus</h3>
            <p class="text-white text-sm mb-3">Schedules, fares and main routes</p>
            <p class="text-white/70 text-xs leading-relaxed mb-4">How to get around the coast by bus: all lines and stops</p>
            <span class="text-med-gold font-semibold text-sm">Read →</span>
          </a>

          <a href="/en-us/guide/when-to-visit/" class="block bg-slate-900 rounded-[2rem] p-6 border-0 hover:shadow-lg transition-all duration-300">
            <h3 class="font-serif text-xl font-bold text-med-gold mb-2">When to Visit</h3>
            <p class="text-white text-sm mb-3">Month by month: weather and crowds</p>
            <p class="text-white/70 text-xs leading-relaxed mb-4">Choose the best time to visit</p>
            <span class="text-med-gold font-semibold text-sm">Read →</span>
          </a>
        </div>
      </div>
    </section>

    <!-- AUTHENTIC EXPERIENCES -->
    <section class="py-16 bg-white overflow-hidden">
      <div class="max-w-editorial mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex flex-col md:flex-row justify-between items-end mb-12 gap-6">
          <div class="max-w-2xl">
            <span class="text-med-gold font-bold uppercase tracking-[0.3em] text-xs mb-4 block">Experience the Territory</span>
            <h2 class="font-serif text-2xl font-semibold text-slate-900 mb-6">Authentic Experiences</h2>
            <p class="text-slate-600 text-lg">From traditional cuisine to lemon grove tours, discover the true soul of the Coast.</p>
          </div>
          <a href="/en-us/experiences/" class="group flex items-center gap-2 text-med-blue font-semibold hover:text-med-gold transition-colors">
            All Experiences
            <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
          </a>
        </div>

        <!-- MOBILE: Swiper slider -->
        <div class="swiper swiper-experiences md:hidden">
          <div class="swiper-wrapper pb-12">
            <div class="swiper-slide">
              <a href="/en-us/experiences/cooking-class/" class="group block">
                <div class="relative aspect-[16/10] rounded-[2.5rem] overflow-hidden mb-6 shadow-lg">
                  <img
                    src="/images/cooking-class-hero.webp"
                    alt="Cooking Class"
                    class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
                    loading="lazy"
                    decoding="async"
                  />
                  <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent" />
                  <div class="absolute bottom-6 left-6">
                    <h3 class="text-2xl font-serif font-bold text-white">Cooking Class</h3>
                  </div>
                </div>
              </a>
            </div>
            <div class="swiper-slide">
              <a href="/en-us/experiences/limoncello-tour/" class="group block">
                <div class="relative aspect-[16/10] rounded-[2.5rem] overflow-hidden mb-6 shadow-lg">
                  <img
                    src="/images/limoncello-mercato-hero.webp"
                    alt="Limoncello Tour"
                    class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
                    loading="lazy"
                    decoding="async"
                  />
