  import { Pagination } from 'swiper/modules';

  const base = {
    modules: [Pagination],
    slidesPerView: 1.15,
    spaceBetween: 16,
    watchSlidesProgress: true,
    resistanceRatio: 0,
    touchReleaseOnEdges: true,
  };

  // Guides slider
  new Swiper('.swiper-guides', { ...base, pagination: { el: '.swiper-guides .swiper-pagination', clickable: true } });

  // Experiences slider
  new Swiper('.swiper-experiences', { ...base, pagination: { el: '.swiper-experiences .swiper-pagination', clickable: true } });
