---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../../components/Breadcrumbs.astro';

const lang = 'en-us';

const breadcrumbs = [
  { name: 'Home', url: '/en-us/' },
  { name: 'Planning', url: '/en-us/planning/' },
  { name: 'Home', url: '/en-us/guide/sita-bus/' },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "How does the SITA bus work on the Amalfi Coast?",
      "acceptedAnswer": { "@type": "Answer", "text": "The SITA bus (now SITA Sud, operated by EAV) runs along the SS163 between Sorrento and Salerno, stopping at Positano, Praiano, Amalfi, Maiori and Minori. Tickets must be purchased before boarding at a tobacconist or newsagent - they are not sold on the bus. Cost: about €2.50-4 per journey; fares were adjusted on 1 October 2026, so check the current price when you buy." }
    },
    {
      "@type": "Question",
      "name": "How long does the bus take from Sorrento to Amalfi?",
      "acceptedAnswer": { "@type": "Answer", "text": "The official timetable valid from 14 September 2026 allows 75 to 100 minutes, depending on the route variant. In summer (July-August) traffic on the SS163 can stretch it to 2-2.5 hours. Amalfi to Positano takes 40 minutes to the Sponda stop and 50 to Chiesa Nuova; Amalfi–Ravello ~25 min (different bus, SITA to Ravello)." }
    },
    {
      "@type": "Question",
      "name": "Can I bring large luggage on the SITA bus?",
      "acceptedAnswer": { "@type": "Answer", "text": "SITA buses on the SS163 are small (they need to navigate the tight bends). In summer they are packed. Large suitcases are difficult to manage: use a compact wheeled bag or backpack. Trolleys can go in the front luggage area if available." }
    },
    {
      "@type": "Question",
      "name": "What time are the first and last SITA buses between Sorrento and Amalfi?",
      "acceptedAnswer": { "@type": "Answer", "text": "With the timetable valid from 14 September 2026, the first bus from Sorrento to Amalfi leaves at 06:30 Monday to Saturday (08:30 on Sundays and holidays) and the last at 19:50 (19:15 on Sundays and holidays). From Amalfi to Sorrento the first bus leaves at 06:20 every day and the last at 21:30 (21:00 on Sundays and holidays). Check sitasudtrasporti.it before travelling, especially on holidays." }
    }
  ]
};

