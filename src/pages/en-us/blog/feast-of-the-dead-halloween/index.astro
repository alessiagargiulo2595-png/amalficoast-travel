const lang = 'en-us';
const post = {
  title: 'The Feast of the Dead, Halloween and the Hooded Brotherhoods',
  subtitle: 'What really happens on 1 and 2 November in Campania, why the sweet of the season is shaped like a coffin, and who the incappucciati of Sorrento are',
  category: 'DISCOVERIES',
  date: 'October 7, 2026',
  readTime: '10 min',
  image: '/images/misteri-venerdi-santo-hero.webp',
  imageAlt: "A Mystery of the Passion carried by hooded brothers in a Good Friday procession",
  path: '/en-us/blog/feast-of-the-dead-halloween/',
};

const metaTitle = 'Feast of the Dead in Campania: Torrone and Processions';
const metaDescription = 'On 1 and 2 November Campania still keeps its own feast of the dead, with the torrone dei morti sold in every pastry shop. Where Halloween fits, and who the hooded brotherhoods of Sorrento are.';

const breadcrumbs = [
  { name: 'Home', url: '/en-us/' },
  { name: 'Blog', url: '/en-us/blog/' },
  { name: 'The Feast of the Dead and Halloween', url: '/en-us/blog/feast-of-the-dead-halloween/' },
];

const quickInfo = [
  { label: 'All Saints', value: '1 November, a public holiday in Italy' },
  { label: 'All Souls', value: '2 November, not a holiday' },
  { label: 'The sweet', value: 'Torrone dei morti, soft, chocolate based' },
  { label: 'Local name', value: '\'O muollo, the soft one' },
  { label: 'On sale', value: 'Pastry shops from mid October' },
  { label: 'Halloween', value: 'Present, mostly for children' },
  { label: 'Brotherhoods', value: 'Santa Monica and della Morte, Sorrento' },
  { label: 'Processions', value: 'Good Friday, not November' },
];

const faq = [
  {
    q: 'What is the torrone dei morti?',
    a: 'A soft Neapolitan sweet eaten around 2 November. Unlike the hard Christmas nougat it is built on chocolate: a dark chocolate shell around a soft filling of white or milk chocolate and hazelnuts, cut into a block that is traditionally said to resemble a small coffin. Locally it is called \'o muollo, the soft one, or \'o murticiell.',
  },
  {
    q: 'Why is it eaten on 2 November?',
    a: 'Because of an old belief that the dead return on the night between 1 and 2 November to taste what their families have prepared. Sweets were left on graves to sweeten the passage to the next world, and the torrone is the surviving form of that offering. The association is far older than the modern pastry version.',
  },
  {
    q: 'Is 1 November a public holiday in Italy?',
    a: 'Yes. Ognissanti, All Saints, is a national holiday, so banks, offices and many shops close and transport runs to a holiday timetable. The following day, the Commemorazione dei defunti on 2 November, is not a holiday, although cemeteries are busy from early morning.',
  },
  {
    q: 'Do people celebrate Halloween on the Amalfi Coast?',
    a: 'Increasingly, yes, mostly as a children\'s party with costumes and decorated shop windows, and more so in the towns than in the villages. It has not displaced the older rite. For most families here 31 October is an evening out and 2 November is the day that matters.',
  },
  {
    q: 'Who are the incappucciati of Sorrento?',
    a: 'The hooded members of two lay brotherhoods: the Venerable Archconfraternity of Santa Monica, who wear white, and the Venerable Archconfraternity of the Morte, who wear black. The latter was founded in 1586 and carries on an older brotherhood of San Catello documented from 1380. The hood conceals the identity of the wearer, so the act of penance is anonymous.',
  },
  {
    q: 'When do the hooded processions take place?',
    a: 'On Good Friday, not in November. The White Procession of the Addolorata leaves the church of the Santissima Annunziata at three in the morning and returns at first light. The Black Procession of the Dead Christ sets off at half past eight in the evening. Both dates move each year with Easter.',
  },
];

const sidebarLinks = [
  { label: 'Sorrento', href: '/en-us/sorrento-peninsula/sorrento/' },
  { label: 'Procida', href: '/en-us/islands/procida/' },
  { label: 'Lemon Delight', href: '/en-us/blog/lemon-delight/' },
  { label: 'Amalfi', href: '/en-us/amalfi-coast/amalfi/' },
  { label: 'Cuoppo Fritto', href: '/en-us/blog/cuoppo-fritto/' },
];

const authorRole = 'Local Expert · Sorrento Peninsula';

const relatedArticles = [
  {
    title: 'Films Made in Sorrento: When Cinema Chooses the Peninsula',
    category: 'DISCOVERIES',
    date: 'June 30, 2026',
    image: '/images/film-fatti-a-sorrento-hero.webp',
    imageAlt: 'Films shot in Sorrento',
    path: '/en-us/blog/films-made-in-sorrento/'
  },
  {
    title: 'Christmas Lights in Sorrento and Salerno',
    category: 'GUIDES',
    date: 'October 21, 2026',
    image: '/images/luci-artista-salerno-hero.webp',
    imageAlt: 'Christmas lights in Sorrento and Salerno',
    path: '/en-us/blog/christmas-lights-sorrento-salerno/'
  }
];

const imageCredit = {
  author: 'Rossella Sorvillo / Wikimedia Commons',
  sourceUrl: 'https://commons.wikimedia.org/wiki/File:L%27antico_rito_dei_Misteri_del_Venerd%C3%AC_Santo.jpg',
  license: 'CC BY-SA 4.0',
  licenseUrl: 'https://creativecommons.org/licenses/by-sa/4.0/',
};

const keyTakeaways = [
  'In Campania the first days of November are the feast of the dead, built around cemetery visits on 2 November rather than around costumes on 31 October.',
  'The sweet of the season is the torrone dei morti, soft and chocolate based, descended from the offerings once left on graves to sweeten the passage of the dead.',
  'Halloween has arrived and is popular with children, but it sits alongside the older rite rather than replacing it.',
  'The hooded brotherhoods of Sorrento exist precisely because of the cult of the dead: they were founded to bury the poor and pray for souls.',
  'Their great public appearance is Good Friday, with the White Procession at three in the morning and the Black Procession in the evening, a tradition traced back to the fourteenth century.',
];
---

<BlogPostLayout
  lang={lang}
  post={post}
  metaTitle={metaTitle}
  metaDescription={metaDescription}
  breadcrumbs={breadcrumbs}
  quickInfo={quickInfo}
  faq={faq}
  sidebarLinks={sidebarLinks}
  authorRole={authorRole}
  relatedArticles={relatedArticles}
  imageCredit={imageCredit}
  pageKey="feast-of-the-dead-halloween"
>

  <!-- Key Takeaways -->
  <div class="bg-slate-900 text-white p-8 rounded-[2rem]">
    <div class="flex items-center gap-3 mb-6">
      <svg class="w-5 h-5 text-med-gold flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
      <h2 class="font-serif text-lg font-bold text-med-gold uppercase tracking-[0.15em]">Key Takeaways</h2>
    </div>
    <ul class="space-y-4">
      {keyTakeaways.map((point) => (
        <li class="flex items-start gap-3">
          <span class="w-1.5 h-1.5 rounded-full bg-med-gold flex-shrink-0 mt-2"></span>
          <span class="text-white/80 text-xs sm:text-sm leading-relaxed">{point}</span>
        </li>
      ))}
    </ul>
  </div>

  <!-- Intro -->
  <div>
    <p class="text-slate-600 text-xl leading-relaxed mb-6 font-light">
      Walk into a pastry shop in <a href="/en-us/sorrento-peninsula/sorrento/" class="text-med-blue hover:underline">Sorrento</a> in the second half of October and the window fills with dark chocolate blocks the size of a brick. Nobody calls them a seasonal product. They are the <em>torrone dei morti</em>, the torrone of the dead, and they belong to a set of beliefs about the first days of November that is still, quietly, the strongest thing in the local calendar. Halloween exists here too now. It has simply landed on top of something much older, and the two have made a sort of peace.
    </p>
  </div>

  <!-- 1 and 2 November -->
  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">What Actually Happens on 1 and 2 November</h2>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      The two days are different, and it is worth separating them. <strong>1 November, Ognissanti</strong>, All Saints, is a national public holiday: offices and banks shut, many shops close, and transport runs to a Sunday timetable. It is a family day, and on the coast it is often the last reasonably warm day anyone bothers to go out for.
    </p>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      <strong>2 November, the Commemorazione dei defunti</strong>, is not a holiday, and yet it is the one that carries the weight. From early morning the cemeteries fill: families clean graves, bring chrysanthemums, light candles, and the visit is made in person, not symbolically. In a region where almost everyone has relatives buried within a few kilometres of where they live, this is not an abstract observance.
    </p>
    <p class="text-slate-600 text-lg leading-relaxed mb-8">
      Underneath it runs an older idea, one the Church absorbed rather than invented: that on the night between the first and the second the dead come back to the houses they lived in, and taste what has been left out for them. Naples took that belief further than anywhere else in Italy, to the point of the Fontanelle ossuary and the practice of adopting an anonymous skull and praying for it. On the peninsula the version that survives is gentler and almost entirely edible.
    </p>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div class="bg-white p-6 rounded-[2rem] border border-slate-100 shadow-sm">
        <h4 class="font-bold text-slate-900 mb-2">What is open</h4>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">On 1 November expect holiday hours: shut banks and offices, reduced bus and train services, and restaurants either full or closed. On 2 November everything is normal apart from heavy traffic around the cemeteries in the morning.</p>
      </div>
      <div class="bg-white p-6 rounded-[2rem] border border-slate-100 shadow-sm">
        <h4 class="font-bold text-slate-900 mb-2">What travellers notice</h4>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Flowers everywhere, especially chrysanthemums, which in Italy are funeral flowers and are never given as a gift. Bringing a bunch to a dinner invitation in early November is the classic foreign mistake.</p>
      </div>
    </div>
  </div>

  <!-- Torrone -->
  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">Torrone dei Morti: the Sweet with a Name Nobody Softens</h2>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      This is not the hard white nougat of Christmas. The torrone dei morti is soft, which is why Naples calls it <em>'o muollo</em>, and it is built on chocolate rather than on honey and egg white. The standard version is a shell of dark chocolate around a soft filling of white or milk chocolate worked with a cream to keep it yielding, studded with hazelnuts and cut into a rectangular block.
    </p>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      The shape is the part people mention and then move past quickly: it is said to recall a small coffin, and the other local name, <em>'o murticiell</em>, the little dead one, does nothing to hide the connection. The origin is in the offerings once left on graves, slices of torrone among plates of food, placed there to sweeten the passage of the dead and to feed them on the night they come home.
    </p>

    <div class="overflow-x-auto rounded-[2rem] border border-slate-100 shadow-sm mb-6">
      <table class="w-full text-xs sm:text-sm">
        <thead class="bg-slate-900 text-white">
          <tr>
            <th class="text-left p-5 font-serif font-bold text-med-gold">Version</th>
            <th class="text-left p-5 font-serif font-bold text-med-gold">What is inside</th>
          </tr>
        </thead>
        <tbody class="bg-white">
          <tr class="border-b border-slate-100">
            <td class="p-5 font-bold">Classico</td>
            <td class="p-5 text-slate-600">Dark chocolate outside, soft chocolate and hazelnut inside. The one to try first, and the benchmark every pastry shop is judged on.</td>
          </tr>
          <tr class="border-b border-slate-100">
            <td class="p-5 font-bold">Caffè</td>
            <td class="p-5 text-slate-600">White chocolate base worked with coffee. Common across Campania and, in Naples, arguably more popular than the original.</td>
          </tr>
          <tr class="border-b border-slate-100">
            <td class="p-5 font-bold">Pistacchio and mandorla</td>
            <td class="p-5 text-slate-600">Pistachio or almond in place of hazelnut. Softer and sweeter, and the versions that sell to people who think they do not like torrone.</td>
          </tr>
          <tr>
            <td class="p-5 font-bold">Torroncini</td>
            <td class="p-5 text-slate-600">The same thing cut into single bites, sold loose by weight. The practical way to try four kinds without buying four bricks.</td>
          </tr>
        </tbody>
      </table>
    </div>

    <p class="text-slate-600 text-lg leading-relaxed">
      It appears in pastry shop windows from the middle of October and disappears within days of 2 November. Unlike the <a href="/en-us/blog/lemon-delight/" class="text-med-blue hover:underline">delizia al limone</a>, which you can order any day of the year, this one is genuinely tied to a fortnight, and every town on the peninsula has a pasticceria whose version the locals argue about.
    </p>
  </div>

  <!-- Halloween -->
  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">And Then Halloween Arrived</h2>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      Halloween reached Italy properly in the 1990s and settled in as a children's party: costumes, decorated shop windows, a disco night for teenagers, pumpkins in bar windows that have nothing to do with anything grown locally. In Sorrento and the larger towns you will find it on 31 October without looking. In the villages along the coast road you may not find it at all.
    </p>
    <p class="text-slate-600 text-lg leading-relaxed mb-8">
      The interesting part is how little conflict there has been. A culture that already believed the dead return for one night a year, and that commemorated them with a sweet shaped like a coffin, was never going to find a costume party shocking. The two simply sit next to each other, three days apart, and most families here do both without thinking about it.
    </p>

    <blockquote class="border-l-4 border-med-gold pl-6 my-8">
      <p class="text-slate-700 text-xl font-serif italic leading-relaxed">
        "Halloween asks children to pretend to be dead for an evening. Here the dead were always expected to come home anyway, and someone had left them something to eat."
      </p>
    </blockquote>
  </div>

  <!-- Confraternite -->
  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">The Hooded Brotherhoods of Sorrento</h2>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      Walk into any church on this coast and you will find a side chapel belonging to a <em>confraternita</em>: a lay brotherhood, not a religious order, made up of ordinary townspeople. Many were founded for an explicitly funerary purpose, to bury those who could not pay for a burial, to accompany the dying and to pray for souls. The cult of the dead described above is not folklore attached to these institutions. It is the reason they exist.
    </p>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      Sorrento has two that everyone knows, and once a year the whole town turns out for them. The <strong>Venerable Archconfraternity of Santa Monica</strong> wears white. The <strong>Venerable Archconfraternity of the Morte</strong> wears black; it was founded in 1586 and took over from a far older brotherhood of San Catello, recorded as early as 1380. Members process hooded, which is the point: the hood removes the man and leaves only the act.
    </p>

    <div class="bg-white p-8 rounded-[2rem] border border-slate-100 shadow-sm mb-6">
      <h3 class="font-serif text-xl font-bold text-slate-900 mb-5">The two processions of Good Friday</h3>
      <div class="space-y-3">
        <div class="flex items-start gap-3">
          <div class="w-6 h-6 rounded-full bg-med-gold/15 flex-shrink-0 flex items-center justify-center text-med-gold font-bold text-xs">1</div>
          <p class="text-slate-600 text-xs sm:text-sm leading-relaxed"><strong>The White Procession</strong>, of the Addolorata, leaves the church of the Santissima Annunziata at three in the morning and walks the streets of the old town until first light. It stages the Virgin searching the city for her son, and it is the one people set an alarm for.</p>
        </div>
        <div class="flex items-start gap-3">
          <div class="w-6 h-6 rounded-full bg-med-gold/15 flex-shrink-0 flex items-center justify-center text-med-gold font-bold text-xs">2</div>
          <p class="text-slate-600 text-xs sm:text-sm leading-relaxed"><strong>The Black Procession</strong>, of the Dead Christ, sets off at half past eight in the evening of the same day, with the black hoods, the funeral march and the body carried through the centre. The tradition behind both is traced to the fourteenth century.</p>
        </div>
      </div>
    </div>

    <p class="text-slate-600 text-lg leading-relaxed">
      It is worth being clear that these are Holy Week events, not November ones, so anyone coming for the feast of the dead will not see them. The gulf's other great hooded procession, the Misteri of <a href="/en-us/islands/procida/" class="text-med-blue hover:underline">Procida</a>, also takes place on Good Friday morning. If the ritual side of this coast is what interests you, Easter rather than Halloween is the trip to plan.
    </p>
  </div>

  <!-- Local Tips -->
  <div class="bg-white p-8 rounded-[2rem] shadow-xl border border-slate-100">
    <div class="flex items-center gap-4 mb-6">
      <svg class="w-6 h-6 text-med-gold flex-shrink-0" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M9 18h6"/><path d="M10 22h4"/><path d="M15.09 14c.18-.98.65-1.74 1.41-2.5A4.65 4.65 0 0 0 18 8 6 6 0 0 0 6 8c0 1 .23 2.23 1.5 3.5A4.61 4.61 0 0 1 8.91 14"/></svg>
      <h3 class="text-xl font-bold">Expert Tips</h3>
    </div>
    <div class="space-y-6">
      <div>
        <p class="font-bold text-slate-900 mb-1">Buy the torrone in the last week of October</p>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">It appears from mid October and the good pastry shops sell out of the better flavours in the final days. Ask for torroncini if you want to taste several, and ask for the <em>muollo</em> if someone offers you a choice: the hard version is a different sweet for a different season.</p>
      </div>
      <div>
        <p class="font-bold text-slate-900 mb-1">Plan around 1 November, not 2</p>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">The public holiday is the first, so it is the day when a closed museum or a holiday bus timetable will catch you out. If you are moving between towns, check the <a href="/en-us/guide/sita-bus/" class="text-med-blue hover:underline">SITA bus</a> timetable for the holiday version before you set off.</p>
      </div>
      <div>
        <p class="font-bold text-slate-900 mb-1">Treat the cemeteries as private</p>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">The hillside cemeteries of the peninsula are extraordinary places, and on 2 November they are full of families doing something personal. Visiting is fine; photographing people while they do it is not.</p>
      </div>
      <div>
        <p class="font-bold text-slate-900 mb-1">If you want the processions, come at Easter</p>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Good Friday in Sorrento means being on the street at three in the morning and again at half past eight at night. Book early, because this is one of the few dates outside summer when the town genuinely fills up, and keep flash and phone lights off while the brethren pass.</p>
      </div>
    </div>
  </div>

</BlogPostLayout>
