---
import BlogPostLayout from '../../../../layouts/BlogPostLayout.astro';

const lang = 'en-us';
const post = {
  title: 'Paris to the Amalfi Coast by Train',
  subtitle: 'The scheduled route via Milan and Naples, how long it actually takes, and the three night Orient-Express that now runs the same journey as a holiday',
  category: 'GUIDES',
  date: 'September 14, 2026',
  readTime: '11 min',
  image: '/images/frecciarossa-napoli-hero.webp',
  imageAlt: "Frecciarossa 1000 high speed trains at Napoli Centrale, the last change on the way from Paris",
  path: '/en-us/blog/paris-to-amalfi-coast-train/',
};

const metaTitle = 'Paris to the Amalfi Coast by Train: Routes and Times 2026';
const metaDescription = 'No direct train exists. Paris to Milan in about 7h, Milan to Naples in 4h30, then Sorrento or Salerno: roughly 13 to 14 hours in total. Plus the Venice Simplon-Orient-Express Paris to Amalfi Coast journey and what it costs.';

const breadcrumbs = [
  { name: 'Home', url: '/en-us/' },
  { name: 'Blog', url: '/en-us/blog/' },
  { name: 'Paris to the Amalfi Coast by Train', url: '/en-us/blog/paris-to-amalfi-coast-train/' },
];

const quickInfo = [
  { label: 'Direct train', value: 'None, the journey is three legs' },
  { label: 'Paris to Milan', value: 'About 7h, 2 round trips a day' },
  { label: 'Milan to Naples', value: 'About 4h30 by Frecciarossa' },
  { label: 'Naples to Sorrento', value: 'About 1h on the Circumvesuviana' },
  { label: 'Naples to Salerno', value: '35 min by high speed train' },
  { label: 'Total travel time', value: 'Roughly 13 to 14 hours' },
  { label: 'Best plan', value: 'Split over two days with one overnight' },
  { label: 'Luxury option', value: 'Orient-Express, 3 nights, from about €9,900' },
];

const faq = [
  {
    q: 'Is there a direct train from Paris to the Amalfi Coast?',
    a: 'No. No railway reaches Positano, Amalfi or Ravello at all, and there is no through service from Paris to southern Italy. The journey is made up of three legs: Paris to Milan, Milan to Naples, and then Naples to Sorrento or Salerno, which are the two rail gateways to the coast.',
  },
  {
    q: 'How long does Paris to the Amalfi Coast take by scheduled train?',
    a: 'Roughly 13 to 14 hours of actual travel, before you add connection margins. About 7 hours Paris to Milan, about 4 hours 30 Milan to Naples, then between 35 minutes and an hour for the last leg. Done in one day it is technically possible and genuinely unpleasant.',
  },
  {
    q: 'Is the Paris to Milan line running normally?',
    a: 'Yes. The route through the Maurienne valley was cut by a landslide in August 2023 and reopened on 31 March 2025, with both SNCF TGV Inoui and Trenitalia Frecciarossa back on it. Works in the Mont Cenis tunnel then suspended direct trains from 11 September to 9 October 2026, with the direct service resuming from 10 October 2026.',
  },
  {
    q: 'Should I aim for Sorrento or Salerno?',
    a: 'Salerno if you are heading for Amalfi, Positano, Ravello or Minori: it has the ferry terminal and the SITA buses along the coast road. Sorrento if you are staying on the Sorrentine Peninsula or want the ferry to Capri. Salerno is also faster to reach, because high speed trains stop there.',
  },
  {
    q: 'What is the Orient-Express Paris to Amalfi Coast journey?',
    a: 'A three night itinerary on the Venice Simplon-Orient-Express run by Belmond: one night on board crossing France and the Italian Riviera, a guided visit to Pompeii, and two nights at the Caruso hotel in Ravello. The inaugural departure left Paris on 4 May 2026 and sold out; further departures are scheduled for 2027, with prices starting around €9,900 per person.',
  },
  {
    q: 'Can I travel overnight instead of stopping in a hotel?',
    a: 'Not on a through train. The old Paris to Italy night service no longer runs, so the practical equivalent is a hotel night in Milan, Turin, Rome or Naples. Many travellers pick Rome, because it breaks the journey almost exactly in half and the onward leg to Naples takes little more than an hour.',
  },
];

const sidebarLinks = [
  { label: 'The Amalfi Coast by Train', href: '/en-us/blog/amalfi-coast-by-train/' },
  { label: 'Where to Fly Into', href: '/en-us/blog/where-to-fly-amalfi-coast/' },
  { label: 'Ferries', href: '/en-us/guide/ferries/' },
  { label: 'SITA Bus', href: '/en-us/guide/sita-bus/' },
  { label: 'Amalfi Coast', href: '/en-us/amalfi-coast/' },
];

const authorRole = 'Travel Specialist · Amalfi Coast';

const relatedArticles = [
  {
    title: 'The Amalfi Coast by Train',
    category: 'GUIDES',
    date: 'August 10, 2026',
    image: '/images/treno-costiera-hero.webp',
    imageAlt: 'The Amalfi Coast by train',
    path: '/en-us/blog/amalfi-coast-by-train/'
  },
  {
    title: 'Where to Fly Into for the Amalfi Coast',
    category: 'GUIDES',
    date: 'August 5, 2026',
    image: '/images/aeroporti-costiera-hero.webp',
    imageAlt: 'Airports for the Amalfi Coast',
    path: '/en-us/blog/where-to-fly-amalfi-coast/'
  }
];

const imageCredit = {
  author: 'philip.mallis / Wikimedia Commons',
  sourceUrl: 'https://commons.wikimedia.org/wiki/File:Trenitalia_Frecciarossa_ETR400_(Frecciarossa_1000)_trains_at_Napoli_Centrale_Railway_Station_in_Naples,_Italy.jpg',
  license: 'CC BY-SA 2.0',
  licenseUrl: 'https://creativecommons.org/licenses/by-sa/2.0/',
};

const keyTakeaways = [
  'There is no direct train. Paris to the Amalfi Coast is three legs, roughly 13 to 14 hours of travel, and it works far better split across two days.',
  'Paris Gare de Lyon to Milano Centrale takes about 7 hours, with two round trips a day operated by SNCF TGV Inoui and Trenitalia Frecciarossa.',
  'Milan to Naples is the easy part: about 4 hours 30 by Frecciarossa, with departures through the day.',
  'The rail gateways to the coast are Salerno and Sorrento. Neither Positano nor Amalfi has a station, and neither ever will.',
  'The Venice Simplon-Orient-Express now sells a Paris to Amalfi Coast journey, but it is a three night holiday ending at a hotel in Ravello, not a way of getting there.',
];
---

<BlogPostLayout
  lang={lang}
  post={post}
  metaTitle={metaTitle}
  metaDescription={metaDescription}
  breadcrumbs={breadcrumbs}
  quickInfo={quickInfo}
  faq={faq}
  sidebarLinks={sidebarLinks}
  authorRole={authorRole}
  relatedArticles={relatedArticles}
  imageCredit={imageCredit}
  pageKey="paris-to-amalfi-coast-train"
>

  <!-- Key Takeaways -->
  <div class="bg-slate-900 text-white p-8 rounded-[2rem]">
    <div class="flex items-center gap-3 mb-6">
      <svg class="w-5 h-5 text-med-gold flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
      <h2 class="font-serif text-lg font-bold text-med-gold uppercase tracking-[0.15em]">Key Takeaways</h2>
    </div>
    <ul class="space-y-4">
      {keyTakeaways.map((point) => (
        <li class="flex items-start gap-3">
          <span class="w-1.5 h-1.5 rounded-full bg-med-gold flex-shrink-0 mt-2"></span>
          <span class="text-white/80 text-xs sm:text-sm leading-relaxed">{point}</span>
        </li>
      ))}
    </ul>
  </div>

  <!-- Intro -->
  <div>
    <p class="text-slate-600 text-xl leading-relaxed mb-6 font-light">
      Two very different journeys now answer to the phrase "Paris to the Amalfi Coast by train". One is a sequence of ordinary high speed trains that gets you from Gare de Lyon to a hotel above the sea for the price of a flight, in about the time it takes to read a long novel. The other is a sleeper that costs as much as a small car and treats the trip itself as the holiday. Both are worth knowing about, and the practical details of the first are what most people actually need.
    </p>
  </div>

  <!-- The three legs -->
  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">The Scheduled Route: Three Legs</h2>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      Since no line reaches the coast villages, every rail journey from France ends at either <strong>Salerno</strong> or <strong>Sorrento</strong>, and the last stretch is a ferry, a bus or a car. The route below is the fastest reliable combination.
    </p>

    <div class="overflow-x-auto rounded-[2rem] border border-slate-100 shadow-sm">
      <table class="w-full text-xs sm:text-sm">
        <thead class="bg-slate-900 text-white">
          <tr>
            <th class="text-left p-5 font-serif font-bold text-med-gold">Leg</th>
            <th class="text-left p-5 font-serif font-bold text-med-gold">Service</th>
            <th class="text-left p-5 font-serif font-bold text-med-gold">Time</th>
          </tr>
        </thead>
        <tbody class="bg-white">
          <tr class="border-b border-slate-100">
            <td class="p-5 font-bold">Paris Gare de Lyon to Milano Centrale</td>
            <td class="p-5 text-slate-600">TGV Inoui or Frecciarossa, via Lyon, Chambéry, Modane and Turin. Two round trips a day.</td>
            <td class="p-5 text-slate-600">About 7h</td>
          </tr>
          <tr class="border-b border-slate-100">
            <td class="p-5 font-bold">Milano Centrale to Napoli Centrale</td>
            <td class="p-5 text-slate-600">Frecciarossa or Italo, frequent through the day, via Bologna, Florence and Rome.</td>
            <td class="p-5 text-slate-600">About 4h30</td>
          </tr>
          <tr class="border-b border-slate-100">
            <td class="p-5 font-bold">Napoli to Salerno</td>
            <td class="p-5 text-slate-600">High speed trains continue south; regional trains are slower but cheaper.</td>
            <td class="p-5 text-slate-600">35 min to 1h15</td>
          </tr>
          <tr>
            <td class="p-5 font-bold">Napoli to Sorrento</td>
            <td class="p-5 text-slate-600">Circumvesuviana or the Campania Express from Napoli Porta Nolana or Garibaldi.</td>
            <td class="p-5 text-slate-600">About 1h</td>
          </tr>
        </tbody>
      </table>
    </div>

    <p class="text-slate-600 text-lg leading-relaxed mt-6">
      Add the walk between platforms in Milan and Naples and you are looking at something between 13 and 15 hours door to door. What happens after Salerno or Sorrento is covered in detail in our guide to <a href="/en-us/blog/amalfi-coast-by-train/" class="text-med-blue hover:underline">the Amalfi Coast by train</a>.
    </p>
  </div>

  <!-- Via Switzerland -->
  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">The Swiss Alternative, and When You Need It</h2>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      The Alpine crossing between France and Italy is the fragile part of this journey. A landslide in the Maurienne valley severed the line at the end of August 2023 and it stayed shut for a year and a half, reopening on <strong>31 March 2025</strong>. Works in the Mont Cenis tunnel then suspended direct Paris to Milan trains again from <strong>11 September to 9 October 2026</strong>, with the direct service resuming from 10 October 2026.
    </p>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      Whenever that happens, the detour is through Switzerland: Paris to Basel by TGV Lyria in around three hours, then a EuroCity down through the Gotthard to Milan. It is longer, usually by two hours or so, but it is a pleasant ride and it keeps the whole trip on rails. Worth checking before you book even in a normal year, because this corridor goes down more often than most.
    </p>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div class="bg-white p-6 rounded-[2rem] border border-slate-100 shadow-sm">
        <h4 class="font-bold text-slate-900 mb-2">Book the French leg early</h4>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">With only two round trips a day on the direct Paris to Milan service, cheap fares disappear fast. Tickets usually open around four to six months ahead and the best prices go in the first weeks.</p>
      </div>
      <div class="bg-white p-6 rounded-[2rem] border border-slate-100 shadow-sm">
        <h4 class="font-bold text-slate-900 mb-2">Buy the Italian legs separately</h4>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">There is no single through ticket, so a missed connection is your problem, not the railway's. Leave a wide margin in Milan and treat Milan to Naples as a separate purchase.</p>
      </div>
    </div>
  </div>

  <!-- Where to break -->
  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">Where to Break the Journey</h2>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      Doing it in a single day means leaving Paris at dawn and reaching the coast after dark, which is a poor way to meet a place whose entire appeal is the view. One overnight changes the trip completely.
    </p>

    <div class="bg-white p-8 rounded-[2rem] border border-slate-100 shadow-sm">
      <h3 class="font-serif text-xl font-bold text-slate-900 mb-5">Three sensible places to stop</h3>
      <div class="space-y-3">
        <div class="flex items-start gap-3">
          <div class="w-6 h-6 rounded-full bg-med-gold/15 flex-shrink-0 flex items-center justify-center text-med-gold font-bold text-xs">1</div>
          <p class="text-slate-600 text-xs sm:text-sm leading-relaxed"><strong>Milan.</strong> The obvious one: you arrive in the early evening with hotels next to Centrale and leave the next morning with four and a half hours still to go. Simple, if not inspiring.</p>
        </div>
        <div class="flex items-start gap-3">
          <div class="w-6 h-6 rounded-full bg-med-gold/15 flex-shrink-0 flex items-center justify-center text-med-gold font-bold text-xs">2</div>
          <p class="text-slate-600 text-xs sm:text-sm leading-relaxed"><strong>Rome.</strong> The best compromise. It is around nine hours from Paris and leaves barely over an hour to Naples the next day, so you can reach the coast by lunchtime and still have an afternoon on arrival.</p>
        </div>
        <div class="flex items-start gap-3">
          <div class="w-6 h-6 rounded-full bg-med-gold/15 flex-shrink-0 flex items-center justify-center text-med-gold font-bold text-xs">3</div>
          <p class="text-slate-600 text-xs sm:text-sm leading-relaxed"><strong>Naples.</strong> Push all the way through and sleep near Centrale, then take the first boat or train out in the morning. It works, and it gives you an evening in Naples, which is no hardship.</p>
        </div>
      </div>
    </div>
  </div>

  <!-- Orient-Express -->
  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">The Orient-Express Version</h2>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      In 2026 Belmond put the <strong>Venice Simplon-Orient-Express</strong> on a new route from Paris to the Amalfi Coast, which is why the phrase started trending in the first place. It is not transport. It is a three night package: one night in a cabin on board as the train crosses France and traces the French and Italian Rivieras, a private guided visit to Pompeii, and then two nights at the Caruso, Belmond's hotel in an eleventh century palazzo above <a href="/en-us/amalfi-coast/ravello/" class="text-med-blue hover:underline">Ravello</a>.
    </p>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      The inaugural departure left Paris at 11:00 on 4 May 2026 and arrived at Pompeii on 7 May. It sold out, and further departures were scheduled for 2027, including a late April slot and a June run. Prices start around <strong>€9,900 per person</strong> based on two sharing a historic cabin, with meals, drinks, excursions and the final transfer to Naples included.
    </p>

    <blockquote class="border-l-4 border-med-gold pl-6 my-8">
      <p class="text-slate-700 text-xl font-serif italic leading-relaxed">
        "One of these journeys is a way of reaching the Amalfi Coast. The other is a reason to go."
      </p>
    </blockquote>

    <p class="text-slate-600 text-lg leading-relaxed">
      Worth being clear about what you are buying: the Orient-Express ends in Ravello and includes two hotel nights, so it replaces the first part of a holiday rather than a plane ticket. If the goal is simply to arrive without flying, the scheduled route above does the same thing for a tiny fraction of the cost.
    </p>
  </div>

  <!-- Local Tips -->
  <div class="bg-white p-8 rounded-[2rem] shadow-xl border border-slate-100">
    <div class="flex items-center gap-4 mb-6">
      <svg class="w-6 h-6 text-med-gold flex-shrink-0" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M9 18h6"/><path d="M10 22h4"/><path d="M15.09 14c.18-.98.65-1.74 1.41-2.5A4.65 4.65 0 0 0 18 8 6 6 0 0 0 6 8c0 1 .23 2.23 1.5 3.5A4.61 4.61 0 0 1 8.91 14"/></svg>
      <h3 class="text-xl font-bold">Expert Tips</h3>
    </div>
    <div class="space-y-6">
      <div>
        <p class="font-bold text-slate-900 mb-1">Decide Salerno or Sorrento before you buy anything</p>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">It changes the whole last day. Salerno gives you <a href="/en-us/guide/ferries/" class="text-med-blue hover:underline">ferries</a> to Amalfi and Positano and the <a href="/en-us/guide/sita-bus/" class="text-med-blue hover:underline">SITA bus</a> along the coast road. Sorrento gives you the peninsula and Capri. Booking the wrong one adds two hours of backtracking.</p>
      </div>
      <div>
        <p class="font-bold text-slate-900 mb-1">Do not plan to arrive after sunset</p>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Ferries stop in the late afternoon, the coast road is slow in the dark and most Positano addresses end in a staircase. Aim to be on the coast by mid afternoon, which from Paris realistically means sleeping somewhere in Italy first.</p>
      </div>
      <div>
        <p class="font-bold text-slate-900 mb-1">Travel light for the last leg</p>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">The Circumvesuviana to Sorrento is a commuter line with no luggage racks and often no seats. The Campania Express is the tourist version of the same route, with guaranteed seating and fewer stops, and it is worth the supplement at the end of a long day.</p>
      </div>
      <div>
        <p class="font-bold text-slate-900 mb-1">Compare it honestly with flying</p>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Paris to Naples by air is about two hours. The train wins on comfort, city centre to city centre convenience and emissions, and loses badly on time. Our guide on <a href="/en-us/blog/where-to-fly-amalfi-coast/" class="text-med-blue hover:underline">where to fly into</a> sets out the alternative.</p>
      </div>
    </div>
  </div>

</BlogPostLayout>
