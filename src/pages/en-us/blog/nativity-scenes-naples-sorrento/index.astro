---
import BlogPostLayout from '../../../../layouts/BlogPostLayout.astro';

const lang = 'en-us';
const post = {
  title: 'Nativity Scenes in Naples and Sorrento: A December Guide',
  subtitle: "Via San Gregorio Armeno, the presepi in Sorrento's churches and the living nativities of the Sorrento Peninsula, with the dates of the last edition",
  category: 'GUIDES',
  date: 'November 10, 2026',
  readTime: '11 min',
  image: '/images/presepe-natale-hero.webp',
  imageAlt: "Nativity scene with Mary, Joseph, the Christ Child, the ox, the donkey and sheep",
  path: '/en-us/blog/nativity-scenes-naples-sorrento/',
};

const metaTitle = 'Nativity Scenes Naples and Sorrento: December Guide';
const metaDescription = "Via San Gregorio Armeno in Naples and the living nativities of the Sorrento Peninsula: where they are held, last edition dates and times, and how to get there.";

const breadcrumbs = [
  { name: 'Home', url: '/en-us/' },
  { name: 'Blog', url: '/en-us/blog/' },
  { name: 'Nativity Scenes in Naples and Sorrento', url: '/en-us/blog/nativity-scenes-naples-sorrento/' },
];

const quickInfo = [
  { label: 'Naples', value: 'Via San Gregorio Armeno, open all year' },
  { label: 'Peak season', value: 'Late November to early January' },
  { label: 'From Sorrento', value: 'Circumvesuviana, about 1h to Naples' },
  { label: 'Sorrento (2025)', value: 'Living nativity in the old town, 28 to 30 Dec' },
  { label: 'Vico Equense (2025/26)', value: 'Fornacelle, 26 Dec to 6 Jan' },
  { label: 'Massa Lubrense (2025/26)', value: 'Monticchio, 27 Dec to 6 Jan' },
  { label: 'Entry', value: 'Free for the living nativities listed here' },
  { label: '2026 programmes', value: 'Published by each comune in December' },
];

const faq = [
  {
    q: 'When is the best time to visit Via San Gregorio Armeno?',
    a: 'The workshops are open all year, but the street is at its fullest from late November to early January. For space to look at the figures, go on a weekday morning. December weekends and the days around 8 December are the most crowded, and in 2025 the comune made the street one way for pedestrians on those days.',
  },
  {
    q: 'How do I get from Sorrento to San Gregorio Armeno?',
    a: 'Take the Circumvesuviana from Sorrento to Napoli Garibaldi, about an hour. From there take Metro Line 1 one stop to Duomo and walk up Via Duomo, or walk the whole way along Corso Umberto I and Via Duomo in roughly twenty five minutes. The street runs between Via dei Tribunali and Via San Biagio dei Librai.',
  },
  {
    q: 'How much do the figures cost?',
    a: 'It depends entirely on size, materials and the workshop. In a 2019 report shopkeepers on the street put a medium sized figure at twenty to thirty euros. Hand finished pieces with silk clothing from the established workshops cost considerably more. Treat these as indications and ask in the shop.',
  },
  {
    q: 'Where are the living nativities on the Sorrento Peninsula?',
    a: 'In the 2025/26 season there were three: in the doorways of Sorrento\'s old town (28 to 30 December), at Fornacelle above Vico Equense (from 26 December to 6 January) and in the monastery at Monticchio, a hamlet of Massa Lubrense (27 December to 6 January). Piano di Sorrento and Sant\'Agnello had static and animated nativities rather than living ones.',
  },
  {
    q: 'Are the 2026 dates already known?',
    a: 'Not yet, as of mid October 2026. The comuni and the parishes publish their Christmas programmes in late November or December. The dates in this guide are those of the 2025/26 edition, which give a reliable idea of the pattern: almost everything happens between 26 December and 6 January.',
  },
  {
    q: 'Do I have to pay to see the living nativities?',
    a: 'The Fornacelle nativity is free with voluntary donations welcome, and Sorrento\'s 2025 edition was listed among the town\'s free events. The Monticchio programme did not mention a ticket. Bring some cash for donations.',
  },
];

const sidebarLinks = [
  { label: 'Sorrento', href: '/en-us/sorrento-peninsula/sorrento/' },
  { label: 'Vico Equense', href: '/en-us/sorrento-peninsula/vico-equense/' },
  { label: 'Massa Lubrense', href: '/en-us/sorrento-peninsula/massa-lubrense/' },
  { label: 'Sant\'Agnello', href: '/en-us/sorrento-peninsula/sant-agnello/' },
  { label: 'Living Nativities on the Amalfi Coast', href: '/en-us/events/amalfi-coast/presepi-viventi-costiera/' },
  { label: "M'illumino d'Inverno", href: '/en-us/events/sorrento-peninsula/millumino-inverno-sorrento/' },
];

const authorRole = 'Local Expert · Amalfi Coast';

const relatedArticles = [
  {
    title: 'Christmas Lights in Sorrento and Salerno',
    category: 'GUIDES',
    date: 'October 21, 2026',
    image: '/images/luci-artista-salerno-hero.webp',
    imageAlt: 'Christmas lights in Sorrento and Salerno',
    path: '/en-us/blog/christmas-lights-sorrento-salerno/'
  },
  {
    title: 'The Amalfi Coast by Train',
    category: 'GUIDES',
    date: 'August 10, 2026',
    image: '/images/treno-costiera-hero.webp',
    imageAlt: 'The Amalfi Coast by train',
    path: '/en-us/blog/amalfi-coast-by-train/'
  }
];


const keyTakeaways = [
  'Via San Gregorio Armeno in Naples is the street of the nativity workshops: open all year, at its fullest from late November to early January, and an hour from Sorrento on the Circumvesuviana.',
  'In 2025 Naples made the street one way for pedestrians on December weekends and over the 8 December holiday, from 9:00 to 20:00. Weekday mornings are the time to go.',
  'On the Sorrento Peninsula the living nativities are concentrated between 26 December and 6 January: Sorrento\'s old town, Fornacelle above Vico Equense and the monastery at Monticchio in Massa Lubrense.',
  'The 2026 programmes are not out yet. Every date here comes from the 2025/26 edition and is marked as such.',
  'Living nativities on the Amalfi Coast side (Agerola, Albori, Pontone, Furore) are covered in a separate guide.',
];
---

<BlogPostLayout
  lang={lang}
  post={post}
  metaTitle={metaTitle}
  metaDescription={metaDescription}
  breadcrumbs={breadcrumbs}
  quickInfo={quickInfo}
  faq={faq}
  sidebarLinks={sidebarLinks}
  authorRole={authorRole}
  relatedArticles={relatedArticles}
  pageKey="nativity-scenes-naples-sorrento"
>

  <!-- Key Takeaways -->
  <div class="bg-slate-900 text-white p-8 rounded-[2rem]">
    <div class="flex items-center gap-3 mb-6">
      <svg class="w-5 h-5 text-med-gold flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
      <h2 class="font-serif text-lg font-bold text-med-gold uppercase tracking-[0.15em]">Key Takeaways</h2>
    </div>
    <ul class="space-y-4">
      {keyTakeaways.map((point) => (
        <li class="flex items-start gap-3">
          <span class="w-1.5 h-1.5 rounded-full bg-med-gold flex-shrink-0 mt-2"></span>
          <span class="text-white/80 text-xs sm:text-sm leading-relaxed">{point}</span>
        </li>
      ))}
    </ul>
  </div>

  <!-- Intro -->
  <div>
    <p class="text-slate-600 text-xl leading-relaxed mb-6 font-light">
      In the Naples area the presepe, the nativity scene, is taken seriously. Families build one at home every year, parishes compete over theirs, and in the days between Christmas and Epiphany whole neighbourhoods dress up as Bethlehem. For a December trip based in <a href="/en-us/sorrento-peninsula/sorrento/" class="text-med-blue hover:underline">Sorrento</a> this gives you two things to plan around: a day in Naples on the street where the figures are made, and the evenings when the villages of the peninsula stage their living nativities. The 2026 programmes are not published yet, so the dates below are those of the last edition, 2025/26, and are labelled that way.
    </p>
  </div>

  <!-- San Gregorio Armeno -->
  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">Via San Gregorio Armeno, Naples</h2>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      San Gregorio Armeno is a narrow pedestrian street of about 200 metres in the historic centre of Naples, a UNESCO World Heritage Site since 1995. It climbs from Via San Biagio dei Librai, the stretch of Spaccanapoli, up to Piazza San Gaetano and Via dei Tribunali. Both sides are lined with workshops that make and sell nativity figures, and in December the stock spills out onto the walls and doorways.
    </p>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      What you find is everything a presepe needs: the shepherds, the Holy Family and the Magi, but also the market traders, the tavern, the fishmonger, the baskets of bread and fruit, the running water and the lights. Alongside the traditional pieces, many shops make figures of footballers, politicians and celebrities of the year, which is the part most visitors photograph. Several workshops have been run by the same families for generations: the Capuano brothers have been working since 1840, and names such as Di Virgilio and Ferrigno are known for figures dressed in fabric, including San Leucio silk.
    </p>
    <p class="text-slate-600 text-lg leading-relaxed mb-8">
      Halfway along stands the church and monastery of San Gregorio Armeno, the complex that gives the street its name, with a Baroque interior and frescoes by Luca Giordano. The cloister opens in the mornings for a small ticket.
    </p>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-8">
      <div class="bg-white p-6 rounded-[2rem] border border-slate-100 shadow-sm">
        <h4 class="font-bold text-slate-900 mb-2">When to go</h4>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">The workshops are open all year. The high season runs from late November to early January. On weekdays shops generally keep hours of about 9:30 to 19:30, with longer days at weekends in December. Weekday mornings are the quietest.</p>
      </div>
      <div class="bg-white p-6 rounded-[2rem] border border-slate-100 shadow-sm">
        <h4 class="font-bold text-slate-900 mb-2">Crowds and the one way system</h4>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">In 2025 the comune made the street one way for pedestrians from 9:00 to 20:00 on 28 to 30 November, 5 to 8 December, 12 to 14 December and 19 to 22 December, and from 9:00 to 14:00 on 23 December. The direction changed halfway through the month. A new ordinance is issued every year.</p>
      </div>
      <div class="bg-white p-6 rounded-[2rem] border border-slate-100 shadow-sm">
        <h4 class="font-bold text-slate-900 mb-2">Prices</h4>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">There is no price list for the street. In a 2019 report shopkeepers quoted twenty to thirty euros for a medium sized figure. Small accessories cost less, and hand finished pieces from the established workshops cost a good deal more. Ask before you pick something up.</p>
      </div>
      <div class="bg-white p-6 rounded-[2rem] border border-slate-100 shadow-sm">
        <h4 class="font-bold text-slate-900 mb-2">Carrying them home</h4>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Terracotta figures are fragile. Ask for them to be wrapped properly and keep them in your hand luggage. Most workshops also sell online and ship, which is worth considering for larger pieces.</p>
      </div>
    </div>

    <h3 class="font-serif text-2xl font-bold text-slate-900 mb-4">Getting there from Sorrento</h3>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      In winter the train is the simplest way. The Circumvesuviana runs from Sorrento to Naples, stopping at Napoli Garibaldi, in the same complex as the main station.
    </p>
    <div class="overflow-x-auto rounded-[2rem] border border-slate-100 shadow-sm mb-6">
      <table class="w-full text-xs sm:text-sm">
        <thead class="bg-slate-900 text-white">
          <tr>
            <th class="text-left p-5 font-serif font-bold text-med-gold">Leg</th>
            <th class="text-left p-5 font-serif font-bold text-med-gold">How</th>
            <th class="text-left p-5 font-serif font-bold text-med-gold">Time</th>
          </tr>
        </thead>
        <tbody class="bg-white">
          <tr class="border-b border-slate-100">
            <td class="p-5 font-bold">Sorrento to Napoli Garibaldi</td>
            <td class="p-5 text-slate-600">Circumvesuviana, Naples line</td>
            <td class="p-5 text-slate-600">About 1h</td>
          </tr>
          <tr class="border-b border-slate-100">
            <td class="p-5 font-bold">Garibaldi to Duomo</td>
            <td class="p-5 text-slate-600">Metro Line 1, one stop</td>
            <td class="p-5 text-slate-600">A few minutes</td>
          </tr>
          <tr>
            <td class="p-5 font-bold">Duomo to San Gregorio Armeno</td>
            <td class="p-5 text-slate-600">On foot up Via Duomo, then left into Via San Biagio dei Librai or Via dei Tribunali</td>
            <td class="p-5 text-slate-600">About 10 min</td>
          </tr>
        </tbody>
      </table>
    </div>
    <p class="text-slate-600 text-lg leading-relaxed">
      If you prefer to walk straight from Garibaldi, Corso Umberto I and Via Duomo get you there in roughly twenty five minutes. Stamp regional tickets before boarding and keep bags in front of you on the Circumvesuviana, which is a commuter line. Our guide to <a href="/en-us/blog/amalfi-coast-by-train/" class="text-med-blue hover:underline">the Amalfi Coast by train</a> covers the line in more detail.
    </p>
  </div>

  <!-- Sorrento churches -->
  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">Sorrento: Presepi in the Old Town</h2>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      In Sorrento the nativity scenes are part of <a href="/en-us/events/sorrento-peninsula/millumino-inverno-sorrento/" class="text-med-blue hover:underline">M'illumino d'Inverno</a>, the winter programme that runs from late November to mid January. The churches and museums of the historic centre put out presepi, and a nativity competition, Il Presepe Oggi, has been held for more than forty years. These are the nativity events of the 2025/26 programme:
    </p>
    <ul class="space-y-3 mb-6">
      <li class="flex items-start gap-3"><span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span><span class="text-slate-700"><strong>Villa Fiorentino.</strong> The exhibition "Giuseppe Ercolano e i maestri del presepe", devoted to the Neapolitan nativity tradition, open until 18 January 2026.</span></li>
      <li class="flex items-start gap-3"><span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span><span class="text-slate-700"><strong>Il Presepe Oggi.</strong> The 46th edition of the town's nativity competition, with the awards ceremony on 18 January in the church of the Santissima Annunziata.</span></li>
      <li class="flex items-start gap-3"><span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span><span class="text-slate-700"><strong>Procession of the Christ Child.</strong> On 6 January at 19:30 from the church of the Carmine, with shepherds and bagpipe players.</span></li>
    </ul>
    <p class="text-slate-600 text-lg leading-relaxed">
      The centre is small and almost entirely on foot, so the churches can be seen in an afternoon between Piazza Tasso, the cathedral and Via San Cesareo. Church opening hours vary and are not always posted, so allow some flexibility.
    </p>
  </div>

  <!-- Living nativities -->
  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">Living Nativities on the Sorrento Peninsula</h2>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      A presepe vivente is a nativity played by real people: the Holy Family in a grotto, and around it the trades of an old village, with bakers, cobblers, spinners and tavern keepers at work. On the peninsula these are run by parishes and local associations and take place in the evening, between Christmas and Epiphany. The table lists those confirmed for the last edition.
    </p>

    <div class="overflow-x-auto rounded-[2rem] border border-slate-100 shadow-sm mb-8">
      <table class="w-full text-xs sm:text-sm">
        <thead class="bg-slate-900 text-white">
          <tr>
            <th class="text-left p-5 font-serif font-bold text-med-gold">Place</th>
            <th class="text-left p-5 font-serif font-bold text-med-gold">Where</th>
            <th class="text-left p-5 font-serif font-bold text-med-gold">2025/26 dates</th>
            <th class="text-left p-5 font-serif font-bold text-med-gold">Hours</th>
          </tr>
        </thead>
        <tbody class="bg-white">
          <tr class="border-b border-slate-100">
            <td class="p-5 font-bold">Sorrento</td>
            <td class="p-5 text-slate-600">Doorways and courtyards of the old town, starting from Piazza Tasso</td>
            <td class="p-5 text-slate-600">28, 29, 30 December</td>
            <td class="p-5 text-slate-600">17:30 to 20:30</td>
          </tr>
          <tr class="border-b border-slate-100">
            <td class="p-5 font-bold">Vico Equense</td>
            <td class="p-5 text-slate-600">Fornacelle, località Torricella</td>
            <td class="p-5 text-slate-600">26, 27, 28 December; 1, 2, 3, 5, 6 January</td>
            <td class="p-5 text-slate-600">18:00 to 21:00</td>
          </tr>
          <tr>
            <td class="p-5 font-bold">Massa Lubrense</td>
            <td class="p-5 text-slate-600">Monastery of the Santissimo Rosario, Monticchio</td>
            <td class="p-5 text-slate-600">27, 28 December; 1, 2, 4, 5, 6 January</td>
            <td class="p-5 text-slate-600">18:00 to 20:30</td>
          </tr>
        </tbody>
      </table>
    </div>

    <h3 class="font-serif text-2xl font-bold text-slate-900 mb-4">Sorrento: the nativity in the doorways</h3>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      The 2025 edition, called "Araprite 'e purtune, ce sta 'o presepio" ("open the doors, the nativity is here"), was organised by Officina Solidale as part of the Surriento Gentile programme. Instead of one stage, the scenes were set in 18 doorways and entrance halls of historic palazzi, each marked with a lantern. The route started from Piazza Tasso, where the info point handed out a QR code with the map. The previous edition, in 2024/25, had been staged in the gardens next to the cathedral with more than 250 performers, so the format can change from year to year.
    </p>

    <h3 class="font-serif text-2xl font-bold text-slate-900 mb-4">Vico Equense: Fornacelle</h3>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      Fornacelle is a hamlet in the hills above <a href="/en-us/sorrento-peninsula/vico-equense/" class="text-med-blue hover:underline">Vico Equense</a>, and its living nativity, organised by the parish of Santi Pietro e Paolo, reached its tenth edition in 2025 with more than 250 performers from the village. It is set in località Torricella, a short walk from the village square. Entry is free and donations are welcome. In 2025 the organisers arranged three car parks and accessible routes for people with disabilities. One listing also included 4 January among the dates, so check the official site, presepefornacelle.it, before going.
    </p>

    <h3 class="font-serif text-2xl font-bold text-slate-900 mb-4">Massa Lubrense: the monastery at Monticchio</h3>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      In <a href="/en-us/sorrento-peninsula/massa-lubrense/" class="text-med-blue hover:underline">Massa Lubrense</a> the Carpe Diem association stages its nativity inside the eighteenth century Monastery of the Santissimo Rosario at Monticchio, with the support of the comune. The visit moves from scenes set in Judea to the Neapolitan eighteenth century, with the tavern, the market stalls and the fortune teller. One listing already gives 27 December 2026 to 6 January 2027 for the next edition, but the comune had not confirmed it at the time of writing.
    </p>

    <h3 class="font-serif text-2xl font-bold text-slate-900 mb-4">Piano di Sorrento and Sant'Agnello</h3>
    <ul class="space-y-3 mb-6">
      <li class="flex items-start gap-3"><span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span><span class="text-slate-700"><strong>Piano di Sorrento.</strong> Not a living nativity but a trail of presepi under the "Borghi e Casali" project, set up in churches, public spaces, shops and private houses and open until 11 January 2026, in some cases with guided visits by the people who built them. The programme was published on the Città di Piano di Sorrento Facebook page.</span></li>
      <li class="flex items-start gap-3"><span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span><span class="text-slate-700"><strong><a href="/en-us/sorrento-peninsula/sant-agnello/" class="text-med-blue hover:underline">Sant'Agnello</a>.</strong> An animated nativity five metres long, with moving figures and everyday scenes, in a space on Via Balsamo. In 2025/26 it opened daily from 16:00 to 20:00, and also from 10:30 to 13:00 on 1, 3 and 6 January.</span></li>
    </ul>
    <p class="text-slate-600 text-lg leading-relaxed">
      We found no confirmed living nativity in Meta for the last edition, and the one in Casarlano, a hill district of Sorrento, appears in listings only up to 2018. If either returns, it will be in the December programmes.
    </p>
  </div>

  <!-- Planning -->
  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">Putting It Together</h2>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      Naples is a day trip, the living nativities are evening outings, so they combine well. Spend a weekday morning on San Gregorio Armeno, have lunch in the historic centre and be back in Sorrento by mid afternoon. On the evenings between 26 December and 6 January, pick one of the living nativities: Sorrento's is walkable from the centre, while Fornacelle and Monticchio are hill hamlets best reached by car or taxi.
    </p>
    <p class="text-slate-600 text-lg leading-relaxed">
      If you are also crossing to the other side of the Lattari mountains, the villages of the Amalfi Coast run their own: see our guide to the <a href="/en-us/events/amalfi-coast/presepi-viventi-costiera/" class="text-med-blue hover:underline">living nativities of the Amalfi Coast</a>. And for the evenings before Christmas, the lights in Sorrento and Salerno are covered in <a href="/en-us/blog/christmas-lights-sorrento-salerno/" class="text-med-blue hover:underline">Christmas lights in Sorrento and Salerno</a>.
    </p>
  </div>

  <!-- Local Tips -->
  <div class="bg-white p-8 rounded-[2rem] shadow-xl border border-slate-100">
    <div class="flex items-center gap-4 mb-6">
      <svg class="w-6 h-6 text-med-gold flex-shrink-0" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M9 18h6"/><path d="M10 22h4"/><path d="M15.09 14c.18-.98.65-1.74 1.41-2.5A4.65 4.61 0 0 0 18 8 6 6 0 0 0 6 8c0 1 .23 2.23 1.5 3.5A4.61 4.61 0 0 1 8.91 14"/></svg>
      <h3 class="text-xl font-bold">Expert Tips</h3>
    </div>
    <div class="space-y-6">
      <div>
        <p class="font-bold text-slate-900 mb-1">Avoid the 8 December weekend in Naples</p>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">The Immacolata holiday brings the largest crowds of the month into the historic centre. If you can only go at a weekend, arrive before ten in the morning, when the one way system has just started and the street is still walkable.</p>
      </div>
      <div>
        <p class="font-bold text-slate-900 mb-1">Go inside the workshops</p>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">The best workshops keep their finest pieces inside, away from the street displays. Step in, ask, and look at how the figures are made: in some shops the artisans work on the premises.</p>
      </div>
      <div>
        <p class="font-bold text-slate-900 mb-1">Dress for a cold evening in the hills</p>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">The living nativities are outdoors or in unheated buildings, and Fornacelle and Monticchio are higher and colder than the coast. Warm shoes and a torch for the walk back to the car make a difference.</p>
      </div>
      <div>
        <p class="font-bold text-slate-900 mb-1">Check the programme in December</p>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">The parishes and associations confirm their dates late, sometimes only a week or two before Christmas. Look at the comune's site, the organiser's page and the local news before fixing an evening.</p>
      </div>
    </div>
  </div>

</BlogPostLayout>
