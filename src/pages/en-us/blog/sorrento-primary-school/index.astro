---
import BlogPostLayout from '../../../../layouts/BlogPostLayout.astro';

const lang = 'en-us';
const post = {
  title: 'Primary School in Sorrento: A Guide for Families',
  subtitle: 'How the Italian scuola primaria works, which schools Sorrento actually has, when enrolment opens, and what families who do not speak Italian need to plan for',
  category: 'GUIDES',
  date: 'September 25, 2026',
  readTime: '10 min',
  image: '/images/piazza-tasso-sorrento-hero.webp',
  imageAlt: "Piazza Tasso, the main square of Sorrento and the centre of everyday life in the town",
  path: '/en-us/blog/sorrento-primary-school/',
};

const metaTitle = 'Primary School in Sorrento: Schools and Enrolment | 2026';
const metaDescription = 'Sorrento has four primary schools, two state and two accredited private, under two istituti comprensivi. Age rules, the January enrolment window on the Unica platform, tempo pieno, and the nearest English language option.';

const breadcrumbs = [
  { name: 'Home', url: '/en-us/' },
  { name: 'Blog', url: '/en-us/blog/' },
  { name: 'Primary School in Sorrento', url: '/en-us/blog/sorrento-primary-school/' },
];

const quickInfo = [
  { label: 'School type', value: 'Scuola primaria, 5 years' },
  { label: 'Ages', value: '6 to 11' },
  { label: 'Starting age rule', value: 'Six by 31 December of that year' },
  { label: 'Early entry', value: 'Possible if six by 30 April after' },
  { label: 'Schools in Sorrento', value: '4: two state, two accredited private' },
  { label: 'Istituti comprensivi', value: '2, Sorrento Capoluogo and Tasso' },
  { label: 'Enrolment', value: 'Online in January, SPID or CIE needed' },
  { label: 'Language of teaching', value: 'Italian' },
];

const faq = [
  {
    q: 'At what age does primary school start in Italy?',
    a: 'A child enters classe prima in the September of the year in which they turn six, provided the birthday falls on or before 31 December. Families can also request early entry, called iscrizione anticipata, for children who turn six by 30 April of the following year. Primary school then lasts five years, to around age eleven.',
  },
  {
    q: 'How many primary schools are there in Sorrento?',
    a: 'Four within the comune of Sorrento: two state schools, Sorrento Capoluogo on Via Vittorio Veneto and Angelina Lauro on Via Capasso, and two accredited private schools, the Conservatorio Santa Maria della Pietà on Via Pietà and Santa Maria delle Grazie on Piazza Sant\'Antonino. The state schools belong to two istituti comprensivi, which also take in nursery and middle school.',
  },
  {
    q: 'When does enrolment open?',
    a: 'In January, for the school year starting the following September. For 2026/2027 the window ran from 13 January to 14 February 2026. The Ministry publishes the circular with the exact dates in December, so the window for the year after that is normally confirmed only a few weeks before it opens.',
  },
  {
    q: 'How do I actually submit the application?',
    a: 'Online, on the Ministry of Education\'s Unica platform. A parent logs in with a digital identity, SPID, CIE or eIDAS, enters the child\'s details and names one school as first choice plus up to two alternatives. You need the child\'s codice fiscale. Children arriving mid year are enrolled directly at the school instead, outside the platform.',
  },
  {
    q: 'Is there an English language primary school in Sorrento?',
    a: 'No. There is no international or English medium primary school on the Sorrentine Peninsula. The nearest option is the International School of Naples at Bagnoli, which runs an American curriculum from pre-school to grade 12 in English. It is roughly an hour and a half from Sorrento, which rules it out as a daily commute for most families.',
  },
  {
    q: 'Is this page about Sorrento Primary School in Australia?',
    a: 'No. Schools of that name exist in Sorrento, Western Australia and Sorrento, Victoria, and they have nothing to do with this one. This page covers primary schooling in Sorrento in Campania, southern Italy, the town on the Bay of Naples.',
  },
];

const sidebarLinks = [
  { label: 'Sorrento', href: '/en-us/sorrento-peninsula/sorrento/' },
  { label: 'Study Abroad in Sorrento', href: '/en-us/blog/study-abroad-sorrento/' },
  { label: 'Sorrento vs Positano', href: '/en-us/blog/sorrento-vs-positano/' },
  { label: 'SITA Bus', href: '/en-us/guide/sita-bus/' },
  { label: 'Ferries', href: '/en-us/guide/ferries/' },
];

const authorRole = 'Local Expert · Sorrento Peninsula';

const relatedArticles = [
  {
    title: 'Study Abroad in Sorrento: Studying on the Sorrentine Peninsula',
    category: 'GUIDES',
    date: 'July 4, 2026',
    image: '/images/study-abroad-sorrento-hero.webp',
    imageAlt: 'Studying in Sorrento',
    path: '/en-us/blog/study-abroad-sorrento/'
  },
  {
    title: 'Films Made in Sorrento: When Cinema Chooses the Peninsula',
    category: 'DISCOVERIES',
    date: 'June 30, 2026',
    image: '/images/film-fatti-a-sorrento-hero.webp',
    imageAlt: 'Films shot in Sorrento',
    path: '/en-us/blog/films-made-in-sorrento/'
  }
];

const imageCredit = {
  author: 'Berthold Werner / Wikimedia Commons',
  sourceUrl: 'https://commons.wikimedia.org/wiki/File:Piazza_Tasso_-_Sorrento_BW_2013-05-12.jpg',
  license: 'CC BY-SA 3.0',
  licenseUrl: 'https://creativecommons.org/licenses/by-sa/3.0/',
};

const keyTakeaways = [
  'Italian scuola primaria lasts five years, from the September of the year a child turns six, and is free in state schools.',
  'Sorrento has four primary schools: two state and two accredited private, grouped under two istituti comprensivi based on Via Vittorio Veneto and Via Marziale.',
  'Enrolment is done online in January on the Ministry\'s Unica platform, and a parent needs an Italian digital identity such as SPID or CIE to submit it.',
  'The choice that matters most locally is tempo normale against tempo pieno, because full time places with a canteen are limited and not offered at every building.',
  'Teaching is in Italian. There is no English medium primary school on the peninsula, and the nearest international school is in Naples, too far for a daily commute.',
];
---

<BlogPostLayout
  lang={lang}
  post={post}
  metaTitle={metaTitle}
  metaDescription={metaDescription}
  breadcrumbs={breadcrumbs}
  quickInfo={quickInfo}
  faq={faq}
  sidebarLinks={sidebarLinks}
  authorRole={authorRole}
  relatedArticles={relatedArticles}
  imageCredit={imageCredit}
  pageKey="sorrento-primary-school"
>

  <!-- Key Takeaways -->
  <div class="bg-slate-900 text-white p-8 rounded-[2rem]">
    <div class="flex items-center gap-3 mb-6">
      <svg class="w-5 h-5 text-med-gold flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
      <h2 class="font-serif text-lg font-bold text-med-gold uppercase tracking-[0.15em]">Key Takeaways</h2>
    </div>
    <ul class="space-y-4">
      {keyTakeaways.map((point) => (
        <li class="flex items-start gap-3">
          <span class="w-1.5 h-1.5 rounded-full bg-med-gold flex-shrink-0 mt-2"></span>
          <span class="text-white/80 text-xs sm:text-sm leading-relaxed">{point}</span>
        </li>
      ))}
    </ul>
  </div>

  <!-- Intro -->
  <div>
    <p class="text-slate-600 text-xl leading-relaxed mb-6 font-light">
      Most people arrive in <a href="/en-us/sorrento-peninsula/sorrento/" class="text-med-blue hover:underline">Sorrento</a> for a week. A smaller number arrive for a year or more, usually because of work in tourism, a remote job that could be done anywhere, or a return to a family house, and then discover that the question of where a six year old goes to school is not covered by any guidebook. This page sets out what the town actually has, how the Italian system works for a child entering it from outside, and the handful of dates that decide everything.
    </p>
  </div>

  <!-- How it works -->
  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">How the Italian Scuola Primaria Works</h2>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      Primary school in Italy is five years long, from <em>classe prima</em> to <em>classe quinta</em>, and covers roughly ages six to eleven. It is compulsory and, in state schools, free: families pay for materials, trips and the canteen, not for teaching. Before it comes the optional <em>scuola dell'infanzia</em> from age three, and after it the three years of <em>scuola secondaria di primo grado</em>, what everyone calls middle school.
    </p>
    <p class="text-slate-600 text-lg leading-relaxed mb-8">
      In Campania the school year normally runs from around the middle of September to the first days of June, with closures at Christmas, Easter and on local and national holidays. The one structural choice families make at enrolment is the timetable.
    </p>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div class="bg-white p-6 rounded-[2rem] border border-slate-100 shadow-sm">
        <h4 class="font-bold text-slate-900 mb-2">Tempo normale</h4>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Mornings only, usually around 27 to 30 hours a week, finishing in the early afternoon with no canteen. The default across most of the south, and the cheaper option, but it assumes someone is at home at lunchtime.</p>
      </div>
      <div class="bg-white p-6 rounded-[2rem] border border-slate-100 shadow-sm">
        <h4 class="font-bold text-slate-900 mb-2">Tempo pieno</h4>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Full time, about 40 hours a week including lunch in the canteen and afternoon lessons. Places are limited, are not available in every building, and are allocated by demand, so this is the question to ask first when you call a school.</p>
      </div>
    </div>
  </div>

  <!-- The schools -->
  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">The Primary Schools in Sorrento</h2>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      Sorrento is a small town, and the list is short. Four primary schools operate within the comune, two run by the state and two accredited private schools attached to religious institutions. The state ones sit inside <em>istituti comprensivi</em>, the Italian unit that groups nursery, primary and middle school under one head teacher and one administration.
    </p>

    <div class="overflow-x-auto rounded-[2rem] border border-slate-100 shadow-sm">
      <table class="w-full text-xs sm:text-sm">
        <thead class="bg-slate-900 text-white">
          <tr>
            <th class="text-left p-5 font-serif font-bold text-med-gold">School</th>
            <th class="text-left p-5 font-serif font-bold text-med-gold">Type</th>
            <th class="text-left p-5 font-serif font-bold text-med-gold">Address</th>
          </tr>
        </thead>
        <tbody class="bg-white">
          <tr class="border-b border-slate-100">
            <td class="p-5 font-bold">Sorrento Capoluogo</td>
            <td class="p-5 text-slate-600">State, part of I.C. Sorrento</td>
            <td class="p-5 text-slate-600">Via Vittorio Veneto, Sorrento</td>
          </tr>
          <tr class="border-b border-slate-100">
            <td class="p-5 font-bold">Angelina Lauro</td>
            <td class="p-5 text-slate-600">State</td>
            <td class="p-5 text-slate-600">Via Capasso, Sorrento</td>
          </tr>
          <tr class="border-b border-slate-100">
            <td class="p-5 font-bold">Conservatorio Santa Maria della Pietà</td>
            <td class="p-5 text-slate-600">Accredited private, religious institute</td>
            <td class="p-5 text-slate-600">Via Pietà 24, Sorrento</td>
          </tr>
          <tr>
            <td class="p-5 font-bold">Santa Maria delle Grazie</td>
            <td class="p-5 text-slate-600">Accredited private</td>
            <td class="p-5 text-slate-600">Piazza Sant'Antonino 14, Sorrento</td>
          </tr>
        </tbody>
      </table>
    </div>

    <p class="text-slate-600 text-lg leading-relaxed mt-6">
      Within the state system, the primary classes are split across two buildings: the main Vittorio Veneto site on Via Vittorio Veneto 16, and a second site on Via Marziale 18, which is also the address of the Tasso istituto comprensivo and where the full time sections have been based. Which building your child attends depends on the section they are placed in, not only on which school you applied to, so it is worth asking at the point of enrolment rather than assuming.
    </p>
  </div>

  <!-- Enrolment -->
  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">How to Enrol, Step by Step</h2>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      Enrolment in classe prima is a national online process with a fixed window, and missing it means negotiating directly with a school for whatever is left. The sequence below is the one that applies to a family already resident, or about to be, in Sorrento.
    </p>

    <div class="bg-white p-8 rounded-[2rem] border border-slate-100 shadow-sm">
      <h3 class="font-serif text-xl font-bold text-slate-900 mb-5">The five steps</h3>
      <div class="space-y-3">
        <div class="flex items-start gap-3">
          <div class="w-6 h-6 rounded-full bg-med-gold/15 flex-shrink-0 flex items-center justify-center text-med-gold font-bold text-xs">1</div>
          <p class="text-slate-600 text-xs sm:text-sm leading-relaxed"><strong>Get the paperwork in place.</strong> The child needs an Italian <em>codice fiscale</em>, and at least one parent needs a digital identity, SPID, CIE or an equivalent European eIDAS login. Both take time, so start in the autumn, not in January.</p>
        </div>
        <div class="flex items-start gap-3">
          <div class="w-6 h-6 rounded-full bg-med-gold/15 flex-shrink-0 flex items-center justify-center text-med-gold font-bold text-xs">2</div>
          <p class="text-slate-600 text-xs sm:text-sm leading-relaxed"><strong>Watch for the ministry circular.</strong> It is published in December and fixes the window. For 2026/2027 applications ran from 13 January to 14 February 2026, and the pattern of recent years has been a January opening.</p>
        </div>
        <div class="flex items-start gap-3">
          <div class="w-6 h-6 rounded-full bg-med-gold/15 flex-shrink-0 flex items-center justify-center text-med-gold font-bold text-xs">3</div>
          <p class="text-slate-600 text-xs sm:text-sm leading-relaxed"><strong>Go to the open days.</strong> Schools run them in the weeks before the window opens. This is where you see the buildings, meet the teachers and find out whether tempo pieno will be offered in the coming year.</p>
        </div>
        <div class="flex items-start gap-3">
          <div class="w-6 h-6 rounded-full bg-med-gold/15 flex-shrink-0 flex items-center justify-center text-med-gold font-bold text-xs">4</div>
          <p class="text-slate-600 text-xs sm:text-sm leading-relaxed"><strong>Apply on Unica.</strong> One school as first choice, up to two alternatives. Residence in the school's catchment is usually the first criterion when a school is oversubscribed, followed by other family circumstances set out in each school's own rules.</p>
        </div>
        <div class="flex items-start gap-3">
          <div class="w-6 h-6 rounded-full bg-med-gold/15 flex-shrink-0 flex items-center justify-center text-med-gold font-bold text-xs">5</div>
          <p class="text-slate-600 text-xs sm:text-sm leading-relaxed"><strong>Sort out the extras with the comune.</strong> The canteen, any pre and post school care and school transport are municipal services with their own separate applications, not part of the school enrolment.</p>
        </div>
      </div>
    </div>
  </div>

  <!-- Non Italian speakers -->
  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">If Your Family Does Not Speak Italian</h2>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      The honest answer is that a child in a Sorrento primary school will be taught in Italian, by teachers who in most cases work only in Italian, alongside classmates who all speak it at home. Italian state schools do accept children at any point in the school year regardless of language or paperwork status, which is a genuine strength of the system, and support for Italian as a second language exists, but how much of it a given school can offer varies a great deal.
    </p>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      For most six and seven year olds this turns out to be survivable, and often remarkably fast. From around age nine or ten, arriving with no Italian into a curriculum that is already demanding in history, geography and grammar is much harder, and worth thinking about carefully.
    </p>
    <p class="text-slate-600 text-lg leading-relaxed mb-8">
      There is no English medium primary school on the peninsula. The nearest alternative is the <strong>International School of Naples</strong> in Bagnoli, on the far western edge of the city, which teaches an American curriculum in English from pre-school to grade 12, has around 300 pupils from a long list of nationalities, and publishes its fee schedule only through its admissions office. From Sorrento it is in the region of an hour and a half each way, across the whole of Naples, so in practice families who need it move closer to the city rather than commute.
    </p>

    <blockquote class="border-l-4 border-med-gold pl-6 my-8">
      <p class="text-slate-700 text-xl font-serif italic leading-relaxed">
        "In Sorrento the school question is not which international curriculum to pick. It is how quickly a child learns Italian, and the answer is usually faster than their parents."
      </p>
    </blockquote>
  </div>

  <!-- Local Tips -->
  <div class="bg-white p-8 rounded-[2rem] shadow-xl border border-slate-100">
    <div class="flex items-center gap-4 mb-6">
      <svg class="w-6 h-6 text-med-gold flex-shrink-0" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M9 18h6"/><path d="M10 22h4"/><path d="M15.09 14c.18-.98.65-1.74 1.41-2.5A4.65 4.65 0 0 0 18 8 6 6 0 0 0 6 8c0 1 .23 2.23 1.5 3.5A4.61 4.61 0 0 1 8.91 14"/></svg>
      <h3 class="text-xl font-bold">Expert Tips</h3>
    </div>
    <div class="space-y-6">
      <div>
        <p class="font-bold text-slate-900 mb-1">Ask about the building, not just the school</p>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Sorrento's state primary classes are spread over more than one site, and the walk from Via Vittorio Veneto to Via Marziale matters when you are doing it twice a day with a six year old. Confirm which site your child's section will use before you accept a place.</p>
      </div>
      <div>
        <p class="font-bold text-slate-900 mb-1">Treat residence as the deciding factor</p>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">If a school is oversubscribed, catchment usually wins. If you are still choosing where to rent in town, check which school the address belongs to before you sign, because it is far easier to pick a flat around a school than a school around a flat.</p>
      </div>
      <div>
        <p class="font-bold text-slate-900 mb-1">Do not count on early entry</p>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">The anticipataria route exists for children turning six by 30 April of the following year, but schools weigh it on readiness and on how many classes they can form. Apply for it if you want it, and have a plan for another year of scuola dell'infanzia if it does not come through.</p>
      </div>
      <div>
        <p class="font-bold text-slate-900 mb-1">The peninsula is bigger than Sorrento</p>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Sant'Agnello, Piano di Sorrento, Meta and Massa Lubrense each have their own istituti comprensivi, a few minutes apart on the Circumvesuviana or the <a href="/en-us/guide/sita-bus/" class="text-med-blue hover:underline">SITA bus</a>. If tempo pieno is what you need and Sorrento cannot offer it, the neighbouring comune often can.</p>
      </div>
    </div>
  </div>

</BlogPostLayout>
