---
import BlogPostLayout from '../../../../layouts/BlogPostLayout.astro';

const lang = 'en-us';
const post = {
  title: 'New Year\'s Eve Fireworks in Positano',
  subtitle: 'Midnight on Spiaggia Grande: when the fireworks start, where to stand, and how to get to Positano and back on the one night of the year when the coast road has no buses after dark',
  category: 'GUIDES',
  date: 'November 24, 2026',
  readTime: '8 min',
  image: '/images/fuochi-capodanno-hero.webp',
  imageAlt: "Green and gold fireworks in the night sky on New Year's Eve",
  path: '/en-us/blog/positano-new-years-eve-fireworks/',
};

const metaTitle = 'Positano New Year\'s Eve Fireworks 2026: Where to Watch';
const metaDescription = 'New Year\'s Eve in Positano: fireworks at midnight on Spiaggia Grande, free DJ set until 3:00, the best places to watch, and how to get there and back with no ferries and no night buses.';

const breadcrumbs = [
  { name: 'Home', url: '/en-us/' },
  { name: 'Blog', url: '/en-us/blog/' },
  { name: 'New Year\'s Eve Fireworks in Positano', url: '/en-us/blog/positano-new-years-eve-fireworks/' },
];

const quickInfo = [
  { label: 'When', value: '31 December, fireworks at midnight' },
  { label: 'Where', value: 'Spiaggia Grande (Marina Grande)' },
  { label: 'Cost', value: 'Free' },
  { label: 'After midnight', value: 'DJ set on the beach until about 3:00' },
  { label: 'Organised by', value: 'Comune di Positano and Forum dei Giovani' },
  { label: 'Ferries', value: 'Not running in winter' },
  { label: 'Night buses', value: 'None, plan your return in advance' },
  { label: '2026 programme', value: 'Usually published in December' },
];

const faq = [
  {
    q: 'Are there fireworks in Positano on New Year\'s Eve?',
    a: 'Yes. In the last two editions the comune put on a fireworks show at midnight from Spiaggia Grande, followed by a free party on the beach with the Forum dei Giovani. The 2026/2027 programme had not been published at the time of writing; the comune normally announces it in December.',
  },
  {
    q: 'What time do the fireworks start?',
    a: 'At midnight. For the 2024/2025 edition the comune listed the start at 23:59 and the end of the evening at 3:00, with a DJ set on the beach after the fireworks. The 2025/2026 calendar gave 00:00 for the fireworks on Spiaggia Grande.',
  },
  {
    q: 'Do I need a ticket?',
    a: 'No. The fireworks and the party on the beach are free and open to everyone. You only pay if you book a New Year\'s Eve dinner in a restaurant or hotel, and those dinners have set menus at set prices.',
  },
  {
    q: 'Where is the best place to watch them?',
    a: 'On Spiaggia Grande itself if you want the music and the crowd, on the steps and lanes around the church of Santa Maria Assunta just above the beach, or from Via Positanesi d\'America, the cliff path towards Fornillo, if you want to see the whole bay with a little more room. A terrace facing the bay is the comfortable option, but you need to book it with dinner.',
  },
  {
    q: 'Can I get to Positano by ferry on 31 December?',
    a: 'No. The ferries along the Amalfi Coast stop for the winter, so on New Year\'s Eve the only ways in are the SITA bus on its reduced winter timetable, a taxi or private driver, or your own car.',
  },
  {
    q: 'How do I get back after midnight?',
    a: 'Not by bus: SITA has no runs in the middle of the night. If you are not sleeping in Positano, book a taxi or private driver well before 31 December and agree the pick up time and place. On that night they are the first thing to sell out.',
  },
];

const sidebarLinks = [
  { label: 'Positano', href: '/en-us/amalfi-coast/positano/' },
  { label: 'Positano Hotels and Restaurants', href: '/en-us/blog/positano-hotels-restaurants/' },
  { label: 'New Year\'s Eve in Sorrento', href: '/en-us/events/sorrento-peninsula/capodanno-sorrento/' },
  { label: 'SITA Bus', href: '/en-us/guide/sita-bus/' },
  { label: 'Parking and ZTL', href: '/en-us/guide/parking-ztl/' },
];

const authorRole = 'Local Expert · Amalfi Coast';

const relatedArticles = [
  {
    title: 'Christmas Lights in Sorrento and Salerno',
    category: 'GUIDES',
    date: 'October 21, 2026',
    image: '/images/luci-artista-salerno-hero.webp',
    imageAlt: 'Christmas lights in Salerno',
    path: '/en-us/blog/christmas-lights-sorrento-salerno/'
  },
  {
    title: 'Positano Hotels and Restaurants',
    category: 'GUIDES',
    date: 'August 31, 2026',
    image: '/images/positano-spiaggia-grande-colombo-hero.webp',
    imageAlt: 'Positano hotels and restaurants',
    path: '/en-us/blog/positano-hotels-restaurants/'
  }
];

const keyTakeaways = [
  'The fireworks go off at midnight from Spiaggia Grande, and the beach party with a DJ set carries on until about 3:00. Both are free.',
  'The 2026/2027 programme is usually confirmed by the comune in December. The timings here come from the last two editions.',
  'There are no ferries in winter and no SITA buses in the middle of the night. Either sleep in Positano or book your ride back before you arrive.',
  'Restaurants that stay open for the holidays serve set New Year\'s Eve menus. Book in November, because many places on the coast are closed for the winter.',
  'If the weather turns, the show can be cut back or moved. Check the comune\'s page and social channels on the 31st.',
];
---

<BlogPostLayout
  lang={lang}
  post={post}
  metaTitle={metaTitle}
  metaDescription={metaDescription}
  breadcrumbs={breadcrumbs}
  quickInfo={quickInfo}
  faq={faq}
  sidebarLinks={sidebarLinks}
  authorRole={authorRole}
  relatedArticles={relatedArticles}
  pageKey="positano-new-years-eve-fireworks"
>

  <!-- Key Takeaways -->
  <div class="bg-slate-900 text-white p-8 rounded-[2rem]">
    <div class="flex items-center gap-3 mb-6">
      <svg class="w-5 h-5 text-med-gold flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
      <h2 class="font-serif text-lg font-bold text-med-gold uppercase tracking-[0.15em]">Key Takeaways</h2>
    </div>
    <ul class="space-y-4">
      {keyTakeaways.map((point) => (
        <li class="flex items-start gap-3">
          <span class="w-1.5 h-1.5 rounded-full bg-med-gold flex-shrink-0 mt-2"></span>
          <span class="text-white/80 text-xs sm:text-sm leading-relaxed">{point}</span>
        </li>
      ))}
    </ul>
  </div>

  <!-- Intro -->
  <div>
    <p class="text-slate-600 text-xl leading-relaxed mb-6 font-light">
      In winter <a href="/en-us/amalfi-coast/positano/" class="text-med-blue hover:underline">Positano</a> goes quiet: many hotels close, the beach clubs pack away their sunbeds and the people in the lanes are mostly residents. On 31 December the town fills up again for one night. At midnight the fireworks go up from Spiaggia Grande, the houses on the hillside light up behind them, and the beach turns into a dance floor until the early hours. Here is what happens, where to stand and, above all, how to get there and back.
    </p>
  </div>

  <!-- The programme -->
  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">What Happens on the Night</h2>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      The celebration is organised by the Comune di Positano together with the Forum dei Giovani, the town's youth council, and the format has been the same in recent years. For the 2024/2025 edition the comune listed the start at <strong>23:59</strong> on Spiaggia Grande: fireworks first, then a <strong>DJ set on the beach until 3:00</strong>. The 2025/2026 calendar again put the fireworks at <strong>midnight on Spiaggia Grande</strong>, followed by the party with the Forum dei Giovani.
    </p>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      Entry is free and there is nothing to book for the beach. The evening before midnight is up to you: most people have dinner in a restaurant or at their hotel and walk down to the beach around half past eleven. The programme for <strong>2026/2027</strong> had not been published when this article was written. The comune normally puts it on its website in December, sometimes only a few days before the 31st.
    </p>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-6">
      <div class="bg-white p-6 rounded-[2rem] border border-slate-100 shadow-sm">
        <h4 class="font-bold text-slate-900 mb-2">Before midnight</h4>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Dinner in town, usually a set New Year's Eve menu. Restaurants with a view over the bay are the first to fill. Allow time for the walk down: in the lanes above the beach everyone is heading the same way.</p>
      </div>
      <div class="bg-white p-6 rounded-[2rem] border border-slate-100 shadow-sm">
        <h4 class="font-bold text-slate-900 mb-2">Midnight</h4>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Fireworks from Spiaggia Grande. The show is short, a matter of minutes, so be in position by a quarter to twelve.</p>
      </div>
      <div class="bg-white p-6 rounded-[2rem] border border-slate-100 shadow-sm">
        <h4 class="font-bold text-slate-900 mb-2">After midnight</h4>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">The DJ set on the beach, free, until around 3:00. Stay as long as you like, but keep an eye on the time if someone is collecting you.</p>
      </div>
      <div class="bg-white p-6 rounded-[2rem] border border-slate-100 shadow-sm">
        <h4 class="font-bold text-slate-900 mb-2">If the weather turns</h4>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">A December storm can scale back or move an event held on a beach. On the day, check the comune's website and the Forum dei Giovani's social channels.</p>
      </div>
    </div>
  </div>

  <!-- Where to watch -->
  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">Where to Watch the Fireworks</h2>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      Positano is built like an amphitheatre around its beach, so the fireworks can be seen from much of the town. The difference is in how close you are and how many people are around you.
    </p>
    <ul class="space-y-4 text-slate-600 mb-6">
      <li class="flex items-start gap-3">
        <span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span>
        <span class="text-slate-700"><strong>Spiaggia Grande.</strong> In the middle of things, with the music and the countdown. It is also where you need to be if you are staying for the DJ set. It gets crowded around midnight, so keep your bag in front of you and arrange a meeting point with your group.</span>
      </li>
      <li class="flex items-start gap-3">
        <span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span>
        <span class="text-slate-700"><strong>Around Santa Maria Assunta.</strong> The steps and lanes around the church, just above the beach, give you a slightly raised view at two minutes' walk from the party.</span>
      </li>
      <li class="flex items-start gap-3">
        <span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span>
        <span class="text-slate-700"><strong>Via Positanesi d'America.</strong> The path carved into the cliff between Spiaggia Grande and <a href="/en-us/beaches/amalfi-coast/fornillo-positano/" class="text-med-blue hover:underline">Fornillo</a> looks back across the bay, with the town behind the fireworks. There is more room than on the beach, but the path is narrow: don't stop where people need to get past.</span>
      </li>
      <li class="flex items-start gap-3">
        <span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span>
        <span class="text-slate-700"><strong>A terrace over the bay.</strong> Hotels and restaurants facing the sea sell New Year's Eve dinner with a view of the fireworks. It is the warmest option and the most expensive, and it has to be booked well in advance.</span>
      </li>
    </ul>
    <p class="text-slate-600 text-lg leading-relaxed">
      A boat is not a realistic option: the ferries do not run in winter, and private hire on a December night depends entirely on the sea.
    </p>
  </div>

  <!-- Getting there -->
  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">Getting There and Back</h2>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      This is the part to plan before anything else. In summer you would arrive by sea and leave by bus. On 31 December the ferries are not running and the buses stop in the evening, so where you sleep decides everything.
    </p>

    <div class="overflow-x-auto rounded-[2rem] border border-slate-100 shadow-sm">
      <table class="w-full text-xs sm:text-sm">
        <thead class="bg-slate-900 text-white">
          <tr>
            <th class="text-left p-5 font-serif font-bold text-med-gold">How</th>
            <th class="text-left p-5 font-serif font-bold text-med-gold">Getting there</th>
            <th class="text-left p-5 font-serif font-bold text-med-gold">Getting back after midnight</th>
          </tr>
        </thead>
        <tbody class="bg-white">
          <tr class="border-b border-slate-100">
            <td class="p-5 font-bold">SITA bus</td>
            <td class="p-5 text-slate-600">Yes, on the winter timetable. From Sorrento about 50 min</td>
            <td class="p-5 text-slate-600">No, there are no night runs</td>
          </tr>
          <tr class="border-b border-slate-100">
            <td class="p-5 font-bold">Ferry</td>
            <td class="p-5 text-slate-600">No, suspended in winter</td>
            <td class="p-5 text-slate-600">No</td>
          </tr>
          <tr class="border-b border-slate-100">
            <td class="p-5 font-bold">Taxi or private driver</td>
            <td class="p-5 text-slate-600">Yes</td>
            <td class="p-5 text-slate-600">Yes, but only if booked in advance</td>
          </tr>
          <tr>
            <td class="p-5 font-bold">Own car</td>
            <td class="p-5 text-slate-600">Possible, paid garages only</td>
            <td class="p-5 text-slate-600">Only with a driver who is not drinking</td>
          </tr>
        </tbody>
      </table>
    </div>

    <p class="text-slate-600 text-lg leading-relaxed mt-6 mb-6">
      <strong>Sleeping in Positano</strong> solves the problem: after the fireworks you walk back to your room. Book early, because few hotels stay open over the holidays. Our selection of <a href="/en-us/blog/positano-hotels-restaurants/" class="text-med-blue hover:underline">hotels and restaurants in Positano</a> is a good starting point.
    </p>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      <strong>By bus.</strong> The <a href="/en-us/guide/sita-bus/" class="text-med-blue hover:underline">SITA bus</a> runs between Sorrento and Amalfi in winter too, with fewer services. The Positano stops are on the main road above the town: from Sponda it is about ten minutes on foot down to the beach. It works for arriving in the afternoon, not for leaving after midnight. On 1 January the holiday timetable applies, with even fewer runs.
    </p>
    <p class="text-slate-600 text-lg leading-relaxed">
      <strong>By car.</strong> The Positano ZTL only applies in summer, so in December you can drive in, but parking is limited to private garages and the town's few streets are clogged on the 31st. Ask your hotel which garage it works with, and read our <a href="/en-us/guide/parking-ztl/" class="text-med-blue hover:underline">parking and ZTL guide</a>. If you are staying in Praiano or Sorrento, a taxi there and back costs more than the garage but takes away both the parking and the drive home on the coast road at two in the morning.
    </p>
  </div>

  <!-- Local Tips -->
  <div class="bg-white p-8 rounded-[2rem] shadow-xl border border-slate-100">
    <div class="flex items-center gap-4 mb-6">
      <svg class="w-6 h-6 text-med-gold flex-shrink-0" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M9 18h6"/><path d="M10 22h4"/><path d="M15.09 14c.18-.98.65-1.74 1.41-2.5A4.65 4.61 0 0 0 18 8 6 6 0 0 0 6 8c0 1 .23 2.23 1.5 3.5A4.61 4.61 0 0 1 8.91 14"/></svg>
      <h3 class="text-xl font-bold">Expert Tips</h3>
    </div>
    <div class="space-y-6">
      <div>
        <p class="font-bold text-slate-900 mb-1">Book your ride back in November</p>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">On New Year's Eve taxis and private drivers on the coast are booked weeks ahead. Agree the pick up point in writing (the Sponda stop on the main road is the simplest) and leave yourself time for the walk up from the beach.</p>
      </div>
      <div>
        <p class="font-bold text-slate-900 mb-1">Wear shoes for steps, not for a party</p>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Positano is all steps and steep lanes, and after midnight they are dark in places and crowded. Flat shoes with grip and a warm jacket: on the beach at night in December the wind off the sea is cold.</p>
      </div>
      <div>
        <p class="font-bold text-slate-900 mb-1">Check the programme on the 31st</p>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">The details here come from the last two editions. Times and organisers can change, and a storm can change the plans on the day. The comune's website is the official source.</p>
      </div>
      <div>
        <p class="font-bold text-slate-900 mb-1">The alternative: Sorrento</p>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">If getting to Positano in winter is too complicated, <a href="/en-us/events/sorrento-peninsula/capodanno-sorrento/" class="text-med-blue hover:underline">New Year's Eve in Sorrento</a> has a concert, the Ciuccio di Fuoco in Piazza Tasso and fireworks from Marina Piccola, in a town with more hotels open and the train to Naples.</p>
      </div>
    </div>
  </div>

</BlogPostLayout>
