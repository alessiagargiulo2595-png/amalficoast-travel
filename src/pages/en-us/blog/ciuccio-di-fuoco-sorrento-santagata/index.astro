---
import BlogPostLayout from '../../../../layouts/BlogPostLayout.astro';

const lang = 'en-us';
const post = {
  title: "The Ciuccio di Fuoco: New Year's Eve in Sorrento and Sant'Agata",
  subtitle: "The fire donkey that closes the old year on the afternoon of 31 December, in Piazza Tasso and in the square of Sant'Agata sui Due Golfi: what it is, when it happens and how to fit it into the rest of the night",
  category: 'DISCOVERIES',
  date: 'November 28, 2026',
  readTime: '8 min',
  image: '/images/ciuccio-di-fuoco-hero.webp',
  imageAlt: "A flame against a black background",
  path: '/en-us/blog/ciuccio-di-fuoco-sorrento-santagata/',
};

const metaTitle = "Ciuccio di Fuoco: New Year's Eve in Sorrento and Sant'Agata";
const metaDescription = "The fire donkey lit on 31 December in Sorrento's Piazza Tasso and in Sant'Agata sui Due Golfi: its meaning, recent times, transport and the rest of the night.";

const breadcrumbs = [
  { name: 'Home', url: '/en-us/' },
  { name: 'Blog', url: '/en-us/blog/' },
  { name: 'The Ciuccio di Fuoco', url: '/en-us/blog/ciuccio-di-fuoco-sorrento-santagata/' },
];

const quickInfo = [
  { label: 'Date', value: '31 December, late afternoon' },
  { label: 'Sorrento', value: 'Piazza Tasso, 18:00 in recent years' },
  { label: 'Before it', value: 'Folk parade from 17:00, Corso Italia' },
  { label: "Sant'Agata", value: 'Village square, after the 16:00/16:30 song' },
  { label: "Sant'Agata organiser", value: 'Pro Loco Due Golfi' },
  { label: 'Cost', value: 'Free, open squares' },
  { label: 'Duration', value: 'A few minutes of fireworks' },
  { label: '2026 programme', value: 'Usually published in late December' },
];

const faq = [
  {
    q: 'What is the Ciuccio di Fuoco?',
    a: 'It is a donkey figure, built in papier-mâché and packed with fireworks, that is set alight in the main square on the afternoon of 31 December. The fireworks go off one after another for a few minutes and the figure burns down. It stands for the year that is ending: the donkey is sent off so that the new year can start clean.',
  },
  {
    q: 'What time is the Ciuccio di Fuoco in Sorrento?',
    a: "In the last editions it has been at 18:00 in Piazza Tasso, after a folk parade that starts around 17:00 between Corso Italia and the old town. The comune of Sorrento publishes the New Year's Eve programme in the last days of December, so confirm the time then.",
  },
  {
    q: "Is there a Ciuccio di Fuoco in Sant'Agata sui Due Golfi too?",
    a: "Yes. Sant'Agata, the hilltop hamlet of Massa Lubrense, lights its own in the village square at the end of the Canzone de lo Capo d'Anno, the traditional New Year song carried through the streets in the afternoon. The Pro Loco Due Golfi has organised it in past editions, and in 2024 the lighting was listed at 16:30. It comes earlier than Sorrento's.",
  },
  {
    q: 'Is it suitable for children?',
    a: 'It is largely aimed at them, and local families bring small children every year. It is loud and throws sparks, so stay a few metres back from the figure, keep small children at the edge of the crowd and consider ear protection for babies.',
  },
  {
    q: 'Can I see both on the same afternoon?',
    a: "In theory, since Sant'Agata usually goes first and the two places are about 8 km apart. In practice it depends on the exact times of that year and on the traffic, and the centre of Sorrento is closed to cars on the evening of the 31st. Pick one unless both times are confirmed and there is a clear gap between them.",
  },
  {
    q: 'What happens after the Ciuccio in Sorrento?',
    a: 'Piazza Tasso stays the centre of the night. In 2024 and 2025 there was live music and a DJ set from 23:00 to 3:00, the countdown in the square and fireworks from Marina Piccola at 1:00. The day itself opens with the end of year concert at Teatro Tasso in the late morning.',
  },
];

const sidebarLinks = [
  { label: 'Sorrento', href: '/en-us/sorrento-peninsula/sorrento/' },
  { label: 'Massa Lubrense', href: '/en-us/sorrento-peninsula/massa-lubrense/' },
  { label: "New Year's Eve in Sorrento", href: '/en-us/events/sorrento-peninsula/capodanno-sorrento/' },
  { label: 'SITA Bus', href: '/en-us/guide/sita-bus/' },
  { label: "New Year's Eve in Positano", href: '/en-us/blog/positano-new-years-eve-fireworks/' },
];

const authorRole = 'Local Expert · Amalfi Coast';

const relatedArticles = [
  {
    title: "New Year's Eve Fireworks in Positano",
    category: 'GUIDES',
    date: 'November 24, 2026',
    image: '/images/spiaggia-grande-positano-hero.webp',
    imageAlt: 'Spiaggia Grande in Positano',
    path: '/en-us/blog/positano-new-years-eve-fireworks/'
  },
  {
    title: 'Christmas Lights in Sorrento and Salerno',
    category: 'GUIDES',
    date: 'October 21, 2026',
    image: '/images/luci-artista-salerno-hero.webp',
    imageAlt: 'Christmas lights in Salerno',
    path: '/en-us/blog/christmas-lights-sorrento-salerno/'
  }
];


const keyTakeaways = [
  'The Ciuccio di Fuoco is a papier-mâché donkey packed with fireworks, burned in the square on 31 December to see off the old year. In Sorrento it has been part of New Year\'s Eve since the 1960s.',
  'It happens in the late afternoon, not at midnight. In Sorrento the last editions were at 18:00 in Piazza Tasso, after a folk parade from 17:00.',
  'Sant\'Agata sui Due Golfi, in the hills of Massa Lubrense, has its own, lit in the village square at the end of the Canzone de lo Capo d\'Anno, earlier than Sorrento\'s.',
  'Both are free and short: a few minutes of fireworks. Arrive early for a place with a view, and keep children back from the sparks.',
  'The 2026 programmes are not out yet. Sorrento usually publishes in the last days of December; Massa Lubrense publishes its Christmas calendar in December.',
];
---

<BlogPostLayout
  lang={lang}
  post={post}
  metaTitle={metaTitle}
  metaDescription={metaDescription}
  breadcrumbs={breadcrumbs}
  quickInfo={quickInfo}
  faq={faq}
  sidebarLinks={sidebarLinks}
  authorRole={authorRole}
  relatedArticles={relatedArticles}
  pageKey="ciuccio-di-fuoco"
>

  <!-- Key Takeaways -->
  <div class="bg-slate-900 text-white p-8 rounded-[2rem]">
    <div class="flex items-center gap-3 mb-6">
      <svg class="w-5 h-5 text-med-gold flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
      <h2 class="font-serif text-lg font-bold text-med-gold uppercase tracking-[0.15em]">Key Takeaways</h2>
    </div>
    <ul class="space-y-4">
      {keyTakeaways.map((point) => (
        <li class="flex items-start gap-3">
          <span class="w-1.5 h-1.5 rounded-full bg-med-gold flex-shrink-0 mt-2"></span>
          <span class="text-white/80 text-xs sm:text-sm leading-relaxed">{point}</span>
        </li>
      ))}
    </ul>
  </div>

  <!-- Intro -->
  <div>
    <p class="text-slate-600 text-xl leading-relaxed mb-6 font-light">
      On the Sorrento peninsula the old year does not wait for midnight to leave. In the late afternoon of 31 December, while it is still the hour for a coffee and a last bit of shopping, a donkey made of papier-mâché and fireworks is set alight in the main square, and for a few minutes the square is all bangs, sparks and smoke. It happens in <a href="/en-us/sorrento-peninsula/sorrento/" class="text-med-blue hover:underline">Sorrento</a>, in Piazza Tasso, and a little earlier up the hill in Sant'Agata sui Due Golfi, in the municipality of <a href="/en-us/sorrento-peninsula/massa-lubrense/" class="text-med-blue hover:underline">Massa Lubrense</a>. It is called the <em>ciuccio di fuoco</em>, the fire donkey, and for most local families it is the real start of New Year's Eve.
    </p>
  </div>

  <!-- What it is -->
  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">What the Ciuccio di Fuoco Is</h2>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      <em>Ciuccio</em> is the Neapolitan word for donkey. The figure is built in papier-mâché, filled and wrapped with fireworks and set up in the middle of the square. Once the fuse is lit the charges go off in sequence, with fountains of sparks, whistles and bangs, and the donkey burns down. The whole thing lasts a few minutes. In Sorrento in 2024 the fuse was lit by the mayor, in front of a square packed with residents and visitors.
    </p>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      Nobody can say exactly where the custom comes from. Local accounts link it to country life on the peninsula, when farmers burned heaps of straw on the last day of the year to keep away bad luck, evil spirits and hunger. The donkey, the animal that carried the loads of the farms and the terraces, became the year itself: it is burned so that it takes the old year with it. In Sorrento the ritual has been part of San Silvestro, as the 31st is called in Italy, since the 1960s.
    </p>

    <blockquote class="border-l-4 border-med-gold pl-6 my-8">
      <p class="text-slate-700 text-xl font-serif italic leading-relaxed">
        "Fire here is not used to destroy, but to bring something to a close."
      </p>
    </blockquote>

    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      The ciuccio rarely arrives alone. In both places it comes at the end of a walk through the streets with the <strong>Canzone di Capodanno</strong> (in Sant'Agata, the <em>Canzone de lo Capo d'Anno</em>), the old New Year song that groups of musicians carry through the streets between 30 December and New Year's Day, wishing a good year to whoever they meet. The song is sung in dialect and is part of the same idea: seeing off the old year together, out in the street.
    </p>
  </div>

  <!-- Sorrento -->
  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">Sorrento: Piazza Tasso at 18:00</h2>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      In Sorrento the ciuccio is part of the town's official New Year's Eve programme, which sits inside the M'illumino d'Inverno winter season promoted by the comune. The shape of the afternoon has been stable for years:
    </p>
    <ul class="space-y-3 mb-6">
      <li class="flex items-start gap-3"><span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span><span class="text-slate-700"><strong>From 17:00, the parade.</strong> The folk group Piedigrotta Sorrentina walks between Corso Italia and the old town playing the Canzone di Capodanno.</span></li>
      <li class="flex items-start gap-3"><span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span><span class="text-slate-700"><strong>18:00, the ciuccio.</strong> The donkey is lit in Piazza Tasso. In the 2017 and 2025 programmes the actor Marco Palmieri took part in the show.</span></li>
      <li class="flex items-start gap-3"><span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span><span class="text-slate-700"><strong>Free.</strong> It is in the open square, with no tickets and no reserved areas.</span></li>
    </ul>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      Those times come from the programmes of the last editions. The 2026 programme has not been published yet: Sorrento usually releases it in the last days of December, and the details can change. Our page on <a href="/en-us/events/sorrento-peninsula/capodanno-sorrento/" class="text-med-blue hover:underline">New Year's Eve in Sorrento</a> will follow the official announcement.
    </p>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      Piazza Tasso fills up well before six, as the parade brings its own crowd with it. If you have small children, a spot at the edge of the square is easier than the middle: you see the fireworks just as well and you can step out when it gets loud.
    </p>
  </div>

  <!-- Sant'Agata -->
  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">Sant'Agata sui Due Golfi: The Village Version</h2>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      Sant'Agata is the largest hamlet of Massa Lubrense, on the ridge above Sorrento where you can see the Gulf of Naples on one side and the Gulf of Salerno on the other. Its ciuccio is more of a village affair than Sorrento's, in a smaller square and with a smaller crowd.
    </p>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      Here the order is song first, then fire. In the afternoon of the 31st the <em>Canzone de lo Capo d'Anno</em> goes through the streets of the village, in recent years starting from Corso Sant'Agata at the junction with Via Torricella, and at the end the donkey is lit in the square. The Pro Loco Due Golfi has organised the lighting in past editions. Recent programmes put the song at 16:00 or 16:30, and in 2024 the lighting was listed at 16:30 together with a brunch offered by the comune.
    </p>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-6">
      <div class="bg-white p-6 rounded-[2rem] border border-slate-100 shadow-sm">
        <h4 class="font-bold text-slate-900 mb-2">Earlier than Sorrento</h4>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">With the song starting at around four, the ciuccio in Sant'Agata comes before the one in Piazza Tasso. If you are staying up on the hill, it is the one to see.</p>
      </div>
      <div class="bg-white p-6 rounded-[2rem] border border-slate-100 shadow-sm">
        <h4 class="font-bold text-slate-900 mb-2">Not always in the listings</h4>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">The 2025/2026 Massa Lubrense calendar listed the song but did not name the ciuccio. Locals still expect it on the 31st, but check the December programme or ask at the Pro Loco.</p>
      </div>
    </div>
  </div>

  <!-- Getting there -->
  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">Getting There on 31 December</h2>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      This is winter, and that changes the options. There are no ferries along the coast, and buses run on holiday timetables that end early.
    </p>

    <div class="overflow-x-auto rounded-[2rem] border border-slate-100 shadow-sm">
      <table class="w-full text-xs sm:text-sm">
        <thead class="bg-slate-900 text-white">
          <tr>
            <th class="text-left p-5 font-serif font-bold text-med-gold">To</th>
            <th class="text-left p-5 font-serif font-bold text-med-gold">How</th>
            <th class="text-left p-5 font-serif font-bold text-med-gold">Notes</th>
          </tr>
        </thead>
        <tbody class="bg-white">
          <tr class="border-b border-slate-100">
            <td class="p-5 font-bold">Sorrento, from Naples</td>
            <td class="p-5 text-slate-600">Circumvesuviana train to Sorrento station</td>
            <td class="p-5 text-slate-600">About 1h; Piazza Tasso is a five minute walk from the station</td>
          </tr>
          <tr class="border-b border-slate-100">
            <td class="p-5 font-bold">Sorrento, by car</td>
            <td class="p-5 text-slate-600">Car parks outside the centre</td>
            <td class="p-5 text-slate-600">The centre is closed to traffic on the evening of the 31st</td>
          </tr>
          <tr class="border-b border-slate-100">
            <td class="p-5 font-bold">Sant'Agata, from Sorrento</td>
            <td class="p-5 text-slate-600">Bus from the station area, or car</td>
            <td class="p-5 text-slate-600">About 8 km, roughly 20 minutes by road</td>
          </tr>
          <tr>
            <td class="p-5 font-bold">Either, from the Amalfi Coast</td>
            <td class="p-5 text-slate-600">SITA bus along the coast road</td>
            <td class="p-5 text-slate-600">Reduced winter service, plan the return first</td>
          </tr>
        </tbody>
      </table>
    </div>

    <p class="text-slate-600 text-lg leading-relaxed mt-6">
      SITA buses link Sorrento with the hamlets of Massa Lubrense, Sant'Agata included, and EAV runs local lines on the peninsula. On the 31st the frequency drops and the last runs are early, so look up the return before you set out: our <a href="/en-us/guide/sita-bus/" class="text-med-blue hover:underline">SITA bus guide</a> explains where to check timetables and buy tickets. Coming from Positano or Amalfi in winter, the bus is the only public option and there is no way back late at night.
    </p>
  </div>

  <!-- Combining -->
  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">How to Build the Rest of the Night Around It</h2>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      Because it happens before dark is fully settled in, the ciuccio fits easily into a New Year's Eve plan rather than competing with it. In Sorrento, recent editions have run like this:
    </p>
    <ul class="space-y-3 mb-6">
      <li class="flex items-start gap-3"><span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span><span class="text-slate-700"><strong>11:30, Teatro Tasso.</strong> The end of year concert of the Società dei Concerti di Sorrento opens the day.</span></li>
      <li class="flex items-start gap-3"><span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span><span class="text-slate-700"><strong>17:00 to 18:00, parade and ciuccio.</strong> The song through the streets, then the donkey in Piazza Tasso.</span></li>
      <li class="flex items-start gap-3"><span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span><span class="text-slate-700"><strong>Dinner.</strong> Restaurants that open on the 31st usually work with a set New Year's Eve menu; book before you travel.</span></li>
      <li class="flex items-start gap-3"><span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span><span class="text-slate-700"><strong>23:00 to 3:00, Piazza Tasso.</strong> Live music and a DJ set, with the countdown in the square.</span></li>
      <li class="flex items-start gap-3"><span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span><span class="text-slate-700"><strong>1:00, fireworks.</strong> In 2024 and 2025 they were launched from a platform off Marina Piccola, an hour after midnight.</span></li>
    </ul>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      If you are staying in Sant'Agata or elsewhere in Massa Lubrense, the natural plan is the ciuccio in the village in the afternoon and dinner up on the hill, then a decision about whether to go down to Sorrento for midnight, which means a car, a taxi or a long walk back. If you would rather see fireworks at midnight on a beach, <a href="/en-us/blog/positano-new-years-eve-fireworks/" class="text-med-blue hover:underline">New Year's Eve in Positano</a> is the other option on this stretch of coast, but it is a separate evening: there is no practical way to do both Positano and Sorrento on the same night.
    </p>
  </div>

  <!-- Local Tips -->
  <div class="bg-white p-8 rounded-[2rem] shadow-xl border border-slate-100">
    <div class="flex items-center gap-4 mb-6">
      <svg class="w-6 h-6 text-med-gold flex-shrink-0" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M9 18h6"/><path d="M10 22h4"/><path d="M15.09 14c.18-.98.65-1.74 1.41-2.5A4.65 4.61 0 0 0 18 8 6 6 0 0 0 6 8c0 1 .23 2.23 1.5 3.5A4.61 4.61 0 0 1 8.91 14"/></svg>
      <h3 class="text-xl font-bold">Expert Tips</h3>
    </div>
    <div class="space-y-6">
      <div>
        <p class="font-bold text-slate-900 mb-1">Get there half an hour early</p>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">The show is short and the crowd arrives with the parade. Being in Piazza Tasso by 17:30, or in the square in Sant'Agata before the song ends, makes the difference between seeing the donkey and seeing the backs of heads.</p>
      </div>
      <div>
        <p class="font-bold text-slate-900 mb-1">Respect the distance</p>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">It is fireworks in the middle of a square. Keep a few metres back from the figure, do not let children run towards it, and bring ear protection for babies.</p>
      </div>
      <div>
        <p class="font-bold text-slate-900 mb-1">No glass in the square</p>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">On New Year's Eve Sorrento has banned drinks in glass in the centre in recent years, and controls are strict. Bring a plastic cup or toast at the bar.</p>
      </div>
      <div>
        <p class="font-bold text-slate-900 mb-1">Check the programme in the last week of December</p>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">The times here come from the last editions. The comune of Sorrento and the Massa Lubrense tourist office publish the definitive ones only in December, and an afternoon of rain can shift things.</p>
      </div>
    </div>
  </div>

</BlogPostLayout>
