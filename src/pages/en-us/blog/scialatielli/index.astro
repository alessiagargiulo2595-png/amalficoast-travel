---
import BlogPostLayout from '../../../../layouts/BlogPostLayout.astro';

const lang = 'en-us';
const post = {
  title: 'Scialatielli',
  subtitle: 'The Amalfi Coast Pasta: Original Recipe and History',
  category: 'FOOD',
  date: 'May 27, 2026',
  readTime: '8 min',
  image: '/images/scialatielli-hero.webp',
  imageAlt: 'Freshly hand-cut scialatielli on a wooden board - traditional pasta of the Amalfi Coast',
  path: '/en-us/blog/scialatielli/',
};

const metaTitle = 'Scialatielli: Original Recipe, History & Where to Eat Them | Amalfi Coast 2026';
const metaDescription = "Scialatielli: the fresh pasta invented in Amalfi by chef Enrico Cosentino. Original recipe with dough ingredients, hand-kneading method, the classic seafood all'amalfitana sauce, and where to eat them on the Amalfi Coast.";

const breadcrumbs = [
  { name: 'Home', url: '/en-us/' },
  { name: 'Blog', url: '/en-us/blog/' },
  { name: 'Scialatielli', url: '/en-us/blog/scialatielli/' },
];

const quickInfo = [
  { label: 'Type', value: 'Fresh hand-cut pasta' },
  { label: 'Inventor', value: "Chef Enrico Cosentino (1970s)" },
  { label: 'Origin', value: 'Amalfi - Amalfi Coast' },
  { label: 'Dough ingredients', value: 'Semolina, eggs, milk, basil, parmesan' },
  { label: 'Preparation', value: '30 min (dough) + 30 min rest' },
  { label: 'Classic sauce', value: 'Mixed seafood (clams, mussels, prawns)' },
  { label: 'Shape', value: 'Short, irregular ribbons (~10 cm)' },
  { label: 'Where to eat', value: 'Restaurants in Amalfi, Atrani, Cetara' },
];

const faq = [
  {
    q: 'What are scialatielli?',
    a: "Scialatielli are a fresh pasta typical of the Amalfi Coast, invented by chef Enrico Cosentino in Amalfi in the 1970s. They resemble short, irregular fettuccine, but the dough is unique: it contains milk, fresh chopped basil, and grated parmesan in addition to durum wheat semolina and eggs.",
  },
  {
    q: 'What is the difference between scialatielli and fettuccine?',
    a: "Classic fettuccine are made with flour, eggs, and water. Scialatielli add milk, fresh basil, and parmesan directly to the dough, making them softer, more fragrant, and with a distinctive texture. They are also cut shorter and more irregularly.",
  },
  {
    q: 'What does the word "scialatielli" mean?',
    a: "The name comes from Neapolitan dialect: \"scialare\" (to enjoy, to indulge) and \"tielli\" (to cut them). Literally \"cut them and enjoy\" — an invitation to eat with pleasure. This name reflects the gastronomic philosophy of the Amalfi Coast: simplicity and enjoyment.",
  },
  {
    q: "How are scialatielli all'amalfitana made?",
    a: "The classic all'amalfitana sauce is a mixed seafood medley: surf clams, mussels, prawns, squid, and piennolo cherry tomatoes, pan-sautéed with garlic, extra virgin olive oil, and fresh parsley. They are traditionally served straight from the pan.",
  },
  {
    q: 'Can scialatielli be made without eggs?',
    a: "The original recipe includes eggs, but egg-free variations using only milk and semolina work well too. The texture will be slightly different, but the defining characteristic — the basil-perfumed dough — remains.",
  },
  {
    q: 'Where can I find the best scialatielli on the Amalfi Coast?',
    a: "The most celebrated scialatielli are found in Amalfi, Atrani, and Cetara. Many Amalfi Coast chefs put their own spin on them: with colatura di alici, with lemon and prawns, or with zucchini and zucchini flowers. Every restaurant has its own version.",
  },
];

const sidebarLinks = [
  { label: 'Cetara Anchovies', href: '/en-us/blog/cetara-anchovies/' },
  { label: 'Limoncello Recipe', href: '/en-us/blog/limoncello-recipe/' },
  { label: 'Cuoppo Fritto', href: '/en-us/blog/cuoppo-fritto/' },
  { label: 'Lemon Delight', href: '/en-us/blog/lemon-delight/' },
  { label: 'Amalfi Coast Wines', href: '/en-us/blog/amalfi-coast-wines/' },
];

const authorRole = 'Food & Travel Specialist · Amalfi Coast';

const relatedArticles = [
  {
    title: 'Cetara Anchovies',
    category: 'FOOD',
    date: 'April 4, 2026',
    image: '/images/alici-cetara-hero.webp',
    imageAlt: 'Cetara Anchovies and Colatura DOP - Amalfi Coast',
    path: '/en-us/blog/cetara-anchovies/'
  },
  {
    title: 'Cuoppo Fritto',
    category: 'FOOD',
    date: 'May 23, 2026',
    image: '/images/cuoppo-fritto-hero.webp',
    imageAlt: 'Cuoppo fritto - street food of the Amalfi Coast',
    path: '/en-us/blog/cuoppo-fritto/'
  }
];

const keyTakeaways = [
  "Scialatielli are a fresh pasta invented in Amalfi in the 1970s by chef Enrico Cosentino — not an ancient dish, but a modern creation that became the signature pasta of the entire coast.",
  "The dough is one of a kind: semolina, eggs, milk, fresh chopped basil, and parmesan — no other Italian pasta incorporates cheese and herbs directly into the dough.",
  "The classic all'amalfitana sauce is a mixed seafood medley (clams, mussels, prawns, squid) with cherry tomatoes and parsley.",
  "The name comes from dialect: 'scialare' (to enjoy) + 'tielli' (cut them) — an invitation to eat with pleasure.",
  "They are cut short and irregular (~10 cm): the rustic shape holds the sauce far better than a smooth fettuccine.",
];

const schemaRecipe = {
  "@context": "https://schema.org",
  "@type": "Recipe",
  "name": "Scialatielli all'Amalfitana with Seafood",
  "description": "Original recipe for scialatielli, the fresh Amalfi Coast pasta invented by chef Enrico Cosentino, tossed all'amalfitana with mixed seafood.",
  "image": "https://amalficoast-travel.com/images/scialatielli-hero.webp",
  "author": { "@type": "Organization", "name": "Amalfi Coast Travel" },
  "datePublished": "2026-04-22",
  "recipeCategory": "Main course",
  "recipeCuisine": "Italian",
  "prepTime": "PT30M",
  "cookTime": "PT15M",
  "totalTime": "PT1H15M",
  "recipeYield": "4 servings",
  "recipeIngredient": [
    "400 g re-milled durum wheat semolina",
    "2 whole eggs",
    "80 ml whole milk at room temperature",
    "10–12 fresh basil leaves, finely chopped",
    "40 g grated Parmigiano Reggiano",
    "A pinch of salt and a drizzle of extra virgin olive oil",
    "300 g cleaned clams",
    "300 g cleaned mussels",
    "200 g prawns",
    "200 g squid",
    "Piennolo cherry tomatoes, garlic, chilli, white wine, parsley"
  ],
  "recipeInstructions": [
    { "@type": "HowToStep", "name": "Make the dough", "text": "Mound the semolina on a work surface and make a well in the centre. Add the eggs, milk, chopped basil, parmesan, and salt. Knead vigorously for 10–15 minutes until smooth and elastic." },
    { "@type": "HowToStep", "name": "Rest the dough", "text": "Wrap the dough in plastic and let it rest at room temperature for at least 30 minutes." },
    { "@type": "HowToStep", "name": "Roll and cut", "text": "Roll out the dough to about 3–4 mm thick. Cut into irregular strips roughly 10 cm long and 1 cm wide." },
    { "@type": "HowToStep", "name": "Make the seafood sauce", "text": "Sauté garlic and chilli in plenty of EVO. Add the clams and mussels, cover, and let them open. Add prawns, squid, halved cherry tomatoes and a splash of white wine. Cook for 5–7 minutes." },
    { "@type": "HowToStep", "name": "Cook and toss", "text": "Cook the scialatielli in salted boiling water for 3–4 minutes. Drain and toss in the pan with the seafood sauce. Serve with chopped fresh parsley." }
  ]
};
---

<BlogPostLayout
  lang={lang}
  post={post}
  metaTitle={metaTitle}
  metaDescription={metaDescription}
  breadcrumbs={breadcrumbs}
  quickInfo={quickInfo}
  faq={faq}
  sidebarLinks={sidebarLinks}
  authorRole={authorRole}
  relatedArticles={relatedArticles}
  pageKey="scialatielli"
  extraSchema={[schemaRecipe]}
>

  <!-- Key Takeaways -->
  <div class="bg-slate-900 text-white p-8 rounded-[2rem]">
    <div class="flex items-center gap-3 mb-6">
      <svg class="w-5 h-5 text-med-gold flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
      <h2 class="font-serif text-lg font-bold text-med-gold uppercase tracking-[0.15em]">Key Takeaways</h2>
    </div>
    <ul class="space-y-4">
      {keyTakeaways.map((point) => (
        <li class="flex items-start gap-3">
          <span class="w-1.5 h-1.5 rounded-full bg-med-gold flex-shrink-0 mt-2"></span>
          <span class="text-white/80 text-xs sm:text-sm leading-relaxed">{point}</span>
        </li>
      ))}
    </ul>
  </div>

  <!-- Intro -->
  <div>
    <p class="text-slate-600 text-xl leading-relaxed mb-6 font-light">
      If the <a href="/en-us/amalfi-coast/" class="text-med-blue hover:underline">Amalfi Coast</a> had one signature dish, it would be <strong>scialatielli</strong>. This <strong>fresh Amalfi Coast pasta</strong>, born from the creativity of a chef from <a href="/en-us/amalfi-coast/amalfi/" class="text-med-blue hover:underline">Amalfi</a>, has become the most ordered pasta in restaurants up and down the coast. Also known as <strong>listarella</strong> in some areas, its history is far more recent than you might expect.
    </p>
  </div>

  <!-- History -->
  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">The History of Scialatielli: A Modern Invention</h2>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      Unlike many Italian pastas with medieval origins, <strong>scialatielli</strong> were created in the 1970s by chef <strong>Enrico Cosentino</strong>, a cook from Amalfi. His insight was revolutionary: incorporating <strong>fresh chopped basil and grated parmesan directly into the pasta dough</strong>, along with milk and eggs.
    </p>
    <p class="text-slate-600 text-lg leading-relaxed mb-8">
      The result was an intensely fragrant pasta — soft yet with a slightly rough texture that holds sauce perfectly. The name, drawn from Neapolitan dialect, says it all: <strong>"scialare"</strong> (to enjoy, to indulge) and <strong>"tielli"</strong> (to cut them) — in other words, "cut them and savor every bite."
    </p>

    <blockquote class="border-l-4 border-med-gold pl-6 my-8">
      <p class="text-slate-700 text-xl font-serif italic leading-relaxed">
        "I didn't set out to invent a new pasta. I wanted the fragrance of basil and parmesan to hit you at the first bite, before you even tasted the sauce."
      </p>
      <cite class="text-slate-400 text-sm mt-2 block">— Chef Enrico Cosentino</cite>
    </blockquote>
  </div>

  <!-- Recipe -->
  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">The Original Scialatielli Recipe</h2>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      Here is the <strong>scialatielli recipe</strong> in chef Cosentino's original version, with quantities for 4 people.
    </p>

    <div class="bg-white p-8 rounded-[2rem] border border-slate-100 shadow-sm mb-8">
      <h3 class="font-serif text-xl font-bold text-slate-900 mb-5">Dough ingredients (serves 4)</h3>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div class="space-y-3">
          <div class="flex items-start gap-3">
            <span class="w-2 h-2 rounded-full bg-med-gold flex-shrink-0 mt-2"></span>
            <p class="text-slate-600 text-xs sm:text-sm leading-relaxed"><strong>400 g re-milled durum wheat semolina</strong></p>
          </div>
          <div class="flex items-start gap-3">
            <span class="w-2 h-2 rounded-full bg-med-gold flex-shrink-0 mt-2"></span>
            <p class="text-slate-600 text-xs sm:text-sm leading-relaxed"><strong>2 whole eggs</strong></p>
          </div>
          <div class="flex items-start gap-3">
            <span class="w-2 h-2 rounded-full bg-med-gold flex-shrink-0 mt-2"></span>
            <p class="text-slate-600 text-xs sm:text-sm leading-relaxed"><strong>80 ml whole milk</strong> at room temperature</p>
          </div>
        </div>
        <div class="space-y-3">
          <div class="flex items-start gap-3">
            <span class="w-2 h-2 rounded-full bg-med-gold flex-shrink-0 mt-2"></span>
            <p class="text-slate-600 text-xs sm:text-sm leading-relaxed"><strong>10–12 fresh basil leaves</strong>, very finely chopped</p>
          </div>
          <div class="flex items-start gap-3">
            <span class="w-2 h-2 rounded-full bg-med-gold flex-shrink-0 mt-2"></span>
            <p class="text-slate-600 text-xs sm:text-sm leading-relaxed"><strong>40 g freshly grated Parmigiano Reggiano</strong></p>
          </div>
          <div class="flex items-start gap-3">
            <span class="w-2 h-2 rounded-full bg-med-gold flex-shrink-0 mt-2"></span>
            <p class="text-slate-600 text-xs sm:text-sm leading-relaxed"><strong>A pinch of salt</strong> and a drizzle of extra virgin olive oil</p>
          </div>
        </div>
      </div>
    </div>

    <div class="bg-white p-8 rounded-[2rem] border border-slate-100 shadow-sm">
      <h3 class="font-serif text-xl font-bold text-slate-900 mb-5">Making the dough</h3>
      <div class="space-y-4">
        <div class="flex items-start gap-3">
          <div class="w-6 h-6 rounded-full bg-med-gold/15 flex-shrink-0 flex items-center justify-center text-med-gold font-bold text-xs">1</div>
          <p class="text-slate-600 text-xs sm:text-sm leading-relaxed"><strong>Mound the semolina</strong> on a work surface. Add the eggs, milk, chopped basil, parmesan, and salt to the center.</p>
        </div>
        <div class="flex items-start gap-3">
          <div class="w-6 h-6 rounded-full bg-med-gold/15 flex-shrink-0 flex items-center justify-center text-med-gold font-bold text-xs">2</div>
          <p class="text-slate-600 text-xs sm:text-sm leading-relaxed"><strong>Knead vigorously</strong> for 10–15 minutes until smooth and elastic. The milk will make the dough slightly more supple than a standard pasta.</p>
        </div>
        <div class="flex items-start gap-3">
          <div class="w-6 h-6 rounded-full bg-med-gold/15 flex-shrink-0 flex items-center justify-center text-med-gold font-bold text-xs">3</div>
          <p class="text-slate-600 text-xs sm:text-sm leading-relaxed"><strong>Rest the dough</strong> wrapped in cling film for at least 30 minutes at room temperature.</p>
        </div>
        <div class="flex items-start gap-3">
          <div class="w-6 h-6 rounded-full bg-med-gold/15 flex-shrink-0 flex items-center justify-center text-med-gold font-bold text-xs">4</div>
          <p class="text-slate-600 text-xs sm:text-sm leading-relaxed"><strong>Roll out the sheet</strong> to about 3–4 mm thickness (thicker than classic fettuccine). Cut into irregular strips roughly 10 cm long and 1 cm wide.</p>
        </div>
      </div>
    </div>
  </div>

  <!-- Seafood sauce -->
  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">Scialatielli all'Amalfitana: The Classic Seafood Sauce</h2>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      <strong>Scialatielli all'amalfitana</strong> is the most ordered dish on the Amalfi Coast: basil-perfumed fresh pasta tossed with a mix of the day's freshest <strong>seafood</strong>. Here are the ingredients for the classic sauce:
    </p>

    <div class="bg-white p-8 rounded-[2rem] border border-slate-100 shadow-sm mb-8">
      <h3 class="font-serif text-xl font-bold text-slate-900 mb-5">Seafood sauce (serves 4)</h3>
      <div class="space-y-3">
        <div class="flex items-start gap-3">
          <div class="w-6 h-6 rounded-full bg-med-gold/15 flex-shrink-0 flex items-center justify-center text-med-gold font-bold text-xs">1</div>
          <p class="text-slate-600 text-xs sm:text-sm leading-relaxed"><strong>Sauté garlic and chili</strong> in generous extra virgin olive oil. Add 300 g purged surf clams and 300 g cleaned mussels. Cover and cook until open.</p>
        </div>
        <div class="flex items-start gap-3">
          <div class="w-6 h-6 rounded-full bg-med-gold/15 flex-shrink-0 flex items-center justify-center text-med-gold font-bold text-xs">2</div>
          <p class="text-slate-600 text-xs sm:text-sm leading-relaxed"><strong>Add prawns and squid</strong> (200 g each), halved piennolo cherry tomatoes, and a splash of white wine. Cook for 5–7 minutes.</p>
        </div>
        <div class="flex items-start gap-3">
          <div class="w-6 h-6 rounded-full bg-med-gold/15 flex-shrink-0 flex items-center justify-center text-med-gold font-bold text-xs">3</div>
          <p class="text-slate-600 text-xs sm:text-sm leading-relaxed"><strong>Cook the scialatielli</strong> in well-salted boiling water for 3–4 minutes (they're fresh, so they cook fast). Drain and finish in the pan with the sauce. Serve with fresh parsley.</p>
        </div>
      </div>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div class="bg-white p-6 rounded-[2rem] border border-slate-100 shadow-sm">
        <h4 class="font-bold text-slate-900 mb-2">Colatura variation</h4>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">In <a href="/en-us/amalfi-coast/cetara/" class="text-med-blue hover:underline">Cetara</a>, scialatielli are dressed with PDO colatura di alici, cherry tomatoes, and olives — a perfect land-and-sea combination.</p>
      </div>
      <div class="bg-white p-6 rounded-[2rem] border border-slate-100 shadow-sm">
        <h4 class="font-bold text-slate-900 mb-2">Lemon variation</h4>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Scialatielli with prawns, IGP lemon zest, and wild rocket: the lightest and freshest summer version you'll find on the coast.</p>
      </div>
    </div>
  </div>

  <!-- Where to eat -->
  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">Where to Eat Scialatielli on the Amalfi Coast</h2>
    <div class="overflow-hidden rounded-[2rem] border border-slate-100 shadow-sm">
      <table class="w-full text-xs sm:text-sm">
        <thead class="bg-slate-900 text-white">
          <tr>
            <th class="text-left p-5 font-serif font-bold text-med-gold">Town</th>
            <th class="text-left p-5 font-serif font-bold text-med-gold">Specialty</th>
          </tr>
        </thead>
        <tbody class="bg-white">
          <tr class="border-b border-slate-100">
            <td class="p-5 font-bold">Amalfi</td>
            <td class="p-5 text-slate-600">The birthplace of scialatielli: nearly every restaurant in the center serves them all'amalfitana with fresh gulf seafood.</td>
          </tr>
          <tr class="border-b border-slate-100">
            <td class="p-5 font-bold">Atrani</td>
            <td class="p-5 text-slate-600">In the trattorias of Italy's smallest village, you find authentic versions made with fish caught that same morning.</td>
          </tr>
          <tr class="border-b border-slate-100">
            <td class="p-5 font-bold">Cetara</td>
            <td class="p-5 text-slate-600">Here scialatielli are dressed with PDO colatura di alici: a flavor pairing found nowhere else on earth.</td>
          </tr>
          <tr>
            <td class="p-5 font-bold">Praiano</td>
            <td class="p-5 text-slate-600">Clifftop restaurants serve scialatielli al limone with prawns and a sea view: the definitive summer version.</td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>

  <!-- Expert Tips -->
  <div class="bg-white p-8 rounded-[2rem] shadow-xl border border-slate-100">
    <div class="flex items-center gap-4 mb-6">
      <svg class="w-6 h-6 text-med-gold flex-shrink-0" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M9 18h6"/><path d="M10 22h4"/><path d="M15.09 14c.18-.98.65-1.74 1.41-2.5A4.65 4.65 0 0 0 18 8 6 6 0 0 0 6 8c0 1 .23 2.23 1.5 3.5A4.61 4.61 0 0 1 8.91 14"/></svg>
      <h3 class="text-xl font-bold">Expert Tips</h3>
    </div>
    <div class="space-y-6">
      <div>
        <p class="font-bold text-slate-900 mb-1">Ultra-fresh basil</p>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">The secret of scialatielli is the basil chopped into the dough. Use only young, fragrant leaves, chop them very fine, and add them with the milk: the heat of kneading releases the essential oils into the dough.</p>
      </div>
      <div>
        <p class="font-bold text-slate-900 mb-1">Lightning-fast cooking</p>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Being fresh pasta, scialatielli cook in 3–4 minutes. Pull them out a minute early and finish cooking by tossing in the pan with the sauce: they'll absorb the flavors and come out perfect.</p>
      </div>
      <div>
        <p class="font-bold text-slate-900 mb-1">Cooking class on the Amalfi Coast</p>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Many restaurants and farm stays offer <a href="/en-us/experiences/cooking-class/" class="text-med-blue hover:underline">cooking classes</a> where you learn to make scialatielli by hand: an unforgettable way to bring a piece of the Amalfi Coast home with you.</p>
      </div>
    </div>
  </div>

</BlogPostLayout>
