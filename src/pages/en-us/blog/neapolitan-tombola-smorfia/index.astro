---
import BlogPostLayout from '../../../../layouts/BlogPostLayout.astro';

const lang = 'en-us';
const post = {
  title: 'Neapolitan Tombola and the Smorfia: What the Numbers Mean',
  subtitle: "The Christmas game every family in Campania plays, how it works, and why 47 is a dead man, 48 is a dead man who talks and 71 is someone you would rather not meet",
  category: 'DISCOVERIES',
  date: 'November 19, 2026',
  readTime: '11 min',
  image: '/images/tombola-numeri-hero.webp',
  imageAlt: "Wooden tombola number pieces with 31 and 73 in red",
  path: '/en-us/blog/neapolitan-tombola-smorfia/',
};

const metaTitle = 'Neapolitan Tombola and Smorfia: What the Numbers Mean';
const metaDescription = "How the Neapolitan tombola works at Christmas, and what the smorfia numbers mean: 33, 47, 48, 71, 77, 90 and more, with the Neapolitan phrase and the translation.";

const breadcrumbs = [
  { name: 'Home', url: '/en-us/' },
  { name: 'Blog', url: '/en-us/blog/' },
  { name: 'Neapolitan Tombola and the Smorfia', url: '/en-us/blog/neapolitan-tombola-smorfia/' },
];

const quickInfo = [
  { label: 'What it is', value: 'A home lotto, close to bingo' },
  { label: 'When', value: 'The Christmas holidays' },
  { label: 'Numbers', value: '1 to 90' },
  { label: 'Card', value: '15 numbers in 3 rows' },
  { label: 'Prizes', value: 'Ambo, terno, quaterna, cinquina, tombola' },
  { label: 'The basket', value: 'Panariello' },
  { label: 'The smorfia', value: 'A meaning for every number' },
  { label: 'Most quoted', value: '47, 48, 71, 90' },
];

const faq = [
  {
    q: 'What is the Neapolitan tombola?',
    a: "A family game of chance played over the Christmas holidays. Numbers from 1 to 90 are drawn one at a time from a basket and players cover them on their cards, a little like bingo. Prizes go to the first person with two, three, four or five numbers on the same row, and the main prize, the tombola, to whoever covers the whole card first. In Naples each number is called with its meaning from the smorfia.",
  },
  {
    q: 'When is the tombola played?',
    a: "Over the Christmas holidays: after dinner on Christmas Eve, on Christmas Day, on New Year's Eve and on the quieter evenings in between. Tradition links it to the Christmas break in the lotto, when families played their own version at home.",
  },
  {
    q: 'What does 71 mean in the smorfia?',
    a: "71 is \"L'ommo 'e merda\", literally the man of shit: a worthless person, someone with no decency. It is one of the vulgar numbers of the smorfia and also one of the most quoted, because at the table it is usually called while looking at a particular relative.",
  },
  {
    q: 'What is the difference between 47 and 48?',
    a: "In Naples 47 is \"'O muorto\", the dead man, and 48 is \"'O muorto che parla\", the dead man who talks, which in a dream means a message from someone who has died. In many other Italian cities the talking dead man is 47, which is why Totò's 1950 film is called 47 morto che parla.",
  },
  {
    q: 'Why does fear make 90?',
    a: "Because in the smorfia 90 is \"'A paura\", fear. The Italian saying la paura fa novanta, fear makes ninety, comes straight from it and is used all over Italy, including by people who have never played a tombola in Naples.",
  },
  {
    q: 'What is the tombola scostumata?',
    a: "The rude version, also called tombola vajassa or tombola dei femminielli. The caller draws the numbers, announces their meanings in Neapolitan and strings them into an improvised, very spicy story. It was traditionally led by the femminielli of the popular quarters, and today it is mostly staged as a Christmas show in Naples theatres.",
  },
];

const sidebarLinks = [
  { label: 'Nativity Scenes in Naples and Sorrento', href: '/en-us/blog/nativity-scenes-naples-sorrento/' },
  { label: 'Neapolitan Christmas Sweets', href: '/en-us/blog/neapolitan-christmas-sweets/' },
  { label: 'The Feast of the Dead and Halloween', href: '/en-us/blog/feast-of-the-dead-halloween/' },
  { label: 'Sorrento', href: '/en-us/sorrento-peninsula/sorrento/' },
];

const authorRole = 'Local Expert · Sorrento Peninsula';

const relatedArticles = [
  {
    title: 'Nativity Scenes in Naples and Sorrento: A December Guide',
    category: 'GUIDES',
    date: 'November 10, 2026',
    image: '/images/presepe-natale-hero.webp',
    imageAlt: 'Nativity scene in Naples',
    path: '/en-us/blog/nativity-scenes-naples-sorrento/'
  },
  {
    title: 'Neapolitan Christmas Sweets',
    category: 'FOOD',
    date: 'November 14, 2026',
    image: '/images/struffoli-hero.webp',
    imageAlt: 'Struffoli, the Neapolitan Christmas sweet',
    path: '/en-us/blog/neapolitan-christmas-sweets/'
  }
];

const keyTakeaways = [
  'The Neapolitan tombola is a home lotto with numbers from 1 to 90, played by families over the Christmas holidays.',
  'Tradition dates it to Naples in 1734, when the lotto was suspended over Christmas and families started drawing the numbers at home.',
  'Prizes go to ambo, terno, quaterna and cinquina (two to five numbers on one row) and to the tombola, the whole card.',
  'Every number is called with its meaning from the smorfia, the Neapolitan book of dreams: 47 is the dead man, 48 the dead man who talks, 90 is fear.',
  'Some meanings are vulgar on purpose, 71 above all, and the rude version of the game, the tombola scostumata, is now a Christmas stage show.',
];

const numbers = [
  { n: 1, nap: "L'Italia", lit: 'Italy', text: 'The first number goes to the country. Older smorfie gave it other images, but Italy is the one every card carries today.' },
  { n: 10, nap: "'E fasule", lit: 'The beans', text: 'A humble number for a humble food. Fitting, since dried beans are also what many families use to cover the numbers on their cards.' },
  { n: 13, nap: "Sant'Antuono", lit: 'Saint Anthony', text: "Sant'Antuono is Saint Anthony the Abbot, one of the most loved saints in Campania. Thirteen is not an unlucky number here: that job belongs to 17." },
  { n: 16, nap: "'O culo", lit: 'The backside', text: 'Literally the bottom, and by extension luck, because in Italian slang having culo means being lucky. Whoever is winning too much will hear this number quoted at them.' },
  { n: 17, nap: "'A disgrazzia", lit: 'Misfortune', text: 'Seventeen is the unlucky number in Italy. The usual explanation is that the Roman numeral XVII rearranges into VIXI, Latin for I have lived, in other words I am dead.' },
  { n: 22, nap: "'O pazzo", lit: 'The madman', text: 'Called with a glance at whoever is behaving most strangely at the table, which on a Christmas evening is rarely hard to decide.' },
  { n: 25, nap: 'Natale', lit: 'Christmas', text: 'The date speaks for itself. Drawing 25 during a Christmas tombola earns a small cheer.' },
  { n: 28, nap: "'E zizze", lit: 'The breasts', text: 'One of the cheeky numbers. Grandmothers say it without blinking; teenagers tend to giggle.' },
  { n: 33, nap: "L'anne 'e Cristo", lit: "The years of Christ", text: "Thirty three, the age at which Christ died. Also written ll'anne 'e Criste, closer to how it is pronounced." },
  { n: 34, nap: "'A capa", lit: 'The head', text: "Plain and anatomical: capa is the Neapolitan word for head. Dreaming of a head, yours or anyone else's, points here." },
  { n: 37, nap: "'O monaco", lit: 'The monk', text: 'A city with as many convents as Naples was bound to give a monk his own number. Dreaming of a friar or a monk points to 37.' },
  { n: 43, nap: "'Onna Pereta fore 'o balcone", lit: 'Donna Pereta out on the balcony', text: 'A woman leaning out of her balcony, the eternal figure of the Neapolitan alley who sees and comments on everything. Pereta is not a name you will find on a birth certificate.' },
  { n: 45, nap: "'O vino bbuono", lit: 'The good wine', text: 'The good wine, specifically. Appropriate at a table that has been eating since the afternoon.' },
  { n: 47, nap: "'O muorto", lit: 'The dead man', text: 'Simply the dead man. Dreaming of someone who has died traditionally points here, unless the dead person speaks.' },
  { n: 48, nap: "'O muorto che parla", lit: 'The dead man who talks', text: "If the dead person speaks in the dream, the number is 48, and what they say is supposed to suggest further numbers. Outside Naples many cities give the talking dead man to 47, hence Totò's 1950 film 47 morto che parla." },
  { n: 55, nap: "'A musica", lit: 'Music', text: 'Music, in a city that exports songs. Also written \'a museca, as it is pronounced.' },
  { n: 69, nap: "Sotto e 'ncoppa", lit: 'Upside down', text: 'Literally under and on top. Look at the two digits and the logic needs no further comment.' },
  { n: 71, nap: "L'ommo 'e merda", lit: 'The man of shit', text: "A worthless man, someone with no decency or word. It is the most famous vulgar number and is called with relish, often while looking at a specific uncle. Also written l'omm 'e mmerd, the way it sounds." },
  { n: 75, nap: 'Pulecenella', lit: 'Pulcinella', text: 'The masked character of Neapolitan comedy, white costume and black half mask, poor, hungry and always finding a way out.' },
  { n: 77, nap: "'E riavule", lit: 'The devils', text: 'In Naples 77 is the devils. The reading of 77 as women\'s legs, which many people quote, belongs to other traditions: a Roman sonnet of 1883 already gives it that meaning.' },
  { n: 85, nap: "Ll'aneme d''o priatorio", lit: 'The souls in purgatory', text: 'The souls of the dead waiting in purgatory, central to Neapolitan popular devotion and to the November feast of the dead.' },
  { n: 89, nap: "'A vecchia", lit: 'The old woman', text: 'The old woman, a stock figure of fairy tales and of the vicolo. Usually not announced while looking at the grandmother who is holding the basket.' },
  { n: 90, nap: "'A paura", lit: 'Fear', text: 'The last number, and the origin of the Italian saying la paura fa novanta, fear makes ninety, used when fright pushes someone to do something they would never do otherwise.' },
];
---

<BlogPostLayout
  lang={lang}
  post={post}
  metaTitle={metaTitle}
  metaDescription={metaDescription}
  breadcrumbs={breadcrumbs}
  quickInfo={quickInfo}
  faq={faq}
  sidebarLinks={sidebarLinks}
  authorRole={authorRole}
  relatedArticles={relatedArticles}
  pageKey="neapolitan-tombola-smorfia"
>

  <!-- Key Takeaways -->
  <div class="bg-slate-900 text-white p-8 rounded-[2rem]">
    <div class="flex items-center gap-3 mb-6">
      <svg class="w-5 h-5 text-med-gold flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
      <h2 class="font-serif text-lg font-bold text-med-gold uppercase tracking-[0.15em]">Key Takeaways</h2>
    </div>
    <ul class="space-y-4">
      {keyTakeaways.map((point) => (
        <li class="flex items-start gap-3">
          <span class="w-1.5 h-1.5 rounded-full bg-med-gold flex-shrink-0 mt-2"></span>
          <span class="text-white/80 text-xs sm:text-sm leading-relaxed">{point}</span>
        </li>
      ))}
    </ul>
  </div>

  <!-- Intro -->
  <div>
    <p class="text-slate-600 text-xl leading-relaxed mb-6 font-light">
      Christmas dinner is over, the table has been cleared just enough to make room, and someone produces a wicker basket full of small wooden numbers. For the next three hours an entire Neapolitan family will argue over dried beans. The game is the <em>tombola</em>, a home version of the lotto that works much like bingo, and what makes it Neapolitan is the voice of whoever holds the basket: every number comes out with its meaning from the <em>smorfia</em>, the book of dreams, and some of those meanings are not suitable for the vicar.
    </p>
  </div>

  <!-- What it is -->
  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">What the Tombola Is and When It Is Played</h2>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      The tombola is a game of chance with 90 numbers. One person draws them one at a time from a basket and calls them out; everyone else covers them on their own cards. Prizes go to whoever first completes two, three, four or five numbers on the same row, and the big one to whoever covers the whole card. If you know bingo, you already know most of it.
    </p>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      It belongs to the Christmas holidays, which in Italy run until the Epiphany on 6 January. The classic evenings are Christmas Eve after the fish dinner, Christmas Day after lunch and New Year's Eve while waiting for midnight, but in many houses the basket comes out on any evening when the family is together and nobody wants to go out in the cold. It is played by grandparents and children at the same table, with stakes of a few coins per card, and the money stays in the family anyway.
    </p>
    <p class="text-slate-600 text-lg leading-relaxed">
      It is a habit across Campania, from Naples to <a href="/en-us/sorrento-peninsula/sorrento/" class="text-med-blue hover:underline">Sorrento</a> and the towns of the Amalfi Coast. If you are spending Christmas here and someone asks whether you want a card, the answer is yes.
    </p>
  </div>

  <!-- Origin -->
  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">Where It Comes From: a King, a Friar and the Lotto</h2>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      Naples was gambling on the lotto long before the tombola existed. The structure of 90 numbers goes back to a Genoese game of the sixteenth century, and the lotto had reached Naples in the late seventeenth century, played legally and illegally in equal measure.
    </p>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      Tradition places the birth of the tombola in <strong>1734</strong>, under King Charles of Bourbon, the future Charles III of Spain. The king wanted the lotto under public control, so that the treasury could profit from it instead of the clandestine banks. Against him stood the Dominican friar <strong>Gregorio Maria Rocco</strong>, a famous preacher, who called the game a deceptive and immoral pastime that distracted people from prayer. The compromise, as the story goes, was that the lotto would stop during the Christmas holidays. Unable to play in public, Neapolitan families put the numbers in a basket and drew them at home.
    </p>
    <p class="text-slate-600 text-lg leading-relaxed">
      Treat the details as a well established tradition rather than a documented decree: it is the story every Neapolitan source repeats, and nobody has produced a better one. The name probably comes from the tumbling of the numbers in the basket before each draw.
    </p>
  </div>

  <!-- How to play -->
  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">How to Play</h2>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      You need three things: the <strong>cartelle</strong>, the cards; the <strong>cartellone</strong>, the big board with all 90 numbers; and the <strong>panariello</strong>, the small wicker basket holding the 90 wooden or plastic numbers. Each cartella has three rows of five numbers, fifteen in all, spread over nine columns. Players buy as many cards as they like, often for a few cents each, and the money collected becomes the prize pot.
    </p>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      The person with the cartellone draws and calls, places each number on the board, and plays too: the board counts as six cards and can win prizes like anyone else. Players cover their numbers with whatever is in the kitchen. Dried beans are the classic, and pieces of mandarin peel are a close second.
    </p>

    <div class="overflow-x-auto rounded-[2rem] border border-slate-100 shadow-sm mb-6">
      <table class="w-full text-xs sm:text-sm">
        <thead class="bg-slate-900 text-white">
          <tr>
            <th class="text-left p-5 font-serif font-bold text-med-gold">Prize</th>
            <th class="text-left p-5 font-serif font-bold text-med-gold">What you need</th>
          </tr>
        </thead>
        <tbody class="bg-white">
          <tr class="border-b border-slate-100">
            <td class="p-5 font-bold">Ambo</td>
            <td class="p-5 text-slate-600">Two numbers on the same row of one card.</td>
          </tr>
          <tr class="border-b border-slate-100">
            <td class="p-5 font-bold">Terno</td>
            <td class="p-5 text-slate-600">Three numbers on the same row.</td>
          </tr>
          <tr class="border-b border-slate-100">
            <td class="p-5 font-bold">Quaterna</td>
            <td class="p-5 text-slate-600">Four numbers on the same row.</td>
          </tr>
          <tr class="border-b border-slate-100">
            <td class="p-5 font-bold">Cinquina</td>
            <td class="p-5 text-slate-600">All five numbers of a row.</td>
          </tr>
          <tr class="border-b border-slate-100">
            <td class="p-5 font-bold">Tombola</td>
            <td class="p-5 text-slate-600">All fifteen numbers of a card. The main prize, announced by shouting the name of the game.</td>
          </tr>
          <tr>
            <td class="p-5 font-bold">Tombolino</td>
            <td class="p-5 text-slate-600">An optional prize for the second card to complete, so the game can go on a little longer.</td>
          </tr>
        </tbody>
      </table>
    </div>

    <ul class="space-y-3">
      <li class="flex items-start gap-3"><span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span><span class="text-slate-700"><strong>Call it out loud.</strong> Each prize must be claimed before the next number is drawn, otherwise it goes to whoever claims it next.</span></li>
      <li class="flex items-start gap-3"><span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span><span class="text-slate-700"><strong>Prizes go in order.</strong> Ambo first, then terno, and so on up to the tombola. Nobody can win a terno before someone has won the ambo.</span></li>
      <li class="flex items-start gap-3"><span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span><span class="text-slate-700"><strong>The basket rotates.</strong> In many families whoever wins the tombola takes the cartellone for the next round.</span></li>
    </ul>
  </div>

  <!-- Smorfia -->
  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">The Smorfia, Explained</h2>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      The <em>smorfia</em> is the Neapolitan book of dreams: a popular dictionary that turns dreams and everyday events into numbers from 1 to 90, originally to know what to play at the lotto. You dream of a cat, you play 3. A dead relative speaks to you in a dream, you play 48. The name is usually linked to Morpheus, the Greek god of dreams; its origins are uncertain, with theories ranging from the Kabbalah to Pythagorean numerology.
    </p>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      It was handed down orally long before it was printed, and when it was written down it was arranged around images, so that people who could not read could use it. That is why the Neapolitan cartellone still shows a small picture in every box. Meanings can differ from one city to another, and even within Naples you will find variants and several spellings of the same phrase.
    </p>
    <p class="text-slate-600 text-lg leading-relaxed">
      At the tombola the smorfia becomes theatre. The caller rarely says the number alone: they say the meaning, or only the meaning, and the table has to work out the number. A good caller strings the numbers together into comments on whoever happens to be sitting there. In the late 1970s Massimo Troisi, Lello Arena and Enzo De Caro even named their comedy trio La Smorfia.
    </p>
  </div>

  <!-- Numbers -->
  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">What the Numbers Mean</h2>
    <p class="text-slate-600 text-lg leading-relaxed mb-8">
      Below are the numbers people search for most and the ones you are most likely to hear at a Neapolitan table. For each one: the phrase in Neapolitan, as it is usually written, the literal translation and a short note. A few are vulgar; they are part of the game, and leaving them out would be a lie.
    </p>
    <div class="space-y-4">
      {numbers.map((item) => (
        <div class="bg-white p-6 rounded-[2rem] border border-slate-100 shadow-sm">
          <h3 class="font-serif text-xl font-bold text-slate-900 mb-2">What does {item.n} mean?</h3>
          <p class="text-slate-900 font-semibold mb-2"><span class="text-med-gold">{item.n}</span> · <em>{item.nap}</em> · {item.lit}</p>
          <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">{item.text}</p>
        </div>
      ))}
    </div>
  </div>

  <!-- Scostumata -->
  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">The Tombola Scostumata</h2>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      There is a family tombola, and then there is the <em>tombola scostumata</em>, the rude one, also called <em>tombola vajassa</em> or <em>tombola dei femminielli</em>. The rules are the same. What changes is the caller, who announces each number with its saltiest possible meaning, strictly in Neapolitan, and links one draw to the next to build an improvised story that gets more indecent as the board fills up.
    </p>
    <p class="text-slate-600 text-lg leading-relaxed">
      Traditionally it was led by the <em>femminielli</em>, a recognised figure of the popular quarters of Naples, in games reserved for women and children. Today it survives mostly as a Christmas show: theatres and cabarets in Naples stage tombolate scostumate every December, often with dinner included. Your Neapolitan will not need to be good. The gestures do most of the work.
    </p>
  </div>

  <!-- Where to buy -->
  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">Where to Buy a Tombola Set</h2>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      In December tombola sets appear everywhere in Campania: stationers, toy shops, tobacconists and supermarkets stack them by the checkout. The one to look for is the Neapolitan version, with the illustrated cartellone carrying the smorfia image in each box; a plain numbered board works, but you lose half the fun.
    </p>
    <p class="text-slate-600 text-lg leading-relaxed">
      If you are in Naples, the workshops of Via San Gregorio Armeno sell Neapolitan souvenirs alongside the nativity figures, and it is a good street to look for smorfia themed objects. Stock varies from shop to shop, so treat it as a browse rather than a guaranteed purchase. Our guide to the <a href="/en-us/blog/nativity-scenes-naples-sorrento/" class="text-med-blue hover:underline">nativity scenes of Naples and Sorrento</a> explains how to get there from the peninsula.
    </p>
  </div>

  <!-- Local Tips -->
  <div class="bg-white p-8 rounded-[2rem] shadow-xl border border-slate-100">
    <div class="flex items-center gap-4 mb-6">
      <svg class="w-6 h-6 text-med-gold flex-shrink-0" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M9 18h6"/><path d="M10 22h4"/><path d="M15.09 14c.18-.98.65-1.74 1.41-2.5A4.65 4.65 0 0 0 18 8 6 6 0 0 0 6 8c0 1 .23 2.23 1.5 3.5A4.61 4.61 0 0 1 8.91 14"/></svg>
      <h3 class="text-xl font-bold">Expert Tips</h3>
    </div>
    <div class="space-y-6">
      <div>
        <p class="font-bold text-slate-900 mb-1">Learn five numbers before you sit down</p>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">47, 48, 71, 77 and 90 will come up in conversation whether they are drawn or not. Knowing them gets you a laugh and a second card.</p>
      </div>
      <div>
        <p class="font-bold text-slate-900 mb-1">Bring something for the table</p>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">A tombola lasts as long as the sweets do. A tray of struffoli or roccocò from a good pastry shop is the ideal contribution: our guide to <a href="/en-us/blog/neapolitan-christmas-sweets/" class="text-med-blue hover:underline">Neapolitan Christmas sweets</a> tells you what to buy.</p>
      </div>
      <div>
        <p class="font-bold text-slate-900 mb-1">Do not take 71 personally</p>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">If the caller looks at you when 71 comes out, you have been accepted into the family. It is when they stop teasing that you should worry.</p>
      </div>
      <div>
        <p class="font-bold text-slate-900 mb-1">The smorfia lives all year</p>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">The tombola is seasonal, the smorfia is not. The same book of numbers runs through the cult of the dead and the souls in purgatory, 85, which our article on the <a href="/en-us/blog/feast-of-the-dead-halloween/" class="text-med-blue hover:underline">feast of the dead</a> covers in November.</p>
      </div>
    </div>
  </div>

</BlogPostLayout>
