---
import BlogPostLayout from '../../../../layouts/BlogPostLayout.astro';

const lang = 'en-us';
const post = {
  title: 'Pompeii and Herculaneum from Sorrento and Positano',
  subtitle: 'Trains, buses and drivers to the two buried cities of Vesuvius, with 2026 tickets, opening hours and an honest answer to which one to choose',
  category: 'GUIDES',
  date: 'October 18, 2026',
  readTime: '11 min',
  image: '/images/pompei-basilica-hero.webp',
  imageAlt: "Brick columns and the two-storey colonnade of the Basilica in Pompeii",
  path: '/en-us/blog/pompeii-herculaneum-from-sorrento-positano/',
};

const metaTitle = 'Pompeii and Herculaneum from Sorrento or Positano 2026';
const metaDescription = 'How to reach Pompeii and Herculaneum from Sorrento and Positano: Circumvesuviana trains, SITA buses, 2026 ticket prices, opening hours and a one day plan.';

const breadcrumbs = [
  { name: 'Home', url: '/en-us/' },
  { name: 'Blog', url: '/en-us/blog/' },
  { name: 'Pompeii and Herculaneum from Sorrento and Positano', url: '/en-us/blog/pompeii-herculaneum-from-sorrento-positano/' },
];

const quickInfo = [
  { label: 'Sorrento to Pompeii', value: 'Circumvesuviana, about 35 to 45 min' },
  { label: 'Sorrento to Herculaneum', value: 'Circumvesuviana, about 1h' },
  { label: 'Positano to Pompeii', value: 'SITA bus + train, 2h or more' },
  { label: 'Pompeii ticket', value: 'From €20 (Express), €25 (Pompeii+)' },
  { label: 'Herculaneum ticket', value: '€16 full price' },
  { label: 'Winter hours', value: 'Last entry 15:30 at both sites' },
  { label: 'Free entry', value: 'First Sunday of every month' },
  { label: 'Time needed', value: 'Herculaneum 2h, Pompeii 3 to 4h' },
];

const faq = [
  {
    q: 'How do I get from Sorrento to Pompeii?',
    a: "Take the Circumvesuviana Napoli-Sorrento line from Sorrento station and get off at Pompei Scavi-Villa dei Misteri. The ride takes roughly 35 to 45 minutes, and the Porta Marina entrance is a few minutes on foot from the platform. Do not get off at Pompei Santuario, which is on a different line and serves the amphitheatre entrance. EAV's timetable from 17 October 2026 gives a train every 30 minutes to and from Sorrento.",
  },
  {
    q: 'Is there a direct bus from Positano to Pompeii?',
    a: "Not one you can plan around. We could not confirm any direct public bus between Positano and Pompeii for autumn and winter 2026. The reliable public route is the SITA bus from Positano to Sorrento, about 50 minutes in normal traffic, then the Circumvesuviana. Otherwise the options are a hired car, a private driver or an organised tour.",
  },
  {
    q: 'Is the Campania Express running?',
    a: "Not at the moment. The tourist train restarted on 28 March 2026 with stops at Ercolano, Pompei and Castellammare, but EAV suspended it from 1 October 2026 until further notice. Holders of tickets for later dates can claim a refund through EAV's complaints form. Check eavsrl.it before next spring.",
  },
  {
    q: 'How much is the ticket for Pompeii in 2026?',
    a: "From 12 January 2026 the Pompeii Express ticket, ancient city only, costs €20 and Pompeii+ costs €25, adding the Villa of the Mysteries, the Villa of Diomedes, Villa Regina at Boscoreale and the shuttle. EU citizens aged 18 to 24 pay €2. Tickets are nominative, so bring ID. Buy on the official Vivaticket site or at the park's ticket offices.",
  },
  {
    q: 'Pompeii or Herculaneum if I only have time for one?',
    a: "Herculaneum if you have half a day, want shade and fewer people, and care about detail: wooden beams, upper floors and painted rooms survive there. Pompeii if you want the scale of a whole Roman city, with its forum, theatres, amphitheatre and long paved streets, and you have at least three or four hours.",
  },
  {
    q: 'Can I visit both in one day?',
    a: "Yes, they are about 20 to 25 minutes apart on the same train line. From Sorrento it works if you start early, give Herculaneum the morning and Pompeii the afternoon in winter. From Positano it makes a very long day, and two separate days or a driver is the better choice.",
  },
];

const sidebarLinks = [
  { label: 'Sorrento', href: '/en-us/sorrento-peninsula/sorrento/' },
  { label: 'Positano', href: '/en-us/amalfi-coast/positano/' },
  { label: 'Sorrento, Pompeii and History in 3 Days', href: '/en-us/itineraries/3-days/sorrento-pompeii-history/' },
  { label: 'SITA Bus', href: '/en-us/guide/sita-bus/' },
  { label: 'The Amalfi Coast by Train', href: '/en-us/blog/amalfi-coast-by-train/' },
  { label: 'Getting Here', href: '/en-us/guide/getting-here/' },
];

const authorRole = 'Local Expert · Amalfi Coast';

const relatedArticles = [
  {
    title: 'The Amalfi Coast by Train',
    category: 'GUIDES',
    date: 'August 10, 2026',
    image: '/images/treno-costiera-hero.webp',
    imageAlt: 'The Amalfi Coast by train',
    path: '/en-us/blog/amalfi-coast-by-train/'
  },
  {
    title: 'Sorrento vs Positano: Where to Stay on the Amalfi Coast',
    category: 'GUIDES',
    date: 'June 15, 2026',
    image: '/images/sorrento-vs-positano-hero.webp',
    imageAlt: 'Sorrento and Positano compared',
    path: '/en-us/blog/sorrento-vs-positano/'
  }
];

const keyTakeaways = [
  "From Sorrento both sites are on the same Circumvesuviana line: about 35 to 45 minutes to Pompei Scavi-Villa dei Misteri and about an hour to Ercolano Scavi, with a train every 30 minutes on the timetable in force from 17 October 2026.",
  "From Positano there is no direct public transport you can count on. Take the SITA bus to Sorrento and the train from there, or use a car, a private driver or a tour.",
  "The Campania Express tourist train is suspended from 1 October 2026 until further notice, so for now it is the ordinary commuter train.",
  "Pompeii tickets cost €20 (Express) or €25 (Pompeii+) from 12 January 2026, are nominative and capped at 20,000 entries a day. Herculaneum costs €16.",
  "From 15 October to 15 March the last entry is 15:30 at both sites. Both are free on the first Sunday of every month, without online booking.",
];
---

<BlogPostLayout
  lang={lang}
  post={post}
  metaTitle={metaTitle}
  metaDescription={metaDescription}
  breadcrumbs={breadcrumbs}
  quickInfo={quickInfo}
  faq={faq}
  sidebarLinks={sidebarLinks}
  authorRole={authorRole}
  relatedArticles={relatedArticles}
  pageKey="pompeii-herculaneum-from-sorrento"
>

  <!-- Key Takeaways -->
  <div class="bg-slate-900 text-white p-8 rounded-[2rem]">
    <div class="flex items-center gap-3 mb-6">
      <svg class="w-5 h-5 text-med-gold flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
      <h2 class="font-serif text-lg font-bold text-med-gold uppercase tracking-[0.15em]">Key Takeaways</h2>
    </div>
    <ul class="space-y-4">
      {keyTakeaways.map((point) => (
        <li class="flex items-start gap-3">
          <span class="w-1.5 h-1.5 rounded-full bg-med-gold flex-shrink-0 mt-2"></span>
          <span class="text-white/80 text-xs sm:text-sm leading-relaxed">{point}</span>
        </li>
      ))}
    </ul>
  </div>

  <!-- Intro -->
  <div>
    <p class="text-slate-600 text-xl leading-relaxed mb-6 font-light">
      Pompeii and Herculaneum sit on the same stretch of railway between Naples and <a href="/en-us/sorrento-peninsula/sorrento/" class="text-med-blue hover:underline">Sorrento</a>, and for anyone staying on the peninsula they are the obvious day out. From Sorrento it is a simple train ride. From <a href="/en-us/amalfi-coast/positano/" class="text-med-blue hover:underline">Positano</a> it takes more planning, because the railway stops at Sorrento and the coast road is slow. This guide covers both starting points, the ticket rules that changed in 2026, the winter and summer hours, and how to decide between the two sites if you only have time for one.
    </p>
  </div>

  <!-- Which one -->
  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">Pompeii or Herculaneum?</h2>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      Both were destroyed by the eruption of Vesuvius in AD 79, but they were buried differently and they feel very different on the ground. Pompeii was covered by ash and pumice; it was a large commercial town and its excavated area is roughly ten times that of Herculaneum. Herculaneum, a smaller and wealthier seaside town, was buried under some 20 metres of volcanic material that sealed it more completely, which is why wooden beams, staircases, upper floors and painted rooms survive there in a way they rarely do in Pompeii.
    </p>

    <div class="overflow-x-auto rounded-[2rem] border border-slate-100 shadow-sm mb-6">
      <table class="w-full text-xs sm:text-sm">
        <thead class="bg-slate-900 text-white">
          <tr>
            <th class="text-left p-5 font-serif font-bold text-med-gold"></th>
            <th class="text-left p-5 font-serif font-bold text-med-gold">Pompeii</th>
            <th class="text-left p-5 font-serif font-bold text-med-gold">Herculaneum</th>
          </tr>
        </thead>
        <tbody class="bg-white">
          <tr class="border-b border-slate-100">
            <td class="p-5 font-bold">Size</td>
            <td class="p-5 text-slate-600">A whole city, long walks between areas</td>
            <td class="p-5 text-slate-600">Compact, seen from above and walked in a loop</td>
          </tr>
          <tr class="border-b border-slate-100">
            <td class="p-5 font-bold">Time needed</td>
            <td class="p-5 text-slate-600">3 to 4 hours minimum, a full day is easy</td>
            <td class="p-5 text-slate-600">About 2 hours</td>
          </tr>
          <tr class="border-b border-slate-100">
            <td class="p-5 font-bold">Preservation</td>
            <td class="p-5 text-slate-600">Street plan, forum, theatres, amphitheatre, frescoes</td>
            <td class="p-5 text-slate-600">Upper floors, wood, furniture, intact interiors</td>
          </tr>
          <tr class="border-b border-slate-100">
            <td class="p-5 font-bold">From Sorrento</td>
            <td class="p-5 text-slate-600">About 35 to 45 min to Pompei Scavi-Villa dei Misteri</td>
            <td class="p-5 text-slate-600">About 1h to Ercolano Scavi, then 6 min on foot</td>
          </tr>
          <tr class="border-b border-slate-100">
            <td class="p-5 font-bold">Full ticket 2026</td>
            <td class="p-5 text-slate-600">€20 Express, €25 Pompeii+</td>
            <td class="p-5 text-slate-600">€16</td>
          </tr>
          <tr class="border-b border-slate-100">
            <td class="p-5 font-bold">Crowds</td>
            <td class="p-5 text-slate-600">Up to 20,000 a day, large groups</td>
            <td class="p-5 text-slate-600">Far fewer, quieter in the afternoon</td>
          </tr>
          <tr>
            <td class="p-5 font-bold">Shade</td>
            <td class="p-5 text-slate-600">Very little, hard work in July and August</td>
            <td class="p-5 text-slate-600">More covered rooms, shorter distances</td>
          </tr>
        </tbody>
      </table>
    </div>

    <p class="text-slate-600 text-lg leading-relaxed">
      Our view: for a first visit with a full day, Pompeii, because nothing else gives the sense of a whole Roman town. For a half day, for families with small children, for travellers who struggle with heat or long walks, or for anyone who has already done Pompeii, Herculaneum is the better use of the time. Note that the Villa of the Papyri and the ancient theatre at Herculaneum are currently closed for works, with no reopening date announced.
    </p>
  </div>

  <!-- From Sorrento -->
  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">From Sorrento: the Circumvesuviana</h2>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      Sorrento is the end of the Circumvesuviana Napoli-Sorrento line, operated by EAV, and both sites have their own station on it. The train is a commuter service rather than a tourist one: no luggage racks, standing room at busy times, and a reputation for pickpockets that it has earned. It is still the fastest way to get there.
    </p>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-6">
      <div class="bg-white p-6 rounded-[2rem] border border-slate-100 shadow-sm">
        <h4 class="font-bold text-slate-900 mb-2">For Pompeii</h4>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Get off at Pompei Scavi-Villa dei Misteri, about 35 to 45 minutes from Sorrento. The Porta Marina and Piazza Esedra entrances are a few minutes away on foot. Pompei Santuario is on the Poggiomarino line and serves the Piazza Anfiteatro entrance, so it is not the stop for trains from Sorrento.</p>
      </div>
      <div class="bg-white p-6 rounded-[2rem] border border-slate-100 shadow-sm">
        <h4 class="font-bold text-slate-900 mb-2">For Herculaneum</h4>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Get off at Ercolano Scavi, about an hour from Sorrento. The park says the entrance at Corso Resina 187 is a 6 minute walk downhill from the station, which means 6 minutes uphill on the way back.</p>
      </div>
      <div class="bg-white p-6 rounded-[2rem] border border-slate-100 shadow-sm">
        <h4 class="font-bold text-slate-900 mb-2">Frequency</h4>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">EAV's new timetable for the Vesuvian lines, in force from 17 October 2026, gives a train every 30 minutes to and from Sorrento. Check departures on the day at orariotreni.eavsrl.it, and look up the last train back before you set off.</p>
      </div>
      <div class="bg-white p-6 rounded-[2rem] border border-slate-100 shadow-sm">
        <h4 class="font-bold text-slate-900 mb-2">Tickets</h4>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">A single from Sorrento costs a few euros (recent guides quote about €3.30 to Pompei Scavi). EAV says its own tickets were not affected by the regional fare change of 1 October 2026. Buy at the station, or tap a contactless card on Tap&amp;Go gates where they are installed, using the same card in and out.</p>
      </div>
    </div>

    <h3 class="font-serif text-2xl font-bold text-slate-900 mb-4">What about the Campania Express?</h3>
    <p class="text-slate-600 text-lg leading-relaxed">
      The Campania Express is EAV's tourist version of the same line: reserved seats, air conditioning, luggage space and stops only at Ercolano, Pompei, Castellammare and the main peninsula stations. It restarted on 28 March 2026 with eight runs a day, but EAV suspended it from <strong>1 October 2026 until further notice</strong>. If you bought a ticket for a later date, EAV handles refunds through its complaints form, or through the reseller if you booked via a third party. For a spring 2027 trip, check eavsrl.it for whether it is back before you plan around it.
    </p>
  </div>

  <!-- From Positano -->
  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">From Positano: Bus, Car or Driver</h2>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      Positano has no railway, and the Lattari mountains stand between it and the Vesuvian plain. Every option goes either west round the peninsula through Sorrento or over the hills, and each has a trade off.
    </p>
    <ul class="space-y-3 mb-6">
      <li class="flex items-start gap-3"><span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span><span class="text-slate-700"><strong>SITA bus and train.</strong> The <a href="/en-us/guide/sita-bus/" class="text-med-blue hover:underline">SITA bus</a> from Positano to Sorrento takes about 50 minutes in normal traffic and stops by Sorrento station, then the Circumvesuviana as above. Allow two hours or more each way to Pompeii and longer for Herculaneum. Buy bus tickets before boarding, and note that SITA Sud adjusted its fares from 1 October 2026.</span></li>
      <li class="flex items-start gap-3"><span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span><span class="text-slate-700"><strong>Ferry to Sorrento in season.</strong> When the coastal ferries are running, a boat from Positano to Sorrento avoids the bus queue in summer. They are seasonal and stop for the winter, so check the <a href="/en-us/guide/ferries/" class="text-med-blue hover:underline">ferry guide</a> for your dates.</span></li>
      <li class="flex items-start gap-3"><span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span><span class="text-slate-700"><strong>Direct bus.</strong> We could not confirm any direct public bus from Positano to Pompeii for autumn and winter 2026. Route planners show a long distance coach on some days, but without a timetable from the operator we would not build a day around it.</span></li>
      <li class="flex items-start gap-3"><span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span><span class="text-slate-700"><strong>Car.</strong> Pompeii is on the A3 Napoli-Salerno motorway, exit Pompei Scavi. From Positano it is roughly an hour to an hour and a half depending on traffic, much more on summer weekends, plus paid parking near the entrances. Read our notes on <a href="/en-us/guide/parking-ztl/" class="text-med-blue hover:underline">parking and ZTL</a> before you hire.</span></li>
      <li class="flex items-start gap-3"><span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span><span class="text-slate-700"><strong>Private driver or tour.</strong> The most expensive and the least tiring. A driver can drop you at one site, collect you at the other and have you back in Positano for dinner, which is the only way both sites in one day from Positano feels comfortable. Group tours from Positano and Sorrento usually include a guide and skip the train.</span></li>
    </ul>

    <div class="overflow-x-auto rounded-[2rem] border border-slate-100 shadow-sm">
      <table class="w-full text-xs sm:text-sm">
        <thead class="bg-slate-900 text-white">
          <tr>
            <th class="text-left p-5 font-serif font-bold text-med-gold">Route</th>
            <th class="text-left p-5 font-serif font-bold text-med-gold">How</th>
            <th class="text-left p-5 font-serif font-bold text-med-gold">Time</th>
          </tr>
        </thead>
        <tbody class="bg-white">
          <tr class="border-b border-slate-100">
            <td class="p-5 font-bold">Sorrento to Pompeii</td>
            <td class="p-5 text-slate-600">Circumvesuviana to Pompei Scavi-Villa dei Misteri</td>
            <td class="p-5 text-slate-600">35 to 45 min</td>
          </tr>
          <tr class="border-b border-slate-100">
            <td class="p-5 font-bold">Sorrento to Herculaneum</td>
            <td class="p-5 text-slate-600">Circumvesuviana to Ercolano Scavi</td>
            <td class="p-5 text-slate-600">About 1h</td>
          </tr>
          <tr class="border-b border-slate-100">
            <td class="p-5 font-bold">Herculaneum to Pompeii</td>
            <td class="p-5 text-slate-600">Circumvesuviana, same line</td>
            <td class="p-5 text-slate-600">20 to 25 min</td>
          </tr>
          <tr class="border-b border-slate-100">
            <td class="p-5 font-bold">Positano to Pompeii</td>
            <td class="p-5 text-slate-600">SITA bus to Sorrento, then train</td>
            <td class="p-5 text-slate-600">2h or more</td>
          </tr>
          <tr>
            <td class="p-5 font-bold">Positano to Pompeii</td>
            <td class="p-5 text-slate-600">Car or private driver</td>
            <td class="p-5 text-slate-600">About 1h to 1h30, traffic permitting</td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>

  <!-- Tickets and hours -->
  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">Tickets and Opening Hours 2026</h2>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      Prices and rules below are those published by the Parco Archeologico di Pompei and the Parco Archeologico di Ercolano at the time of writing. Both parks change details at short notice, so check the official pages before you go.
    </p>

    <h3 class="font-serif text-2xl font-bold text-slate-900 mb-4">Pompeii</h3>
    <ul class="space-y-3 mb-6">
      <li class="flex items-start gap-3"><span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span><span class="text-slate-700"><strong>Pompeii Express, €20.</strong> The ancient city only. The Villa of the Mysteries, outside the walls, is not included, although you can add the suburban villas for €8 by card at Porta Ercolano.</span></li>
      <li class="flex items-start gap-3"><span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span><span class="text-slate-700"><strong>Pompeii+, €25.</strong> Adds the Villa of the Mysteries, the Villa of Diomedes, Villa Regina at Boscoreale and the shuttle bus between sites.</span></li>
      <li class="flex items-start gap-3"><span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span><span class="text-slate-700"><strong>Pompeii Plus, €30.</strong> Valid three days, one entry per site, adding Oplontis, Stabiae and Boscoreale.</span></li>
      <li class="flex items-start gap-3"><span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span><span class="text-slate-700"><strong>Reduced, €2.</strong> EU citizens aged 18 to 24. Under 18s enter free under Italian state museum rules. These prices apply from 12 January 2026.</span></li>
      <li class="flex items-start gap-3"><span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span><span class="text-slate-700"><strong>Nominative tickets.</strong> Each ticket carries the visitor's name, is not transferable and is not refundable except for extraordinary closures. Staff can ask for ID at the gate. There is a cap of 20,000 entries a day, and no re-entry.</span></li>
      <li class="flex items-start gap-3"><span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span><span class="text-slate-700"><strong>Time slots in the high season.</strong> From 16 March to 14 October entry is split into a 9:00 to 13:00 slot and a 13:00 to 17:30 slot, each with its own quota. Book online on the official Vivaticket site, or buy at the entrances.</span></li>
    </ul>

    <h3 class="font-serif text-2xl font-bold text-slate-900 mb-4">Herculaneum</h3>
    <ul class="space-y-3 mb-6">
      <li class="flex items-start gap-3"><span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span><span class="text-slate-700"><strong>Full ticket, €16.</strong> Reduced €2 for those aged 18 to 24, free for the categories set by national law. Children under 12 must be accompanied.</span></li>
      <li class="flex items-start gap-3"><span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span><span class="text-slate-700"><strong>Ercolano Card, €30.</strong> Valid 365 days from first use, worth it only if you plan to come back. The Campania Artecard is also accepted, activated at the ticket office.</span></li>
      <li class="flex items-start gap-3"><span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span><span class="text-slate-700"><strong>Open every day except 25 December.</strong> Tickets are sold online from the park's tickets page and at the ticket office.</span></li>
    </ul>

    <div class="overflow-x-auto rounded-[2rem] border border-slate-100 shadow-sm mb-6">
      <table class="w-full text-xs sm:text-sm">
        <thead class="bg-slate-900 text-white">
          <tr>
            <th class="text-left p-5 font-serif font-bold text-med-gold">Period</th>
            <th class="text-left p-5 font-serif font-bold text-med-gold">Pompeii</th>
            <th class="text-left p-5 font-serif font-bold text-med-gold">Herculaneum</th>
          </tr>
        </thead>
        <tbody class="bg-white">
          <tr class="border-b border-slate-100">
            <td class="p-5 font-bold">15 October to 15 March</td>
            <td class="p-5 text-slate-600">9:00 to 17:00, last entry 15:30</td>
            <td class="p-5 text-slate-600">8:30 to 17:00, last entry 15:30, leave the area by 16:40</td>
          </tr>
          <tr class="border-b border-slate-100">
            <td class="p-5 font-bold">16 March to 14 October</td>
            <td class="p-5 text-slate-600">9:00 to 19:00, last entry 17:30</td>
            <td class="p-5 text-slate-600">8:30 to 19:30, last entry 18:00</td>
          </tr>
          <tr>
            <td class="p-5 font-bold">Closed</td>
            <td class="p-5 text-slate-600">25 December and 1 January</td>
            <td class="p-5 text-slate-600">25 December</td>
          </tr>
        </tbody>
      </table>
    </div>

    <h3 class="font-serif text-2xl font-bold text-slate-900 mb-4">Free first Sundays</h3>
    <p class="text-slate-600 text-lg leading-relaxed">
      Both parks are free on the first Sunday of every month under the Ministry's Domenica al Museo scheme. At Pompeii there is no online booking on those days and no nominative ticket: you go straight through the turnstiles, with the 20,000 daily cap still in force. At Herculaneum there is no booking either, and you collect the free ticket at the ticket office on the day. Herculaneum is also free on 25 April, 2 June and 4 November. The next first Sundays are <strong>1 November 2026</strong> (also a public holiday), <strong>6 December 2026</strong> and <strong>3 January 2027</strong>. Expect long queues and a crowded site: free is not the same as easy.
    </p>
  </div>

  <!-- One day or two -->
  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">Both in One Day, or Two Separate Days?</h2>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      From Sorrento, one day for both is realistic. The two stations are 20 to 25 minutes apart, Herculaneum needs about two hours and Pompeii three to four. The catch is the winter timetable: with last entry at 15:30, you need to be at Pompeii by early afternoon, so you start Herculaneum when it opens. In summer the order flips: Pompeii first thing for the cooler hours, Herculaneum in the afternoon because its last entry is later.
    </p>
    <p class="text-slate-600 text-lg leading-relaxed">
      From Positano, add roughly an hour each way for the bus and the queue at the stop, and one day for both becomes a twelve hour outing. Either split them over two days, or base yourself in Sorrento for a night, as in our <a href="/en-us/itineraries/3-days/sorrento-pompeii-history/" class="text-med-blue hover:underline">three day Sorrento, Pompeii and history itinerary</a>, or book a driver.
    </p>
  </div>

