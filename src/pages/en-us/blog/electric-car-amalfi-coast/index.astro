---
import BlogPostLayout from '../../../../layouts/BlogPostLayout.astro';

const lang = 'en-us';
const post = {
  title: 'Electric Car on the Amalfi Coast: Charging and Road Trip Guide',
  subtitle: "Where the public chargers are on the coast and the Sorrento Peninsula, fast chargers on the way in, prices, apps, alternate plates and an honest verdict on doing the trip in an EV",
  category: 'GUIDES',
  date: 'October 30, 2026',
  readTime: '11 min',
  image: '/images/auto-elettrica-ricarica-hero.webp',
  imageAlt: "A white electric car plugged in to charge on a tree-lined street",
  path: '/en-us/blog/electric-car-amalfi-coast/',
};

const metaTitle = 'Electric Car on the Amalfi Coast: EV Charging Guide 2026';
const metaDescription = "EV charging on the Amalfi Coast and Sorrento Peninsula: chargers town by town, fast chargers near Naples and Salerno, 2026 prices per kWh, apps, plate rules.";

const breadcrumbs = [
  { name: 'Home', url: '/en-us/' },
  { name: 'Blog', url: '/en-us/blog/' },
  { name: 'Electric Car on the Amalfi Coast', url: '/en-us/blog/electric-car-amalfi-coast/' },
];

const quickInfo = [
  { label: 'Feasible?', value: 'Yes, if you sleep where you can charge' },
  { label: 'Sorrento to Vietri', value: 'About 64 km of SS163 and SS145' },
  { label: 'Public chargers on the coast', value: 'A handful per town, mostly AC' },
  { label: 'Nearest fast chargers', value: 'Salerno area, Naples area, A1' },
  { label: 'Average AC price', value: '€0.63/kWh (July 2026)' },
  { label: 'Average DC price', value: '€0.74/kWh (July 2026)' },
  { label: 'EV exempt from alternate plates on SS163?', value: 'No exemption found' },
  { label: 'Data checked', value: '16 October 2026' },
];

const faq = [
  {
    q: 'Can you drive the Amalfi Coast in an electric car?',
    a: "Yes. Distances are short: the whole run from Sorrento to Vietri sul Mare is about 64 km, and a typical stay rarely adds up to more than 200 to 300 km including the trip from Naples. Range is not the issue. Charging is: public points on the coast are few, mostly slow AC and often occupied in summer, so the trip works best if your hotel or a garage near it has a charger.",
  },
  {
    q: 'Are there fast chargers on the Amalfi Coast itself?',
    a: "We did not find a confirmed DC fast charger on the SS163 between Positano and Vietri when we checked on 16 October 2026. The nearest high power options are around Salerno and Naples: Tesla Superchargers open to other brands at Mercato San Severino, Nola, Naples West and Afragola, and on the A1 the Free To X station at Teano Ovest. Check the live map in your app before setting off, because new sites open every month.",
  },
  {
    q: 'Are electric cars exempt from the alternate plates rule on the SS163?',
    a: "Not according to the exemption lists we found. The ANAS ordinance on the SS163 exempts residents, taxis and chauffeur services, disabled badge holders, hotel guests with a booking on arrival and departure days, and motorbikes, but no list we found mentions electric cars. Some Sorrento Peninsula municipal ordinances have treated electric and plug-in hybrid cars differently, so check the rule of each town you cross.",
  },
  {
    q: 'How much does it cost to charge an EV in Italy?',
    a: "The Adiconsum-TariffEV observatory put the average pay as you go price at €0.63 per kWh on AC chargers and €0.74 per kWh on DC and ultra-fast chargers in July 2026, with big differences between operators. Topping up 40 kWh therefore costs roughly €25 to €30. Subscriptions and third party apps can be cheaper; paying by card at the post is often the most expensive option.",
  },
  {
    q: 'Which apps should I install before the trip?',
    a: "At least one aggregator map (Electromaps, PlugShare or Chargemap) to see every operator in one place, plus the app of the operators you are most likely to use, such as Enel X Way, Plenitude (formerly Be Charge), Free To X or the Tesla app for Superchargers. Italy's official national map, the Piattaforma Unica Nazionale (PUN), shows public points with power, operator and status.",
  },
  {
    q: 'Can I rent an electric car in Naples or Salerno?',
    a: "Yes, the main rental companies at Naples airport list electric models, but usually as a category \"or similar\", so you may not know the exact car until you pick it up. Ask for a model with a realistic range of at least 300 km, check the charge level at pickup and the return rules, and make sure the car comes with a Type 2 cable for AC charging.",
  },
];

const sidebarLinks = [
  { label: 'Parking and ZTL', href: '/en-us/guide/parking-ztl/' },
  { label: 'Alternate License Plates', href: '/en-us/guide/alternate-license-plates/' },
  { label: 'Getting Here', href: '/en-us/guide/getting-here/' },
  { label: 'SITA Bus', href: '/en-us/guide/sita-bus/' },
  { label: 'The Amalfi Coast by Train', href: '/en-us/blog/amalfi-coast-by-train/' },
];

const authorRole = 'Local Expert · Amalfi Coast';

const relatedArticles = [
  {
    title: 'The Amalfi Coast by Train',
    category: 'GUIDES',
    date: 'August 10, 2026',
    image: '/images/treno-costiera-hero.webp',
    imageAlt: 'The Amalfi Coast by train',
    path: '/en-us/blog/amalfi-coast-by-train/'
  },
  {
    title: 'Christmas Lights in Sorrento and Salerno',
    category: 'GUIDES',
    date: 'October 21, 2026',
    image: '/images/luci-artista-salerno-hero.webp',
    imageAlt: "Pink flamingo light installation at the Villa Comunale in Salerno during Luci d'Artista",
    path: '/en-us/blog/christmas-lights-sorrento-salerno/'
  }
];

const keyTakeaways = [
  'Range is not the problem on this coast: Sorrento to Vietri is about 64 km and a whole stay rarely tops 300 km. Charging access is the problem.',
  'Public chargers on the coast are few, mostly AC and scattered: one or two listings per town in Positano, Praiano, Amalfi, Ravello, Maiori, Minori and Vietri when we checked on 16 October 2026.',
  'The nearest fast chargers are off the coast, around Salerno, Naples and on the A1. Arrive with a high state of charge.',
  'The single most useful thing you can do is book a hotel or garage with a charger. It turns an awkward trip into an easy one.',
  'No exemption for electric cars appears in the published lists for the SS163 alternate plates rule. Plan driving days around it.',
];
---

<BlogPostLayout
  lang={lang}
  post={post}
  metaTitle={metaTitle}
  metaDescription={metaDescription}
  breadcrumbs={breadcrumbs}
  quickInfo={quickInfo}
  faq={faq}
  sidebarLinks={sidebarLinks}
  authorRole={authorRole}
  relatedArticles={relatedArticles}
  pageKey="electric-car-amalfi-coast"
>

  <!-- Key Takeaways -->
  <div class="bg-slate-900 text-white p-8 rounded-[2rem]">
    <div class="flex items-center gap-3 mb-6">
      <svg class="w-5 h-5 text-med-gold flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
      <h2 class="font-serif text-lg font-bold text-med-gold uppercase tracking-[0.15em]">Key Takeaways</h2>
    </div>
    <ul class="space-y-4">
      {keyTakeaways.map((point) => (
        <li class="flex items-start gap-3">
          <span class="w-1.5 h-1.5 rounded-full bg-med-gold flex-shrink-0 mt-2"></span>
          <span class="text-white/80 text-xs sm:text-sm leading-relaxed">{point}</span>
        </li>
      ))}
    </ul>
  </div>

  <!-- Intro -->
  <div>
    <p class="text-slate-600 text-xl leading-relaxed mb-6 font-light">
      An electric car and the Amalfi Coast sound like a poor match: one road, no motorway, parking that is hard to find even without a cable. In practice the distances are so short that a modern EV can cover a whole week here on one or two full charges. What makes the difference is not the battery but where you sleep, where you park and whether you have planned the fast charge before you leave the motorway. This guide sets out what we found on the ground and in the charging maps, town by town, and gives an honest answer on whether it is worth it.
    </p>
  </div>

  <!-- Range -->
  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">Range on the SS163: Better Than You Think</h2>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      The Amalfi road is slow. Between Positano and Vietri you rarely go above 40 to 50 km/h, there are hundreds of bends and, in summer, long queues behind buses. For an electric car that is close to ideal: low speed means low aerodynamic losses, and every descent into a village or down to the sea is energy recovered through regenerative braking.
    </p>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      Three things push consumption up. The climbs, first of all: <a href="/en-us/amalfi-coast/ravello/" class="text-med-blue hover:underline">Ravello</a> sits at about 350 m and <a href="/en-us/amalfi-coast/agerola/" class="text-med-blue hover:underline">Agerola</a> at about 600 m, both reached on steep roads straight from sea level, although a good part comes back on the way down. Then the air conditioning, which in July and August runs all day, including while you sit still in traffic. And finally the approach: the motorway from Rome or from the north, at 130 km/h, is where most of the battery goes.
    </p>
    <ul class="space-y-3 mb-6">
      <li class="flex items-start gap-3"><span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span><span class="text-slate-700"><strong>Sorrento to Positano.</strong> About 17 km on the SS163.</span></li>
      <li class="flex items-start gap-3"><span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span><span class="text-slate-700"><strong>Positano to Amalfi.</strong> About 17 km, through Praiano and Conca dei Marini.</span></li>
      <li class="flex items-start gap-3"><span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span><span class="text-slate-700"><strong>Amalfi to Salerno.</strong> About 25 km, through Minori, Maiori, Cetara and Vietri.</span></li>
      <li class="flex items-start gap-3"><span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span><span class="text-slate-700"><strong>Naples to Sorrento.</strong> About 50 km, motorway to Castellammare then the SS145.</span></li>
    </ul>
    <p class="text-slate-600 text-lg leading-relaxed">
      Put together, a stay based in Sorrento or Positano with day trips along the coast and the drive from and back to Naples adds up to a few hundred kilometres. Any EV with a real range of 300 km can do it with one charge in the middle, provided that charge happens.
    </p>
  </div>

  <!-- Town by town -->
  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">Public Chargers Town by Town</h2>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      The table below shows what the charging maps listed on <strong>16 October 2026</strong>, using Electromaps' town pages and OpenStreetMap. Neither is complete, and they rarely show the power of each point: treat it as a picture of how sparse the network is, not as a list to rely on. Most points on the coast are AC posts with Type 2 sockets, typically up to 22 kW, which means hours, not minutes, for a meaningful charge.
    </p>

    <div class="overflow-x-auto rounded-[2rem] border border-slate-100 shadow-sm">
      <table class="w-full text-xs sm:text-sm">
        <thead class="bg-slate-900 text-white">
          <tr>
            <th class="text-left p-5 font-serif font-bold text-med-gold">Town</th>
            <th class="text-left p-5 font-serif font-bold text-med-gold">Listed locations (16 Oct 2026)</th>
            <th class="text-left p-5 font-serif font-bold text-med-gold">Notes</th>
          </tr>
        </thead>
        <tbody class="bg-white">
          <tr class="border-b border-slate-100">
            <td class="p-5 font-bold">Positano</td>
            <td class="p-5 text-slate-600">Two listings on Via Guglielmo Marconi, the stretch of SS163 above the town, 2 connectors each</td>
            <td class="p-5 text-slate-600">On the main road, far from the beach. The lower town is a camera ZTL.</td>
          </tr>
          <tr class="border-b border-slate-100">
            <td class="p-5 font-bold">Praiano</td>
            <td class="p-5 text-slate-600">Via Umberto I (6 connectors) and Via Costantinopoli (2)</td>
            <td class="p-5 text-slate-600">The best supplied village on paper, and a practical base between Positano and Amalfi.</td>
          </tr>
          <tr class="border-b border-slate-100">
            <td class="p-5 font-bold">Amalfi</td>
            <td class="p-5 text-slate-600">One listing on Via delle Cartiere, at a private business in the upper town</td>
            <td class="p-5 text-slate-600">We found no listed public point in the port car parks or at Luna Rossa.</td>
          </tr>
          <tr class="border-b border-slate-100">
            <td class="p-5 font-bold">Ravello</td>
            <td class="p-5 text-slate-600">One listing on Via Orso Papice, 1 connector</td>
            <td class="p-5 text-slate-600">The point on Via della Repubblica in OpenStreetMap is for e-bikes, not cars.</td>
          </tr>
          <tr class="border-b border-slate-100">
            <td class="p-5 font-bold">Maiori</td>
            <td class="p-5 text-slate-600">One listing on Via Amendola</td>
            <td class="p-5 text-slate-600">Long seafront and more parking than most towns.</td>
          </tr>
          <tr class="border-b border-slate-100">
            <td class="p-5 font-bold">Minori</td>
            <td class="p-5 text-slate-600">Via Pergola and Via Bizantina, 2 connectors each</td>
            <td class="p-5 text-slate-600">Small town, very few spaces in summer.</td>
          </tr>
          <tr class="border-b border-slate-100">
            <td class="p-5 font-bold">Vietri sul Mare</td>
            <td class="p-5 text-slate-600">Corso Umberto I; OpenStreetMap also shows a municipal point near Benincasa</td>
            <td class="p-5 text-slate-600">Gateway town with the largest car parks on the coast.</td>
          </tr>
          <tr class="border-b border-slate-100">
            <td class="p-5 font-bold">Agerola</td>
            <td class="p-5 text-slate-600">One point in Bomerano (Via Casalone) in OpenStreetMap</td>
            <td class="p-5 text-slate-600">Up on the plateau, useful for the Path of the Gods start.</td>
          </tr>
          <tr class="border-b border-slate-100">
            <td class="p-5 font-bold">Sorrento</td>
            <td class="p-5 text-slate-600">Piazza Angelina Lauro, Via Capo and Via Nastro Verde, plus one hotel listing</td>
            <td class="p-5 text-slate-600">Piazza Lauro is above the Achille Lauro garage, the most central option.</td>
          </tr>
          <tr class="border-b border-slate-100">
            <td class="p-5 font-bold">Sant'Agnello and Meta</td>
            <td class="p-5 text-slate-600">No Sant'Agnello listing found; OpenStreetMap shows two Enel X points in nearby Meta (Via Flavio Gioia, Via del Lauro)</td>
            <td class="p-5 text-slate-600">Check the live map: this stretch changes quickly.</td>
          </tr>
          <tr class="border-b border-slate-100">
            <td class="p-5 font-bold">Vico Equense</td>
            <td class="p-5 text-slate-600">Piazza Stazione, by the Circumvesuviana station, 2 connectors</td>
            <td class="p-5 text-slate-600">Good park and ride point before Sorrento.</td>
          </tr>
          <tr>
            <td class="p-5 font-bold">Massa Lubrense</td>
            <td class="p-5 text-slate-600">One listing at a restaurant in Sant'Agata sui Due Golfi and one point near Via Massa Turro in OpenStreetMap</td>
            <td class="p-5 text-slate-600">Very thin coverage towards Nerano and Marina del Cantone.</td>
          </tr>
        </tbody>
      </table>
    </div>

    <p class="text-slate-600 text-lg leading-relaxed mt-6">
      Two practical consequences. First, in high season a public charger in a village is also one of the very few parking spaces in that village, so expect it to be occupied, sometimes by a car that is not charging. Second, a point that shows as available in the app can be out of service: industry reporting puts the share of Italian and European stations out of order at any given moment at around one in five. Always have a plan B within your remaining range.
    </p>
  </div>

  <!-- Fast chargers -->
  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">Fast Chargers on the Way In</h2>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      The rule is simple: arrive on the coast full. The coast road has no confirmed DC fast charger that we could find, so the last fast charge should happen before you leave the motorway. These are the sites we could confirm from operator pages and specialist press:
    </p>
    <ul class="space-y-3 mb-6">
      <li class="flex items-start gap-3"><span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span><span class="text-slate-700"><strong>Tesla Supercharger, Mercato San Severino.</strong> Six stalls at a hotel just north of Salerno, open to other CCS cars. Tesla's page quoted around €0.47 to €0.49 per kWh for non-Tesla drivers. The most convenient fast stop if you enter the coast from Salerno or Vietri.</span></li>
      <li class="flex items-start gap-3"><span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span><span class="text-slate-700"><strong>Tesla Superchargers around Naples.</strong> Nola (Vulcano Buono), Naples West (Centro Commerciale Azzurro) and Afragola (Le Porte di Napoli), eight stalls each, open to other EVs.</span></li>
      <li class="flex items-start gap-3"><span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span><span class="text-slate-700"><strong>Free To X, Teano Ovest on the A1.</strong> Four 300 kW points in the service area, direction Naples, the obvious stop if you are driving down from Rome.</span></li>
      <li class="flex items-start gap-3"><span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span><span class="text-slate-700"><strong>Ionity.</strong> Battipaglia, south of Salerno, was listed as active with six chargers; a site at Afragola was announced. Check the Ionity app for current status.</span></li>
      <li class="flex items-start gap-3"><span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span><span class="text-slate-700"><strong>Naples city.</strong> A dedicated ultra-fast hub at the Mostra d'Oltremare (Viale Kennedy), announced with six high power chargers.</span></li>
      <li class="flex items-start gap-3"><span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span><span class="text-slate-700"><strong>Ewiva.</strong> The Enel X and Volkswagen joint venture is expanding on motorways; its July 2026 plan includes Angioina Ovest on the A30 Caserta-Salerno by 2027. Its stations take contactless cards.</span></li>
    </ul>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      We found no confirmed charging in the service areas of the A3 Napoli-Pompei-Salerno itself. Castellammare di Stabia, where the motorway ends for Sorrento, had six listed sites and Salerno twenty-six, but the maps did not tell us which of them are DC, so verify the power in the app before counting on a quick top-up there.
    </p>
  </div>

  <!-- Operators, apps and prices -->
  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">Operators, Apps and Prices</h2>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      Italy had about 84,500 public charging points by mid 2026 according to Motus-E, run by dozens of operators. The biggest networks you will meet in Campania are Enel X Way and Plenitude (which absorbed Be Charge), with Free To X and Ewiva on motorways and Tesla near the big cities. Many operators are interoperable, so one good app often starts sessions on several networks, but not always at the same price.
    </p>
    <ul class="space-y-3 mb-6">
      <li class="flex items-start gap-3"><span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span><span class="text-slate-700"><strong>An aggregator map.</strong> Electromaps, PlugShare or Chargemap, to see every operator in one view and read recent user check-ins.</span></li>
      <li class="flex items-start gap-3"><span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span><span class="text-slate-700"><strong>The official map.</strong> The Piattaforma Unica Nazionale (PUN), run for the Ministry of the Environment, shows public points with location, power, operator and status.</span></li>
      <li class="flex items-start gap-3"><span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span><span class="text-slate-700"><strong>One or two operator apps.</strong> Enel X Way and Plenitude cover most of the AC posts; add Free To X or the Tesla app for motorway and Supercharger stops.</span></li>
    </ul>

    <div class="overflow-x-auto rounded-[2rem] border border-slate-100 shadow-sm mb-6">
      <table class="w-full text-xs sm:text-sm">
        <thead class="bg-slate-900 text-white">
          <tr>
            <th class="text-left p-5 font-serif font-bold text-med-gold">Charger type</th>
            <th class="text-left p-5 font-serif font-bold text-med-gold">Average price, July 2026</th>
            <th class="text-left p-5 font-serif font-bold text-med-gold">Range between operators</th>
          </tr>
        </thead>
        <tbody class="bg-white">
          <tr class="border-b border-slate-100">
            <td class="p-5 font-bold">AC, up to 22 kW</td>
            <td class="p-5 text-slate-600">€0.63/kWh</td>
            <td class="p-5 text-slate-600">€0.53 to €0.84</td>
          </tr>
          <tr class="border-b border-slate-100">
            <td class="p-5 font-bold">DC fast, 50 to 150 kW</td>
            <td class="p-5 text-slate-600">€0.74/kWh</td>
            <td class="p-5 text-slate-600">€0.61 to €0.81</td>
          </tr>
          <tr>
            <td class="p-5 font-bold">HPC, over 150 kW</td>
            <td class="p-5 text-slate-600">€0.74/kWh</td>
            <td class="p-5 text-slate-600">€0.54 to €0.90</td>
          </tr>
        </tbody>
      </table>
    </div>
    <p class="text-slate-600 text-lg leading-relaxed">
      Figures are pay as you go averages from the Adiconsum-TariffEV observatory. Two details matter for visitors: paying by card at the post can cost noticeably more than the operator's app, and Italian rules let you stay in a charging bay for a maximum of one hour after the charge ends (the limit does not apply between 23:00 and 07:00, except on chargers above 22 kW). Overstaying, or parking in the bay without charging, can earn a fine.
    </p>
  </div>

  <!-- Hotels and parking -->
  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">Hotels, Garages and Charging Overnight</h2>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      On this coast the overnight charge at your accommodation is worth more than any public network. A growing number of hotels, villas and private garages have a wallbox or a dedicated socket, but it is rarely shown clearly in booking filters, and a hotel with "parking" may mean a valet who takes the car to a garage several kilometres away.
    </p>
    <ul class="space-y-3 mb-6">
      <li class="flex items-start gap-3"><span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span><span class="text-slate-700"><strong>Ask in writing.</strong> Is the charger on site or at a partner garage? What power? Is it shared with other guests, and can you book a slot? Is it included or charged per kWh or per night?</span></li>
      <li class="flex items-start gap-3"><span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span><span class="text-slate-700"><strong>Bring a Type 2 cable.</strong> Many destination chargers are untethered sockets.</span></li>
      <li class="flex items-start gap-3"><span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span><span class="text-slate-700"><strong>Check the ZTL.</strong> In Positano the internal road is a camera-controlled ZTL; in Amalfi, Ravello and Sorrento the centres are restricted too. If the hotel's parking or charger is inside, ask them to register your plate before you arrive.</span></li>
      <li class="flex items-start gap-3"><span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span><span class="text-slate-700"><strong>Garages.</strong> We found no published list of public garages with chargers on the coast. Ask the garage directly; some private car parks have a socket for regular customers even when no map shows it.</span></li>
    </ul>
    <p class="text-slate-600 text-lg leading-relaxed">
      Prices, opening hours and the main car parks for each town are in our <a href="/en-us/guide/parking-ztl/" class="text-med-blue hover:underline">parking and ZTL guide</a>.
    </p>
  </div>

  <!-- Alternate plates -->
  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">Alternate Plates and ZTL: No Free Pass for EVs</h2>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      On the SS163 the ANAS ordinance 340/2019 applies the alternate plates rule from 10:00 to 18:00 on set days between Easter and October: every day in August and September, and on weekends and holidays in June, July and October, plus the Easter and 25 April bridges. On an odd date only odd final digits may drive, on an even date only even ones.
    </p>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      The exemption lists we found for 2026 cover residents, taxis and chauffeur services, disabled badge holders, hotel guests with a booking on arrival and departure days, and motorbikes and scooters. <strong>None mentions electric cars.</strong> Some Sorrento Peninsula towns, which set their own rules on the SS145, have listed electric and plug-in hybrid cars among the exempt categories, but the details change by town and by year. Our <a href="/en-us/guide/alternate-license-plates/" class="text-med-blue hover:underline">alternate plates guide</a> has the 2026 calendar and the municipal rules.
    </p>
    <p class="text-slate-600 text-lg leading-relaxed">
      For a rented car, check the last digit of the plate as soon as you pick it up and plan the coast days around it. Outside the 10:00 to 18:00 window the road is open to everyone, and from 1 November there is no restriction until the next season.
    </p>
  </div>

  <!-- Rental -->
  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">Renting an EV in Naples or Salerno</h2>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      The main rental companies have desks at Naples airport, in the P5 car park reached by a free shuttle, and comparison sites list electric cars on offer in Naples. The catch is that EVs are usually sold as a category "or similar", so the exact model and its range are a surprise until the counter.
    </p>
    <ul class="space-y-3 mb-6">
      <li class="flex items-start gap-3"><span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span><span class="text-slate-700"><strong>Size matters more than range.</strong> On the SS163 a compact car is far easier to pass buses with and to park. A large SUV with a big battery is the wrong tool here.</span></li>
      <li class="flex items-start gap-3"><span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span><span class="text-slate-700"><strong>Check the return rule.</strong> Some contracts ask for the same charge level at return, others charge a fee below a threshold.</span></li>
      <li class="flex items-start gap-3"><span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span><span class="text-slate-700"><strong>Ask for a charging card or app.</strong> If the rental includes one, ask which networks it works on and at what price.</span></li>
    </ul>
    <p class="text-slate-600 text-lg leading-relaxed">
      If you are coming by train, renting in Salerno and entering the coast from Vietri avoids the Naples traffic entirely. Our <a href="/en-us/guide/getting-here/" class="text-med-blue hover:underline">getting here guide</a> compares the routes in.
    </p>
  </div>

  <!-- Sample plan -->
  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">A Sample Four-Day Plan</h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-6">
      <div class="bg-white p-6 rounded-[2rem] border border-slate-100 shadow-sm">
        <h4 class="font-bold text-slate-900 mb-2">Day 1: arrive full</h4>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Fast charge at Teano Ovest on the A1 or at a Supercharger around Naples, then motorway to Castellammare and the SS145 to <a href="/en-us/sorrento-peninsula/sorrento/" class="text-med-blue hover:underline">Sorrento</a>. Plug in overnight at the hotel.</p>
      </div>
      <div class="bg-white p-6 rounded-[2rem] border border-slate-100 shadow-sm">
        <h4 class="font-bold text-slate-900 mb-2">Day 2: the peninsula</h4>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Short loops to <a href="/en-us/sorrento-peninsula/massa-lubrense/" class="text-med-blue hover:underline">Massa Lubrense</a> and Nerano, or leave the car and take the boat to Capri. Almost no energy used.</p>
      </div>
      <div class="bg-white p-6 rounded-[2rem] border border-slate-100 shadow-sm">
        <h4 class="font-bold text-slate-900 mb-2">Day 3: the coast road</h4>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">On a day your plate is allowed, or before 10:00, drive to <a href="/en-us/amalfi-coast/positano/" class="text-med-blue hover:underline">Positano</a> and <a href="/en-us/amalfi-coast/praiano/" class="text-med-blue hover:underline">Praiano</a>, where the chargers are, then on to Amalfi. Or leave the car and use the <a href="/en-us/guide/sita-bus/" class="text-med-blue hover:underline">SITA bus</a> or the ferry.</p>
      </div>
      <div class="bg-white p-6 rounded-[2rem] border border-slate-100 shadow-sm">
        <h4 class="font-bold text-slate-900 mb-2">Day 4: out via Salerno</h4>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Ravello in the morning, then Maiori, Vietri and <a href="/en-us/amalfi-coast/salerno/" class="text-med-blue hover:underline">Salerno</a>. Fast charge at Mercato San Severino before the motorway home.</p>
      </div>
    </div>
    <p class="text-slate-600 text-lg leading-relaxed">
      The same logic works in reverse, and with a base in Praiano or Maiori instead of Sorrento. What does not work well is relying on a public post in a village to fill the battery in the middle of an August day.
    </p>
  </div>

  <!-- Verdict -->
  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">The Honest Verdict</h2>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      An electric road trip on the Amalfi Coast is feasible, and from October to May it is easy: quiet roads, empty charging bays, no plate restrictions after October. In July and August it is feasible but only with a charger where you sleep, because public points are few, slow and contested, and there is no fast charger on the coast road to save you.
    </p>
    <blockquote class="border-l-4 border-med-gold pl-6 my-8">
      <p class="text-slate-700 text-xl font-serif italic leading-relaxed">
        "On this coast the battery is never the problem. The parking space next to the charger is."
      </p>
    </blockquote>
    <p class="text-slate-600 text-lg leading-relaxed">
      And remember that a car of any kind is optional here. Many visitors park in Sorrento, Vietri or Salerno and move along the coast by bus, ferry and on foot, which is often faster in summer. Our guide to <a href="/en-us/blog/amalfi-coast-by-train/" class="text-med-blue hover:underline">the Amalfi Coast by train</a> covers that option.
    </p>
  </div>

  <!-- Local Tips -->
  <div class="bg-white p-8 rounded-[2rem] shadow-xl border border-slate-100">
    <div class="flex items-center gap-4 mb-6">
      <svg class="w-6 h-6 text-med-gold flex-shrink-0" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M9 18h6"/><path d="M10 22h4"/><path d="M15.09 14c.18-.98.65-1.74 1.41-2.5A4.65 4.61 0 0 0 18 8 6 6 0 0 0 6 8c0 1 .23 2.23 1.5 3.5A4.61 4.61 0 0 1 8.91 14"/></svg>
      <h3 class="text-xl font-bold">Expert Tips</h3>
    </div>
    <div class="space-y-6">
      <div>
        <p class="font-bold text-slate-900 mb-1">Never arrive below half</p>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Arrive on the coast with at least 50 to 60 percent and you can ignore public charging for two or three days of local driving. Arrive at 15 percent and your holiday starts with a hunt for a free post.</p>
      </div>
      <div>
        <p class="font-bold text-slate-900 mb-1">Charge early in the morning</p>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Village posts are most often free before 09:00, when day trippers have not arrived yet. It also keeps you off the SS163 during the 10:00 to 18:00 restriction window on plate days.</p>
      </div>
      <div>
        <p class="font-bold text-slate-900 mb-1">Use the car less, not more</p>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Once you are parked and charging, leave the car. Positano to Amalfi is easier by ferry in summer, and the Path of the Gods is a walk, not a drive.</p>
      </div>
      <div>
        <p class="font-bold text-slate-900 mb-1">Check the map the night before</p>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">The data in this article was checked on 16 October 2026. Charging maps change monthly, so look at recent check-ins in your app and at the PUN map before each drive.</p>
      </div>
    </div>
  </div>

  <!-- Sources -->
  <div>
    <h2 class="font-serif text-2xl font-bold text-slate-900 mb-4">How We Checked</h2>
