---
import BlogPostLayout from '../../../../layouts/BlogPostLayout.astro';

const lang = 'en-us';
const post = {
  title: 'Crapolla Fjord',
  subtitle: 'The Hidden Treasure Among the 700 Steps',
  category: 'DISCOVERIES',
  date: 'May 15, 2026',
  readTime: '12 min',
  image: '/images/fiordo-crapolla-hero.jpg',
  imageAlt: 'Crapolla Fjord - Massa Lubrense, Sorrentine Peninsula',
  path: '/en-us/blog/fiordo-di-crapolla/',
};

const metaTitle = 'Crapolla Fjord: The Hidden Treasure of the Sorrentine Peninsula 2026';
const metaDescription = 'Complete guide to Crapolla Fjord: 700 steps, medieval chapel, Roman ruins, archaeological history and practical tips for visiting this secret location in Massa Lubrense.';

const breadcrumbs = [
  { name: 'Home', url: '/en-us/' },
  { name: 'Blog', url: '/en-us/blog/' },
  { name: 'Crapolla Fjord', url: '/en-us/blog/fiordo-di-crapolla/' },
];

const quickInfo = [
  { label: 'Starting Point', value: 'Via Casal di Torca (Massa Lubrense)' },
  { label: 'Number of Steps', value: '~700 (natural stone)' },
  { label: 'Elevation Drop', value: 'Approx. 525 feet (160 meters)' },
  { label: 'Difficulty', value: 'Medium/High (due to physical effort of ascent)' },
  { label: 'Water', value: 'None on site (bring at least 2 liters)' },
  { label: 'Time Down', value: 'Approx. 45-60 minutes' },
  { label: 'What to See', value: 'Chapel of San Pietro, Roman remains, monazeni cavities' },
  { label: 'Best Season', value: 'April-June, September-October' },
];

const faq = [
  {
    q: 'What is the exact number of steps?',
    a: 'There is no precise number: the count varies between 680 and 700 depending on the starting point and how the last steps are counted. Most visitors report approximately 700 steps.',
  },
  {
    q: 'How long does the climb up take?',
    a: 'The ascent generally requires 60-90 minutes. It depends on your fitness level and the time of day (in the hot months, the heat from the stone significantly slows your pace).',
  },
  {
    q: 'Is it mandatory to bring water?',
    a: 'Absolutely yes. There are no fountains or refreshment stands along the route. Bring at least 2 liters per person, more in summer.',
  },
  {
    q: 'Are there dangers along the path?',
    a: 'The route is not technically difficult, but limestone can be slippery, especially with unsuitable shoes. Always use hiking boots with good grip.',
  },
  {
    q: 'Can I swim?',
    a: 'Yes, the water is crystalline and the beach is wonderful. The area is part of the Punta Campanella Marine Reserve, so the ecosystem is preserved.',
  },
  {
    q: 'Do I need to book or ask permission?',
    a: 'No reservation is necessary. It is a public area, but remember to take your trash with you and respect the environment.',
  },
];

const sidebarLinks = [
  { label: 'Massa Lubrense', href: '/en-us/sorrento-peninsula/' },
  { label: 'Punta Campanella', href: '/en-us/blog/punta-campanella/' },
  { label: 'When to Visit', href: '/en-us/' },
  { label: 'How to Get There', href: '/en-us/guide/getting-here/' },
];

const relatedArticles = [
  {
    title: 'Punta Campanella',
    category: 'DISCOVERIES',
    date: 'May 10, 2026',
    image: '/images/punta-campanella-hero.jpg',
    imageAlt: 'Punta Campanella - Massa Lubrense, Sorrentine Peninsula',
    path: '/en-us/blog/punta-campanella/'
  },
  {
    title: 'Ferriere Valley: Trekking in the Green Heart of Amalfi',
    category: 'DISCOVERIES',
    date: 'April 22, 2026',
    image: '/images/valle-ferriere-hero.jpg',
    imageAlt: 'Waterfall in Ferriere Valley, Amalfi - Amalfi Coast',
    path: '/en-us/blog/ferriere-valley/'
  }
];

const authorRole = 'Archaeology & Trekking Guide · Sorrentine Peninsula';

const keyTakeaways = [
  'Crapolla Fjord is not just a secret beach, but a natural and archaeological monument with roots dating back to classical times, dedicated to the god Apollo.',
  'The ~700 limestone steps were constructed with ancient wisdom to overcome a dizzying elevation change of about 525 feet (160 meters), and remain the distinctive feature of the place.',
  'The Chapel of San Pietro stands on the remains of a pagan temple dedicated to Apollo; in the Middle Ages, an important Benedictine abbey flourished here.',
  'The monazeni (cavities carved into the rock by the Romans) testify to how the place was used for centuries as a natural shelter and boat storage facility.',
  'The ideal time to visit is between 6:00 AM and 12:00 PM in summer, avoiding the scorching heat of the limestone during the central hours of the day.',
];

const videoSchema = {
  "@context": "https://schema.org",
  "@type": "VideoObject",
  "name": "Crapolla Fjord: The Hidden Treasure Among the 700 Steps",
  "description": "Video of Crapolla Fjord - one of the most fascinating places on the Sorrentine Peninsula with its 700 limestone steps, the Chapel of San Pietro and ancient archaeological history.",
  "thumbnailUrl": "/images/fiordo-crapolla-hero.jpg",
  "uploadDate": "2026-05-15",
  "duration": "PT1M30S",
  "contentUrl": "/videos/fiordo-crapolla-video.mp4",
  "videoDetails": {
    "width": "1280",
    "height": "720"
  }
};
---

<BlogPostLayout
  lang={lang}
  post={post}
  metaTitle={metaTitle}
  metaDescription={metaDescription}
  breadcrumbs={breadcrumbs}
  quickInfo={quickInfo}
  faq={faq}
  sidebarLinks={sidebarLinks}
  authorRole={authorRole}
  relatedArticles={relatedArticles}
  schema={[videoSchema]}
  pageKey="fiordo-di-crapolla"
>

  <!-- Key Takeaways -->
  <div class="bg-slate-900 text-white p-8 rounded-[2rem]">
    <div class="flex items-center gap-3 mb-6">
      <svg class="w-5 h-5 text-med-gold flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
      <h2 class="font-serif text-lg font-bold text-med-gold uppercase tracking-[0.15em]">Key Takeaways</h2>
    </div>
    <ul class="space-y-4">
      {keyTakeaways.map((point) => (
        <li class="flex items-start gap-3">
          <span class="w-1.5 h-1.5 rounded-full bg-med-gold flex-shrink-0 mt-2"></span>
          <span class="text-white/80 text-xs sm:text-sm leading-relaxed">{point}</span>
        </li>
      ))}
    </ul>
  </div>

  <!-- Intro -->
  <div>
    <p class="text-slate-600 text-xl leading-relaxed mb-6 font-light">
      While most tourists crowd the streets of <a href="/en-us/amalfi-coast/positano/" class="text-med-blue hover:underline">Positano</a> or the piers of Sorrento, there is an inlet carved into the rock that preserves the intact charm of a lost Italy. The Crapolla Fjord, in the municipality of <a href="/en-us/sorrento-peninsula/massa-lubrense/" class="text-med-blue hover:underline">Massa Lubrense</a>, is not just a beach: it is an open-air natural and archaeological monument, protected by towering cliffs and accessible only to those willing to "earn it" with a long hike.
    </p>
  </div>

  <!-- Video Section -->
  <div class="rounded-[2rem] shadow-xl mb-8 flex justify-center bg-slate-900 py-4">
    <video muted="muted"
      controls controlsList="nofullscreen" id="disable-audio"
      poster="/images/fiordo-crapolla-hero.jpg"
      class="max-w-full max-h-[500px]"
      width="1280"
      height="720"
    >
      <source src="/videos/fiordo-crapolla-video.mp4?v=2" type="video/mp4" />
      Your browser does not support the video tag. Please download the video to view it.
    </video>
    <script>
      let video = document.getElementById("disable-audio");
      if (!video) video = document.querySelector('video');
      if (video) {
        const forceMuted = () => {
          video.muted = true;
          video.volume = 0;
        };
        forceMuted();
        video.addEventListener('play', forceMuted);
        video.addEventListener('playing', forceMuted);
        video.addEventListener('volumechange', forceMuted);
        video.addEventListener('timeupdate', forceMuted);
        video.addEventListener('seeked', forceMuted);
      }
    </script>
  </div>

  <!-- The Path -->
  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">The Path: Between Mediterranean Scrub and Myths</h2>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      The journey begins in the small village of Torca. From here, you take a path that winds through ancient dry-stone walls, vegetable gardens, and typical coastal vegetation dominated by the scent of myrtle, mastic, and broom. The route offers a privileged view of the Li Galli archipelago (the legendary islands of the Sirens) and the island of Isca, the rock loved and purchased by the great playwright Eduardo De Filippo.
    </p>

    <div class="bg-white p-8 rounded-[2rem] border border-slate-100 shadow-sm my-6">
      <h3 class="font-serif text-xl font-bold text-slate-900 mb-4">The Challenge of the 700 Steps</h3>
      <p class="text-slate-600 leading-relaxed mb-4">
        The defining feature of Crapolla is its incredible staircase. To reach the sea, you must descend approximately 700 limestone steps (the precise count often varies between 680 and 700 depending on the starting point). Each step was laid with ancient wisdom to overcome the dizzying drop of the cliff.
      </p>
      <p class="text-slate-600 leading-relaxed">
        Along the descent, you will find small majolica tiles indicating the number of steps taken-a detail that becomes crucial (and psychologically demanding) during the climb back up.
      </p>
    </div>
  </div>

  <!-- The Chapel -->
  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">The Church Below: St. Peter and the Temple of Apollo</h2>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      Near the end of the staircase, before touching the sand, you come across a place of absolute peace: the Chapel of San Pietro. This small white church stands in an extraordinary panoramic position, but its importance is historical even before it is religious.
    </p>

    <div class="space-y-6 mb-8">
      <div class="bg-white p-6 rounded-[2rem] border border-slate-100 shadow-sm">
        <h4 class="font-bold text-slate-900 mb-2">Classical Roots</h4>
        <p class="text-slate-600 text-sm leading-relaxed">The name "Crapolla" likely derives from Acra-Apollo, the promontory dedicated to the god Apollo. The church stands directly on the remains of an ancient pagan temple dedicated to the sun god.</p>
      </div>
      <div class="bg-white p-6 rounded-[2rem] border border-slate-100 shadow-sm">
        <h4 class="font-bold text-slate-900 mb-2">St. Peter's Abbey</h4>
        <p class="text-slate-600 text-sm leading-relaxed">In the Middle Ages, an important Benedictine abbey flourished here. Today, marble columns and Roman architectural bases remain visible, repurposed in the construction of the chapel.</p>
      </div>
      <div class="bg-white p-6 rounded-[2rem] border border-slate-100 shadow-sm">
        <h4 class="font-bold text-slate-900 mb-2">The Legend</h4>
        <p class="text-slate-600 text-sm leading-relaxed">It is said that St. Peter the Apostle, on his journey to Rome to evangelize the West, stopped in this very inlet, finding there his first safe landing.</p>
      </div>
    </div>

    <blockquote class="border-l-4 border-med-gold pl-6 my-8">
      <p class="text-slate-700 text-xl font-serif italic leading-relaxed">
        "Crapolla is where classical history, medieval Christian history, and wild nature meet in an incredibly small and untouched space."
      </p>
    </blockquote>
  </div>

  <!-- The Fishing Village -->
  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">The Fishing Village and the Beach</h2>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      At the bottom, you will be greeted by the remains of an ancient fishing village. Here you will find the monazeni: cavities carved into the rock by the Romans and used for centuries to store boats. The beach is a small patch of white pebbles where the water is of crystalline purity, typical of the <a href="/en-us/blog/punta-campanella/" class="text-med-blue hover:underline">Punta Campanella</a> Marine Protected Area.
    </p>

    <div class="overflow-hidden rounded-[2rem] border border-slate-100 shadow-sm">
      <table class="w-full text-xs sm:text-sm">
        <thead class="bg-slate-900 text-white">
          <tr>
            <th class="text-left p-5 font-serif font-bold text-med-gold">Feature</th>
            <th class="text-left p-5 font-serif font-bold text-med-gold">Details</th>
          </tr>
        </thead>
        <tbody class="bg-white">
          <tr class="border-b border-slate-100">
            <td class="p-5 font-bold text-slate-900">Starting Point</td>
            <td class="p-5 text-slate-600">Via Casal di Torca (Massa Lubrense)</td>
          </tr>
          <tr class="border-b border-slate-100">
            <td class="p-5 font-bold text-slate-900">Number of Steps</td>
            <td class="p-5 text-slate-600">~700 (natural stone)</td>
          </tr>
          <tr class="border-b border-slate-100">
            <td class="p-5 font-bold text-slate-900">Elevation Drop</td>
            <td class="p-5 text-slate-600">Approx. 525 feet (160 meters)</td>
          </tr>
          <tr class="border-b border-slate-100">
            <td class="p-5 font-bold text-slate-900">Difficulty</td>
            <td class="p-5 text-slate-600">Medium/High (due to physical effort of ascent)</td>
          </tr>
          <tr>
            <td class="p-5 font-bold text-slate-900">Water</td>
            <td class="p-5 text-slate-600">None on site (bring at least 2 liters per person)</td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>

  <!-- Expert Tips -->
  <div class="bg-white p-8 rounded-[2rem] shadow-xl border border-slate-100">
    <div class="flex items-center gap-4 mb-6">
      <svg class="w-6 h-6 text-med-gold flex-shrink-0" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M9 18h6"/><path d="M10 22h4"/><path d="M15.09 14c.18-.98.65-1.74 1.41-2.5A4.65 4.65 0 0 0 18 8 6 6 0 0 0 6 8c0 1 .23 2.23 1.5 3.5A4.61 4.61 0 0 1 8.91 14"/></svg>
      <h3 class="text-xl font-bold text-slate-900">Expert Tips</h3>
    </div>
    <div class="space-y-6">
      <div>
        <p class="font-bold text-slate-900 mb-1">The Best Time</p>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Avoid the climb between 12:00 PM and 4:00 PM in summer. The staircase faces south and the heat retained by the limestone can be grueling.</p>
      </div>
      <div>
        <p class="font-bold text-slate-900 mb-1">Footwear</p>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Don't make the mistake of descending in flip-flops. The stone is slippery and the steps are irregular. Use hiking or athletic shoes with good grip.</p>
      </div>
      <div>
        <p class="font-bold text-slate-900 mb-1">Respect</p>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Crapolla is an archaeological and natural site. Take your trash with you: there are no cleaning services here and the beauty of the place depends on the respect of those who visit it.</p>
      </div>
    </div>
  </div>

</BlogPostLayout>
