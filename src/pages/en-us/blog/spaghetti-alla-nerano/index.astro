---
import BlogPostLayout from '../../../../layouts/BlogPostLayout.astro';

const lang = 'en-us';
const post = {
  title: 'Spaghetti alla Nerano',
  subtitle: 'The fried zucchini pasta born in a tiny bay in 1952, and where to eat the original today',
  category: 'FOOD',
  date: 'August 17, 2026',
  readTime: '8 min',
  image: '/images/nerano-hero.webp',
  imageAlt: 'Spaghetti alla Nerano, the fried zucchini pasta of Marina del Cantone',
  path: '/en-us/blog/spaghetti-alla-nerano/',
};

const metaTitle = 'Spaghetti alla Nerano: Where to Eat the Original | Guide 2026';
const metaDescription = 'The dish was invented in Nerano in 1952 at Ristorante Maria Grazia. Where to eat it at Marina del Cantone, how to reach the bay from Sorrento by SITA bus or boat, and what makes it different from ordinary zucchini pasta.';

const breadcrumbs = [
  { name: 'Home', url: '/en-us/' },
  { name: 'Blog', url: '/en-us/blog/' },
  { name: 'Spaghetti alla Nerano', url: '/en-us/blog/spaghetti-alla-nerano/' },
];

const quickInfo = [
  { label: 'Dish', value: 'Spaghetti with fried zucchini and cheese' },
  { label: 'Born in', value: 'Nerano, Marina del Cantone (1952)' },
  { label: 'Created by', value: 'Donna Rosa, Ristorante Maria Grazia' },
  { label: 'Where', value: 'Massa Lubrense, Sorrentine Peninsula' },
  { label: 'Key cheese', value: 'Provolone del Monaco PDO or local caciotta' },
  { label: 'From Sorrento', value: 'About 50 min by SITA bus' },
  { label: 'Booking', value: 'Essential in July and August' },
  { label: 'Best season', value: 'June to September, for the zucchini' },
];

const faq = [
  {
    q: 'Where was Spaghetti alla Nerano invented?',
    a: 'At Ristorante Maria Grazia in Marina del Cantone, the small bay below the village of Nerano, in the municipality of Massa Lubrense. The dish was created in 1952 by Donna Rosa, and the restaurant, founded in 1901, is still run by her descendants.',
  },
  {
    q: 'Where should I eat it in Nerano?',
    a: 'Maria Grazia is the original and the reason the dish carries the name of the village. Lo Scoglio da Tommaso, right on the water in the same bay, is the other well-known address and became famous internationally after Stanley Tucci filmed there. Both sit on Marina del Cantone, a few minutes apart on foot.',
  },
  {
    q: 'How do I get to Nerano from Sorrento?',
    a: 'By SITA bus from Sorrento station, roughly 50 minutes, sometimes with a change at Sant\'Agata sui Due Golfi. By car it is about a 30 minute drive, but parking at Marina del Cantone is limited and paid in summer. Many visitors arrive by boat from Sorrento, Positano or Capri.',
  },
  {
    q: 'What cheese goes into Spaghetti alla Nerano?',
    a: 'The traditional choice is Provolone del Monaco PDO, the aged cow\'s milk cheese of the Sorrentine Peninsula, sometimes combined with or replaced by a local caciotta. The cheese is what gives the sauce its body: there is no cream in the original.',
  },
  {
    q: 'Why is it different from ordinary zucchini pasta?',
    a: 'Two things. The zucchini are fried separately and left to rest, so they soften and concentrate rather than steam. Then the sauce is built by emulsifying grated cheese with starchy pasta water off the heat, which produces a glossy coating instead of a watery one.',
  },
  {
    q: 'Do I need to book?',
    a: 'Yes, in high season. Marina del Cantone is a very small bay with a handful of restaurants and it fills with both road and boat arrivals. For July and August, book well in advance, especially for a table at lunch.',
  },
];

const sidebarLinks = [
  { label: 'Marina del Cantone', href: '/en-us/beaches/sorrentine-peninsula/marina-del-cantone/' },
  { label: 'Massa Lubrense', href: '/en-us/sorrento-peninsula/massa-lubrense/' },
  { label: 'Baia di Recommone', href: '/en-us/blog/baia-recommone/' },
  { label: 'SITA Bus', href: '/en-us/guide/sita-bus/' },
  { label: 'Punta Campanella', href: '/en-us/blog/punta-campanella/' },
];

const authorRole = 'Food & Travel Specialist · Amalfi Coast';

const relatedArticles = [
  {
    title: 'Cetara Anchovies: The Silver Gold of the Amalfi Coast',
    category: 'FOOD',
    date: 'April 4, 2026',
    image: '/images/alici-cetara-hero.webp',
    imageAlt: 'Cetara Anchovies and Colatura PDO - Amalfi Coast',
    path: '/en-us/blog/cetara-anchovies/'
  },
  {
    title: 'Scialatielli: The Amalfi Coast\'s Iconic Fresh Pasta',
    category: 'FOOD',
    date: 'May 27, 2026',
    image: '/images/scialatielli-hero.webp',
    imageAlt: 'Scialatielli, the fresh pasta of the Amalfi Coast',
    path: '/en-us/blog/scialatielli/'
  }
];

const keyTakeaways = [
  'Spaghetti alla Nerano was created in 1952 by Donna Rosa at Ristorante Maria Grazia, in the bay of Marina del Cantone below the village of Nerano.',
  'The village belongs to Massa Lubrense, on the Sorrentine Peninsula, not to the Amalfi Coast proper, which is why so many visitors never find it.',
  'The sauce is built on fried zucchini and grated cheese emulsified with pasta water. There is no cream in the original version.',
  'Maria Grazia is the birthplace of the dish; Lo Scoglio da Tommaso, in the same bay, is the address that Stanley Tucci made famous abroad.',
  'Reaching Nerano takes about 50 minutes by SITA bus from Sorrento, and booking is essential at lunch in July and August.',
];
---

<BlogPostLayout
  lang={lang}
  post={post}
  metaTitle={metaTitle}
  metaDescription={metaDescription}
  breadcrumbs={breadcrumbs}
  quickInfo={quickInfo}
  faq={faq}
  sidebarLinks={sidebarLinks}
  authorRole={authorRole}
  relatedArticles={relatedArticles}
  pageKey="spaghetti-alla-nerano"
>

  <!-- Key Takeaways -->
  <div class="bg-slate-900 text-white p-8 rounded-[2rem]">
    <div class="flex items-center gap-3 mb-6">
      <svg class="w-5 h-5 text-med-gold flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
      <h2 class="font-serif text-lg font-bold text-med-gold uppercase tracking-[0.15em]">Key Takeaways</h2>
    </div>
    <ul class="space-y-4">
      {keyTakeaways.map((point) => (
        <li class="flex items-start gap-3">
          <span class="w-1.5 h-1.5 rounded-full bg-med-gold flex-shrink-0 mt-2"></span>
          <span class="text-white/80 text-xs sm:text-sm leading-relaxed">{point}</span>
        </li>
      ))}
    </ul>
  </div>

  <!-- Intro -->
  <div>
    <p class="text-slate-600 text-xl leading-relaxed mb-6 font-light">
      Most famous Italian dishes are named after a city. This one is named after a hamlet of a few hundred people, hidden on the far tip of the Sorrentine Peninsula. Nerano sits above a bay called <a href="/en-us/beaches/sorrentine-peninsula/marina-del-cantone/" class="text-med-blue hover:underline">Marina del Cantone</a>, facing Capri, and the pasta that carries its name was invented there in a single kitchen, on a single evening, in 1952. Almost every restaurant between Naples and Salerno now serves a version of it. Only one place can claim the original.
    </p>
  </div>

  <!-- Origin -->
  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">Nerano, 1952: How the Dish Was Born</h2>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      The kitchen belonged to <strong>Ristorante Maria Grazia</strong>, a family business opened in 1901 on the beach at Marina del Cantone. The cook was Donna Rosa, and the dish she put together in 1952 used what the vegetable garden and the local dairy could supply: zucchini, cheese, basil, olive oil. Nothing that had to be shipped in, which on a road this steep mattered a great deal.
    </p>
    <p class="text-slate-600 text-lg leading-relaxed mb-8">
      The restaurant is still run by her descendants, and the family has always kept the finishing of the sauce to itself. That reticence is part of the legend, but the real reason the dish travelled is simpler: the bay became a mooring point for boats coming from Capri and <a href="/en-us/amalfi-coast/positano/" class="text-med-blue hover:underline">Positano</a>, and the people stepping off them carried the name back home.
    </p>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div class="bg-white p-6 rounded-[2rem] border border-slate-100 shadow-sm">
        <h4 class="font-bold text-slate-900 mb-2">A village, not a town</h4>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Nerano is a frazione of <a href="/en-us/sorrento-peninsula/massa-lubrense/" class="text-med-blue hover:underline">Massa Lubrense</a>, which is made up of seventeen such hamlets scattered across the headland. It has no centre in the usual sense, just a square and a road down to the water.</p>
      </div>
      <div class="bg-white p-6 rounded-[2rem] border border-slate-100 shadow-sm">
        <h4 class="font-bold text-slate-900 mb-2">Not the Amalfi Coast</h4>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">The bay faces the Gulf of Salerno but belongs administratively to the Sorrentine Peninsula. Travellers who search only along the Amalfi road never reach it, which is precisely why it stayed small.</p>
      </div>
    </div>
  </div>

  <!-- Where to eat -->
  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">Where to Eat Spaghetti alla Nerano in Nerano</h2>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      Both of the addresses that matter are on the same short stretch of beach, a few minutes apart on foot. They are very different experiences, and the choice is genuinely a matter of what you are after.
    </p>

    <div class="overflow-hidden rounded-[2rem] border border-slate-100 shadow-sm">
      <table class="w-full text-xs sm:text-xs sm:text-sm">
        <thead class="bg-slate-900 text-white">
          <tr>
            <th class="text-left p-5 font-serif font-bold text-med-gold">Restaurant</th>
            <th class="text-left p-5 font-serif font-bold text-med-gold">What to know</th>
          </tr>
        </thead>
        <tbody class="bg-white">
          <tr class="border-b border-slate-100">
            <td class="p-5 font-bold">Maria Grazia</td>
            <td class="p-5 text-slate-600">The birthplace. Open since 1901, still in the family, and the reason the dish is called alla Nerano at all. Come here for the version the recipe descends from rather than for the view.</td>
          </tr>
          <tr class="border-b border-slate-100">
            <td class="p-5 font-bold">Lo Scoglio da Tommaso</td>
            <td class="p-5 text-slate-600">Built out over the water on its own jetty, with produce from the family garden. Filmed by Stanley Tucci for "Searching for Italy", which is why it is now booked out months ahead in summer.</td>
          </tr>
          <tr>
            <td class="p-5 font-bold">Everywhere else</td>
            <td class="p-5 text-slate-600">You will find the dish on menus all along both coasts. Treat those as interpretations. If a kitchen serves it with cream, it is not following the Nerano method.</td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>

  <!-- Getting there -->
  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">How to Reach Nerano and Marina del Cantone</h2>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      The bay is roughly 30 minutes from Sorrento by road, but the road is narrow and the last stretch drops sharply to the sea. Choose your method before you go rather than on the day.
    </p>

    <div class="bg-white p-8 rounded-[2rem] border border-slate-100 shadow-sm">
      <h3 class="font-serif text-xl font-bold text-slate-900 mb-5">Three ways down to the bay</h3>
      <div class="space-y-3">
        <div class="flex items-start gap-3">
          <div class="w-6 h-6 rounded-full bg-med-gold/15 flex-shrink-0 flex items-center justify-center text-med-gold font-bold text-xs">1</div>
          <p class="text-slate-600 text-xs sm:text-sm leading-relaxed"><strong>By <a href="/en-us/guide/sita-bus/" class="text-med-blue hover:underline">SITA bus</a></strong> from Sorrento station, about 50 minutes. Some runs require a change at Sant'Agata sui Due Golfi, so check the timetable for the direct Nerano service.</p>
        </div>
        <div class="flex items-start gap-3">
          <div class="w-6 h-6 rounded-full bg-med-gold/15 flex-shrink-0 flex items-center justify-center text-med-gold font-bold text-xs">2</div>
          <p class="text-slate-600 text-xs sm:text-sm leading-relaxed"><strong>By car</strong>, about 30 minutes from Sorrento through Massa Lubrense. Parking at Marina del Cantone is limited and paid, and in August it is full by mid morning.</p>
        </div>
        <div class="flex items-start gap-3">
          <div class="w-6 h-6 rounded-full bg-med-gold/15 flex-shrink-0 flex items-center justify-center text-med-gold font-bold text-xs">3</div>
          <p class="text-slate-600 text-xs sm:text-sm leading-relaxed"><strong>By boat</strong> from Sorrento, Positano or Capri. This is how most people arrive in summer, and several restaurants have their own moorings.</p>
        </div>
      </div>
    </div>
  </div>

  <!-- The technique -->
  <div>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">What Makes It Different from Ordinary Zucchini Pasta</h2>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      The ingredient list is almost embarrassingly short, so everything rests on method. Two steps separate the real thing from a plate of pasta with courgettes.
    </p>
    <p class="text-slate-600 text-lg leading-relaxed mb-6">
      First, the zucchini are <strong>fried separately and left to rest</strong>, often for hours. They collapse and sweeten instead of steaming in the pan, and the oil they release carries their flavour into the finished sauce. Second, the sauce is finished off the heat: grated cheese, traditionally <strong>Provolone del Monaco PDO</strong> from the peninsula or a local caciotta, is emulsified with starchy pasta water until it coats rather than pools.
    </p>

    <blockquote class="border-l-4 border-med-gold pl-6 my-8">
      <p class="text-slate-700 text-xl font-serif italic leading-relaxed">
        "There is no cream in Spaghetti alla Nerano. What looks like cream is cheese, water and patience."
      </p>
    </blockquote>
  </div>

  <!-- Local Tips -->
  <div class="bg-white p-8 rounded-[2rem] shadow-xl border border-slate-100">
    <div class="flex items-center gap-4 mb-6">
      <svg class="w-6 h-6 text-med-gold flex-shrink-0" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M9 18h6"/><path d="M10 22h4"/><path d="M15.09 14c.18-.98.65-1.74 1.41-2.5A4.65 4.65 0 0 0 18 8 6 6 0 0 0 6 8c0 1 .23 2.23 1.5 3.5A4.61 4.61 0 0 1 8.91 14"/></svg>
      <h3 class="text-xl font-bold">Expert Tips</h3>
    </div>
    <div class="space-y-6">
      <div>
        <p class="font-bold text-slate-900 mb-1">Book before you travel, not on arrival</p>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Marina del Cantone has only a handful of restaurants and receives arrivals by road and by sea at the same time. In July and August, lunch tables at the two historic addresses go months in advance.</p>
      </div>
      <div>
        <p class="font-bold text-slate-900 mb-1">Come for the zucchini season</p>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">The dish depends entirely on the quality of the vegetable, so it is at its best from June to September. Out of season you will still be served it, but with produce that did not grow on the headland.</p>
      </div>
      <div>
        <p class="font-bold text-slate-900 mb-1">Make a day of the bay</p>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">Lunch pairs naturally with a swim. <a href="/en-us/blog/baia-recommone/" class="text-med-blue hover:underline">Baia di Recommone</a> is the next cove along, and the trail to the Bay of Ieranto starts from Nerano's square and runs out towards <a href="/en-us/blog/punta-campanella/" class="text-med-blue hover:underline">Punta Campanella</a> with Capri ahead of you the whole way.</p>
      </div>
    </div>
  </div>

</BlogPostLayout>
