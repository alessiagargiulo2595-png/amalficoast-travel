---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import CorrelationSlider from '../../../../components/CorrelationSlider.astro';
import Breadcrumbs from '../../../../components/Breadcrumbs.astro';

const lang = 'en-us';

const breadcrumbs = [
  { name: 'Home', url: '/en-us/' },
  { name: 'Gulf Islands', url: '/en-us/islands/' },
  { name: 'Anacapri', url: '/en-us/islands/anacapri/' },
];

const touristAttractionSchema = {
  "@context": "https://schema.org",
  "@type": "TouristAttraction",
  "name": "Anacapri",
  "description": "Anacapri is the higher municipality of the island of Capri: Villa San Michele, chairlift to Monte Solaro (589 m), Church of San Michele and breathtaking panoramas over the Gulf of Naples.",
  "url": "https://amalficoast-travel.com/en-us/islands/anacapri/",
  "touristType": ["Culture", "Nature", "Hiking", "Panoramas"],
  "address": { "@type": "PostalAddress", "addressLocality": "Anacapri", "addressRegion": "Napoli", "addressCountry": "IT", "postalCode": "80071" },
  "geo": { "@type": "GeoCoordinates", "latitude": 40.5520, "longitude": 14.2150 }
};

const placeSchema = {
  "@context": "https://schema.org",
  "@type": "Place",
  "name": "Anacapri, Island of Capri",
  "geo": { "@type": "GeoCoordinates", "latitude": 40.5520, "longitude": 14.2150 },
  "containedInPlace": { "@type": "AdministrativeArea", "name": "Island of Capri" }
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "How do you get to Anacapri from Marina Grande?",
      "acceptedAnswer": { "@type": "Answer", "text": "From Marina Grande you take the ATC bus directly to Anacapri (about 15 minutes, ticket ~2 euros). Alternatively you can take the funicular to Capri town centre and then the bus to Anacapri. Open-air taxis cost around 20-25 euros." }
    },
    {
      "@type": "Question",
      "name": "How much does the Monte Solaro chairlift cost?",
      "acceptedAnswer": { "@type": "Answer", "text": "The single-seat chairlift from Piazza Vittoria in Anacapri costs around 12 euros return (8 euros one way). The ascent takes about 12 minutes with spectacular views. At the top there is a bar and the highest viewpoint on the island at 589 metres." }
    },
    {
      "@type": "Question",
      "name": "Is Villa San Michele worth visiting?",
      "acceptedAnswer": { "@type": "Answer", "text": "Absolutely yes. Villa San Michele, built by Swedish physician Axel Munthe on the ruins of a medieval chapel and a Roman villa of Tiberius, is one of the most evocative places on Capri. The garden with the Egyptian sphinx and the panoramic terrace overlooking the Gulf of Naples are unforgettable. Entrance around 8 euros." }
    },
    {
      "@type": "Question",
      "name": "Anacapri vs Capri: what is the difference?",
      "acceptedAnswer": { "@type": "Answer", "text": "Anacapri is the upper municipality of the island (about 275 m above sea level), quieter, greener and more authentic. Capri town is more glamorous, with the Piazzetta, luxury shops and nightlife. Anacapri is ideal for those seeking nature, panoramas and a more relaxed pace." }
    },
    {
      "@type": "Question",
      "name": "Can you reach the Blue Grotto from Anacapri?",
      "acceptedAnswer": { "@type": "Answer", "text": "Yes. From Anacapri you can reach the entrance to the Blue Grotto on foot (about 30 minutes downhill) or by bus to Grotta Azzurra. The boat entry costs around 14 euros. Alternatively it can be reached by boat from Marina Grande." }
    }
  ]
};

const schemas = [touristAttractionSchema, placeSchema, faqSchema];

const fastFacts = [
  { dt: 'Location', dd: 'Island of Capri, NA' },
  { dt: 'Altitude', dd: '275 m above sea level' },
  { dt: 'Population', dd: '~7,000 inhabitants' },
  { dt: 'Summit', dd: 'Monte Solaro 589 m' },
  { dt: 'From Marina Grande', dd: '15 min (ATC bus)' },
  { dt: 'From Capri town', dd: '10 min (bus)' },
  { dt: 'Top attraction', dd: 'Villa San Michele' },
  { dt: 'Best period', dd: 'Apr-Jun / Sep-Oct' },
  { dt: 'Currency', dd: 'Euro (EUR)' },
];

const tips = [
  'Take the first bus from Marina Grande to Anacapri (7:30): you arrive before the crowds and ride the chairlift without queuing.',
  'The Church of San Michele has a majolica floor from 1761 visible from the balcony: entrance is only 2 euros.',
  'Descend from Monte Solaro on foot instead of by chairlift: the trail winds through holm oak woods with incredible views (45 min).',
  'Via Orlandi is the local shopping street: far cheaper than Capri\'s Piazzetta, with authentic artisan workshops.',
];
---

<BaseLayout
  title="Anacapri 2026: Complete Guide | Villa San Michele, Monte Solaro & Blue Grotto"
  description="Anacapri complete guide: Villa San Michele, Monte Solaro chairlift, Church of San Michele, Blue Grotto. How to get there, what to see, practical tips for visiting the upper village of Capri."
  lang={lang}
  breadcrumbs={breadcrumbs}
  schema={schemas}
  pageKey="anacapri"
>

  <section class="relative h-[75vh] sm:h-[90vh] flex items-center bg-charcoal overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-b from-black/75 via-black/40 to-black/70 z-10"></div>
    <img src="/images/anacapri-hero.jpg" alt="" class="absolute inset-0 w-full h-full object-cover" loading="eager" referrerpolicy="no-referrer"/>
    <div class="relative z-20 max-w-editorial mx-auto px-4 sm:px-6 lg:px-8">
      </nav>
      <div class="max-w-3xl">
        <p class="text-med-gold text-xs sm:text-sm font-medium uppercase tracking-[0.3em] mb-3">Island of Capri · The upper village</p>
        <h1 class="font-serif text-display text-white mb-4">Anacapri</h1>
        <p class="text-xl text-white/80 leading-relaxed max-w-2xl">
          The green and silent heart of the island of Capri: Villa San Michele, the chairlift to Monte Solaro and the most spectacular panoramas in the Gulf.
        </p>
        <div class="flex flex-wrap gap-3 mt-8">
          <a href="#fast-facts" class="px-5 py-2.5 bg-med-gold text-white text-xs sm:text-sm font-semibold rounded-full hover:scale-105 hover:shadow-[0_8px_25px_rgba(212,175,55,0.4)] transition-all duration-300">Fast Facts</a>
          <a href="#getting-there" class="px-5 py-2.5 bg-white/10 backdrop-blur text-white text-xs sm:text-sm font-medium rounded-full border border-white/20 hover:bg-white/20 transition-colors">Getting There</a>
          <a href="#faq" class="px-5 py-2.5 bg-white/10 backdrop-blur text-white text-xs sm:text-sm font-medium rounded-full border border-white/20 hover:bg-white/20 transition-colors">FAQ</a>
        </div>
      </div>
    </div>

    <Breadcrumbs breadcrumbs={breadcrumbs} />
  </section>

  <section class="max-w-editorial mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="grid lg:grid-cols-[1fr_320px] gap-12">

      <div class="space-y-16">

        <div class="prose-editorial">
          <p class="text-xl leading-relaxed text-charcoal">
            Anacapri is the second municipality of the island of Capri, perched at around 275 metres above sea level. If Capri town means glamour, boutiques and the Piazzetta, Anacapri is its opposite: silent gardens, panoramic trails, authentic villages and the highest peak on the island.
          </p>
          <p class="mt-4 text-slate-600 leading-relaxed">
            The name derives from the Greek "ana" (above) and Capri: literally "above Capri". Until 1877 the two municipalities were connected only by the Phoenician Steps, 921 steps carved into the rock. Today you can ride up comfortably by bus, but those steps still exist and offer one of the most evocative treks on the island.
          </p>
        </div>

        <div class="bg-slate-900 border border-white/10 rounded-[3rem] p-8">
          <p class="text-[10px] uppercase tracking-[0.3em] text-med-gold font-medium mb-4">Did you know?</p>
          <div class="grid sm:grid-cols-3 gap-6">
            <div class="text-center">
              <p class="font-serif text-5xl font-bold text-med-gold">589 m</p>
              <p class="text-white/60 text-xs italic mt-1">Monte Solaro, highest peak</p>
            </div>
            <div class="text-center">
              <p class="font-serif text-5xl font-bold text-med-gold">921</p>
              <p class="text-white/60 text-xs italic mt-1">steps of the Phoenician Steps</p>
            </div>
            <div class="text-center">
              <p class="font-serif text-5xl font-bold text-med-gold">1877</p>
              <p class="text-white/60 text-xs italic mt-1">year of the first road</p>
            </div>
          </div>
          <p class="text-white/40 text-xs mt-6 italic">
            Axel Munthe, the Swedish physician who built Villa San Michele, wrote "The Story of San Michele" (1929), one of the best-selling books of the 20th century, set entirely in Anacapri.
          </p>
        </div>

        <div>
          <h2 class="font-serif text-3xl font-semibold text-slate-900 mb-8">What to see in Anacapri</h2>
          <div class="space-y-8">
            {[
              {
                n: 1,
                title: 'Villa San Michele',
                text: 'The museum-villa of Swedish physician Axel Munthe, built on the ruins of a medieval chapel and a villa of Tiberius. The garden with the Egyptian sphinx and the panoramic terrace over the Gulf of Naples are among the most iconic images of Capri. Entrance ~8 euros. Open year-round.',
              },
              {
                n: 2,
                title: 'Monte Solaro (chairlift)',
                text: 'The single-seat chairlift from Piazza Vittoria carries you to the top of Monte Solaro (589 m) in 12 minutes. A 360-degree panorama: you can see Capri, Ischia, Procida, Vesuvius, the Amalfi Coast and on clear days as far as Calabria. At the top: a bar, a viewpoint and the Sanctuary of the Madonna del Soccorso.',
              },
              {
                n: 3,
                title: 'Church of San Michele Arcangelo',
                text: 'This 18th-century baroque church preserves an extraordinary majolica floor (1761) depicting the expulsion of Adam and Eve from the Garden of Eden. It is admired from the balcony to avoid walking on it. Entrance ~2 euros. In Piazza San Nicola.',
              },
              {
                n: 4,
                title: 'Phoenician Steps',
                text: 'The ancient staircase of 921 steps that connected Marina Grande to Anacapri before the road was built (1877). Descend in about 25 minutes. Starting point on Via Capodimonte in Anacapri, arrival near the harbour. Spectacular views during the descent.',
              },
              {
                n: 5,
                title: 'Blue Grotto',
                text: 'Reachable from Anacapri by bus to Grotta Azzurra or on foot (30 min downhill). The famous sea cave is visited by rowboat: light filters through a submerged opening and illuminates the water with an electric blue. Entrance ~14 euros. Avoid in rough seas.',
              },
            ].map(({ n, title, text }) => (
              <div class="grid sm:grid-cols-[auto_1fr] gap-4">
                <div class="w-14 h-14 rounded-[1rem] bg-med-gold/10 flex items-center justify-center flex-shrink-0 text-med-gold font-serif font-bold text-xl">{n}</div>
                <div>
                  <h3 class="font-semibold text-charcoal text-lg mb-1">{title}</h3>
                  <p class="text-slate-600 leading-relaxed">{text}</p>
                </div>
              </div>
            ))}
          </div>
        </div>

        <div id="getting-there">
          <h2 class="font-serif text-3xl font-semibold text-slate-900 mb-6">Getting to Anacapri</h2>
          <p class="text-slate-600 mb-8 leading-relaxed">Anacapri is reached from Capri's Marina Grande by direct ATC bus (about 15 minutes). Alternatively you can take the funicular to Capri town centre and then the bus. Open-air taxis from the harbour cost around 20-25 euros.</p>

          <div class="overflow-x-auto rounded-2xl border border-slate-200">
            <table class="w-full text-xs sm:text-xs sm:text-sm">
              <caption class="text-left text-xs text-slate-500 px-4 py-2 bg-slate-50 rounded-t-2xl border-b border-slate-200 font-medium">
                Getting to/from Anacapri
              </caption>
              <thead>
                <tr class="bg-slate-900 text-white">
                  <th class="text-left px-4 py-3 font-semibold">Route</th>
                  <th class="text-left px-4 py-3 font-semibold">Transport</th>
                  <th class="text-left px-4 py-3 font-semibold">Duration</th>
                  <th class="text-left px-4 py-3 font-semibold">Cost</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-slate-100">
                {[
                  ['Marina Grande → Anacapri', 'Direct ATC bus', '~15 min', '~2 EUR'],
                  ['Capri town → Anacapri', 'ATC bus', '~10 min', '~2 EUR'],
                  ['Marina Grande → Anacapri', 'Open-air taxi', '~12 min', '~20-25 EUR'],
                  ['Anacapri → Blue Grotto', 'ATC bus', '~10 min', '~2 EUR'],
                  ['Anacapri → Monte Solaro', 'Chairlift', '~12 min', '~12 EUR R/T'],
                ].map(([route, transport, duration, cost]) => (
                  <tr class="hover:bg-slate-50 transition-colors">
                    <td class="px-4 py-3 font-medium text-charcoal">{route}</td>
                    <td class="px-4 py-3 text-slate-500">{transport}</td>
                    <td class="px-4 py-3 font-mono">{duration}</td>
                    <td class="px-4 py-3 text-slate-500">{cost}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          <p class="text-xs text-slate-400 mt-2">* Prices and times are approximate for summer 2026.</p>
        </div>

        <div>
          <h2 class="font-serif text-3xl font-semibold text-slate-900 mb-6">Hiking trails from Anacapri</h2>
          <div class="grid sm:grid-cols-2 gap-6">
            {[
              { title: 'Phoenician Steps (descent)', text: '921 steps from the panoramic road down to Marina Grande. About 25 minutes downhill (45 uphill). Incredible views over the north coast of the island. Departure from Via Capodimonte.' },
              { title: 'Fortini Trail', text: 'A coastal path of about 5 km connecting the Blue Grotto to the Punta Carena lighthouse, passing three Bourbon fortins. Open sea views, ideal at sunset. Duration about 2 hours.' },
              { title: 'Monte Solaro on foot', text: 'From Piazza Vittoria you can hike to the summit (589 m) in about 1 hour through holm oak woods and Mediterranean scrub. A free alternative to the chairlift.' },
              { title: 'Migliera - Belvedere della Migliara', text: 'A flat 30-minute walk from Anacapri town centre to the viewpoint over the south coast and the Faraglioni. An easy route, suitable for everyone. Ends at Il Tuono, a panoramic restaurant.' },
            ].map(({ title, text }) => (
              <div class="bg-white rounded-[3rem] p-8 border border-slate-100 hover:shadow-xl transition-all duration-300">
                <h3 class="font-semibold text-charcoal mb-2">{title}</h3>
                <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">{text}</p>
              </div>
            ))}
          </div>
        </div>

        <div id="faq">
          <h2 class="font-serif text-3xl font-semibold text-slate-900 mb-8">Frequently Asked Questions about Anacapri</h2>
          <div class="space-y-4">
            {faqSchema.mainEntity.map((q) => (
              <details class="group border border-slate-200 rounded-2xl overflow-hidden">
                <summary class="flex items-center justify-between px-6 py-4 cursor-pointer select-none text-charcoal font-medium hover:bg-slate-50 transition-colors">
                  {q.name}
                  <svg class="w-4 h-4 text-slate-400 group-open:rotate-180 transition-transform flex-shrink-0 ml-3" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
                </summary>
                <div class="px-6 pb-5 text-slate-600 leading-relaxed text-xs sm:text-sm border-t border-slate-100 pt-4">
                  {q.acceptedAnswer.text}
                </div>
              </details>
            ))}
          </div>
        </div>

      </div>

      <aside class="space-y-6 lg:sticky lg:top-24 self-start">
        <div id="fast-facts" class="bg-slate-900 text-white rounded-[3rem] p-6">
          <p class="text-[10px] uppercase tracking-[0.3em] text-med-gold font-medium mb-4">Fast Facts - Anacapri</p>
          <dl class="space-y-3">
            {fastFacts.map(({ dt, dd }, i) => (
              <>
                <div class="flex justify-between items-start gap-3">
                  <dt class="text-white/40 text-xs sm:text-sm font-light flex-shrink-0">{dt}</dt>
                  <dd class="text-white font-medium text-xs sm:text-sm text-right">{dd}</dd>
                </div>
                {i < fastFacts.length - 1 && <div class="border-t border-white/5"></div>}
              </>
            ))}
          </dl>
        </div>

        <div class="bg-med-cream border border-med-gold/30 rounded-[2rem] p-6">
          <p class="text-[10px] uppercase tracking-[0.3em] text-med-gold font-medium mb-3">Insider tips</p>
          <ul class="space-y-3">
            {tips.map(tip => (
              <li class="flex items-start gap-2 text-xs sm:text-sm text-charcoal">
                <span class="w-1.5 h-1.5 rounded-full bg-med-gold mt-1.5 flex-shrink-0"></span>
                <span set:html={tip}></span>
              </li>
            ))}
          </ul>
        </div>

        <div class="bg-white border border-slate-100 rounded-[2rem] p-6 shadow-sm">
          <p class="text-[10px] uppercase tracking-[0.3em] text-slate-400 font-medium mb-3">Other Gulf Islands</p>
          <nav class="space-y-1">
            {[
              { href: '/en-us/islands/capri/', label: 'Capri' },
              { href: '/en-us/islands/ischia/', label: 'Ischia' },
              { href: '/en-us/islands/forio/', label: 'Forio' },
              { href: '/en-us/islands/procida/', label: 'Procida' },
            ].map(({ href, label }) => (
              <a href={href} class="flex items-center gap-2 px-3 py-2 rounded-xl text-xs sm:text-sm text-charcoal hover:bg-med-blue/5 hover:text-med-blue transition-colors">
                <span class="w-1.5 h-1.5 rounded-full bg-med-blue/30"></span> {label}
              </a>
            ))}
          </nav>
        </div>
      </aside>

    </div>
  </section>

  <CorrelationSlider
    lang="en-us"
    heading="Explore the other islands and the Coast"
    items={[
      { name: 'Capri',     href: '/en-us/islands/capri/',                 tag: 'Most Iconic',      desc: 'Blue Grotto, Faraglioni, the Piazzetta: the most famous island in the Gulf.' },
      { name: 'Ischia',    href: '/en-us/islands/ischia/',                tag: 'Spas & Nature',    desc: 'Natural thermal spas, Aragonese Castle, Monte Epomeo and volcanic beaches.' },
      { name: 'Forio',     href: '/en-us/islands/forio/',                 tag: 'Sunsets & Spas',   desc: 'Poseidon Gardens, the Soccorso Church and the most beautiful sunsets on Ischia.' },
      { name: 'Procida',   href: '/en-us/islands/procida/',               tag: 'Most Authentic',   desc: 'Colourful houses at Marina Corricella, Italian Capital of Culture 2022.' },
      { name: 'Positano',  href: '/en-us/amalfi-coast/positano/',         tag: 'Fashion & Views',  desc: 'Colourful houses cascading to the sea, luxury boutiques and Fornillo beach.' },
    ]}
  />

</BaseLayout>
