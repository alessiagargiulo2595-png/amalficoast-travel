---
import BaseLayout from '../../../layouts/BaseLayout.astro';

const lang = 'en-us';

const breadcrumbs = [
  { name: 'Home', url: '/en-us/' },
  { name: 'Islands', url: '/en-us/islands/' },
];

const isole = [
  {
    name: 'Capri',
    href: '/en-us/islands/capri/',
    desc: 'The Blue Grotto, the Faraglioni sea stacks and the glamorous Piazzetta: the most iconic island in the Gulf of Naples.',
    tag: 'The most iconic',
  },
  {
    name: 'Anacapri',
    href: '/en-us/islands/anacapri/',
    desc: 'The upper village of Capri: Villa San Michele, the chairlift to Monte Solaro (589 m) and the ancient Phoenician Steps.',
    tag: 'Nature & Panoramas',
  },
  {
    name: 'Ischia',
    href: '/en-us/islands/ischia/',
    desc: 'The green island of the Gulf: natural thermal parks, the Aragonese Castle, volcanic beaches and Monte Epomeo (789 m).',
    tag: 'Spas & Nature',
  },
  {
    name: 'Forio',
    href: '/en-us/islands/forio/',
    desc: 'The Poseidon Gardens, the Soccorso Church at sunset and the natural thermal pools at Sorgeto Bay.',
    tag: 'Sunsets & Spas',
  },
  {
    name: 'Procida',
    href: '/en-us/islands/procida/',
    desc: 'The smallest and most authentic: colourful houses at Marina Corricella, Italian Capital of Culture 2022.',
    tag: 'The most authentic',
  },
];

const destinationSchema = {
  "@context": "https://schema.org",
  "@type": "TouristDestination",
  "name": "Islands of the Gulf of Naples",
  "description": "Capri, Anacapri, Ischia, Forio and Procida: the islands of the Gulf of Naples, reachable by ferry from Naples, Pozzuoli and Sorrento.",
  "url": "https://amalficoast-travel.com/en-us/islands/",
  "touristType": ["Sea", "Culture", "Spas", "Nature"],
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": 40.5500,
    "longitude": 14.1000
  }
};
---

<BaseLayout
  title="Islands of Naples Gulf 2026: Capri, Ischia, Procida & Forio"
  description="Guide to the islands of the Gulf of Naples: Capri, Anacapri, Ischia, Forio and Procida. How to get there, what to see, when to go. Everything to plan your island day trip or stay."
  lang={lang}
  breadcrumbs={breadcrumbs}
  schema={[destinationSchema]}
  pageKey="islands"

  heroImage="/images/isole-hero.jpg"
>

  <!-- Hero -->
  <section class="relative h-[75vh] sm:h-[90vh] flex items-center bg-charcoal overflow-hidden">
    <img src="/images/isole-hero.jpg" alt="Islands of the Gulf of Naples" class="absolute inset-0 w-full h-full object-cover" loading="eager" fetchpriority="high" decoding="sync" referrerpolicy="no-referrer"/>

    <div class="absolute inset-0 bg-gradient-to-b from-black/25 via-black/40 to-black/75"></div>
    <div class="relative z-10 max-w-7xl mx-auto px-6 py-24">
      <nav class="flex items-center gap-2 text-white/60 text-xs mb-6">
        <a href="/en-us/" class="hover:text-white transition-colors">Home</a>
        <span>/</span>
        <span class="text-white">Islands</span>
      </nav>
      <div class="max-w-3xl">
        <p class="text-med-gold text-xs sm:text-sm font-medium uppercase tracking-[0.3em] mb-3">Gulf of Naples</p>
        <h1 class="font-serif text-display text-white mb-4">The Islands of the Gulf</h1>
        <p class="text-xl text-white/80 leading-relaxed">
          Three distinct islands: Capri (glamour, Blue Grotto), Ischia (volcanic spas, Castle), Procida (authentic, no crowds). All reachable by ferry in &lt;1 hour from Naples.
        </p>
      </div>
    </div>
  </section>

  <div class="max-w-editorial mx-auto px-4 sm:px-6 lg:px-8 py-16 space-y-20">

    <!-- Intro -->
    <section class="text-justify">
      <p class="text-xl leading-relaxed text-charcoal">
        The Gulf of Naples is one of the most beautiful in the Mediterranean, and its islands are its crown jewels. Each has a strong and unmistakable identity: difficult to visit them all in one trip, but impossible to choose just one.
      </p>
      <p class="mt-4 text-slate-600 leading-relaxed">
        Capri, Ischia and Procida are all reachable from Naples Molo Beverello or Pozzuoli with frequent ferries and hydrofoils. In summer, connections multiply. From Sorrento, Capri is reached in 20–25 minutes by hydrofoil.
      </p>
    </section>

    <!-- Isole Grid -->
    <section>
      <div class="flex items-end justify-between mb-8">
        <h2 class="font-serif text-3xl font-semibold">The Islands of the Gulf</h2>
        <p class="text-xs sm:text-sm text-slate-400 hidden sm:block">Gulf of Naples, Campania</p>
      </div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {isole.map((b, i) => {
          const stripeColors = ['#D4AF37', '#E2725B', '#005B96', '#40E0D0'];
          const stripeColor = stripeColors[i % stripeColors.length];
          return (
            <a href={b.href} class="group relative overflow-hidden bg-white border border-slate-100 rounded-[2rem] p-6 pl-7 shadow-sm hover:border-med-blue/30 hover:shadow-xl transition-all duration-300">
              <span class="absolute left-0 top-0 bottom-0 w-1.5" style={`background-color: ${stripeColor}`}></span>
              <div class="flex items-start justify-between mb-3">
                <h3 class="font-serif text-xl font-semibold text-slate-900 group-hover:text-med-blue transition-colors">{b.name}</h3>
                <span class="text-[10px] uppercase tracking-wide px-2 py-1 rounded-full font-semibold flex-shrink-0 ml-2 text-white" style={`background-color: ${stripeColor}`}>{b.tag}</span>
              </div>
              <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">{b.desc}</p>
              <p class="text-med-blue text-xs sm:text-sm font-medium mt-4 group-hover:translate-x-1 transition-transform inline-flex items-center gap-1">
                Discover {b.name}
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 18l6-6-6-6"/></svg>
              </p>
            </a>
          );
        })}
      </div>
    </section>

    <!-- Stats -->
    <section class="bg-charcoal text-white rounded-[2rem] p-10">
      <p class="text-[10px] uppercase tracking-[0.3em] text-med-gold font-medium mb-8">The Islands by the Numbers</p>
      <div class="grid sm:grid-cols-4 gap-8 text-center">
        <div>
          <p class="font-serif text-5xl font-bold text-med-gold">3</p>
          <p class="text-white/60 text-xs sm:text-sm mt-2">islands in the Gulf of Naples</p>
        </div>
        <div>
          <p class="font-serif text-5xl font-bold text-med-gold">25 min</p>
          <p class="text-white/60 text-xs sm:text-sm mt-2">Sorrento → Capri by hydrofoil</p>
        </div>
        <div>
          <p class="font-serif text-5xl font-bold text-med-gold">789 m</p>
          <p class="text-white/60 text-xs sm:text-sm mt-2">Monte Epomeo, Ischia</p>
        </div>
        <div>
          <p class="font-serif text-5xl font-bold text-med-gold">2022</p>
          <p class="text-white/60 text-xs sm:text-sm mt-2">Procida Capital of Culture</p>
        </div>
      </div>
    </section>

    <!-- Come arrivare riepilogo -->
    <section>
      <h2 class="font-serif text-3xl font-semibold text-slate-900 mb-8">Getting to the Islands</h2>
      <div class="overflow-x-auto rounded-2xl border border-slate-200">
        <table class="w-full text-xs sm:text-xs sm:text-sm">
          <thead>
            <tr class="bg-slate-900 text-white">
              <th class="text-left px-4 py-3 font-semibold">Island</th>
              <th class="text-left px-4 py-3 font-semibold">From Naples (Beverello)</th>
              <th class="text-left px-4 py-3 font-semibold">From Sorrento</th>
              <th class="text-left px-4 py-3 font-semibold">From Pozzuoli</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100">
            <tr class="hover:bg-slate-50 transition-colors">
              <td class="px-4 py-3 font-semibold text-charcoal">Capri</td>
              <td class="px-4 py-3">~50 min (ferry) / ~40 min (hydrofoil)</td>
              <td class="px-4 py-3">~20–25 min (hydrofoil)</td>
              <td class="px-4 py-3 text-slate-400">-</td>
            </tr>
            <tr class="hover:bg-slate-50 transition-colors">
              <td class="px-4 py-3 font-semibold text-charcoal">Ischia</td>
              <td class="px-4 py-3">~75 min (ferry) / ~50 min (hydrofoil)</td>
              <td class="px-4 py-3 text-slate-400">-</td>
              <td class="px-4 py-3">~35 min (ferry)</td>
            </tr>
            <tr class="hover:bg-slate-50 transition-colors">
              <td class="px-4 py-3 font-semibold text-charcoal">Procida</td>
              <td class="px-4 py-3">~35 min (hydrofoil)</td>
              <td class="px-4 py-3 text-slate-400">-</td>
              <td class="px-4 py-3">~15 min (ferry)</td>
            </tr>
          </tbody>
        </table>
      </div>
      <p class="text-xs text-slate-400 mt-2">* Approximate times. Check caremar.it, snav.it, medmar.it for current schedules.</p>
    </section>

  </div>

</BaseLayout>
