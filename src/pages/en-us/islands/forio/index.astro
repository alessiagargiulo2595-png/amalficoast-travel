---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import CorrelationSlider from '../../../../components/CorrelationSlider.astro';
import Breadcrumbs from '../../../../components/Breadcrumbs.astro';

const lang = 'en-us';

const breadcrumbs = [
  { name: 'Home', url: '/en-us/' },
  { name: 'Gulf Islands', url: '/en-us/islands/' },
  { name: 'Forio', url: '/en-us/islands/forio/' },
];

const touristAttractionSchema = {
  "@context": "https://schema.org",
  "@type": "TouristAttraction",
  "name": "Forio d'Ischia",
  "description": "Forio is the largest municipality on the island of Ischia: Poseidon Gardens, the Soccorso Church, Citara Bay, sunsets over the sea and natural thermal spas make it an unmissable destination.",
  "url": "https://amalficoast-travel.com/en-us/islands/forio/",
  "touristType": ["Spas", "Beach", "Culture", "Sunsets"],
  "address": { "@type": "PostalAddress", "addressLocality": "Forio", "addressRegion": "Napoli", "addressCountry": "IT", "postalCode": "80075" },
  "geo": { "@type": "GeoCoordinates", "latitude": 40.7365, "longitude": 13.8570 }
};

const placeSchema = {
  "@context": "https://schema.org",
  "@type": "Place",
  "name": "Forio, Island of Ischia",
  "geo": { "@type": "GeoCoordinates", "latitude": 40.7365, "longitude": 13.8570 },
  "containedInPlace": { "@type": "AdministrativeArea", "name": "Island of Ischia" }
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "How do you get to Forio from Naples?",
      "acceptedAnswer": { "@type": "Answer", "text": "From Naples you take the ferry or hydrofoil to Ischia Porto (about 50-75 minutes). From there you reach Forio by bus (line CD or CS, about 25-30 minutes) or by taxi. Alternatively, some Medmar ferries from Pozzuoli arrive at Casamicciola, from which Forio is even closer." }
    },
    {
      "@type": "Question",
      "name": "How much does Poseidon Gardens cost?",
      "acceptedAnswer": { "@type": "Answer", "text": "Entrance to Poseidon Gardens thermal park costs around 35-38 euros for a full day (half day from 1pm around 30 euros). The park includes 22 thermal pools at different temperatures, a private beach, sauna and gardens. It is the largest and most famous thermal park on Ischia." }
    },
    {
      "@type": "Question",
      "name": "What is the best beach in Forio?",
      "acceptedAnswer": { "@type": "Answer", "text": "Citara Bay is the most famous, with fine sand and clear waters. San Francesco Beach is smaller and quieter. Sorgeto Bay offers natural pools of warm thermal water mixing with the sea (free, accessible via a staircase)." }
    },
    {
      "@type": "Question",
      "name": "What to see in Forio in one day?",
      "acceptedAnswer": { "@type": "Answer", "text": "In one day you can visit the Soccorso Church at sunset, La Mortella Gardens in the morning, the historic centre with the Saracen towers, and Citara Bay or Poseidon Gardens in the afternoon. If time allows, Sorgeto Bay for a thermal bath at sunset." }
    },
    {
      "@type": "Question",
      "name": "When is the best time to visit Forio?",
      "acceptedAnswer": { "@type": "Answer", "text": "May, June and September are the ideal months: perfect weather, warm sea, fewer crowds than July and August. La Mortella Gardens are open from April to November. Poseidon Gardens are open from April to October. Winter is very quiet with some reduced services." }
    }
  ]
};

const schemas = [touristAttractionSchema, placeSchema, faqSchema];

const fastFacts = [
  { dt: 'Location', dd: 'West coast of Ischia, NA' },
  { dt: 'Population', dd: '~18,000 inhabitants' },
  { dt: 'Largest municipality', dd: 'On the island of Ischia' },
  { dt: 'From Ischia Porto', dd: '25-30 min (bus CD/CS)' },
  { dt: 'From Naples', dd: '50-75 min + bus' },
  { dt: 'Thermal spas', dd: 'Poseidon Gardens, Sorgeto' },
  { dt: 'Top beach', dd: 'Citara Bay' },
  { dt: 'Best period', dd: 'May-Jun / Sep' },
  { dt: 'Currency', dd: 'Euro (EUR)' },
];

const tips = [
  'The Soccorso Church at sunset is one of the most beautiful spectacles in the entire Gulf of Naples: arrive 30 minutes early to find a good spot.',
  'La Mortella Gardens are only open on certain days: check the calendar at lamortella.org before planning your visit.',
  'Sorgeto Bay is free but you descend about 200 steps to reach it: go at sunset for the most magical thermal bath experience.',
  'The circular bus CD (clockwise) and CS (anticlockwise) connect all municipalities on Ischia: 90-minute ticket ~2 euros.',
];
---

<BaseLayout
  title="Forio d'Ischia 2026 | Poseidon Gardens, Soccorso & Thermal Spas"
  description="Forio d'Ischia complete guide: Poseidon Gardens, Soccorso Church, Citara Bay, La Mortella Gardens, Sorgeto. How to get there, what to see, thermal spas and sunsets."
  lang={lang}
  breadcrumbs={breadcrumbs}
  schema={schemas}
  pageKey="forio"

  heroImage="/images/forio-hero.jpg"
>

  <section class="relative h-[75vh] sm:h-[90vh] flex items-center bg-charcoal overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-b from-black/75 via-black/40 to-black/70 z-10"></div>
    <img src="/images/forio-hero.jpg" alt="Forio on Ischia: the Soccorso church at sunset" class="absolute inset-0 w-full h-full object-cover" loading="eager" fetchpriority="high" decoding="sync" referrerpolicy="no-referrer"/>
    <div class="relative z-20 max-w-editorial mx-auto px-4 sm:px-6 lg:px-8">
      </nav>
      <div class="max-w-3xl">
        <p class="text-med-gold text-xs sm:text-sm font-medium uppercase tracking-[0.3em] mb-3">Island of Ischia · West coast</p>
        <h1 class="font-serif text-display text-white mb-4">Forio</h1>
        <p class="text-xl text-white/80 leading-relaxed max-w-2xl">
          Open-air thermal spas, legendary sunsets over the Soccorso Church and Poseidon Gardens: Forio is the beating heart of Ischia's western coast.
        </p>
        <div class="flex flex-wrap gap-3 mt-8">
          <a href="#fast-facts" class="px-5 py-2.5 bg-med-gold text-white text-xs sm:text-sm font-semibold rounded-full hover:scale-105 hover:shadow-[0_8px_25px_rgba(212,175,55,0.4)] transition-all duration-300">Fast Facts</a>
          <a href="#getting-there" class="px-5 py-2.5 bg-white/10 backdrop-blur text-white text-xs sm:text-sm font-medium rounded-full border border-white/20 hover:bg-white/20 transition-colors">Getting There</a>
          <a href="#faq" class="px-5 py-2.5 bg-white/10 backdrop-blur text-white text-xs sm:text-sm font-medium rounded-full border border-white/20 hover:bg-white/20 transition-colors">FAQ</a>
        </div>
      </div>
    </div>

    <Breadcrumbs breadcrumbs={breadcrumbs} />
  </section>

  <section class="max-w-editorial mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="grid lg:grid-cols-[1fr_320px] gap-12">

      <div class="space-y-16">

        <div class="prose-editorial">
          <p class="text-xl leading-relaxed text-charcoal">
            Forio is the largest municipality on the island of Ischia and occupies its entire western coast. It is the point on the island where the sun sets over the open sea - and this simple geographical fact has shaped its identity: a place of golden light, volcanic thermal springs and lush gardens.
          </p>
          <p class="mt-4 text-slate-600 leading-relaxed">
            Historically a village of fishermen and farmers, Forio was discovered in the 1950s by European artists and intellectuals - Truman Capote, W.H. Auden and Hans Werner Henze composed some of their most important works here. Today it is the ideal destination for those seeking the more authentic and natural side of Ischia, far from the glamour of Ischia Porto.
          </p>
        </div>

        <div class="bg-slate-900 border border-white/10 rounded-[3rem] p-8">
          <p class="text-[10px] uppercase tracking-[0.3em] text-med-gold font-medium mb-4">Did you know?</p>
          <div class="grid sm:grid-cols-3 gap-6">
            <div class="text-center">
              <p class="font-serif text-5xl font-bold text-med-gold">22</p>
              <p class="text-white/60 text-xs italic mt-1">thermal pools at Poseidon Gardens</p>
            </div>
            <div class="text-center">
              <p class="font-serif text-5xl font-bold text-med-gold">12</p>
              <p class="text-white/60 text-xs italic mt-1">Saracen towers in the territory</p>
            </div>
            <div class="text-center">
              <p class="font-serif text-5xl font-bold text-med-gold">1958</p>
              <p class="text-white/60 text-xs italic mt-1">year La Mortella Gardens founded</p>
            </div>
          </div>
          <p class="text-white/40 text-xs mt-6 italic">
            Lady Susana Walton, wife of English composer William Walton, created La Mortella Gardens in Forio with the help of landscape designer Russell Page. Today they host chamber music concerts every weekend.
          </p>
        </div>

        <div>
          <h2 class="font-serif text-3xl font-semibold text-slate-900 mb-8">What to see in Forio</h2>
          <div class="space-y-8">
            {[
              {
                n: 1,
                title: 'Soccorso Church',
                text: 'The white church on the headland is the symbol of Forio and of all Ischia. Built in the 14th century, it faces directly onto the open sea with a majolica-paved forecourt. At sunset it becomes the most spectacular natural stage on the island. Free entry.',
              },
              {
                n: 2,
                title: 'Poseidon Gardens Thermal Park',
                text: 'The largest and most famous thermal park on Ischia: 22 pools at different temperatures (from 20 to 40 degrees), a natural cave sauna and a private beach on Citara Bay. A full day of relaxation. Entrance around 35-38 euros for a full day. Open April-October.',
              },
              {
                n: 3,
                title: 'La Mortella Gardens',
                text: 'One of the most beautiful botanical gardens in the Mediterranean, created by Lady Walton in 1958. Two hectares of tropical and Mediterranean plants, fountains, water lilies, a museum and a concert hall hosting recitals every weekend. Entrance around 12 euros. Open on certain days of the week (check the calendar).',
              },
              {
                n: 4,
                title: 'Sorgeto Bay',
                text: 'Natural pools where warm thermal water bubbles up from the rocks and mingles with the cool sea. Reached by descending about 200 steps from the hamlet of Panza. Free and open year-round, even at night. A bath at sunset or under the stars is a unique experience.',
              },
              {
                n: 5,
                title: 'Historic centre & Saracen towers',
                text: 'The centre of Forio retains 12 watchtowers from the 15th-16th century, built to defend against Saracen raids. The Torre Torrione is the largest and houses a civic museum. The village is a maze of alleyways, baroque churches, artisan workshops and traditional restaurants.',
              },
            ].map(({ n, title, text }) => (
              <div class="grid sm:grid-cols-[auto_1fr] gap-4">
                <div class="w-14 h-14 rounded-[1rem] bg-med-gold/10 flex items-center justify-center flex-shrink-0 text-med-gold font-serif font-bold text-xl">{n}</div>
                <div>
                  <h3 class="font-semibold text-charcoal text-lg mb-1">{title}</h3>
                  <p class="text-slate-600 leading-relaxed">{text}</p>
                </div>
              </div>
            ))}
          </div>
        </div>

        <div id="getting-there">
          <h2 class="font-serif text-3xl font-semibold text-slate-900 mb-6">Getting to Forio</h2>
          <p class="text-slate-600 mb-8 leading-relaxed">Forio is reached by ferry or hydrofoil from Naples or Pozzuoli to Ischia Porto or Casamicciola, then by circular bus. There are no direct sea connections to Forio.</p>

          <div class="overflow-x-auto rounded-2xl border border-slate-200">
            <table class="w-full text-xs sm:text-xs sm:text-sm">
              <caption class="text-left text-xs text-slate-500 px-4 py-2 bg-slate-50 rounded-t-2xl border-b border-slate-200 font-medium">
                Getting to/from Forio
              </caption>
              <thead>
                <tr class="bg-slate-900 text-white">
                  <th class="text-left px-4 py-3 font-semibold">Route</th>
                  <th class="text-left px-4 py-3 font-semibold">Transport</th>
                  <th class="text-left px-4 py-3 font-semibold">Duration</th>
                  <th class="text-left px-4 py-3 font-semibold">Cost</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-slate-100">
                {[
                  ['Naples → Ischia Porto', 'Hydrofoil (NLG/Alilauro)', '~50 min', '~20 EUR'],
                  ['Naples → Ischia Porto', 'Ferry (Caremar)', '~75 min', '~13 EUR'],
                  ['Pozzuoli → Casamicciola', 'Ferry (Medmar)', '~35 min', '~10 EUR'],
                  ['Ischia Porto → Forio', 'Bus CD/CS', '~25-30 min', '~2 EUR'],
                  ['Casamicciola → Forio', 'Bus CD/CS', '~15 min', '~2 EUR'],
                ].map(([route, transport, duration, cost]) => (
                  <tr class="hover:bg-slate-50 transition-colors">
                    <td class="px-4 py-3 font-medium text-charcoal">{route}</td>
                    <td class="px-4 py-3 text-slate-500">{transport}</td>
                    <td class="px-4 py-3 font-mono">{duration}</td>
                    <td class="px-4 py-3 text-slate-500">{cost}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          <p class="text-xs text-slate-400 mt-2">* Prices and times are approximate for summer 2026. Check caremar.it, medmar.it, alilauro.it.</p>
        </div>

        <div>
          <h2 class="font-serif text-3xl font-semibold text-slate-900 mb-6">Forio's beaches</h2>
          <div class="grid sm:grid-cols-2 gap-6">
            {[
              { title: 'Citara Bay', text: 'The largest and best-equipped beach in Forio, with fine golden sand and turquoise waters. Home to Poseidon Gardens. Both lido facilities and a free beach stretch. West-facing: perfect for sunsets.' },
              { title: 'San Francesco Beach', text: 'A small beach beneath the Soccorso Church, more sheltered and quiet than Citara. Sand and pebbles, crystal-clear water. Reachable on foot from Forio town centre in 5 minutes.' },
              { title: 'Cava dell\'Isola Beach', text: 'A wild cove on the north coast of Forio, popular with surfers and nature lovers. Less equipped, more authentic. Reachable by car or bus plus a short walk.' },
              { title: 'Sorgeto Bay (thermal)', text: 'Not a traditional beach but natural thermal rock pools. Warm volcanic water mingles with the cool sea. Free, open year-round. You descend about 200 steps from the hamlet of Panza.' },
            ].map(({ title, text }) => (
              <div class="bg-white rounded-[3rem] p-8 border border-slate-100 hover:shadow-xl transition-all duration-300">
                <h3 class="font-semibold text-charcoal mb-2">{title}</h3>
                <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">{text}</p>
              </div>
            ))}
          </div>
        </div>

        <div id="faq">
          <h2 class="font-serif text-3xl font-semibold text-slate-900 mb-8">Frequently Asked Questions about Forio</h2>
          <div class="space-y-4">
            {faqSchema.mainEntity.map((q) => (
              <details class="group border border-slate-200 rounded-2xl overflow-hidden">
                <summary class="flex items-center justify-between px-6 py-4 cursor-pointer select-none text-charcoal font-medium hover:bg-slate-50 transition-colors">
                  {q.name}
                  <svg class="w-4 h-4 text-slate-400 group-open:rotate-180 transition-transform flex-shrink-0 ml-3" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
                </summary>
                <div class="px-6 pb-5 text-slate-600 leading-relaxed text-xs sm:text-sm border-t border-slate-100 pt-4">
                  {q.acceptedAnswer.text}
                </div>
              </details>
            ))}
          </div>
        </div>

      </div>

      <aside class="space-y-6 lg:sticky lg:top-24 self-start">
        <div id="fast-facts" class="bg-slate-900 text-white rounded-[3rem] p-6">
          <p class="text-[10px] uppercase tracking-[0.3em] text-med-gold font-medium mb-4">Fast Facts - Forio</p>
          <dl class="space-y-3">
            {fastFacts.map(({ dt, dd }, i) => (
              <>
                <div class="flex justify-between items-start gap-3">
                  <dt class="text-white/40 text-xs sm:text-sm font-light flex-shrink-0">{dt}</dt>
                  <dd class="text-white font-medium text-xs sm:text-sm text-right">{dd}</dd>
                </div>
                {i < fastFacts.length - 1 && <div class="border-t border-white/5"></div>}
              </>
            ))}
          </dl>
        </div>

        <div class="bg-med-cream border border-med-gold/30 rounded-[2rem] p-6">
          <p class="text-[10px] uppercase tracking-[0.3em] text-med-gold font-medium mb-3">Insider tips</p>
          <ul class="space-y-3">
            {tips.map(tip => (
              <li class="flex items-start gap-2 text-xs sm:text-sm text-charcoal">
                <span class="w-1.5 h-1.5 rounded-full bg-med-gold mt-1.5 flex-shrink-0"></span>
                <span set:html={tip}></span>
              </li>
            ))}
          </ul>
        </div>

        <div class="bg-white border border-slate-100 rounded-[2rem] p-6 shadow-sm">
          <p class="text-[10px] uppercase tracking-[0.3em] text-slate-400 font-medium mb-3">Other Gulf Islands</p>
          <nav class="space-y-1">
            {[
              { href: '/en-us/islands/capri/', label: 'Capri' },
              { href: '/en-us/islands/anacapri/', label: 'Anacapri' },
              { href: '/en-us/islands/ischia/', label: 'Ischia' },
              { href: '/en-us/islands/procida/', label: 'Procida' },
            ].map(({ href, label }) => (
              <a href={href} class="flex items-center gap-2 px-3 py-2 rounded-xl text-xs sm:text-sm text-charcoal hover:bg-med-blue/5 hover:text-med-blue transition-colors">
                <span class="w-1.5 h-1.5 rounded-full bg-med-blue/30"></span> {label}
              </a>
            ))}
          </nav>
        </div>
      </aside>

    </div>
  </section>

  <CorrelationSlider
    lang="en-us"
    heading="Explore the other islands and the Coast"
    items={[
      { name: 'Ischia',    href: '/en-us/islands/ischia/',                tag: 'Spas & Nature',    desc: 'Natural thermal spas, Aragonese Castle, Monte Epomeo and volcanic beaches.' },
      { name: 'Capri',     href: '/en-us/islands/capri/',                 tag: 'Most Iconic',      desc: 'Blue Grotto, Faraglioni, the Piazzetta: the most famous island in the Gulf.' },
      { name: 'Anacapri',  href: '/en-us/islands/anacapri/',              tag: 'Nature & Panoramas', desc: 'Villa San Michele, Monte Solaro, Phoenician Steps: the upper village of Capri.' },
      { name: 'Procida',   href: '/en-us/islands/procida/',               tag: 'Most Authentic',   desc: 'Colourful houses at Marina Corricella, Italian Capital of Culture 2022.' },
      { name: 'Positano',  href: '/en-us/amalfi-coast/positano/',         tag: 'Fashion & Views',  desc: 'Colourful houses cascading to the sea, luxury boutiques and Fornillo beach.' },
    ]}
  />

</BaseLayout>
