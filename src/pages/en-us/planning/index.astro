---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import { getTranslations, getLocalePath } from '../../../i18n/translations';

const lang = 'en-us';
const t = getTranslations(lang);

const breadcrumbs = [
  { name: 'Home', url: '/en-us/' },
  { name: 'Planning', url: '/en-us/planning/' },
];

// Guide articles data
const guides = [
  {
    title: 'How to Get Here',
    desc: 'Train, plane, ferry or car: all the options for reaching the Amalfi Coast.',
    img: '/images/come-arrivare-hero.jpg',
    href: '/en-us/guide/getting-here/',
    tag: 'Transport'
  },
  {
    title: 'SITA Bus',
    desc: 'The complete guide to local buses: schedules, fares, tickets and routes along the coast.',
    img: '/images/bus-sita-hero.jpg',
    href: '/en-us/guide/sita-bus/',
    tag: 'Transport'
  },
  {
    title: 'Ferries',
    desc: 'From local ferries to summer routes from Naples and Salerno: how to reach every town by sea.',
    img: '/images/traghetti-hero.jpg',
    href: '/en-us/guide/ferries/',
    tag: 'Transport'
  },
  {
    title: 'Parking & ZTL Zones',
    desc: 'Where to park, hours and costs. How to avoid restricted traffic zones and fines.',
    img: '/images/parcheggi-hero.jpg',
    href: '/en-us/guide/parking-ztl/',
    tag: 'Practical'
  },
  {
    title: 'When to Visit',
    desc: 'Seasons, weather, holidays and crowds. When is the best time for your visit.',
    img: '/images/quando-visitare-hero.jpg',
    href: '/en-us/guide/when-to-visit/',
    tag: 'Planning'
  },
];
---

<BaseLayout
  title={t.meta.itineraries_title}
  description={t.meta.itineraries_description}
  lang={lang}
  pageKey="planning"
>
  <!-- Hero -->
  <section class="relative bg-charcoal text-white py-20 overflow-hidden">
    <img src="/images/itinerari-hero.jpg" alt="Planning Amalfi Coast" class="absolute inset-0 w-full h-full object-cover opacity-20" loading="eager" referrerpolicy="no-referrer"/>
    <div class="absolute inset-0 bg-charcoal/80"></div>
    <div class="relative z-10 max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <p class="text-white/80 text-xs sm:text-sm uppercase tracking-[0.3em] mb-3">Plan your trip</p>
      <h1 class="text-4xl md:text-5xl font-bold font-serif mb-4">Practical Guides</h1>
      <p class="text-white/80 text-lg max-w-2xl mx-auto">How to get there, how to move around, when to visit and where to park on the Amalfi Coast. Everything you need for a perfect trip.</p>
    </div>
    <Breadcrumbs breadcrumbs={breadcrumbs} />
  </section>

  <!-- Intro -->
  <section class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <p class="text-lg text-slate-600 leading-relaxed">
      The Amalfi Coast is easy to explore once you know how to get there, how to get around, and the best seasons to visit. Here you'll find all the practical information you need: from transport options to parking prices, from local buses to summer ferries.
    </p>
  </section>

  <!-- Guides Grid -->
  <section class="py-12 border-t border-slate-100">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {guides.map((guide) => (
          <a href={guide.href} class="group block bg-white rounded-2xl border border-slate-100 overflow-hidden hover:shadow-lg hover:border-med-blue/20 transition-all duration-300">
            <!-- Image with overlay -->
            <div class="relative h-44 overflow-hidden">
              <img src={guide.img} alt={guide.title} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
              <div class="absolute inset-0 bg-gradient-to-t from-black/50 to-transparent" />
              <!-- Category badge -->
              <span class="absolute bottom-3 left-3 text-[10px] font-bold uppercase tracking-wider text-white bg-med-blue/80 backdrop-blur-sm px-2.5 py-1 rounded-full">
                {guide.tag}
              </span>
            </div>
            <!-- Text section -->
            <div class="p-5">
              <h3 class="font-semibold text-charcoal text-sm mb-1.5 group-hover:text-med-blue transition-colors">{guide.title}</h3>
              <p class="text-xs text-slate-500 leading-relaxed">{guide.desc}</p>
              <span class="mt-3 inline-flex items-center text-xs font-semibold text-med-blue gap-1 group-hover:gap-2 transition-all">
                Read guide →
              </span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Itineraries CTA -->
  <section class="bg-med-blue py-16 text-center">
    <div class="max-w-2xl mx-auto px-4">
      <h2 class="text-2xl font-bold text-white mb-4">Ready to explore the coast?</h2>
      <p class="text-white mb-6">Choose between 1 day, 3 days or 1 week of recommended itineraries.</p>
      <a href={getLocalePath(lang, 'itineraries')}
        class="inline-block bg-white text-med-blue font-semibold px-8 py-3 rounded-full hover:bg-slate-100 transition-colors">
        View itineraries
      </a>
    </div>
  </section>
</BaseLayout>
