---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../../components/Breadcrumbs.astro';
import CorrelationSlider from '../../../../components/CorrelationSlider.astro';

const lang = 'en-us';

const breadcrumbs = [
  { name: 'Home', url: '/en-us/' },
  { name: 'Beaches', url: '/en-us/beaches/' },
  { name: 'Cala del Pozzo Vecchio', url: '/en-us/beaches/islands/cala-del-pozzo-vecchio/' },
];

const facts = [
  { label: 'Surface', value: 'Black volcanic sand' },
  { label: 'Vibe', value: 'Poetic and peaceful' },
  { label: 'Access', value: '10 min walk from the bus stop' },
  { label: 'Shade', value: 'From 17:30' },
  { label: 'Best for', value: 'Cinema lovers, poetry, authentic relaxation' },
  { label: 'Island', value: 'Procida (4 km²)' },
  { label: 'Geology', value: 'Neapolitan yellow tuff' },
  { label: 'Film', value: 'Il Postino (1994)' },
  { label: 'Oscar', value: '5 nominations, 1 win' },
  { label: 'Fortress above', value: 'Terra Murata (medieval)' },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "How do I get to Cala del Pozzo Vecchio from Naples?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "From Naples, take the ferry or hydrofoil to Procida from Pozzuoli port or Molo Beverello (approximately 35–80 minutes depending on the vessel). From Procida port, take bus line C1 to the Pozzo Vecchio stop, then walk downhill for 10 minutes. Alternatively, the beach is reachable on foot from the town centre in about 20–25 minutes through the island's narrow lanes."
      }
    },
    {
      "@type": "Question",
      "name": "Is Cala del Pozzo Vecchio really the beach from Il Postino?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. Cala del Pozzo Vecchio is the main beach used as a set in the film Il Postino (1994), directed by Michael Radford and starring Massimo Troisi and Philippe Noiret. Some scenes were also shot in other parts of Procida and on the island of Salina (for the Pablo Neruda sequences). Fans of the film will recognise it instantly."
      }
    },
    {
      "@type": "Question",
      "name": "Are there facilities at Cala del Pozzo Vecchio?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "The beach has basic amenities: a few sun loungers and umbrellas for hire and a small drinks kiosk. It is not a fully equipped lido, which is part of its authentic charm. It is best to bring your own water and food if you plan to spend the whole day there. The nearby town of Procida has bars and restaurants a short walk away."
      }
    },
    {
      "@type": "Question",
      "name": "When is the best time to visit Procida and Cala del Pozzo Vecchio?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "May, June and September are ideal: the sea is already warm (22–26°C), crowds are far smaller than in August, and the atmosphere is at its most authentic. July and August do get busy, but never reach the overcrowding levels of Capri or Ischia. The island is also pleasant in spring for walks."
      }
    },
    {
      "@type": "Question",
      "name": "Can you snorkel at Cala del Pozzo Vecchio?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes, the water at Cala del Pozzo Vecchio is clear and well suited to snorkelling. The sandy seabed shelves gently, with good visibility especially in the morning before the afternoon breeze stirs up the sand. The rocky sides of the cove are home to sea urchins, octopuses and small shoals of fish. Bring your own equipment as there are no rentals on site."
      }
    }
  ]
};

const beachSchema = {
  "@context": "https://schema.org",
  "@type": "Beach",
  "name": "Cala del Pozzo Vecchio",
  "description": "The Procida beach made immortal by Massimo Troisi's film Il Postino. Black volcanic sand and emerald-green water.",
  "address": {
    "@type": "PostalAddress",
    "addressLocality": "Procida",
    "addressRegion": "NA",
    "addressCountry": "IT"
  }
};
---

<BaseLayout
  title="Il Postino Beach Procida 2026: Cala del Pozzo Vecchio"
  description="The beach made immortal by the film Il Postino. Black volcanic sand, emerald water, and the most authentic side of Procida. 2026 guide."
  lang={lang}
  breadcrumbs={breadcrumbs}
  schema={[beachSchema, faqSchema]}
 pageKey="cala-del-pozzo-vecchio">

  <!-- Hero -->
  <section class="relative h-[52.5vh] sm:h-[70vh] overflow-hidden flex items-center justify-center">
    <img
      src="/images/cala-pozzo-vecchio-procida.jpg"
      alt="Cala del Pozzo Vecchio, Procida - Il Postino beach"
      class="absolute inset-0 w-full h-full object-cover"
      loading="eager"
      referrerpolicy="no-referrer"
    />
    <div class="absolute inset-0 hidden sm:block bg-gradient-to-b from-black/20 via-black/35 to-black/70"></div>
    <div class="relative z-10 text-center px-6 max-w-4xl text-white">
      <p class="text-med-gold text-sm font-medium uppercase tracking-[0.3em] mb-3">Procida · Gulf Islands</p>
      <h1 class="font-serif text-display text-white mb-6">Cala del Pozzo Vecchio</h1>
      <p class="text-lg md:text-xl font-light text-white/80">The beach made immortal by Massimo Troisi.</p>
    </div>
    <Breadcrumbs breadcrumbs={breadcrumbs} />
  </section>

  <!-- Content + Sidebar -->
  <section class="bg-med-cream py-24 px-6">
    <div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-3 gap-16">

      <!-- Main text -->
      <div class="lg:col-span-2 space-y-12">
        <div>
          <h2 class="font-serif text-4xl font-bold text-slate-900 mb-6">Cinema Made Beach</h2>
          <p class="text-slate-600 text-lg leading-relaxed mb-6">
            The beach made immortal by Massimo Troisi in <em>Il Postino</em> (1994). A crescent of black volcanic sand and emerald-green water that looks as if it stepped straight out of the film. The moment you arrive, you understand immediately why Troisi and director Michael Radford chose it as the main set.
          </p>
          <p class="text-slate-600 text-lg leading-relaxed">
            This is the most authentic and least touristy side of the Campanian islands. <a href="/en-us/islands/procida/" class="text-med-blue hover:underline">Procida</a> has never had the mass tourism of <a href="/en-us/islands/capri/" class="text-med-blue hover:underline">Capri</a> or <a href="/en-us/islands/ischia/" class="text-med-blue hover:underline">Ischia</a>, and this beach preserves its soul: few visitors, a great deal of poetry, spotlessly clean water. Perfect for total relaxation and those who love cinematic atmospheres.
          </p>
        </div>

        <!-- Il Postino box -->
        <div class="bg-white p-8 rounded-[2rem] shadow-xl border border-slate-100">
          <div class="flex items-center gap-4 mb-4">
            <svg class="w-6 h-6 text-med-gold flex-shrink-0" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><rect x="2" y="2" width="20" height="20" rx="2.18" ry="2.18"/><line x1="7" y1="2" x2="7" y2="22"/><line x1="17" y1="2" x2="17" y2="22"/><line x1="2" y1="12" x2="22" y2="12"/><line x1="2" y1="7" x2="7" y2="7"/><line x1="2" y1="17" x2="7" y2="17"/><line x1="17" y1="17" x2="22" y2="17"/><line x1="17" y1="7" x2="22" y2="7"/></svg>
            <h3 class="text-xl font-bold">Il Postino (1994)</h3>
          </div>
          <p class="text-slate-600 leading-relaxed mb-4">
            Michael Radford's film starring Massimo Troisi and Philippe Noiret won the Academy Award for Best Foreign Language Film. This beach is the heart of the movie. Many visitors come here to relive the iconic scenes — the postman walking along the shore, the poetry of the sea.
          </p>
          <p class="text-slate-600 leading-relaxed italic">
            "Il mondo è bello e tu sei un po' curioso" — Il Postino, 1994
          </p>
        </div>

        <!-- The story behind the film -->
        <div>
          <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">The Story Behind the Film</h2>
          <p class="text-slate-600 text-lg leading-relaxed mb-6">
            Massimo Troisi played Mario Ruoppolo, the island postman who befriends the exiled Chilean poet Pablo Neruda (Philippe Noiret) living in his villa. The film was shot in 1994 on this beach and in the alleyways of Procida. The real tragedy is that Troisi was suffering from a serious heart condition and postponed surgery in order to finish filming. He died just <strong>12 hours after the final take</strong>, on 4 June 1994, aged only 41.
          </p>
          <p class="text-slate-600 text-lg leading-relaxed">
            Il Postino received 5 Oscar nominations, winning the award for <strong>Best Original Score</strong> (Luis Bacalov). At the time it was the foreign-language film with the most Academy Award nominations in history. Troisi's legacy — and that of this beach — remains very much alive.
          </p>
        </div>

        <!-- Geology and history -->
        <div>
          <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">Pozzo Vecchio and the Island's Geology</h2>
          <p class="text-slate-600 text-lg leading-relaxed mb-6">
            The cove's name comes from an ancient well — the <strong>Pozzo Vecchio</strong> (Old Well) — that once stood nearby and supplied fishermen and farmers with fresh water. The well is no longer visible, but its name has endured for centuries. The black sand is <strong>Neapolitan yellow tuff</strong>: volcanic rock from the Campi Flegrei eroded by the sea into dark, heavy grains. The cliffs bordering the cove clearly show the layered pyroclastic deposits of ancient eruptions.
          </p>
          <p class="text-slate-600 text-lg leading-relaxed">
            Procida is the smallest of the Phlegrean Islands (just 4 km²). From the beach you can look up at the silhouette of <strong>Terra Murata</strong>, the medieval citadel housing the Abbey of San Michele Arcangelo. For centuries that fortress protected the islanders from Saracen pirate raids.
          </p>
        </div>

        <!-- Fishing tradition -->
        <div class="bg-white p-8 rounded-[2rem] shadow-xl border border-slate-100">
          <div class="flex items-center gap-4 mb-4">
            <svg class="w-6 h-6 text-med-gold flex-shrink-0" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M18 16.5a9 9 0 1 1-9-9"/><path d="M22 2L11 13"/><path d="M22 2h-5.5M22 2v5.5"/></svg>
            <h3 class="text-xl font-bold">The Fishing Tradition</h3>
          </div>
          <p class="text-slate-600 leading-relaxed">
            Procida has the strongest fishing tradition of all the Gulf islands. Procidan fishermen still use traditional methods, and every year the <strong>Graziella</strong> festival celebrates this seafaring identity. The literary character of Graziella, created by Alphonse de Lamartine in 1852, was herself a young fisherwoman from Procida. The local catch — clams, octopus, squid — is among the freshest in the Gulf of Naples.
          </p>
        </div>

        <!-- Stats box -->
        <div class="bg-slate-900 text-white p-8 rounded-[2rem] grid grid-cols-2 sm:grid-cols-4 gap-6 text-center">
          <div>
            <p class="text-med-gold text-3xl font-bold">4</p>
            <p class="text-white/60 text-sm mt-1">km² Procida</p>
          </div>
          <div>
            <p class="text-med-gold text-3xl font-bold">5</p>
            <p class="text-white/60 text-sm mt-1">Oscar nominations</p>
          </div>
          <div>
            <p class="text-med-gold text-3xl font-bold">12h</p>
            <p class="text-white/60 text-sm mt-1">after filming ended</p>
          </div>
          <div>
            <p class="text-med-gold text-3xl font-bold">1994</p>
            <p class="text-white/60 text-sm mt-1">year of the film</p>
          </div>
        </div>

        <!-- Local Tips -->
        <div class="bg-med-cream p-8 rounded-[2rem] border border-med-gold/20">
          <h3 class="font-serif text-2xl font-bold text-slate-900 mb-6">Local Tips</h3>
          <ul class="space-y-4">
            <li class="flex items-start gap-3">
              <span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span>
              <span class="text-slate-600">Take the hydrofoil from Pozzuoli rather than Naples: it costs less and takes almost the same time.</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span>
              <span class="text-slate-600">Visit the beach early in the morning to recapture the quiet, poetic atmosphere of the film.</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span>
              <span class="text-slate-600">Walk up to Terra Murata after the beach: the view over the Gulf more than repays the climb.</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span>
              <span class="text-slate-600">Bring water shoes: the black volcanic sand gets much hotter than ordinary sand under the August sun.</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="w-2 h-2 bg-med-gold rounded-full mt-2.5 flex-shrink-0"></span>
              <span class="text-slate-600">For lunch, look for trattorias in the old town: they are cheaper and more genuine than those on the seafront.</span>
            </li>
          </ul>
        </div>

        <!-- How to Get There -->
        <div>
          <h2 class="font-serif text-3xl font-bold text-slate-900 mb-6">How to Get There</h2>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div class="bg-white p-6 rounded-[2rem] border border-slate-100 shadow-sm">
              <p class="text-med-gold text-xs font-bold uppercase tracking-wider mb-2">Bus Line C1 ⭐</p>
              <p class="text-slate-700 font-medium mb-1">From Procida port</p>
              <p class="text-slate-500 text-sm">Pozzo Vecchio stop. Then 10 min walk downhill to the beach.</p>
            </div>
            <div class="bg-white p-6 rounded-[2rem] border border-slate-100 shadow-sm">
              <p class="text-med-gold text-xs font-bold uppercase tracking-wider mb-2">On foot</p>
              <p class="text-slate-700 font-medium mb-1">From Procida town centre</p>
              <p class="text-slate-500 text-sm">20–25 minutes. Scenic and pleasant through the island's narrow lanes.</p>
            </div>
            <div class="bg-white p-6 rounded-[2rem] border border-slate-100 shadow-sm">
              <p class="text-med-gold text-xs font-bold uppercase tracking-wider mb-2">Ferry from Naples</p>
              <p class="text-slate-700 font-medium mb-1">Molo Beverello or Pozzuoli</p>
              <p class="text-slate-500 text-sm">35–80 min depending on the vessel. Hydrofoil is faster, ferry is cheaper.</p>
            </div>
            <div class="bg-white p-6 rounded-[2rem] border border-slate-100 shadow-sm">
              <p class="text-med-gold text-xs font-bold uppercase tracking-wider mb-2">Scooter hire</p>
              <p class="text-slate-700 font-medium mb-1">From the port</p>
              <p class="text-slate-500 text-sm">Handy for exploring the whole island. Parking close to the cove.</p>
            </div>
          </div>
        </div>

        <!-- FAQ -->
        <div>
          <h2 class="font-serif text-3xl font-bold text-slate-900 mb-8">Frequently Asked Questions</h2>
          <div class="space-y-4">
            {faqSchema.mainEntity.map((q) => (
              <details class="group border border-slate-200 rounded-2xl overflow-hidden bg-white">
                <summary class="flex items-center justify-between px-6 py-4 cursor-pointer select-none text-charcoal font-medium hover:bg-slate-50 transition-colors">
                  {q.name}
                  <svg class="w-4 h-4 text-slate-400 group-open:rotate-180 transition-transform flex-shrink-0 ml-3" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
                </summary>
                <div class="px-6 pb-5 text-slate-600 leading-relaxed text-xs sm:text-sm border-t border-slate-100 pt-4">
                  {q.acceptedAnswer.text}
                </div>
              </details>
            ))}
          </div>
        </div>
      </div>

      <!-- Sidebar Fast-Facts -->
      <aside class="lg:col-span-1">
        <div class="bg-slate-900 text-white p-10 rounded-[3rem] sticky top-32">
          <h3 class="font-serif text-2xl font-bold mb-8 flex items-center gap-3">
            <svg class="w-6 h-6 text-med-gold" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M2 12c.6.5 1.2 1 2.5 1 2.5 0 2.5-2 5-2 2.6 0 2.4 2 5 2 2.5 0 2.5-2 5-2 1.3 0 1.9.5 2.5 1"/><path d="M2 18c.6.5 1.2 1 2.5 1 2.5 0 2.5-2 5-2 2.6 0 2.4 2 5 2 2.5 0 2.5-2 5-2 1.3 0 1.9.5 2.5 1"/></svg> Fast-Facts
          </h3>
          <div class="space-y-6">
            {facts.map((item) => (
              <div class="border-b border-white/5 pb-4 last:border-0">
                <span class="text-white/40 text-sm font-light block mb-1">{item.label}</span>
                <span class="text-white font-medium text-sm">{item.value}</span>
              </div>
            ))}
          </div>
          <div class="mt-10 pt-8 border-t border-white/10">
            <a
              href="/en-us/beaches/"
              class="inline-flex items-center gap-2 text-med-gold text-sm font-medium hover:text-white transition-colors"
            >
              ← All Beaches
            </a>
          </div>
        </div>
      </aside>

    </div>
  </section>

  <!-- More Island Beaches -->
  <CorrelationSlider
    lang="en-us"
    title="More Island Beaches"
    items={[
      { name: 'Spiaggia Maronti', href: '/en-us/beaches/islands/spiaggia-maronti/', tag: 'Ischia', desc: 'Three kilometres of warm sand heated by the volcano.' },
      { name: 'Marina Piccola', href: '/en-us/beaches/islands/marina-piccola-capri/', tag: 'Capri', desc: 'The exclusive beach with views of the Faraglioni.' },
      { name: 'Faraglioni', href: '/en-us/beaches/islands/faraglioni-capri/', tag: 'Capri', desc: 'The three legendary rocks that are the symbol of the island.' },
      { name: 'Spiaggia Grande', href: '/en-us/beaches/amalfi-coast/spiaggia-grande-positano/', tag: 'Positano', desc: 'The vibrant heart of the Amalfi Coast.' },
    ]}
  />

  <!-- CTA -->
  <section class="bg-med-blue py-16 text-center">
    <div class="max-w-2xl mx-auto px-6">
      <h2 class="font-serif text-2xl font-bold text-white mb-4">Discover everything about Procida</h2>
      <a
        href="/en-us/islands/procida/"
        class="inline-block bg-white text-med-blue font-semibold px-8 py-3 rounded-full hover:bg-med-cream transition-colors"
      >
        Complete Procida guide
      </a>
    </div>
  </section>

</BaseLayout>
