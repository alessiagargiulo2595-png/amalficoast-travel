---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import StickyBar from '../components/StickyBar.astro';
import HrefLangTags from '../components/HrefLangTags.astro';
import CookieConsent from '../components/CookieConsent.astro';
import SearchModal from '../components/SearchModal.astro';
import { getTranslations, getLocalePath, slugMap, translatePath, extractPageKeyFromPath, resolveCanonicalUrl } from '../i18n/translations';
import type { Locale } from '../i18n/translations';

interface Props {
  title: string;
  description: string;
  lang: Locale;
  pageKey?: string;
  breadcrumbs?: { name: string; url: string }[];
  schema?: object[];
  ogImage?: string;
}

const { title, description, lang, pageKey, breadcrumbs, schema, ogImage = '/images/costiera-hero.webp' } = Astro.props;
const t = getTranslations(lang);
const site = 'https://amalficoast-travel.com';

const locales: Locale[] = ['en-us', 'de-de', 'fr-fr', 'es-es', 'it-it'];

// Smart fallback: if no pageKey, try to extract it from current pathname
const smartPageKey = pageKey || extractPageKeyFromPath(Astro.url.pathname);

const hreflangs = locales.map((l) => {
  const path = smartPageKey
    ? getLocalePath(l, smartPageKey)
    : translatePath(Astro.url.pathname, lang, l);
  // Resolve redirects to ensure hreflang points to canonical URL (200)
  const canonicalPath = resolveCanonicalUrl(`${path}`);
  return { locale: l, url: `${site}${canonicalPath}` };
});
const xDefaultUrl = hreflangs.find(h => h.locale === 'en-us')?.url || `${site}/en-us/`;

const schemaLocaleMap: Record<Locale, string> = {
  'en-us': 'en-US', 'de-de': 'de-DE',
  'fr-fr': 'fr-FR', 'es-es': 'es-ES', 'it-it': 'it-IT',
};
const htmlLang = schemaLocaleMap[lang];
const canonicalUrl = `${site}${Astro.url.pathname}`;

// Base website schema
const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "Amalfi Coast Travel Guide",
  "url": site,
  "description": "Guida turistica alla Costiera Amalfitana, Penisola Sorrentina e Isole del Golfo di Napoli.",
  "inLanguage": htmlLang,
};

// Organization schema
const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "Amalfi Coast Travel Guide",
  "url": site,
  "logo": `${site}/logo-footer.svg`,
  "description": "Guida turistica completa alla Costiera Amalfitana, Penisola Sorrentina e Isole del Golfo di Napoli. Orari, spiagge, eventi, esperienze e consigli pratici.",
  "address": {
    "@type": "PostalAddress",
    "addressLocality": "Costiera Amalfitana",
    "addressRegion": "Campania",
    "addressCountry": "IT"
  }
};

// Breadcrumb schema
const breadcrumbSchema = breadcrumbs ? {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": breadcrumbs.map((b, i) => ({
    "@type": "ListItem",
    "position": i + 1,
    "name": b.name,
    "item": `${site}${b.url}`
  }))
} : null;

const allSchemas = [websiteSchema, organizationSchema, ...(schema || []), ...(breadcrumbSchema ? [breadcrumbSchema] : [])];
---

<!DOCTYPE html>
<html lang={htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Hreflang -->
    <HrefLangTags pathname={Astro.url.pathname} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="Amalfi Coast Travel Guide" />
    <meta property="og:locale" content={htmlLang} />
    <meta property="og:image" content={`${site}${ogImage}`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={`${site}${ogImage}`} />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400;1,600&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet" />

    <!-- Schema.org JSON-LD -->
    {allSchemas.map(s => (
      <script type="application/ld+json" set:html={JSON.stringify(s)} />
    ))}

    <!-- Google Analytics with Consent Mode -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      window.gtag = function(){window.dataLayer.push(arguments);}
      gtag('consent', 'default', {
        'analytics_storage': 'denied',
        'ad_storage': 'denied',
        'ad_user_data': 'denied',
        'ad_personalization': 'denied',
        'wait_for_update': 500
      });
      gtag('js', new Date());
      gtag('config', 'G-C9MBPN3GKX', {
        'anonymize_ip': true,
        'allow_google_signals': false,
        'allow_ad_personalization_signals': false
      });
    </script>
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-C9MBPN3GKX"></script>

    <!-- Microsoft Clarity -->
    <script type="text/javascript">
      (function(c,l,a,r,i,t,y){
        c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
        t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
        y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
      })(window, document, "clarity", "script", "wj6329gkzr");
    </script>

    <!-- Cookie Consent (vanilla-cookieconsent, MIT) -->

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body class="bg-med-cream text-charcoal font-sans antialiased overflow-x-hidden selection:bg-med-gold selection:text-white">
    <Header lang={lang} pageKey={pageKey} />
    <main>
      <slot />
    </main>
    <Footer lang={lang} pageKey={pageKey} />
    <StickyBar lang={lang} />
    <CookieConsent lang={lang} />
    <SearchModal lang={lang} />

    <!-- Back to top -->
    <button id="back-to-top" class="hidden fixed bottom-20 right-4 z-40 w-11 h-11 bg-white rounded-full shadow-lg border border-slate-100 flex items-center justify-center text-slate-500 hover:text-med-blue hover:shadow-xl transition-all duration-200 lg:bottom-8" aria-label="Back to top">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M5 15l7-7 7 7"/>
      </svg>
    </button>
    <script>
      const btt = document.getElementById('back-to-top');
      if (btt) {
        window.addEventListener('scroll', () => {
          btt.classList.toggle('hidden', window.scrollY < 300);
        }, { passive: true });
        btt.addEventListener('click', () => window.scrollTo({ top: 0, behavior: 'smooth' }));
      }

      // Outbound link tracking
      document.querySelectorAll<HTMLAnchorElement>('a[href^="http"]').forEach(link => {
        if (link.hostname !== window.location.hostname) {
          link.addEventListener('click', () => {
            if (typeof window.gtag === 'function') {
              window.gtag('event', 'outbound_click', {
                link_url: link.href,
                link_text: link.textContent?.trim().slice(0, 100) || '',
                link_domain: link.hostname,
                page_path: window.location.pathname,
              });
            }
          });
        }
      });

      // CTA click tracking (bg-med-blue sections = CTA blocks)
      document.querySelectorAll<HTMLAnchorElement>('section.bg-med-blue a, section.bg-slate-900 a, a[class*="bg-med-blue"], a[class*="bg-med-gold"]').forEach(link => {
        link.addEventListener('click', () => {
          if (typeof window.gtag === 'function') {
            window.gtag('event', 'cta_click', {
              cta_text: link.textContent?.trim().slice(0, 100) || '',
              cta_url: link.getAttribute('href') || '',
              page_path: window.location.pathname,
            });
          }
        });
      });

      // FAQ / accordion tracking (<details> elements in main content)
      document.querySelectorAll<HTMLDetailsElement>('main details').forEach(det => {
        det.addEventListener('toggle', () => {
          if (det.open && typeof window.gtag === 'function') {
            const question = det.querySelector('summary')?.textContent?.trim().slice(0, 150) || '';
            window.gtag('event', 'faq_interaction', {
              faq_question: question,
              page_path: window.location.pathname,
            });
          }
        });
      });

      // File download tracking
      document.querySelectorAll<HTMLAnchorElement>('a[download], a[href$=".pdf"], a[href$=".gpx"]').forEach(link => {
        link.addEventListener('click', () => {
          if (typeof window.gtag === 'function') {
            const url = link.getAttribute('href') || '';
            const fileName = url.split('/').pop() || url;
            window.gtag('event', 'file_download', {
              file_name: fileName,
              file_url: url,
              link_text: link.textContent?.trim().slice(0, 100) || '',
              page_path: window.location.pathname,
            });
          }
        });
      });

      // Scroll depth tracking (25%, 50%, 75%, 90%)
      (function() {
        const thresholds = [25, 50, 75, 90];
        const fired = new Set<number>();

        function getScrollPercent(): number {
          const docHeight = document.documentElement.scrollHeight - window.innerHeight;
          if (docHeight <= 0) return 100;
          return Math.round((window.scrollY / docHeight) * 100);
        }

        window.addEventListener('scroll', () => {
          const pct = getScrollPercent();
          for (const t of thresholds) {
            if (pct >= t && !fired.has(t)) {
              fired.add(t);
              if (typeof window.gtag === 'function') {
                window.gtag('event', 'scroll_depth', {
                  percent_scrolled: t,
                  page_path: window.location.pathname,
                });
              }
            }
          }
        }, { passive: true });
      })();
    </script>
  </body>
</html>
